{% doc %}
  @prompt
    <!DOCTYPE html>
    <html lang="de">
    <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Solarbank Produkte</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
      }
    
      body {
        background: #ffffff;
        padding: 2rem 1rem;
      }
    
      .product-grid {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
      }
    
      @media (max-width: 900px) {
        .product-grid { grid-template-columns: repeat(2, 1fr); }
      }
    
      @media (max-width: 600px) {
        .product-grid { grid-template-columns: 1fr; }
      }
    
      /* 卡片 */
      .product-card {
        border: 1px solid #ececec;
        border-radius: 8px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        background: #ffffff;
      }
    
      /* 图片区域 */
      .product-media {
        position: relative;
        background: #fafafa;
        aspect-ratio: 4 / 3;
        display: flex;
        align-items: center;
        justify-content: center;
      }
    
      .product-media img {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }
    
      /* 左上角折扣角标 */
      .discount-badge {
        position: absolute;
        top: 12px;
        left: 0;
        background: #f5a623;
        color: #ffffff;
        font-size: 0.72rem;
        font-weight: 600;
        padding: 0.3rem 0.8rem 0.3rem 0.6rem;
        clip-path: polygon(0 0, 100% 0, 88% 100%, 0% 100%);
      }
    
      /* 右上角赠品圆形角标 */
      .gift-badge {
        position: absolute;
        top: 14px;
        right: 14px;
        width: 62px;
        height: 62px;
        border-radius: 50%;
        background: #2ec5f6;
        color: #ffffff;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        line-height: 1.15;
        box-shadow: 0 4px 10px rgba(46, 197, 246, 0.35);
      }
    
      .gift-badge .gift-label {
        font-size: 0.62rem;
        font-weight: 600;
      }
    
      .gift-badge .gift-price {
        font-size: 0.75rem;
        font-weight: 700;
      }
    
      /* 内容区 */
      .product-content {
        padding: 1rem 1.1rem 1.2rem;
        display: flex;
        flex-direction: column;
        flex: 1;
      }
    
      /* 产品名称 */
      .product-title {
        font-size: 0.95rem;
        font-weight: 600;
        color: #1a1a1a;
        line-height: 1.4;
        margin-bottom: 0.9rem;
        min-height: 2.6rem;
      }
    
      /* 卖点三列 */
      .selling-points {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.5rem;
        margin-bottom: 1rem;
      }
    
      .selling-point {
        text-align: left;
      }
    
      .selling-point .value {
        font-size: 0.95rem;
        font-weight: 700;
        color: #1a1a1a;
      }
    
      .selling-point .label {
        font-size: 0.72rem;
        color: #6b6b6b;
        margin-top: 0.1rem;
        line-height: 1.3;
      }
    
      /* 价格 + 按钮行 */
      .price-row {
        margin-top: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.6rem;
        flex-wrap: wrap;
      }
    
      .price-group {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
      }
    
      .price-current {
        font-size: 1.4rem;
        font-weight: 700;
        color: #1a1a1a;
      }
    
      .price-old {
        font-size: 0.85rem;
        color: #9b9b9b;
        text-decoration: line-through;
      }
    
      .buy-btn {
        background: #14b8b0;
        color: #ffffff;
        font-size: 0.85rem;
        font-weight: 600;
        padding: 0.6rem 1.1rem;
        border-radius: 4px;
        border: none;
        text-decoration: none;
        white-space: nowrap;
        cursor: pointer;
        transition: background-color 0.15s ease;
      }
    
      .buy-btn:hover {
        background: #0fa39c;
      }
    </style>
    </head>
