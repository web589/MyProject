{% endstyle %}

<product-grid-{{ ai_gen_id }} class="ai-product-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-grid-container-{{ ai_gen_id }}">
    {% for i in (1..6) %}
      {% liquid
        assign product_key = 'product_' | append: i
        assign product = block.settings[product_key]
        assign discount_key = 'discount_text_' | append: i
        assign discount_text = block.settings[discount_key]
        assign gift_key = 'gift_text_' | append: i
        assign gift_text = block.settings[gift_key]
        assign gift_price_key = 'gift_price_' | append: i
        assign gift_price = block.settings[gift_price_key]
        assign point1_value_key = 'point1_value_' | append: i
        assign point1_value = block.settings[point1_value_key]
        assign point1_label_key = 'point1_label_' | append: i
        assign point1_label = block.settings[point1_label_key]
        assign point2_value_key = 'point2_value_' | append: i
        assign point2_value = block.settings[point2_value_key]
        assign point2_label_key = 'point2_label_' | append: i
        assign point2_label = block.settings[point2_label_key]
        assign point3_value_key = 'point3_value_' | append: i
        assign point3_value = block.settings[point3_value_key]
        assign point3_label_key = 'point3_label_' | append: i
        assign point3_label = block.settings[point3_label_key]
      %}

      {% if product != blank %}
        <div class="ai-product-card-{{ ai_gen_id }}">
          <div class="ai-product-media-{{ ai_gen_id }}">
            {% if discount_text != blank %}
              <span class="ai-discount-badge-{{ ai_gen_id }}">{{ discount_text }}</span>
            {% endif %}

            {% if gift_text != blank %}
              <div class="ai-gift-badge-{{ ai_gen_id }}">
                <span class="ai-gift-label-{{ ai_gen_id }}">{{ gift_text }}</span>
                {% if gift_price != blank %}
                  <span class="ai-gift-price-{{ ai_gen_id }}">{{ gift_price }}</span>
                {% endif %}
              </div>
            {% endif %}

            {% if product.featured_image %}
              <img
                src="{{ product.featured_image | image_url: width: 600 }}"
                alt="{{ product.featured_image.alt | escape }}"
                loading="lazy"
                width="600"
                height="450"
              >
            {% else %}
              <div class="ai-product-media-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          <div class="ai-product-content-{{ ai_gen_id }}">
            <h3 class="ai-product-title-{{ ai_gen_id }}">{{ product.title }}</h3>

            <div class="ai-selling-points-{{ ai_gen_id }}">
              {% if point1_value != blank %}
                <div class="ai-selling-point-{{ ai_gen_id }}">
                  <div class="ai-selling-point-value-{{ ai_gen_id }}">{{ point1_value }}</div>
                  {% if point1_label != blank %}
                    <div class="ai-selling-point-label-{{ ai_gen_id }}">{{ point1_label }}</div>
                  {% endif %}
                </div>
              {% endif %}

              {% if point2_value != blank %}
                <div class="ai-selling-point-{{ ai_gen_id }}">
                  <div class="ai-selling-point-value-{{ ai_gen_id }}">{{ point2_value }}</div>
                  {% if point2_label != blank %}
                    <div class="ai-selling-point-label-{{ ai_gen_id }}">{{ point2_label }}</div>
                  {% endif %}
                </div>
              {% endif %}

              {% if point3_value != blank %}
                <div class="ai-selling-point-{{ ai_gen_id }}">
                  <div class="ai-selling-point-value-{{ ai_gen_id }}">{{ point3_value }}</div>
                  {% if point3_label != blank %}
                    <div class="ai-selling-point-label-{{ ai_gen_id }}">{{ point3_label }}</div>
                  {% endif %}
                </div>
              {% endif %}
            </div>

            <div class="ai-price-row-{{ ai_gen_id }}">
              <div class="ai-price-group-{{ ai_gen_id }}">
                <span class="ai-price-current-{{ ai_gen_id }}">{{ product.price | money }}</span>
                {% if product.compare_at_price > product.price %}
                  <span class="ai-price-old-{{ ai_gen_id }}">{{ product.compare_at_price | money }}</span>
                {% endif %}
              </div>
              <a href="{{ product.url }}" class="ai-buy-btn-{{ ai_gen_id }}">{{ block.settings.button_text }}</a>
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</product-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }
    customElements.define('product-grid-{{ ai_gen_id }}', ProductGrid{{ ai_gen_id }});
  })();
</script>

