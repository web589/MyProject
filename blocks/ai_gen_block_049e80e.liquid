{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-review-slider-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
    box-sizing: border-box;
    position: relative;
  }

  .ai-review-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-review-main-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    margin: 0 0 {{ block.settings.title_margin }}px;
    font-weight: 700;
    color: {{ block.settings.title_color }};
    text-align: {{ block.settings.title_alignment }};
  }

  .ai-review-outer-{{ ai_gen_id }} {
    overflow: hidden;
    position: relative;
  }

  .ai-review-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    transition: transform 0.4s ease-out;
    will-change: transform;
  }

  .ai-review-card-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.card_width }}px;
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.card_border_radius }}px;
    cursor: pointer;
  }

  .ai-review-img-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.card_width }}px;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .ai-review-card-{{ ai_gen_id }}:hover .ai-review-img-{{ ai_gen_id }} {
    transform: scale({{ block.settings.hover_scale }});
  }

  .ai-review-mask-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    background: {{ block.settings.overlay_color }};
    padding: 26px 20px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: {{ block.settings.overlay_text_color }};
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ai-review-card-{{ ai_gen_id }}:hover .ai-review-mask-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-review-stars-{{ ai_gen_id }} {
    font-size: {{ block.settings.star_size }}px;
    color: {{ block.settings.star_color }};
    margin-bottom: 12px;
  }

  .ai-review-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.review_text_size }}px;
    line-height: 1.6;
    margin: 0 0 16px;
  }

  .ai-review-author-{{ ai_gen_id }} {
    font-size: {{ block.settings.author_text_size }}px;
    opacity: 0.85;
  }

  .ai-slider-control-btn-{{ ai_gen_id }} {
    width: {{ block.settings.button_size }}px;
    height: {{ block.settings.button_size }}px;
    border-radius: 50%;
    background: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_icon_color }};
    border: none;
    font-size: {{ block.settings.button_icon_size }}px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    transition: background 0.2s ease;
  }

  .ai-slider-control-btn-{{ ai_gen_id }}:hover {
    background: {{ block.settings.button_hover_bg_color }};
  }

  .ai-btn-prev-{{ ai_gen_id }} {
    left: 12px;
  }

  .ai-btn-next-{{ ai_gen_id }} {
    right: 12px;
  }

  @media screen and (max-width: 768px) {
    .ai-review-card-{{ ai_gen_id }} {
      flex: 0 0 260px;
    }

    .ai-review-img-{{ ai_gen_id }} {
      height: 260px;
    }

    .ai-slider-control-btn-{{ ai_gen_id }} {
      width: 40px;
      height: 40px;
      font-size: 16px;
    }

    .ai-btn-prev-{{ ai_gen_id }} {
      left: 6px;
    }

    .ai-btn-next-{{ ai_gen_id }} {
      right: 6px;
    }
  }
{% endstyle %}

<review-slider-{{ ai_gen_id }} class="ai-review-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-review-container-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h2 class="ai-review-main-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    {% endif %}

    <div class="ai-review-outer-{{ ai_gen_id }}">
      <button class="ai-slider-control-btn-{{ ai_gen_id }} ai-btn-prev-{{ ai_gen_id }}" type="button" aria-label="Previous reviews">←</button>
      <button class="ai-slider-control-btn-{{ ai_gen_id }} ai-btn-next-{{ ai_gen_id }}" type="button" aria-label="Next reviews">→</button>

      <div class="ai-review-track-{{ ai_gen_id }}">
        {% for i in (1..10) %}
          {% liquid
            assign image_key = 'review_image_' | append: i
            assign stars_key = 'review_stars_' | append: i
            assign text_key = 'review_text_' | append: i
            assign author_key = 'review_author_' | append: i

            assign review_image = block.settings[image_key]
            assign review_stars = block.settings[stars_key]
            assign review_text = block.settings[text_key]
            assign review_author = block.settings[author_key]
          %}

          {% if review_image != blank or review_text != blank %}
            <div class="ai-review-card-{{ ai_gen_id }}">
              {% if review_image %}
                <img
                  class="ai-review-img-{{ ai_gen_id }}"
                  src="{{ review_image | image_url: width: 640 }}"
                  alt="{{ review_author | default: 'Customer review' }}"
                  loading="lazy"
                  width="640"
                  height="640"
                >
              {% else %}
                <div class="ai-review-img-{{ ai_gen_id }}" style="background-color: #f4f4f4; display: flex; align-items: center; justify-content: center;">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}

              <div class="ai-review-mask-{{ ai_gen_id }}">
                {% if review_stars > 0 %}
                  <div class="ai-review-stars-{{ ai_gen_id }}">
                    {% for star in (1..5) %}
                      {% if star <= review_stars %}★{% else %}☆{% endif %}
                    {% endfor %}
                  </div>
                {% endif %}

                {% if review_text != blank %}
                  <p class="ai-review-text-{{ ai_gen_id }}">{{ review_text }}</p>
                {% endif %}

                {% if review_author != blank %}
                  <div class="ai-review-author-{{ ai_gen_id }}">{{ review_author }}</div>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</review-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class ReviewSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.cardWidth = {{ block.settings.card_width }};
        this.cardGap = {{ block.settings.card_gap }};
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-review-track-{{ ai_gen_id }}');
        this.cards = this.querySelectorAll('.ai-review-card-{{ ai_gen_id }}');
        this.prevBtn = this.querySelector('.ai-btn-prev-{{ ai_gen_id }}');
        this.nextBtn = this.querySelector('.ai-btn-next-{{ ai_gen_id }}');

        if (!this.track || this.cards.length === 0) return;

        this.setupEventListeners();
        
        {% if block.settings.autoplay %}
          this.startAutoplay();
        {% endif %}
      }

      setupEventListeners() {
        this.prevBtn.addEventListener('click', () => this.slide(-1));
        this.nextBtn.addEventListener('click', () => this.slide(1));

        {% if block.settings.autoplay %}
          this.addEventListener('mouseenter', () => this.stopAutoplay());
          this.addEventListener('mouseleave', () => this.startAutoplay());
        {% endif %}
      }

      slide(direction) {
        const maxIndex = this.cards.length - this.getVisibleCards();
        this.currentIndex = Math.max(0, Math.min(this.currentIndex + direction, maxIndex));
        this.updatePosition();
      }

      updatePosition() {
        const offset = this.currentIndex * (this.cardWidth + this.cardGap);
        this.track.style.transform = `translateX(-${offset}px)`;
      }

      getVisibleCards() {
        const containerWidth = this.querySelector('.ai-review-outer-{{ ai_gen_id }}').offsetWidth;
        return Math.floor(containerWidth / (this.cardWidth + this.cardGap));
      }

      startAutoplay() {
        this.autoplayInterval = setInterval(() => {
          const maxIndex = this.cards.length - this.getVisibleCards();
          if (this.currentIndex >= maxIndex) {
            this.currentIndex = 0;
          } else {
            this.currentIndex++;
          }
          this.updatePosition();
        }, {{ block.settings.autoplay_speed }} * 1000);
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }
    }

    customElements.define('review-slider-{{ ai_gen_id }}', ReviewSlider{{ ai_gen_id }});
  })();
</script>

