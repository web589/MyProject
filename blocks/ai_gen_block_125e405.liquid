{% doc %}
  @prompt
    <!DOCTYPE html>
    <html lang="de">
    <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <title>Finden Sie Ihr VENUS E</title>
      <style>
        /* ===== 整体区块 ===== */
        .comparison-section {
          max-width: 1280px;
          margin: 0 auto 60px;
          padding: 0 20px;
          font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        }
    
        .comparison-section .section-title {
          font-size: 38px;
          font-weight: 700;
          color: #0A1628;
          margin-bottom: 32px;
          letter-spacing: -0.5px;
        }
        .comparison-section .section-title span {
          color: #0099FC;
        }
    
        /* ===== 表格容器 ===== */
        .comparison-table-wrapper {
          overflow-x: auto;
          border-radius: 20px;
          box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
          border: 1px solid #E2E8F0;
          background: #FFFFFF;
        }
    
        /* ===== 表格 ===== */
        .comparison-table {
          width: 100%;
          border-collapse: collapse;
          font-size: 15px;
          min-width: 600px;
        }
    
        /* 表头强制蓝色 #0099FC */
        .comparison-table th {
          padding: 16px 20px;
          text-align: left;
          font-weight: 700;
          color: #FFFFFF;
          font-size: 16px;
          border-bottom: none;
          background-color: #0099FC !important;  /* 强制蓝色 */
        }
    
        .comparison-table th:first-child {
          border-radius: 20px 0 0 0;
        }
        .comparison-table th:last-child {
          border-radius: 0 20px 0 0;
        }
    
        /* 行分隔线 */
        .comparison-table td {
          padding: 14px 20px;
          border-bottom: 1px solid #E2E8F0;
          color: #242424;
          vertical-align: middle;
        }
    
        /* 最后一行的底部边框去掉 */
        .comparison-table tbody tr:last-child td {
          border-bottom: none;
        }
    
        /* 第一列（规格名）加粗，深蓝色 */
        .comparison-table td:first-child {
          font-weight: 600;
          color: #0369A1;
        }
    
        /* 行悬停浅蓝色背景 */
        .comparison-table tbody tr:hover {
          background: #E0F7FF;
        }
    
        /* 特殊值标记 */
        .comparison-table .check-yes {
          color: #0099FC;
          font-weight: 700;
        }
        .comparison-table .check-optional {
          color: #FF8C00;
          font-weight: 600;
        }
        .comparison-table .check-no {
          color: #999;
        }
    
        /* 产品列（第2～5列）可加粗突出 */
        .comparison-table td:not(:first-child) {
          font-weight: 500;
        }
    
        /* 移动端适配 */
        @media (max-width: 640px) {
          .comparison-section .section-title {
            font-size: 26px;
          }
          .comparison-table {
            font-size: 13px;
            min-width: 480px;
          }
          .comparison-table th,
          .comparison-table td {
            padding: 10px 14px;
          }
        }
    
        @media (max-width: 480px) {
          .comparison-table {
            font-size: 12px;
            min-width: 380px;
          }
          .comparison-table th,
          .comparison-table td {
            padding: 8px 10px;
          }
        }
      </style>
    </head>
    <body>
    
      <!-- ============================================ -->
      <!-- 板块：Finden Sie Ihr VENUS E                 -->
      <!-- ============================================ -->
      <section class="comparison-section">
        <h2 class="section-title">Finden Sie Ihr <span>VENUS E</span></h2>
    
        <div class="comparison-table-wrapper">
          <table class="comparison-table">
            <thead>
              <tr>
                <th>Spezifikation</th>
                <th>VENUS E Mini</th>
                <th>VENUS E 3.0</th>
                <th>VENUS E 4.0</th>
                <th>VENUS E MAX</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Kapazität</td>
                <td>2 kWh</td>
                <td>5.12 kWh</td>
                <td>5 kWh</td>
                <td>10 kWh</td>
              </tr>
              <tr>
                <td>Leistung</td>
                <td>1.5 kW</td>
                <td>2.5 kW</td>
                <td>3 kW</td>
                <td>3.6 kW</td>
              </tr>
              <tr>
                <td>EPS Umschaltung</td>
                <td>&lt;15 ms</td>
                <td>&lt;15 ms</td>
                <td>&lt;10 ms</td>
                <td>&lt;10 ms</td>
              </tr>
              <tr>
                <td>VPP</td>
                <td><span class="check-no">—</span></td>
                <td><span class="check-optional">Optional</span></td>
                <td><span class="check-yes">Ja</span></td>
                <td><span class="check-yes">Ja</span></td>
              </tr>
              <tr>
                <td>Max. Erweiterung</td>
                <td>2 kWh</td>
                <td>20 kWh</td>
                <td>30 kWh</td>
                <td>30 kWh</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    
    </body>
    </html>
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-comparison-section-{{ ai_gen_id }} {
    display: block;
    max-width: 1280px;
    margin: {{ block.settings.section_top_margin }}px auto {{ block.settings.section_bottom_margin }}px;
    padding: 0 20px;
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    width: {{ block.settings.desktop_width_percent }}%;
  }

  .ai-comparison-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    color: {{ block.settings.title_color }};
    margin-bottom: {% if block.settings.subtitle != blank %}8{% else %}{{ block.settings.title_margin_bottom }}{% endif %}px;
    letter-spacing: -0.5px;
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
  }

  .ai-comparison-subtitle-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.title_margin_bottom | minus: 8 }}px;
    color: #596b82;
    font-size: 16px;
    line-height: 1.5;
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
  }

  .ai-comparison-subtitle-{{ ai_gen_id }} p {
    margin: 0;
  }

  .ai-comparison-wrapper-{{ ai_gen_id }} {
    overflow-x: auto;
    border-radius: {{ block.settings.table_border_radius }}px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, {{ block.settings.shadow_opacity | divided_by: 100.0 }});
    border: 1px solid {{ block.settings.border_color }};
    background: {{ block.settings.table_background }};
  }

  .ai-comparison-table-{{ ai_gen_id }} {
    width: 100%;
    border-collapse: collapse;
    font-size: {{ block.settings.table_font_size }}px;
    min-width: 920px;
  }

  .ai-comparison-table-{{ ai_gen_id }} th {
    padding: {{ block.settings.header_padding }}px 20px;
    text-align: left;
    font-weight: 700;
    color: {{ block.settings.header_text_color }};
    font-size: {{ block.settings.header_font_size }}px;
    border-bottom: none;
    background-color: {{ block.settings.header_background }};
  }

  .ai-comparison-table-{{ ai_gen_id }} th:first-child {
    border-radius: {{ block.settings.table_border_radius }}px 0 0 0;
  }

  .ai-comparison-table-{{ ai_gen_id }} th:last-child {
    border-radius: 0 {{ block.settings.table_border_radius }}px 0 0;
  }

  .ai-comparison-table-{{ ai_gen_id }} td {
    padding: {{ block.settings.cell_padding }}px 20px;
    border-bottom: 1px solid {{ block.settings.row_border_color }};
    color: {{ block.settings.cell_text_color }};
    vertical-align: middle;
  }

  .ai-comparison-table-{{ ai_gen_id }} tbody tr:last-child td {
    border-bottom: none;
  }

  .ai-comparison-table-{{ ai_gen_id }} td:first-child {
    font-weight: 600;
    color: {{ block.settings.spec_label_color }};
  }

  {% if block.settings.enable_row_hover %}
    .ai-comparison-table-{{ ai_gen_id }} tbody tr:hover {
      background: {{ block.settings.row_hover_color }};
    }
  {% endif %}

  .ai-comparison-yes-{{ ai_gen_id }} {
    color: {{ block.settings.yes_color }};
    font-weight: 700;
  }

  .ai-comparison-optional-{{ ai_gen_id }} {
    color: {{ block.settings.optional_color }};
    font-weight: 600;
  }

  .ai-comparison-no-{{ ai_gen_id }} {
    color: {{ block.settings.no_color }};
  }

  .ai-comparison-table-{{ ai_gen_id }} td:not(:first-child) {
    font-weight: 500;
  }

  .ai-comparison-table-{{ ai_gen_id }} th,
  .ai-comparison-table-{{ ai_gen_id }} td {
    min-width: 150px;
  }

  .ai-comparison-table-{{ ai_gen_id }} th:first-child,
  .ai-comparison-table-{{ ai_gen_id }} td:first-child {
    min-width: 210px;
  }

  @media (max-width: 749px) {
    .ai-comparison-section-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-comparison-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.7 }}px;
    }

    .ai-comparison-table-{{ ai_gen_id }} {
      font-size: {{ block.settings.table_font_size | minus: 2 }}px;
      min-width: 860px;
    }

    .ai-comparison-table-{{ ai_gen_id }} th,
    .ai-comparison-table-{{ ai_gen_id }} td {
      padding: 10px 14px;
    }
  }

  @media (max-width: 480px) {
    .ai-comparison-table-{{ ai_gen_id }} {
      font-size: {{ block.settings.table_font_size | minus: 3 }}px;
      min-width: 800px;
    }

    .ai-comparison-table-{{ ai_gen_id }} th,
    .ai-comparison-table-{{ ai_gen_id }} td {
      padding: 8px 10px;
    }
  }
{% endstyle %}

<product-comparison-{{ ai_gen_id }} class="ai-comparison-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
{% if block.settings.section_title != blank %}
  <h2 class="ai-comparison-title-{{ ai_gen_id }}">
    {{ block.settings.section_title }}
  </h2>
  {% if block.settings.subtitle != blank %}
    <div class="ai-comparison-subtitle-{{ ai_gen_id }} rte">{{ block.settings.subtitle }}</div>
  {% endif %}
{% endif %}

  <div class="ai-comparison-wrapper-{{ ai_gen_id }}">
    <table class="ai-comparison-table-{{ ai_gen_id }}">
      <thead>
        <tr>
          <th>{{ block.settings.header_spec }}</th>
          <th>{{ block.settings.header_product_1 }}</th>
          <th>{{ block.settings.header_product_2 }}</th>
          <th>{{ block.settings.header_product_3 }}</th>
          <th>{{ block.settings.header_product_4 }}</th>
        </tr>
      </thead>
      <tbody>
        {% for i in (1..10) %}
          {% liquid
            assign row_source = 'product'
            case i
              when 1
                assign row_spec = 'Speicherkapazität'
                assign row_keys = 'capacity,speicherkapazitat,speicherkapazitaet,speicherkapazität,storage_capacity'
                assign row_source = 'variant'
              when 2
                assign row_spec = 'Bidirektionale Leistung'
                assign row_keys = 'bidirectional_power,bidirektionale_leistung,leistung'
              when 3
                assign row_spec = 'Notstromleistung'
                assign row_keys = 'backup_power,notstromleistung,emergency_power,notstrom'
              when 4
                assign row_spec = 'EPS-Umschaltzeit'
                assign row_keys = 'eps_switch_time,eps_umschaltzeit,eps_switching_time,eps_transfer_time'
              when 5
                assign row_spec = 'Ladezyklen'
                assign row_keys = 'cycles,ladezyklen,charging_cycles,cycle_life,lebenszyklen'
              when 6
                assign row_spec = 'Erweiterbarkeit'
                assign row_keys = 'scalability,erweiterbarkeit,expandability,max_erweiterung'
              when 7
                assign row_spec = 'Nulleinspeisung'
                assign row_keys = 'nulleinspeisung,zero_export,zero_feed_in,zero_injection'
              when 8
                assign row_spec = 'VPP-Unterstützung'
                assign row_keys = 'vpp,vpp_support,vpp_unterstutzung,vpp_unterstuetzung'
              when 9
                assign row_spec = 'Installation'
                assign row_keys = 'installation,installation_type'
              when 10
                assign row_spec = 'Ideal für'
                assign row_keys = 'ideal_fur,ideal_fuer,ideal_for,recommended_for'
            endcase
          %}
          <tr>
            <td>{{ row_spec }}</td>
            {% for product_index in (1..4) %}
              {% liquid
                assign product_setting_key = 'comparison_product_' | append: product_index
                assign comparison_product = block.settings[product_setting_key]
              %}
              {% capture metafield_value %}{% render 'product-comparison-value', spec_product: comparison_product, spec_source: row_source, spec_variant_option: '1×', spec_keys: row_keys, spec_namespace: settings.technical_specs_namespace %}{% endcapture %}
              {% assign display_value = metafield_value | strip %}
              <td>{% if display_value == blank %}–{% else %}{{ display_value }}{% endif %}</td>
            {% endfor %}
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</product-comparison-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductComparison{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.table = this.querySelector('.ai-comparison-table-{{ ai_gen_id }}');
      }
    }

    customElements.define('product-comparison-{{ ai_gen_id }}', ProductComparison{{ ai_gen_id }});
  })();
</script>

