{% doc %}
  @prompt
    <style>
    /* ===== 全局统一按钮样式 ===== */
    :root {
      --brand-blue: #224378;
      --highlight-yellow: #FFDD57;
      --btn-radius: 6px;
      --btn-padding: 17px 38px;
      --btn-fontsize: 17px;
      --btn-fontweight: 600;
      --btn-transition: all 0.25s ease;
    }
    
    .btn-primary-main {
      padding: var(--btn-padding);
      background-color: var(--brand-blue);
      color: #ffffff;
      border: none;
      border-radius: var(--btn-radius);
      font-size: var(--btn-fontsize);
      font-weight: var(--btn-fontweight);
      text-decoration: none;
      transition: var(--btn-transition);
      display: inline-block;
      text-align: center;
    }
    
    .btn-primary-main:hover {
      background-color: #1a355c;
      transform: translateY(-3px);
    }
    
    .btn-outline-secondary {
      padding: var(--btn-padding);
      background: transparent;
      color: #ffffff;
      border: 2px solid #ffffff;
      border-radius: var(--btn-radius);
      font-size: var(--btn-fontsize);
      font-weight: var(--btn-fontweight);
      text-decoration: none;
      transition: var(--btn-transition);
      display: inline-block;
      text-align: center;
    }
    
    .btn-outline-secondary:hover {
      background-color: rgba(255,255,255,0.12);
      transform: translateY(-3px);
    }
    
    /* ===== 整页轮播Hero ===== */
    .venus-e-fullpage-slider {
      width: 100%;
      min-height: 88vh;
      position: relative;
      overflow: hidden;
      color: #ffffff;
    }
    
    .slide-wrapper {
      display: flex;
      width: 400%;
      height: 100%;
      transition: transform 0.6s ease-in-out;
    }
    
    .slide-item {
      width: 25%;
      min-height: 88vh;
      position: relative;
      display: flex;
      align-items: center;
      background-size: cover;
      background-position: center right;
      background-repeat: no-repeat;
    }
    
    /* 每张背景图单独替换 */
    .slide-venus-3-0 {
      background-image: url('替换Venus E 3.0阳台庭院场景大图，产品主体在右侧');
    }
    
    .slide-venus-mini {
      background-image: url('替换Venus E Mini阳台场景大图，产品主体在右侧');
    }
    
    .slide-venus-4-0 {
      background-image: url('替换Venus E 4.0庭院场景大图，产品主体在右侧');
    }
    
    .slide-venus-max {
      background-image: url('替换Venus E Max全屋储能场景大图，产品主体在右侧');
    }
    
    /* 左侧遮罩，不遮挡右侧产品 */
    .slide-dark-mask {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(to right, rgba(0,0,0,0.66) 0%, rgba(0,0,0,0.38) 45%, rgba(0,0,0,0.12) 70%);
      z-index: 1;
    }
    
    /* 左侧文字内容 */
    .slide-content {
      position: relative;
      z-index: 2;
      width: 100%;
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 32px;
      display: flex;
      justify-content: flex-start;
    }
    
    .slide-text-block {
      max-width: 520px;
    }
    
    .slide-kicker {
      font-size: 16px;
      font-weight: 600;
      color: var(--highlight-yellow);
      letter-spacing: 0.6px;
      margin-bottom: 20px;
      display: inline-block;
    }
    
    .slide-title {
      font-size: clamp(30px, 5vw, 54px);
      font-weight: 700;
      line-height: 1.25;
      margin: 0 0 24px 0;
    }
    
    .slide-desc {
      font-size: clamp(16px, 2vw, 20px);
      line-height: 1.7;
      opacity: 0.92;
      margin: 0 0 40px 0;
    }
    
    .slide-buttons {
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
    }
    
    /* ===== 居中轮播指示器 ===== */
    .slide-dots {
      position: absolute;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 10px;
      z-index: 3;
    }
    
    .slide-dot {
      width: 11px;
      height: 11px;
      border-radius: 50%;
      background: rgba(255,255,255,0.35);
      cursor: pointer;
      transition: background 0.2s ease;
    }
    
    .slide-dot.active {
      background: var(--highlight-yellow);
    }
    
    /* ===== 左右切换箭头 ===== */
    .slide-arrow {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 3;
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: rgba(255,255,255,0.08);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 20px;
      border: 1px solid rgba(255,255,255,0.15);
      transition: background 0.2s ease;
    }
    
    .slide-arrow:hover {
      background: rgba(255,255,255,0.18);
    }
    
    .slide-arrow.prev {
      left: 24px;
    }
    
    .slide-arrow.next {
      right: 24px;
    }
    
    /* ===== 移动端适配 ===== */
    @media screen and (max-width: 768px) {
      .venus-e-fullpage-slider {
        min-height: 92vh;
      }
    
      .slide-item {
        min-height: 92vh;
        background-position: center center;
      }
    
      .slide-dark-mask {
        background: rgba(0,0,0,0.58);
      }
    
      .slide-content {
        padding: 0 16px;
      }
    
      .slide-text-block {
        max-width: 100%;
      }
    
      .slide-arrow {
        display: none;
      }
    
      .slide-dots {
        bottom: 16px;
      }
    }
    </style>
    
    <section class="venus-e-fullpage-slider">
      <div class="slide-wrapper" id="fullpageSlider">
        <!-- Slide 1 主推 Venus E 3.0 -->
        <div class="slide-item slide-venus-3-0">
          <div class="slide-dark-mask"></div>
          <div class="slide-content">
            <div class="slide-text-block">
              <div class="slide-kicker">🚀 Ab 929 € sofort lieferbar</div>
              <h2 class="slide-title">Venus E 3.0 | 5,12 kWh</h2>
              <p class="slide-desc">
                Das sofort verfügbare Balkonspeicher-Modell mit großer Kapazität. Ideal für Haushalte, die mehr Eigenverbrauch und Notstromfunktion wollen.
              </p>
              <div class="slide-buttons">
                <a href="/products/venus-e-3-0" class="btn-primary-main">Jetzt kaufen</a
