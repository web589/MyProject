          --card-width: 60%;
    
          /* 卡片之间的间距 */
          --card-gap: 24px;
    
          /* 右侧额外留白（在卡片轨道尾部增加，使右侧露出部分更宽） */
          --track-padding-right: 0px;  /* 增大此值可让右侧露出更多空白 */
        }
    
        /* ===== 整体区块 ===== */
        .power-section {
          max-width: 1280px;
