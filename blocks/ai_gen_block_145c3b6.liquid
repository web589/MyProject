{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-power-carousel-{{ ai_gen_id }} {
    display: block;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto {{ block.settings.bottom_margin }}px;
    padding: 0 {{ block.settings.padding_left }}px 0 {{ block.settings.padding_right }}px;
    font-family: {{ block.settings.font_family.family }}, {{ block.settings.font_family.fallback_families }};
    width: {{ block.settings.desktop_width_percent }}%;
  }

  .ai-power-carousel__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    color: {{ block.settings.title_color }};
    margin-bottom: {{ block.settings.title_margin }}px;
    letter-spacing: -0.5px;
    text-align: {{ block.settings.title_alignment }};
  }

  .ai-power-carousel__title-{{ ai_gen_id }} span {
    color: {{ block.settings.title_accent_color }};
  }

  .ai-power-carousel__wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.carousel_border_radius }}px;
  }

  .ai-power-carousel__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    will-change: transform;
    padding-right: {{ block.settings.track_padding_right }}px;
  }

  .ai-power-carousel__card-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.card_width }}%;
    aspect-ratio: 16 / 9;
    border-radius: {{ block.settings.card_border_radius }}px;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    position: relative;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    transition: transform 0.3s ease;
  }

  .ai-power-carousel__card-{{ ai_gen_id }}:hover {
    transform: scale(1.01);
  }

  .ai-power-carousel__card-overlay-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(0, 0, 0, {{ block.settings.overlay_opacity }}) 0%, rgba(0, 0, 0, {{ block.settings.overlay_opacity | times: 0.15 }}) 60%);
    pointer-events: none;
  }

  .ai-power-carousel__card-text-{{ ai_gen_id }} {
    position: absolute;
    bottom: 28px;
    left: 28px;
    z-index: 2;
    max-width: 60%;
    color: {{ block.settings.card_text_color }};
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.5);
    pointer-events: none;
  }

  .ai-power-carousel__card-text-{{ ai_gen_id }} h3 {
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: 700;
    margin: 0 0 6px 0;
    letter-spacing: -0.3px;
  }

  .ai-power-carousel__card-text-{{ ai_gen_id }} p {
    font-size: {{ block.settings.card_description_size }}px;
    margin: 0;
    opacity: 0.92;
    line-height: 1.5;
    font-weight: 400;
    max-width: 400px;
  }

  .ai-power-carousel__card-btn-{{ ai_gen_id }} {
    position: absolute;
    bottom: 28px;
    right: 28px;
    z-index: 2;
    pointer-events: auto;
  }

  .ai-power-carousel__card-btn-{{ ai_gen_id }} a {
    display: inline-block;
    padding: 10px 28px;
    background: {{ block.settings.button_bg_color }};
    backdrop-filter: blur(4px);
    color: {{ block.settings.button_text_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    text-decoration: none;
    font-weight: 600;
    font-size: {{ block.settings.button_font_size }}px;
    transition: all 0.25s ease;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.3);
  }

  .ai-power-carousel__card-btn-{{ ai_gen_id }} a:hover {
    background: {{ block.settings.button_hover_bg_color }};
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.15);
  }

  .ai-power-carousel__nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: none;
    background: {{ block.settings.nav_bg_color }};
    backdrop-filter: blur(6px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.10);
    font-size: 26px;
    font-weight: 300;
    color: {{ block.settings.nav_icon_color }};
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.25s ease;
    user-select: none;
    border: 1px solid rgba(255, 255, 255, 0.4);
  }

  .ai-power-carousel__nav-{{ ai_gen_id }}:hover {
    background: {{ block.settings.nav_hover_bg_color }};
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.15);
    transform: translateY(-50%) scale(1.04);
  }

  .ai-power-carousel__nav-{{ ai_gen_id }}:active {
    transform: translateY(-50%) scale(0.94);
  }

  .ai-power-carousel__nav-{{ ai_gen_id }}--prev {
    left: 16px;
  }

  .ai-power-carousel__nav-{{ ai_gen_id }}--next {
    right: 16px;
  }

  .ai-power-carousel__placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-power-carousel__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  @media screen and (max-width: 749px) {
    .ai-power-carousel__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.7 }}px;
    }

    .ai-power-carousel__card-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.card_width_mobile }}%;
    }

    .ai-power-carousel__card-text-{{ ai_gen_id }} h3 {
      font-size: {{ block.settings.card_title_size | times: 0.8 }}px;
    }

    .ai-power-carousel__card-text-{{ ai_gen_id }} p {
      font-size: {{ block.settings.card_description_size | times: 0.9 }}px;
    }

    .ai-power-carousel__nav-{{ ai_gen_id }} {
      width: 40px;
      height: 40px;
      font-size: 20px;
    }
  }
{% endstyle %}

<power-carousel-{{ ai_gen_id }} class="ai-power-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.section_title != blank %}
    <h2 class="ai-power-carousel__title-{{ ai_gen_id }}">
      {{ block.settings.section_title }}
    </h2>
  {% endif %}

  <div class="ai-power-carousel__wrapper-{{ ai_gen_id }}">
    <div class="ai-power-carousel__track-{{ ai_gen_id }}" data-track>
      {% for i in (1..3) %}
        {% liquid
          assign image_key = 'card_' | append: i | append: '_image'
          assign title_key = 'card_' | append: i | append: '_title'
          assign description_key = 'card_' | append: i | append: '_description'
          assign button_text_key = 'card_' | append: i | append: '_button_text'
          assign button_url_key = 'card_' | append: i | append: '_button_url'

          assign card_image = block.settings[image_key]
          assign card_title = block.settings[title_key]
          assign card_description = block.settings[description_key]
          assign button_text = block.settings[button_text_key]
          assign button_url = block.settings[button_url_key]
        %}

        <div
          class="ai-power-carousel__card-{{ ai_gen_id }}"
          {% if card_image %}
            style="background-image: url('{{ card_image | image_url: width: 1600 }}');"
          {% endif %}
        >
          {% unless card_image %}
            <div class="ai-power-carousel__placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endunless %}

          <div class="ai-power-carousel__card-overlay-{{ ai_gen_id }}"></div>

          {% if card_title != blank or card_description != blank %}
            <div class="ai-power-carousel__card-text-{{ ai_gen_id }}">
              {% if card_title != blank %}
                <h3>{{ card_title }}</h3>
              {% endif %}
              {% if card_description != blank %}
                <p>{{ card_description }}</p>
              {% endif %}
            </div>
          {% endif %}

          {% if button_text != blank and button_url != blank %}
            <div class="ai-power-carousel__card-btn-{{ ai_gen_id }}">
              <a href="{{ button_url }}">{{ button_text }}</a>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {% if block.settings.show_navigation %}
      <button
        class="ai-power-carousel__nav-{{ ai_gen_id }} ai-power-carousel__nav-{{ ai_gen_id }}--prev"
        data-prev
        aria-label="Previous slide"
      >
        ‹
      </button>
      <button
        class="ai-power-carousel__nav-{{ ai_gen_id }} ai-power-carousel__nav-{{ ai_gen_id }}--next"
        data-next
        aria-label="Next slide"
      >
        ›
      </button>
    {% endif %}
  </div>
</power-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class PowerCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.track = this.querySelector('[data-track]');
        this.prevBtn = this.querySelector('[data-prev]');
        this.nextBtn = this.querySelector('[data-next]');
        this.cards = this.querySelectorAll('.ai-power-carousel__card-{{ ai_gen_id }}');
        this.totalCards = this.cards.length;
      }

      connectedCallback() {
        if (this.prevBtn && this.nextBtn) {
          this.prevBtn.addEventListener('click', () => this.navigate(-1));
          this.nextBtn.addEventListener('click', () => this.navigate(1));
        }

        let startX = 0;
        let currentX = 0;
        let isDragging = false;

        this.track.addEventListener('touchstart', (e) => {
          startX = e.touches[0].clientX;
          isDragging = true;
        });

        this.track.addEventListener('touchmove', (e) => {
          if (!isDragging) return;
          currentX = e.touches[0].clientX;
        });

        this.track.addEventListener('touchend', () => {
          if (!isDragging) return;
          const diff = startX - currentX;
          if (Math.abs(diff) > 50) {
            this.navigate(diff > 0 ? 1 : -1);
          }
          isDragging = false;
        });
      }

      navigate(direction) {
        this.currentIndex += direction;

        if (this.currentIndex < 0) {
          this.currentIndex = this.totalCards - 1;
        } else if (this.currentIndex >= this.totalCards) {
          this.currentIndex = 0;
        }

        this.updateCarousel();
      }

      updateCarousel() {
        const cardWidth = this.cards[0].offsetWidth;
        const gap = {{ block.settings.card_gap }};
        const offset = -(this.currentIndex * (cardWidth + gap));
        this.track.style.transform = `translateX(${offset}px)`;
      }
    }

    customElements.define('power-carousel-{{ ai_gen_id }}', PowerCarousel{{ ai_gen_id }});
  })();
</script>

