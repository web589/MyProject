{% doc %}
  @prompt
    {% comment %}
    Impulse 4图商品轮播 | 兼容OS2.0
    适合：送货上门/产品实景大图轮播
    无JS滚轮冲突，不会锁住页面滚动
    {% endcomment %}
    <style>
    .delivery-slider-wrap {
      position: relative;
      overflow: hidden;
      width: 100%;
    }
    .delivery-slider-track {
      display: flex;
      transition: transform 0.6s ease-in-out;
    }
    .delivery-slide {
      flex: 0 0 100%;
    }
    .delivery-slide img {
      width: 100%;
      display: block;
      object-fit: cover;
    }
    /* 左右箭头 */
    .slider-arrow {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 46px;
      height: 46px;
      border-radius: 50%;
      background: rgba(255,255,255,0.3);
      backdrop-filter: blur(3px);
      border: none;
      font-size: 22px;
      cursor: pointer;
      z-index: 8;
      color: #000;
      transition: 0.2s;
    }
    .slider-arrow:hover {
      background: rgba(255,255,255,0.6);
    }
    .arrow-prev {left: 16px;}
    .arrow-next {right: 16px;}
    /* 底部圆点 */
    .slider-dots {
      position: absolute;
      bottom: 14px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 10px;
      z-index: 8;
    }
    .slider-dot {
      width: 11px;
      height: 11px;
      border-radius: 50%;
      border: 0;
      background: rgba(0,0,0,0.25);
      padding: 0;
      cursor: pointer;
    }
    .slider-dot.active {
      background: #000;
    }
    @media screen and (max-width:749px){
      .slider-arrow{width:36px;height:36px;font-size:16px;}
    }
    </style>
    
    <div class="delivery-slider-wrap" data-autoplay="{{ section.settings.autoplay }}">
      <div class="delivery-slider-track">
        {% for block in section.blocks %}
        <div class="delivery-slide">
          {% if block.settings.slide_image %}
            <a href="{{ block.settings.slide_link }}">
              {% assign slide_img = block.settings.slide_image | image_url: width: 2000 %}
              <img src="{{ slide_img }}" alt="{{ block.settings.alt_text }}">
            </a>
          {% endif %}
        </div>
        {% endfor %}
      </div>
    
      <button class="slider-arrow arrow-prev">‹</button>
      <button class="slider-arrow arrow-next">›</button>
    
      <div class="slider-dots">
        {% for block in section.blocks %}
          <button class="slider-dot{% if forloop.first %} active{% endif %}"></button>
        {% endfor %}
      </div>
    </div>
    
    <script>
    (function(){
      const wrap = document.querySelector('.delivery-slider-wrap');
      const track = wrap.querySelector('.delivery-slider-track');
      const slides = wrap.querySelectorAll('.delivery-slide');
      const prevBtn = wrap.querySelector('.arrow-prev');
      const nextBtn = wrap.querySelector('.arrow-next');
      const dots = wrap.querySelectorAll('.slider-dot');
      const autoPlayEnable = wrap.dataset.autoplay === 'true';
    
      let currentIndex = 0;
      const slideCount = slides.length;
      let autoTimer;
    
      function renderSlide(){
        track.style.transform = `translateX(-${currentIndex * 100}%)`;
        dots.forEach((dot,i) => dot.classList.toggle('active', i === currentIndex));
      }
      function goNext(){
        currentIndex = currentIndex >= slideCount - 1 ? 0 : currentIndex + 1;
        renderSlide();
      }
      function goPrev(){
        currentIndex = currentIndex <= 0 ? slideCount - 1 : currentIndex - 1;
        renderSlide();
      }
      prevBtn.addEventListener('click', goPrev);
      nextBtn.addEventListener('click', goNext);
      dots.forEach((dot, idx)=>{
        dot.addEventListener('click', ()=>{
          currentIndex = idx;
          renderSlide();
        })
      })
    
      //自动播放逻辑
      if(autoPlayEnable && slideCount > 1){
        function startAuto(){
          autoTimer = setInterval(goNext, 6000);
        }
        startAuto();
        wrap.addEventListener('mouseenter', ()=>clearInterval(autoTimer));
        wrap.addEventListener('mouseleave', startAuto);
      }
    })();
    </script>
    
    {% schema %}
    {
      "name": "Bild Slider | 4张大图轮播",
      "presets": [
        {
          "name": "Slider erstellen",
          "blocks": [
            {"type":"slide"},
            {"type":"slide"},
            {"type":"slide"},
            {"type":"slide"}
          ]
        }
      ],
      "settings": [
        {
          "type":"checkbox",
          "id":"autoplay",
          "label":"Automatisch wechseln",
          "default": true
        }
      ],
      "blocks": [
        {
          "type":"slide",
          "name":"Einzelner Slide",
          "settings": [
            {
              "type":"image_picker",
              "id":"slide_image",
              "label":"Banner Bild (Empfehlung 1920×960)"
            },
            {
              "type":"url",
              "id":"slide_link",
              "label":"Ziel-Link bei Klick"
            },
            {
              "type":"text",
              "id":"alt_text",
              "label":"Alt-Text (SEO Deutsch)",
              "default":"Balkonkraftwerk Speicher Lieferung"
            }
          ]
        }
      ]
    }
    {% endschema %}
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-delivery-slider-{{ ai_gen_id }} {
    display: block;
    position: relative;
    overflow: hidden;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-delivery-slider-track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.6s ease-in-out;
  }

  .ai-delivery-slide-{{ ai_gen_id }} {
    flex: 0 0 100%;
  }

  .ai-delivery-slide-{{ ai_gen_id }} img {
    width: 100%;
    display: block;
    object-fit: cover;
  }

  .ai-delivery-slide-{{ ai_gen_id }} a {
    display: block;
  }

  .ai-delivery-slide-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-delivery-slide-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-slider-arrow-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: {{ block.settings.arrow_background }};
    backdrop-filter: blur(3px);
    border: none;
    font-size: 22px;
    cursor: pointer;
    z-index: 8;
    color: {{ block.settings.arrow_color }};
    transition: 0.2s;
  }

  .ai-slider-arrow-{{ ai_gen_id }}:hover {
    background: {{ block.settings.arrow_hover_background }};
  }

  .ai-arrow-prev-{{ ai_gen_id }} {
    left: 16px;
  }

  .ai-arrow-next-{{ ai_gen_id }} {
    right: 16px;
  }

  .ai-slider-dots-{{ ai_gen_id }} {
    position: absolute;
    bottom: 14px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 10px;
    z-index: 8;
  }

  .ai-slider-dot-{{ ai_gen_id }} {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 0;
    background: {{ block.settings.dot_color }};
    padding: 0;
    cursor: pointer;
    transition: background 0.3s ease;
  }

  .ai-slider-dot-{{ ai_gen_id }}.active {
    background: {{ block.settings.dot_active_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-slider-arrow-{{ ai_gen_id }} {
      width: 36px;
      height: 36px;
      font-size: 16px;
    }
  }
{% endstyle %}

<delivery-slider-{{ ai_gen_id }}
  class="ai-delivery-slider-{{ ai_gen_id }}"
  data-autoplay="{{ block.settings.autoplay }}"
  data-interval="{{ block.settings.autoplay_interval | times: 1000 }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-delivery-slider-track-{{ ai_gen_id }}">
    {% if block.settings.slide_1_image %}
      <div class="ai-delivery-slide-{{ ai_gen_id }}">
        {% if block.settings.slide_1_link != blank %}
          <a href="{{ block.settings.slide_1_link }}">
            <img
              src="{{ block.settings.slide_1_image | image_url: width: 2000 }}"
              alt="{{ block.settings.slide_1_alt | escape }}"
              loading="lazy"
              width="{{ block.settings.slide_1_image.width }}"
              height="{{ block.settings.slide_1_image.height }}"
            >
          </a>
        {% else %}
          <img
            src="{{ block.settings.slide_1_image | image_url: width: 2000 }}"
            alt="{{ block.settings.slide_1_alt | escape }}"
            loading="lazy"
            width="{{ block.settings.slide_1_image.width }}"
            height="{{ block.settings.slide_1_image.height }}"
          >
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.slide_2_image %}
      <div class="ai-delivery-slide-{{ ai_gen_id }}">
        {% if block.settings.slide_2_link != blank %}
          <a href="{{ block.settings.slide_2_link }}">
            <img
              src="{{ block.settings.slide_2_image | image_url: width: 2000 }}"
              alt="{{ block.settings.slide_2_alt | escape }}"
              loading="lazy"
              width="{{ block.settings.slide_2_image.width }}"
              height="{{ block.settings.slide_2_image.height }}"
            >
          </a>
        {% else %}
          <img
            src="{{ block.settings.slide_2_image | image_url: width: 2000 }}"
            alt="{{ block.settings.slide_2_alt | escape }}"
            loading="lazy"
            width="{{ block.settings.slide_2_image.width }}"
            height="{{ block.settings.slide_2_image.height }}"
          >
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.slide_3_image %}
      <div class="ai-delivery-slide-{{ ai_gen_id }}">
        {% if block.settings.slide_3_link != blank %}
          <a href="{{ block.settings.slide_3_link }}">
            <img
              src="{{ block.settings.slide_3_image | image_url: width: 2000 }}"
              alt="{{ block.settings.slide_3_alt | escape }}"
              loading="lazy"
              width="{{ block.settings.slide_3_image.width }}"
              height="{{ block.settings.slide_3_image.height }}"
            >
          </a>
        {% else %}
          <img
            src="{{ block.settings.slide_3_image | image_url: width: 2000 }}"
            alt="{{ block.settings.slide_3_alt | escape }}"
            loading="lazy"
            width="{{ block.settings.slide_3_image.width }}"
            height="{{ block.settings.slide_3_image.height }}"
