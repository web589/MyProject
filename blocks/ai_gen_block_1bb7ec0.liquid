        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.slide_4_image %}
      <div class="ai-delivery-slide-{{ ai_gen_id }}">
        {% if block.settings.slide_4_link != blank %}
          <a href="{{ block.settings.slide_4_link }}">
            <img
              src="{{ block.settings.slide_4_image | image_url: width: 2000 }}"
              alt="{{ block.settings.slide_4_alt | escape }}"
              loading="lazy"
              width="{{ block.settings.slide_4_image.width }}"
              height="{{ block.settings.slide_4_image.height }}"
            >
          </a>
        {% else %}
          <img
            src="{{ block.settings.slide_4_image | image_url: width: 2000 }}"
            alt="{{ block.settings.slide_4_alt | escape }}"
            loading="lazy"
            width="{{ block.settings.slide_4_image.width }}"
            height="{{ block.settings.slide_4_image.height }}"
          >
        {% endif %}
      </div>
    {% endif %}

    {% unless block.settings.slide_1_image or block.settings.slide_2_image or block.settings.slide_3_image or block.settings.slide_4_image %}
      <div class="ai-delivery-slide-{{ ai_gen_id }}">
        <div class="ai-delivery-slide-placeholder-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
        </div>
      </div>
    {% endunless %}
  </div>

  {% if block.settings.show_arrows %}
    <button class="ai-slider-arrow-{{ ai_gen_id }} ai-arrow-prev-{{ ai_gen_id }}" aria-label="Previous slide">‹</button>
    <button class="ai-slider-arrow-{{ ai_gen_id }} ai-arrow-next-{{ ai_gen_id }}" aria-label="Next slide">›</button>
  {% endif %}

  {% if block.settings.show_dots %}
    <div class="ai-slider-dots-{{ ai_gen_id }}">
      {% if block.settings.slide_1_image %}
        <button class="ai-slider-dot-{{ ai_gen_id }} active" aria-label="Go to slide 1"></button>
      {% endif %}
      {% if block.settings.slide_2_image %}
        <button class="ai-slider-dot-{{ ai_gen_id }}" aria-label="Go to slide 2"></button>
      {% endif %}
      {% if block.settings.slide_3_image %}
        <button class="ai-slider-dot-{{ ai_gen_id }}" aria-label="Go to slide 3"></button>
      {% endif %}
      {% if block.settings.slide_4_image %}
        <button class="ai-slider-dot-{{ ai_gen_id }}" aria-label="Go to slide 4"></button>
      {% endif %}
    </div>
  {% endif %}
</delivery-slider-{{ ai_gen_id }}>

<script>
(function() {
  class DeliverySlider{{ ai_gen_id }} extends HTMLElement {
    constructor() {
      super();
      this.track = this.querySelector('.ai-delivery-slider-track-{{ ai_gen_id }}');
      this.slides = this.querySelectorAll('.ai-delivery-slide-{{ ai_gen_id }}');
      this.prevBtn = this.querySelector('.ai-arrow-prev-{{ ai_gen_id }}');
      this.nextBtn = this.querySelector('.ai-arrow-next-{{ ai_gen_id }}');
      this.dots = this.querySelectorAll('.ai-slider-dot-{{ ai_gen_id }}');
      this.autoPlayEnable = this.dataset.autoplay === 'true';
      this.interval = parseInt(this.dataset.interval) || 6000;
      this.currentIndex = 0;
      this.slideCount = this.slides.length;
      this.autoTimer = null;
    }

    connectedCallback() {
      if (this.slideCount <= 1) return;

      if (this.prevBtn) {
        this.prevBtn.addEventListener('click', () => this.goPrev());
      }
      if (this.nextBtn) {
        this.nextBtn.addEventListener('click', () => this.goNext());
      }

      this.dots.forEach((dot, idx) => {
        dot.addEventListener('click', () => {
          this.currentIndex = idx;
          this.renderSlide();
          if (this.autoPlayEnable) {
            this.resetAutoPlay();
          }
        });
      });

      if (this.autoPlayEnable) {
        this.startAutoPlay();
        this.addEventListener('mouseenter', () => this.stopAutoPlay());
        this.addEventListener('mouseleave', () => this.startAutoPlay());
      }
    }

    renderSlide() {
      this.track.style.transform = `translateX(-${this.currentIndex * 100}%)`;
      this.dots.forEach((dot, i) => {
        dot.classList.toggle('active', i === this.currentIndex);
      });
    }

    goNext() {
      this.currentIndex = this.currentIndex >= this.slideCount - 1 ? 0 : this.currentIndex + 1;
      this.renderSlide();
    }

    goPrev() {
      this.currentIndex = this.currentIndex <= 0 ? this.slideCount - 1 : this.currentIndex - 1;
      this.renderSlide();
    }

    startAutoPlay() {
      if (!this.autoPlayEnable || this.slideCount <= 1) return;
      this.autoTimer = setInterval(() => this.goNext(), this.interval);
    }

    stopAutoPlay() {
      if (this.autoTimer) {
        clearInterval(this.autoTimer);
        this.autoTimer = null;
      }
    }

    resetAutoPlay() {
      this.stopAutoPlay();
      this.startAutoPlay();
    }
  }

  customElements.define('delivery-slider-{{ ai_gen_id }}', DeliverySlider{{ ai_gen_id }});
})();
</script>

