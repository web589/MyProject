{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-scroll-bar-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.bar_height }}px;
    display: flex;
    align-items: center;
    background: {{ block.settings.background_gradient_start }};
    {% if block.settings.use_gradient %}
      background: linear-gradient(90deg, {{ block.settings.background_gradient_start }}, {{ block.settings.background_gradient_end }});
    {% endif %}
    overflow: hidden;
  }

  .ai-scroll-inner-{{ ai_gen_id }} {
    display: flex;
    white-space: nowrap;
    animation: ai-scroll-move-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
  }

  .ai-scroll-bar-{{ ai_gen_id }}:hover .ai-scroll-inner-{{ ai_gen_id }} {
    animation-play-state: paused;
  }

  .ai-scroll-item-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    text-decoration: none;
    padding: 0 {{ block.settings.item_spacing }}px;
    display: inline-block;
  }

  .ai-scroll-item-{{ ai_gen_id }} span {
    font-weight: bold;
    color: {{ block.settings.highlight_color }};
  }

  .ai-scroll-item-{{ ai_gen_id }}:hover {
    text-decoration: underline;
  }

  @keyframes ai-scroll-move-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
{% endstyle %}

<div class="ai-scroll-bar-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-scroll-inner-{{ ai_gen_id }}">
    {% for i in (1..4) %}
      {% liquid
        assign label_key = 'item_' | append: i | append: '_label'
        assign text_key = 'item_' | append: i | append: '_text'
        assign url_key = 'item_' | append: i | append: '_url'
        assign enabled_key = 'item_' | append: i | append: '_enabled'

        assign item_label = block.settings[label_key]
        assign item_text = block.settings[text_key]
        assign item_url = block.settings[url_key]
        assign item_enabled = block.settings[enabled_key]
      %}

      {% if item_enabled and item_text != blank %}
        <a href="{{ item_url }}" class="ai-scroll-item-{{ ai_gen_id }}">
          {% if item_label != blank %}<span>{{ item_label }}</span> {% endif %}{{ item_text }}
        </a>
      {% endif %}
    {% endfor %}

    {% for i in (1..4) %}
      {% liquid
        assign label_key = 'item_' | append: i | append: '_label'
        assign text_key = 'item_' | append: i | append: '_text'
        assign url_key = 'item_' | append: i | append: '_url'
        assign enabled_key = 'item_' | append: i | append: '_enabled'

        assign item_label = block.settings[label_key]
        assign item_text = block.settings[text_key]
        assign item_url = block.settings[url_key]
        assign item_enabled = block.settings[enabled_key]
      %}

      {% if item_enabled and item_text != blank %}
        <a href="{{ item_url }}" class="ai-scroll-item-{{ ai_gen_id }}">
          {% if item_label != blank %}<span>{{ item_label }}</span> {% endif %}{{ item_text }}
        </a>
      {% endif %}
    {% endfor %}
  </div>
</div>

