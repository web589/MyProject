      <svg viewBox="0 0 24 24">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <button
      class="ai-nav-button-{{ ai_gen_id }} ai-nav-next-{{ ai_gen_id }}"
      aria-label="Next testimonial"
      data-nav="next"
    >
      <svg viewBox="0 0 24 24">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>
