          %}
          {% if testimonial_image != blank or testimonial_title != blank or testimonial_description != blank %}
            <div class="ai-testimonial-slide-{{ ai_gen_id }}">
              <div class="ai-testimonial-card-{{ ai_gen_id }}">
                {% if testimonial_image != blank %}{{ testimonial_image | image_url: width: 1200 | image_tag: class: testimonial_image_class, loading: 'lazy', widths: '480, 800, 1200', sizes: image_sizes, alt: testimonial_title }}{% endif %}
                <div class="ai-card-overlay-{{ ai_gen_id }}"></div>
                <div class="ai-card-content-{{ ai_gen_id }}">
                  {% if testimonial_rating > 0 %}<div class="ai-stars-{{ ai_gen_id }}">{% for star in (1..testimonial_rating) %}★{% endfor %}</div>{% endif %}
                  {% if testimonial_title != blank %}<h3 class="ai-card-title-{{ ai_gen_id }}">{{ testimonial_title }}</h3>{% endif %}
                  {% if testimonial_description != blank %}<p class="ai-card-desc-{{ ai_gen_id }}">{{ testimonial_description }}</p>{% endif %}
                  {% if testimonial_author != blank %}<span class="ai-card-author-{{ ai_gen_id }}">— {{ testimonial_author }}</span>{% endif %}
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      {% else %}
      {% for i in (1..10) %}
        {% liquid
          assign image_key = 'testimonial_' | append: i | append: '_image'
          assign title_key = 'testimonial_' | append: i | append: '_title'
          assign description_key = 'testimonial_' | append: i | append: '_description'
          assign author_key = 'testimonial_' | append: i | append: '_author'
          assign rating_key = 'testimonial_' | append: i | append: '_rating'

          assign testimonial_image = block.settings[image_key]
          assign testimonial_title = block.settings[title_key]
          assign testimonial_description = block.settings[description_key]
          assign testimonial_author = block.settings[author_key]
          assign testimonial_rating = block.settings[rating_key]
        %}

        {% if testimonial_title != blank or testimonial_description != blank %}
          <div class="ai-testimonial-slide-{{ ai_gen_id }}">
            <div class="ai-testimonial-card-{{ ai_gen_id }}">
              {% if testimonial_image %}
                <img
                  class="ai-card-bg-{{ ai_gen_id }}"
                  src="{{ testimonial_image | image_url: width: 1200 }}"
                  alt="{{ testimonial_image.alt | escape }}"
                  loading="lazy"
                  width="{{ testimonial_image.width }}"
                  height="{{ testimonial_image.height }}"
                >
              {% else %}
                <div class="ai-card-bg-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}

              <div class="ai-card-overlay-{{ ai_gen_id }}"></div>

              <div class="ai-card-content-{{ ai_gen_id }}">
                {% if testimonial_rating > 0 %}
                  <div class="ai-stars-{{ ai_gen_id }}">
                    {% for star in (1..testimonial_rating) %}★{% endfor %}
                  </div>
                {% endif %}

                {% if testimonial_title != blank %}
                  <h3 class="ai-card-title-{{ ai_gen_id }}">{{ testimonial_title }}</h3>
                {% endif %}

                {% if testimonial_description != blank %}
                  <p class="ai-card-desc-{{ ai_gen_id }}">{{ testimonial_description }}</p>
                {% endif %}

                {% if testimonial_author != blank %}
                  <span class="ai-card-author-{{ ai_gen_id }}">— {{ testimonial_author }}</span>
                {% endif %}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
      {% endif %}
    </div>

    <button
      class="ai-nav-button-{{ ai_gen_id }} ai-nav-prev-{{ ai_gen_id }}"
      aria-label="Previous testimonial"
      data-nav="prev"
