<script>
  (function() {
    class TestimonialCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.autoplayTimer = null;
      }

      connectedCallback() {
        this.carousel = this.querySelector('.ai-testimonial-carousel-{{ ai_gen_id }}');
        this.track = this.querySelector('.ai-testimonial-track-{{ ai_gen_id }}');
        this.slides = this.querySelectorAll('.ai-testimonial-slide-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('[data-nav="prev"]');
        this.nextButton = this.querySelector('[data-nav="next"]');
        this.defaultSlidesPerView = parseInt(this.dataset.slidesPerView) || 4;
        this.slidesPerView = this.defaultSlidesPerView;
        this.autoplay = this.dataset.autoplay === 'true';
        this.autoplayDelay = parseInt(this.dataset.autoplayDelay) || 5000;
        this.handleResize = () => this.updateSlidesPerView();

        this.setupEventListeners();
        this.updateButtons();
        this.updateSlidesPerView();

        if (this.autoplay) {
          this.startAutoplay();
        }

        window.addEventListener('resize', this.handleResize);
      }

      updateSlidesPerView() {
        const width = this.carousel ? this.carousel.offsetWidth : this.offsetWidth;
        if (width <= 749) {
          this.slidesPerView = 1;
        } else if (width <= 989) {
          this.slidesPerView = 2;
        } else {
          this.slidesPerView = this.defaultSlidesPerView;
        }
        const maxIndex = Math.max(this.slides.length - this.slidesPerView, 0);
        this.currentIndex = Math.min(this.currentIndex, maxIndex);
        this.updateSlidePosition();
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.prev());
        this.nextButton.addEventListener('click', () => this.next());

        this.addEventListener('mouseenter', () => this.stopAutoplay());
        this.addEventListener('mouseleave', () => {
          if (this.autoplay) {
            this.startAutoplay();
          }
        });
      }

      prev() {
        if (this.currentIndex > 0) {
          this.currentIndex--;
          this.updateSlidePosition();
        }
      }

      next() {
        const maxIndex = this.slides.length - this.slidesPerView;
        if (this.currentIndex < maxIndex) {
          this.currentIndex++;
          this.updateSlidePosition();
        } else if (this.autoplay) {
          this.currentIndex = 0;
          this.updateSlidePosition();
        }
      }

      updateSlidePosition() {
        if (!this.slides.length || !this.track) return;
        const slideWidth = this.slides[0].getBoundingClientRect().width;
        const gap = parseInt(getComputedStyle(this.track).gap) || 0;
        const offset = -(this.currentIndex * (slideWidth + gap));
        this.track.style.transform = `translateX(${offset}px)`;
        this.updateButtons();
      }

      updateButtons() {
        const maxIndex = Math.max(this.slides.length - this.slidesPerView, 0);
        this.prevButton.disabled = this.currentIndex === 0;
        this.nextButton.disabled = this.currentIndex >= maxIndex;
      }

      startAutoplay() {
        this.stopAutoplay();
        this.autoplayTimer = setInterval(() => {
          const maxIndex = Math.max(this.slides.length - this.slidesPerView, 0);
          if (this.currentIndex >= maxIndex) {
            this.currentIndex = 0;
          } else {
            this.currentIndex++;
          }
          this.updateSlidePosition();
        }, this.autoplayDelay);
      }

      stopAutoplay() {
        if (this.autoplayTimer) {
          clearInterval(this.autoplayTimer);
          this.autoplayTimer = null;
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
        window.removeEventListener('resize', this.handleResize);
      }
    }

    customElements.define('testimonial-carousel-{{ ai_gen_id }}', TestimonialCarousel{{ ai_gen_id }});
  })();
</script>

