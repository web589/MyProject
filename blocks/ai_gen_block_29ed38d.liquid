    <h2 class="ai-testimonial-heading-{{ ai_gen_id }}">{{ testimonial_heading }}</h2>
  {% endif %}
  {% if block.settings.subtitle != blank %}
    <div class="ai-testimonial-subtitle-{{ ai_gen_id }} rte">{{ block.settings.subtitle }}</div>
  {% endif %}

  <div class="ai-testimonial-carousel-{{ ai_gen_id }}">
    <div class="ai-testimonial-track-{{ ai_gen_id }}">
      {% if use_shared_testimonials %}
        {% for shared_testimonial in shared_testimonials limit: 10 %}
          {% liquid
            assign testimonial_image = shared_testimonial.image.value
            assign testimonial_title = shared_testimonial.title.value
            assign testimonial_description = shared_testimonial.description.value
            assign testimonial_author = shared_testimonial.author.value
            assign testimonial_rating = shared_testimonial.rating.value | default: 5
