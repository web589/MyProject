{% doc %}
  @prompt
    {% comment %}
    PDP组合购买模块（主图+放大镜+缩略图轮播+双组选项+联动结账卡）
    字体规范：Manrope Bold(700)标题 / Inter Regular(400)正文 / Inter Medium(500)标签 / Inter SemiBold(600)按钮
    左侧sticky固定，右侧滚动；选项卡选中联动结账卡图片/标题/总价
    {% endcomment %}
    {% liquid
    /* ===================== 全局配置区 ===================== */
    assign module_max_width = "1400px"
    assign module_top_margin = "40px"
    assign module_bottom_margin = "80px"
    assign module_padding_x = "24px"
    assign two_col_gap = "48px"
    
    /* 左侧主图 */
    assign main_img_size = "560px"           /* 正方形主图宽高 */
    assign main_img_radius = "12px"
    assign thumb_size = "110px"              /* 缩略图尺寸 */
    assign thumb_gap = "12px"
    assign thumb_visible = 4                 /* 同时显示几张缩略图 */
    
    /* 右侧标题 */
    assign product_title_text = "MARSTEK Venus E Gen 3.0 – Plug & Play Balkonspeicher"
    assign title_font_size = "32px"
    assign title_font_weight = "700"
    assign title_star_gap = "12px"
    
    /* 星级 */
    assign star_count = 5
    assign star_size = "20px"
    assign star_color = "#ffb400"
    assign star_desc_gap = "20px"
    
    /* 描述 */
    assign desc_text = "Der modulare Speicher für dein Balkonkraftwerk. Bis zu 10 kWh erweiterbar, 2400W PV-Eingang, über 40 % kompakter und 15 Jahre Lebensdauer. Plug-and-Play ohne Fachpersonal – perfekt für Mieter."
    assign desc_font_size = "15px"
    assign desc_font_weight = "400"
    assign desc_color = "#444444"
    assign desc_options_gap = "32px"
    
    /* 选项组小标题 */
    assign group_label_font_size = "14px"
    assign group_label_font_weight = "600"
    assign group_label_color = "#333333"
    assign group_label_gap = "12px"
    
    /* 选项卡 */
    assign option_card_radius = "10px"
    assign option_card_padding = "14px"
    assign option_img_size = "64px"
    assign option_img_radius = "8px"
    assign option_title_size = "15px"
    assign option_title_weight = "500"
    assign option_price_size = "16px"
    assign option_price_weight = "600"
    assign option_orig_price_size = "13px"
    assign option_gap = "12px"
    
    /* 颜色系统 */
    assign color_primary = "#1958d9"         /* 主蓝色 */
    assign color_primary_light = "#eef3fd"   /* 选中浅蓝背景 */
    assign color_border = "#e5e7eb"          /* 常态边框灰 */
    assign color_border_hover = "#c5cdd9"
    assign color_text_dark = "#111111"
    assign color_text_body = "#444444"
    assign color_text_muted = "#888888"
    assign color_green = "#00c853"           /* 绿色按钮 */
    assign color_green_dark = "#00a844"
    
    /* 结账卡 */
    assign checkout_card_radius = "14px"
    assign checkout_card_padding = "24px"
    assign checkout_img_size = "72px"
    assign total_label_size = "16px"
    assign total_price_size = "28px"
    assign total_orig_size = "16px"
    assign installment_text_size = "13px"
    
    /* 按钮 */
    assign btn_height = "56px"
    assign btn_radius = "10px"
    assign btn_font_size = "16px"
    assign btn_font_weight = "600"
    assign btn_gradient_left = "#00c853"
    assign btn_gradient_right = "#00a844"
    
    /* 底部特性 */
    assign feature_icon_size = "24px"
    assign feature_text_size = "14px"
    %}
    
    <style>
    :root {
      --font-heading: 'Manrope', sans-serif;
      --font-body: 'Inter', sans-serif;
      --primary: {{color_primary}};
      --primary-light: {{color_primary_light}};
      --border: {{color_border}};
      --border-hover: {{color_border_hover}};
      --text-dark: {{color_text_dark}};
      --text-body: {{color_text_body}};
      --text-muted: {{color_text_muted}};
      --green: {{color_green}};
      --green-dark: {{color_green_dark}};
    }
    .pdp-bundle-module {
      width: 100%;
      max-width: {{module_max_width}};
      margin: {{module_top_margin}} auto {{module_bottom_margin}};
      padding: 0 {{module_padding_x}};
      display: flex;
      gap: {{two_col_gap}};
      align-items: flex-start;
    }
    /* ========== 左侧：sticky固定 ========== */
    .pdp-left-col {
      width: {{main_img_size}};
      flex-shrink: 0;
      position: sticky;
      top: 20px;
      align-self: flex-start;
    }
    /* 主图放大镜容器 */
    .main-img-box {
      width: {{main_img_size}};
      height: {{main_img_size}};
      border-radius: {{main_img_radius}};
      border: 1px solid var(--border);
      position: relative;
      overflow: hidden;
      cursor: zoom-in;
      background: #fafafa;
    }
    .main-img-box img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
      pointer-events: none;
    }
    .magnifier-lens {
      position: absolute;
      width: 140px;
      height: 140px;
      border: 2px solid rgba(255,255,255,0.8);
      box-shadow: 0 0 0 9999px rgba(0,0,0,0.15);
      background-repeat: no-repeat;
      background-size: 400% 400%;
      display: none;
      pointer-events: none;
      z-index: 5;
    }
    /* 缩略图轮播 */
    .thumb-scroll-wrap {
      margin-top: 16px;
      position: relative;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .thumb-arrow {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      border: 1px solid var(--border);
      background: #fff;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      color: var(--text-body);
      flex-shrink: 0;
      transition: all 0.2s;
    }
    .thumb-arrow:hover { border-color: var(--primary); color: var(--primary); }
    .thumb-viewport {
      flex: 1;
      overflow: hidden;
    }
    .thumb-track {
      display: flex;
      gap: {{thumb_gap}};
      transition: transform 0.3s ease;
    }
    .thumb-item {
      width: {{thumb_size}};
      height: {{thumb_size}};
      border-radius: 8px;
