{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-feature-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-feature-grid-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 {{ block.settings.section_padding_horizontal }}px;
    box-sizing: border-box;
  }

  #shopify-block-{{ block.id }} {
    display: block;
    background-color: {{ block.settings.background_color }};
  }

  .ai-feature-grid-header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 32px;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-feature-grid-heading-{{ ai_gen_id }} {
    flex: 1 1 auto;
    min-width: 0;
    max-width: none;
  }

  .ai-feature-grid-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    color: {{ block.settings.title_color }};
    line-height: 1.2;
    letter-spacing: 0;
    margin: 0;
  }

  .ai-feature-grid-subtitle-{{ ai_gen_id }} {
    margin: 12px 0 0;
    color: #596b82;
    font-size: 16px;
    line-height: 1.6;
    letter-spacing: 0;
  }

  .ai-feature-grid-link-{{ ai_gen_id }} {
    font-size: {{ block.settings.link_size }}px;
    color: {{ block.settings.link_color }};
    text-decoration: none;
    font-weight: 500;
    transition: opacity 0.3s ease;
  }

  .ai-feature-grid-link-{{ ai_gen_id }}:hover {
    text-decoration: underline;
    opacity: 0.8;
  }

  .ai-feature-grid-cards-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1.7fr 0.9fr;
    grid-template-rows: 160px 88px 160px;
    gap: {{ block.settings.grid_gap }}px;
    grid-template-areas:
      "card1 card2 card3"
      "card1 card2 card5"
      "card1 card4 card5";
  }

  .ai-feature-card-{{ ai_gen_id }} {
    border-radius: {{ block.settings.card_radius }}px;
    position: relative;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.3s ease;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 28px 24px;
    min-height: 0;
    text-decoration: none;
  }

  .ai-feature-card-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
  }

  .ai-feature-card-1-{{ ai_gen_id }} {
    grid-area: card1;
  }

  .ai-feature-card-2-{{ ai_gen_id }} {
    grid-area: card2;
  }

  .ai-feature-card-3-{{ ai_gen_id }} {
    grid-area: card3;
  }

  .ai-feature-card-4-{{ ai_gen_id }} {
    grid-area: card4;
  }

  .ai-feature-card-5-{{ ai_gen_id }} {
    grid-area: card5;
  }

  .ai-feature-card-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .ai-feature-card-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .ai-feature-card-{{ ai_gen_id }}:hover .ai-feature-card-image-{{ ai_gen_id }} img {
    transform: scale(1.03);
  }

  .ai-feature-card-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-feature-card-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
    opacity: 0.3;
  }

  .ai-feature-card-overlay-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    background: linear-gradient(to top, rgba(0,0,0,{{ block.settings.overlay_opacity }}) 0%, rgba(0,0,0,{{ block.settings.overlay_opacity | times: 0.5 }}) 45%, rgba(0,0,0,0) 100%);
    margin: -28px -24px;
    padding: 56px 24px 28px;
    border-radius: {{ block.settings.card_radius }}px;
  }

  .ai-feature-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: 600;
    color: {{ block.settings.card_text_color }};
    line-height: 1.3;
    margin: 0;
  }

  .ai-feature-card-desc-wrap-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transform: translateY(18px);
    transition: max-height 0.35s ease, margin-top 0.35s ease, opacity 0.25s ease, transform 0.35s ease, visibility 0s linear 0.35s;
    margin-top: 0;
  }

  .ai-feature-card-{{ ai_gen_id }}:hover .ai-feature-card-desc-wrap-{{ ai_gen_id }},
  .ai-feature-card-{{ ai_gen_id }}:focus-visible .ai-feature-card-desc-wrap-{{ ai_gen_id }} {
    max-height: 300px;
    margin-top: 12px;
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition-delay: 0s;
  }

  .ai-feature-card-desc-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_desc_size }}px;
    line-height: 1.6;
    color: {{ block.settings.card_desc_color }};
    margin: 0;
  }

  @media screen and (max-width: 900px) {
    .ai-feature-grid-cards-{{ ai_gen_id }} {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto;
      grid-template-areas:
        "card1 card2"
        "card3 card5"
        "card4 card4";
    }

    .ai-feature-card-{{ ai_gen_id }} {
      min-height: 280px;
    }

    .ai-feature-card-1-{{ ai_gen_id }} {
      min-height: 400px;
    }
  }

  @media screen and (max-width: 1248px) and (min-width: 901px) {
    .ai-feature-grid-container-{{ ai_gen_id }} {
      padding-right: 24px;
      padding-left: 24px;
    }
  }

  @media screen and (max-width: 640px) {
    .ai-feature-grid-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.6 }}px 0 {{ block.settings.section_padding_bottom | times: 0.6 }}px;
    }

    .ai-feature-grid-container-{{ ai_gen_id }} {
      padding-right: 16px;
      padding-left: 16px;
    }

    .ai-feature-grid-header-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }

    .ai-feature-grid-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-feature-grid-cards-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      grid-template-areas:
        "card1"
        "card2"
        "card3"
        "card4"
        "card5";
    }

    .ai-feature-card-1-{{ ai_gen_id }},
    .ai-feature-card-2-{{ ai_gen_id }},
    .ai-feature-card-3-{{ ai_gen_id }},
    .ai-feature-card-4-{{ ai_gen_id }},
    .ai-feature-card-5-{{ ai_gen_id }} {
      min-height: 220px;
    }
  }
{% endstyle %}

<feature-grid-{{ ai_gen_id }} class="ai-feature-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-feature-grid-container-{{ ai_gen_id }}">
    <div class="ai-feature-grid-header-{{ ai_gen_id }}">
      <div class="ai-feature-grid-heading-{{ ai_gen_id }}">
        {% if block.settings.section_title != blank %}
          <h2 class="ai-feature-grid-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
        {% endif %}
        {% if block.settings.section_subtitle != blank %}
          <div class="ai-feature-grid-subtitle-{{ ai_gen_id }}">{{ block.settings.section_subtitle }}</div>
        {% endif %}
      </div>
      {% if block.settings.header_link_url != blank and block.settings.header_link_text != blank %}
        <a href="{{ block.settings.header_link_url }}" class="ai-feature-grid-link-{{ ai_gen_id }}">
          {{ block.settings.header_link_text }}
        </a>
      {% endif %}
    </div>

    <div class="ai-feature-grid-cards-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign card_enabled_key = 'card_' | append: i | append: '_enabled'
          assign card_bg_key = 'card_' | append: i | append: '_bg_color'
          assign card_image_key = 'card_' | append: i | append: '_image'
          assign card_title_key = 'card_' | append: i | append: '_title'
          assign card_desc_key = 'card_' | append: i | append: '_description'
          assign card_link_key = 'card_' | append: i | append: '_link'

          assign card_enabled = block.settings[card_enabled_key]
          assign card_bg = block.settings[card_bg_key]
          assign card_image = block.settings[card_image_key]
          assign card_title = block.settings[card_title_key]
          assign card_desc = block.settings[card_desc_key]
          assign card_link = block.settings[card_link_key]
        %}

        {% if card_enabled %}
          <a
            href="{% if card_link != blank %}{{ card_link }}{% else %}#{% endif %}"
            class="ai-feature-card-{{ ai_gen_id }} ai-feature-card-{{ i }}-{{ ai_gen_id }}"
            style="background-color: {{ card_bg }};"
          >
            <div class="ai-feature-card-image-{{ ai_gen_id }}">
              {% if card_image %}
                <img
                  src="{{ card_image | image_url: width: 1200 }}"
                  alt="{{ card_image.alt | escape }}"
                  loading="lazy"
                  width="{{ card_image.width }}"
                  height="{{ card_image.height }}"
                >
              {% else %}
                <div class="ai-feature-card-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            <div class="ai-feature-card-overlay-{{ ai_gen_id }}">
              {% if card_title != blank %}
                <h3 class="ai-feature-card-title-{{ ai_gen_id }}">{{ card_title }}</h3>
              {% endif %}
              {% if card_desc != blank %}
                <div class="ai-feature-card-desc-wrap-{{ ai_gen_id }}">
                  <p class="ai-feature-card-desc-{{ ai_gen_id }}">{{ card_desc }}</p>
                </div>
              {% endif %}
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</feature-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class FeatureGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.cards = this.querySelectorAll('.ai-feature-card-{{ ai_gen_id }}');
        this.setupAccessibility();
      }

      setupAccessibility() {
        this.cards.forEach((card) => {
          card.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              card.click();
            }
          });
        });
      }
    }

    customElements.define('feature-grid-{{ ai_gen_id }}', FeatureGrid{{ ai_gen_id }});
  })();
</script>

