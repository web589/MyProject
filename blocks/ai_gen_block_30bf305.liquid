{% doc %}
  @prompt
    <!DOCTYPE html>
    <html lang="de">
    <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
    :root {
      --color-bg-page: #f7f7f7;
      --color-blue-dark: #0f2b61;
      --color-blue-mid: #162b48;
      --color-blue-light: #405a88;
      --color-gray-bg: #e9edf2;
      --color-text-white: #ffffff;
      --color-text-gray: #c5cdd8;
      --color-text-dark: #1a1a1a;
      --color-brand: #00C6FF;
      --radius-card: 12px;
      --gap-grid: 16px;
      --font-main: 'Inter', sans-serif;
      --transition-speed: 0.3s ease;
    }
    
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      background-color: var(--color-bg-page);
      font-family: var(--font-main);
    }
    
    .why-marstek-section {
      width: 100%;
      padding: 80px 24px;
      background-color: var(--color-bg-page);
    }
    
    .section-container {
      max-width: 1400px;
      margin: 0 auto;
    }
    
    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 40px;
    }
    
    .section-title {
      font-size: 36px;
      font-weight: 700;
      color: var(--color-text-dark);
    }
    
    .header-link {
      font-size: 16px;
      color: var(--color-brand);
      text-decoration: none;
      font-weight: 500;
      transition: var(--transition-speed);
    }
    
    .header-link:hover {
      text-decoration: underline;
      opacity: 0.8;
    }
    
    .cards-grid {
      display: grid;
      grid-template-columns: 1fr 2fr 1fr;
      grid-template-rows: auto auto;
      gap: var(--gap-grid);
      grid-template-areas:
        "safe plug vpp"
        "safe ki notstrom";
    }
    
    .card-safe { grid-area: safe; }
    .card-plug { grid-area: plug; }
    .card-vpp { grid-area: vpp; }
    .card-ki { grid-area: ki; }
    .card-notstrom { grid-area: notstrom; }
    
    .feature-card {
      border-radius: var(--radius-card);
      position: relative;
      overflow: hidden;
      cursor: pointer;
      transition: var(--transition-speed);
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 28px 24px;
    }
    
    .card-image-box {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
    }
    
    .card-image-box img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform var(--transition-speed);
    }
    
    .feature-card:hover .card-image-box img {
      transform: scale(1.03);
    }
    
    /* 统一文字遮罩：从下到上渐变阴影 */
    .card-text-overlay {
      position: relative;
      z-index: 2;
      background: linear-gradient(to top, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0.35) 45%, rgba(0,0,0,0) 100%);
      margin: -28px -24px;
      padding: 56px 24px 28px;
      border-radius: var(--radius-card);
    }
    
    .card-title {
      font-size: 22px;
      font-weight: 600;
      color: var(--color-text-white);
      line-height: 1.3;
    }
    
    .card-desc-wrap {
      max-height: 0;
      overflow: hidden;
      transition: max-height var(--transition-speed), margin-top var(--transition-speed);
      margin-top: 0;
    }
    
    .feature-card:hover .card-desc-wrap {
      max-height: 300px;
      margin-top: 12px;
    }
    
    .card-desc {
      font-size: 15px;
      line-height: 1.6;
      color: var(--color-text-gray);
    }
    
    /* 左侧竖卡 */
    .card-safe {
      background-color: var(--color-blue-dark);
      min-height: 520px;
    }
    
    /* 中上卡片 */
    .card-plug {
      background-color: var(--color-blue-mid);
      min-height: 252px;
    }
    
    /* 右上卡片 */
    .card-vpp {
      background-color: var(--color-blue-light);
      min-height: 252px;
    }
    
    /* 中间底部卡片：删除独立浅蓝图片块，文字宽度与中上卡片一致 */
    .card-ki {
      background-color: var(--color-gray-bg);
      min-height: 252px;
    }
    
    .card-ki .card-text-overlay {
      margin: -28px -24px;
      padding: 56px 24px 28px;
      border-radius: var(--radius-card);
    }
    
    .card-ki .card-title {
      color: var(--color-text-white);
    }
    
    .card-ki .card-desc {
      color: var(--color-text-gray);
    }
    
    /* 右下卡片 */
    .card-notstrom {
      background-color: var(--color-blue-mid);
      min-height: 252px;
    }
    
    /* 响应式 */
    @media screen and (max-width: 1024px) {
      .cards-grid {
        grid-template-columns: 1fr 1fr;
        grid-template-areas:
          "safe plug"
          "vpp notstrom"
          "ki ki";
      }
    
      .card-safe {
        min-height: 400px;
      }
    }
    
    @media screen and (max-width: 640px) {
      .section-title {
        font-size: 28px;
      }
    
      .cards-grid {
        grid-template-columns: 1fr;
        grid-template-areas:
          "safe"
          "plug"
          "vpp"
          "ki"
          "notstrom";
      }
    
      .card-safe,
      .card-plug,
      .card-vpp,
      .card-ki,
      .card-notstrom {
        min-height: 220px;
      }
    }
    </style>
    </head>
    <body>
    
    <section class="why-marstek-section">
      <div class="section-container">
        <div class="section-header">
          <h2 class="section-title">Warum MARSTEK?</h2>
          <a href="#" class="header-link">Mehr erfahren</a>
        </div>
    
        <div class="cards-grid">
    
          <!-- 1. Sicher & Langlebig -->
