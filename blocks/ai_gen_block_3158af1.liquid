            font-size: 20px;
          }
          .scenario-card .card-text p {
            font-size: 13px;
            max-width: 200px;
          }
          .scenario-card .card-btn {
            bottom: 18px;
            right: 18px;
          }
          .scenario-card .card-btn a {
            padding: 6px 18px;
            font-size: 13px;
          }
        }
    
        @media (max-width: 480px) {
          :root {
            --card-height: 180px;
          }
          .scenario-card .card-text h3 {
            font-size: 18px;
