{% doc %}
  @prompt
    <!DOCTYPE html>
    <html lang="de">
    <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <title>Verschiedene Einsatzszenarien</title>
      <style>
        /* ===================================================
           可调节变量（修改数值即可调整卡片尺寸）
           =================================================== */
        :root {
          /* 所有卡片的统一高度（单位：px） */
          --card-height: 280px;
    
          /* 整个板块的最大宽度，卡片宽度由 grid 自动分配 */
          --card-max-width: 1280px;
    
          /* 卡片之间的间距 */
          --card-gap: 24px;
        }
    
        /* ===== 整体区块 ===== */
        .scenario-section {
          max-width: var(--card-max-width);
          margin: 0 auto 60px;
          padding: 0 20px;
          font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        }
    
        .scenario-section .section-title {
          font-size: 38px;
          font-weight: 700;
          color: #0A1628;
          margin-bottom: 32px;
          letter-spacing: -0.5px;
        }
        .scenario-section .section-title span {
          color: #0099FC;
        }
    
        /* ===== 网格布局：上一下二，高度固定 ===== */
        .scenario-grid {
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: var(--card-gap);
          /* 让每行高度自动，但卡片高度固定 */
        }
    
        /* 第一张卡片横跨两列（顶部大图） */
        .scenario-card:first-child {
          grid-column: 1 / -1;
        }
    
        /* ===== 单个卡片（背景图，固定高度） ===== */
        .scenario-card {
          height: var(--card-height);
          border-radius: 20px;
          background-size: cover;
          background-position: center;
          background-repeat: no-repeat;
          position: relative;
          overflow: hidden;
          box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
          transition: transform 0.3s ease;
          /* 默认占位图，用户自行替换 */
          background-image: url('https://images.unsplash.com/photo-1500382017468-9049fed747ef?w=800&h=450&fit=crop&crop=center');
        }
        .scenario-card:hover {
          transform: scale(1.01);
        }
    
        /* 卡片2（左下） */
        .scenario-card:nth-child(2) {
          background-image: url('https://images.unsplash.com/photo-1497366216548-37526070297c?w=800&h=450&fit=crop&crop=center');
        }
        /* 卡片3（右下） */
        .scenario-card:nth-child(3) {
          background-image: url('https://images.unsplash.com/photo-1556761175-b413da4baf72?w=800&h=450&fit=crop&crop=center');
        }
    
        /* ===== 暗色遮罩 ===== */
        .scenario-card .card-overlay {
          position: absolute;
          inset: 0;
          background: linear-gradient(135deg, rgba(0, 0, 0, 0.40) 0%, rgba(0, 0, 0, 0.05) 60%);
          pointer-events: none;
        }
    
        /* ===== 文字：左下角 ===== */
        .scenario-card .card-text {
          position: absolute;
          bottom: 28px;
          left: 28px;
          z-index: 2;
          max-width: 70%;
          color: #fff;
          text-shadow: 0 2px 20px rgba(0, 0, 0, 0.5);
          pointer-events: none;
        }
        .scenario-card .card-text h3 {
          font-size: 26px;
          font-weight: 700;
          margin: 0 0 6px 0;
          letter-spacing: -0.3px;
        }
        .scenario-card .card-text p {
          font-size: 15px;
          margin: 0;
          opacity: 0.95;
          line-height: 1.5;
          font-weight: 400;
          max-width: 400px;
        }
        .scenario-card .card-text p strong {
          font-weight: 700;
        }
    
        /* ===== 按钮：右下角 ===== */
        .scenario-card .card-btn {
          position: absolute;
          bottom: 28px;
          right: 28px;
          z-index: 2;
          pointer-events: auto;
        }
        .scenario-card .card-btn a {
          display: inline-block;
          padding: 10px 28px;
          background: rgba(255, 255, 255, 0.92);
          backdrop-filter: blur(4px);
          color: #0A1628;
          border-radius: 50px;
          text-decoration: none;
          font-weight: 600;
          font-size: 15px;
          transition: all 0.25s ease;
          box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
          border: 1px solid rgba(255, 255, 255, 0.3);
        }
        .scenario-card .card-btn a:hover {
          background: #ffffff;
          transform: translateY(-2px);
          box-shadow: 0 8px 28px rgba(0, 0, 0, 0.15);
        }
    
        /* ===== 响应式：手机堆叠 ===== */
        @media (max-width: 640px) {
          :root {
            --card-height: 220px;  /* 手机上稍矮 */
          }
          .scenario-grid {
            grid-template-columns: 1fr;
            gap: 16px;
          }
          .scenario-card:first-child {
            grid-column: 1;
          }
          .scenario-section .section-title {
            font-size: 26px;
          }
          .scenario-card .card-text {
            bottom: 18px;
