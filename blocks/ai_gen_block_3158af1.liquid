{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-scenario-section-{{ ai_gen_id }} {
    display: block;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto {{ block.settings.section_bottom_margin }}px;
    padding: 0 20px;
    width: 100%;
  }

  .ai-scenario-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    color: {{ block.settings.title_color }};
    margin-bottom: {% if block.settings.section_subtitle != blank %}8{% else %}{{ block.settings.title_margin }}{% endif %}px;
    letter-spacing: -0.5px;
  }

  .ai-scenario-subtitle-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.title_margin | minus: 8 }}px;
    color: #596b82;
    font-size: 16px;
    line-height: 1.5;
    max-width: 800px;
  }

  .ai-scenario-subtitle-{{ ai_gen_id }} p {
    margin: 0;
  }

  .ai-scenario-title-{{ ai_gen_id }} .ai-scenario-title-highlight-{{ ai_gen_id }} {
    color: {{ block.settings.title_highlight_color }};
  }

  .ai-scenario-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.card_gap }}px;
  }

  .ai-scenario-card-{{ ai_gen_id }}:first-child {
    grid-column: 1 / -1;
  }

  .ai-scenario-card-{{ ai_gen_id }} {
    height: {{ block.settings.card_height }}px;
    border-radius: {{ block.settings.card_border_radius }}px;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    position: relative;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    transition: transform 0.3s ease;
  }

  .ai-scenario-card-{{ ai_gen_id }}:first-child {
    height: {{ block.settings.card_1_height }}px;
  }

  .ai-scenario-card-{{ ai_gen_id }}:hover {
    transform: scale(1.01);
  }

  .ai-scenario-card-overlay-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(0, 0, 0, {{ block.settings.overlay_opacity }}) 0%, rgba(0, 0, 0, {{ block.settings.overlay_opacity | times: 0.125 }}) 60%);
    pointer-events: none;
  }

  .ai-scenario-card-text-{{ ai_gen_id }} {
    position: absolute;
    bottom: {{ block.settings.content_padding }}px;
    left: {{ block.settings.content_padding }}px;
    z-index: 2;
    max-width: 70%;
    color: {{ block.settings.text_color }};
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.5);
    pointer-events: none;
  }

  .ai-scenario-card-text-{{ ai_gen_id }} h3 {
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: 700;
    margin: 0 0 6px 0;
    letter-spacing: -0.3px;
  }

  .ai-scenario-card-text-{{ ai_gen_id }} p {
    font-size: {{ block.settings.card_description_size }}px;
    margin: 0;
    opacity: 0.95;
    line-height: 1.5;
    font-weight: 400;
    max-width: 400px;
  }

  .ai-scenario-card-btn-{{ ai_gen_id }} {
    position: absolute;
    bottom: {{ block.settings.content_padding }}px;
    right: {{ block.settings.content_padding }}px;
    z-index: 2;
    pointer-events: auto;
  }

  .ai-scenario-card-btn-{{ ai_gen_id }} a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    min-width: 120px;
    min-height: 40px;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background: {{ block.settings.button_bg_color | color_modify: 'alpha', block.settings.button_bg_opacity }};
    color: {{ block.settings.button_text_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    text-decoration: none;
    font-family: inherit;
    font-weight: 500;
    font-size: {{ block.settings.button_text_size }}px;
    line-height: 1.2;
    white-space: nowrap;
    border: 1px solid {{ block.settings.button_border_color }};
    box-shadow: none;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .ai-scenario-card-btn-{{ ai_gen_id }} a:hover {
    background: {{ block.settings.button_hover_bg }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_border_color }};
  }

  .ai-scenario-card-btn-{{ ai_gen_id }} a:focus-visible {
    outline: 2px solid {{ block.settings.button_border_color }};
    outline-offset: 3px;
  }

  @media (max-width: 749px) {
    .ai-scenario-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .ai-scenario-card-{{ ai_gen_id }}:first-child {
      grid-column: 1;
      height: {{ block.settings.card_1_height | times: 0.785 }}px;
    }

    .ai-scenario-card-{{ ai_gen_id }} {
      height: {{ block.settings.card_height | times: 0.785 }}px;
    }

    .ai-scenario-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.68 }}px;
    }

    .ai-scenario-card-text-{{ ai_gen_id }} {
      bottom: 18px;
      left: 18px;
      max-width: 75%;
    }

    .ai-scenario-card-text-{{ ai_gen_id }} h3 {
      font-size: {{ block.settings.card_title_size | times: 0.77 }}px;
    }

    .ai-scenario-card-text-{{ ai_gen_id }} p {
      font-size: {{ block.settings.card_description_size | times: 0.87 }}px;
      max-width: 200px;
    }

    .ai-scenario-card-btn-{{ ai_gen_id }} {
      bottom: 18px;
      right: 18px;
    }

    .ai-scenario-card-btn-{{ ai_gen_id }} a {
      min-width: 112px;
      min-height: 38px;
      padding: 8px 14px;
      font-size: {{ block.settings.button_text_size }}px;
    }
  }

  @media (max-width: 480px) {
    .ai-scenario-card-{{ ai_gen_id }}:first-child {
      height: {{ block.settings.card_1_height | times: 0.64 }}px;
    }

    .ai-scenario-card-{{ ai_gen_id }} {
      height: {{ block.settings.card_height | times: 0.64 }}px;
    }

    .ai-scenario-card-text-{{ ai_gen_id }} h3 {
      font-size: {{ block.settings.card_title_size | times: 0.69 }}px;
    }

    .ai-scenario-card-text-{{ ai_gen_id }} p {
      font-size: {{ block.settings.card_description_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<scenario-cards-{{ ai_gen_id }} class="ai-scenario-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.section_title != blank %}
    <h2 class="ai-scenario-title-{{ ai_gen_id }}">
      {{ block.settings.section_title }}
    </h2>
  {% endif %}

  {% if block.settings.section_subtitle != blank %}
    <div class="ai-scenario-subtitle-{{ ai_gen_id }} rte">
      {{ block.settings.section_subtitle }}
    </div>
  {% endif %}

  <div class="ai-scenario-grid-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign image_key = 'card_' | append: i | append: '_image'
        assign title_key = 'card_' | append: i | append: '_title'
        assign description_key = 'card_' | append: i | append: '_description'
        assign button_text_key = 'card_' | append: i | append: '_button_text'
        assign button_link_key = 'card_' | append: i | append: '_button_link'

        assign card_image = block.settings[image_key]
        assign card_title = block.settings[title_key]
        assign card_description = block.settings[description_key]
        assign card_button_text = block.settings[button_text_key]
        assign card_button_link = block.settings[button_link_key]
      %}

      <div
        class="ai-scenario-card-{{ ai_gen_id }}"
        {% if card_image %}
          style="background-image: url('{{ card_image | image_url: width: 2000 }}');"
        {% endif %}
      >
        <div class="ai-scenario-card-overlay-{{ ai_gen_id }}"></div>

        {% if card_title != blank or card_description != blank %}
          <div class="ai-scenario-card-text-{{ ai_gen_id }}">
            {% if card_title != blank %}
              <h3>{{ card_title }}</h3>
            {% endif %}
            {% if card_description != blank %}
              <p>{{ card_description }}</p>
            {% endif %}
          </div>
        {% endif %}

        {% if card_button_text != blank and card_button_link != blank %}
          <div class="ai-scenario-card-btn-{{ ai_gen_id }}">
            <a href="{{ card_button_link }}">{{ card_button_text }}</a>
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</scenario-cards-{{ ai_gen_id }}>

<script>
  (function() {
    class ScenarioCards{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.applyHighlight();
      }

      applyHighlight() {
        const titleElement = this.querySelector('.ai-scenario-title-{{ ai_gen_id }}');
        if (!titleElement) return;

        const highlightText = '{{ block.settings.title_highlight_text }}';
        if (!highlightText) return;

        const titleHTML = titleElement.innerHTML;
        const highlightedHTML = titleHTML.replace(
          new RegExp(highlightText, 'gi'),
          '<span class="ai-scenario-title-highlight-{{ ai_gen_id }}">$&</span>'
        );
        titleElement.innerHTML = highlightedHTML;
      }
    }

    customElements.define('scenario-cards-{{ ai_gen_id }}', ScenarioCards{{ ai_gen_id }});
  })();
</script>

