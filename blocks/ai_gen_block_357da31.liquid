  .ai-energy-step-item-{{ ai_gen_id }}.item-4 .ai-energy-title-sweep-{{ ai_gen_id }} {
    animation: ai-title-sweep-{{ ai_gen_id }} 0.8s ease 18.8s forwards;
  }

  @media screen and (max-width: 1024px) {
    .ai-energy-main-title-{{ ai_gen_id }} {
