  }
  .ai-energy-step-item-{{ ai_gen_id }}.item-1 .ai-energy-step-title-{{ ai_gen_id }} {
    animation: ai-title-blue-{{ ai_gen_id }} 0.3s ease 0.8s forwards;
  }
  .ai-energy-step-item-{{ ai_gen_id }}.item-1 .ai-energy-title-sweep-{{ ai_gen_id }} {
    animation: ai-title-sweep-{{ ai_gen_id }} 0.8s ease 0.8s forwards;
  }

  .ai-energy-step-item-{{ ai_gen_id }}.item-2 .ai-energy-icon-box-{{ ai_gen_id }} {
    animation: ai-card-lift-{{ ai_gen_id }} 0.6s ease 6.5s forwards;
  }
  .ai-energy-step-item-{{ ai_gen_id }}.item-2 .ai-energy-dot-{{ ai_gen_id }} {
    animation: ai-dot-activate-{{ ai_gen_id }} 0.3s ease 6.5s forwards;
  }
  .ai-energy-step-item-{{ ai_gen_id }}.item-2 .ai-energy-dot-glow-{{ ai_gen_id }} {
    animation: ai-glow-pulse-{{ ai_gen_id }} 1.2s ease 6.5s;
  }
  .ai-energy-step-item-{{ ai_gen_id }}.item-2 .ai-energy-step-title-{{ ai_gen_id }} {
    animation: ai-title-blue-{{ ai_gen_id }} 0.3s ease 6.8s forwards;
  }
  .ai-energy-step-item-{{ ai_gen_id }}.item-2 .ai-energy-title-sweep-{{ ai_gen_id }} {
    animation: ai-title-sweep-{{ ai_gen_id }} 0.8s ease 6.8s forwards;
  }

  .ai-energy-step-item-{{ ai_gen_id }}.item-3 .ai-energy-icon-box-{{ ai_gen_id }} {
    animation: ai-card-lift-{{ ai_gen_id }} 0.6s ease 12.5s forwards;
  }
  .ai-energy-step-item-{{ ai_gen_id }}.item-3 .ai-energy-dot-{{ ai_gen_id }} {
    animation: ai-dot-activate-{{ ai_gen_id }} 0.3s ease 12.5s forwards;
  }
  .ai-energy-step-item-{{ ai_gen_id }}.item-3 .ai-energy-dot-glow-{{ ai_gen_id }} {
    animation: ai-glow-pulse-{{ ai_gen_id }} 1.2s ease 12.5s;
  }
  .ai-energy-step-item-{{ ai_gen_id }}.item-3 .ai-energy-step-title-{{ ai_gen_id }} {
    animation: ai-title-blue-{{ ai_gen_id }} 0.3s ease 12.8s forwards;
  }
  .ai-energy-step-item-{{ ai_gen_id }}.item-3 .ai-energy-title-sweep-{{ ai_gen_id }} {
    animation: ai-title-sweep-{{ ai_gen_id }} 0.8s ease 12.8s forwards;
  }

  .ai-energy-step-item-{{ ai_gen_id }}.item-4 .ai-energy-icon-box-{{ ai_gen_id }} {
    animation: ai-card-lift-{{ ai_gen_id }} 0.6s ease 18.5s forwards;
  }
  .ai-energy-step-item-{{ ai_gen_id }}.item-4 .ai-energy-dot-{{ ai_gen_id }} {
    animation: ai-dot-activate-{{ ai_gen_id }} 0.3s ease 18.5s forwards;
  }
  .ai-energy-step-item-{{ ai_gen_id }}.item-4 .ai-energy-dot-glow-{{ ai_gen_id }} {
    animation: ai-glow-pulse-{{ ai_gen_id }} 1.2s ease 18.5s;
  }
  .ai-energy-step-item-{{ ai_gen_id }}.item-4 .ai-energy-step-title-{{ ai_gen_id }} {
    animation: ai-title-blue-{{ ai_gen_id }} 0.3s ease 18.8s forwards;
