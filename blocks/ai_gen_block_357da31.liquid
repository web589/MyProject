{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-energy-steps-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-energy-steps-wrapper-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    text-align: center;
  }

  .ai-energy-main-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    font-weight: 700;
    margin: 0 0 {{ block.settings.title_spacing }}px;
    line-height: 1.2;
  }

  .ai-energy-steps-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
    position: relative;
  }

  .ai-energy-step-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .ai-energy-icon-box-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 0 rgba(0, 0, 0, 0);
    transform: translateY(0);
    transition: all 0.6s ease;
    overflow: hidden;
  }

  .ai-energy-icon-box-{{ ai_gen_id }} img {
    max-width: 80%;
    max-height: 80%;
    object-fit: contain;
  }

  .ai-energy-icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-energy-icon-placeholder-{{ ai_gen_id }} svg {
    width: 80%;
    height: 80%;
  }

  .ai-energy-dot-{{ ai_gen_id }} {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: {{ block.settings.dot_inactive_color }};
    position: relative;
    margin: 24px 0 20px;
    z-index: 3;
    transition: background 0.3s ease;
  }

  .ai-energy-dot-glow-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: {{ block.settings.accent_color }};
    box-shadow: 0 0 0 0 {{ block.settings.accent_color | color_modify: 'alpha', 0.6 }};
  }

  .ai-energy-step-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.step_title_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0 0 16px;
    position: relative;
    overflow: hidden;
    transition: color 0.3s ease;
  }

  .ai-energy-title-sweep-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.7), transparent);
  }

  .ai-energy-step-desc-{{ ai_gen_id }} {
    font-size: {{ block.settings.step_desc_size }}px;
    color: {{ block.settings.desc_color }};
    line-height: 1.6;
    max-width: 220px;
  }

  @keyframes ai-card-lift-{{ ai_gen_id }} {
    0% {
      transform: translateY(0);
      box-shadow: 0 0 0 rgba(0, 0, 0, 0);
    }
    100% {
      transform: translateY(-12px);
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
    }
  }

  @keyframes ai-dot-activate-{{ ai_gen_id }} {
    0% {
      background: {{ block.settings.dot_inactive_color }};
    }
    100% {
      background: {{ block.settings.accent_color }};
    }
  }

  @keyframes ai-glow-pulse-{{ ai_gen_id }} {
    0% {
      box-shadow: 0 0 0 0 {{ block.settings.accent_color | color_modify: 'alpha', 0.6 }};
    }
    50% {
      box-shadow: 0 0 0 12px {{ block.settings.accent_color | color_modify: 'alpha', 0 }};
    }
    100% {
      box-shadow: 0 0 0 0 {{ block.settings.accent_color | color_modify: 'alpha', 0 }};
    }
  }

  @keyframes ai-title-sweep-{{ ai_gen_id }} {
    0% {
      left: -100%;
    }
    100% {
      left: 100%;
    }
  }

  @keyframes ai-title-blue-{{ ai_gen_id }} {
    0% {
      color: {{ block.settings.text_color }};
    }
    100% {
      color: {{ block.settings.accent_color }};
    }
  }

  .ai-energy-step-item-{{ ai_gen_id }}.item-1 .ai-energy-icon-box-{{ ai_gen_id }} {
    animation: ai-card-lift-{{ ai_gen_id }} 0.6s ease 0.5s forwards;
