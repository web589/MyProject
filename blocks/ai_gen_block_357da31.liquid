{% endstyle %}

<energy-steps-{{ ai_gen_id }} class="ai-energy-steps-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-energy-steps-wrapper-{{ ai_gen_id }}">
    {% if block.settings.main_title != blank %}
      <h2 class="ai-energy-main-title-{{ ai_gen_id }}">{{ block.settings.main_title }}</h2>
    {% endif %}

    <div class="ai-energy-steps-grid-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign step_image_key = 'step_' | append: i | append: '_image'
          assign step_title_key = 'step_' | append: i | append: '_title'
          assign step_desc_key = 'step_' | append: i | append: '_desc'

          assign step_image = block.settings[step_image_key]
          assign step_title = block.settings[step_title_key]
          assign step_desc = block.settings[step_desc_key]
        %}

        <div class="ai-energy-step-item-{{ ai_gen_id }} item-{{ i }}">
          <div class="ai-energy-icon-box-{{ ai_gen_id }}">
            {% if step_image %}
              <img
                src="{{ step_image | image_url: width: 300 }}"
                alt="{{ step_image.alt | escape }}"
                loading="lazy"
                width="300"
                height="300"
              >
            {% else %}
              <div class="ai-energy-icon-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          <div class="ai-energy-dot-{{ ai_gen_id }}">
            <div class="ai-energy-dot-glow-{{ ai_gen_id }}"></div>
          </div>

          {% if step_title != blank %}
            <h3 class="ai-energy-step-title-{{ ai_gen_id }}">
              {{ step_title }}
              <div class="ai-energy-title-sweep-{{ ai_gen_id }}"></div>
            </h3>
          {% endif %}

          {% if step_desc != blank %}
            <div class="ai-energy-step-desc-{{ ai_gen_id }}">{{ step_desc }}</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</energy-steps-{{ ai_gen_id }}>

<script>
  (function() {
    class EnergySteps{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupAnimation();
      }

      setupAnimation() {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        }, { threshold: 0.1 });

        observer.observe(this);
      }
    }

    customElements.define('energy-steps-{{ ai_gen_id }}', EnergySteps{{ ai_gen_id }});
  })();
</script>

