{% doc %}
  @prompt
    <!DOCTYPE html>
    <html lang="de">
    <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Energie für Zuhause Animation</title>
    <style>
    /* 全局基础重置 */
    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      font-family: Arial, Helvetica, sans-serif;
    }
    body{
      background:#ffffff;
      padding:60px 20px;
    }
    
    /* 外层容器 */
    .energy-step-wrapper{
      max-width:1400px;
      margin:0 auto;
      text-align:center;
    }
    
    /* 顶部大标题 */
    .main-top-title{
      font-size:64px;
      color:#222222;
      font-weight:700;
      margin-bottom:80px;
    }
    
    /* 4步骤网格容器 */
    .steps-container{
      display:grid;
      grid-template-columns: repeat(4, 1fr);
      gap:30px;
      position:relative;
    }
    
    /* 单个步骤卡片模块 */
    .step-item{
      display:flex;
      flex-direction:column;
      align-items:center;
      position:relative;
    }
    
    /* 图标盒子 默认初始状态 */
    .step-icon-box{
      width:160px;
      height:160px;
      background:#ffffff;
      border-radius:24px;
      display:flex;
      align-items:center;
      justify-content:center;
      box-shadow: 0 0 0 rgba(0,0,0,0);
      transform: translateY(0);
      transition: all 0.6s ease;
      overflow:hidden;
    }
    .step-icon-box img{
      max-width:80%;
      max-height:80%;
      object-fit:contain;
    }
    
    /* 圆点定位 */
    .dot-point{
      width:12px;
      height:12px;
      border-radius:50%;
      background:#dddddd;
      position:relative;
      margin:24px 0 20px;
      z-index:3;
    }
    /* 圆点发光扩散光圈 */
    .dot-glow{
      position:absolute;
      top:50%;
      left:50%;
      transform:translate(-50%,-50%);
      width:12px;
      height:12px;
      border-radius:50%;
      background:#0066ff;
      box-shadow: 0 0 0 0 rgba(0,102,255,0.6);
    }
    
    /* 标题文字基础样式 */
    .step-title{
      font-size:32px;
      font-weight:600;
      color:#222222;
      margin-bottom:16px;
      position:relative;
      overflow:hidden;
    }
    /* 标题蓝色扫光遮罩层 */
    .title-sweep-light{
      position:absolute;
      top:0;
      left:-100%;
      width:100%;
      height:100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.7), transparent);
    }
    
    /* 描述文案 */
    .step-desc{
      font-size:20px;
      color:#666666;
      line-height:1.6;
      max-width:220px;
    }
    
    /* ========== 分步动画关键帧定义 ========== */
    /* 卡片上浮+阴影动画 */
    @keyframes cardLift{
      0%{ transform:translateY(0); box-shadow:0 0 0 rgba(0,0,0,0); }
      100%{ transform:translateY(-12px); box-shadow:0 12px 30px rgba(0,0,0,0.12); }
    }
    
    /* 圆点点亮+光圈扩散脉冲 */
    @keyframes dotActivate{
      0%{ background:#ddd; }
      100%{ background:#0066ff; }
    }
    @keyframes glowPulse{
      0%{ box-shadow:0 0 0 0 rgba(0,102,255,0.6); }
      50%{ box-shadow:0 0 0 12px rgba(0,102,255,0); }
      100%{ box-shadow:0 0 0 0 rgba(0,102,255,0); }
    }
    
    /* 标题扫光+变色为蓝色 */
    @keyframes titleSweep{
      0%{ left:-100%; }
      100%{ left:100%; }
    }
    @keyframes titleTurnBlue{
      0%{ color:#222; }
      100%{ color:#0066ff; }
    }
    
    /* ========== 给每一项分配不同时间轴动画 ========== */
    /* 第1项 0~6s执行 */
    .item-1 .step-icon-box{
      animation: cardLift 0.6s ease 0.5s forwards;
    }
    .item-1 .dot-point{
      animation: dotActivate 0.3s ease 0.5s forwards;
    }
    .item-1 .dot-glow{
      animation: glowPulse 1.2s ease 0.5s;
    }
    .item-1 .step-title{
      animation: titleTurnBlue 0.3s ease 0.8s forwards;
    }
    .item-1 .title-sweep-light{
      animation: titleSweep 0.8s ease 0.8s forwards;
    }
    
    /* 第2项 6~12s执行 */
    .item-2 .step-icon-box{
      animation: cardLift 0.6s ease 6.5s forwards;
    }
    .item-2 .dot-point{
      animation: dotActivate 0.3s ease 6.5s forwards;
    }
    .item-2 .dot-glow{
      animation: glowPulse 1.2s ease 6.5s;
    }
    .item-2 .step-title{
      animation: titleTurnBlue 0.3s ease 6.8s forwards;
    }
    .item-2 .title-sweep-light{
      animation: titleSweep 0.8s ease 6.8s forwards;
    }
    
    /* 第3项 12~18s执行 */
    .item-3 .step-icon-box{
      animation: cardLift 0.6s ease 12.5s forwards;
    }
    .item-3 .dot-point{
      animation: dotActivate 0.3s ease 12.5s forwards;
    }
    .item-3 .dot-glow{
      animation: glowPulse 1.2s ease 12.5s;
    }
    .item-3 .step-title{
      animation: titleTurnBlue 0.3s ease 12.8s forwards;
    }
    .item-3 .title-sweep-light{
      animation: titleSweep 0.8s ease 12.8s forwards;
    }
    
    /* 第4项 18~24s执行 */
    .item-4 .step-icon-box{
      animation: cardLift 0.6s ease 18.5s forwards;
    }
    .item-4 .dot-point{
      animation: dotActivate 0.3s ease 18.5s forwards;
    }
    .item-4 .dot-glow{
      animation: glowPulse 1.2s ease 18.5s;
    }
    .item-4 .step-title{
      animation: titleTurnBlue 0.3s ease 18.8s forwards;
    }
    .item-4 .title-sweep-light{
      animation: titleSweep 0.8s ease 18.8s forwards;
    }
    
    /* 响应式适配 */
    @media screen and (max-width: 1024px) {
      .main-top-title {
        font-size: 42px;
      }
      .step-icon-box {
        width: 140px;
        height: 140px;
      }
      .step-title {
        font-size: 26px;
      }
    }
    @media screen and (max-width: 640px) {
      .main-top-title {
        font-size: 32px;
      }
      .steps-container {
        grid-template-columns: 1fr;
      }
      .step-icon-box {
        width: 120px;
        height: 120px;
      }
      .step-title {
        font-size: 16px;
      }
    }
    </style>
    </head>
    <body>
    
    <div class="energy-step-wrapper">
      <h1 class="main-top-title">Energie für Zuhause, Geld für dich!</h1>
    
