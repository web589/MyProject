{% doc %}
  @prompt
    <style>
    /* 全局品牌配色变量 统一全站风格 */
    :root {
      --page-bg: #F8FAFC;
      --accent-green: #00E676;
      --green-dark: #00bd52;
      --text-white: #ffffff;
      --text-dark: #111827;
      --text-gray: #4B5563;
      --border-light: rgba(255, 255, 255, 0.5);
      --btn-glow: 0 0 8px rgba(0, 230, 118, 0.25), 0 0 16px rgba(0, 230, 118, 0.35), 0 0 28px rgba(0, 230, 118, 0.18);
      --radius-card: 8px;
      --grid-gap: 24px;
      --section-padding: 80px;
      --container-max: 1400px;
      --side-padding: 20px;
    }
    @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@600;700;800&family=Inter:wght@400;500;600&display=swap');
    
    /* 产品板块外层 整体背景#F8FAFC */
    .product-grid-section {
      width: 100%;
      background: var(--page-bg);
      padding: var(--section-padding) 0;
    }
    .product-container {
      max-width: var(--container-max);
      margin: 0 auto;
      padding: 0 var(--side-padding);
    }
    
    /* 四张卡片上方 板块顶部标语 */
    .section-title-wrap {
      text-align: center;
      margin-bottom: 48px;
    }
    .section-tag {
      font-size: 16px;
      color: var(--accent-green);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin: 0 0 12px;
      font-family: 'Inter', sans-serif;
    }
    .section-main-title {
      font-family: 'Manrope', sans-serif;
      font-size: 42px;
      font-weight: 800;
      color: var(--text-dark);
      margin: 0;
      line-height: 1.2;
    }
    
    /* 2×2网格布局 */
    .product-grid-wrap {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--grid-gap);
    }
    
    /* 单张产品卡片 横向 宽:高=4:3 */
    .product-card {
      position: relative;
      border-radius: var(--radius-card);
      overflow: hidden;
      aspect-ratio: 4 / 3;
    }
    /* 背景图完全铺满卡片 */
    .product-bg-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.4s ease;
    }
    .product-card:hover .product-bg-img {
      transform: scale(1.03);
    }
    
    /* 文字容器：居中偏上，高度限制40%（2/5），下方60%留给图片，整体缩小 */
    .product-content-wrap {
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 60%;
      padding: 20px 0;
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      max-height: 40%;
    }
    /* 卡片内顶部小字标语 */
    .product-top-slogan {
      font-size: 11px;
      color: #ffd02f;
      font-weight: 600;
      margin: 0 0 8px;
      font-family: 'Inter', sans-serif;
      letter-spacing: 0.5px;
    }
    /* 产品型号 强制单行不换行 */
    .product-model-title {
      font-family: 'Manrope', sans-serif;
      font-size: 20px;
      font-weight: 800;
      color: var(--text-white);
      line-height: 1.2;
      margin: 0 0 6px;
      white-space: nowrap;
      overflow: hidden;
    }
    /* NEU新品小标签 同步缩小 */
    .product-new-tag {
      display: inline-block;
      background: var(--accent-green);
      color: #000;
      font-size: 9px;
      font-weight: 700;
      padding: 2px 5px;
      border-radius: 3px;
      margin-left: 5px;
      vertical-align: top;
    }
    /* 简短描述文案 */
    .product-desc-text {
      font-size: 12px;
      color: var(--text-white);
      opacity: 0.92;
      margin: 0 0 12px;
      line-height: 1.5;
    }
    /* 原价现价模块（描述下方、按钮上方） */
    .price-line {
      display: flex;
      gap: 8px;
      align-items: center;
      margin: 0 0 14px;
    }
    .old-price-text {
      font-size: 11px;
      color: #cccccc;
      text-decoration: line-through;
    }
    .new-price-text {
      font-size: 13px;
      font-weight: 600;
      color: var(--accent-green);
    }
    /* 底部双按钮居中并排 */
    .product-btn-group {
      display: flex;
      gap: 10px;
      justify-content: center;
    }
    /* 主按钮 */
    .btn-primary-shop {
      padding: 7px 16px;
      background: var(--accent-green);
      color: #000;
      border: none;
      border-radius: 3px;
      font-size: 12px;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.3s ease;
    }
    .btn-primary-shop:hover {
      background: var(--green-dark);
      transform: translateY(-3px);
      box-shadow: var(--btn-glow);
    }
    /* 次按钮 */
    .btn-secondary-info {
      padding: 7px 16px;
      background: transparent;
      color: var(--text-white);
      border: 1px solid var(--border-light);
      border-radius: 3px;
      font-size: 12px;
      font-weight: 500;
      text-decoration: none;
      transition: all 0.3s ease;
    }
    .btn-secondary-info:hover {
      border-color: var(--accent-green);
      color: var(--accent-green);
      transform: translateY(-3px);
    }
    
    /* 响应式适配 */
    @media screen and (max-width: 1024px) {
      .section-main-title {
        font-size: 36px;
      }
      .product-model-title {
        font-size: 18px;
      }
      .product-content-wrap {
        width: 68%;
      }
    }
    @media screen and (max-width: 640px) {
      .section-title-wrap {
        margin-bottom: 32px;
      }
      .section-main-title {
        font-size: 30px;
      }
      .product-grid-wrap {
        grid-template-columns: 1fr;
      }
      .product-model-title {
        font-size: 16px;
      }
      .product-content-wrap {
        width: 75%;
        padding: 16px 0;
        max-height: 42%;
      }
      .product-grid-section {
        padding: 50px 0;
      }
    }
    </style>
    
    <!-- 4宫格产品板块完整HTML -->
    <section class="product-grid-section">
      <div class="product-container">
        <!-- 四张卡片上方 板块大标语 -->
        <div class="section-title-wrap">
          <p class="section-tag">PRODUKTREIHE VENUS E</p>
          <h2 class="section-main-title">Wähle deine passende Heimbatterie</h2>
        </div>
    
        <div class="product-grid-wrap">
          <!-- 卡片1：VENUS E Mini -->
          <div class="product-card">
           , 添加4个产品卡片的Top slogan、Description、Old price、New price字体大小调节选项
{% enddoc %}
