<ai-product-grid-{{ ai_gen_id }} class="ai-product-grid-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-container-{{ ai_gen_id }}">
    {% if block.settings.section_tag != blank or block.settings.section_title != blank %}
      <div class="ai-section-title-wrap-{{ ai_gen_id }}">
        {% if block.settings.section_tag != blank %}
          <p class="ai-section-tag-{{ ai_gen_id }}">{{ block.settings.section_tag }}</p>
        {% endif %}
        {% if block.settings.section_title != blank %}
          <h2 class="ai-section-main-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-product-grid-wrap-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign product_key = 'product_' | append: i
          assign slogan_key = 'product_' | append: i | append: '_slogan'
          assign desc_key = 'product_' | append: i | append: '_desc'
          assign show_new_key = 'product_' | append: i | append: '_show_new'
          assign old_price_key = 'product_' | append: i | append: '_old_price'
          assign new_price_key = 'product_' | append: i | append: '_new_price'
          assign btn1_text_key = 'product_' | append: i | append: '_btn1_text'
          assign btn1_url_key = 'product_' | append: i | append: '_btn1_url'
          assign btn2_text_key = 'product_' | append: i | append: '_btn2_text'
          assign btn2_url_key = 'product_' | append: i | append: '_btn2_url'
          assign bg_image_key = 'product_' | append: i | append: '_bg_image'

          assign product = block.settings[product_key]
          assign slogan = block.settings[slogan_key]
          assign desc = block.settings[desc_key]
          assign show_new = block.settings[show_new_key]
          assign old_price = block.settings[old_price_key]
          assign new_price = block.settings[new_price_key]
          assign btn1_text = block.settings[btn1_text_key]
          assign btn1_url = block.settings[btn1_url_key]
          assign btn2_text = block.settings[btn2_text_key]
          assign btn2_url = block.settings[btn2_url_key]
          assign bg_image = block.settings[bg_image_key]
        %}

        <div class="ai-product-card-{{ ai_gen_id }}">
          {% if bg_image %}
            <img
              src="{{ bg_image | image_url: width: 1200 }}"
              alt="{{ bg_image.alt | escape }}"
              loading="lazy"
              width="{{ bg_image.width }}"
              height="{{ bg_image.height }}"
              class="ai-product-bg-img-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-product-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}

          <div class="ai-product-content-wrap-{{ ai_gen_id }}">
            {% if slogan != blank %}
              <p class="ai-product-top-slogan-{{ ai_gen_id }}">{{ slogan }}</p>
            {% endif %}

            {% if product %}
              <h3 class="ai-product-model-title-{{ ai_gen_id }}">
                {{ product.title }}
                {% if show_new %}
                  <span class="ai-product-new-tag-{{ ai_gen_id }}">NEU</span>
                {% endif %}
              </h3>
            {% endif %}

            {% if desc != blank %}
              <p class="ai-product-desc-text-{{ ai_gen_id }}">{{ desc }}</p>
            {% endif %}

            {% if old_price != blank or new_price != blank %}
              <div class="ai-price-line-{{ ai_gen_id }}">
                {% if old_price != blank %}
                  <span class="ai-old-price-text-{{ ai_gen_id }}">{{ old_price }}</span>
                {% endif %}
                {% if new_price != blank %}
                  <span class="ai-new-price-text-{{ ai_gen_id }}">{{ new_price }}</span>
                {% endif %}
              </div>
            {% endif %}

            <div class="ai-product-btn-group-{{ ai_gen_id }}">
              {% if btn1_text != blank %}
                <a
                  href="{% if btn1_url != blank %}{{ btn1_url }}{% elsif product %}{{ product.url }}{% else %}#{% endif %}"
                  class="ai-btn-primary-shop-{{ ai_gen_id }}"
                >
                  {{ btn1_text }}
                </a>
              {% endif %}

              {% if btn2_text != blank %}
                <a
                  href="{% if btn2_url != blank %}{{ btn2_url }}{% elsif product %}{{ product.url }}{% else %}#{% endif %}"
                  class="ai-btn-secondary-info-{{ ai_gen_id }}"
                >
                  {{ btn2_text }}
                </a>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</ai-product-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class AiProductGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('ai-product-grid-{{ ai_gen_id }}', AiProductGrid{{ ai_gen_id }});
  })();
</script>

