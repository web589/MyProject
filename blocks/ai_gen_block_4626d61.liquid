{% doc %}
  @prompt
    <!DOCTYPE html>
    <html lang="de">
    <head>
      <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <title>NODE Rabot · Produkte</title>
      <style>
        * {
          margin: 0;
          padding: 0;
          box-sizing: border-box;
          font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
        }
    
        body {
          background: #f2f4f8;
          min-height: 100vh;
          padding: 2rem 1rem;
        }
    
        /* 页面标题 */
        .page-header {
          max-width: 1400px;
          margin: 0 auto 2rem;
          padding: 0 0.5rem;
        }
    
        .page-header h2 {
          font-size: 2rem;
          font-weight: 650;
          color: #0b1a2b;
          letter-spacing: -0.5px;
        }
    
        .page-header p {
          color: #5a6f82;
          font-size: 1rem;
          margin-top: 0.25rem;
        }
    
        /* 4列网格 */
        .product-grid {
          max-width: 1400px;
          margin: 0 auto;
          display: grid;
          grid-template-columns: repeat(4, 1fr);
          gap: 1.5rem;
        }
    
        /* 每个产品卡片 */
        .product-card {
          background: #ffffff;
          border-radius: 28px;
          box-shadow: 0 20px 40px rgba(0, 0, 0, 0.04), 0 8px 20px rgba(0, 0, 0, 0.03);
          padding: 1.5rem 1.2rem 1.2rem;
          transition: transform 0.2s ease, box-shadow 0.2s ease;
          border: 1px solid rgba(0, 0, 0, 0.02);
          display: flex;
          flex-direction: column;
        }
    
        .product-card:hover {
          transform: translateY(-4px);
          box-shadow: 0 24px 48px rgba(0, 0, 0, 0.06);
        }
    
        /* 品牌标题 */
        .brand-headline {
          display: flex;
          justify-content: space-between;
          align-items: baseline;
          margin-bottom: 0.15rem;
        }
    
        .brand-headline h3 {
          font-size: 1.2rem;
          font-weight: 650;
          color: #0b1a2b;
        }
    
        .brand-headline .badge {
          font-size: 0.6rem;
          font-weight: 500;
          background: #eef2f6;
          padding: 0.15rem 0.6rem;
          border-radius: 30px;
          color: #1f2a3a;
        }
    
        /* 产品名称 */
        .product-name {
          font-size: 0.85rem;
          font-weight: 450;
          color: #2c3e50;
          margin-bottom: 1rem;
          border-left: 3px solid #c0cfde;
          padding-left: 0.6rem;
          background: #fafcfe;
          border-radius: 0 4px 4px 0;
          display: inline-block;
          padding-right: 0.6rem;
        }
    
        /* 1:1 图片容器 */
        .product-image {
          width: 100%;
          aspect-ratio: 1 / 1;
          background: #ffffff;
          border-radius: 20px;
          margin-bottom: 1.2rem;
          overflow: hidden;
          display: flex;
          align-items: center;
          justify-content: center;
          border: 1px solid #f0f2f5;
          box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.02);
        }
    
        .product-image img {
          width: 100%;
          height: 100%;
          object-fit: contain;
          display: block;
        }
    
        /* 如果没有图片，显示占位SVG */
        .product-image .placeholder {
          width: 70%;
          height: 70%;
          color: #b6c9db;
          opacity: 0.4;
        }
    
        /* 价格块 */
        .price-block {
          display: flex;
          align-items: baseline;
          flex-wrap: wrap;
          gap: 0.3rem 0.6rem;
          margin: 0.3rem 0 0.8rem 0;
          background: #f9fbfd;
          padding: 0.3rem 0.6rem 0.3rem 0;
          border-radius: 40px;
        }
    
        .price-current {
          font-size: 1.5rem;
          font-weight: 700;
          color: #0b1a2b;
          letter-spacing: -0.3px;
        }
    
        .price-old {
          font-size: 1rem;
          font-weight: 400;
          color: #7c8b9c;
          text-decoration: line-through;
        }
    
        .price-tax-note {
          font-size: 0.6rem;
          font-weight: 450;
          color: #3d5a73;
          background: #e2f0e6;
          padding: 0.1rem 0.6rem;
          border-radius: 30px;
          margin-left: auto;
          white-space: nowrap;
        }
    
        /* 分期付款块 */
        .financing-block {
          background: #f2f6fc;
          border-radius: 16px;
          padding: 0.6rem 0.9rem;
          margin: 0.5rem 0 0.8rem 0;
          border: 1px solid #e5ecf3;
          flex-shrink: 0;
        }
    
        .financing-logos {
          display: flex;
          align-items: center;
          gap: 0.3rem 0.6rem;
          flex-wrap: wrap;
          margin-bottom: 0.15rem;
        }
    
        .financing-logos .bank {
          font-weight: 650;
          font-size: 0.7rem;
          color: #1a2b3c;
        }
    
        .financing-logos .bank-bnp {
          font-weight: 700;
          color: #0055a5;
          background: white;
          padding: 0.05rem 0.7rem 0.05rem 0.5rem;
          border-radius: 40px;
          font-size: 0.65rem;
          display: inline-flex;
          align-items: center;
          gap: 0.15rem;
          box-shadow: 0 1px 4px rgba(0, 0, 0, 0.02);
        }
    
        .financing-logos .bank-bnp::before {
          content: "●";
          color: #0095d9;
          font-size: 0.4rem;
          margin-right: 0.1rem;
        }
    
        .financing-details {
          display: flex;
          flex-wrap: wrap;
          align-items: baseline;
          justify-content: space-between;
          margin-top: 0.15rem;
        }
    
        .interest-rate {
          font-weight: 550;
          color: #1f3a4b;
          background: #ffffffcc;
          padding: 0.05rem 0.6rem 0.05rem 0.5rem;
          border-radius: 40px;
          font-size: 0.7rem;
        }
    
