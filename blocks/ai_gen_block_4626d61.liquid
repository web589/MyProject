    background: {{ block.settings.financing_background }};
    border-radius: 16px;
    padding: 0.6rem 0.9rem;
    margin: 0.5rem 0 0.8rem 0;
    border: 1px solid {{ block.settings.financing_border }};
    flex-shrink: 0;
  }

  .ai-financing-logos-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 0.3rem 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 0.15rem;
  }

  .ai-bank-{{ ai_gen_id }} {
    font-weight: 650;
    font-size: 0.7rem;
    color: {{ block.settings.financing_text_color }};
  }

  .ai-bank-bnp-{{ ai_gen_id }} {
    font-weight: 700;
    color: #0055a5;
    background: white;
    padding: 0.05rem 0.7rem 0.05rem 0.5rem;
    border-radius: 40px;
    font-size: 0.65rem;
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.02);
  }

  .ai-bank-bnp-{{ ai_gen_id }}::before {
    content: "●";
    color: #0095d9;
    font-size: 0.4rem;
    margin-right: 0.1rem;
  }

  .ai-financing-details-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    margin-top: 0.15rem;
  }

  .ai-interest-rate-{{ ai_gen_id }} {
    font-weight: 550;
    color: {{ block.settings.financing_text_color }};
    background: #ffffffcc;
    padding: 0.05rem 0.6rem 0.05rem 0.5rem;
    border-radius: 40px;
    font-size: 0.7rem;
  }

  .ai-monthly-payment-{{ ai_gen_id }} {
    font-weight: 600;
    color: {{ block.settings.financing_text_color }};
    font-size: 0.75rem;
  }

  .ai-product-link-{{ ai_gen_id }} {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  @media screen and (max-width: 1200px) {
    .ai-product-grid-container-{{ ai_gen_id }} {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-product-grid-container-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: 1rem;
    }

    .ai-product-grid-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.7);
    }

    .ai-product-grid-subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtitle_size }}px * 0.85);
    }

    .ai-product-card-{{ ai_gen_id }} {
      padding: 1rem 0.8rem 0.8rem;
    }
  }
{% endstyle %}

<product-grid-{{ ai_gen_id }} class="ai-product-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.title != blank or block.settings.subtitle != blank %}
    <div class="ai-product-grid-header-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-product-grid-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}
      {% if block.settings.subtitle != blank %}
        <p class="ai-product-grid-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="ai-product-grid-container-{{ ai_gen_id }}">
    {% for i in (1..8) %}
      {% liquid
        assign product_key = 'product_' | append: i
        assign product = block.settings[product_key]
        assign brand_key = 'brand_' | append: i
        assign brand = block.settings[brand_key]
        assign badge_key = 'badge_' | append: i
        assign badge = block.settings[badge_key]
        assign product_name_key = 'product_name_' | append: i
        assign product_name = block.settings[product_name_key]
      %}

      {% if product != blank %}
        <div class="ai-product-card-{{ ai_gen_id }}">
          <a href="{{ product.url }}" class="ai-product-link-{{ ai_gen_id }}">
            <div class="ai-brand-headline-{{ ai_gen_id }}">
              {% if brand != blank %}
                <h3 class="ai-brand-name-{{ ai_gen_id }}">{{ brand }}</h3>
              {% endif %}
              {% if badge != blank %}
                <span class="ai-badge-{{ ai_gen_id }}">{{ badge }}</span>
              {% endif %}
            </div>

            {% if product_name != blank %}
              <div class="ai-product-name-{{ ai_gen_id }}">{{ product_name }}</div>
            {% endif %}

            <div class="ai-product-image-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  width="600"
                  height="600"
                  loading="lazy"
                >
              {% else %}
                <div class="ai-product-image-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            <div class="ai-price-block-{{ ai_gen_id }}">
              <span class="ai-price-current-{{ ai_gen_id }}">{{ product.price | money }}</span>
              {% if product.compare_at_price > product.price %}
                <span class="ai-price-old-{{ ai_gen_id }}">{{ product.compare_at_price | money }}</span>
              {% endif %}
              {% if block.settings.show_tax_note %}
                <span class="ai-price-tax-note-{{ ai_gen_id }}">{{ block.settings.tax_note_text }}</span>
              {% endif %}
            </div>

            {% if block.settings.show_financing %}
              <div class="ai-financing-block-{{ ai_gen_id }}">
                <div class="ai-financing-logos-{{ ai_gen_id }}">
                  <span class="ai-bank-{{ ai_gen_id }}">{{ block.settings.financing_bank_1 }}</span>
                  <span class="ai-bank-bnp-{{ ai_gen_id }}">{{ block.settings.financing_bank_2 }}</span>
                </div>
                <div class="ai-financing-details-{{ ai_gen_id }}">
                  <span class="ai-interest-rate-{{ ai_gen_id }}">{{ block.settings.financing_rate_text }}</span>
                  {% if block.settings.show_monthly_payment %}
                    {% assign monthly = product.price | divided_by: block.settings.financing_months %}
                    <span class="ai-monthly-payment-{{ ai_gen_id }}">{{ monthly | money }}/{{ block.settings.financing_period_label }}</span>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          </a>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</product-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.cards = this.querySelectorAll('.ai-product-card-{{ ai_gen_id }}');
        this.setupAccessibility();
      }

      setupAccessibility() {
        this.cards.forEach((card) => {
          const link = card.querySelector('.ai-product-link-{{ ai_gen_id }}');
          if (link) {
            link.setAttribute('aria-label', 'View product details');
          }
        });
      }
    }

    customElements.define('product-grid-{{ ai_gen_id }}', ProductGrid{{ ai_gen_id }});
  })();
</script>

