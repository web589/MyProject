{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 1rem;
    background: {{ block.settings.background_color }};
  }

  .ai-product-grid-header-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto 2rem;
    padding: 0 0.5rem;
  }

  .ai-product-grid-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 650;
    color: {{ block.settings.title_color }};
    letter-spacing: -0.5px;
    margin: 0 0 0.25rem 0;
  }

  .ai-product-grid-subtitle-{{ ai_gen_id }} {
    color: {{ block.settings.subtitle_color }};
    font-size: {{ block.settings.subtitle_size }}px;
    margin: 0;
  }

  .ai-product-grid-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .ai-product-card-{{ ai_gen_id }} {
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.04), 0 8px 20px rgba(0, 0, 0, 0.03);
    padding: 1.5rem 1.2rem 1.2rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    border: 1px solid rgba(0, 0, 0, 0.02);
    display: flex;
    flex-direction: column;
  }

  .ai-product-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.06);
  }

  .ai-brand-headline-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.15rem;
  }

  .ai-brand-name-{{ ai_gen_id }} {
    font-size: 1.2rem;
    font-weight: 650;
    color: {{ block.settings.brand_color }};
    margin: 0;
  }

  .ai-badge-{{ ai_gen_id }} {
