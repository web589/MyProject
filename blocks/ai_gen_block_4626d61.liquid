    flex-wrap: wrap;
    gap: 0.3rem 0.6rem;
    margin: 0.3rem 0 0.8rem 0;
    background: {{ block.settings.price_block_background }};
    padding: 0.3rem 0.6rem 0.3rem 0;
    border-radius: 40px;
