    padding: 0.15rem 0.6rem;
    border-radius: 30px;
    color: {{ block.settings.badge_text_color }};
  }

  .ai-product-name-{{ ai_gen_id }} {
    font-size: 0.85rem;
    font-weight: 450;
    color: {{ block.settings.product_name_color }};
    margin-bottom: 1rem;
    border-left: 3px solid {{ block.settings.product_name_border }};
    padding-left: 0.6rem;
    background: {{ block.settings.product_name_background }};
    border-radius: 0 4px 4px 0;
    display: inline-block;
    padding-right: 0.6rem;
  }

  .ai-product-image-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background: #ffffff;
    border-radius: 20px;
    margin-bottom: 1.2rem;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #f0f2f5;
    box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.02);
  }

  .ai-product-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .ai-product-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
