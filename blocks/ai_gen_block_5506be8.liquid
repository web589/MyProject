{% doc %}
  @prompt
    <!DOCTYPE html>
    <html lang="zh-CN">
    <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>In den Medien 滚动版块</title>
    <style>
      /* 基础重置 */
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
    
      body {
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        background-color: #f8f9fa; /* 与图片一致的浅灰背景 */
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        padding: 40px 20px;
      }
    
      /* 主模块容器 */
      .media-section {
        width: 100%;
        max-width: 1200px;
      }
    
      /* 标题 */
      .media-section h2 {
        font-size: 28px;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 32px;
      }
    
      /* 滚动轨道外层容器 */
      .scroll-container {
        position: relative;
        width: 100%;
        overflow: hidden; /* 隐藏超出部分 */
        /* 左右两侧添加遮罩渐变，实现图片中的淡出效果 */
        -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
        mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
        padding: 10px 0; /* 留出一点上下空间 */
      }
    
      /* 滚动的轨道（无限循环的条带） */
      .scroll-track {
        display: flex;
        gap: 20px; /* 卡片之间的间距 */
        width: max-content; /* 宽度自适应内容 */
        animation: scroll 40s linear infinite; /* 40秒匀速无限滚动 */
      }
    
      /* 单个卡片样式 */
      .media-item {
        /* 固定宽度，保证排列整齐 */
        flex: 0 0 160px; 
        height: 56px;
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: #cdd7e4; /* 浅灰蓝色背景 */
        color: #475569; /* 文字颜色 */
        border-radius: 12px; /* 圆角 */
        font-size: 15px;
        font-weight: 500;
        transition: all 0.2s ease;
        cursor: default;
      }
    
      /* 鼠标悬停在卡片上的交互反馈（可选） */
      .media-item:hover {
        background-color: #bfcde0;
        color: #1e293b;
      }
    
      /* 鼠标悬停在滚动容器上时，暂停滚动，便于用户查看 */
      .scroll-track:hover {
        animation-play-state: paused;
      }
    
      /* ----- 核心动画关键帧 ----- */
      @keyframes scroll {
        0% {
          transform: translateX(0);
        }
        100% {
          /* 因为我们在 HTML 中复制了一组同样的项目，
             所以移动 50% 的距离就能实现完美无缝衔接 */
          transform: translateX(-50%);
        }
      }
    
      /* --- 移动端适配 --- */
      @media (max-width: 768px) {
        .media-section h2 {
          font-size: 22px;
          margin-bottom: 20px;
        }
        .media-item {
          flex: 0 0 130px;
          height: 46px;
          font-size: 13px;
        }
      }
    </style>
    </head>
    <body>
    
    <div class="media-section">
      <h2>In den Medien</h2>
      
      <div class="scroll-container">
        <div class="scroll-track">
          <!-- ===== 第一组：真实的Logo列表 ===== -->
          <div class="media-item">Forbes</div>
          <div class="media-item">Bloomberg</div>
          <div class="media-item">Handelsblatt</div>
          <div class="media-item">PV Magazine</div>
          <div class="media-item">Electrek</div>
          <div class="media-item">CleanTechnica</div>
          <div class="media-item">TechCrunch</div>
          <div class="media-item">Wired</div>
    
          <!-- ===== 第二组：克隆的重复列表（必须与第一组完全一致，用于实现无缝衔接） ===== -->
          <div class="media-item">Forbes</div>
          <div class="media-item">Bloomberg</div>
          <div class="media-item">Handelsblatt</div>
          <div class="media-item">PV Magazine</div>
          <div class="media-item">Electrek</div>
          <div class="media-item">CleanTechnica</div>
          <div class="media-item">TechCrunch</div>
          <div class="media-item">Wired</div>
        </div>
      </div>
    </div>
    
    </body>
    </html>
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-media-scroll-{{ ai_gen_id }} {
    --media-carousel-gap: {{ block.settings.item_gap }}px;
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px clamp(16px, 3vw, 40px);
    background-color: {{ block.settings.background_color }};
  }

  .ai-media-scroll__inner-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-media-scroll__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    color: {{ block.settings.title_color }};
    margin-bottom: {% if block.settings.subtitle != blank %}8{% else %}{{ block.settings.title_spacing }}{% endif %}px;
    text-align: {{ block.settings.title_alignment }};
  }

  .ai-media-scroll__subtitle-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.title_spacing | minus: 8 }}px;
    color: #596b82;
    font-size: 16px;
    line-height: 1.5;
    text-align: {{ block.settings.title_alignment }};
  }

  .ai-media-scroll__subtitle-{{ ai_gen_id }} p {
    margin: 0;
  }

  .ai-media-scroll__container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
    mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
    padding: 14px 0;
  }

  .ai-media-scroll__track-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    width: max-content;
    transform: translate3d(0, 0, 0);
    animation: ai-media-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
    will-change: transform;
  }

  .ai-media-scroll__track-{{ ai_gen_id }}.is-paused,
  .ai-media-scroll__track-{{ ai_gen_id }}:hover {
    animation-play-state: paused;
  }

  .ai-media-scroll__group-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    gap: var(--media-carousel-gap);
  }

  .ai-media-scroll-{{ ai_gen_id }} .ai-media-scroll__item {
    flex: 0 0 auto;
    width: max-content;
    max-width: 100%;
    min-width: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    color: {{ block.settings.item_text_color }};
    font-size: {{ block.settings.item_font_size }}px;
    font-weight: 500;
    line-height: 1.2;
    cursor: default;
    text-align: center;
    box-sizing: border-box;
    transition: transform 0.25s ease;
  }

  .ai-media-scroll-{{ ai_gen_id }} .ai-media-scroll__item-link {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .ai-media-scroll-{{ ai_gen_id }} .ai-media-scroll__item:not(.ai-media-scroll__item--has-image) .ai-media-scroll__item-link {
    padding: 8px 12px;
  }

  .ai-media-scroll-{{ ai_gen_id }} .ai-media-scroll__item-image {
    display: block;
    width: var(--media-logo-width, auto);
    height: auto;
    max-width: min(100%, calc(100vw - 32px));
    max-height: 100%;
    object-fit: contain;
    object-position: center;
    transform: scale(1);
    transform-origin: center;
    transition: transform 0.25s ease;
  }

  @keyframes ai-media-scroll-{{ ai_gen_id }} {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(calc(-1 * var(--media-carousel-distance, 50%)), 0, 0);
    }
  }

  .ai-media-scroll-{{ ai_gen_id }} .ai-media-scroll__item:hover,
  .ai-media-scroll-{{ ai_gen_id }} .ai-media-scroll__item:focus-within {
    z-index: 1;
  }

  .ai-media-scroll-{{ ai_gen_id }} .ai-media-scroll__item--has-image:hover .ai-media-scroll__item-image,
  .ai-media-scroll-{{ ai_gen_id }} .ai-media-scroll__item--has-image:focus-within .ai-media-scroll__item-image {
    transform: scale(1.08);
  }

  @media screen and (max-width: 768px) {
    .ai-media-scroll-{{ ai_gen_id }} {
      padding-left: 16px;
      padding-right: 16px;
    }

    .ai-media-scroll__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
      margin-bottom: {{ block.settings.title_spacing | times: 0.7 }}px;
    }

    .ai-media-scroll-{{ ai_gen_id }} .ai-media-scroll__item {
      font-size: {{ block.settings.item_font_size | times: 0.9 }}px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-media-scroll__track-{{ ai_gen_id }} {
      animation: none;
    }

    .ai-media-scroll-{{ ai_gen_id }} .ai-media-scroll__item-image {
      transition: none;
    }
  }
{% endstyle %}

<media-scroll-{{ ai_gen_id }} class="ai-media-scroll-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-media-scroll__inner-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h2 class="ai-media-scroll__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    {% endif %}
    {% if block.settings.subtitle != blank %}
      <div class="ai-media-scroll__subtitle-{{ ai_gen_id }} rte">{{ block.settings.subtitle }}</div>
    {% endif %}

    <div
      class="ai-media-scroll__container-{{ ai_gen_id }}"
      data-media-scroll-container
      role="region"
      {% if block.settings.title != blank %}aria-label="{{ block.settings.title | strip_html | escape }}"{% endif %}
    >
      <div class="ai-media-scroll__track-{{ ai_gen_id }}" data-media-scroll-track>
        <div class="ai-media-scroll__group-{{ ai_gen_id }}" data-media-scroll-group>
          {% content_for 'blocks' %}
        </div>
      </div>
    </div>
  </div>
</media-scroll-{{ ai_gen_id }}>

<script>
  (function() {
    class MediaScroll{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.initialized = false;
        this.groups = [];
        this.boundItems = [];
        this.isItemHovered = false;
        this.isItemFocused = false;
        this.handleResize = this.updateCarousel.bind(this);
        this.handleImageLoad = this.updateCarousel.bind(this);
        this.handleItemEnter = this.pauseForItem.bind(this);
        this.handleItemLeave = this.resumeFromItem.bind(this);
        this.handleItemFocusIn = this.pauseForFocus.bind(this);
        this.handleItemFocusOut = this.resumeFromFocus.bind(this);
      }

      connectedCallback() {
        if (this.initialized) return;

        this.track = this.querySelector('[data-media-scroll-track]');
        this.container = this.querySelector('[data-media-scroll-container]');
        this.group = this.querySelector('[data-media-scroll-group]');
        if (!this.track || !this.container || !this.group) return;

        this.items = Array.from(this.group.children).filter((item) => item.hasAttribute('data-media-logo-item'));
        if (!this.items.length) return;

        this.initialized = true;
        this.groups = [this.group];
        this.bindGroup(this.group);

        this.updateCarousel();

        if ('ResizeObserver' in window) {
          this.resizeObserver = new ResizeObserver(this.handleResize);
          this.resizeObserver.observe(this.container);
          this.resizeObserver.observe(this.group);
        } else {
          window.addEventListener('resize', this.handleResize, { passive: true });
        }
      }

      disconnectedCallback() {
        if (!this.initialized) return;

        if (this.resizeObserver) this.resizeObserver.disconnect();
        window.removeEventListener('resize', this.handleResize);
        this.boundItems.forEach((item) => this.unbindItem(item));
        this.groups.slice(1).forEach((group) => group.remove());
        this.groups = [];
        this.boundItems = [];
        this.isItemHovered = false;
        this.isItemFocused = false;
        this.initialized = false;
      }

      createClone() {
        const clone = this.group.cloneNode(true);
        clone.setAttribute('aria-hidden', 'true');
        clone.removeAttribute('data-shopify-editor-block');
        clone.querySelectorAll('[data-shopify-editor-block]').forEach((element) => element.removeAttribute('data-shopify-editor-block'));
        clone.querySelectorAll('a, button, input').forEach((element) => element.setAttribute('tabindex', '-1'));
        this.track.appendChild(clone);
        this.bindGroup(clone);
        return clone;
      }

      bindGroup(group) {
        const items = Array.from(group.children).filter((item) => item.hasAttribute('data-media-logo-item'));
        items.forEach((item) => {
          item.addEventListener('mouseenter', this.handleItemEnter);
          item.addEventListener('mouseleave', this.handleItemLeave);
          item.addEventListener('focusin', this.handleItemFocusIn);
          item.addEventListener('focusout', this.handleItemFocusOut);
          item.querySelectorAll('img').forEach((image) => {
            if (!image.complete) image.addEventListener('load', this.handleImageLoad);
          });
          this.boundItems.push(item);
        });
      }

      unbindItem(item) {
        item.removeEventListener('mouseenter', this.handleItemEnter);
        item.removeEventListener('mouseleave', this.handleItemLeave);
        item.removeEventListener('focusin', this.handleItemFocusIn);
        item.removeEventListener('focusout', this.handleItemFocusOut);
        item.querySelectorAll('img').forEach((image) => image.removeEventListener('load', this.handleImageLoad));
      }

      updateCarousel() {
        if (!this.container || !this.track || !this.group || !this.items.length) return;

        if (this.items.length < 2) {
          this.track.style.animation = 'none';
          return;
        }

        const groupWidth = this.group.getBoundingClientRect().width;
        if (!groupWidth) return;

        const requiredGroupCount = Math.max(2, Math.ceil(this.container.clientWidth / groupWidth) + 1);
        while (this.groups.length < requiredGroupCount) {
          this.groups.push(this.createClone());
        }

        this.track.style.setProperty('--media-carousel-distance', `${groupWidth}px`);
        if (this.track.style.animation === 'none') this.track.style.removeProperty('animation');
      }

      pauseForItem() {
        this.isItemHovered = true;
        if (this.track) this.track.classList.add('is-paused');
      }

      resumeFromItem() {
        this.isItemHovered = false;
        this.resumeIfClear();
      }

      pauseForFocus() {
        this.isItemFocused = true;
        if (this.track) this.track.classList.add('is-paused');
      }

      resumeFromFocus(event) {
        if (event.relatedTarget && event.currentTarget.contains(event.relatedTarget)) return;
        this.isItemFocused = false;
        this.resumeIfClear();
      }

      resumeIfClear() {
        if (this.isItemHovered || this.isItemFocused) return;
        if (this.track) this.track.classList.remove('is-paused');
      }
    }

    if (!customElements.get('media-scroll-{{ ai_gen_id }}')) {
      customElements.define('media-scroll-{{ ai_gen_id }}', MediaScroll{{ ai_gen_id }});
    }
  })();
</script>

{% schema %}
{
  "name": "Media logos scroll",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
