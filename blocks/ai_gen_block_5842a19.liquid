    opacity: 0.9;
  }

  .ai-preorder-btn-{{ ai_gen_id }} {
    flex: 1;
    padding: 12px 0;
    border: 1px solid {{ block.settings.secondary_button_border }};
    border-radius: {{ block.settings.cta_border_radius }}px;
    background: {{ block.settings.secondary_button_bg }};
    color: {{ block.settings.secondary_button_color }};
    font-weight: 500;
    cursor: pointer;
    font-size: 16px;
    text-decoration: none;
    text-align: center;
    display: block;
  }

  .ai-preorder-btn-{{ ai_gen_id }}:hover {
    background: {{ block.settings.secondary_button_hover_bg }};
  }

  @media (max-width: 1024px) {
    .ai-product-slider-header-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }

    .ai-product-slider-header-left-{{ ai_gen_id }} h2 {
      font-size: {{ block.settings.heading_size | times: 0.75 }}px;
    }

    .ai-product-card-{{ ai_gen_id }} {
      min-width: 280px;
    }
  }

  @media (max-width: 749px) {
    .ai-product-slider-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<product-slider-{{ ai_gen_id }} class="ai-product-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-slider-wrapper-{{ ai_gen_id }}">
    <div class="ai-product-slider-header-{{ ai_gen_id }}">
      <div class="ai-product-slider-header-left-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2>{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <p>{{ block.settings.subheading }}</p>
        {% endif %}
      </div>
      <div class="ai-product-slider-header-right-{{ ai_gen_id }}">
        {% if block.settings.view_all_link != blank %}
          <a href="{{ block.settings.view_all_link }}" class="ai-product-slider-view-all-{{ ai_gen_id }}">
            {{ block.settings.view_all_text }} →
          </a>
        {% endif %}
        <div class="ai-product-slider-buttons-{{ ai_gen_id }}">
          <button class="ai-product-slider-btn-{{ ai_gen_id }} ai-product-slider-btn-prev-{{ ai_gen_id }}" aria-label="Previous">‹</button>
          <button class="ai-product-slider-btn-{{ ai_gen_id }} ai-product-slider-btn-next-{{ ai_gen_id }}" aria-label="Next">›</button>
        </div>
      </div>
    </div>

    <div class="ai-product-slider-container-{{ ai_gen_id }}">
      <div class="ai-product-slider-track-{{ ai_gen_id }}">
        {% for i in (1..6) %}
          {% liquid
            assign product_key = 'product_' | append: i
            assign product = block.settings[product_key]
            assign tag_key = 'product_' | append: i | append: '_tag'
            assign tag = block.settings[tag_key]
            assign desc_key = 'product_' | append: i | append: '_description'
            assign desc = block.settings[desc_key]
            assign savings_key = 'product_' | append: i | append: '_savings'
            assign savings = block.settings[savings_key]
            assign primary_btn_key = 'product_' | append: i | append: '_primary_button_text'
            assign primary_btn_text = block.settings[primary_btn_key]
            assign primary_url_key = 'product_' | append: i | append: '_primary_url'
            assign primary_url = block.settings[primary_url_key]
            assign secondary_btn_key = 'product_' | append: i | append: '_secondary_button_text'
            assign secondary_btn_text = block.settings[secondary_btn_key]
            assign secondary_url_key = 'product_' | append: i | append: '_secondary_url'
            assign secondary_url = block.settings[secondary_url_key]
          %}

          <div class="ai-product-card-{{ ai_gen_id }}">
            <div class="ai-product-img-box-{{ ai_gen_id }}">
              {% if product != blank and product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  loading="lazy"
                  width="600"
                  height="{{ block.settings.image_height }}"
                >
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}
            </div>

            {% if product != blank %}
              <h3 class="ai-product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
            {% else %}
              <h3 class="ai-product-title-{{ ai_gen_id }}">Product {{ i }}</h3>
            {% endif %}

            {% if tag != blank %}
              <div class="ai-product-tag-{{ ai_gen_id }}">{{ tag }}</div>
            {% endif %}

            {% if desc != blank %}
              <div class="ai-product-desc-{{ ai_gen_id }}">{{ desc }}</div>
            {% elsif product != blank and product.description != blank %}
              <div class="ai-product-desc-{{ ai_gen_id }}">{{ product.description | strip_html | truncate: 120 }}</div>
            {% endif %}

            {% if savings != blank %}
              <div class="ai-save-tag-{{ ai_gen_id }}">{{ savings }}</div>
            {% endif %}

            <div class="ai-btn-group-{{ ai_gen_id }}">
              {% if primary_url != blank %}
                <a href="{{ primary_url }}" class="ai-buy-btn-{{ ai_gen_id }}">
                  {{ primary_btn_text }}
                </a>
              {% elsif product != blank %}
                <a href="{{ product.url }}" class="ai-buy-btn-{{ ai_gen_id }}">
                  {{ primary_btn_text }}
                </a>
              {% endif %}

              {% if secondary_url != blank %}
                <a href="{{ secondary_url }}" class="ai-preorder-btn-{{ ai_gen_id }}">
                  {{ secondary_btn_text }}
                </a>
              {% elsif product != blank %}
                <a href="{{ product.url }}" class="ai-preorder-btn-{{ ai_gen_id }}">
                  {{ secondary_btn_text }}
                </a>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</product-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.cardWidth = {{ block.settings.card_width }};
        this.cardGap = {{ block.settings.card_gap }};
        this.isResizing = false;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-product-slider-track-{{ ai_gen_id }}');
        this.prevBtn = this.querySelector('.ai-product-slider-btn-prev-{{ ai_gen_id }}');
        this.nextBtn = this.querySelector('.ai-product-slider-btn-next-{{ ai_gen_id }}');
        this.cards = this.querySelectorAll('.ai-product-card-{{ ai_gen_id }}');
        this.container = this.querySelector('.ai-product-slider-container-{{ ai_gen_id }}');
        
        this.setupEventListeners();
        this.updateButtons();

        window.addEventListener('resize', () => {
          if (!this.isResizing) {
            this.isResizing = true;
            setTimeout(() => {
              this.currentIndex = 0;
              this.track.style.transform = 'translateX(0)';
              this.updateButtons();
              this.isResizing = false;
            }, 100);
          }
        });
      }

      setupEventListeners() {
        this.prevBtn.addEventListener('click', () => this.slide(-1));
        this.nextBtn.addEventListener('click', () => this.slide(1));
      }

      slide(direction) {
        const visibleCards = this.getVisibleCards();
        const totalCards = this.cards.length;
        const maxIndex = Math.max(0, totalCards - visibleCards);
        
        this.currentIndex = Math.max(0, Math.min(this.currentIndex + direction, maxIndex));
        
        const offset = this.currentIndex * (this.cardWidth + this.cardGap);
        this.track.style.transform = `translateX(-${offset}px)`;
        
        this.updateButtons();
      }

      getVisibleCards() {
        const containerWidth = this.container.offsetWidth;
        const cardTotalWidth = this.cardWidth + this.cardGap;
        const visibleCount = Math.floor((containerWidth + this.cardGap) / cardTotalWidth);
        return Math.max(1, visibleCount);
      }

      updateButtons() {
        const visibleCards = this.getVisibleCards();
        const totalCards = this.cards.length;
        const maxIndex = Math.max(0, totalCards - visibleCards);
        
        this.prevBtn.disabled = this.currentIndex === 0;
        this.nextBtn.disabled = this.currentIndex >= maxIndex;
      }
    }

    customElements.define('product-slider-{{ ai_gen_id }}', ProductSlider{{ ai_gen_id }});
  })();
</script>

