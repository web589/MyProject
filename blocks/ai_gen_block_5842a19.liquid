{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-slider-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-product-slider-wrapper-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-product-slider-header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
  }

  .ai-product-slider-header-left-{{ ai_gen_id }} h2 {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    color: {{ block.settings.heading_color }};
    margin-bottom: 12px;
  }

  .ai-product-slider-header-left-{{ ai_gen_id }} p {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
  }

  .ai-product-slider-header-right-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .ai-product-slider-view-all-{{ ai_gen_id }} {
    color: {{ block.settings.link_color }};
    font-size: 17px;
    text-decoration: none;
    font-weight: 500;
  }

  .ai-product-slider-view-all-{{ ai_gen_id }}:hover {
    text-decoration: underline;
  }

  .ai-product-slider-buttons-{{ ai_gen_id }} {
    display: flex;
    gap: 6px;
  }

  .ai-product-slider-btn-{{ ai_gen_id }} {
    width: 36px;
    height: 36px;
    border-radius: {{ block.settings.button_border_radius }}px;
    border: none;
    font-size: 18px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-product-slider-btn-prev-{{ ai_gen_id }} {
    background: {{ block.settings.nav_button_bg }};
    border: 1px solid {{ block.settings.nav_button_border }};
    color: {{ block.settings.nav_button_color }};
  }

  .ai-product-slider-btn-next-{{ ai_gen_id }} {
    background: {{ block.settings.nav_button_active_bg }};
    color: {{ block.settings.nav_button_active_color }};
  }

  .ai-product-slider-btn-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-product-slider-btn-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-product-slider-container-{{ ai_gen_id }} {
    overflow: hidden;
  }

  .ai-product-slider-track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.4s ease;
    gap: {{ block.settings.card_gap }}px;
  }

  .ai-product-card-{{ ai_gen_id }} {
    min-width: {{ block.settings.card_width }}px;
    background: {{ block.settings.card_bg }};
    border: 1px solid {{ block.settings.card_border }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
  }

  .ai-product-img-box-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.image_height }}px;
    background: {{ block.settings.image_bg }};
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
    margin-bottom: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-img-box-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .ai-product-img-box-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    font-weight: 700;
    color: {{ block.settings.product_title_color }};
    margin-bottom: 14px;
  }

  .ai-product-tag-{{ ai_gen_id }} {
    color: {{ block.settings.tag_color }};
    font-size: {{ block.settings.tag_size }}px;
    font-weight: 500;
    margin-bottom: 12px;
  }

  .ai-product-desc-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.6;
    margin-bottom: 16px;
    flex-grow: 1;
  }

  .ai-save-tag-{{ ai_gen_id }} {
    background: {{ block.settings.savings_bg }};
    color: {{ block.settings.savings_color }};
    font-size: {{ block.settings.savings_size }}px;
    padding: 6px 10px;
    border-radius: 6px;
    display: inline-block;
    margin-bottom: 22px;
  }

  .ai-btn-group-{{ ai_gen_id }} {
    display: flex;
    gap: 10px;
  }

  .ai-buy-btn-{{ ai_gen_id }} {
    flex: 1;
    padding: 12px 0;
    border: none;
    border-radius: {{ block.settings.cta_border_radius }}px;
    background: {{ block.settings.primary_button_bg }};
    color: {{ block.settings.primary_button_color }};
