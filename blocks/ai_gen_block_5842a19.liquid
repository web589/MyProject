      padding: 80px 20px;
    }
    
    .wrapper {
      max-width: 1400px;
      margin: 0 auto;
    }
    
    /* 头部标题区域 */
    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 40px;
    }
    .header-left h2 {
      font-size: 42px;
      font-weight: 700;
      color: #111;
      margin-bottom: 12px;
    }
    .header-left p {
      font-size: 18px;
      color: #666;
    }
    
    .header-right {
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .view-all-link {
      color: #0099ff;
      font-size: 17px;
      text-decoration: none;
      font-weight: 500;
    }
    .view-all-link:hover {
      text-decoration: underline;
    }
    .slider-buttons {
      display: flex;
      gap: 6px;
    }
    .slider-btn {
      width: 36px;
      height: 36px;
      border-radius: 4px;
      border: none;
      font-size: 18px;
      cursor: pointer;
    }
    .btn-prev {
      background: #ffffff;
      border: 1px solid #ddd;
    }
    .btn-next {
      background: #0099ff;
      color: #fff;
    }
    
    /* 滑块容器 */
    .slider-container {
      overflow: hidden;
    }
    .slider-track {
      display: flex;
      transition: transform 0.4s ease;
      gap: 24px;
    }
    
    /* 产品卡片 */
    .product-card {
      min-width: 320px;
      background: #fff;
      border: 1px solid #eee;
      border-radius: 12px;
      padding: 24px;
      display: flex;
      flex-direction: column;
    }
    
    /* 图片容器 纯留白 无灰边 */
    .product-img-box {
      width: 100%;
      height: 220px;
      background: #ffffff;
      border-radius: 8px;
      overflow: hidden;
      margin-bottom: 22px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    /* 自定义图片插槽，修改src替换图片 */
    .product-img-box img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
    }
    
    .product-title {
      font-size: 26px;
      font-weight: 700;
      color: #111;
      margin-bottom: 14px;
    }
    .product-tag {
      color: #0099ff;
      font-size: 16px;
      font-weight: 500;
      margin-bottom: 12px;
    }
    .product-desc {
      font-size: 15px;
      color: #555;
      line-height: 1.6;
      margin-bottom: 16px;
      flex-grow: 1;
    }
    
    .save-tag {
      background: #e6f4ff;
      color: #0066cc;
      font-size: 15px;
      padding: 6px 10px;
      border-radius: 6px;
      display: inline-block;
      margin-bottom: 22px;
    }
    
    /* 底部按钮组 */
    .btn-group {
      display: flex;
      gap: 10px;
    }
    .buy-btn {
      flex: 1;
      padding: 12px 0;
      border: none;
      border-radius: 6px;
      background: linear-gradient(90deg, #0088ff, #00ddcc);
      color: #fff;
      font-weight: 600;
      cursor: pointer;
      font-size: 16px;
    }
    .preorder-btn {
      flex: 1;
      padding: 12px 0;
      border: 1px solid #ddd;
      border-radius: 6px;
      background: #fff;
      color: #333;
      font-weight: 500;
      cursor: pointer;
      font-size: 16px;
    }
    
    /* 移动端适配 */
    @media (max-width: 1024px) {
      .section-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 20px;
      }
      .header-left h2 {
        font-size: 32px;
      }
      .product-card {
        min-width: 280px;
      }
    }
    </style>
