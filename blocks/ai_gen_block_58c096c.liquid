  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Bar style"
    },
    {
      "type": "range",
      "id": "bar_height",
      "label": "Bar height",
      "min": 30,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
