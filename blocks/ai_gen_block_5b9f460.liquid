{% doc %}
  @prompt
    {% stylesheet %}
    /* 外层区块容器 */
    .balkon-vorteile-slider-section {
      width: 100%;
      padding: 70px 20px;
      box-sizing: border-box;
      background: #ffffff;
      overflow: hidden;
    }
    .vorteile-inner-wrap {
      max-width: 1440px;
      margin: 0 auto;
      position: relative;
    }
    /* 标题区域 */
    .vorteile-main-title {
      font-size: clamp(2rem, 5vw, 3.2rem);
      font-weight: 800;
      margin: 0 0 16px;
      color: #000;
    }
    .vorteile-sub-desc {
      font-size: 1.1rem;
      color: #222;
      margin: 0 0 50px;
    }
    /* 轮播容器 */
    .slider-outer {
      overflow: hidden;
    }
    .slider-track {
      display: flex;
      gap: 30px;
      transition: transform 0.4s ease-out;
    }
    /* 单张卡片宽度 */
    .vorteile-card {
      flex: 0 0 calc(33.333% - 20px);
      overflow: hidden;
      background: #f7f7f7;
    }
    @media screen and (max-width: 992px) {
      .vorteile-card {
        flex: 0 0 calc(50% - 15px);
      }
    }
    @media screen and (max-width: 640px) {
      .vorteile-card {
        flex: 0 0 100%;
      }
    }
    /* 图片容器+缩放动画 */
    .card-img-wrap {
      position: relative;
      overflow: hidden;
    }
    .card-img {
      width: 100%;
      display: block;
      transition: transform 0.4s ease;
    }
    .vorteile-card:hover .card-img {
      transform: scale(1.06);
    }
    /* 渐变分割线：hover从左到右展开 */
    .card-divider-line {
      height: 4px;
      width: 0;
      background: linear-gradient(90deg, #00b8e6, #36d399);
      transition: width 0.3s ease-out;
    }
    .vorteile-card:hover .card-divider-line {
      width: 100%;
    }
    /* 卡片文字区域 */
    .card-text-area {
      padding: 24px 20px;
    }
    .card-title {
      font-size: 1.4rem;
      font-weight: 700;
      margin: 0 0 14px;
      color: #000;
    }
    .card-desc {
      font-size: 0.98rem;
      line-height: 1.6;
      color: #333;
      margin: 0;
    }
    /* 左右悬浮切换箭头按钮 */
    .slider-arrow {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 50px;
      height: 50px;
      background: rgba(255,255,255,0.85);
      border: none;
      border-radius: 4px;
      cursor: pointer;
      z-index: 10;
      display: grid;
      place-items: center;
      transition: background 0.2s ease;
    }
    .slider-arrow:hover {
      background: #fff;
    }
    .arrow-left {
      left: 0;
    }
    .arrow-right {
      right: 0;
    }
    .arrow-icon {
      width: 20px;
      height: 20px;
      stroke: #000;
      stroke-width: 2.5;
      fill: transparent;
    }
    {% endstylesheet %}
    
