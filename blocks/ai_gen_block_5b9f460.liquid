{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-balkon-slider-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    box-sizing: border-box;
    background: {{ block.settings.background_color }};
    overflow: hidden;
  }

  .ai-balkon-inner-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    position: relative;
  }

  .ai-balkon-title-{{ ai_gen_id }} {
    font-size: clamp(2rem, 5vw, {{ block.settings.title_size }}px);
    font-weight: 800;
    margin: 0 0 16px;
    color: {{ block.settings.title_color }};
  }

  .ai-balkon-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0 0 50px;
  }

  .ai-slider-outer-{{ ai_gen_id }} {
    overflow: hidden;
  }

  .ai-slider-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    transition: transform 0.4s ease-out;
  }

  .ai-card-{{ ai_gen_id }} {
    flex: 0 0 calc(33.333% - {{ block.settings.card_gap | times: 2 | divided_by: 3 }}px);
    overflow: hidden;
    background: {{ block.settings.card_background }};
  }

  @media screen and (max-width: 992px) {
    .ai-card-{{ ai_gen_id }} {
      flex: 0 0 calc(50% - {{ block.settings.card_gap | divided_by: 2 }}px);
    }
  }

  @media screen and (max-width: 640px) {
    .ai-card-{{ ai_gen_id }} {
      flex: 0 0 100%;
    }
  }

  .ai-card-img-wrap-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-card-img-{{ ai_gen_id }} {
    width: 100%;
    display: block;
    transition: transform 0.4s ease;
  }

  .ai-card-{{ ai_gen_id }}:hover .ai-card-img-{{ ai_gen_id }} {
    transform: scale(1.06);
  }

  .ai-card-divider-{{ ai_gen_id }} {
    height: {{ block.settings.divider_height }}px;
    width: 0;
    background: linear-gradient(90deg, {{ block.settings.gradient_start }}, {{ block.settings.gradient_end }});
    transition: width 0.3s ease-out;
  }

  .ai-card-{{ ai_gen_id }}:hover .ai-card-divider-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-card-text-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px 20px;
  }

  .ai-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: 700;
    margin: 0 0 14px;
    color: {{ block.settings.card_title_color }};
  }

  .ai-card-desc-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_desc_size }}px;
    line-height: 1.6;
    color: {{ block.settings.card_desc_color }};
    margin: 0;
  }

  .ai-arrow-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: {{ block.settings.arrow_size }}px;
    height: {{ block.settings.arrow_size }}px;
    background: {{ block.settings.arrow_background }};
    border: none;
    border-radius: {{ block.settings.arrow_radius }}px;
    cursor: pointer;
    z-index: 10;
    display: grid;
    place-items: center;
    transition: background 0.2s ease;
  }

  .ai-arrow-{{ ai_gen_id }}:hover {
    background: {{ block.settings.arrow_hover_background }};
  }

  .ai-arrow-left-{{ ai_gen_id }} {
    left: 0;
  }

  .ai-arrow-right-{{ ai_gen_id }} {
    right: 0;
  }

  .ai-arrow-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    stroke: {{ block.settings.arrow_color }};
    stroke-width: 2.5;
    fill: transparent;
  }
{% endstyle %}

<balkon-slider-{{ ai_gen_id }} class="ai-balkon-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-balkon-inner-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h2 class="ai-balkon-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    {% endif %}

    {% if block.settings.subtitle != blank %}
      <p class="ai-balkon-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
    {% endif %}

    <button class="ai-arrow-{{ ai_gen_id }} ai-arrow-left-{{ ai_gen_id }}" aria-label="Previous slide">
      <svg class="ai-arrow-icon-{{ ai_gen_id }}" viewBox="0 0 24 24">
        <path d="M15 19l-7-7 7-7"/>
      </svg>
    </button>

    <button class="ai-arrow-{{ ai_gen_id }} ai-arrow-right-{{ ai_gen_id }}" aria-label="Next slide">
      <svg class="ai-arrow-icon-{{ ai_gen_id }}" viewBox="0 0 24 24">
        <path d="M9 5l7 7-7 7"/>
      </svg>
    </button>

    <div class="ai-slider-outer-{{ ai_gen_id }}">
      <div class="ai-slider-track-{{ ai_gen_id }}">
        {% for i in (1..6) %}
          {% liquid
            assign card_enabled_key = 'card_' | append: i | append: '_enabled'
            assign card_image_key = 'card_' | append: i | append: '_image'
            assign card_title_key = 'card_' | append: i | append: '_title'
            assign card_desc_key = 'card_' | append: i | append: '_description'

            assign card_enabled = block.settings[card_enabled_key]
            assign card_image = block.settings[card_image_key]
            assign card_title = block.settings[card_title_key]
            assign card_desc = block.settings[card_desc_key]
          %}

          {% if card_enabled %}
            <div class="ai-card-{{ ai_gen_id }}">
              <div class="ai-card-img-wrap-{{ ai_gen_id }}">
                {% if card_image %}
                  <img
                    class="ai-card-img-{{ ai_gen_id }}"
                    src="{{ card_image | image_url: width: 800 }}"
                    alt="{{ card_image.alt | escape }}"
                    loading="lazy"
                    width="{{ card_image.width }}"
                    height="{{ card_image.height }}"
                  >
                {% else %}
                  <div class="ai-card-img-placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
              <div class="ai-card-divider-{{ ai_gen_id }}"></div>
              <div class="ai-card-text-{{ ai_gen_id }}">
                {% if card_title != blank %}
                  <h3 class="ai-card-title-{{ ai_gen_id }}">{{ card_title }}</h3>
                {% endif %}
                {% if card_desc != blank %}
                  <p class="ai-card-desc-{{ ai_gen_id }}">{{ card_desc }}</p>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</balkon-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class BalkonSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.track = this.querySelector('.ai-slider-track-{{ ai_gen_id }}');
        this.cards = this.querySelectorAll('.ai-card-{{ ai_gen_id }}');
        this.leftBtn = this.querySelector('.ai-arrow-left-{{ ai_gen_id }}');
        this.rightBtn = this.querySelector('.ai-arrow-right-{{ ai_gen_id }}');
      }

      connectedCallback() {
        if (!this.track || this.cards.length === 0) return;

        this.leftBtn.addEventListener('click', () => this.slide(-1));
        this.rightBtn.addEventListener('click', () => this.slide(1));

        this.updateSlider();
      }

      slide(direction) {
        const cardsPerView = this.getCardsPerView();
        const maxIndex = Math.max(0, this.cards.length - cardsPerView);

        this.currentIndex += direction;

        if (this.currentIndex < 0) {
          this.currentIndex = maxIndex;
        } else if (this.currentIndex > maxIndex) {
          this.currentIndex = 0;
        }

        this.updateSlider();
      }

      getCardsPerView() {
        const width = window.innerWidth;
        if (width <= 640) return 1;
        if (width <= 992) return 2;
        return 3;
      }

      updateSlider() {
        const cardWidth = this.cards[0].offsetWidth;
        const gap = {{ block.settings.card_gap }};
        const offset = this.currentIndex * (cardWidth + gap);
        this.track.style.transform = `translateX(-${offset}px)`;
      }
    }

    customElements.define('balkon-slider-{{ ai_gen_id }}', BalkonSlider{{ ai_gen_id }});
  })();
</script>

