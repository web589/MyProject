{% endstyle %}

<blog-carousel-{{ ai_gen_id }} class="ai-blog-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank or block.settings.description != blank %}
    <div class="ai-blog-header-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2>{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.description != blank %}
        <p>{{ block.settings.description }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="ai-blog-slider-wrapper-{{ ai_gen_id }}">
    <button class="ai-carousel-arrow-{{ ai_gen_id }} prev" aria-label="Previous articles">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <div class="ai-blog-cards-wrap-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign article_enabled_key = 'article_' | append: i | append: '_enabled'
          assign article_image_key = 'article_' | append: i | append: '_image'
          assign article_title_key = 'article_' | append: i | append: '_title'
          assign article_excerpt_key = 'article_' | append: i | append: '_excerpt'
          assign article_url_key = 'article_' | append: i | append: '_url'

          assign article_enabled = block.settings[article_enabled_key]
          assign article_image = block.settings[article_image_key]
          assign article_title = block.settings[article_title_key]
          assign article_excerpt = block.settings[article_excerpt_key]
          assign article_url = block.settings[article_url_key]
        %}

        {% if article_enabled %}
          <div class="ai-blog-card-item-{{ ai_gen_id }}">
            <div class="ai-blog-card-img-box-{{ ai_gen_id }}">
              {% if article_image %}
                <img
                  src="{{ article_image | image_url: width: 600 }}"
                  alt="{{ article_image.alt | escape }}"
                  loading="lazy"
                  width="600"
                  height="{{ block.settings.image_height }}"
                >
              {% else %}
                <div class="ai-blog-card-img-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            <div class="ai-blog-card-content-{{ ai_gen_id }}">
              <h3>{{ article_title }}</h3>
              <p class="excerpt">{{ article_excerpt }}</p>
              <a href="{{ article_url }}" class="ai-blog-read-btn-{{ ai_gen_id }}">
                {{ block.settings.button_text }}
              </a>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <button class="ai-carousel-arrow-{{ ai_gen_id }} next" aria-label="Next articles">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>
</blog-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class BlogCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentPage = 0;
        this.cardsPerPage = {{ block.settings.cards_per_row }};
        this.totalCards = 0;
        this.totalPages = 0;
      }

      connectedCallback() {
        this.cardsWrap = this.querySelector('.ai-blog-cards-wrap-{{ ai_gen_id }}');
        this.prevBtn = this.querySelector('.ai-carousel-arrow-{{ ai_gen_id }}.prev');
        this.nextBtn = this.querySelector('.ai-carousel-arrow-{{ ai_gen_id }}.next');
        this.cards = this.querySelectorAll('.ai-blog-card-item-{{ ai_gen_id }}');

        this.totalCards = this.cards.length;
        this.updateCardsPerPage();
        this.calculatePages();
        this.setupEventListeners();
        this.updateView();

        window.addEventListener('resize', () => {
          this.updateCardsPerPage();
          this.calculatePages();
          this.updateView();
        });
      }

      updateCardsPerPage() {
        const width = window.innerWidth;
        if (width <= 640) {
          this.cardsPerPage = 1;
        } else if (width <= 1024) {
          this.cardsPerPage = 2;
        } else {
          this.cardsPerPage = {{ block.settings.cards_per_row }};
        }
      }

      calculatePages() {
        this.totalPages = Math.ceil(this.totalCards / this.cardsPerPage);
        if (this.currentPage >= this.totalPages) {
          this.currentPage = Math.max(0, this.totalPages - 1);
        }
      }

      setupEventListeners() {
        this.prevBtn.addEventListener('click', () => this.goToPrevPage());
        this.nextBtn.addEventListener('click', () => this.goToNextPage());
      }

      goToPrevPage() {
        if (this.currentPage > 0) {
          this.currentPage--;
          this.updateView();
        }
      }

      goToNextPage() {
        if (this.currentPage < this.totalPages - 1) {
          this.currentPage++;
          this.updateView();
        }
      }

      updateView() {
        const startIndex = this.currentPage * this.cardsPerPage;
        const endIndex = startIndex + this.cardsPerPage;

        this.cards.forEach((card, index) => {
          if (index >= startIndex && index < endIndex) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });

        this.prevBtn.disabled = this.currentPage === 0;
        this.nextBtn.disabled = this.currentPage >= this.totalPages - 1;
      }
    }

    customElements.define('blog-carousel-{{ ai_gen_id }}', BlogCarousel{{ ai_gen_id }});
  })();
</script>

