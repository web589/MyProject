{% doc %}
  @prompt
    <style>
    /* 信任通栏全局样式 */
    .trust-banner-bar {
      width: 100%;
      padding: 24px 0;
      background: #ffffff; /* 白底和截图一致 */
      border-top: 1px solid #f0f0f0;
      border-bottom: 1px solid #f0f0f0;
    }
    .trust-container {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 20px;
    }
    .trust-list {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 16px 8px;
    }
    .trust-item {
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: Inter, sans-serif;
      font-size: 16px;
      color: #111827;
      white-space: nowrap;
    }
    .trust-icon {
      width: 22px;
      height: 22px;
      flex-shrink: 0;
    }
    
    /* 响应式适配 */
    @media (max-width: 992px) {
      .trust-list {
        justify-content: center;
      }
      .trust-item {
        flex: 0 0 calc(33.33% - 12px);
        justify-content: center;
      }
    }
    @media (max-width: 576px) {
      .trust-item {
        flex: 0 0 calc(50% - 12px);
        font-size: 14px;
      }
      .trust-icon {
        width: 20px;
        height: 20px;
      }
    }
    </style>
    
    <!-- HTML 主体区块 -->
    <div class="trust-banner-bar">
      <div class="trust-container">
        <div class="trust-list">
          <!-- 1. TÜV-zertifiziert -->
          <div class="trust-item">
            <svg class="trust-icon" viewBox="0 0 24 24" fill="#111827">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
            </svg>
            <span>TÜV-zertifiziert</span>
          </div>
    
          <!-- 2. CE-zertifiziert -->
          <div class="trust-item">
            <svg class="trust-icon" viewBox="0 0 24 24" fill="#111827">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
            </svg>
            <span>CE-zertifiziert</span>
          </div>
    
          <!-- 3. IP65 Schutz -->
          <div class="trust-item">
            <svg class="trust-icon" viewBox="0 0 24 24" fill="#111827">
              <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/>
            </svg>
            <span>IP65 Schutz</span>
          </div>
    
          <!-- 4. 10 Jahre Garantie -->
          <div class="trust-item">
            <svg class="trust-icon" viewBox="0 0 24 24" fill="#111827">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z"/>
            </svg>
            <span>10 Jahre Garantie</span>
          </div>
    
          <!-- 5. 100.000+ Haushalte -->
          <div class="trust-item">
            <svg class="trust-icon" viewBox="0 0 24 24" fill="#111827">
              <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
            </svg>
            <span>100.000+ Haushalte</span>
          </div>
    
          <!-- 6. LiFePO4 Zellen -->
          <div class="trust-item">
            <svg class="trust-icon" viewBox="0 0 24 24" fill="#111827">
              <path d="M17 4h-3V2h-4v2H7v18h10V4zm-2 16H9V6h6v14z"/>
            </svg>
            <span>LiFePO4 Zellen</span>
          </div>
        </div>
      </div>
    </div>
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-trust-banner-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    border-top: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-bottom: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
  }

  .ai-trust-banner-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-trust-banner-list-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    justify-content: {{ block.settings.alignment }};
    align-items: center;
    gap: {{ block.settings.gap_vertical }}px {{ block.settings.gap_horizontal }}px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ai-trust-banner-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.icon_text_gap }}px;
    font-family: {{ block.settings.font_family.family }}, {{ block.settings.font_family.fallback_families }};
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_family.weight }};
    color: {{ block.settings.text_color }};
    white-space: nowrap;
  }

  .ai-trust-banner-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
    fill: {{ block.settings.icon_color }};
  }

  @media (max-width: 992px) {
    .ai-trust-banner-list-{{ ai_gen_id }} {
      justify-content: center;
    }
    .ai-trust-banner-item-{{ ai_gen_id }} {
      flex: 0 0 calc(33.33% - {{ block.settings.gap_horizontal }}px);
      justify-content: center;
    }
  }

  @media (max-width: 576px) {
    .ai-trust-banner-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.75 }}px 0 {{ block.settings.padding_bottom | times: 0.75 }}px;
    }
    .ai-trust-banner-item-{{ ai_gen_id }} {
      flex: 0 0 calc(50% - {{ block.settings.gap_horizontal }}px);
      font-size: {{ block.settings.font_size | times: 0.875 }}px;
    }
    .ai-trust-banner-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.9 }}px;
      height: {{ block.settings.icon_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

