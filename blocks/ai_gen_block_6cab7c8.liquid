{% doc %}
  @prompt
    <!DOCTYPE html>
    <html lang="de">
    <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
    /* ========== 全局可调节变量（新增渐变透明度控制） ========== */
    :root {
      --bg-dark: #0A1628; /* 区块底色适配深色图 */
      --accent-blue: #00C6FF;
      --text-white: #ffffff; /* 主文字白色适配深色背景 */
      --text-muted-light: #D1D5DB; /* 浅灰辅助文字 */
      --radius-btn: 4px;
      --radius-pill: 20px;
      --font-heading: 'Manrope', sans-serif;
      --font-body: 'Inter', sans-serif;
    
      --content-max-width: 1200px;
      --side-padding: 80px; /* 文字靠左，减小边距贴近侧边 */
      --badge-max-width: 320px;
      --heading-max-width: 520px;
      --desc-max-width: 480px;
      --btns-wrap-max-width: 500px;
      --footer-note-max-width: 400px;
    
      /* 间距调节选项 */
      --badge-bottom-gap: 28px;
      --heading-bottom-gap: 24px;
      --desc-bottom-gap: 36px;
      --buttons-bottom-gap: 24px;
      --footer-note-top-gap: 24px;
      --heading-line-height: 1.15; /* 标题紧凑行距 */
      --button-gap: 12px;
    
      /* 渐变透明度调节变量（直接修改数值控制深浅，不删除渐变层） */
      --grad-left-opacity: 0.92;
      --grad-mid-opacity: 0.65;
      --grad-end-opacity: 0.05;
    
      --badge-dot-breathe-speed: 4s;
    }
    
    @keyframes badge-dot-breathe {
      0% { opacity: 0.25; }
      50% { opacity: 1; }
      100% { opacity: 0.25; }
    }
    
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    
    body {
      background-color: var(--bg-dark);
      font-family: var(--font-body);
    }
    
    .venus-e-static-hero {
      width: 100%;
      min-height: 88vh;
      background-color: var(--bg-dark);
      position: relative;
      display: flex;
      align-items: center;
      overflow: hidden;
    }
    
    /* 背景图改为cover铺满整个版面 */
    .hero-bg-image {
      position: absolute;
      top: 0;
      right: 0;
      width: 100%;
      height: 100%;
      background-image: url('粘贴深色产品大图链接');
      background-size: cover;
      background-position: right center;
      background-repeat: no-repeat;
    }
    
    /* 渐变层完整保留，透明度由变量控制，不会覆盖背景图 */
    .hero-gradient-overlay {
      position: absolute;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(
        90deg,
        rgba(10,22,40, var(--grad-left-opacity)) 0%,
        rgba(10,22,40, var(--grad-mid-opacity)) 55%,
        rgba(10,22,40, var(--grad-end-opacity)) 80%
      );
    }
    
    .hero-content-wrap {
      position: relative;
      z-index: 2;
      width: 100%;
      max-width: var(--content-max-width);
      margin: 0 auto;
      padding: 0 var(--side-padding);
      display: flex;
      justify-content: flex-start;
      align-items: center;
    }
    
    .hero-text-block {
      width: 100%;
      max-width: 520px;
      text-align: left;
      margin-left: 0;
      margin-right: auto;
    }
    
    /* 顶部标签 */
    .hero-pill-badge {
      display: inline-flex;
      align-items: center;
      justify-content: flex-start;
      gap: 8px;
      border: 1px solid var(--accent-blue);
      color: var(--accent-blue);
      font-family: var(--font-body);
      font-size: 14px;
      font-weight: 500;
      padding: 8px 18px;
      border-radius: var(--radius-pill);
      margin-bottom: var(--badge-bottom-gap);
      max-width: var(--badge-max-width);
      text-align: left;
    }
    
    .badge-dot {
      width: 8px;
      height: 8px;
      min-width: 8px;
      min-height: 8px;
      border-radius: 50%;
      background-color: var(--accent-blue);
      animation: badge-dot-breathe var(--badge-dot-breathe-speed) ease-in-out infinite;
      display: block;
      opacity: 1;
    }
    
    /* 大标题 白色适配深色图 */
    .hero-main-heading {
      font-family: var(--font-heading);
      font-size: clamp(36px, 6vw, 64px);
      font-weight: 700;
      line-height: var(--heading-line-height);
      color: var(--text-white);
      margin: 0 0 var(--heading-bottom-gap) 0;
      max-width: var(--heading-max-width);
      text-align: left;
      white-space: pre-line;
      word-break: keep-all;
      overflow-wrap: normal;
    }
    
    /* 描述文字 浅白色 */
    .hero-desc-paragraph {
      font-family: var(--font-body);
      font-size: 18px;
      line-height: 1.7;
      color: var(--text-muted-light);
      margin: 0 0 var(--desc-bottom-gap) 0;
      max-width: var(--desc-max-width);
      text-align: left;
    }
    
    .hero-button-group {
      display: flex;
      gap: var(--button-gap);
      flex-wrap: nowrap;
      margin-bottom: var(--buttons-bottom-gap);
      max-width: var(--btns-wrap-max-width);
      justify-content: flex-start;
      align-items: center;
    }
    
    /* 主按钮 统一品牌蓝 */
    .btn-primary {
      padding: 16px 32px;
      background-color: var(--accent-blue);
      color: #ffffff;
      border: none;
      border-radius: var(--radius-btn);
      font-family: var(--font-body);
      font-weight: 600;
      font-size: 16px;
      text-decoration: none;
      transition: all 0.25s ease;
      display: inline-block;
      white-space: nowrap;
    }
    .btn-primary:hover {
      filter: brightness(0.9);
      transform: translateY(-2px);
      box-shadow: 0 4px 14px rgba(0,198,255,0.2);
    }
    
    /* 轮廓按钮 文字白色、蓝色边框适配深色 */
    .btn-outline {
      padding: 16px 32px;
      background: transparent;
      color: var(--text-white);
      border: 2px solid var(--accent-blue);
      border-radius: var(--radius-btn);
      font-family: var(--font-body);
      font-weight: 600;
      font-size: 16px;
      text-decoration: none;
      transi, 除了背景图外的元素往左移靠近左侧, 除背景图外的其他元素有点太靠左了，稍微往中间靠一点点, Heading文字要有换行效果, Heading在哪儿换行要按照我在文本框里输入的换行来, 除背景图外所有元素再往中间稍微靠近点
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-{{ ai_gen_id }} {
    width: 100%;
    min-height: {{ block.settings.min_height }}vh;
    background-color: {{ block.settings.bg_color }};
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .ai-hero-bg-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: {{ block.settings.image_position }};
    background-repeat: no-repeat;
  }

  .ai-hero-bg-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ block.settings.image_position }};
  }

  .ai-hero-gradient-{{ ai_gen_id }} {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      rgba({{ block.settings.overlay_color | color_extract: 'red' }}, {{ block.settings.overlay_color | color_extract: 'green' }}, {{ block.settings.overlay_color | color_extract: 'blue' }}, {{ block.settings.gradient_left_opacity | divided_by: 100.0 }}) 0%,
      rgba({{ block.settings.overlay_color | color_extract: 'red' }}, {{ block.settings.overlay_color | color_extract: 'green' }}, {{ block.settings.overlay_color | color_extract: 'blue' }}, {{ block.settings.gradient_mid_opacity | divided_by: 100.0 }}) 55%,
      rgba({{ block.settings.overlay_color | color_extract: 'red' }}, {{ block.settings.overlay_color | color_extract: 'green' }}, {{ block.settings.overlay_color | color_extract: 'blue' }}, {{ block.settings.gradient_end_opacity | divided_by: 100.0 }}) 80%
    );
  }

  .ai-hero-content-wrap-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    width: 100%;
    padding: 0 {{ block.settings.side_padding }}px;
    display: flex;
    justify-content: flex-start;
    align-items: center;
  }

  .ai-hero-text-block-{{ ai_gen_id }} {
    width: 100%;
    max-width: {{ block.settings.text_block_max_width }}px;
    text-align: left;
  }

  .ai-hero-badge-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    gap: 8px;
    border: 1px solid {{ block.settings.badge_color }};
    color: {{ block.settings.badge_color }};
    font-size: {{ block.settings.badge_font_size }}px;
    font-weight: 500;
    padding: 8px 18px;
    border-radius: {{ block.settings.badge_radius }}px;
    margin-bottom: {{ block.settings.badge_bottom_gap }}px;
    max-width: {{ block.settings.badge_max_width }}px;
    text-align: left;
  }

  .ai-hero-badge-dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    min-width: 8px;
    min-height: 8px;
    border-radius: 50%;
    background-color: {{ block.settings.badge_color }};
    animation: ai-hero-badge-breathe-{{ ai_gen_id }} {{ block.settings.badge_breathe_speed }}s ease-in-out infinite;
    display: block;
    opacity: 1;
  }

  @keyframes ai-hero-badge-breathe-{{ ai_gen_id }} {
    0% { opacity: 0.25; }
    50% { opacity: 1; }
    100% { opacity: 0.25; }
  }

  .ai-hero-heading-{{ ai_gen_id }} {
    font-size: clamp({{ block.settings.heading_min_size }}px, 6vw, {{ block.settings.heading_max_size }}px);
    font-weight: 700;
    line-height: {{ block.settings.heading_line_height }};
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_bottom_gap }}px 0;
    max-width: {{ block.settings.heading_max_width }}px;
    text-align: left;
    white-space: pre-line;
  }

  .ai-hero-desc-{{ ai_gen_id }} {
    font-size: {{ block.settings.desc_font_size }}px;
    line-height: {{ block.settings.desc_line_height }};
    color: {{ block.settings.desc_color }};
    margin: 0 0 {{ block.settings.desc_bottom_gap }}px 0;
    max-width: {{ block.settings.desc_max_width }}px;
    text-align: left;
  }

  .ai-hero-buttons-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.button_gap }}px;
    flex-wrap: wrap;
    margin-bottom: {{ block.settings.buttons_bottom_gap }}px;
    max-width: {{ block.settings.buttons_max_width }}px;
    justify-content: flex-start;
    align-items: center;
  }

  .ai-hero-btn-primary-{{ ai_gen_id }} {
    padding: {{ block.settings.button_padding_v }}px {{ block.settings.button_padding_h }}px;
    background: linear-gradient(90deg, #0099FC 0%, #00D8C6 100%);
    color: {{ block.settings.primary_btn_color }};
    border: none;
    border-radius: {{ block.settings.button_radius }}px;
    font-weight: 600;
    font-size: {{ block.settings.button_font_size }}px;
    text-decoration: none;
    transition: all 0.25s ease;
    display: inline-block;
    white-space: nowrap;
  }

  .ai-hero-btn-primary-{{ ai_gen_id }}:hover {
    filter: brightness(0.96);
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba({{ block.settings.primary_btn_bg | color_extract: 'red' }}, {{ block.settings.primary_btn_bg | color_extract: 'green' }}, {{ block.settings.primary_btn_bg | color_extract: 'blue' }}, 0.2);
  }

  .ai-hero-btn-outline-{{ ai_gen_id }} {
    padding: {{ block.settings.button_padding_v }}px {{ block.settings.button_padding_h }}px;
    background: #ffffff;
    color: {{ block.settings.outline_btn_color }};
    border: 2px solid {{ block.settings.outline_btn_border }};
    border-radius: {{ block.settings.button_radius }}px;
    font-weight: 600;
    font-size: {{ block.settings.button_font_size }}px;
    text-decoration: none;
    transition: all 0.25s ease;
    display: inline-block;
    white-space: nowrap;
  }

  .ai-hero-btn-outline-{{ ai_gen_id }}:hover {
    background: {{ block.settings.outline_btn_border }};
    color: {{ block.settings.outline_btn_hover_color }};
    transform: translateY(-2px);
  }

  .ai-hero-footer-note-{{ ai_gen_id }} {
    font-size: {{ block.settings.footer_font_size }}px;
    line-height: 1.6;
    color: {{ block.settings.footer_color }};
    margin-top: {{ block.settings.footer_top_gap }}px;
    max-width: {{ block.settings.footer_max_width }}px;
    text-align: left;
  }

  @media screen and (max-width: 749px) {
    .ai-hero-{{ ai_gen_id }} {
      min-height: {{ block.settings.min_height_mobile }}vh;
    }

    .ai-hero-content-wrap-{{ ai_gen_id }} {
      padding: 0 {{ block.settings.side_padding_mobile }}px;
    }

    .ai-hero-heading-{{ ai_gen_id }} {
      font-size: clamp({{ block.settings.heading_min_size_mobile }}px, 10vw, {{ block.settings.heading_max_size_mobile }}px);
    }

    .ai-hero-buttons-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: flex-start;
    }

    .ai-hero-btn-primary-{{ ai_gen_id }},
    .ai-hero-btn-outline-{{ ai_gen_id }} {
      width: 100%;
      text-align: center;
    }
  }
{% endstyle %}

<div class="ai-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-bg-{{ ai_gen_id }}" data-scroll-reveal-module-media>
    {% if block.settings.bg_image %}
      <img
        src="{{ block.settings.bg_image | image_url: width: 2000 }}"
        alt="{{ block.settings.bg_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.bg_image.width }}"
        height="{{ block.settings.bg_image.height }}"
      >
    {% endif %}
  </div>

  <div class="ai-hero-gradient-{{ ai_gen_id }}"></div>

  <div class="ai-hero-content-wrap-{{ ai_gen_id }}">
    <div class="ai-hero-text-block-{{ ai_gen_id }}">
      {% if block.settings.show_badge and block.settings.badge_text != blank %}
        <div class="ai-hero-badge-{{ ai_gen_id }}">
          {% if block.settings.show_badge_dot %}
            <span class="ai-hero-badge-dot-{{ ai_gen_id }}"></span>
          {% endif %}
          {{ block.settings.badge_text }}
        </div>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h1 class="ai-hero-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h1>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-hero-desc-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}

      {% if block.settings.show_buttons %}
        <div class="ai-hero-buttons-{{ ai_gen_id }}">
          {% if block.settings.primary_btn_label != blank %}
            <a
              href="{{ block.settings.primary_btn_link }}"
              class="ai-hero-btn-primary-{{ ai_gen_id }}"
            >
              {{ block.settings.primary_btn_label }}
            </a>
          {% endif %}

          {% if block.settings.outline_btn_label != blank %}
            <a
              href="{{ block.settings.outline_btn_link }}"
              class="ai-hero-btn-outline-{{ ai_gen_id }}"
            >
              {{ block.settings.outline_btn_label }}
            </a>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.footer_note != blank %}
        <div class="ai-hero-footer-note-{{ ai_gen_id }}">{{ block.settings.footer_note }}</div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Premium hero",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left center", "label": "Left" },
        { "value": "center center", "label": "Center" },
        { "value": "right center", "label": "Right" }
      ],
      "default": "right center"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#0A1628"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Gradient overlay color",
      "default": "#0A1628"
    },
    {
      "type": "range",
      "id": "gradient_left_opacity",
      "label": "Gradient left opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 90
    },
    {
      "type": "range",
      "id": "gradient_mid_opacity",
      "label": "Gradient middle opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 65
    },
    {
      "type": "range",
      "id": "gradient_end_opacity",
      "label": "Gradient end opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 5
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height (desktop)",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 90
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "label": "Minimum height (mobile)",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 70
    },
    {
      "type": "range",
      "id": "text_block_max_width",
      "label": "Text block max width",
      "min": 400,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 520
    },
    {
      "type": "range",
      "id": "side_padding",
      "label": "Side padding (desktop)",
      "min": 20,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "side_padding_mobile",
      "label": "Side padding (mobile)",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Badge"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show badge",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Neu eingetroffen"
    },
    {
      "type": "checkbox",
      "id": "show_badge_dot",
      "label": "Show animated dot",
      "default": true
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge color",
      "default": "#00C6FF"
    },
    {
      "type": "range",
      "id": "badge_font_size",
      "label": "Font size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "badge_radius",
      "label": "Border radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "badge_max_width",
      "label": "Max width",
      "min": 200,
      "max": 500,
      "step": 20,
      "unit": "px",
      "default": 320
    },
    {
      "type": "range",
      "id": "badge_bottom_gap",
