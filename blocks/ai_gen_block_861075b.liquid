{% doc %}
  @prompt
    <style>
    /* ========== 全局可调节变量 ========== */
    :root {
      --bg-dark: #0A1628;
      --accent-green: #00E676;
      --text-primary: #FFFFFF;
      --text-muted: #94A3B8;
      --radius-btn: 4px;
      --radius-pill: 20px;
      --font-heading: 'Manrope', sans-serif;
      --font-body: 'Inter', sans-serif;
    
      --content-max-width: 1200px;
      --side-padding: 0; /* 侧边距最小0，整体贴近左侧 */
      --badge-max-width: 320px;
      --heading-max-width: 8000; /* Heading最大宽度改为8000 */
      --desc-max-width: 480px;
      --btns-wrap-max-width: 500px;
      --footer-note-max-width: 400px;
    
      --award-section-top-gap: 60px;
      --award-card-radius: 8px;
      --award-card-height: 100px;
      --award-card-gap: 16px;
      --award-wrap-max-width: 650px;
      --award-bg-color: #142238;
    
      --badge-dot-breathe-speed: 4s;
      /* 渐变透明度可控变量 */
      --gradient-start-opacity: 0.98;
      --gradient-mid-opacity: 0.75;
      --gradient-end-opacity: 0.1;
    }
    @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@700&family=Inter:wght@400;500;600&display=swap');
    
    @keyframes badge-dot-breathe {
      0% {
        opacity: 0.25;
      }
      50% {
        opacity: 1;
      }
      100% {
        opacity: 0.25;
      }
    }
    
    .btn-primary {
      padding: 16px 32px;
      background-color: var(--accent-green);
      color: var(--bg-dark);
      border: none;
      border-radius: var(--radius-btn);
      font-family: var(--font-body);
      font-weight: 600;
      font-size: 16px;
      text-decoration: none;
      transition: all 0.25s ease;
      display: inline-block;
    }
    .btn-primary:hover {
      filter: brightness(0.9);
      transform: translateY(-2px);
    }
    
    .btn-outline {
      padding: 16px 32px;
      background: transparent;
      color: var(--text-primary);
      border: 2px solid var(--text-primary);
      border-radius: var(--radius-btn);
      font-family: var(--font-body);
      font-weight: 600;
      font-size: 16px;
      text-decoration: none;
      transition: all 0.25s ease;
      display: inline-block;
    }
    .btn-outline:hover {
      background-color: rgba(255, 255, 255, 0.1);
      transform: translateY(-2px);
    }
    
    .venus-e-static-hero {
      width: 100%;
      min-height: 88vh;
      background-color: var(--bg-dark);
      position: relative;
      display: flex;
      align-items: center;
      overflow: hidden;
    }
    
    .hero-bg-image {
      position: absolute;
      top: 0;
      right: 0;
      width: 100%;
      height: 100%;
      background-size: cover; /* 背景图铺满整个区块 */
      background-position: right center;
      background-repeat: no-repeat;
      background-image: url('粘贴产品大图链接');
    }
    
    .hero-gradient-overlay {
      position: absolute;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg,
        rgba(10,22,40,var(--gradient-start-opacity)) 0%,
        rgba(10,22,40,var(--gradient-mid-opacity)) 55%,
        rgba(10,22,40,var(--gradient-end-opacity)) 80%);
    }
    
    .hero-content-wrap {
      position: relative;
      z-index: 2;
      width: 100%;
      max-width: var(--content-max-width);
      margin: 0 auto;
      padding: 0 var(--side-padding);
      /* 关键：内容整体靠左，而不是居中 */
      display: flex;
      justify-content: flex-start;
      align-items: center;
    }
    
    .hero-text-block {
      width: 100%;
      max-width: 520px;
      text-align: left;
      /* 防止某些编辑器把内容块自动拉到中间 */
      margin-left: 0 !important;
      margin-right: auto !important;
    }
    
    /* 顶部标签：左对齐 + 小圆点独立渲染 */
    .hero-pill-badge {
      display: inline-flex;
      align-items: center;
      justify-content: flex-start;
      gap: 8px;
      border: 1px solid var(--accent-green);
      color: var(--accent-green);
      font-family: var(--font-body);
      font-size: 14px;
      font-weight: 500;
      padding: 8px 18px;
      border-radius: var(--radius-pill);
      margin-bottom: 28px;
      max-width: var(--badge-max-width);
      text-align: left;
    }
    
    .badge-dot {
      width: 8px;
      height: 8px;
      min-width: 8px;
      min-height: 8px;
      border-radius: 50%;
      background-color: var(--accent-green);
      animation: badge-dot-breathe var(--badge-dot-breathe-speed) ease-in-out infinite;
      /* 强制显示，避免编辑器隐藏伪元素 */
      display: block !important;
      opacity: 1 !important;
    }
    
    .hero-main-heading {
      font-family: var(--font-heading);
      font-size: clamp(36px, 6vw, 64px);
      font-weight: 700;
      line-height: 1.3;
      color: var(--text-primary);
      margin: 0 0 24px 0;
      max-width: var(--heading-max-width);
      text-align: left;
      white-space: pre-line !important;
      word-break: keep-all !important;
      overflow-wrap: normal !important;
    }
    
    .hero-desc-paragraph {
      font-family: var(--font-body);
      font-size: 18px;
      line-height: 1.7;
      color: var(--text-muted);
      margin: 0 0 36px 0;
      max-width: var(--desc-max-width);
      text-align: left;
    }
    
    .hero-button-group {
      display: flex;
      gap: 20px;
      flex-wrap: wrap;
      margin-bottom: 24px;
      max-width: var(--btns-wrap-max-width);
      justify-content: flex-start;
    }
    
    .hero-footer-note {
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: var(--font-body);
      font-size: 14px;
      color: var(--text-muted);
      max-width: var(--footer-note-max-width);
      justify-content: flex-start;
    }
    .hero-footer-note .check-icon {
      width: 16px;
      height: 16px;
      fill: var(--accent-green);
    }
    
    .awards-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
