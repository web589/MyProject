{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    min-height: {{ block.settings.min_height }}vh;
    background-color: {{ block.settings.bg_color }};
    position: relative;
    overflow: hidden;
  }

  .ai-hero-inner-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: {{ block.settings.min_height }}vh;
    display: flex;
    align-items: center;
  }

  .ai-hero-bg-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: {{ block.settings.image_position }};
    background-repeat: no-repeat;
    z-index: 1;
  }

  .ai-hero-bg-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ block.settings.image_position }};
  }

  .ai-hero-gradient-{{ ai_gen_id }} {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      {{ block.settings.bg_color | color_modify: 'alpha', block.settings.gradient_start_opacity }} 0%,
      {{ block.settings.bg_color | color_modify: 'alpha', block.settings.gradient_mid_opacity }} 55%,
      {{ block.settings.bg_color | color_modify: 'alpha', block.settings.gradient_end_opacity }} 80%
    );
    z-index: 2;
  }

  .ai-hero-content-wrap-{{ ai_gen_id }} {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0;
    margin-left: {{ block.settings.content_left_offset }}px;
    padding: 60px {{ block.settings.side_padding }}px;
    display: flex;
    justify-content: flex-start;
    align-items: center;
  }

  .ai-hero-text-block-{{ ai_gen_id }} {
    width: 100%;
    max-width: {{ block.settings.text_block_max_width }}px;
    text-align: left;
  }

  .ai-hero-badge-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    gap: 8px;
    border: 1px solid {{ block.settings.accent_color }};
    color: {{ block.settings.accent_color }};
    font-size: {{ block.settings.badge_font_size }}px;
    font-weight: 500;
    padding: 8px 18px;
    border-radius: {{ block.settings.badge_border_radius }}px;
    margin-bottom: 28px;
    max-width: {{ block.settings.badge_max_width }}px;
  }

  .ai-hero-badge-dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    min-width: 8px;
    min-height: 8px;
    border-radius: 50%;
    background-color: {{ block.settings.accent_color }};
    animation: ai-hero-badge-breathe-{{ ai_gen_id }} {{ block.settings.badge_animation_speed }}s ease-in-out infinite;
  }

  @keyframes ai-hero-badge-breathe-{{ ai_gen_id }} {
    0%, 100% {
      opacity: 0.25;
    }
    50% {
      opacity: 1;
    }
  }

  .ai-hero-heading-{{ ai_gen_id }} {
    font-size: clamp({{ block.settings.heading_min_size }}px, 6vw, {{ block.settings.heading_max_size }}px);
    font-weight: 700;
    line-height: {{ block.settings.heading_line_height }};
    color: {{ block.settings.heading_color }};
    margin: 0 0 24px 0;
    max-width: {{ block.settings.heading_max_width }}px;
    white-space: pre-line;
    word-break: keep-all;
  }

  .ai-hero-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_font_size }}px;
    line-height: {{ block.settings.description_line_height }};
    color: {{ block.settings.description_color }};
    margin: 0 0 36px 0;
    max-width: {{ block.settings.description_max_width }}px;
  }

  .ai-hero-buttons-{{ ai_gen_id }} {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 24px;
    max-width: {{ block.settings.buttons_max_width }}px;
  }

  .ai-hero-btn-primary-{{ ai_gen_id }} {
    padding: 16px 32px;
    background-color: {{ block.settings.primary_btn_bg }};
    color: {{ block.settings.primary_btn_color }};
    border: none;
    border-radius: {{ block.settings.btn_border_radius }}px;
    font-weight: 600;
    font-size: 16px;
    text-decoration: none;
    transition: all 0.25s ease;
    display: inline-block;
  }

  .ai-hero-btn-primary-{{ ai_gen_id }}:hover {
    filter: brightness(0.9);
    transform: translateY(-2px);
  }

  .ai-hero-btn-outline-{{ ai_gen_id }} {
    padding: 16px 32px;
    background: transparent;
    color: {{ block.settings.outline_btn_color }};
    border: 2px solid {{ block.settings.outline_btn_border }};
    border-radius: {{ block.settings.btn_border_radius }}px;
    font-weight: 600;
    font-size: 16px;
    text-decoration: none;
    transition: all 0.25s ease;
    display: inline-block;
  }

  .ai-hero-btn-outline-{{ ai_gen_id }}:hover {
    background-color: rgba(255, 255, 255, 0.1);
    transform: translateY(-2px);
  }

  .ai-hero-footer-note-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: {{ block.settings.footer_note_font_size }}px;
    color: {{ block.settings.description_color }};
    max-width: {{ block.settings.footer_note_max_width }}px;
  }

  .ai-hero-check-icon-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
    fill: {{ block.settings.accent_color }};
    flex-shrink: 0;
  }

  .ai-hero-awards-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.awards_columns }}, 1fr);
    gap: {{ block.settings.awards_gap }}px;
    margin-top: {{ block.settings.awards_top_gap }}px;
    max-width: {{ block.settings.awards_max_width }}px;
  }

  .ai-hero-award-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.award_bg_color }};
    border-radius: {{ block.settings.award_border_radius }}px;
    height: {{ block.settings.award_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }

  .ai-hero-award-card-{{ ai_gen_id }} img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  @media screen and (max-width: 989px) {
    .ai-hero-content-wrap-{{ ai_gen_id }} {
      padding: 40px 20px;
      margin-left: 0;
    }

    .ai-hero-awards-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-hero-inner-{{ ai_gen_id }} {
      min-height: {{ block.settings.mobile_min_height }}vh;
    }

    .ai-hero-buttons-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: flex-start;
    }

    .ai-hero-btn-primary-{{ ai_gen_id }},
    .ai-hero-btn-outline-{{ ai_gen_id }} {
      width: 100%;
      text-align: center;
    }
  }
{% endstyle %}

<ai-hero-{{ ai_gen_id }} class="ai-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-inner-{{ ai_gen_id }}">
    {% if block.settings.background_image %}
      <div class="ai-hero-bg-image-{{ ai_gen_id }}">
        <img
          src="{{ block.settings.background_image | image_url: width: 2000 }}"
          alt="{{ block.settings.background_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.background_image.width }}"
          height="{{ block.settings.background_image.height }}"
        >
      </div>
    {% endif %}

    <div class="ai-hero-gradient-{{ ai_gen_id }}"></div>

    <div class="ai-hero-content-wrap-{{ ai_gen_id }}">
      <div class="ai-hero-text-block-{{ ai_gen_id }}">
        {% if block.settings.show_badge and block.settings.badge_text != blank %}
          <div class="ai-hero-badge-{{ ai_gen_id }}">
            <span class="ai-hero-badge-dot-{{ ai_gen_id }}"></span>
            {{ block.settings.badge_text }}
          </div>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h1 class="ai-hero-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h1>
        {% endif %}

        {% if block.settings.description != blank %}
          <div class="ai-hero-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
        {% endif %}

        {% if block.settings.show_buttons %}
          <div class="ai-hero-buttons-{{ ai_gen_id }}">
            {% if block.settings.primary_btn_text != blank %}
              <a
                href="{{ block.settings.primary_btn_link }}"
                class="ai-hero-btn-primary-{{ ai_gen_id }}"
              >
                {{ block.settings.primary_btn_text }}
              </a>
            {% endif %}

            {% if block.settings.outline_btn_text != blank %}
              <a
                href="{{ block.settings.outline_btn_link }}"
                class="ai-hero-btn-outline-{{ ai_gen_id }}"
              >
                {{ block.settings.outline_btn_text }}
              </a>
            {% endif %}
          </div>
        {% endif %}

        {% if block.settings.show_footer_note and block.settings.footer_note_text != blank %}
          <div class="ai-hero-footer-note-{{ ai_gen_id }}">
            <svg class="ai-hero-check-icon-{{ ai_gen_id }}" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
              <path d="M13.5 3.5L6 11L2.5 7.5" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            {{ block.settings.footer_note_text }}
          </div>
        {% endif %}

        {% if block.settings.show_awards %}
          <div class="ai-hero-awards-{{ ai_gen_id }}">
            {% for i in (1..4) %}
              {% assign award_key = 'award_' | append: i %}
              {% assign award_image = block.settings[award_key] %}
              {% if award_image %}
                <div class="ai-hero-award-card-{{ ai_gen_id }}">
                  <img
                    src="{{ award_image | image_url: width: 200 }}"
                    alt="{{ award_image.alt | escape }}"
                    loading="lazy"
                    width="200"
                    height="100"
                  >
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</ai-hero-{{ ai_gen_id }}>

<script>
  (function() {
    class AiHero{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.adjustGradient();
        window.addEventListener('resize', this.adjustGradient.bind(this));
      }

      adjustGradient() {
        const gradient = this.querySelector('.ai-hero-gradient-{{ ai_gen_id }}');
        if (gradient && window.innerWidth < 750) {
          gradient.style.background = 'linear-gradient(180deg, rgba(10,22,40,0.6) 0%, rgba(10,22,40,0.9) 100%)';
        }
      }

      disconnectedCallback() {
        window.removeEventListener('resize', this.adjustGradient.bind(this));
      }
    }

    customElements.define('ai-hero-{{ ai_gen_id }}', AiHero{{ ai_gen_id }});
  })();
</script>

