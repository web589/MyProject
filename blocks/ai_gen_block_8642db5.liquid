{% doc %}
  @prompt
    {% stylesheet %}
    .blog-latest-section {
      width: 100%;
      padding: 80px 20px;
      background-color: #f8f8f8;
      box-sizing: border-box;
    }
    .blog-container {
      max-width: 1440px;
      margin: 0 auto;
    }
    /* 标题行：左标题 右链接 */
    .blog-header-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 45px;
    }
    .blog-main-title {
      font-size: clamp(2.2rem, 5vw, 3.8rem);
      font-weight: 700;
      margin: 0;
      color: #000;
    }
    .all-blogs-link {
      font-size: 1.1rem;
      color: #222;
      text-decoration: none;
    }
    .all-blogs-link:hover {
      text-decoration: underline;
    }
    /* 三栏网格 */
    .blog-grid-wrap {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
    }
    /* 单张博客卡片容器 */
    .blog-card {
      background: #fff;
      border-radius: 16px;
      overflow: hidden;
      transition: transform 0.3s ease;
    }
    /* 鼠标悬浮卡片整体轻微放大 */
    .blog-card:hover {
      transform: scale(1.03);
    }
    /* 博客图片 */
    .blog-card-img {
      width: 100%;
      display: block;
    }
    /* 卡片文字区域 */
    .blog-card-text {
      padding: 26px 22px 32px;
      text-align: center;
    }
    .blog-card-title {
      font-size: 1.15rem;
      line-height: 1.5;
      color: #111;
      margin: 0 0 24px;
      font-weight: 500;
    }
    /* Learn more 淡蓝色圆角按钮 */
    .blog-learn-link {
      display: inline-block;
      padding: 10px 36px;
      background-color: #33a0ff;
      color: #ffffff;
      text-decoration: none;
      border-radius: 999px;
      font-size: 1.05rem;
      transition: background 0.25s ease;
    }
    .blog-learn-link:hover {
      background-color: #0084ff;
    }
    /* 响应式适配 */
    @media screen and (max-width: 990px) {
      .blog-grid-wrap {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media screen and (max-width: 640px) {
      .blog-grid-wrap {
        grid-template-columns: 1fr;
      }
      .blog-header-row {
        flex-direction: column;
        gap:12px;
      }
    }
    {% endstylesheet %}
    
    <section class="blog-latest-section">
      <div class="blog-container">
        <div class="blog-header-row">
          <h2 class="blog-main-title">Our Latest Blog Posts</h2>
          <a href="/blogs/news" class="all-blogs-link">All blogs &gt;</a>
        </div>
    
        <div class="blog-grid-wrap">
          <!-- 博客卡片1 -->
          <div class="blog-card">
            <img class="blog-card-img" src="https://cdn.shopify.com/s/files/xxx/blog1.jpg" alt="Solar Battery Charge Cycle">
            <div class="blog-card-text">
              <h3 class="blog-card-title">What is a Battery Charge Cycle and How to Maximize Your Solar Storage Lifespan?</h3>
              <a href="/blogs/news/article-1" class="blog-learn-link">Learn more</a>
            </div>
          </div>
    
          <!-- 博客卡片2 -->
          <div class="blog-card">
            <img class="blog-card-img" src="https://cdn.shopify.com/s/files/xxx/blog2.jpg" alt="Solar Battery Efficiency">
            <div class="blog-card-text">
              <h3 class="blog-card-title">Everything You Need to Know About Solar Battery Efficiency: Optimize Your Energy Autonomy</h3>
              <a href="/blogs/news/article-2" class="blog-learn-link">Learn more</a>
            </div>
          </div>
    
          <!-- 博客卡片3 -->
          <div class="blog-card">
            <img class="blog-card-img" src="https://cdn.shopify.com/s/files/xxx/blog3.jpg" alt="Zendure SolarFlow 1600 AC+">
            <div class="blog-card-text">
              <h3 class="blog-card-title">Zendure SolarFlow 1600 AC+: The Ultimate Product Guide</h3>
              <a href="/blogs/news/article-3" class="blog-learn-link">Learn more</a>
            </div>
          </div>
        </div>
      </div>
    </section>
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-blog-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    box-sizing: border-box;
  }

  .ai-blog-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
  }

  .ai-blog-header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-blog-title-{{ ai_gen_id }} {
    font-size: clamp(2.2rem, 5vw, {{ block.settings.title_size }}px);
    font-weight: {{ block.settings.title_weight }};
    margin: 0;
    color: {{ block.settings.title_color }};
  }

  .ai-blog-all-link-{{ ai_gen_id }} {
    font-size: {{ block.settings.link_size }}px;
    color: {{ block.settings.link_color }};
    text-decoration: none;
  }

  .ai-blog-all-link-{{ ai_gen_id }}:hover {
    text-decoration: underline;
  }

  .ai-blog-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-blog-card-{{ ai_gen_id }} {
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease;
  }

  .ai-blog-card-{{ ai_gen_id }}:hover {
    transform: scale(1.05);
  }

  .ai-blog-card-img-{{ ai_gen_id }} {
    width: 100%;
    display: block;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    object-fit: cover;
  }

  .ai-blog-card-img-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-blog-card-img-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-blog-card-text-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-blog-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    line-height: 1.5;
    color: {{ block.settings.card_title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px;
    font-weight: {{ block.settings.card_title_weight }};
  }

  .ai-blog-learn-link-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    transition: background 0.25s ease;
  }

  .ai-blog-learn-link-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  @media screen and (max-width: 990px) {
    .ai-blog-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 640px) {
    .ai-blog-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-blog-header-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 12px;
    }
  }
{% endstyle %}

<ai-blog-section-{{ ai_gen_id }} class="ai-blog-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-blog-container-{{ ai_gen_id }}">
    <div class="ai-blog-header-{{ ai_gen_id }}">
      {% if block.settings.section_title != blank %}
        <h2 class="ai-blog-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
      {% endif %}
      {% if block.settings.blog_link != blank %}
        <a href="{{ block.settings.blog_link }}" class="ai-blog-all-link-{{ ai_gen_id }}">
          {{ block.settings.link_text }} &gt;
        </a>
      {% endif %}
    </div>

    <div class="ai-blog-grid-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign article_key = 'article_' | append: i
          assign article = block.settings[article_key]
        %}

        <div class="ai-blog-card-{{ ai_gen_id }}">
          {% if article != blank %}
            {% if article.image %}
              <a href="{{ article.url }}">
                <img
                  class="ai-blog-card-img-{{ ai_gen_id }}"
                  src="{{ article.image | image_url: width: 800 }}"
                  alt="{{ article.image.alt | escape }}"
                  loading="lazy"
                  width="800"
                  height="{{ 800 | divided_by: block.settings.image_aspect_ratio | round }}"
                >
              </a>
            {% else %}
              <div class="ai-blog-card-img-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}

            <div class="ai-blog-card-text-{{ ai_gen_id }}">
              <h3 class="ai-blog-card-title-{{ ai_gen_id }}">
                {{ article.title }}
              </h3>
              <a href="{{ article.url }}" class="ai-blog-learn-link-{{ ai_gen_id }}">
                {{ block.settings.button_text }}
              </a>
            </div>
          {% else %}
            <div class="ai-blog-card-img-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
            <div class="ai-blog-card-text-{{ ai_gen_id }}">
              <h3 class="ai-blog-card-title-{{ ai_gen_id }}">
                Select an article for blog post {{ i }}
              </h3>
              <a href="#" class="ai-blog-learn-link-{{ ai_gen_id }}">
                {{ block.settings.button_text }}
              </a>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</ai-blog-section-{{ ai_gen_id }}>

<script>
  (function() {
    class AiBlogSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('ai-blog-section-{{ ai_gen_id }}', AiBlogSection{{ ai_gen_id }});
  })();
</script>

