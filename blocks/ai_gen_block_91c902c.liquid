{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-grid-section-{{ ai_gen_id }} {
    width: 100%;
    background: {{ block.settings.section_bg_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-product-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
    padding: 0 {{ block.settings.side_padding }}px;
  }

  .ai-product-grid-wrap-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-product-card-{{ ai_gen_id }} {
    position: relative;
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .ai-product-bg-img-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .ai-product-card-{{ ai_gen_id }}:hover .ai-product-bg-img-{{ ai_gen_id }} {
    transform: scale(1.03);
  }

  .ai-product-content-wrap-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60%;
    padding: 20px 0;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-height: 40%;
  }

  .ai-product-top-slogan-{{ ai_gen_id }} {
    font-size: {{ block.settings.slogan_font_size }}px;
    color: {{ block.settings.slogan_color }};
    font-weight: 600;
    margin: 0 0 8px;
    letter-spacing: 0.5px;
  }

  .ai-product-model-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: 800;
    color: {{ block.settings.title_color }};
    line-height: 1.2;
    margin: 0 0 6px;
  }

  .ai-product-new-tag-{{ ai_gen_id }} {
    display: inline-block;
    background: {{ block.settings.tag_bg_color }};
    color: {{ block.settings.tag_text_color }};
    font-size: {{ block.settings.tag_font_size }}px;
    font-weight: 700;
    padding: 2px 5px;
    border-radius: 3px;
    margin-left: 5px;
    vertical-align: top;
  }

  .ai-product-desc-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.desc_font_size }}px;
    color: {{ block.settings.desc_color }};
    opacity: 0.92;
    margin: 0 0 16px;
    line-height: 1.5;
  }

  .ai-product-btn-group-{{ ai_gen_id }} {
    display: flex;
    gap: 10px;
    justify-content: center;
  }

  .ai-btn-primary-shop-{{ ai_gen_id }} {
    padding: 7px 16px;
    background: {{ block.settings.primary_btn_bg }};
    color: {{ block.settings.primary_btn_text }};
    border: none;
    border-radius: {{ block.settings.btn_border_radius }}px;
    font-size: {{ block.settings.btn_font_size }}px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    display: inline-block;
  }

  .ai-btn-primary-shop-{{ ai_gen_id }}:hover {
    background: {{ block.settings.primary_btn_hover_bg }};
    transform: translateY(-3px);
    box-shadow: 0 0 8px {{ block.settings.primary_btn_bg }}40,
                0 0 16px {{ block.settings.primary_btn_bg }}59,
                0 0 28px {{ block.settings.primary_btn_bg }}2E;
  }

  .ai-btn-secondary-info-{{ ai_gen_id }} {
    padding: 7px 16px;
    background: transparent;
    color: {{ block.settings.secondary_btn_text }};
    border: 1px solid {{ block.settings.secondary_btn_border }};
    border-radius: {{ block.settings.btn_border_radius }}px;
    font-size: {{ block.settings.btn_font_size }}px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.3s ease;
    display: inline-block;
  }

  .ai-btn-secondary-info-{{ ai_gen_id }}:hover {
    border-color: {{ block.settings.primary_btn_bg }};
    color: {{ block.settings.primary_btn_bg }};
    transform: translateY(-3px);
  }

  @media screen and (max-width: 1024px) {
    .ai-product-model-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_font_size }}px * 0.9);
    }
    .ai-product-content-wrap-{{ ai_gen_id }} {
      width: 68%;
    }
  }

  @media screen and (max-width: 640px) {
    .ai-product-grid-wrap-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
    .ai-product-model-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_font_size }}px * 0.8);
    }
    .ai-product-content-wrap-{{ ai_gen_id }} {
      width: 75%;
      padding: 16px 0;
      max-height: 42%;
    }
    .ai-product-grid-section-{{ ai_gen_id }} {
      padding: 50px 0;
    }
  }
{% endstyle %}

<product-grid-{{ ai_gen_id }} class="ai-product-grid-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-container-{{ ai_gen_id }}">
    <div class="ai-product-grid-wrap-{{ ai_gen_id }}">

      {% for i in (1..4) %}
        {% liquid
          assign image_key = 'product_' | append: i | append: '_image'
          assign slogan_key = 'product_' | append: i | append: '_slogan'
          assign title_key = 'product_' | append: i | append: '_title'
          assign show_tag_key = 'product_' | append: i | append: '_show_tag'
          assign tag_text_key = 'product_' | append: i | append: '_tag_text'
          assign desc_key = 'product_' | append: i | append: '_description'
          assign primary_link_key = 'product_' | append: i | append: '_primary_link'
          assign primary_text_key = 'product_' | append: i | append: '_primary_text'
          assign secondary_link_key = 'product_' | append: i | append: '_secondary_link'
          assign secondary_text_key = 'product_' | append: i | append: '_secondary_text'

          assign product_image = block.settings[image_key]
          assign product_slogan = block.settings[slogan_key]
          assign product_title = block.settings[title_key]
          assign show_tag = block.settings[show_tag_key]
          assign tag_text = block.settings[tag_text_key]
          assign product_desc = block.settings[desc_key]
          assign primary_link = block.settings[primary_link_key]
          assign primary_text = block.settings[primary_text_key]
          assign secondary_link = block.settings[secondary_link_key]
          assign secondary_text = block.settings[secondary_text_key]
        %}

        <div class="ai-product-card-{{ ai_gen_id }}">
          {% if product_image %}
            <img
              class="ai-product-bg-img-{{ ai_gen_id }}"
              src="{{ product_image | image_url: width: 1200 }}"
              alt="{{ product_title | escape }}"
              loading="lazy"
              width="1200"
              height="900"
            >
          {% else %}
            <div class="ai-product-bg-img-{{ ai_gen_id }}" style="background-color: #f4f4f4;">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}

          <div class="ai-product-content-wrap-{{ ai_gen_id }}">
            {% if product_slogan != blank %}
              <p class="ai-product-top-slogan-{{ ai_gen_id }}">{{ product_slogan }}</p>
            {% endif %}

            {% if product_title != blank %}
              <h3 class="ai-product-model-title-{{ ai_gen_id }}">
                {{ product_title }}
                {% if show_tag and tag_text != blank %}
                  <span class="ai-product-new-tag-{{ ai_gen_id }}">{{ tag_text }}</span>
                {% endif %}
              </h3>
            {% endif %}

            {% if product_desc != blank %}
              <p class="ai-product-desc-text-{{ ai_gen_id }}">{{ product_desc }}</p>
            {% endif %}

            <div class="ai-product-btn-group-{{ ai_gen_id }}">
              {% if primary_link != blank and primary_text != blank %}
                <a href="{{ primary_link }}" class="ai-btn-primary-shop-{{ ai_gen_id }}">
                  {{ primary_text }}
                </a>
              {% endif %}

              {% if secondary_link != blank and secondary_text != blank %}
                <a href="{{ secondary_link }}" class="ai-btn-secondary-info-{{ ai_gen_id }}">
                  {{ secondary_text }}
                </a>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}

    </div>
  </div>
</product-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('product-grid-{{ ai_gen_id }}', ProductGrid{{ ai_gen_id }});
  })();
</script>

