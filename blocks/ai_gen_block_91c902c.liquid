{% doc %}
  @prompt
    <style>
    /* 全局品牌配色变量 统一全站风格 */
    :root {
      --page-bg: #F8FAFC;
      --accent-green: #00E676;
      --green-dark: #00bd52;
      --text-white: #ffffff;
      --text-dark: #111827;
      --text-gray: #4B5563;
      --border-light: rgba(255, 255, 0.5);
      --btn-glow: 0 0 8px rgba(0, 230, 118, 0.25),
                  0 0 16px rgba(0, 230, 118, 0.35),
                  0 0 28px rgba(0, 230, 118, 0.18);
      --radius-card: 8px;
      --grid-gap: 24px;
      --section-padding: 80px;
      --container-max: 1400px;
      --side-padding: 20px;
    }
    @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@600;700;800&family=Inter:wght@400;500;600&display=swap');
    
    /* 产品板块外层 整体背景#F8FAFC */
    .product-grid-section {
      width: 100%;
      background: var(--page-bg);
      padding: var(--section-padding) 0;
    }
    .product-container {
      max-width: var(--container-max);
      margin: 0 auto;
      padding: 0 var(--side-padding);
    }
    /* 2×2网格布局 */
    .product-grid-wrap {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--grid-gap);
    }
    
    /* 单张产品卡片 横向 宽:高=4:3 */
    .product-card {
      position: relative;
      border-radius: var(--radius-card);
      overflow: hidden;
      aspect-ratio: 4 / 3;
    }
    /* 背景图完全铺满卡片 */
    .product-bg-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.4s ease;
    }
    .product-card:hover .product-bg-img {
      transform: scale(1.03);
    }
    
    /* 文字容器：居中偏上，高度限制40%（2/5），下方60%（3/5）留给图片，整体缩小 */
    .product-content-wrap {
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 60%;
      padding: 20px 0;
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      max-height: 40%;
    }
    /* 顶部小字标语 缩小字号 */
    .product-top-slogan {
      font-size: 11px;
      color: #ffd02f;
      font-weight: 600;
      margin: 0 0 8px;
      font-family: 'Inter', sans-serif;
      letter-spacing: 0.5px;
    }
    /* 产品型号大字 缩小 */
    .product-model-title {
      font-family: 'Manrope', sans-serif;
      font-size: 20px;
      font-weight: 800;
      color: var(--text-white);
      line-height: 1.2;
      margin: 0 0 6px;
    }
    /* NEU新品小标签 同步缩小 */
    .product-new-tag {
      display: inline-block;
      background: var(--accent-green);
      color: #000;
      font-size: 9px;
      font-weight: 700;
      padding: 2px 5px;
      border-radius: 3px;
      margin-left: 5px;
      vertical-align: top;
    }
    /* 简短描述文案 缩小字号+缩减间距 */
    .product-desc-text {
      font-size: 12px;
      color: var(--text-white);
      opacity: 0.92;
      margin: 0 0 16px;
      line-height: 1.5;
    }
    /* 底部双按钮居中并排 */
    .product-btn-group {
      display: flex;
      gap: 10px;
      justify-content: center;
    }
    /* 主按钮 缩小内边距字号，修复边框变量错误 */
    .btn-primary-shop {
      padding: 7px 16px;
      background: var(--accent-green);
      color: #000;
      border: none;
      border-radius: 3px;
      font-size: 12px;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.3s ease;
    }
    .btn-primary-shop:hover {
      background: var(--green-dark);
      transform: translateY(-3px);
      box-shadow: var(--btn-glow);
    }
    /* 次按钮 同步缩小，修复边框变量缺失值 */
    .btn-secondary-info {
      padding: 7px 16px;
      background: transparent;
      color: var(--text-white);
      border: 1px solid rgba(255,255,255,0.5);
      border-radius: 3px;
      font-size: 12px;
      font-weight: 500;
      text-decoration: none;
      transition: all 0.3s ease;
    }
    .btn-secondary-info:hover {
      border-color: var(--accent-green);
      color: var(--accent-green);
      transform: translateY(-3px);
    }
    
    /* 响应式适配 */
    @media screen and (max-width: 1024px) {
      .product-model-title {
        font-size: 18px;
      }
      .product-content-wrap {
        width: 68%;
      }
    }
    @media screen and (max-width: 640px) {
      .product-grid-wrap {
        grid-template-columns: 1fr;
      }
      .product-model-title {
        font-size: 16px;
      }
      .product-content-wrap {
        width: 75%;
        padding: 16px 0;
        max-height: 42%;
      }
      .product-grid-section {
        padding: 50px 0;
      }
    }
    </style>
    
    <!-- 4宫格横版4:3产品卡片 HTML（全部卡片按钮完整，第三四张也补全双按钮） -->
    <section class="product-grid-section">
      <div class="product-container">
        <div class="product-grid-wrap">
    
          <!-- 卡片1：VENUS E Mini -->
          <div class="product-card">
            <img class="product-bg-img" src="替换第一张产品图链接" alt="VENUS E Mini">
            <div class="product-content-wrap">
              <p class="product-top-slogan">Dünn & leicht 22kg</p>
