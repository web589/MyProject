{% schema %}
{
  "name": "Im Lieferumfang",
  "settings": [
    {
      "type": "select",
      "id": "content_source",
      "label": "内容来源",
      "options": [
        { "value": "theme_editor", "label": "右侧 Theme Editor（默认）" },
        { "value": "pdp_content", "label": "PDP 后台内容（备份/旧模式）" }
      ],
      "default": "theme_editor",
      "info": "选择右侧 Theme Editor 后，标题、副标题和清单只读取当前模板的下方字段。"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Im Lieferumfang"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "副标题"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "manrope_n4"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#2c2c2c"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_margin_bottom",
      "label": "Heading bottom margin",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "range",
      "id": "card_size",
      "label": "Card size",
      "min": 180,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 280
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card gap",
      "min": 16,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_border_width",
      "label": "Card border width",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
