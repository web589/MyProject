{% doc %}
  @prompt
    <style>
    .marstek-footer * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      list-style: none;
      text-decoration: none;
    }
    .marstek-footer {
      background-color: #0A1628;
      color: rgba(255, 255, 255, 0.7);
      padding: 60px 20px 30px;
      font-family: system-ui, sans-serif;
    }
    .footer-container {
      max-width: 1400px;
      margin: 0 auto;
    }
    /* 四栏导航主体 */
    .footer-nav-wrap {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 60px;
      margin-bottom: 40px;
      padding-bottom: 30px;
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }
    /* 品牌第一列 */
    .footer-brand h1 {
      color: #ffffff;
      font-size: 42px;
      font-weight: 700;
      margin-bottom: 16px;
      letter-spacing: 2px;
    }
    .footer-brand .brand-desc {
      font-size: 18px;
      line-height: 1.6;
      max-width: 320px;
    }
    /* 导航列通用样式 */
    .footer-column h3 {
      color: #ffffff;
      font-size: 22px;
      margin-bottom: 22px;
      font-weight: 500;
    }
    .footer-column li {
      margin-bottom: 16px;
    }
    .footer-column li a {
      color: rgba(255, 255, 255, 0.65);
      font-size: 17px;
      transition: 0.2s;
    }
    .footer-column li a:hover {
      color: #ffffff;
    }
    
    /* ========== 新增社媒图标区域 ========== */
    .footer-social-wrap {
      display: flex;
      justify-content: center;
      gap: 24px;
      margin-bottom: 40px;
    }
    .social-circle {
      width: 64px;
      height: 64px;
      border-radius: 50%;
      background: #333842;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.25s ease;
    }
    .social-circle:hover {
      background: #ffffff;
    }
    .social-circle:hover svg {
      fill: #0A1628;
    }
    .social-circle svg {
      width: 28px;
      height: 28px;
      fill: #fff;
      transition: fill 0.25s ease;
    }
    
    /* 底部版权栏 */
    .footer-bottom-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 16px;
      color: rgba(255,255,255,0.5);
      flex-wrap: wrap;
      gap: 20px;
    }
    .lang-switch a {
      color: rgba(255,255,255,0.5);
    }
    
    /* 移动端自适应 */
    @media (max-width: 1024px) {
      .footer-nav-wrap {
        grid-template-columns: 1fr 1fr;
        gap: 40px;
      }
    }
    @media (max-width: 640px) {
      .footer-nav-wrap {
        grid-template-columns: 1fr;
      }
      .footer-bottom-bar {
        flex-direction: column;
        text-align: center;
      }
      .social-circle {
        width: 52px;
        height: 52px;
      }
      .social-circle svg {
        width: 24px;
        height: 24px;
      }
    }
    </style>
    
    <div class="marstek-footer">
      <div class="footer-container">
        <div class="footer-nav-wrap">
          <!-- 品牌栏 -->
          <div class="footer-column footer-brand">
            <h1>MARSTEK</h1>
            <p class="brand-desc">Sonne als zuverlässiger Strom für Ihr Zuhause.</p>
          </div>
          <!-- Produkte -->
          <div class="footer-column">
            <h3>Produkte</h3>
            <ul>
              <li><a href="#">VENUSE Mini</a></li>
              <li><a href="#">VENUSE 3.0</a></li>
              <li><a href="#">VENUSE 4.0</a></li>
              <li><a href="#">VENUSE MAX</a></li>
            </ul>
          </div>
          <!-- Support -->
          <div class="footer-column">
            <h3>Support</h3>
            <ul>
              <li><a href="#">Installationsanleitung</a></li>
              <li><a href="#">App Download</a></li>
              <li><a href="#">FAQ</a></li>
              <li><a href="#">Kontakt</a></li>
            </ul>
          </div>
          <!-- Unternehmen -->
          <div class="footer-column">
            <h3>Unternehmen</h3>
            <ul>
              <li><a href="#">Über MARSTEK</a></li>
              <li><a href="#">Presse</a></li>
              <li><a href="#">Karriere</a></li>
              <li><a href="#">Datenschutz</a></li>
            </ul>
          </div>
        </div>
    
        <!-- 社媒图标模块（对应你截图5个平台） -->
        <div class="footer-social-wrap">
          <!-- Facebook -->
          <a href="DEIN_FB_LINK" class="social-circle" target="_blank">
            <svg viewBox="0 0 320 512"><path d="M279.14 288l14.27-92.66h-88.91v-60.13c0-25.35 12.42-50.06 52.24-50.06h40.42V6.26S260.43 0 225.36 0c-73.22 0-121.08 44.38-121.08 124.72v70.62H22.89V288h81.39v224h100.17V288z"></path></svg>
          </a>
          <!-- Instagram -->
          <a href="DEIN_IG_LINK" class="social-circle" target="_blank">
            <svg viewBox="0 0 448 512"><path d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.9 0-184.9zm-39.8 232c-7.3 18.2-22.9 30.7-41.6 34.1-36.9 2.9-132.4 2.9-169.3 0-18.6-3.4-34.2-15.9-41.6-34.1-2.9-36.8-2.9-132.4 0-169.3 7.3-18.2 22.9-30.7 41.6-34.1 36.9-2.9 132.4-2.9 169.3 0 18.6 3.4 34.2 15.9 41.6 34.1 2.9 36.9 2.9 132.4 0 169.3z"></path></svg>
          </a>
          <!-- YouTube -->
          <a href="DEIN_YT_LINK" class="social-circle" target="_blank">
      
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    font-family: {{ block.settings.font_family.family }}, {{ block.settings.font_family.fallback_families }};
    width: 100%;
  }

  .ai-footer-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-footer-nav-wrap-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 60px;
    margin-bottom: 40px;
    padding-bottom: 30px;
    border-bottom: 1px solid {{ block.settings.border_color }};
  }

  .ai-footer-brand-{{ ai_gen_id }} h1 {
    color: {{ block.settings.brand_title_color }};
    font-size: {{ block.settings.brand_title_size }}px;
    font-weight: 700;
    margin: 0 0 16px 0;
    letter-spacing: 2px;
  }

  .ai-footer-brand-desc-{{ ai_gen_id }} {
    font-size: {{ block.settings.brand_desc_size }}px;
    line-height: 1.6;
    max-width: 320px;
    margin: 0;
  }

  .ai-footer-column-{{ ai_gen_id }} h3 {
    color: {{ block.settings.column_heading_color }};
    font-size: {{ block.settings.column_heading_size }}px;
    margin: 0 0 22px 0;
    font-weight: 500;
  }

  .ai-footer-column-{{ ai_gen_id }} ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ai-footer-column-{{ ai_gen_id }} li {
    margin-bottom: 16px;
  }

  .ai-footer-column-{{ ai_gen_id }} li a {
    color: {{ block.settings.link_color }};
    font-size: {{ block.settings.link_size }}px;
    text-decoration: none;
    transition: color 0.2s;
  }

  .ai-footer-column-{{ ai_gen_id }} li a:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-footer-social-wrap-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 24px;
    margin-bottom: 40px;
  }

  .ai-social-circle-{{ ai_gen_id }} {
    width: {{ block.settings.social_icon_size }}px;
    height: {{ block.settings.social_icon_size }}px;
    border-radius: 50%;
    background: {{ block.settings.social_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.25s ease;
    text-decoration: none;
  }

  .ai-social-circle-{{ ai_gen_id }}:hover {
    background: {{ block.settings.social_bg_hover_color }};
  }

  .ai-social-circle-{{ ai_gen_id }}:hover svg {
    fill: {{ block.settings.social_icon_hover_color }};
  }

  .ai-social-circle-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.social_icon_size }}px * 0.44);
    height: calc({{ block.settings.social_icon_size }}px * 0.44);
    fill: {{ block.settings.social_icon_color }};
    transition: fill 0.25s ease;
  }

  .ai-footer-bottom-bar-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: {{ block.settings.bottom_text_size }}px;
    color: {{ block.settings.bottom_text_color }};
    flex-wrap: wrap;
    gap: 20px;
  }

  .ai-footer-bottom-bar-{{ ai_gen_id }} a {
    color: {{ block.settings.bottom_text_color }};
    text-decoration: none;
  }

  .ai-footer-bottom-bar-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.link_hover_color }};
  }

  @media (max-width: 1024px) {
    .ai-footer-nav-wrap-{{ ai_gen_id }} {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 640px) {
    .ai-footer-nav-wrap-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
    .ai-footer-bottom-bar-{{ ai_gen_id }} {
      flex-direction: column;
      text-align: center;
    }
    .ai-social-circle-{{ ai_gen_id }} {
      width: calc({{ block.settings.social_icon_size }}px * 0.8);
      height: calc({{ block.settings.social_icon_size }}px * 0.8);
    }
    .ai-footer-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px {{ block.settings.padding_bottom | times: 0.7 }}px;
    }
  }
{% endstyle %}

<footer-component-{{ ai_gen_id }} class="ai-footer-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
