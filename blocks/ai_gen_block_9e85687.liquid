    {% endif %}

    <div class="ai-footer-bottom-bar-{{ ai_gen_id }}">
      <div>
        {% if block.settings.copyright_text != blank %}
          {{ block.settings.copyright_text }}
        {% else %}
          &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}
        {% endif %}
      </div>
      {% if block.settings.show_language_selector %}
        <div class="ai-lang-switch-{{ ai_gen_id }}">
          <a href="#">{{ block.settings.language_text }}</a>
        </div>
      {% endif %}
    </div>
  </div>
</footer-component-{{ ai_gen_id }}>

<script>
  (function() {
    class FooterComponent{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('footer-component-{{ ai_gen_id }}', FooterComponent{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "MARSTEK footer",
  "settings": [
    {
      "type": "header",
      "content": "Brand section"
    },
    {
      "type": "text",
      "id": "brand_title",
      "label": "Brand title",
      "default": "MARSTEK"
    },
    {
      "type": "textarea",
      "id": "brand_description",
      "label": "Brand description",
      "default": "Sonne als zuverlässiger Strom für Ihr Zuhause."
    },
    {
      "type": "header",
      "content": "Column 1"
    },
    {
      "type": "text",
