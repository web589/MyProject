{% doc %}
  @prompt
    <!DOCTYPE html>
    <html lang="de">
    <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Energie Formate 3 Karten</title>
    <style>
    * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: system-ui, -apple-system, sans-serif;
    }
    
    body {
    background-color: #f8f8f8;
    padding: 80px 20px;
    }
    
    .container {
    max-width: 1280px;
    margin: 0 auto;
    }
    
    /* 整体大标题缩小 */
    .section-title {
    font-size: 32px;
    font-weight: 700;
    color: #222;
    text-align: center;
    margin-bottom: 48px;
    }
    
    .cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    }
    
    /* 卡片容器 强制4:3比例 */
    .feature-card {
    aspect-ratio: 4 / 3;
    border-radius: 16px;
    padding: 40px 32px;
    position: relative;
    display: flex;
    flex-direction: column;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-color: #eef2f6;
    overflow: hidden;
    }
    
    /* 分别给3张卡片自定义背景图，替换url即可 */
    .card-1 {
    background-image: url("BG_URL_1");
    }
    .card-2 {
    background-image: url("BG_URL_2");
    }
    .card-3 {
    background-image: url("BG_URL_3");
    }
    
    .icon-box {
    width: 36px;
    height: 36px;
    margin-bottom: 20px;
    }
    .icon-box img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    }
    
    /* 卡片内标题缩小 */
    .card-h3 {
    font-size: 22px;
    font-weight: 700;
    color: #111;
    margin-bottom: 20px;
    }
    
    /* 卡片描述文字缩小 */
    .card-desc {
    font-size: 15px;
    color: #555;
    line-height: 1.7;
    flex-grow: 1; /* 文字自动撑开，把链接压到底部 */
    margin-bottom: 30px;
    }
    
    /* 所有链接固定在卡片底部，统一位置平行对齐 */
    .card-link {
    position: relative;
    bottom: 0;
    left: 0;
    font-size: 16px;
    font-weight: 600;
    color: #0088ff;
    text-decoration: none;
    align-self: flex-start;
    }
    .card-link:hover {
    text-decoration: underline;
    }
    
    /* 移动端响应式 */
    @media (max-width: 900px) {
    .cards-grid {
    grid-template-columns: 1fr;
    }
    .section-title {
    font-size: 24px;
    }
    }
    </style>
    </head>
    <body>
    <div class="container">
    <h2 class="section-title">Drei Formate für unterschiedliche Energiebedürfnisse</h2>
    
    <div class="cards-grid">
    <!-- Karte 1 Plug & Play -->
    <div class="feature-card card-1">
    <div class="icon-box">
    <img src="ICON_URL_1" alt="Plug&Play Icon">
    </div>
    <h3 class="card-h3">Plug & Play</h3>
    <p class="card-desc">
    Einfach an die Steckdose – keine professionelle Installation erforderlich. Ideal für Balkonkraftwerke und kleine Haushalte.
    </p>
    <a href="#" class="card-link">Plug & Play Produkte →</a>
    </div>
    
    <!-- Karte 2 Erweiterbar -->
    <div class="feature-card card-2">
    <div class="icon-box">
    <img src="ICON_URL_2" alt="Erweiterbar Icon">
    </div>
    <h3 class="card-h3">Erweiterbar</h3>
    <p class="card-desc">
    Parallelschaltung mit SmartBox. Kapazität und Leistung wachsen mit Ihrem Energiebedarf.
    </p>
    <a href="#" class="card-link">Erweiterung ansehen →</a>
    </div>
    
    <!-- Karte 3 Zubehör -->
    <div class="feature-card card-3">
    <div class="icon-box">
    <img src="ICON_URL_3" alt="Zubehör Icon">
    </div>
    <h3 class="card-h3">Zubehör</h3>
    <p class="card-desc">
    SmartBox, intelligente Stromzähler, tragbare EV-Ladegeräte und mehr für Ihr komplettes Heimsystem.
    </p>
    <a href="#" class="card-link">Zubehör durchsuchen →</a>
    </div>
    </div>
    </div>
    </body>
    </html>, 每个card的Link都居于卡片底部同一位置平行, 每个card的Link都居于卡片底部同一高度
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-energy-formats-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 20px;
  }

  .ai-energy-formats-container-{{ ai_gen_id }} {
    max-width: 1280px;
    margin: 0 auto;
  }

  .ai-energy-formats-heading-{{ ai_gen_id }} {
    max-width: 900px;
    margin: 0 auto 48px;
    text-align: center;
  }

  .ai-energy-formats-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    color: {{ block.settings.title_color }};
    margin: 0;
    line-height: 1.2;
    letter-spacing: 0;
  }

  .ai-energy-formats-subtitle-{{ ai_gen_id }} {
    margin: 12px auto 0;
    color: {{ block.settings.card_text_color }};
    font-size: {{ block.settings.card_text_size }}px;
    line-height: 1.7;
    letter-spacing: 0;
  }

  .ai-energy-formats-subtitle-{{ ai_gen_id }} p {
    margin: 0;
  }

  .ai-energy-formats-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .ai-energy-formats-card-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    min-width: 0;
    text-align: center;
  }

  .ai-energy-formats-card-media-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.card_border_radius }}px;
    background-color: {{ block.settings.card_fallback_bg }};
  }

  .ai-energy-formats-card-media-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-energy-formats-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #b9c3cf;
  }

  .ai-energy-formats-image-placeholder-{{ ai_gen_id }} svg {
    width: 64px;
    height: 64px;
    opacity: 0.45;
  }

  .ai-energy-formats-card-body-{{ ai_gen_id }} {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    padding: 16px 16px 0;
  }

  .ai-energy-formats-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: 700;
    color: {{ block.settings.card_title_color }};
    margin: 0 0 12px;
    line-height: 1.2;
    letter-spacing: 0;
  }

  .ai-energy-formats-card-desc-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_text_size }}px;
    color: {{ block.settings.card_text_color }};
    line-height: 1.7;
    margin: 0 0 18px;
  }

  .ai-energy-formats-card-link-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    margin-top: auto;
    padding: 8px 18px;
    border: 1px solid #dce3ea;
    border-radius: 999px;
    font-size: 16px;
    font-weight: 600;
    color: {{ block.settings.link_color }};
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
  }

  .ai-energy-formats-card-link-{{ ai_gen_id }}:hover {
    border-color: {{ block.settings.link_color }};
    color: {{ block.settings.link_color }};
    box-shadow: 0 4px 12px rgba(0, 153, 252, 0.12);
  }

  @media screen and (max-width: 900px) {
    .ai-energy-formats-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-energy-formats-heading-{{ ai_gen_id }} {
      margin-bottom: 32px;
    }

    .ai-energy-formats-title-{{ ai_gen_id }} {
      font-size: 28px;
    }
  }
{% endstyle %}

<energy-formats-{{ ai_gen_id }} class="ai-energy-formats-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-energy-formats-container-{{ ai_gen_id }}">
    {% if block.settings.section_title != blank or block.settings.section_subtitle != blank %}
      <div class="ai-energy-formats-heading-{{ ai_gen_id }}">
        {% if block.settings.section_title != blank %}
          <h2 class="ai-energy-formats-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
        {% endif %}
        {% if block.settings.section_subtitle != blank %}
          <div class="ai-energy-formats-subtitle-{{ ai_gen_id }} rte">{{ block.settings.section_subtitle }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-energy-formats-grid-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign card_bg_key = 'card_' | append: i | append: '_bg_image'
          assign card_title_key = 'card_' | append: i | append: '_title'
          assign card_desc_key = 'card_' | append: i | append: '_description'
          assign card_link_text_key = 'card_' | append: i | append: '_link_text'
          assign card_link_url_key = 'card_' | append: i | append: '_link_url'

          assign card_image = block.settings[card_bg_key]
          assign card_title = block.settings[card_title_key]
          assign card_desc = block.settings[card_desc_key]
          assign card_link_text = block.settings[card_link_text_key]
          assign card_link_url = block.settings[card_link_url_key]
        %}

        <article class="ai-energy-formats-card-{{ ai_gen_id }}">
          <div class="ai-energy-formats-card-media-{{ ai_gen_id }}" data-scroll-reveal-module-media>
            {% if card_image != blank %}
              {% liquid
                assign card_image_alt = card_image.alt | default: card_title
              %}
              {{ card_image
                | image_url: width: 1200
                | image_tag:
                  widths: '360, 540, 720, 960, 1200',
                  sizes: '(min-width: 901px) 33vw, 100vw',
                  loading: 'lazy',
                  alt: card_image_alt
              }}
            {% else %}
              <div class="ai-energy-formats-image-placeholder-{{ ai_gen_id }}" aria-label="Image placeholder">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          <div class="ai-energy-formats-card-body-{{ ai_gen_id }}">
            {% if card_title != blank %}
              <h3 class="ai-energy-formats-card-title-{{ ai_gen_id }}">{{ card_title }}</h3>
            {% endif %}

            {% if card_desc != blank %}
              <p class="ai-energy-formats-card-desc-{{ ai_gen_id }}">{{ card_desc | escape | newline_to_br }}</p>
            {% endif %}

            {% if card_link_text != blank and card_link_url != blank %}
              <a href="{{ card_link_url }}" class="ai-energy-formats-card-link-{{ ai_gen_id }}">
                {{ card_link_text }}
              </a>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</energy-formats-{{ ai_gen_id }}>

