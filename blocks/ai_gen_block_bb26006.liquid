{% doc %}
  @prompt
    <!DOCTYPE html>
    <html lang="de">
    <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kundenbewertungen Slider</title>
    <style>
    .review-slider-section {
      width: 100%;
      padding: 70px 20px;
      background-color: #f5f5f5;
      box-sizing: border-box;
      position: relative;
    }
    .review-container {
      max-width: 1440px;
      margin: 0 auto;
    }
    .review-main-title {
      font-size: clamp(2.2rem, 5vw, 3.6rem);
      margin: 0 0 45px;
      font-weight: 700;
      color: #000;
    }
    /* 轮播外层 */
    .review-outer {
      overflow: hidden;
      position: relative;
    }
    /* 滚动轨道 */
    .review-track {
      display: flex;
      gap: 22px;
      transition: transform 0.4s ease-out;
      will-change: transform;
    }
    /* 单张卡片 */
    .review-card {
      flex: 0 0 320px;
      position: relative;
      overflow: hidden;
      border-radius: 12px;
      cursor: pointer;
    }
    .review-img {
      width: 100%;
      height: 320px;
      object-fit: cover;
      display: block;
      transition: transform 0.3s ease;
    }
    .review-card:hover .review-img {
      transform: scale(1.06);
    }
    /* 悬浮遮罩+文字 */
    .review-mask {
      position: absolute;
      inset: 0;
      background: rgba(0,0,0,0.65);
      padding: 26px 20px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      color: #fff;
      opacity: 0;
      transition: opacity 0.3s ease;
    }
    .review-card:hover .review-mask {
      opacity: 1;
    }
    .review-stars {
      font-size: 1.6rem;
      color: #36d399;
      margin-bottom: 12px;
    }
    .review-text {
      font-size: 1.05rem;
      line-height: 1.6;
      margin: 0 0 16px;
    }
    .review-author {
      font-size: 0.98rem;
      opacity: 0.85;
    }
    
    /* 左右控制按钮 */
    .slider-control-btn {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: rgba(0,0,0,0.4);
      color: #fff;
      border: none;
      font-size: 20px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 10;
      transition: background 0.2s ease;
    }
    .slider-control-btn:hover {
      background: rgba(0,0,0,0.75);
    }
    .btn-prev {
      left: 12px;
    }
    .btn-next {
      right: 12px;
    }
    
    /* 移动端适配 */
    @media screen and (max-width:768px) {
      .review-card {
        flex: 0 0 260px;
      }
      .review-img {
        height: 260px;
      }
      .slider-control-btn {
        width: 40px;
        height: 40px;
        font-size: 16px;
      }
      .btn-prev {
        left: 6px;
      }
      .btn-next {
        right: 6px;
      }
    }
    </style>
    </head>
    <body>
    <section class="review-slider-section">
      <div class="review-container">
        <h2 class="review-main-title">Hear from our users</h2>
        <div class="review-outer">
          <!-- 左右控制按钮 -->
          <button class="slider-control-btn btn-prev" type="button">←</button>
          <button class="slider-control-btn btn-next" type="button">→</button>
    
          <div class="review-track">
