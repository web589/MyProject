{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-grid-container-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px {{ block.settings.section_padding_horizontal }}px;
    background: {{ block.settings.background_color }};
  }

  .ai-product-grid-header-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-product-grid-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 650;
    color: {{ block.settings.title_color }};
    letter-spacing: -0.5px;
    margin: 0 0 {{ block.settings.subtitle_spacing }}px 0;
  }

  .ai-product-grid-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
  }

  .ai-product-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  @media (max-width: 1100px) {
    .ai-product-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media (max-width: 600px) {
    .ai-product-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(1, 1fr);
    }
  }

  .ai-product-card-{{ ai_gen_id }} {
    position: relative;
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.04), 0 8px 20px rgba(0, 0, 0, 0.03);
    padding: {{ block.settings.card_padding }}px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    border: 1px solid {{ block.settings.card_border_color }};
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }

  .ai-product-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.06);
  }

  .ai-product-card-{{ ai_gen_id }}.is-soldout {
    opacity: 0.92;
  }

  .ai-discount-badge-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.card_padding }}px;
    left: {{ block.settings.card_padding }}px;
    z-index: 2;
    background: {{ block.settings.discount_badge_bg }};
    color: {{ block.settings.discount_badge_text }};
    font-size: {{ block.settings.badge_font_size }}px;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: 30px;
    letter-spacing: 0.02em;
  }

  .ai-soldout-badge-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.card_padding }}px;
    left: {{ block.settings.card_padding }}px;
    z-index: 2;
    background: {{ block.settings.soldout_badge_bg }};
    color: {{ block.settings.soldout_badge_text }};
    font-size: {{ block.settings.badge_font_size }}px;
    font-weight: 650;
    padding: 0.25rem 0.65rem;
    border-radius: 30px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .ai-brand-headline-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.15rem;
  }

  .ai-brand-headline-{{ ai_gen_id }} h3 {
    font-size: {{ block.settings.brand_font_size }}px;
    font-weight: 650;
    color: {{ block.settings.brand_color }};
    margin: 0;
  }

  .ai-brand-badge-{{ ai_gen_id }} {
    font-size: {{ block.settings.badge_font_size | times: 0.85 }}px;
    font-weight: 500;
    background: {{ block.settings.badge_background }};
    padding: 0.15rem 0.6rem;
    border-radius: 30px;
    color: {{ block.settings.badge_text_color }};
  }

  .ai-product-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_name_size }}px;
    font-weight: 450;
    color: {{ block.settings.product_name_color }};
    margin-bottom: 1rem;
    border-left: 3px solid {{ block.settings.product_name_border }};
    padding-left: 0.6rem;
    background: {{ block.settings.product_name_bg }};
    border-radius: 0 4px 4px 0;
    display: inline-block;
    padding-right: 0.6rem;
  }

  .ai-product-image-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background: {{ block.settings.image_background }};
    border-radius: {{ block.settings.image_border_radius }}px;
    margin-bottom: 1.2rem;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid {{ block.settings.image_border_color }};
    box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.02);
  }

  .ai-product-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .ai-product-image-placeholder-{{ ai_gen_id }} {
    width: 70%;
    height: 70%;
  }

  .ai-product-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    color: #b6c9db;
    opacity: 0.4;
  }

  .ai-price-block-{{ ai_gen_id }} {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.3rem 0.6rem;
    margin: 0.3rem 0 0.8rem 0;
    background: {{ block.settings.price_block_bg }};
    padding: 0.3rem 0.6rem 0.3rem 0;
    border-radius: 40px;
  }

  .ai-price-current-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_font_size }}px;
    font-weight: 700;
    color: {{ block.settings.price_color }};
    letter-spacing: -0.3px;
  }

  .ai-price-old-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_font_size | times: 0.66 }}px;
    font-weight: 400;
    color: {{ block.settings.price_old_color }};
    text-decoration: line-through;
  }

  .ai-price-tax-note-{{ ai_gen_id }} {
    font-size: {{ block.settings.tax_note_size }}px;
    font-weight: 450;
    color: {{ block.settings.tax_note_color }};
    background: {{ block.settings.tax_note_bg }};
    padding: 0.1rem 0.6rem;
    border-radius: 30px;
    margin-left: auto;
    white-space: nowrap;
  }

  .ai-shipping-note-{{ ai_gen_id }} {
    font-size: {{ block.settings.shipping_note_size }}px;
    color: {{ block.settings.shipping_note_color }};
    margin: -0.4rem 0 0.8rem 0.1rem;
  }

  .ai-financing-block-{{ ai_gen_id }} {
    background: {{ block.settings.financing_bg }};
    border-radius: 16px;
    padding: 0.6rem 0.9rem;
    margin: 0.5rem 0 0.8rem 0;
    border: 1px solid {{ block.settings.financing_border }};
    flex-shrink: 0;
  }

  .ai-financing-logos-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }

  .ai-financing-logo-{{ ai_gen_id }} {
    height: 16px;
    width: auto;
  }

  .ai-financing-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.financing_text_size }}px;
    color: {{ block.settings.financing_text_color }};
    line-height: 1.3;
  }

  .ai-financing-amount-{{ ai_gen_id }} {
    font-weight: 700;
    color: {{ block.settings.financing_amount_color }};
  }
{% endstyle %}

<product-grid-{{ ai_gen_id }} class="ai-product-grid-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.show_header %}
    <div class="ai-product-grid-header-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-product-grid-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}
      {% if block.settings.subtitle != blank %}
        <p class="ai-product-grid-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="ai-product-grid-{{ ai_gen_id }}">
    {% if block.settings.products != blank %}
      {% for product in block.settings.products %}
        <a
          href="{{ product.url }}"
          class="ai-product-card-{{ ai_gen_id }} {% unless product.available %}is-soldout{% endunless %}"
        >
          {% if product.available == false %}
            <div class="ai-soldout-badge-{{ ai_gen_id }}">{{ block.settings.soldout_text }}</div>
          {% elsif product.compare_at_price > product.price %}
            {% assign discount_percent = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
            <div class="ai-discount-badge-{{ ai_gen_id }}">-{{ discount_percent }}%</div>
          {% endif %}

          {% if product.vendor != blank %}
            <div class="ai-brand-headline-{{ ai_gen_id }}">
              <h3>{{ product.vendor }}</h3>
              {% if block.settings.show_brand_badge %}
                <span class="ai-brand-badge-{{ ai_gen_id }}">{{ block.settings.brand_badge_label }}</span>
              {% endif %}
            </div>
          {% endif %}

          {% if product.title != blank %}
            <div class="ai-product-name-{{ ai_gen_id }}">{{ product.title }}</div>
          {% endif %}

          <div class="ai-product-image-{{ ai_gen_id }}">
            {% if product.featured_image %}
              <img
                src="{{ product.featured_image | image_url: width: 600 }}"
                alt="{{ product.featured_image.alt | escape }}"
                loading="lazy"
                width="600"
                height="600"
              >
            {% else %}
              <div class="ai-product-image-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          <div class="ai-price-block-{{ ai_gen_id }}">
            <span class="ai-price-current-{{ ai_gen_id }}">{{ product.price | money }}</span>
            {% if product.compare_at_price > product.price %}
              <span class="ai-price-old-{{ ai_gen_id }}">{{ product.compare_at_price | money }}</span>
            {% endif %}
            {% if block.settings.show_tax_note %}
              <span class="ai-price-tax-note-{{ ai_gen_id }}">{{ block.settings.tax_note_text }}</span>
            {% endif %}
          </div>

          {% if block.settings.show_shipping_note %}
            <div class="ai-shipping-note-{{ ai_gen_id }}">{{ block.settings.shipping_note_text }}</div>
          {% endif %}

          {% if block.settings.show_financing %}
            <div class="ai-financing-block-{{ ai_gen_id }}">
              {% if block.settings.financing_logo_1 or block.settings.financing_logo_2 %}
                <div class="ai-financing-logos-{{ ai_gen_id }}">
                  {% if block.settings.financing_logo_1 %}
                    <img
                      src="{{ block.settings.financing_logo_1 | image_url: height: 32 }}"
                      alt="Financing option 1"
                      class="ai-financing-logo-{{ ai_gen_id }}"
                      loading="lazy"
                    >
                  {% endif %}
                  {% if block.settings.financing_logo_2 %}
                    <img
                      src="{{ block.settings.financing_logo_2 | image_url: height: 32 }}"
                      alt="Financing option 2"
                      class="ai-financing-logo-{{ ai_gen_id }}"
                      loading="lazy"
                    >
                  {% endif %}
                </div>
              {% endif %}
              {% if block.settings.financing_text != blank %}
                <div class="ai-financing-text-{{ ai_gen_id }}">
                  {{ block.settings.financing_text }}
                  {% if block.settings.show_financing_amount %}
                    {% assign monthly_payment = product.price | divided_by: block.settings.financing_months %}
                    <span class="ai-financing-amount-{{ ai_gen_id }}">{{ monthly_payment | money }}</span>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          {% endif %}
        </a>
      {% endfor %}
    {% else %}
      {% for i in (1..8) %}
        <div class="ai-product-card-{{ ai_gen_id }}">
          <div class="ai-brand-headline-{{ ai_gen_id }}">
            <h3>Brand Name</h3>
            {% if block.settings.show_brand_badge %}
              <span class="ai-brand-badge-{{ ai_gen_id }}">{{ block.settings.brand_badge_label }}</span>
            {% endif %}
          </div>

          <div class="ai-product-name-{{ ai_gen_id }}">Product Name</div>

          <div class="ai-product-image-{{ ai_gen_id }}">
            <div class="ai-product-image-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          </div>

          <div class="ai-price-block-{{ ai_gen_id }}">
            <span class="ai-price-current-{{ ai_gen_id }}">€0,00</span>
            {% if block.settings.show_tax_note %}
              <span class="ai-price-tax-note-{{ ai_gen_id }}">{{ block.settings.tax_note_text }}</span>
            {% endif %}
          </div>

          {% if block.settings.show_shipping_note %}
            <div class="ai-shipping-note-{{ ai_gen_id }}">{{ block.settings.shipping_note_text }}</div>
          {% endif %}
        </div>
      {% endfor %}
    {% endif %}
  </div>
</product-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('product-grid-{{ ai_gen_id }}', ProductGrid{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Product grid",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show header",
      "default": true
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "NODE Rabot · Produkte"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "Subtitle size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "header_spacing",
      "label": "Header spacing",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "subtitle_spacing",
      "label": "Subtitle spacing",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "limit": 12
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Columns on tablet",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 25
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "section_padding_horizontal",
      "label": "Horizontal padding",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
