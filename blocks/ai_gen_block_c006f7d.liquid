{% doc %}
  @prompt
    <!DOCTYPE html>
    <html lang="de">
    <head>
      <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <title>NODE Rabot · Produkte</title>
      <style>
        * {
          margin: 0;
          padding: 0;
          box-sizing: border-box;
          font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
        }
    
        body {
          background: #f2f4f8;
          min-height: 100vh;
          padding: 2rem 1rem;
        }
    
        /* 页面标题 */
        .page-header {
          max-width: 1400px;
          margin: 0 auto 2rem;
          padding: 0 0.5rem;
        }
    
        .page-header h2 {
          font-size: 2rem;
          font-weight: 650;
          color: #0b1a2b;
          letter-spacing: -0.5px;
        }
    
        .page-header p {
          color: #5a6f82;
          font-size: 1rem;
          margin-top: 0.25rem;
        }
    
        /* 4列网格 */
        .product-grid {
          max-width: 1400px;
          margin: 0 auto;
          display: grid;
          grid-template-columns: repeat(4, 1fr);
          gap: 1.5rem;
        }
    
        @media (max-width: 1100px) {
          .product-grid { grid-template-columns: repeat(2, 1fr); }
        }
    
        @media (max-width: 600px) {
          .product-grid { grid-template-columns: 1fr; }
        }
    
        /* 每个产品卡片 */
        .product-card {
          position: relative;
          background: #ffffff;
          border-radius: 28px;
          box-shadow: 0 20px 40px rgba(0, 0, 0, 0.04), 0 8px 20px rgba(0, 0, 0, 0.03);
          padding: 1.5rem 1.2rem 1.2rem;
          transition: transform 0.2s ease, box-shadow 0.2s ease;
          border: 1px solid rgba(0, 0, 0, 0.02);
          display: flex;
          flex-direction: column;
        }
    
        .product-card:hover {
          transform: translateY(-4px);
          box-shadow: 0 24px 48px rgba(0, 0, 0, 0.06);
        }
    
        .product-card.is-soldout {
          opacity: 0.92;
        }
    
        /* 折扣角标 */
        .discount-badge {
          position: absolute;
          top: 1.2rem;
          left: 1.2rem;
          z-index: 2;
          background: #d0382f;
          color: #ffffff;
          font-size: 0.7rem;
          font-weight: 700;
          padding: 0.25rem 0.65rem;
          border-radius: 30px;
          letter-spacing: 0.02em;
        }
    
        /* 售罄角标 */
        .soldout-badge {
          position: absolute;
          top: 1.2rem;
          left: 1.2rem;
          z-index: 2;
          background: #93a2b1;
          color: #ffffff;
          font-size: 0.65rem;
          font-weight: 650;
          padding: 0.25rem 0.65rem;
          border-radius: 30px;
          letter-spacing: 0.04em;
          text-transform: uppercase;
        }
    
        /* 品牌标题 */
        .brand-headline {
          display: flex;
          justify-content: space-between;
          align-items: baseline;
          margin-bottom: 0.15rem;
        }
    
        .brand-headline h3 {
          font-size: 1.2rem;
          font-weight: 650;
          color: #0b1a2b;
        }
    
        .brand-headline .badge {
          font-size: 0.6rem;
          font-weight: 500;
          background: #eef2f6;
          padding: 0.15rem 0.6rem;
          border-radius: 30px;
          color: #1f2a3a;
        }
    
        /* 产品名称 */
        .product-name {
          font-size: 0.85rem;
          font-weight: 450;
          color: #2c3e50;
          margin-bottom: 1rem;
          border-left: 3px solid #c0cfde;
          padding-left: 0.6rem;
          background: #fafcfe;
          border-radius: 0 4px 4px 0;
          display: inline-block;
          padding-right: 0.6rem;
        }
    
        /* 1:1 图片容器 */
        .product-image {
          width: 100%;
          aspect-ratio: 1 / 1;
          background: #ffffff;
          border-radius: 20px;
          margin-bottom: 1.2rem;
          overflow: hidden;
          display: flex;
          align-items: center;
          justify-content: center;
          border: 1px solid #f0f2f5;
          box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.02);
        }
    
        .product-image img {
          width: 100%;
          height: 100%;
          object-fit: contain;
          display: block;
        }
    
        /* 如果没有图片，显示占位SVG */
        .product-image .placeholder {
          width: 70%;
          height: 70%;
          color: #b6c9db;
          opacity: 0.4;
        }
    
        /* 价格块 */
        .price-block {
          display: flex;
          align-items: baseline;
          flex-wrap: wrap;
          gap: 0.3rem 0.6rem;
          margin: 0.3rem 0 0.8rem 0;
          background: #f9fbfd;
          padding: 0.3rem 0.6rem 0.3rem 0;
          border-radius: 40px;
        }
    
        .price-current {
          font-size: 1.5rem;
          font-weight: 700;
          color: #0b1a2b;
          letter-spacing: -0.3px;
        }
    
        .price-old {
          font-size: 1rem;
          font-weight: 400;
          color: #7c8b9c;
          text-decoration: line-through;
        }
    
        .price-tax-note {
