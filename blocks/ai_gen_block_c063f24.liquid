{% doc %}
  @prompt
    .spc {
      max-width: 1200px;
      margin: 0 auto;
      padding: 40px 24px;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      color: #1a1a1a;
    }
    
    .spc__heading {
      font-size: 24px;
      font-weight: 700;
      margin: 0 0 24px;
    }
    
    .spc__grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
    
    @media (max-width: 989px) {
      .spc__grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    
    @media (max-width: 599px) {
      .spc__grid {
        grid-template-columns: 1fr;
      }
    }
    
    .spc__card {
      display: flex;
      flex-direction: column;
      background: #ffffff;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid #eef0f3;
    }
    
    .spc__media {
      display: block;
      aspect-ratio: 4 / 3;
      background: #f7f8fa;
      overflow: hidden;
    }
    
    .spc__media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    
    .spc__media-placeholder svg {
      width: 100%;
      height: 100%;
    }
    
    .spc__title {
      display: block;
      font-size: 16px;
      font-weight: 600;
      line-height: 1.4;
      color: #1a1a1a;
      text-decoration: none;
      padding: 16px 20px 0;
    }
    
    .spc__title:hover {
      text-decoration: underline;
    }
    
    .spc__points {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      padding: 16px 20px 0;
    }
    
    .spc__point {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    
    .spc__point-value {
      font-size: 15px;
      font-weight: 700;
      color: #1a1a1a;
    }
    
    .spc__point-label {
      font-size: 12px;
      color: #6b7280;
      line-height: 1.3;
    }
    
    .spc__price-row {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      padding: 16px 20px 20px;
      margin-top: auto;
    }
    
    .spc__price {
      font-size: 28px;
      font-weight: 700;
      white-space: nowrap;
    }
    
    .spc__price-compare {
      font-size: 14px;
      color: #9ca3af;
      text-decoration: line-through;
      white-space: nowrap;
    }
    
    .spc__btn {
      margin-left: auto;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 10px 18px;
      border-radius: 6px;
      background: var(--spc-btn-bg, #1abc9c);
      color: var(--spc-btn-text, #ffffff);
      font-size: 14px;
      font-weight: 600;
      text-decoration: none;
      white-space: nowrap;
      transition: opacity 0.15s ease;
    }
    
    .spc__btn:hover {
      opacity: 0.88;
    }
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-comparison-{{ ai_gen_id }} {
    display: block;
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 24px;
    font-family: {{ block.settings.font_family.family }}, {{ block.settings.font_family.fallback_families }};
    color: {{ block.settings.text_color }};
    width: {{ block.settings.desktop_width_percent }}%;
  }

  .ai-product-comparison__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    margin: 0 0 24px;
    color: {{ block.settings.heading_color }};
  }

  .ai-product-comparison__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: 24px;
  }

  @media (max-width: 989px) {
    .ai-product-comparison__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 599px) {
    .ai-product-comparison__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }
  }

  .ai-product-comparison__card-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    background: {{ block.settings.card_bg_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    border: 1px solid {{ block.settings.card_border_color }};
  }

  .ai-product-comparison__media-{{ ai_gen_id }} {
    display: block;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    background: {{ block.settings.image_bg_color }};
    overflow: hidden;
    position: relative;
  }

  .ai-product-comparison__media-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-product-comparison__media-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background: {{ block.settings.image_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-comparison__media-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-product-comparison__title-{{ ai_gen_id }} {
    display: block;
    font-size: {{ block.settings.product_title_size }}px;
    font-weight: 600;
    line-height: 1.4;
    color: {{ block.settings.text_color }};
    text-decoration: none;
    padding: 16px 20px 0;
  }

  .ai-product-comparison__title-{{ ai_gen_id }}:hover {
    text-decoration: underline;
  }

  .ai-product-comparison__points-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    padding: 16px 20px 0;
  }

  .ai-product-comparison__point-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ai-product-comparison__point-value-{{ ai_gen_id }} {
    font-size: {{ block.settings.point_value_size }}px;
    font-weight: 700;
    color: {{ block.settings.text_color }};
  }

  .ai-product-comparison__point-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.point_label_size }}px;
    color: {{ block.settings.secondary_text_color }};
    line-height: 1.3;
  }

  .ai-product-comparison__price-row-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    padding: 16px 20px 20px;
    margin-top: auto;
  }

  .ai-product-comparison__price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    font-weight: 700;
    white-space: nowrap;
    color: {{ block.settings.text_color }};
  }

  .ai-product-comparison__price-compare-{{ ai_gen_id }} {
    font-size: {{ block.settings.compare_price_size }}px;
    color: {{ block.settings.secondary_text_color }};
    text-decoration: line-through;
    white-space: nowrap;
  }

  .ai-product-comparison__btn-{{ ai_gen_id }} {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 18px;
    border-radius: {{ block.settings.button_border_radius }}px;
    background: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.15s ease;
  }

  .ai-product-comparison__btn-{{ ai_gen_id }}:hover {
    opacity: 0.88;
  }

  .ai-product-comparison__empty-state-{{ ai_gen_id }} {
    grid-column: 1 / -1;
    text-align: center;
    padding: 60px 20px;
    color: {{ block.settings.secondary_text_color }};
    font-size: 14px;
  }
{% endstyle %}

<product-comparison-{{ ai_gen_id }} class="ai-product-comparison-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-product-comparison__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
  {% endif %}

  <div class="ai-product-comparison__grid-{{ ai_gen_id }}">
    {% liquid
      assign has_products = false
      for i in (1..6)
        assign product_key = 'product_' | append: i
        assign product = block.settings[product_key]
        if product != blank
          assign has_products = true
          break
        endif
      endfor
    %}

    {% if has_products %}
      {% for i in (1..6) %}
        {% liquid
          assign product_key = 'product_' | append: i
          assign point_1_label_key = 'product_' | append: i | append: '_point_1_label'
          assign point_1_value_key = 'product_' | append: i | append: '_point_1_value'
          assign point_2_label_key = 'product_' | append: i | append: '_point_2_label'
          assign point_2_value_key = 'product_' | append: i | append: '_point_2_value'
          assign point_3_label_key = 'product_' | append: i | append: '_point_3_label'
          assign point_3_value_key = 'product_' | append: i | append: '_point_3_value'

          assign product = block.settings[product_key]
          assign point_1_label = block.settings[point_1_label_key]
          assign point_1_value = block.settings[point_1_value_key]
          assign point_2_label = block.settings[point_2_label_key]
          assign point_2_value = block.settings[point_2_value_key]
          assign point_3_label = block.settings[point_3_label_key]
          assign point_3_value = block.settings[point_3_value_key]
        %}

        {% if product != blank %}
          <div class="ai-product-comparison__card-{{ ai_gen_id }}">
            <div class="ai-product-comparison__media-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 800 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  loading="lazy"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                >
              {% else %}
                <div class="ai-product-comparison__media-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            <a href="{{ product.url }}" class="ai-product-comparison__title-{{ ai_gen_id }}">
              {{ product.title }}
            </a>

            <div class="ai-product-comparison__points-{{ ai_gen_id }}">
              <div class="ai-product-comparison__point-{{ ai_gen_id }}">
                <div class="ai-product-comparison__point-value-{{ ai_gen_id }}">{{ point_1_value }}</div>
                <div class="ai-product-comparison__point-label-{{ ai_gen_id }}">{{ point_1_label }}</div>
              </div>
              <div class="ai-product-comparison__point-{{ ai_gen_id }}">
                <div class="ai-product-comparison__point-value-{{ ai_gen_id }}">{{ point_2_value }}</div>
                <div class="ai-product-comparison__point-label-{{ ai_gen_id }}">{{ point_2_label }}</div>
              </div>
              <div class="ai-product-comparison__point-{{ ai_gen_id }}">
                <div class="ai-product-comparison__point-value-{{ ai_gen_id }}">{{ point_3_value }}</div>
                <div class="ai-product-comparison__point-label-{{ ai_gen_id }}">{{ point_3_label }}</div>
              </div>
            </div>

            <div class="ai-product-comparison__price-row-{{ ai_gen_id }}">
              <div class="ai-product-comparison__price-{{ ai_gen_id }}">
                {{ product.price | money }}
              </div>
              {% if product.compare_at_price > product.price %}
                <div class="ai-product-comparison__price-compare-{{ ai_gen_id }}">
                  {{ product.compare_at_price | money }}
                </div>
              {% endif %}
              <a href="{{ product.url }}" class="ai-product-comparison__btn-{{ ai_gen_id }}">
                {{ block.settings.button_text }}
              </a>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    {% else %}
      <div class="ai-product-comparison__empty-state-{{ ai_gen_id }}">
        Next, add products to compare
      </div>
    {% endif %}
  </div>
</product-comparison-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductComparison{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('product-comparison-{{ ai_gen_id }}', ProductComparison{{ ai_gen_id }});
  })();
</script>

