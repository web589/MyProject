{% doc %}
  @prompt
    <!DOCTYPE html>
    <html lang="de">
    <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Footer CTA | 与Hero氛围呼应 版式不重复</title>
    <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: -apple-system, BlinkMacSystemFont, sans-serif;
    }
    
    body {
      background-color: #000;
    }
    
    /* 核心CTA区块：氛围呼应Hero，版式全新居中极简 */
    .page-final-cta {
      width: 100%;
      padding: 90px 20px;
      /* 只复用Hero的绿光渐变氛围，实现首尾呼应 */
      background: 
        radial-gradient(circle at 50% 0%, rgba(0, 199, 82, 0.12), transparent 60%),
        #040404;
      position: relative;
    }
    
    /* 顶部细分割线 微光呼应Hero */
    .cta-line-top {
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 80px;
      height: 2px;
      background: #00c752;
      border-radius: 2px;
      opacity: 0.7;
    }
    
    /* 居中窄版容器 和Hero宽幅分栏完全区分 */
    .cta-inner {
      max-width: 700px;
      margin: 0 auto;
      text-align: center;
    }
    
    .cta-subtitle {
      color: #00c752;
      font-size: 14px;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 16px;
      opacity: 0.9;
    }
    
    .cta-title {
      font-size: 36px;
      color: #ffffff;
      font-weight: 700;
      line-height: 1.3;
      margin-bottom: 20px;
    }
    
    .cta-desc {
      font-size: 16px;
      color: rgba(255,255,255,0.7);
      line-height: 1.75;
      margin-bottom: 35px;
    }
    
    /* 居中双按钮 全新排版 */
    .cta-btn-group {
      display: flex;
      justify-content: center;
      gap: 18px;
      flex-wrap: wrap;
    }
    
    .cta-btn-primary {
      padding: 15px 34px;
      background: #00c752;
      color: #000;
      font-weight: 600;
      border-radius: 50px;
      text-decoration: none;
      font-size: 15px;
      transition: all 0.3s ease;
    }
    
    .cta-btn-primary:hover {
      background: #00e05e;
      box-shadow: 0 0 20px rgba(0,199,82,0.4);
      transform: translateY(-2px);
    }
    
    .cta-btn-outline {
      padding: 15px 34px;
      background: transparent;
      color: #fff;
      border: 1px solid rgba(255,255,255,0.25);
      border-radius: 50px;
      text-decoration: none;
      font-size: 15px;
      transition: all 0.3s ease;
    }
    
    .cta-btn-outline:hover {
      border-color: #00c752;
      color: #00c752;
      background: rgba(0,199,82,0.05);
    }
    
    /* 底部小字备注 */
    .cta-tip {
      margin-top: 30px;
      font-size: 13px;
      color: rgba(255,255,255,0.5);
    }
    
    /* 移动端适配 */
    @media(max-width: 768px) {
      .page-final-cta {
        padding: 60px 20px;
      }
      .cta-title {
        font-size: 26px;
      }
      .cta-btn-group {
        flex-direction: column;
        align-items: center;
      }
      .cta-btn-primary,
      .cta-btn-outline {
        width: 100%;
        text-align: center;
      }
    }
    </style>
    </head>
    <body>
    
    <section class="page-final-cta">
      <div class="cta-line-top"></div>
      <div class="cta-inner">
        <p class="cta-subtitle">MARSTEK VENUS SERIE</p>
        <h2 class="cta-title">
          Machen Sie sich unabhängig von steigenden Strompreisen
        </h2>
        <p class="cta-desc">
          Steckerfertige Balkonkraftwerke &amp; Batteriespeicher – einfache Installation, intelligente Steuerung und langfristige Ersparnis. Starten Sie Ihre private Energiewende noch heute.
        </p>
        <div class="cta-btn-group">
          <a href="" class="cta-btn-primary">Jetzt Produkte entdecken</a>
          <a href="" class="cta-btn-outline">Beratung erhalten</a>
        </div>
        <p class="cta-tip">10 Jahre Garantie ✓ TÜV &amp; CE zertifiziert ✓ Kostenloser Support</p>
      </div>
    </section>
    
    </body>
    </html>
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-cta-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
    background: {{ block.settings.background_color }};
    position: relative;
  }

  .ai-footer-cta-glow-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 50% 0%, {{ block.settings.glow_color }}, transparent 60%);
    opacity: {{ block.settings.glow_opacity }};
    pointer-events: none;
  }

  .ai-footer-cta-line-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: {{ block.settings.line_width }}px;
    height: {{ block.settings.line_height }}px;
    background: {{ block.settings.line_color }};
    border-radius: {{ block.settings.line_height }}px;
    opacity: {{ block.settings.line_opacity }};
  }

  .ai-footer-cta-inner-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .ai-footer-cta-subtitle-{{ ai_gen_id }} {
    color: {{ block.settings.subtitle_color }};
    font-size: {{ block.settings.subtitle_size }}px;
    letter-spacing: {{ block.settings.subtitle_spacing }}px;
    text-transform: uppercase;
    margin-bottom: {{ block.settings.subtitle_margin }}px;
    opacity: {{ block.settings.subtitle_opacity }};
  }

  .ai-footer-cta-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    font-weight: {{ block.settings.title_weight }};
    line-height: {{ block.settings.title_line_height }};
    margin-bottom: {{ block.settings.title_margin }}px;
  }

  .ai-footer-cta-desc-{{ ai_gen_id }} {
    font-size: {{ block.settings.desc_size }}px;
    color: {{ block.settings.desc_color }};
    line-height: {{ block.settings.desc_line_height }};
    margin-bottom: {{ block.settings.desc_margin }}px;
    opacity: {{ block.settings.desc_opacity }};
  }

  .ai-footer-cta-buttons-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: {{ block.settings.button_gap }}px;
    flex-wrap: wrap;
  }

  .ai-footer-cta-btn-primary-{{ ai_gen_id }} {
    padding: {{ block.settings.button_padding_v }}px {{ block.settings.button_padding_h }}px;
    background: {{ block.settings.primary_bg }};
    color: {{ block.settings.primary_text }};
    font-weight: {{ block.settings.button_weight }};
    border-radius: {{ block.settings.button_radius }}px;
    text-decoration: none;
    font-size: {{ block.settings.button_size }}px;
    transition: all 0.3s ease;
    display: inline-block;
  }

  .ai-footer-cta-btn-primary-{{ ai_gen_id }}:hover {
    background: {{ block.settings.primary_hover_bg }};
    color: {{ block.settings.primary_hover_text }};
    {% if block.settings.enable_shadow %}
      box-shadow: 0 0 {{ block.settings.shadow_blur }}px {{ block.settings.shadow_color }};
    {% endif %}
    transform: translateY(-{{ block.settings.hover_lift }}px);
  }

  .ai-footer-cta-btn-outline-{{ ai_gen_id }} {
    padding: {{ block.settings.button_padding_v }}px {{ block.settings.button_padding_h }}px;
    background: {{ block.settings.outline_bg }};
    color: {{ block.settings.outline_text }};
    border: {{ block.settings.outline_border_width }}px solid {{ block.settings.outline_border }};
    border-radius: {{ block.settings.button_radius }}px;
    text-decoration: none;
    font-size: {{ block.settings.button_size }}px;
    transition: all 0.3s ease;
    display: inline-block;
  }

  .ai-footer-cta-btn-outline-{{ ai_gen_id }}:hover {
    border-color: {{ block.settings.outline_hover_border }};
    color: {{ block.settings.outline_hover_text }};
    background: {{ block.settings.outline_hover_bg }};
  }

  .ai-footer-cta-tip-{{ ai_gen_id }} {
    margin-top: {{ block.settings.tip_margin }}px;
    font-size: {{ block.settings.tip_size }}px;
    color: {{ block.settings.tip_color }};
    opacity: {{ block.settings.tip_opacity }};
  }

  @media screen and (max-width: 768px) {
    .ai-footer-cta-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_padding_top }}px 20px {{ block.settings.mobile_padding_bottom }}px;
    }

    .ai-footer-cta-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_title_size }}px;
    }

    .ai-footer-cta-buttons-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: center;
    }

    .ai-footer-cta-btn-primary-{{ ai_gen_id }},
    .ai-footer-cta-btn-outline-{{ ai_gen_id }} {
      width: 100%;
      text-align: center;
    }
  }
{% endstyle %}

<footer-cta-{{ ai_gen_id }} class="ai-footer-cta-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.enable_glow %}
    <div class="ai-footer-cta-glow-{{ ai_gen_id }}"></div>
  {% endif %}
  
  {% if block.settings.show_line %}
    <div class="ai-footer-cta-line-{{ ai_gen_id }}"></div>
  {% endif %}

  <div class="ai-footer-cta-inner-{{ ai_gen_id }}">
    {% if block.settings.subtitle != blank %}
      <p class="ai-footer-cta-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
    {% endif %}

    {% if block.settings.title != blank %}
      <h2 class="ai-footer-cta-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    {% endif %}

    {% if block.settings.description != blank %}
      <div class="ai-footer-cta-desc-{{ ai_gen_id }}">{{ block.settings.description }}</div>
    {% endif %}

    <div class="ai-footer-cta-buttons-{{ ai_gen_id }}">
      {% if block.settings.primary_text_label != blank %}
        <a href="{{ block.settings.primary_link }}" class="ai-footer-cta-btn-primary-{{ ai_gen_id }}">
          {{ block.settings.primary_text_label }}
        </a>
      {% endif %}

      {% if block.settings.outline_text_label != blank %}
        <a href="{{ block.settings.outline_link }}" class="ai-footer-cta-btn-outline-{{ ai_gen_id }}">
          {{ block.settings.outline_text_label }}
        </a>
      {% endif %}
    </div>

    {% if block.settings.tip != blank %}
      <div class="ai-footer-cta-tip-{{ ai_gen_id }}">{{ block.settings.tip }}</div>
    {% endif %}
  </div>
</footer-cta-{{ ai_gen_id }}>

