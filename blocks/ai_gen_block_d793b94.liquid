        "imageAlt": {% if max_image %}{{ max_image.alt | default: max_name | json }}{% else %}{{ max_name | json }}{% endif %},
        "imageWidth": {% if max_image %}{{ max_image.width | json }}{% else %}null{% endif %},
        "imageHeight": {% if max_image %}{{ max_image.height | json }}{% else %}null{% endif %}
