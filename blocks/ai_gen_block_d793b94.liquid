        "point1": {{ block.settings.product_3_point_1 | json }},
        "point2": {{ block.settings.product_3_point_2 | json }},
        "image": {% if product_3_image %}{{ product_3_image | image_url: width: 600 | json }}{% else %}""{% endif %},
        "imageAlt": {% if product_3_image %}{{ product_3_image.alt | default: product_3_name | json }}{% else %}{{ product_3_name | json }}{% endif %},
        "imageWidth": {% if product_3_image %}{{ product_3_image.width | json }}{% else %}null{% endif %},
        "imageHeight": {% if product_3_image %}{{ product_3_image.height | json }}{% else %}null{% endif %}
      },
      "4": {
        "name": {{ product_4_name | json }},
        "url": {{ product_4_url | default: '' | json }},
        "cta": {{ block.settings.product_4_cta | json }},
        "point1": {{ block.settings.product_4_point_1 | json }},
        "point2": {{ block.settings.product_4_point_2 | json }},
        "image": {% if product_4_image %}{{ product_4_image | image_url: width: 600 | json }}{% else %}""{% endif %},
        "imageAlt": {% if product_4_image %}{{ product_4_image.alt | default: product_4_name | json }}{% else %}{{ product_4_name | json }}{% endif %},
        "imageWidth": {% if product_4_image %}{{ product_4_image.width | json }}{% else %}null{% endif %},
        "imageHeight": {% if product_4_image %}{{ product_4_image.height | json }}{% else %}null{% endif %}
      },
