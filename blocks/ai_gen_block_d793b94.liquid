{% liquid
  assign ai_gen_id = block.id | replace: '_', '' | downcase

  assign overlay_left = block.settings.overlay_opacity_left | divided_by: 100.0
  assign overlay_middle = block.settings.overlay_opacity_middle | divided_by: 100.0
  assign overlay_right = block.settings.overlay_opacity_right | divided_by: 100.0
  assign overlay_mobile = block.settings.overlay_opacity_mobile | divided_by: 100.0

  assign mini_product = block.settings.mini_product
  assign product_3 = block.settings.product_3
  assign product_4 = block.settings.product_4
  assign max_product = block.settings.max_product

  assign mini_name = block.settings.mini_product_name | default: mini_product.title | default: 'VENUS E Mini'
  assign product_3_name = block.settings.product_3_name | default: product_3.title | default: 'VENUS E 3.0'
  assign product_4_name = block.settings.product_4_name | default: product_4.title | default: 'VENUS E 4.0'
  assign max_name = block.settings.max_product_name | default: max_product.title | default: 'VENUS E Max'

  assign mini_url = block.settings.mini_url
  if mini_url == blank and mini_product != blank
    assign mini_url = mini_product.url
  endif
  assign product_3_url = block.settings.product_3_url
  if product_3_url == blank and product_3 != blank
    assign product_3_url = product_3.url
  endif
  assign product_4_url = block.settings.product_4_url
  if product_4_url == blank and product_4 != blank
    assign product_4_url = product_4.url
  endif
  assign max_url = block.settings.max_url
  if max_url == blank and max_product != blank
    assign max_url = max_product.url
  endif

  assign mini_image = mini_product.featured_image
  assign product_3_image = product_3.featured_image
  assign product_4_image = product_4.featured_image
  assign max_image = max_product.featured_image
%}

{% style %}
  .ai-savings-calculator-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 24px;
    background: linear-gradient(110deg, #e8f7ff 0%, #d1eaff 100%);
    {% if block.settings.background_image != blank %}
      background-image:
        linear-gradient(
          90deg,
          {{ block.settings.overlay_color | color_modify: 'alpha', overlay_left }} 0%,
          {{ block.settings.overlay_color | color_modify: 'alpha', overlay_middle }} 45%,
          {{ block.settings.overlay_color | color_modify: 'alpha', overlay_right }} 75%
        ),
        url('{{ block.settings.background_image | image_url: width: 2400 }}');
      background-position: {{ block.settings.image_position }};
      background-size: cover;
      background-repeat: no-repeat;
    {% endif %}
  }

  .ai-savings-calculator-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(420px, 560px);
    align-items: center;
    gap: clamp(32px, 6vw, 88px);
    width: 100%;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-savings-text-column-{{ ai_gen_id }} {
    max-width: 620px;
  }

  .ai-savings-eyebrow-{{ ai_gen_id }} {
    margin: 0 0 22px;
    color: #48658d;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .ai-savings-heading-{{ ai_gen_id }} {
    margin: 0 0 18px;
    color: #0c1730;
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    line-height: 1.12;
  }

  .ai-savings-description-{{ ai_gen_id }} {
    margin: 0 0 32px;
    color: #4d658c;
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.65;
  }

  .ai-savings-description-{{ ai_gen_id }} p {
    margin: 0 0 10px;
  }

  .ai-savings-description-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-savings-feature-list-{{ ai_gen_id }} {
    display: grid;
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ai-savings-feature-item-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    color: #1d355d;
    font-size: {{ block.settings.feature_text_size }}px;
    line-height: 1.45;
  }

  .ai-savings-icon-wrapper-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    margin-top: 1px;
    border-radius: 50%;
    background: rgba(215, 239, 255, 0.9);
    color: #078be8;
  }

  .ai-savings-icon-wrapper-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .ai-savings-feature-content-{{ ai_gen_id }} {
    display: grid;
    gap: 2px;
    padding-top: 1px;
  }

  .ai-savings-feature-content-{{ ai_gen_id }} strong {
    color: #1d355d;
    font-weight: 700;
  }

  .ai-savings-feature-content-{{ ai_gen_id }} span {
    color: #4d658c;
  }

  .ai-savings-form-column-{{ ai_gen_id }} {
    width: 100%;
    padding: 30px;
    border: 1px solid rgba(226, 232, 240, 0.85);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.93);
    box-shadow: 0 18px 45px rgba(3, 63, 119, 0.12);
    backdrop-filter: blur(8px);
  }

  .ai-savings-form-{{ ai_gen_id }} {
    margin: 0;
  }

  .ai-savings-form-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin: 0 0 24px;
  }

  .ai-savings-form-heading-{{ ai_gen_id }} {
    margin: 0;
    color: #10172a;
    font-size: 25px;
    font-weight: 700;
    line-height: 1.2;
  }

  .ai-savings-form-helper-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #58709a;
    font-size: 13px;
    line-height: 1.4;
    text-align: right;
  }

  .ai-savings-form-helper-{{ ai_gen_id }} svg {
    width: 21px;
    height: 21px;
    flex: 0 0 21px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .ai-savings-input-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .ai-savings-form-group-{{ ai_gen_id }} {
    min-width: 0;
    margin: 0 0 20px;
  }

  .ai-savings-field-error-{{ ai_gen_id }} {
    display: none;
    margin: 6px 0 0;
    color: #b42318;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.4;
  }

  .ai-savings-field-error-{{ ai_gen_id }}[data-visible='true'] {
    display: block;
  }

  .ai-savings-form-label-{{ ai_gen_id }} {
    display: block;
    margin: 0 0 8px;
    color: #526b95;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
  }

  .ai-savings-form-input-{{ ai_gen_id }} {
    width: 100%;
    height: 52px;
    padding: 0 16px;
    border: 1px solid #dbe5f2;
    border-radius: 10px;
    outline: none;
    background: #ffffff;
    color: #17213a;
    font: inherit;
    font-size: 17px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .ai-savings-form-input-{{ ai_gen_id }}:focus {
    border-color: #0099fc;
    box-shadow: 0 0 0 3px rgba(0, 153, 252, 0.12);
  }

  .ai-savings-form-input-{{ ai_gen_id }}[aria-invalid='true'] {
    border-color: #b42318;
    background: #fff8f7;
    box-shadow: 0 0 0 3px rgba(180, 35, 24, 0.08);
  }

  .ai-savings-result-box-{{ ai_gen_id }} {
    width: 100%;
    margin: 0 0 18px;
    padding: 20px 22px;
    border-radius: 12px;
    background: linear-gradient(110deg, #098be8 0%, #20d7d0 100%);
    color: #ffffff;
  }

  .ai-savings-result-label-{{ ai_gen_id }} {
    display: block;
    margin-bottom: 4px;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
  }

  .ai-savings-result-amount-{{ ai_gen_id }} {
    display: block;
    font-size: {{ block.settings.result_amount_size }}px;
    font-weight: 700;
    line-height: 1.2;
  }

  .ai-savings-result-badge-{{ ai_gen_id }} {
    display: inline-flex;
    margin-top: 10px;
    padding: 7px 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    color: #143c5a;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.3;
  }

  .ai-savings-recommendation-{{ ai_gen_id }} {
    display: block;
    margin-top: 15px;
    padding-top: 13px;
    border-top: 1px solid rgba(255, 255, 255, 0.25);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.35;
  }

  .ai-savings-status-{{ ai_gen_id }} {
    display: none;
    margin-top: 8px;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.35;
  }

  .ai-savings-status-{{ ai_gen_id }}[data-visible='true'] {
    display: block;
  }

  .ai-savings-product-card-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 18px;
    align-items: center;
    margin: 0 0 18px;
    padding: 12px;
    border: 1px solid #dfe8f3;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.86);
  }

  .ai-savings-product-card-{{ ai_gen_id }}[hidden] {
    display: none;
  }

  .ai-savings-product-media-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 138px;
    overflow: hidden;
    border-radius: 10px;
    background: #edf5ff;
  }

  .ai-savings-product-media-{{ ai_gen_id }}[hidden] {
    display: none;
  }

  .ai-savings-product-media-{{ ai_gen_id }} img {
    display: block;
    width: 100%;
    height: 138px;
    object-fit: contain;
  }

  .ai-savings-product-content-{{ ai_gen_id }} {
    min-width: 0;
  }

  .ai-savings-product-name-{{ ai_gen_id }} {
    margin: 0 0 11px;
    color: #10172a;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.25;
  }

  .ai-savings-product-points-{{ ai_gen_id }} {
    display: grid;
    gap: 6px;
    margin: 0 0 16px;
    padding: 0;
    list-style: none;
  }

  .ai-savings-product-point-{{ ai_gen_id }} {
    position: relative;
    padding-left: 22px;
    color: #526b95;
    font-size: 14px;
    line-height: 1.35;
  }

  .ai-savings-product-point-{{ ai_gen_id }}::before {
    position: absolute;
    top: 0.18em;
    left: 0;
    width: 13px;
    height: 13px;
    border: 2px solid #178fe8;
    border-radius: 50%;
    content: '✓';
    color: #178fe8;
    font-size: 9px;
    font-weight: 700;
    line-height: 9px;
    text-align: center;
  }

  .ai-savings-product-point-{{ ai_gen_id }}[hidden] {
    display: none;
  }

  .ai-savings-cta-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 46px;
    padding: 11px 18px;
    border: 1px solid #078be8;
    border-radius: 9px;
    background: #078be8;
    color: #ffffff;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .ai-savings-cta-button-{{ ai_gen_id }}:hover {
    border-color: #0369a1;
    background: #0369a1;
    box-shadow: 0 5px 14px rgba(0, 105, 161, 0.18);
  }

  .ai-savings-cta-button-{{ ai_gen_id }}:focus-visible {
    outline: 2px solid #0099fc;
    outline-offset: 3px;
  }

  .ai-savings-cta-button-{{ ai_gen_id }}[aria-disabled='true'] {
    border-color: #b7c6d8;
    background: #b7c6d8;
    cursor: not-allowed;
  }

  .ai-savings-compare-link-{{ ai_gen_id }} {
    display: block;
    margin-top: 12px;
    color: #087ed0;
    font-size: 14px;
    font-weight: 600;
    text-align: center;
    text-underline-offset: 3px;
  }

  .ai-savings-info-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin: 18px 0 0;
    color: #60769b;
    font-size: 12px;
    line-height: 1.5;
  }

  .ai-savings-info-{{ ai_gen_id }} svg {
    width: 17px;
    height: 17px;
    flex: 0 0 17px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .ai-savings-disclaimer-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 20px auto 0;
    color: #596b82;
    font-size: 12px;
    line-height: 1.5;
    text-align: center;
  }

  .ai-savings-disclaimer-{{ ai_gen_id }} a {
    color: #0369a1;
    text-underline-offset: 3px;
  }

  @media screen and (max-width: 900px) {
    .ai-savings-calculator-{{ ai_gen_id }} {
      padding: 48px 20px;
      {% if block.settings.background_image != blank %}
        background-image:
          linear-gradient(
            {{ block.settings.overlay_color | color_modify: 'alpha', overlay_mobile }} 0%,
            {{ block.settings.overlay_color | color_modify: 'alpha', overlay_mobile }} 100%
          ),
          url('{{ block.settings.background_image | image_url: width: 1600 }}');
      {% endif %}
    }

    .ai-savings-calculator-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 32px;
      max-width: 680px;
    }

    .ai-savings-text-column-{{ ai_gen_id }} {
      max-width: none;
    }

    .ai-savings-form-column-{{ ai_gen_id }} {
      max-width: 600px;
      margin: 0 auto;
    }
  }

  @media screen and (max-width: 520px) {
    .ai-savings-calculator-{{ ai_gen_id }} {
      padding: 40px 16px;
    }

    .ai-savings-heading-{{ ai_gen_id }} {
      font-size: 34px;
    }

    .ai-savings-form-column-{{ ai_gen_id }} {
      padding: 22px 18px;
      border-radius: 14px;
    }

    .ai-savings-form-header-{{ ai_gen_id }} {
      display: block;
      margin-bottom: 20px;
    }

    .ai-savings-form-helper-{{ ai_gen_id }} {
      margin-top: 9px;
      text-align: left;
    }

    .ai-savings-input-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .ai-savings-product-card-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-savings-product-media-{{ ai_gen_id }} {
      min-height: 170px;
    }

    .ai-savings-product-media-{{ ai_gen_id }} img {
      height: 170px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-savings-form-input-{{ ai_gen_id }},
    .ai-savings-cta-button-{{ ai_gen_id }} {
      transition: none;
    }
  }
{% endstyle %}

<savings-calculator-{{ ai_gen_id }}
  class="ai-savings-calculator-{{ ai_gen_id }}"
  data-electricity-price="{{ block.settings.electricity_price }}"
  data-annual-sun-hours="{{ block.settings.annual_sun_hours }}"
  data-baseline-self-use="{{ block.settings.baseline_self_use_rate }}"
  data-storage-self-use="{{ block.settings.storage_self_use_rate }}"
  data-bonus-factor="{{ block.settings.bonus_factor }}"
  data-pv-mini-max="{{ block.settings.pv_mini_max }}"
  data-pv-3-max="{{ block.settings.pv_3_max }}"
  data-pv-4-max="{{ block.settings.pv_4_max }}"
  data-bill-mini-max="{{ block.settings.bill_mini_max }}"
  data-bill-3-max="{{ block.settings.bill_3_max }}"
  data-bill-4-max="{{ block.settings.bill_4_max }}"
  data-result-empty="{{ block.settings.currency_symbol | append: ' ' | append: block.settings.result_period | escape }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-savings-calculator-container-{{ ai_gen_id }}">
    <div class="ai-savings-text-column-{{ ai_gen_id }}">
      {% if block.settings.eyebrow != blank %}
        <p class="ai-savings-eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow }}</p>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h2 class="ai-savings-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-savings-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}

      <ul class="ai-savings-feature-list-{{ ai_gen_id }}">
        {% for feature_index in (1..3) %}
          {% assign feature_title_key = 'feature_' | append: feature_index | append: '_title' %}
          {% assign feature_text_key = 'feature_' | append: feature_index | append: '_text' %}
          {% assign legacy_feature_key = 'feature_' | append: feature_index %}
          {% assign feature_title = block.settings[feature_title_key] | default: block.settings[legacy_feature_key] %}
          {% assign feature_text = block.settings[feature_text_key] %}
          {% if feature_title != blank or feature_text != blank %}
            <li class="ai-savings-feature-item-{{ ai_gen_id }}">
              <span class="ai-savings-icon-wrapper-{{ ai_gen_id }}" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              </span>
              <span class="ai-savings-feature-content-{{ ai_gen_id }}">
                {% if feature_title != blank %}<strong>{{ feature_title }}</strong>{% endif %}
                {% if feature_text != blank %}<span>{{ feature_text }}</span>{% endif %}
              </span>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>

    <div class="ai-savings-form-column-{{ ai_gen_id }}">
      <form class="ai-savings-form-{{ ai_gen_id }}" data-calculator-form novalidate>
        <div class="ai-savings-form-header-{{ ai_gen_id }}">
          {% if block.settings.form_heading != blank %}
            <h3 class="ai-savings-form-heading-{{ ai_gen_id }}">{{ block.settings.form_heading }}</h3>
          {% endif %}
          {% if block.settings.form_helper != blank %}
            <span class="ai-savings-form-helper-{{ ai_gen_id }}">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
              {{ block.settings.form_helper }}
            </span>
          {% endif %}
        </div>

        <div class="ai-savings-input-grid-{{ ai_gen_id }}">
          <div class="ai-savings-form-group-{{ ai_gen_id }}">
            <label for="ai-savings-cost-{{ ai_gen_id }}" class="ai-savings-form-label-{{ ai_gen_id }}">
              {{ block.settings.label_monthly_cost }}
            </label>
            <input
              type="text"
              id="ai-savings-cost-{{ ai_gen_id }}"
              class="ai-savings-form-input-{{ ai_gen_id }}"
              value="{{ block.settings.default_monthly_cost }}"
              inputmode="decimal"
              autocomplete="off"
              data-input="cost"
              aria-describedby="ai-savings-cost-error-{{ ai_gen_id }}"
            >
            <span
              id="ai-savings-cost-error-{{ ai_gen_id }}"
              class="ai-savings-field-error-{{ ai_gen_id }}"
              data-error="cost"
              data-visible="false"
              role="alert"
            ></span>
          </div>

          <div class="ai-savings-form-group-{{ ai_gen_id }}">
            <label for="ai-savings-pv-{{ ai_gen_id }}" class="ai-savings-form-label-{{ ai_gen_id }}">
              {{ block.settings.label_pv_power }}
            </label>
            <input
              type="text"
              id="ai-savings-pv-{{ ai_gen_id }}"
              class="ai-savings-form-input-{{ ai_gen_id }}"
              value="{{ block.settings.default_pv_power }}"
              inputmode="decimal"
              autocomplete="off"
              data-input="pv"
              aria-describedby="ai-savings-pv-error-{{ ai_gen_id }}"
            >
            <span
              id="ai-savings-pv-error-{{ ai_gen_id }}"
              class="ai-savings-field-error-{{ ai_gen_id }}"
              data-error="pv"
              data-visible="false"
              role="alert"
            ></span>
          </div>
        </div>

        <div class="ai-savings-result-box-{{ ai_gen_id }}" aria-live="polite">
          <span class="ai-savings-result-label-{{ ai_gen_id }}">{{ block.settings.result_label }}</span>
          <span class="ai-savings-result-amount-{{ ai_gen_id }}" data-result></span>
          {% if block.settings.result_badge != blank %}
            <span class="ai-savings-result-badge-{{ ai_gen_id }}">{{ block.settings.result_badge }}</span>
          {% endif %}
          <span class="ai-savings-recommendation-{{ ai_gen_id }}" data-recommendation></span>
          <span class="ai-savings-status-{{ ai_gen_id }}" data-status data-visible="false"></span>
        </div>

        <div class="ai-savings-product-card-{{ ai_gen_id }}" data-recommendation-card hidden>
          <div class="ai-savings-product-media-{{ ai_gen_id }}" data-product-image-wrap hidden>
            <img
              data-product-image
              {% if mini_image %}src="{{ mini_image | image_url: width: 600 }}"{% endif %}
              alt=""
              loading="lazy"
              width="600"
              height="600"
            >
          </div>
          <div class="ai-savings-product-content-{{ ai_gen_id }}">
            <h4 class="ai-savings-product-name-{{ ai_gen_id }}" data-product-name></h4>
            <ul class="ai-savings-product-points-{{ ai_gen_id }}">
              <li class="ai-savings-product-point-{{ ai_gen_id }}" data-product-point="1"></li>
              <li class="ai-savings-product-point-{{ ai_gen_id }}" data-product-point="2"></li>
            </ul>
