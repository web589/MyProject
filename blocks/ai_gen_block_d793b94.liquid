</savings-calculator-{{ ai_gen_id }}>

<script>
  (function() {
    class SavingsCalculator{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        if (this.dataset.initialized === 'true') return;
        this.dataset.initialized = 'true';

        this.costInput = this.querySelector('[data-input="cost"]');
        this.pvInput = this.querySelector('[data-input="pv"]');
        this.resultDisplay = this.querySelector('[data-result]');
        this.recommendationDisplay = this.querySelector('[data-recommendation]');
        this.costError = this.querySelector('[data-error="cost"]');
        this.pvError = this.querySelector('[data-error="pv"]');
        this.statusDisplay = this.querySelector('[data-status]');
        this.recommendationCard = this.querySelector('[data-recommendation-card]');
        this.productImageWrap = this.querySelector('[data-product-image-wrap]');
        this.productImage = this.querySelector('[data-product-image]');
        this.productName = this.querySelector('[data-product-name]');
        this.productCta = this.querySelector('[data-product-cta]');
        this.productPoints = [
          this.querySelector('[data-product-point="1"]'),
          this.querySelector('[data-product-point="2"]')
        ];

        const dataElement = this.querySelector('[data-recommendation-data]');
        try {
          this.recommendations = JSON.parse(dataElement ? dataElement.textContent : '{}');
        } catch (error) {
          this.recommendations = {};
        }

        this.electricityPrice = this.readNumber(this.dataset.electricityPrice, 0.4);
        this.annualSunHours = this.readNumber(this.dataset.annualSunHours, 1000);
        this.baselineSelfUse = this.readNumber(this.dataset.baselineSelfUse, 0.3);
        this.storageSelfUse = this.readNumber(this.dataset.storageSelfUse, 0.8);
        this.bonusFactor = this.readNumber(this.dataset.bonusFactor, 1.15);
        this.pvThresholds = this.getThresholds(
          [
            this.readNumber(this.dataset.pvMiniMax, Number.NaN),
            this.readNumber(this.dataset.pv3Max, Number.NaN),
            this.readNumber(this.dataset.pv4Max, Number.NaN)
          ],
          [2.5, 4.5, 6.5]
        );
        this.billThresholds = this.getThresholds(
          [
            this.readNumber(this.dataset.billMiniMax, Number.NaN),
            this.readNumber(this.dataset.bill3Max, Number.NaN),
            this.readNumber(this.dataset.bill4Max, Number.NaN)
          ],
          [90, 130, 180]
        );
        this.currencySymbol = {{ block.settings.currency_symbol | json }};
        this.resultPeriod = {{ block.settings.result_period | json }};
        this.emptyResult = this.dataset.resultEmpty || '€ / Jahr';
        this.recommendationPrefix = {{ block.settings.recommendation_prefix | json }};

        if (!this.costInput || !this.pvInput || !this.resultDisplay || !this.recommendationDisplay || !this.costError || !this.pvError || !this.statusDisplay) return;

        this.costInput.addEventListener('input', () => this.calculate());
        this.pvInput.addEventListener('input', () => this.calculate());
        this.calculate();
      }

      readNumber(value, fallback) {
        const number = Number(value);
        return Number.isFinite(number) ? number : fallback;
      }

      getThresholds(values, fallback) {
        if (values.every((value) => Number.isFinite(value)) && values[0] < values[1] && values[1] < values[2]) {
          return values;
        }
        return fallback;
      }

      parseNumber(value) {
        let normalized = String(value).trim().replace(/\s/g, '');
        if (normalized === '') return Number.NaN;

        const commaIndex = normalized.lastIndexOf(',');
        const dotIndex = normalized.lastIndexOf('.');
        if (commaIndex > -1 && dotIndex > -1) {
          if (commaIndex > dotIndex) {
            normalized = normalized.replace(/\./g, '').replace(',', '.');
          } else {
            normalized = normalized.replace(/,/g, '');
          }
        } else if (commaIndex > -1) {
          normalized = normalized.replace(',', '.');
        }

        const parsed = Number(normalized);
        return Number.isFinite(parsed) ? parsed : Number.NaN;
      }

      setFieldError(input, errorElement, message) {
        const hasError = message !== '';
        input.setAttribute('aria-invalid', String(hasError));
        errorElement.textContent = message;
        errorElement.dataset.visible = String(hasError);
      }

      setStatus(message) {
        this.statusDisplay.textContent = message;
        this.statusDisplay.dataset.visible = String(message !== '');
      }

      setEmptyResult() {
        this.resultDisplay.textContent = this.emptyResult;
        this.recommendationDisplay.textContent = '';
        if (this.recommendationCard) this.recommendationCard.hidden = true;
        this.clearProductCta();
      }

      clearProductCta() {
        if (!this.productCta) return;
        this.productCta.removeAttribute('href');
        this.productCta.setAttribute('aria-disabled', 'true');
        this.productCta.setAttribute('tabindex', '-1');
      }

      getTier(value, thresholds) {
        if (value <= thresholds[0]) return 0;
        if (value <= thresholds[1]) return 1;
        if (value <= thresholds[2]) return 2;
        return 3;
      }

      formatResult(value) {
        const formattedValue = new Intl.NumberFormat('de-DE', {
          maximumFractionDigits: 0
        }).format(value);
        return (this.currencySymbol || '') + formattedValue + (this.resultPeriod ? ' ' + this.resultPeriod : '');
      }

      updateRecommendation(tier) {
        const tierKeys = ['mini', '3', '4', 'max'];
        const recommendation = this.recommendations[tierKeys[tier]];
        if (!recommendation) {
          this.setEmptyResult();
          return;
        }

        this.recommendationDisplay.textContent = [this.recommendationPrefix, recommendation.name]
          .filter((value) => value && value.trim())
          .join(' ');

        if (!this.recommendationCard) return;
        this.recommendationCard.hidden = false;

        if (this.productName) this.productName.textContent = recommendation.name || '';

        this.productPoints.forEach((pointElement, index) => {
          if (!pointElement) return;
          const point = index === 0 ? recommendation.point1 : recommendation.point2;
          pointElement.textContent = point || '';
          pointElement.hidden = !point;
        });

        if (this.productImage && this.productImageWrap) {
          if (recommendation.image) {
            this.productImage.src = recommendation.image;
            this.productImage.alt = recommendation.imageAlt || recommendation.name || '';
            if (recommendation.imageWidth) this.productImage.width = recommendation.imageWidth;
            if (recommendation.imageHeight) this.productImage.height = recommendation.imageHeight;
            this.productImageWrap.hidden = false;
          } else {
            this.productImage.removeAttribute('src');
            this.productImage.alt = '';
            this.productImageWrap.hidden = true;
          }
        }

        if (this.productCta) {
          this.productCta.textContent = recommendation.cta || '';
          if (recommendation.url) {
            this.productCta.href = recommendation.url;
            this.productCta.setAttribute('aria-disabled', 'false');
            this.productCta.setAttribute('tabindex', '0');
          } else {
            this.clearProductCta();
          }
        }
      }

      calculate() {
        const monthlyBill = this.parseNumber(this.costInput.value);
        const pvPower = this.parseNumber(this.pvInput.value);
        const billInvalid = !Number.isFinite(monthlyBill) || monthlyBill <= 0;
        const pvInvalid = !Number.isFinite(pvPower) || pvPower < 0;
        const noPvInstalled = Number.isFinite(pvPower) && pvPower === 0;

        this.setFieldError(
          this.costInput,
          this.costError,
          billInvalid ? {{ block.settings.bill_error_message | json }} : ''
        );
        this.setFieldError(
          this.pvInput,
          this.pvError,
          noPvInstalled
            ? {{ block.settings.no_pv_message | json }}
            : (pvInvalid ? {{ block.settings.pv_error_message | json }} : '')
        );

        if (billInvalid || pvInvalid || noPvInstalled) {
          this.setEmptyResult();
          this.setStatus(noPvInstalled
            ? {{ block.settings.no_pv_message | json }}
            : {{ block.settings.invalid_message | json }}
          );
          return;
        }

        const annualUse = (monthlyBill / this.electricityPrice) * 12;
        const annualPvYield = pvPower * this.annualSunHours;
        if (annualPvYield === 0) {
          this.setEmptyResult();
          this.setStatus({{ block.settings.no_pv_message | json }});
          return;
        }

        const rateWasAdjusted = this.storageSelfUse < this.baselineSelfUse;
        const effectiveStorageSelfUse = rateWasAdjusted
          ? this.baselineSelfUse + 0.3
          : this.storageSelfUse;
        const baselineEnergy = Math.min(annualPvYield * this.baselineSelfUse, annualUse);
        const storageEnergy = Math.min(annualPvYield * effectiveStorageSelfUse, annualUse);
        const extraSelfUse = Math.max(0, storageEnergy - baselineEnergy);
        const yearlySaving = Math.max(0, Math.round(extraSelfUse * this.electricityPrice * this.bonusFactor));

        const pvTier = this.getTier(pvPower, this.pvThresholds);
        const billTier = this.getTier(monthlyBill, this.billThresholds);
        const recommendedTier = Math.min(pvTier, billTier);

        this.resultDisplay.textContent = this.formatResult(yearlySaving);
        this.updateRecommendation(recommendedTier);
        this.setStatus(rateWasAdjusted ? {{ block.settings.rate_adjustment_message | json }} : '');
      }
    }

    if (!customElements.get('savings-calculator-{{ ai_gen_id }}')) {
      customElements.define('savings-calculator-{{ ai_gen_id }}', SavingsCalculator{{ ai_gen_id }});
    }
  })();
</script>

