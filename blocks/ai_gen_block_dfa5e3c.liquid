{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-custom-blog-section-{{ ai_gen_id }} {
    display: block;
    max-width: 1280px;
    margin: 0 auto;
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    width: {{ block.settings.desktop_width_percent }}%;
  }

  .ai-custom-blog-header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: {% if block.settings.subtitle != blank %}flex-start{% else %}center{% endif %};
    margin-bottom: 32px;
  }

  .ai-custom-blog-heading-group-{{ ai_gen_id }} {
    min-width: 0;
  }

  .ai-custom-blog-title-{{ ai_gen_id }} {
    font-size: clamp(1.5rem, 2.5vw, {{ block.settings.heading_size }}px);
    font-weight: 700;
    color: {{ block.settings.heading_color }};
    margin: 0;
  }

  .ai-custom-blog-subtitle-{{ ai_gen_id }} {
    margin: 8px 0 0;
    color: #596b82;
    font-size: 16px;
    line-height: 1.5;
    max-width: 760px;
  }

  .ai-custom-blog-subtitle-{{ ai_gen_id }} p {
    margin: 0;
  }

  .ai-custom-blog-all-link-{{ ai_gen_id }} {
    font-size: {{ block.settings.link_size }}px;
    color: {{ block.settings.link_color }};
    text-decoration: none;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .ai-custom-blog-all-link-{{ ai_gen_id }}:hover {
    color: #007dcc;
  }

  .ai-custom-blog-arrow-{{ ai_gen_id }} {
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
    transition: transform 0.2s ease;
  }

  .ai-custom-blog-all-link-{{ ai_gen_id }}:hover .ai-custom-blog-arrow-{{ ai_gen_id }},
  .ai-custom-blog-all-link-{{ ai_gen_id }}:focus-visible .ai-custom-blog-arrow-{{ ai_gen_id }} {
    transform: translateX(3px);
  }

  .ai-custom-blog-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    align-items: start;
  }

  .ai-custom-blog-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border: 1px solid #dfe6ee;
    box-shadow: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  {% if block.settings.enable_card_hover %}
    .ai-custom-blog-card-{{ ai_gen_id }}:hover,
    .ai-custom-blog-card-{{ ai_gen_id }}:focus-within {
      border-color: #0099fe;
      box-shadow: 0 8px 24px rgba(0, 153, 254, 0.1);
    }
  {% endif %}

  .ai-custom-blog-card-image-{{ ai_gen_id }} {
    width: 100%;
    height: 0;
    padding-bottom: {{ block.settings.image_aspect_ratio }}%;
    position: relative;
    background-color: #e9eef4;
  }

  .ai-custom-blog-card-image-{{ ai_gen_id }} img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-custom-blog-card-image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #e9eef4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-custom-blog-card-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-custom-blog-card-source-{{ ai_gen_id }} {
    padding: 10px {{ block.settings.card_padding }}px 0;
    color: {{ block.settings.tag_color }};
    font-size: {{ block.settings.tag_size }}px;
    font-weight: 600;
    line-height: 1.3;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-custom-blog-card-content-{{ ai_gen_id }} {
    padding: 8px {{ block.settings.card_padding }}px {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .ai-custom-blog-card-tag-{{ ai_gen_id }} {
    font-size: {{ block.settings.tag_size }}px;
    font-weight: 600;
    color: {{ block.settings.tag_color }};
    background: {{ block.settings.tag_background }};
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 10px;
    padding: 5px 9px;
    border-radius: 999px;
    align-self: flex-start;
    text-decoration: none;
  }

  .ai-custom-blog-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: 700;
    color: {{ block.settings.card_title_color }};
    margin-bottom: 12px;
    line-height: 1.4;
  }

  .ai-custom-blog-card-title-{{ ai_gen_id }} a {
    color: inherit;
    text-decoration: none;
  }

  .ai-custom-blog-card-title-{{ ai_gen_id }} a:hover {
    color: #0099fe;
  }

  .ai-custom-blog-card-excerpt-{{ ai_gen_id }} {
    font-size: {{ block.settings.excerpt_size }}px;
    color: {{ block.settings.excerpt_color }};
    line-height: 1.5;
    margin-bottom: 16px;
    flex-grow: 1;
  }

  .ai-custom-blog-card-link-{{ ai_gen_id }} {
    font-size: {{ block.settings.read_more_size }}px;
    font-weight: 600;
    color: {{ block.settings.read_more_color }};
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .ai-custom-blog-card-link-{{ ai_gen_id }}:hover {
    color: #0099fe;
  }

  {% if block.settings.enable_card_hover %}
    .ai-custom-blog-card-{{ ai_gen_id }}:hover .ai-custom-blog-card-title-{{ ai_gen_id }} a,
    .ai-custom-blog-card-{{ ai_gen_id }}:hover .ai-custom-blog-card-link-{{ ai_gen_id }},
    .ai-custom-blog-card-{{ ai_gen_id }}:focus-within .ai-custom-blog-card-title-{{ ai_gen_id }} a,
    .ai-custom-blog-card-{{ ai_gen_id }}:focus-within .ai-custom-blog-card-link-{{ ai_gen_id }} {
      color: #0099fe;
    }
  {% endif %}

  .ai-custom-blog-card-link-{{ ai_gen_id }}:hover .ai-custom-blog-arrow-{{ ai_gen_id }},
  .ai-custom-blog-card-link-{{ ai_gen_id }}:focus-visible .ai-custom-blog-arrow-{{ ai_gen_id }} {
    transform: translateX(3px);
  }

  .ai-custom-blog-empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #999;
    font-size: 16px;
  }

  @media screen and (max-width: 1024px) {
    .ai-custom-blog-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 640px) {
    .ai-custom-blog-header-{{ ai_gen_id }} {
      align-items: {% if block.settings.subtitle != blank %}flex-start{% else %}flex-end{% endif %};
      gap: 12px;
    }

    .ai-custom-blog-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }
  }
{% endstyle %}

{% liquid
  assign blog_one = blogs[block.settings.blog_1]
  assign blog_two = blogs[block.settings.blog_2]
  assign blog_three = blogs[block.settings.blog_3]
  assign post_limit = block.settings.post_limit | default: 4
  assign article_count = 0

  if blog_one != blank
    assign all_articles = blog_one.articles
    if blog_two != blank and blog_two != blog_one
      assign all_articles = all_articles | concat: blog_two.articles
    endif
    if blog_three != blank and blog_three != blog_one and blog_three != blog_two
      assign all_articles = all_articles | concat: blog_three.articles
    endif
  elsif blog_two != blank
    assign all_articles = blog_two.articles
    if blog_three != blank and blog_three != blog_two
      assign all_articles = all_articles | concat: blog_three.articles
    endif
  elsif blog_three != blank
    assign all_articles = blog_three.articles
  endif

  if all_articles != blank
    assign all_articles = all_articles | sort: 'updated_at' | reverse
  endif
%}

<custom-blog-section-{{ ai_gen_id }} class="ai-custom-blog-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-custom-blog-header-{{ ai_gen_id }}">
    <div class="ai-custom-blog-heading-group-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-custom-blog-title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.subtitle != blank %}
        <div class="ai-custom-blog-subtitle-{{ ai_gen_id }} rte">{{ block.settings.subtitle }}</div>
      {% endif %}
    </div>
    {% if block.settings.show_view_all %}
      <a href="{{ routes.search_url }}?q=&type=article" class="ai-custom-blog-all-link-{{ ai_gen_id }}">
        {{ block.settings.view_all_text | escape }}
        <svg class="ai-custom-blog-arrow-{{ ai_gen_id }}" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M4 10h11m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    {% endif %}
  </div>

  <div class="ai-custom-blog-grid-{{ ai_gen_id }}">
    {% if all_articles != blank %}
      {% for article in all_articles limit: post_limit %}
        {% liquid
          assign article_count = article_count | plus: 1
          assign article_blog_handle = article.url | split: '/blogs/' | last | split: '/' | first
          assign article_blog = blogs[article_blog_handle]
          assign article_blog_title = article_blog.title | default: article_blog_handle
          assign article_tag = article.tags | first
          assign article_excerpt = article.excerpt_or_content | strip_html | truncatewords: 24
        %}

        <article
          class="ai-custom-blog-card-{{ ai_gen_id }}"
        >
          <div class="ai-custom-blog-card-image-{{ ai_gen_id }}">
            {% if article.image != blank %}
              <img
                src="{{ article.image | image_url: width: 800 }}"
                alt="{{ article.image.alt | default: article.title | escape }}"
                loading="lazy"
                width="800"
                height="{{ 800 | times: block.settings.image_aspect_ratio | divided_by: 100 }}"
              >
            {% else %}
              <div class="ai-custom-blog-card-image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          {% if article_blog_title != blank %}
            <div class="ai-custom-blog-card-source-{{ ai_gen_id }}">
              {{ article_blog_title | escape }}
            </div>
          {% endif %}

          <div class="ai-custom-blog-card-content-{{ ai_gen_id }}">
            {% if block.settings.show_article_badge and article_tag != blank %}
              <span class="ai-custom-blog-card-tag-{{ ai_gen_id }}">
                {{ article_tag | escape }}
              </span>
            {% endif %}

            <h3 class="ai-custom-blog-card-title-{{ ai_gen_id }}">
              <a href="{{ article.url }}">{{ article.title | escape }}</a>
            </h3>

            <div class="ai-custom-blog-card-excerpt-{{ ai_gen_id }}">
              {{ article_excerpt | escape | newline_to_br }}
            </div>

            {% if block.settings.show_read_more %}
              <a href="{{ article.url }}" class="ai-custom-blog-card-link-{{ ai_gen_id }}">
                {{ block.settings.read_more_text | escape }}
                <svg class="ai-custom-blog-arrow-{{ ai_gen_id }}" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M4 10h11m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    {% endif %}

    {% if article_count == 0 %}
      <div class="ai-custom-blog-empty-state-{{ ai_gen_id }}">
        Keine Blogartikel verfügbar.
      </div>
    {% endif %}
  </div>
</custom-blog-section-{{ ai_gen_id }}>

