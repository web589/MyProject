{% doc %}
  @prompt
    <!DOCTYPE html>
    <html lang="de">
    <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blog / Inhaltsmarketing Eingang</title>
    <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    
    body {
      background-color: #f7f7f7;
      padding: 60px 20px;
    }
    
    .blog-section {
      max-width: 1280px;
      margin: 0 auto;
    }
    
    /* 头部 */
    .blog-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 32px;
    }
    
    .blog-title {
      font-size: clamp(1.5rem, 2.5vw, 2rem);
      font-weight: 700;
      color: #111;
    }
    
    .blog-all-link {
      font-size: 0.95rem;
      color: #111;
