      font-weight: 600;
    }
    
    .blog-all-link:hover {
      text-decoration: underline;
    }
    
    /* 卡片网格 */
    .blog-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }
    
    /* 单张卡片 */
    .blog-card {
      background-color: #fff;
      border-radius: 16px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    
    /* 图片区域，预留位置 */
    .blog-card-image {
      width: 100%;
      height: 0;
      padding-bottom: 66%;
      position: relative;
      background-color: #f0f4f8;
    }
    
    .blog-card-image img {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    
    /* 内容区域 */
    .blog-card-content {
      padding: 20px;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }
    
    .blog-card-tag {
      font-size: 0.75rem;
      font-weight: 600;
      color: #666;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 10px;
    }
    
    .blog-card-title {
      font-size: 1.1rem;
      font-weight: 700;
      color: #111;
      margin-bottom: 12px;
      line-height: 1.4;
    }
    
    .blog-card-excerpt {
      font-size: 0.9rem;
      color: #666;
      line-height: 1.5;
      margin-bottom: 16px;
      flex-grow: 1;
    }
    
    .blog-card-link {
      font-size: 0.9rem;
      font-weight: 600;
      color: #111;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    
    .blog-card-link:hover {
      text-decoration: underline;
    }
    
    /* 移动端适配 */
    @media (max-width: 1024px) {
      .blog-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    
    @media (max-width: 640px) {
      .blog-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
      }
    
      .blog-grid {
        grid-template-columns: 1fr;
      }
    }
    </style>
    </head>
    <body>
    
