{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-grid-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background: {{ block.settings.section_bg_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-product-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
    padding: 0 {{ block.settings.side_padding }}px;
  }

  .ai-section-title-wrap-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 48px;
  }

  .ai-section-tag-{{ ai_gen_id }} {
    font-size: 16px;
    color: {{ block.settings.tag_color }};
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0 0 12px;
  }

  .ai-section-main-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.main_title_size }}px;
    font-weight: 800;
    color: {{ block.settings.title_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-product-grid-wrap-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-product-card-{{ ai_gen_id }} {
    position: relative;
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .ai-product-bg-img-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .ai-product-card-{{ ai_gen_id }}:hover .ai-product-bg-img-{{ ai_gen_id }} {
    transform: scale(1.03);
  }

  .ai-product-bg-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-bg-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-product-content-wrap-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60%;
    padding: 20px 0;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-height: 40%;
  }

  .ai-product-top-slogan-{{ ai_gen_id }} {
    font-size: {{ block.settings.slogan_size }}px;
    color: {{ block.settings.slogan_color }};
    font-weight: 600;
    margin: 0 0 8px;
    letter-spacing: 0.5px;
  }

  .ai-product-model-title-{{ ai_gen_id }} {
    font-size: 20px;
    font-weight: 800;
    color: {{ block.settings.model_title_color }};
    line-height: 1.2;
    margin: 0 0 6px;
    white-space: nowrap;
    overflow: hidden;
  }

  .ai-product-new-tag-{{ ai_gen_id }} {
    display: inline-block;
    background: {{ block.settings.new_tag_bg }};
    color: {{ block.settings.new_tag_text }};
    font-size: 9px;
    font-weight: 700;
    padding: 2px 5px;
    border-radius: 3px;
    margin-left: 5px;
    vertical-align: top;
  }

  .ai-product-desc-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.desc_text_size }}px;
    color: {{ block.settings.desc_color }};
    opacity: 0.92;
    margin: 0 0 12px;
    line-height: 1.5;
  }

  .ai-price-line-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
    align-items: center;
    margin: 0 0 14px;
  }

  .ai-old-price-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.old_price_size }}px;
    color: #cccccc;
    text-decoration: line-through;
  }

  .ai-new-price-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.new_price_size }}px;
    font-weight: 600;
    color: {{ block.settings.new_price_color }};
  }

  .ai-product-btn-group-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: nowrap;
  }

  .ai-btn-primary-shop-{{ ai_gen_id }} {
    padding: {{ block.settings.btn_padding_y }}px {{ block.settings.btn_padding_x }}px;
    background-color: {{ block.settings.primary_btn_bg }};
    color: {{ block.settings.primary_btn_text }};
    border: none;
    border-radius: {{ block.settings.btn_border_radius }}px;
    font-weight: 600;
    font-size: {{ block.settings.btn_font_size }}px;
    text-decoration: none;
    transition: all 0.25s ease;
    white-space: nowrap;
    cursor: pointer;
  }

  .ai-btn-primary-shop-{{ ai_gen_id }}:hover {
    filter: brightness(0.9);
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(0, 198, 255, 0.2);
  }

  .ai-btn-secondary-info-{{ ai_gen_id }} {
    padding: {{ block.settings.btn_padding_y }}px {{ block.settings.btn_padding_x }}px;
    background: transparent;
    color: {{ block.settings.secondary_btn_text }};
    border: 2px solid {{ block.settings.secondary_btn_border }};
    border-radius: {{ block.settings.btn_border_radius }}px;
    font-weight: 600;
    font-size: {{ block.settings.btn_font_size }}px;
    text-decoration: none;
    transition: all 0.25s ease;
    white-space: nowrap;
    cursor: pointer;
  }

  .ai-btn-secondary-info-{{ ai_gen_id }}:hover {
    background-color: rgba(0, 198, 255, 0.08);
    transform: translateY(-2px);
  }

  {% if block.settings.btn_size == 'small' %}
    .ai-btn-primary-shop-{{ ai_gen_id }},
    .ai-btn-secondary-info-{{ ai_gen_id }} {
      padding: 10px 20px;
      font-size: 13px;
    }
  {% elsif block.settings.btn_size == 'large' %}
    .ai-btn-primary-shop-{{ ai_gen_id }},
    .ai-btn-secondary-info-{{ ai_gen_id }} {
      padding: 20px 40px;
      font-size: 18px;
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    .ai-product-grid-wrap-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-section-main-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.main_title_size | times: 0.7 }}px;
    }

    .ai-product-content-wrap-{{ ai_gen_id }} {
      width: 80%;
    }

    .ai-product-btn-group-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 8px;
    }
  }
{% endstyle %}

<product-grid-{{ ai_gen_id }} class="ai-product-grid-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-container-{{ ai_gen_id }}">
    {% if block.settings.section_tag != blank or block.settings.section_title != blank %}
      <div class="ai-section-title-wrap-{{ ai_gen_id }}">
        {% if block.settings.section_tag != blank %}
          <div class="ai-section-tag-{{ ai_gen_id }}">{{ block.settings.section_tag }}</div>
        {% endif %}
        {% if block.settings.section_title != blank %}
          <h2 class="ai-section-main-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-product-grid-wrap-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign product_key = 'product_' | append: i
          assign slogan_key = 'product_' | append: i | append: '_slogan'
          assign desc_key = 'product_' | append: i | append: '_desc'
          assign old_price_key = 'product_' | append: i | append: '_old_price'
          assign new_price_key = 'product_' | append: i | append: '_new_price'
          assign show_new_tag_key = 'product_' | append: i | append: '_show_new_tag'
          assign primary_btn_text_key = 'product_' | append: i | append: '_primary_btn'
          assign primary_btn_url_key = 'product_' | append: i | append: '_primary_url'
          assign secondary_btn_text_key = 'product_' | append: i | append: '_secondary_btn'
          assign secondary_btn_url_key = 'product_' | append: i | append: '_secondary_url'
          assign bg_image_key = 'product_' | append: i | append: '_bg_image'

          assign product = block.settings[product_key]
          assign slogan = block.settings[slogan_key]
          assign desc = block.settings[desc_key]
          assign old_price = block.settings[old_price_key]
          assign new_price = block.settings[new_price_key]
          assign show_new_tag = block.settings[show_new_tag_key]
          assign primary_btn_text = block.settings[primary_btn_text_key]
          assign primary_btn_url = block.settings[primary_btn_url_key]
          assign secondary_btn_text = block.settings[secondary_btn_text_key]
          assign secondary_btn_url = block.settings[secondary_btn_url_key]
          assign bg_image = block.settings[bg_image_key]
        %}

        <div class="ai-product-card-{{ ai_gen_id }}">
          {% if bg_image %}
            <img
              src="{{ bg_image | image_url: width: 1200 }}"
              alt="{{ bg_image.alt | escape }}"
              loading="lazy"
              width="{{ bg_image.width }}"
              height="{{ bg_image.height }}"
              class="ai-product-bg-img-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-product-bg-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}

          <div class="ai-product-content-wrap-{{ ai_gen_id }}">
            {% if slogan != blank %}
              <div class="ai-product-top-slogan-{{ ai_gen_id }}">{{ slogan }}</div>
            {% endif %}

            {% if product %}
              <h3 class="ai-product-model-title-{{ ai_gen_id }}">
                {{ product.title }}
                {% if show_new_tag %}
                  <span class="ai-product-new-tag-{{ ai_gen_id }}">NEU</span>
                {% endif %}
              </h3>
            {% endif %}

            {% if desc != blank %}
              <div class="ai-product-desc-text-{{ ai_gen_id }}">{{ desc }}</div>
            {% endif %}

            {% if old_price != blank or new_price != blank %}
              <div class="ai-price-line-{{ ai_gen_id }}">
                {% if old_price != blank %}
                  <span class="ai-old-price-text-{{ ai_gen_id }}">{{ old_price }}</span>
                {% endif %}
                {% if new_price != blank %}
                  <span class="ai-new-price-text-{{ ai_gen_id }}">{{ new_price }}</span>
                {% endif %}
              </div>
            {% endif %}

            <div class="ai-product-btn-group-{{ ai_gen_id }}">
              {% if primary_btn_text != blank %}
                <a
                  href="{% if primary_btn_url %}{{ primary_btn_url }}{% elsif product %}{{ product.url }}{% else %}#{% endif %}"
                  class="ai-btn-primary-shop-{{ ai_gen_id }}"
                >
                  {{ primary_btn_text }}
                </a>
              {% endif %}

              {% if secondary_btn_text != blank %}
                <a
                  href="{% if secondary_btn_url %}{{ secondary_btn_url }}{% elsif product %}{{ product.url }}{% else %}#{% endif %}"
                  class="ai-btn-secondary-info-{{ ai_gen_id }}"
                >
                  {{ secondary_btn_text }}
                </a>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</product-grid-{{ ai_gen_id }}>

<script>
(function() {
  class ProductGrid{{ ai_gen_id }} extends HTMLElement {
    constructor() {
      super();
    }

    connectedCallback() {
      this.style.display = 'block';
    }
  }

  customElements.define('product-grid-{{ ai_gen_id }}', ProductGrid{{ ai_gen_id }});
})();
</script>

