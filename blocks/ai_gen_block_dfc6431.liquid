{% doc %}
  @prompt
    <!DOCTYPE html>
    <html lang="de">
    <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
    /* 全局品牌配色变量 统一全站风格 */
    :root {
      --page-bg: #F8FAFC;
      --accent-green: #00E676;
      --green-dark: #00bd52;
      --accent-blue: #00C6FF;
      --blue-dark: #00a8e0;
      --text-white: #ffffff;
      --text-dark: #111827;
      --text-gray: #4B5563;
      --border-light: rgba(255, 255, 0.5);
      --btn-glow-green: 0 0 8px rgba(0, 230, 118, 0.25), 0 0 16px rgba(0, 230, 118, 0.35), 0 0 28px rgba(0, 230, 118, 0.18);
      --btn-glow-blue: 0 4px 14px rgba(0,198,255,0.2);
      --radius-card: 8px;
      --grid-gap: 24px;
      --section-padding: 80px;
      --container-max: 1400px;
      --side-padding: 20px;
    
      /* 新增文字大小调节变量 */
      --top-slogan-size: 11px;
      --desc-text-size: 12px;
      --old-price-size: 11px;
      --new-price-size: 13px;
    
      /* 复用Hero按钮尺寸变量 */
      --btn-padding-x: 32px;
      --btn-padding-y: 16px;
      --btn-radius: 4px;
      --btn-font-size: 16px;
    }
    
    /* 产品板块外层 整体背景#F8FAFC */
    .product-grid-section {
      width: 100%;
      background: var(--page-bg);
      padding: var(--section-padding) 0;
    }
    .product-container {
      max-width: var(--container-max);
      margin: 0 auto;
      padding: 0 var(--side-padding);
    }
    
    /* 四张卡片上方 板块顶部标语 */
    .section-title-wrap {
      text-align: center;
      margin-bottom: 48px;
    }
    .section-tag {
      font-size: 16px;
      color: var(--accent-green);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin: 0 0 12px;
      font-family: 'Inter', sans-serif;
    }
    .section-main-title {
      font-family: 'Manrope', sans-serif;
      font-size: 42px;
      font-weight: 800;
      color: var(--text-dark);
      margin: 0;
      line-height: 1.2;
    }
    
    /* 2×2网格布局 */
    .product-grid-wrap {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--grid-gap);
    }
    
    /* 单张产品卡片 横向 宽:高=4:3 */
    .product-card {
      position: relative;
      border-radius: var(--radius-card);
      overflow: hidden;
      aspect-ratio: 4 / 3;
    }
    /* 背景图完全铺满卡片 */
    .product-bg-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.4s ease;
    }
    .product-card:hover .product-bg-img {
      transform: scale(1.03);
    }
    
    /* 文字容器：居中偏上，高度限制40%（2/5），下方60%留给图片，整体缩小 */
    .product-content-wrap {
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 60%;
      padding: 20px 0;
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      max-height: 40%;
    }
    
    /* 卡片内顶部小字标语 支持字号调节 */
    .product-top-slogan {
      font-size: var(--top-slogan-size);
      color: #ffd02f;
      font-weight: 600;
      margin: 0 0 8px;
      font-family: 'Inter', sans-serif;
      letter-spacing: 0.5px;
    }
    
    /* 产品型号 强制单行不换行 */
    .product-model-title {
      font-family: 'Manrope', sans-serif;
      font-size: 20px;
      font-weight: 800;
      color: var(--text-white);
      line-height: 1.2;
      margin: 0 0 6px;
      white-space: nowrap;
      overflow: hidden;
    }
    
    /* NEU新品小标签 颜色保留原绿色 */
    .product-new-tag {
      display: inline-block;
      background: var(--accent-green);
      color: #000;
      font-size: 9px;
      font-weight: 700;
      padding: 2px 5px;
      border-radius: 3px;
      margin-left: 5px;
      vertical-align: top;
    }
    
    /* 简短描述文案 字号变量控制 */
    .product-desc-text {
      font-size: var(--desc-text-size);
      color: var(--text-white);
      opacity: 0.92;
      margin: 0 0 12px;
      line-height: 1.5;
    }
    
    /* 原价现价模块 字号变量控制 */
    .price-line {
      display: flex;
      gap: 8px;
      align-items: center;
      margin: 0 0 14px;
    }
    .old-price-text {
      font-size: var(--old-price-size);
      color: #cccccc;
      text-decoration: line-through;
    }
    .new-price-text {
      font-size: var(--new-price-size);
      font-weight: 600;
      color: var(--accent-green);
    }
    
    /* 底部双按钮 替换为Hero同款大按钮样式 */
    .product-btn-group {
      display: flex;
      gap: 12px;
      justify-content: center;
      flex-wrap: nowrap;
    }
    /* 主按钮 复用Hero主按钮样式 */
    .btn-primary-shop {
      padding: var(--btn-padding-y) var(--btn-padding-x);
      background-color: var(--accent-blue);
      color: #ffffff;
      border: none;
      border-radius: var(--btn-radius);
      font-family: 'Inter', sans-serif;
      font-weight: 600;
      font-size: var(--btn-font-size);
      text-decoration: none;
      transition: all 0.25s ease;
      white-space: nowrap;
    }
    .btn-primary-shop:hover {
      filter: brightness(0.9);
      transform: translateY(-2px);
      box-shadow: var(--btn-glow-blue);
    }
    /* 次要边框按钮 复用Hero轮廓按钮样式 */
    .btn-secondary-info {
      padding: var(--btn-padding-y) var(--btn-padding-x);
      background: transparent;
      color: var(--text-white);
      border: 2px solid var(--accent-blue);
      border-radius: var(--btn-radius);
      font-family: 'Inter', sans-serif;
      font-weight: 600;
      font-size: var(--btn-font-size);
      text-decoration: none;
      transition: all 0.25s ease;
      white-space: nowrap;
    }
