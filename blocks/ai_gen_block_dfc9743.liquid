{% endstyle %}

<blog-carousel-{{ ai_gen_id }} class="ai-blog-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank or block.settings.description != blank %}
    <div class="ai-blog-header-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2>{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.description != blank %}
        <p>{{ block.settings.description }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="ai-blog-slider-wrapper-{{ ai_gen_id }}">
    <button class="ai-carousel-arrow-{{ ai_gen_id }} prev" aria-label="Previous articles">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <div class="ai-blog-cards-wrap-{{ ai_gen_id }}" data-carousel-track>
      {% for i in (1..6) %}
        {% assign card_image_key = 'card_' | append: i | append: '_image' %}
        {% assign card_title_key = 'card_' | append: i | append: '_title' %}
        {% assign card_excerpt_key = 'card_' | append: i | append: '_excerpt' %}
        {% assign card_link_key = 'card_' | append: i | append: '_link' %}
        
        {% assign card_image = block.settings[card_image_key] %}
        {% assign card_title = block.settings[card_title_key] %}
        {% assign card_excerpt = block.settings[card_excerpt_key] %}
        {% assign card_link = block.settings[card_link_key] %}

        <div class="ai-blog-card-item-{{ ai_gen_id }}">
          <div class="ai-blog-card-img-box-{{ ai_gen_id }}">
            {% if card_image %}
              <img
                src="{{ card_image | image_url: width: 600 }}"
                alt="{{ card_image.alt | escape }}"
                loading="lazy"
                width="600"
                height="{{ block.settings.image_height }}"
              >
            {% else %}
              {{ 'image' | placeholder_svg_tag }}
            {% endif %}
          </div>
          <div class="ai-blog-card-content-{{ ai_gen_id }}">
            <h3>{{ card_title }}</h3>
            <p class="excerpt">{{ card_excerpt }}</p>
            <a href="{{ card_link }}" class="ai-blog-read-btn-{{ ai_gen_id }}">
              {{ block.settings.button_text }}
            </a>
          </div>
        </div>
      {% endfor %}
    </div>

    <button class="ai-carousel-arrow-{{ ai_gen_id }} next" aria-label="Next articles">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>
</blog-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class BlogCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentPage = 0;
        this.itemsPerPage = {{ block.settings.columns_desktop }};
      }

      connectedCallback() {
        this.track = this.querySelector('[data-carousel-track]');
        this.prevBtn = this.querySelector('.ai-carousel-arrow-{{ ai_gen_id }}.prev');
        this.nextBtn = this.querySelector('.ai-carousel-arrow-{{ ai_gen_id }}.next');
        this.cards = this.querySelectorAll('.ai-blog-card-item-{{ ai_gen_id }}');
        this.totalPages = Math.ceil(this.cards.length / this.itemsPerPage);

        this.setupEventListeners();
        this.updateButtons();
        this.handleResize();
      }

      setupEventListeners() {
        this.prevBtn.addEventListener('click', () => this.goToPrevPage());
        this.nextBtn.addEventListener('click', () => this.goToNextPage());
        window.addEventListener('resize', () => this.handleResize());
      }

      handleResize() {
        const width = window.innerWidth;
        if (width <= 640) {
          this.itemsPerPage = 1;
        } else if (width <= 1024) {
          this.itemsPerPage = 2;
        } else {
          this.itemsPerPage = {{ block.settings.columns_desktop }};
        }
        this.totalPages = Math.ceil(this.cards.length / this.itemsPerPage);
        if (this.currentPage >= this.totalPages) {
          this.currentPage = this.totalPages - 1;
        }
        this.updateCarousel();
      }

      goToPrevPage() {
        if (this.currentPage > 0) {
          this.currentPage--;
          this.updateCarousel();
        }
      }

      goToNextPage() {
        if (this.currentPage < this.totalPages - 1) {
          this.currentPage++;
          this.updateCarousel();
        }
      }

      updateCarousel() {
        this.cards.forEach((card, index) => {
          const startIndex = this.currentPage * this.itemsPerPage;
          const endIndex = startIndex + this.itemsPerPage;
          if (index >= startIndex && index < endIndex) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
        this.updateButtons();
      }

      updateButtons() {
        this.prevBtn.disabled = this.currentPage === 0;
        this.nextBtn.disabled = this.currentPage >= this.totalPages - 1;
      }
    }

    customElements.define('blog-carousel-{{ ai_gen_id }}', BlogCarousel{{ ai_gen_id }});
  })();
</script>

