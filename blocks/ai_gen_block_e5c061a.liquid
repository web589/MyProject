{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-steps-animation-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: 60px 20px;
    background: {{ block.settings.background_color }};
  }

  .ai-steps-wrapper-{{ ai_gen_id }} {
    max-width: 1600px;
    margin: 0 auto;
    text-align: center;
  }

  .ai-steps-main-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    color: {{ block.settings.title_color }};
    margin-bottom: 80px;
    line-height: 1.2;
  }

  .ai-steps-row-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    position: relative;
  }

  .ai-step-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .ai-icon-card-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    box-shadow: 0 0 0 rgba(0,0,0,0);
    transition: all 0.4s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .ai-icon-card-{{ ai_gen_id }} img {
    max-width: 85%;
    max-height: 85%;
    object-fit: contain;
  }

  .ai-icon-card-{{ ai_gen_id }}.active {
    transform: translateY(-10px);
    box-shadow: 0 12px 30px rgba(0,0,0,0.1);
  }

  .ai-dot-wrap-{{ ai_gen_id }} {
    width: 14px;
    height: 14px;
    margin: 26px 0 22px;
    position: relative;
  }

  .ai-dot-core-{{ ai_gen_id }} {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: {{ block.settings.dot_inactive_color }};
    position: relative;
    z-index: 2;
  }

  .ai-dot-glow-ring-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: {{ block.settings.dot_active_color }};
    opacity: 0;
  }

  .ai-step-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.step_title_size }}px;
    font-weight: 700;
    color: {{ block.settings.step_title_color }};
    margin-bottom: 14px;
    position: relative;
    overflow: hidden;
    min-height: 40px;
  }

  .ai-light-sweep-mask-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.8), transparent);
  }

  .ai-step-title-{{ ai_gen_id }}.active {
    color: {{ block.settings.step_title_active_color }};
  }

  .ai-step-desc-{{ ai_gen_id }} {
    font-size: {{ block.settings.step_desc_size }}px;
    color: {{ block.settings.step_desc_color }};
    line-height: 1.6;
    max-width: 240px;
  }

  @keyframes ai-dot-light-on-{{ ai_gen_id }} {
    from { background: {{ block.settings.dot_inactive_color }}; }
    to { background: {{ block.settings.dot_active_color }}; }
  }

  @keyframes ai-glow-pulse-spread-{{ ai_gen_id }} {
    0% {
      opacity: 0.7;
      transform: translate(-50%, -50%) scale(1);
    }
    100% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(3);
    }
  }

  @keyframes ai-title-sweep-move-{{ ai_gen_id }} {
    from { left: -100%; }
    to { left: 100%; }
  }

  @media(max-width: 1200px){
    .ai-steps-main-title-{{ ai_gen_id }} { 
      font-size: calc({{ block.settings.title_size }}px * 0.7); 
    }
    .ai-icon-card-{{ ai_gen_id }} { 
      width: calc({{ block.settings.icon_size }}px * 0.8); 
      height: calc({{ block.settings.icon_size }}px * 0.8); 
    }
    .ai-step-title-{{ ai_gen_id }} { 
      font-size: calc({{ block.settings.step_title_size }}px * 0.8); 
    }
  }

  @media(max-width: 768px){
    .ai-steps-row-{{ ai_gen_id }} { 
      grid-template-columns: 1fr; 
      gap: 60px; 
    }
    .ai-steps-main-title-{{ ai_gen_id }} { 
      font-size: calc({{ block.settings.title_size }}px * 0.5); 
    }
  }
{% endstyle %}

<steps-animation-{{ ai_gen_id }}
  class="ai-steps-animation-{{ ai_gen_id }}"
  data-animation-speed="{{ block.settings.animation_speed }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-steps-wrapper-{{ ai_gen_id }}">
    {% if block.settings.main_title != blank %}
      <h2 class="ai-steps-main-title-{{ ai_gen_id }}">{{ block.settings.main_title }}</h2>
    {% endif %}

    <div class="ai-steps-row-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign step_image_key = 'step_' | append: i | append: '_image'
          assign step_title_key = 'step_' | append: i | append: '_title'
          assign step_desc_key = 'step_' | append: i | append: '_desc'
          
          assign step_image = block.settings[step_image_key]
          assign step_title = block.settings[step_title_key]
          assign step_desc = block.settings[step_desc_key]
        %}

        <div class="ai-step-item-{{ ai_gen_id }} ai-step-item-{{ ai_gen_id }}-{{ i }}" data-step="{{ i }}">
          <div class="ai-icon-card-{{ ai_gen_id }}">
            {% if step_image %}
              <img
                src="{{ step_image | image_url: width: 300 }}"
                alt="{{ step_title | escape }}"
                loading="lazy"
                width="300"
                height="300"
              >
            {% else %}
              <div class="ai-icon-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          <div class="ai-dot-wrap-{{ ai_gen_id }}">
            <div class="ai-dot-core-{{ ai_gen_id }}"></div>
            <div class="ai-dot-glow-ring-{{ ai_gen_id }}"></div>
          </div>
          <h3 class="ai-step-title-{{ ai_gen_id }}">
            {{ step_title }}
            <span class="ai-light-sweep-mask-{{ ai_gen_id }}"></span>
          </h3>
          <p class="ai-step-desc-{{ ai_gen_id }}">{{ step_desc }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</steps-animation-{{ ai_gen_id }}>

<script>
  (function() {
    class StepsAnimation{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentStep = 0;
        this.totalSteps = 4;
        this.animationSpeed = parseFloat(this.dataset.animationSpeed) || 3;
        this.intervalId = null;
      }

      connectedCallback() {
        this.startAnimation();
      }

      disconnectedCallback() {
        if (this.intervalId) {
          clearInterval(this.intervalId);
        }
      }

      startAnimation() {
        this.animateStep(this.currentStep);
        
        this.intervalId = setInterval(() => {
          this.currentStep = (this.currentStep + 1) % this.totalSteps;
          this.animateStep(this.currentStep);
        }, this.animationSpeed * 1000);
      }

      animateStep(stepIndex) {
        const stepItems = this.querySelectorAll('.ai-step-item-{{ ai_gen_id }}');
        
        stepItems.forEach((item, index) => {
          const iconCard = item.querySelector('.ai-icon-card-{{ ai_gen_id }}');
          const dotCore = item.querySelector('.ai-dot-core-{{ ai_gen_id }}');
          const dotGlow = item.querySelector('.ai-dot-glow-ring-{{ ai_gen_id }}');
          const stepTitle = item.querySelector('.ai-step-title-{{ ai_gen_id }}');
          const lightSweep = item.querySelector('.ai-light-sweep-mask-{{ ai_gen_id }}');
          
          if (index === stepIndex) {
            iconCard.classList.add('active');
            stepTitle.classList.add('active');
            
            dotCore.style.animation = 'ai-dot-light-on-{{ ai_gen_id }} 0.4s ease forwards';
            dotGlow.style.animation = 'ai-glow-pulse-spread-{{ ai_gen_id }} 0.6s ease-out forwards';
            lightSweep.style.animation = 'ai-title-sweep-move-{{ ai_gen_id }} 0.8s ease forwards';
          } else {
            iconCard.classList.remove('active');
            stepTitle.classList.remove('active');
            
            dotCore.style.animation = '';
            dotGlow.style.animation = '';
            lightSweep.style.animation = '';
          }
        });
      }
    }

    customElements.define('steps-animation-{{ ai_gen_id }}', StepsAnimation{{ ai_gen_id }});
  })();
</script>

