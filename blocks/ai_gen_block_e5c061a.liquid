    <title>Balkonkraftwerk 4 Schritte Loop Animation</title>
    <style>
    *{
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, Helvetica, sans-serif;
    }
    body{
      background: #ffffff;
      padding: 60px 20px;
    }
    
    /* 外层容器 */
    .wrapper{
      max-width: 1600px;
      margin: 0 auto;
      text-align: center;
    }
    
    /* 顶部大标题 */
    .main-title{
      font-size: 64px;
      font-weight: 700;
      color: #222;
      margin-bottom: 80px;
    }
    
    /* 四列布局容器 */
    .steps-row{
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      position: relative;
    }
    
    /* 单个步骤模块 */
    .step-item{
      display: flex;
      flex-direction: column;
      align-items: center;
      position: relative;
    }
    
    /* 图标圆角卡片 */
    .icon-card{
      width: 160px;
      height: 160px;
      background: #fff;
      border-radius: 24px;
      box-shadow: 0 0 0 rgba(0,0,0);
      transition: all 0.4s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }
    .icon-card img{
      max-width: 85%;
      max-height: 85%;
      object-fit: contain;
    }
    .icon-card.active{
      transform: translateY(-10px);
      box-shadow: 0 12px 30px rgba(0,0,0,0.1);
    }
    
    /* 圆点容器 */
    .dot-wrap{
      width: 14px;
      height: 14px;
      margin: 26px 0 22px;
      position: relative;
    }
    .dot-core{
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: #dddddd;
      position: relative;
      z-index: 2;
    }
    .dot-glow-ring{
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: #0066ff;
      opacity: 0;
    }
    
    /* 标题样式+扫光遮罩 */
    .step-title{
      font-size: 32px;
      font-weight: 700;
      color: #222;
      margin-bottom: 14px;
      position: relative;
      overflow: hidden;
      min-height: 40px;
    }
    .light-sweep-mask{
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.8), transparent);
    }
    .step-title.active{
      color: #0066ff;
    }
    
    /* 描述文本 */
    .step-desc{
      font-size: 18px;
      color: #666;
      line-height: 1.6;
      max-width: 240px;
    }
    
    /* 速度控制面板 */
    .speed-control-box{
      margin-top: 100px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 16px;
    }
    .speed-control-box label{
      font-size: 18px;
    }
    #speedSlider{
      width: 350px;
    }
    .speed-value-text{
      width: 70px;
      font-size: 18px;
    }
    
    /* 关键帧动画 */
    @keyframes dotLightOn {
      from { background: #ddd; }
      to { background: #0066ff; }
    }
    @keyframes glowPulseSpread {
      0% {
        opacity: 0.7;
        transform: translate(-50%, -50%) scale(1);
      }
      100% {
        opacity: 0;
        transform: translate(-50%, -50%) scale(3);
      }
    }
    @keyframes titleSweepMove {
      from { left: -100%; }
      to { left: 100%; }
    }
    
    /* 响应式适配 */
    @media(max-width: 1200px){
      .main-title { font-size: 46px; }
      .icon-card { width: 130px; height: 130px; }
      .step-title { font-size: 26px; }
    }
    @media(max-width: 768px){
      .steps-row { grid-template-columns: 1fr; gap: 60px; }
      .main-title { font-size: 34px; }
    }
    </style>
    </head>
