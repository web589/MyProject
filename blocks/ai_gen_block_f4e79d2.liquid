{% doc %}
  @prompt
    {% comment %}
    ===== 自定义配置区，在这里直接改参数 =====
    module_title:模块大标题
    container_max_width:模块整体最大宽度
    container_top_margin / container_bottom_margin:模块上下外边距
    card_gap:卡片之间间距
    card_border_radius:卡片圆角
    card_1~card4：4张卡片，image填图片链接，title标题，desc描述
    font_size_title：模块总标题字号
    font_size_card_title：卡片内标题字号
    font_size_card_desc：卡片内描述字号
    {% endcomment %}
    <style>
    .feature-card-module {
      width: 100%;
      margin: var(--module-top) auto var(--module-bottom);
      max-width: var(--container-width);
    }
    .feature-card-module__heading {
      font-size: var(--heading-font-size);
      margin-bottom: 32px;
      font-weight: 700;
    }
    .feature-card-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--card-gap);
    }
    .feature-card-item {
      position: relative;
      border-radius: var(--card-radius);
      overflow: hidden;
      aspect-ratio: 16 /9;
    }
    .feature-card-item img {
      width:100%;
      height:100%;
      object-fit:cover;
    }
    .feature-card-text-wrap {
      position: absolute;
      top:24px;
      left:24px;
      color:#ffffff;
    }
    .feature-card-card-title {
      font-size: var(--card-title-font);
      font-weight:600;
      margin:0 0 8px;
    }
    .feature-card-card-desc {
      font-size: var(--card-desc-font);
      margin:0;
    }
    /*移动端自动变成1列*/
    @media(max-width:768px){
      .feature-card-grid{
        grid-template-columns:1fr;
      }
    }
    </style>
    
    {% assign module_title = "Revolutionäre Power. Wegweisende Einsparungen." %}
    {% assign container_max_width = "1400px" %}
    {% assign container_top_margin = "60px" %}
    {% assign container_bottom_margin = "60px" %}
    {% assign card_gap = "20px" %}
    {% assign card_border_radius = "12px" %}
    {% assign font_size_title = "42px" %}
    {% assign font_size_card_title = "24px" %}
    {% assign font_size_card_desc = "18px" %}
    
    {% comment %}卡片内容配置，替换image为你的图片链接，修改title、desc文字{% endcomment %}
    {% assign card1_image = "https://cdn.shopify.com/s/files/1/0000/0000/0000/files/card1.jpg" %}
    {% assign card1_title = "3600W PV‑Eingang" %}
    {% assign card1_desc = "4 MPPT" %}
    
    {% assign card2_image = "https://cdn.shopify.com/s/files/1/0000/0000/0000/files/card2.jpg" %}
    {% assign card2_title = "Bis zu 1566€" %}
    {% assign card2_desc = "jährliche Einsparungen" %}
    
    {% assign card3_image = "https://cdn.shopify.com/s/files/1/0000/0000/0000/files/card3.jpg" %}
    {% assign card3_title = "Anker Intelligence™" %}
    {% assign card3_desc = "Optimiert Energieverbrauch & Einsparungen" %}
    
    {% assign card4_image = "https://cdn.shopify.com/s/files/1/0000/0000/0000/files/card4.jpg" %}
    {% assign card4_title = "2,68‑16kWh" %}
    {% assign card4_desc = "erweiterbare Kapazität" %}
    
    <div class="feature-card-module"
    style="
    --container-width:{{container_max_width}};
    --module-top:{{container_top_margin}};
    --module-bottom:{{container_bottom_margin}};
    --card-gap:{{card_gap}};
    --card-radius:{{card_border_radius}};
    --heading-font-size:{{font_size_title}};
    --card-title-font:{{font_size_card_title}};
    --card-desc-font:{{font_size_card_desc}};
    ">
      <h2 class="feature-card-module__heading">{{module_title}}</h2>
      <div class="feature-card-grid">
        <!--卡片1-->
        <div class="feature-card-item">
          <img src="{{card1_image}}" alt="{{card1_title}}">
          <div class="feature-card-text-wrap">
            <div class="feature-card-card-title">{{card1_title}}</div>
            <div class="feature-card-card-desc">{{card1_desc}}</div>
          </div>
        </div>
        <!--卡片2-->
        <div class="feature-card-item">
          <img src="{{card2_image}}" alt="{{card2_title}}">
          <div class="feature-card-text-wrap">
            <div class="feature-card-card-title">{{card2_title}}</div>
            <div class="feature-card-card-desc">{{card2_desc}}</div>
          </div>
        </div>
        <!--卡片3-->
        <div class="feature-card-item">
          <img src="{{card3_image}}" alt="{{card3_title}}">
          <div class="feature-card-text-wrap">
            <div class="feature-card-card-title">{{card3_title}}</div>
            <div class="feature-card-card-desc">{{card3_desc}}</div>
          </div>
        </div>
        <!--卡片4-->
        <div class="feature-card-item">
          <img src="{{card4_image}}" alt="{{card4_title}}">
          <div class="feature-card-text-wrap">
            <div class="feature-card-card-title">{{card4_title}}</div>
            <div class="feature-card-card-desc">{{card4_desc}}</div>
          </div>
        </div>
      </div>
    </div>, 每张卡片的高度宽度可以单独自由调节, 每张卡片的宽度可以单独独立调节，高度也可以单独独立调节，在调节宽度时，只拉宽或变窄卡片，卡片高度不变，高度在调节时，宽度也不会变化, 整个卡片模块要整体保持居中, 其他地方不变，加一个可以调节整个模块容器与上一个模块间距的设置，还有给每个卡片加一层由顶部到卡片2分之一处黑色至透明渐变的遮罩, 其他不用变，再添加一个可以调节容器内标题距离顶部的距离的设置，还有容器下面内部边距设置，还有整个模块容器与下面一个模块间距的设置, 其他地方不用变化，添加一个可以调节卡片内文字位置的设置, 在前两排卡片下方再加一排图片卡片,为三个卡片并排,, 每张卡片可以单独调节宽度，可以单独高度，并且宽度可以调节无上限，但整个模块始终保持居中，左侧卡片的左边不能超过左边容器边框，右侧卡片的右边不能超过右边容器边框, 增加一个可以调节每个图片卡片里标题和描述的上下左右位置的设置，这个设置的滑块设置的 step(步长)单位为1来调节，图片里的黑色遮罩的位置和高度还有透明度也可以自定义调节, 增加一个可以调节标题在左边还是居中还是右边的设置，请帮我把当前这个 section 里 "Container max width"(容器最大宽度)这个滑块设置的 step(步长)从 40 改成 10,其他不用变。还有再增加一个每个卡片里的标题和描述可以选择左对齐、居中、右对齐的设置
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

<div id="pdp-overview" class="ai-feature-cards-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
{% style %}
