{% liquid
  assign is_product_context = false
  assign use_product_features = false
  assign pdp_feature_title = blank
  assign pdp_features = blank
  if request.page_type == 'product' and product != blank and block.settings.content_source != 'theme_editor'
    assign is_product_context = true
    assign pdp_content_candidate = product.metafields.custom.pdp_content.value
    if pdp_content_candidate != blank
      assign pdp_content_owner = pdp_content_candidate.product.value
      assign pdp_content_is_for_product = false
      if pdp_content_owner != blank
        if pdp_content_owner.handle == product.handle
          assign pdp_content_is_for_product = true
        endif
      elsif pdp_content_candidate.system.handle == product.handle
        assign pdp_content_is_for_product = true
      endif
      if pdp_content_is_for_product
        assign pdp_content = pdp_content_candidate
        assign pdp_feature_title = pdp_content.overview_title.value
        assign pdp_features = pdp_content.features.value
        if pdp_features != blank
          assign use_product_features = true
        endif
      endif
    endif
  endif
  if is_product_context == false
    assign pdp_feature_title = block.settings.module_title
  endif
%}

{% if is_product_context == false or pdp_features != blank %}
  <div class="ai-feature-cards-container-{{ ai_gen_id }}">
    {% if pdp_feature_title != blank %}
      <div class="ai-feature-cards-heading-group-{{ ai_gen_id }}">
        <h2 class="ai-feature-cards-heading-{{ ai_gen_id }}">{{ pdp_feature_title | escape }}</h2>
        {% if block.settings.module_subtitle != blank %}
          <div class="ai-feature-cards-subheading-{{ ai_gen_id }}">{{ block.settings.module_subtitle | escape | newline_to_br }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-feature-cards-grid-{{ ai_gen_id }}">
      {% if is_product_context == false %}
        {% for feature_index in (1..4) %}
          {% liquid
            assign image_key = 'card_' | append: feature_index | append: '_image'
            assign title_key = 'card_' | append: feature_index | append: '_title'
            assign description_key = 'card_' | append: feature_index | append: '_desc'
            assign feature_image = block.settings[image_key]
            assign feature_title = block.settings[title_key]
            assign feature_description = block.settings[description_key]
          %}
          {% if feature_image != blank or feature_title != blank or feature_description != blank %}
            <div class="ai-feature-card-{{ ai_gen_id }} ai-feature-card-{{ ai_gen_id }}--{{ feature_index }}">
              {% if feature_image != blank %}{{ feature_image | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1400, 2000', sizes: '(max-width: 768px) 100vw, 50vw', alt: feature_title }}{% else %}<div class="ai-feature-card-placeholder-{{ ai_gen_id }}">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}
              <div class="ai-feature-card-overlay-{{ ai_gen_id }}"></div>
              <div class="ai-feature-card-text-{{ ai_gen_id }}">
                {% if feature_title != blank %}<div class="ai-feature-card-title-{{ ai_gen_id }}">{{ feature_title | escape }}</div>{% endif %}
                {% if feature_description != blank %}<div class="ai-feature-card-desc-{{ ai_gen_id }}">{{ feature_description | escape }}</div>{% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      {% elsif use_product_features %}
      {% for pdp_feature in pdp_features limit: 4 %}
      {% liquid
        assign feature_image = pdp_feature.image.value
        assign feature_title = pdp_feature.title.value
        assign feature_description = pdp_feature.description.value
      %}
      {% if feature_image != blank or feature_title != blank or feature_description != blank %}
      <div class="ai-feature-card-{{ ai_gen_id }} ai-feature-card-{{ ai_gen_id }}--{{ forloop.index }}">
        {% if feature_image != blank %}{{ feature_image | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1400, 2000', sizes: '(max-width: 768px) 100vw, 50vw', alt: feature_title }}{% endif %}
        <div class="ai-feature-card-overlay-{{ ai_gen_id }}"></div>
        <div class="ai-feature-card-text-{{ ai_gen_id }}">
          {% if feature_title != blank %}<div class="ai-feature-card-title-{{ ai_gen_id }}">{{ feature_title | escape }}</div>{% endif %}
          {% if feature_description != blank %}<div class="ai-feature-card-desc-{{ ai_gen_id }}">{{ feature_description | escape }}</div>{% endif %}
        </div>
      </div>
      {% endif %}
      {% endfor %}
      {% endif %}
    </div>

    <div class="ai-feature-cards-grid-{{ ai_gen_id }}" style="margin-top: {{ block.settings.card_gap }}px;">
      {% if is_product_context == false %}
        {% for feature_index in (5..7) %}
          {% liquid
            assign image_key = 'card_' | append: feature_index | append: '_image'
            assign title_key = 'card_' | append: feature_index | append: '_title'
            assign description_key = 'card_' | append: feature_index | append: '_desc'
            assign feature_image = block.settings[image_key]
            assign feature_title = block.settings[title_key]
            assign feature_description = block.settings[description_key]
          %}
          {% if feature_image != blank or feature_title != blank or feature_description != blank %}
            <div class="ai-feature-card-{{ ai_gen_id }} ai-feature-card-{{ ai_gen_id }}--{{ feature_index }}">
              {% if feature_image != blank %}{{ feature_image | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1400, 2000', sizes: '(max-width: 768px) 100vw, 33vw', alt: feature_title }}{% else %}<div class="ai-feature-card-placeholder-{{ ai_gen_id }}">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}
              <div class="ai-feature-card-overlay-{{ ai_gen_id }}"></div>
              <div class="ai-feature-card-text-{{ ai_gen_id }}">
                {% if feature_title != blank %}<div class="ai-feature-card-title-{{ ai_gen_id }}">{{ feature_title | escape }}</div>{% endif %}
                {% if feature_description != blank %}<div class="ai-feature-card-desc-{{ ai_gen_id }}">{{ feature_description | escape }}</div>{% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      {% elsif use_product_features %}
      {% for pdp_feature in pdp_features offset: 4 limit: 3 %}
        {% liquid
          assign feature_image = pdp_feature.image.value
          assign feature_title = pdp_feature.title.value
          assign feature_description = pdp_feature.description.value
          assign feature_index = forloop.index | plus: 4
        %}
        {% if feature_image != blank or feature_title != blank or feature_description != blank %}
          <div class="ai-feature-card-{{ ai_gen_id }} ai-feature-card-{{ ai_gen_id }}--{{ feature_index }}">
            {% if feature_image != blank %}{{ feature_image | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1400, 2000', sizes: '(max-width: 768px) 100vw, 33vw', alt: feature_title }}{% endif %}
            <div class="ai-feature-card-overlay-{{ ai_gen_id }}"></div>
            <div class="ai-feature-card-text-{{ ai_gen_id }}">
              {% if feature_title != blank %}<div class="ai-feature-card-title-{{ ai_gen_id }}">{{ feature_title | escape }}</div>{% endif %}
              {% if feature_description != blank %}<div class="ai-feature-card-desc-{{ ai_gen_id }}">{{ feature_description | escape }}</div>{% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
      {% endif %}
    </div>
  </div>
{% elsif request.design_mode %}
  <div class="ai-feature-cards-container-{{ ai_gen_id }}">
    <p>为当前产品创建并关联独立的 PDP content 后，Feature cards 的文案和图片会显示在这里。</p>
  </div>
{% endif %}
</div>

