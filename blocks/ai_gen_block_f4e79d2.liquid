    font-size: 18px;
    line-height: 1.5;
    text-align: {{ block.settings.heading_alignment }};
  }

  .ai-feature-cards-grid-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: {{ block.settings.card_gap }}px;
    flex-wrap: wrap;
  }

  .ai-feature-card-{{ ai_gen_id }} {
    position: relative;
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    flex-shrink: 0;
    isolation: isolate;
    background: #111827;
    box-shadow: 0 1px 0 rgba(15, 23, 42, 0.04);
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 420ms ease;
  }

  .ai-feature-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 34px rgba(15, 23, 42, 0.18);
  }

  .ai-feature-card-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.001);
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .ai-feature-card-{{ ai_gen_id }}:hover img {
    transform: scale(1.06);
  }

  .ai-feature-card-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-feature-card-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-feature-card-overlay-{{ ai_gen_id }} {
    position: absolute;
    left: 0;
    right: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, {{ block.settings.overlay_opacity }}) 0%,
      rgba(0, 0, 0, {{ block.settings.overlay_opacity | times: 0.45 }}) 52%,
      transparent 100%
    );
    pointer-events: none;
    opacity: 0.9;
    transition: opacity 420ms ease;
  }

  .ai-feature-card-{{ ai_gen_id }}:hover .ai-feature-card-overlay-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-feature-card-text-{{ ai_gen_id }} {
    position: absolute;
    color: #ffffff;
    z-index: 1;
    top: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    box-sizing: border-box;
    padding-top: 24px;
    padding-bottom: max(24px, {{ block.settings.card_1_text_bottom }}px);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.22);
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .ai-feature-card-{{ ai_gen_id }}:hover .ai-feature-card-text-{{ ai_gen_id }} {
