    border-radius: {{ block.settings.card_border_radius }}px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.07);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.28s ease, box-shadow 0.28s ease;
  }

  .ai-blog-card-item-{{ ai_gen_id }}:hover {
    transform: translateY(-7px);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.11);
  }

  .ai-blog-card-img-box-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.image_height }}px;
    background: #f5f7fa;
    overflow: hidden;
  }

  .ai-blog-card-img-box-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.32s ease;
  }

  .ai-blog-card-item-{{ ai_gen_id }}:hover .ai-blog-card-img-box-{{ ai_gen_id }} img {
    transform: scale(1.05);
  }

  .ai-blog-card-img-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-blog-card-img-placeholder-{{ ai_gen_id }} svg {
