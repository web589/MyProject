    width: 16px;
    height: 16px;
    transition: transform 0.2s ease;
  }

  .ai-blog-footer-link-{{ ai_gen_id }} a:hover svg {
    transform: translateX(4px);
  }

  @media screen and (max-width: 1024px) {
    .ai-blog-slider-wrapper-{{ ai_gen_id }} {
      padding: 0 65px;
    }
    .ai-blog-cards-wrap-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
    .ai-carousel-arrow-{{ ai_gen_id }} {
      width: 44px;
      height: 44px;
    }
    .ai-carousel-arrow-{{ ai_gen_id }}.prev {
      left: 15px;
    }
    .ai-carousel-arrow-{{ ai_gen_id }}.next {
      right: 15px;
    }
  }

  @media screen and (max-width: 640px) {
    .ai-blog-carousel-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.7 }}px 20px;
    }
    .ai-blog-header-{{ ai_gen_id }} {
      margin-left: 0;
    }
    .ai-blog-slider-wrapper-{{ ai_gen_id }} {
      padding: 0;
      margin-bottom: 80px;
    }
    .ai-blog-cards-wrap-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
    .ai-blog-card-img-box-{{ ai_gen_id }} {
      height: {{ block.settings.image_height | times: 0.8 }}px;
    }
    .ai-blog-read-btn-{{ ai_gen_id }} {
      width: 100%;
      text-align: center;
    }
    .ai-carousel-arrow-{{ ai_gen_id }} {
      width: 40px;
      height: 40px;
      top: auto;
      bottom: -65px;
      transform: none;
    }
    .ai-carousel-arrow-{{ ai_gen_id }}.prev {
      left: calc(50% - 50px);
    }
    .ai-carousel-arrow-{{ ai_gen_id }}.next {
      right: calc(50% - 50px);
    }
  }
{% endstyle %}

<blog-carousel-{{ ai_gen_id }} class="ai-blog-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank or block.settings.description != blank %}
    <div class="ai-blog-header-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2>{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.description != blank %}
        <p>{{ block.settings.description }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="ai-blog-slider-wrapper-{{ ai_gen_id }}">
    <button class="ai-carousel-arrow-{{ ai_gen_id }} prev" aria-label="Previous articles">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <div class="ai-blog-cards-wrap-{{ ai_gen_id }}">
      {% for i in (1..12) %}
        {% liquid
          assign card_enabled_key = 'card_' | append: i | append: '_enabled'
          assign card_image_key = 'card_' | append: i | append: '_image'
          assign card_title_key = 'card_' | append: i | append: '_title'
          assign card_excerpt_key = 'card_' | append: i | append: '_excerpt'
          assign card_link_key = 'card_' | append: i | append: '_link'

          assign card_enabled = block.settings[card_enabled_key]
          assign card_image = block.settings[card_image_key]
          assign card_title = block.settings[card_title_key]
          assign card_excerpt = block.settings[card_excerpt_key]
          assign card_link = block.settings[card_link_key]
        %}

        {% if card_enabled %}
          <div class="ai-blog-card-item-{{ ai_gen_id }}">
            <div class="ai-blog-card-img-box-{{ ai_gen_id }}">
              {% if card_image %}
                <img
                  src="{{ card_image | image_url: width: 600 }}"
                  alt="{{ card_image.alt | escape }}"
                  loading="lazy"
                  width="600"
                  height="{{ block.settings.image_height }}"
                >
              {% else %}
                <div class="ai-blog-card-img-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            <div class="ai-blog-card-content-{{ ai_gen_id }}">
              <h3>
                {% if card_title != blank %}
                  {{ card_title }}
                {% else %}
                  Article title {{ i }}
                {% endif %}
              </h3>
              <p class="excerpt">
                {% if card_excerpt != blank %}
                  {{ card_excerpt }}
                {% else %}
                  Add a description for this article in the block settings.
                {% endif %}
              </p>
              <a 
                href="{% if card_link != blank %}{{ card_link }}{% else %}#{% endif %}" 
                class="ai-blog-read-btn-{{ ai_gen_id }}"
              >
                {{ block.settings.button_text }}
              </a>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <button class="ai-carousel-arrow-{{ ai_gen_id }} next" aria-label="Next articles">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>

  {% if block.settings.footer_link_url != blank %}
    <div class="ai-blog-footer-link-{{ ai_gen_id }}">
      <a href="{{ block.settings.footer_link_url }}">
        {{ block.settings.footer_link_text }}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  {% endif %}
</blog-carousel-{{ ai_gen_id }}>

<script>
(function() {
  class BlogCarousel{{ ai_gen_id }} extends HTMLElement {
    constructor() {
      super();
      this.currentPage = 0;
      this.itemsPerPage = {{ block.settings.columns_desktop }};
    }

    connectedCallback() {
      this.cardsWrap = this.querySelector('.ai-blog-cards-wrap-{{ ai_gen_id }}');
      this.cards = Array.from(this.querySelectorAll('.ai-blog-card-item-{{ ai_gen_id }}'));
      this.prevBtn = this.querySelector('.ai-carousel-arrow-{{ ai_gen_id }}.prev');
      this.nextBtn = this.querySelector('.ai-carousel-arrow-{{ ai_gen_id }}.next');
      
      this.totalPages = Math.ceil(this.cards.length / this.itemsPerPage);
      
      this.prevBtn.addEventListener('click', () => this.goToPrevPage());
      this.nextBtn.addEventListener('click', () => this.goToNextPage());
      
      this.updateView();
      this.updateButtons();
      
      window.addEventListener('resize', () => this.handleResize());
    }

    handleResize() {
      const width = window.innerWidth;
      if (width <= 640) {
        this.itemsPerPage = 1;
      } else if (width <= 1024) {
        this.itemsPerPage = {{ block.settings.columns_tablet }};
      } else {
        this.itemsPerPage = {{ block.settings.columns_desktop }};
      }
      this.totalPages = Math.ceil(this.cards.length / this.itemsPerPage);
      this.currentPage = Math.min(this.currentPage, this.totalPages - 1);
      this.updateView();
      this.updateButtons();
    }

    goToPrevPage() {
      if (this.currentPage > 0) {
        this.currentPage--;
        this.updateView();
        this.updateButtons();
      }
    }

    goToNextPage() {
      if (this.currentPage < this.totalPages - 1) {
        this.currentPage++;
        this.updateView();
        this.updateButtons();
      }
    }

    updateView() {
      const startIndex = this.currentPage * this.itemsPerPage;
      const endIndex = startIndex + this.itemsPerPage;
      
      this.cards.forEach((card, index) => {
        if (index >= startIndex && index < endIndex) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    updateButtons() {
      this.prevBtn.disabled = this.currentPage === 0;
      this.nextBtn.disabled = this.currentPage >= this.totalPages - 1;
    }
  }

  customElements.define('blog-carousel-{{ ai_gen_id }}', BlogCarousel{{ ai_gen_id }});
})();
</script>

{% schema %}
{
  "name": "Blog carousel",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Blog / Inhaltsmarketing Eingang"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Hier werden ausgewählte Ratgeber, Produktkaufberatungen und aktuelle Gesetzesauswertungen rund um Balkonkraftwerke und Hausbatterien angezeigt."
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "header_left_offset",
      "label": "Left offset",
      "info": "Distance from left edge when alignment is set to Left",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 38
    },
    {
      "type": "range",
      "id": "description_size",
