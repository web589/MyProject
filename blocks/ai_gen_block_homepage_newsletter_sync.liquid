{% comment %}
  Reuse the homepage newsletter so this page keeps the same subscription form,
  copy and consent handling as the storefront homepage.
{% endcomment %}
{% assign bw_anchor_id = block.settings.anchor_id | handle %}
<div{% if bw_anchor_id != blank %} id="{{ bw_anchor_id }}"{% endif %} class="bw-homepage-sync-anchor" {{ block.shopify_attributes }}>
  <homepage-section-sync
    id="HomepageNewsletterSync-{{ block.id }}"
    data-homepage-newsletter-sync
    data-source-section-key="1786674497042b635a"
    data-homepage-url="{{ routes.root_url }}"
    style="display: block;"
  ></homepage-section-sync>
</div>

{% schema %}
{
  "name": "Homepage newsletter sync",
  "settings": [{"type":"text","id":"anchor_id","label":"锚点ID","info":"Use the same value in navigation links, without the # symbol."}],
  "presets": [{"name":"Homepage newsletter sync"}]
}
{% endschema %}
