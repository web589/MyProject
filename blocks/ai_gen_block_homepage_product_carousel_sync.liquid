{% comment %}
  Product pages reuse the complete rendered homepage product carousel.
  Homepage block settings and live Shopify product data remain the single
  source for products, prices, inventory states, badges, styles and scripts.
{% endcomment %}
{% assign pdp_anchor_id = block.settings.anchor_id | handle %}
<div{% if pdp_anchor_id != blank %} id="{{ pdp_anchor_id }}"{% endif %} class="pdp-anchor-target" {{ block.shopify_attributes }}>
  <homepage-section-sync
    id="HomepageProductCarouselSync-{{ block.id }}"
    data-homepage-product-carousel-sync
    data-source-section-key="17864389448c0111e2"
    data-homepage-url="{{ routes.root_url }}"
    style="display: block;"
  ></homepage-section-sync>
</div>

{% schema %}
{
  "name": "Homepage product sync",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Use the same value in navigation links, without the # symbol."
    }
  ],
  "blocks": [
    {
      "type": "venus_product_category"
    }
  ],
  "presets": [
    {
      "name": "Homepage product sync"
    }
  ]
}
{% endschema %}
