{% comment %}
  Product pages reuse the rendered homepage testimonial section instead of
  keeping a second set of block settings. This makes the homepage the only
  content and style source for this module.
{% endcomment %}
{% assign pdp_anchor_id = block.settings.anchor_id | handle %}
<div{% if pdp_anchor_id != blank %} id="{{ pdp_anchor_id }}"{% endif %} class="pdp-anchor-target" {{ block.shopify_attributes }}>
  <homepage-section-sync
    id="HomepageTestimonialsSync-{{ block.id }}"
    data-homepage-testimonials-sync
    data-source-section-key="17866880723359951f"
    data-homepage-url="{{ routes.root_url }}"
    style="display: block;"
  ></homepage-section-sync>
</div>

{% schema %}
{
  "name": "Homepage testimonial sync",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Use the same value in navigation links, without the # symbol."
    }
  ],
  "presets": [
    {
      "name": "Homepage testimonial sync"
    }
  ]
}
{% endschema %}
