{% liquid
  assign logo_alt = block.settings.alt_text | default: block.settings.fallback_label
%}

<div
  class="ai-media-scroll__item{% if block.settings.image != blank %} ai-media-scroll__item--has-image{% endif %}"
  data-media-logo-item
  {{ block.shopify_attributes }}
>
  {% if block.settings.link != blank %}
    <a class="ai-media-scroll__item-link" href="{{ block.settings.link | escape }}"{% if block.settings.open_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>
  {% else %}
    <div class="ai-media-scroll__item-link">
  {% endif %}

    {% if block.settings.image != blank %}
      {{
        block.settings.image
        | image_url: width: block.settings.image.width
        | image_tag:
          class: 'ai-media-scroll__item-image',
          loading: 'lazy',
          widths: '200, 320, 480, 640, 800, 1200',
          sizes: '(max-width: 768px) 70vw, 25vw',
          width: block.settings.image.width,
          height: block.settings.image.height,
          alt: logo_alt
      }}
    {% elsif block.settings.fallback_label != blank %}
      <span>{{ block.settings.fallback_label }}</span>
    {% else %}
      {{ 'image' | placeholder_svg_tag: 'ai-media-scroll__item-image placeholder-svg' }}
    {% endif %}

  {% if block.settings.link != blank %}
    </a>
  {% else %}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Media logo",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Logo image"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Image alt text",
      "info": "Describe the publication or brand shown in the image."
    },
    {
      "type": "text",
      "id": "fallback_label",
      "label": "Fallback text",
      "info": "Shown until an image is selected.",
      "default": "Media logo"
    },
    {
      "type": "text",
      "id": "link",
      "label": "Link",
      "info": "Enter an internal path or a complete external URL, such as https://example.com. Leave blank to disable clicking."
    },
    {
      "type": "checkbox",
      "id": "open_new_tab",
      "label": "Open link in a new tab",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Media logo"
    }
  ]
}
{% endschema %}
