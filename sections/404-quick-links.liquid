{{ '404-page.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign models_collection = collections['venus-e']
  assign models_url = models_collection.url | default: '/collections/venus-e'
  assign accessory_product = all_products['ct002-smart-meter']
  assign accessory_url = accessory_product.url | default: '/products/ct002-smart-meter'
  assign guide_url = '/blogs/blog-center'
  assign faq_page = pages['faq']
  assign faq_url = faq_page.url | default: '/pages/faq'
  assign quick_background = section.settings.background_color | default: '#ffffff'
  assign card_background = section.settings.card_background | default: '#ffffff'
  assign quick_columns = section.settings.desktop_columns | default: 4
-%}

<section
  class="venus-404 venus-404__section venus-404__quick"
  style="{% render '404-page-style', section: section %} --venus-404-section-background: {{ quick_background | escape }}; --venus-404-quick-columns: {{ quick_columns }}; --venus-404-card-background: {{ card_background | escape }};"
  aria-labelledby="venus-404-quick-title-{{ section.id }}"
>
  <div class="venus-404__section-inner">
    <p class="venus-404__eyebrow">{{ section.settings.eyebrow | default: 'Nächste Schritte' | escape }}</p>
    <h2 id="venus-404-quick-title-{{ section.id }}">
      {{ section.settings.heading_before | default: 'Finde deinen Weg' | escape }}
      <span class="venus-404__accent">{{ section.settings.heading_accent | default: 'zurück' | escape }}</span>
    </h2>

    {%- if section.blocks.size > 0 -%}
      <div class="venus-404__quick-grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign card_url = block.settings.link
            if card_url == blank
              case block.settings.destination
                when 'accessory'
                  assign card_url = accessory_url
                when 'guide'
                  assign card_url = guide_url
                when 'support'
                  assign card_url = faq_url
                else
                  assign card_url = models_url
              endcase
            endif
          -%}

          <article class="venus-404__card" {{ block.shopify_attributes }}>
            {%- if block.settings.custom_icon != blank -%}
              {{ block.settings.custom_icon | image_url: width: 160 | image_tag: class: 'venus-404__card-icon venus-404__card-icon--image', widths: '48, 72, 96, 128, 160', sizes: '80px', alt: block.settings.title, loading: 'lazy' }}
            {%- else -%}
              {%- case block.settings.icon -%}
                {%- when 'plug' -%}
                  <svg class="venus-404__card-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M9 3v6m6-6v6M7 9h10v2a5 5 0 0 1-5 5v5m0-5a5 5 0 0 1-5-5V9"></path>
                    <path d="M9 21h6"></path>
                  </svg>
                {%- when 'document' -%}
                  <svg class="venus-404__card-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M6 3h9l3 3v15H6z"></path>
                    <path d="M15 3v4h3M9 12h6M9 16h6"></path>
                  </svg>
                {%- when 'headset' -%}
                  <svg class="venus-404__card-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 13v-1a8 8 0 0 1 16 0v1"></path>
                    <path d="M4 13h3v5H5a1 1 0 0 1-1-1zm16 0h-3v5h2a1 1 0 0 1 1-1zM17 19c-1 1-2 1-3 1"></path>
                  </svg>
                {%- else -%}
                  <svg class="venus-404__card-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="3" y="7" width="16" height="10" rx="2"></rect>
                    <path d="M19 10h2v4h-2M7 10v4m3-4v4"></path>
                  </svg>
              {%- endcase -%}
            {%- endif -%}

            <h3>{{ block.settings.title | default: 'Solarspeicher entdecken' | escape }}</h3>
            <p>{{ block.settings.text | default: 'Finde den passenden VENUS E Speicher für dein Zuhause.' | escape }}</p>
            <a class="venus-404__card-link" href="{{ card_url | escape }}">
              {{ block.settings.link_label | default: 'Mehr erfahren' | escape }}
              <span aria-hidden="true">&#8594;</span>
            </a>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "404 · Schnellzugriff",
  "tag": "section",
  "class": "section-404-quick-links",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "快捷入口区域"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "眉题",
      "default": "Nächste Schritte"
    },
    {
      "type": "text",
      "id": "heading_before",
      "label": "标题前半段",
      "default": "Finde deinen Weg"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "标题高亮段",
      "default": "zurück"
    },
    {
      "type": "select",
      "id": "desktop_columns",
      "label": "桌面端列数",
      "options": [
        {
          "value": "2",
          "label": "2 列"
        },
        {
          "value": "3",
          "label": "3 列"
        },
        {
          "value": "4",
          "label": "4 列"
        }
      ],
      "default": "4"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "区域背景颜色",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "卡片背景颜色",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "字体和尺寸"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "眉题大小",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "标题大小",
      "min": 24,
      "max": 56,
      "step": 1,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "正文大小",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "item_heading_size",
      "label": "卡片标题大小",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "item_text_size",
      "label": "卡片正文大小",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "control_size",
      "label": "链接文字大小",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "图标大小",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "section_spacing",
      "label": "上下间距",
      "min": 40,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "快捷入口卡片",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "图标",
          "options": [
            {
              "value": "battery",
              "label": "电池"
            },
            {
              "value": "plug",
              "label": "插头"
            },
            {
              "value": "document",
              "label": "文档"
            },
            {
              "value": "headset",
              "label": "耳机"
            }
          ],
          "default": "battery"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "自定义图标",
          "info": "上传后优先使用此图片；留空则使用上面的内置 SVG 图标。"
        },
        {
          "type": "text",
          "id": "title",
          "label": "标题"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "说明"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "链接文字"
        },
        {
          "type": "url",
          "id": "link",
          "label": "自定义链接"
        },
        {
          "type": "select",
          "id": "destination",
          "label": "默认目标",
          "options": [
            {
              "value": "models",
              "label": "VENUS E 模型"
            },
            {
              "value": "accessory",
              "label": "Zubehör"
            },
            {
              "value": "guide",
              "label": "Energie-Wissen"
            },
            {
              "value": "support",
              "label": "Support / FAQ"
            }
          ],
          "default": "models"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "404 · Schnellzugriff",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "icon": "battery",
            "title": "Solarspeicher entdecken",
            "text": "Finde den passenden VENUS E Speicher für dein Zuhause.",
            "link_label": "Speicher ansehen",
            "destination": "models"
          }
        },
        {
          "type": "card",
          "settings": {
            "icon": "plug",
            "title": "Passendes Zubehör finden",
            "text": "Smart Meter und weiteres Zubehör für dein VENUS E System entdecken.",
            "link_label": "Zum Zubehör",
            "destination": "accessory"
          }
        },
        {
          "type": "card",
          "settings": {
            "icon": "document",
            "title": "Energie-Wissen entdecken",
            "text": "Erfahre mehr über Balkonkraftwerk mit Speicher, Nachrüstung und Energieverbrauch.",
            "link_label": "Zum Energie-Wissen",
            "destination": "guide"
          }
        },
        {
          "type": "card",
          "settings": {
            "icon": "headset",
            "title": "Hilfe & Support",
            "text": "Wir helfen dir bei Auswahl, Installation und Fragen zu deinem System.",
            "link_label": "Support öffnen",
            "destination": "support"
          }
        }
      ]
    }
  ]
}
{% endschema %}
