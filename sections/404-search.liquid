            "term": "VENUS E 3.0"
          }
        },
        {
          "type": "query",
          "settings": {
            "label": "VENUS E 4.0",
            "term": "VENUS E 4.0"
          }
        },
        {
          "type": "query",
          "settings": {
            "label": "VENUS E Max",
            "term": "VENUS E Max"
          }
        },
        {
          "type": "query",
          "settings": {
            "label": "Smart Meter CT002",
            "term": "Smart Meter CT002"
          }
        },
        {
          "type": "query",
          "settings": {
            "label": "Smart Meter CT003 (P1)",
            "term": "Smart Meter CT003 (P1)"
          }
        },
        {
