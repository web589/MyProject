{%- liquid
  assign page_id = 'ac-storage-' | append: section.id
  assign compare_url = section.settings.compare_url | default: '/pages/venus-e-vergleich'
  assign storage_url = section.settings.storage_url | default: '/pages/balkonkraftwerk-mit-speicher'
  assign eauto_url = section.settings.eauto_url | default: '/pages/e-auto'
  assign smart_meter_url = section.settings.smart_meter_url | default: '/products/ct002-smart-meter'
  assign blog_url = section.settings.blog_url | default: '/blogs/balkonkraftwerk-mit-speicher'
  assign article_1_url = section.settings.article_1_url | default: '/blogs/balkonkraftwerk-mit-speicher'
  assign article_2_url = section.settings.article_2_url | default: '/pages/venus-e-vergleich'
  assign article_3_url = section.settings.article_3_url | default: '/blogs/balkonkraftwerk-mit-speicher'

  assign product_mini = section.settings.product_mini
  assign product_3 = section.settings.product_3
  assign product_4 = section.settings.product_4
  assign product_max = section.settings.product_max
  if product_mini == blank
    assign product_mini = all_products['venus-e-mini']
  endif
  if product_3 == blank
    assign product_3 = all_products['venus-e-3']
  endif
  if product_4 == blank
    assign product_4 = all_products['venus-e-4']
  endif
  if product_max == blank
    assign product_max = all_products['venus-e-max']
  endif

  assign ct002_product = section.settings.ct002_product
  assign ct003_product = section.settings.ct003_product
  if ct002_product == blank
    assign ct002_product = all_products['ct002-smart-meter']
  endif
  if ct003_product == blank
    assign ct003_product = all_products['ct003-smart-meter']
  endif
  assign smart_meter_image = ct002_product.featured_image | default: ct003_product.featured_image
-%}

<div id="{{ page_id }}" class="ac-storage-page" data-ac-storage-page>
  {% for block in section.blocks %}
    {% assign block_id = page_id | append: '-' | append: block.id %}

    {% case block.type %}
      {% when 'hero' %}
        {% assign hero_primary_url = block.settings.primary_url | default: '#modelle' %}
        {% assign hero_secondary_url = block.settings.secondary_url | default: '#funktion' %}
        <section id="{{ block_id }}" class="ac-storage-page__hero" {{ block.shopify_attributes }}>
          <div class="ac-storage-page__wrap ac-storage-page__hero-grid">
            <div class="ac-storage-page__hero-copy">
              <p class="ac-storage-page__eyebrow">{{ block.settings.eyebrow }}</p>
              <h1>{{ block.settings.heading }}</h1>
              <p class="ac-storage-page__lead">{{ block.settings.lead }}</p>
              <div class="ac-storage-page__actions">
                <a class="ac-storage-page__button ac-storage-page__button--primary" href="{{ hero_primary_url }}">{{ block.settings.primary_label }}</a>
                <a class="ac-storage-page__button ac-storage-page__button--secondary" href="{{ hero_secondary_url }}">{{ block.settings.secondary_label }}</a>
              </div>
            </div>
            <div class="ac-storage-page__media ac-storage-page__media--hero">
              {% if block.settings.hero_image != blank %}
                {{ block.settings.hero_image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '640, 960, 1280, 1600', sizes: '(min-width: 1000px) 48vw, 100vw', alt: block.settings.hero_image_alt }}
              {% else %}
                <div class="ac-storage-page__placeholder">{{ block.settings.hero_placeholder }}</div>
              {% endif %}
            </div>
          </div>
        </section>

      {% when 'definition' %}
        <section id="{{ block_id }}" class="ac-storage-page__section ac-storage-page__answer" {{ block.shopify_attributes }}>
          <div class="ac-storage-page__wrap">
            <p class="ac-storage-page__eyebrow">{{ block.settings.eyebrow }}</p>
            <h2>{{ block.settings.heading }}</h2>
            <div class="ac-storage-page__answer-box">
              <p><strong>{{ block.settings.answer_label }}</strong> {{ block.settings.answer }}</p>
            </div>
            <div class="ac-storage-page__feature-grid">
              {% for feature_index in (1..3) %}
                {% assign feature_title_key = 'feature_' | append: feature_index | append: '_title' %}
                {% assign feature_body_key = 'feature_' | append: feature_index | append: '_body' %}
                {% assign feature_title = block.settings[feature_title_key] %}
                {% assign feature_body = block.settings[feature_body_key] %}
                {% if feature_title != blank or feature_body != blank %}
                  <article class="ac-storage-page__feature-card">
                    <span class="ac-storage-page__icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24"><path d="M12 3v18M3 12h18M5.5 5.5l13 13M18.5 5.5l-13 13"/></svg>
                    </span>
                    <h3>{{ feature_title }}</h3>
                    <p>{{ feature_body }}</p>
                  </article>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </section>

      {% when 'function' %}
        {% assign function_link_url = block.settings.link_url | default: eauto_url %}
        {% assign day_nodes = block.settings.day_nodes | split: '|' %}
        {% assign evening_nodes = block.settings.evening_nodes | split: '|' %}
        <section id="funktion" class="ac-storage-page__section ac-storage-page__function" {{ block.shopify_attributes }}>
          <div class="ac-storage-page__wrap">
            <p class="ac-storage-page__eyebrow">{{ block.settings.eyebrow }}</p>
            <h2>{{ block.settings.heading }}</h2>
            <p class="ac-storage-page__subtext">{{ block.settings.subtext }}</p>
            <div class="ac-storage-page__flow-toggle" role="tablist" aria-label="{{ block.settings.toggle_aria_label }}">
              <button type="button" role="tab" class="is-active" data-ac-flow-toggle="day" aria-selected="true" aria-controls="{{ block_id }}-day">{{ block.settings.toggle_day_label }}</button>
              <button type="button" role="tab" data-ac-flow-toggle="evening" aria-selected="false" aria-controls="{{ block_id }}-evening" tabindex="-1">{{ block.settings.toggle_evening_label }}</button>
            </div>

            <div id="{{ block_id }}-day" class="ac-storage-page__flow-panel" data-ac-flow-panel="day" role="tabpanel" aria-hidden="false">
              <div class="ac-storage-page__media ac-storage-page__media--flow">
                {% if block.settings.day_image != blank %}
                  {{ block.settings.day_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '640, 960, 1280, 1600', sizes: '100vw', alt: block.settings.day_image_alt }}
                {% else %}
                  <div class="ac-storage-page__placeholder">{{ block.settings.day_placeholder }}</div>
                {% endif %}
              </div>
              <div class="ac-storage-page__flow-nodes">
                {% for node in day_nodes %}
                  {% assign clean_node = node | strip %}
                  {% if clean_node != blank %}<span><i aria-hidden="true"></i>{{ clean_node }}</span>{% endif %}
                {% endfor %}
              </div>
            </div>
            <div id="{{ block_id }}-evening" class="ac-storage-page__flow-panel" data-ac-flow-panel="evening" role="tabpanel" aria-hidden="true" hidden>
              <div class="ac-storage-page__media ac-storage-page__media--flow">
                {% if block.settings.evening_image != blank %}
                  {{ block.settings.evening_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '640, 960, 1280, 1600', sizes: '100vw', alt: block.settings.evening_image_alt }}
                {% else %}
                  <div class="ac-storage-page__placeholder">{{ block.settings.evening_placeholder }}</div>
                {% endif %}
              </div>
              <div class="ac-storage-page__flow-nodes">
                {% for node in evening_nodes %}
                  {% assign clean_node = node | strip %}
                  {% if clean_node != blank %}<span><i aria-hidden="true"></i>{{ clean_node }}</span>{% endif %}
                {% endfor %}
              </div>
            </div>

            <div class="ac-storage-page__steps">
              {% for step_index in (1..3) %}
                {% assign step_title_key = 'step_' | append: step_index | append: '_title' %}
                {% assign step_body_key = 'step_' | append: step_index | append: '_body' %}
                <article class="ac-storage-page__step">
                  <span class="ac-storage-page__step-number">0{{ step_index }}</span>
                  <h3>{{ block.settings[step_title_key] }}</h3>
                  <p>{{ block.settings[step_body_key] }}</p>
                </article>
              {% endfor %}
            </div>
            <a class="ac-storage-page__link" href="{{ function_link_url }}">{{ block.settings.link_label }}</a>
          </div>
        </section>

      {% when 'why' %}
        {% assign why_cta_url = block.settings.cta_url | default: '#modelle' %}
        <section id="{{ block_id }}" class="ac-storage-page__section ac-storage-page__why" {{ block.shopify_attributes }}>
          <div class="ac-storage-page__wrap">
            <p class="ac-storage-page__eyebrow">{{ block.settings.eyebrow }}</p>
            <h2>{{ block.settings.heading }}</h2>
            <p class="ac-storage-page__subtext">{{ block.settings.subtext }}</p>
            <div class="ac-storage-page__why-grid">
              {% for card_index in (1..2) %}
                {% assign card_title_key = 'card_' | append: card_index | append: '_title' %}
                {% assign card_body_key = 'card_' | append: card_index | append: '_body' %}
                {% assign card_image_key = 'card_' | append: card_index | append: '_image' %}
                {% assign card_alt_key = 'card_' | append: card_index | append: '_alt' %}
                {% assign card_placeholder_key = 'card_' | append: card_index | append: '_placeholder' %}
                <article class="ac-storage-page__why-card">
                  <div class="ac-storage-page__media ac-storage-page__media--why">
                    {% if block.settings[card_image_key] != blank %}
                      {{ block.settings[card_image_key] | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1000', sizes: '(min-width: 1000px) 50vw, 100vw', alt: block.settings[card_alt_key] }}
                    {% else %}
                      <div class="ac-storage-page__placeholder">{{ block.settings[card_placeholder_key] }}</div>
                    {% endif %}
                  </div>
                  <div class="ac-storage-page__card-body">
                    <h3>{{ block.settings[card_title_key] }}</h3>
                    <p>{{ block.settings[card_body_key] }}</p>
                  </div>
                </article>
              {% endfor %}
              {% for stat_index in (1..2) %}
                {% assign stat_title_key = 'stat_' | append: stat_index | append: '_title' %}
                {% assign stat_body_key = 'stat_' | append: stat_index | append: '_body' %}
                {% assign stat_tag_key = 'stat_' | append: stat_index | append: '_tag' %}
                <article class="ac-storage-page__why-stat">
                  <span class="ac-storage-page__step-number">0{{ stat_index }}</span>
                  <h3>{{ block.settings[stat_title_key] }}</h3>
                  <p>{{ block.settings[stat_body_key] }}</p>
                  <span class="ac-storage-page__tag">{{ block.settings[stat_tag_key] }}</span>
                </article>
              {% endfor %}
            </div>
            <div class="ac-storage-page__center-cta">
              <a class="ac-storage-page__link" href="{{ why_cta_url }}">{{ block.settings.cta_label }}</a>
            </div>
          </div>
        </section>

      {% when 'comparison' %}
        {% assign comparison_link_url = block.settings.link_url | default: compare_url %}
        <section id="{{ block_id }}" class="ac-storage-page__section ac-storage-page__comparison" {{ block.shopify_attributes }}>
          <div class="ac-storage-page__wrap">
            <p class="ac-storage-page__eyebrow">{{ block.settings.eyebrow }}</p>
            <h2>{{ block.settings.heading }}</h2>
            <p class="ac-storage-page__subtext">{{ block.settings.subtext }}</p>
            <div class="ac-storage-page__table-wrap">
              <table>
                <thead>
                  <tr>
                    <th scope="col">{{ block.settings.table_feature_heading }}</th>
                    <th scope="col" class="is-highlight">{{ block.settings.table_ac_heading }}</th>
                    <th scope="col">{{ block.settings.table_dc_heading }}</th>
                  </tr>
                </thead>
                <tbody>
                  {% for row_index in (1..5) %}
                    {% assign row_label_key = 'row_' | append: row_index | append: '_label' %}
                    {% assign row_ac_key = 'row_' | append: row_index | append: '_ac' %}
                    {% assign row_dc_key = 'row_' | append: row_index | append: '_dc' %}
                    <tr>
                      <th scope="row">{{ block.settings[row_label_key] }}</th>
                      <td>{{ block.settings[row_ac_key] }}</td>
                      <td>{{ block.settings[row_dc_key] }}</td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
            <p class="ac-storage-page__comparison-note">{{ block.settings.note }}</p>
            <a class="ac-storage-page__link" href="{{ comparison_link_url }}">{{ block.settings.link_label }}</a>
          </div>
        </section>

      {% when 'smart' %}
        {% assign smart_link_url = block.settings.link_url | default: smart_meter_url %}
        <section id="{{ block_id }}" class="ac-storage-page__section ac-storage-page__smart" {{ block.shopify_attributes }}>
          <div class="ac-storage-page__wrap">
            <p class="ac-storage-page__eyebrow">{{ block.settings.eyebrow }}</p>
            <h2>{{ block.settings.heading }}</h2>
            <p class="ac-storage-page__subtext">{{ block.settings.subtext }}</p>
            <div class="ac-storage-page__smart-grid">
              <div>
                <div class="ac-storage-page__smart-steps">
                  {% for step_index in (1..3) %}
                    {% assign smart_title_key = 'step_' | append: step_index | append: '_title' %}
                    {% assign smart_body_key = 'step_' | append: step_index | append: '_body' %}
                    <article class="ac-storage-page__smart-step">
                      <span class="ac-storage-page__smart-number">0{{ step_index }}</span>
                      <div>
                        <h3>{{ block.settings[smart_title_key] }}</h3>
                        <p>{{ block.settings[smart_body_key] }}</p>
                      </div>
                    </article>
                  {% endfor %}
                </div>
                <a class="ac-storage-page__link" href="{{ smart_link_url }}">{{ block.settings.link_label }}</a>
              </div>
              <div class="ac-storage-page__smart-visuals">
                <div class="ac-storage-page__media ac-storage-page__media--smart-main">
                  {% if block.settings.main_image != blank %}
                    {{ block.settings.main_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '640, 960, 1200, 1400', sizes: '(min-width: 1000px) 42vw, 100vw', alt: block.settings.main_image_alt }}
                  {% else %}
                    <div class="ac-storage-page__placeholder">{{ block.settings.main_placeholder }}</div>
                  {% endif %}
                </div>
                <div class="ac-storage-page__smart-small-grid">
                  <div class="ac-storage-page__media ac-storage-page__media--smart-small">
                    {% if block.settings.app_image != blank %}
                      {{ block.settings.app_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '360, 560, 800', sizes: '(min-width: 1000px) 21vw, 100vw', alt: block.settings.app_image_alt }}
                    {% else %}
                      <div class="ac-storage-page__placeholder">{{ block.settings.app_placeholder }}</div>
                    {% endif %}
                  </div>
                  <div class="ac-storage-page__media ac-storage-page__media--smart-small">
                    {% if block.settings.meter_image != blank %}
                      {{ block.settings.meter_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '360, 560, 800', sizes: '(min-width: 1000px) 21vw, 100vw', alt: block.settings.meter_image_alt }}
                    {% elsif smart_meter_image != blank %}
                      {{ smart_meter_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '360, 560, 800', sizes: '(min-width: 1000px) 21vw, 100vw', alt: block.settings.meter_image_alt }}
                    {% else %}
                      <div class="ac-storage-page__placeholder">{{ block.settings.meter_placeholder }}</div>
                    {% endif %}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

      {% when 'audience' %}
        {% assign audience_link_url = block.settings.link_url | default: eauto_url %}
        <section id="{{ block_id }}" class="ac-storage-page__section ac-storage-page__audience" {{ block.shopify_attributes }}>
          <div class="ac-storage-page__wrap">
            <p class="ac-storage-page__eyebrow">{{ block.settings.eyebrow }}</p>
            <h2>{{ block.settings.heading }}</h2>
            <div class="ac-storage-page__audience-grid">
              {% for card_index in (1..4) %}
                {% assign audience_title_key = 'card_' | append: card_index | append: '_title' %}
                {% assign audience_body_key = 'card_' | append: card_index | append: '_body' %}
                {% assign audience_image_key = 'card_' | append: card_index | append: '_image' %}
                {% assign audience_alt_key = 'card_' | append: card_index | append: '_alt' %}
                {% assign audience_placeholder_key = 'card_' | append: card_index | append: '_placeholder' %}
                <article class="ac-storage-page__audience-card">
                  <div class="ac-storage-page__media ac-storage-page__media--audience">
                    {% if block.settings[audience_image_key] != blank %}
                      {{ block.settings[audience_image_key] | image_url: width: 800 | image_tag: loading: 'lazy', widths: '360, 560, 800', sizes: '(min-width: 1000px) 25vw, 100vw', alt: block.settings[audience_alt_key] }}
                    {% else %}
                      <div class="ac-storage-page__placeholder">{{ block.settings[audience_placeholder_key] }}</div>
                    {% endif %}
                  </div>
                  <div class="ac-storage-page__card-body">
                    <h3>{{ block.settings[audience_title_key] }}</h3>
                    <p>{{ block.settings[audience_body_key] }}</p>
                  </div>
                </article>
              {% endfor %}
            </div>
            <a class="ac-storage-page__link" href="{{ audience_link_url }}">{{ block.settings.link_label }}</a>
          </div>
        </section>

      {% when 'models' %}
        <section id="modelle" class="ac-storage-page__section ac-storage-page__models" {{ block.shopify_attributes }}>
          <div class="ac-storage-page__wrap">
            <p class="ac-storage-page__eyebrow">{{ block.settings.eyebrow }}</p>
            <h2>{{ block.settings.heading }}</h2>
            <p class="ac-storage-page__subtext">{{ block.settings.subtext }}</p>
            <div class="ac-storage-page__models-grid">
              {% for model_index in (1..4) %}
                {% case model_index %}
                  {% when 1 %}{% assign model_product = product_mini %}
                  {% when 2 %}{% assign model_product = product_3 %}
                  {% when 3 %}{% assign model_product = product_4 %}
                  {% when 4 %}{% assign model_product = product_max %}
                {% endcase %}
                {% assign model_name_key = 'model_' | append: model_index | append: '_name' %}
                {% assign model_copy_key = 'model_' | append: model_index | append: '_copy' %}
                {% assign model_alt_key = 'model_' | append: model_index | append: '_alt' %}
                {% assign model_name = block.settings[model_name_key] | default: model_product.title %}
                {% assign model_url = model_product.url | default: storage_url %}
                <article class="ac-storage-page__model-card">
                  <a class="ac-storage-page__media ac-storage-page__media--model" href="{{ model_url }}">
                    {% if model_product.featured_image != blank %}
                      {{ model_product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '360, 560, 800', sizes: '(min-width: 1000px) 25vw, 100vw', alt: block.settings[model_alt_key] | default: model_name }}
                    {% else %}
                      <span class="ac-storage-page__placeholder">{{ model_name }}</span>
                    {% endif %}
                  </a>
                  <div class="ac-storage-page__card-body">
                    <h3>{{ model_name }}</h3>
                    <p>{{ block.settings[model_copy_key] }}</p>
                    <a class="ac-storage-page__link" href="{{ model_url }}">{{ block.settings.card_link_label }}</a>
                  </div>
                </article>
              {% endfor %}
            </div>
            <div class="ac-storage-page__models-actions">
              <a class="ac-storage-page__button ac-storage-page__button--primary" href="{{ block.settings.compare_url | default: compare_url }}">{{ block.settings.compare_label }}</a>
              <a class="ac-storage-page__button ac-storage-page__button--secondary" href="{{ block.settings.storage_url | default: storage_url }}">{{ block.settings.storage_label }}</a>
            </div>
          </div>
        </section>

      {% when 'faq' %}
        <section id="{{ block_id }}" class="ac-storage-page__section ac-storage-page__faq" {{ block.shopify_attributes }}>
          <div class="ac-storage-page__wrap">
            <p class="ac-storage-page__eyebrow">{{ block.settings.eyebrow }}</p>
            <h2>{{ block.settings.heading }}</h2>
            <div class="ac-storage-page__faq-list">
              {% for faq_index in (1..7) %}
                {% assign faq_question_key = 'question_' | append: faq_index %}
                {% assign faq_answer_key = 'answer_' | append: faq_index %}
                {% assign faq_question = block.settings[faq_question_key] %}
                {% assign faq_answer = block.settings[faq_answer_key] %}
                {% if faq_question != blank %}
                  <article class="ac-storage-page__faq-item" data-ac-faq-item>
                    <button class="ac-storage-page__faq-question" type="button" data-ac-faq-question aria-expanded="false" aria-controls="{{ block_id }}-faq-{{ faq_index }}">
                      {{ faq_question }}<span aria-hidden="true">+</span>
                    </button>
                    <div id="{{ block_id }}-faq-{{ faq_index }}" class="ac-storage-page__faq-answer" data-ac-faq-answer hidden>
                      <p>{{ faq_answer }}</p>
                    </div>
                  </article>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </section>

      {% when 'blog' %}
        <section id="{{ block_id }}" class="ac-storage-page__section ac-storage-page__blog" {{ block.shopify_attributes }}>
          <div class="ac-storage-page__wrap">
            <p class="ac-storage-page__eyebrow">{{ block.settings.eyebrow }}</p>
            <h2>{{ block.settings.heading }}</h2>
            <div class="ac-storage-page__blog-grid">
              {% for article_index in (1..3) %}
                {% assign article_tag_key = 'article_' | append: article_index | append: '_tag' %}
                {% assign article_title_key = 'article_' | append: article_index | append: '_title' %}
                {% assign article_copy_key = 'article_' | append: article_index | append: '_copy' %}
                {% assign article_image_key = 'article_' | append: article_index | append: '_image' %}
                {% assign article_alt_key = 'article_' | append: article_index | append: '_alt' %}
                {% assign article_placeholder_key = 'article_' | append: article_index | append: '_placeholder' %}
                {% case article_index %}
                  {% when 1 %}{% assign article_url = article_1_url %}
                  {% when 2 %}{% assign article_url = article_2_url %}
                  {% when 3 %}{% assign article_url = article_3_url %}
                {% endcase %}
                <article class="ac-storage-page__blog-card">
                  <a class="ac-storage-page__media ac-storage-page__media--blog" href="{{ article_url }}">
                    {% if block.settings[article_image_key] != blank %}
                      {{ block.settings[article_image_key] | image_url: width: 900 | image_tag: loading: 'lazy', widths: '420, 640, 900', sizes: '(min-width: 1000px) 33vw, 100vw', alt: block.settings[article_alt_key] }}
                    {% else %}
                      <span class="ac-storage-page__placeholder">{{ block.settings[article_placeholder_key] }}</span>
                    {% endif %}
                  </a>
                  <div class="ac-storage-page__card-body">
                    <span class="ac-storage-page__tag">{{ block.settings[article_tag_key] }}</span>
                    <h3>{{ block.settings[article_title_key] }}</h3>
                    <p>{{ block.settings[article_copy_key] }}</p>
                    <a class="ac-storage-page__link" href="{{ article_url }}">{{ block.settings.card_link_label }}</a>
                  </div>
                </article>
              {% endfor %}
            </div>
            <a class="ac-storage-page__link" href="{{ block.settings.blog_url | default: blog_url }}">{{ block.settings.blog_link_label }}</a>
          </div>
        </section>

      {% when 'final' %}
        <section id="{{ block_id }}" class="ac-storage-page__section ac-storage-page__final" {{ block.shopify_attributes }}>
          <div class="ac-storage-page__wrap">
            <div class="ac-storage-page__final-card">
              <h2>{{ block.settings.heading }}</h2>
              <p>{{ block.settings.copy }}</p>
              <div class="ac-storage-page__actions">
                <a class="ac-storage-page__button ac-storage-page__button--primary" href="{{ block.settings.primary_url | default: compare_url }}">{{ block.settings.primary_label }}</a>
                <a class="ac-storage-page__button ac-storage-page__button--secondary" href="{{ block.settings.secondary_url | default: storage_url }}">{{ block.settings.secondary_label }}</a>
                <a class="ac-storage-page__link" href="{{ block.settings.link_url | default: eauto_url }}">{{ block.settings.link_label }}</a>
              </div>
            </div>
          </div>
        </section>
    {% endcase %}
  {% endfor %}
</div>

{%- assign faq_schema_count = 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for block in section.blocks %}
      {% if block.type == 'faq' %}
        {% for faq_index in (1..7) %}
          {% assign faq_question_key = 'question_' | append: faq_index %}
          {% assign faq_answer_key = 'answer_' | append: faq_index %}
          {% assign faq_question = block.settings[faq_question_key] %}
          {% assign faq_answer = block.settings[faq_answer_key] %}
          {% if faq_question != blank %}
            {% if faq_schema_count > 0 %},{% endif %}
            {"@type":"Question","name":{{ faq_question | json }},"acceptedAnswer":{"@type":"Answer","text":{{ faq_answer | strip_html | json }}}}
            {% assign faq_schema_count = faq_schema_count | plus: 1 %}
          {% endif %}
        {% endfor %}
      {% endif %}
    {% endfor %}
  ]
}
</script>

