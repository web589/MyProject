{%- comment -%} AC storage editor section: anchor navigation {%- endcomment -%}
{% liquid
  assign navigation_anchor = section.settings.anchor_id | default: 'ac-storage-navigation' | handle
%}

<nav
  id="{{ navigation_anchor }}"
  class="ac-storage-anchor-nav bw-storage bw-storage-section bw-anchor-nav bw-anchor-target"
  data-ac-storage-anchor-nav
  data-bw-anchor-nav
  data-section-id="{{ section.id }}"
  style="--ac-nav-height: {{ section.settings.nav_height | default: 72 }}px; --ac-nav-text-size: {{ section.settings.nav_text_size | default: 13 }}px;"
  aria-label="{{ section.settings.aria_label | escape }}"
  {{ section.shopify_attributes }}
>
  <div class="bw-container bw-anchor-nav__inner">
    {% for block in section.blocks %}
      {% assign link_module = block.settings.module | default: 'custom' %}
      {% capture link_target %}{% render 'anchor-navigation-target', module: link_module, fallback: block.settings.target %}{% endcapture %}
      {% assign link_target = link_target | strip | remove_first: '#' | handle %}
      {% if block.type == 'link' and block.settings.label != blank and link_target != blank %}
        <a
          class="bw-anchor-nav__link"
          href="#{{ link_target }}"
          data-ac-anchor-link
          data-bw-anchor-link
          data-bw-anchor-module="{{ link_module | escape }}"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.label | escape }}
        </a>
      {% endif %}
    {% endfor %}

  </div>
</nav>

{% schema %}
{
  "name": "AC Ankernavigation",
  "tag": "section",
  "class": "ac-storage-anchor-nav-section",
  "settings": [
    {
      "type": "text",
      "id": "aria_label",
      "label": "无障碍标签",
      "default": "Seitennavigation"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "锚点ID",
      "info": "Ohne # eingeben; die ID muss auf dieser Seite eindeutig sein.",
      "default": "ac-storage-navigation"
    },
    {
      "type": "range",
      "id": "nav_height",
      "label": "导航高度",
      "min": 44,
      "max": 84,
      "step": 2,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "nav_text_size",
      "label": "导航文字大小",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Navigationslink",
      "settings": [
        {
          "type": "select",
          "id": "module",
          "label": "链接到模块",
          "options": [
            { "value": "ac_definition", "label": "AC-Speicher · Was ist AC-Speicher?" },
            { "value": "ac_function", "label": "AC-Speicher · Funktionsweise" },
            { "value": "ac_why", "label": "AC-Speicher · Vorteile" },
            { "value": "ac_comparison", "label": "AC-Speicher · AC oder DC?" },
            { "value": "ac_smart", "label": "AC-Speicher · Intelligente Steuerung" },
            { "value": "ac_audience", "label": "AC-Speicher · Zielgruppen" },
            { "value": "ac_models", "label": "AC-Speicher · Modelle" },
            { "value": "ac_faq", "label": "AC-Speicher · FAQ" },
            { "value": "ac_blog", "label": "AC-Speicher · Ratgeber" },
            { "value": "custom", "label": "自定义锚点（高级）" }
          ],
          "default": "custom"
        },
        {
          "type": "text",
          "id": "label",
          "label": "标签",
          "default": "Navigation",
          "info": "模块决定链接目标；此处仅用于自定义导航显示文字。"
        },
        {
          "type": "text",
          "id": "target",
          "label": "自定义锚点 ID（高级）",
          "info": "仅当上方选择“自定义锚点”时填写，可带或不带 #。",
          "visible_if": "{{ block.settings.module == 'custom' }}"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "AC-Speicher – Ankernavigation",
      "blocks": [
        { "type": "link", "settings": { "label": "Was ist AC-Speicher?", "module": "ac_definition" } },
        { "type": "link", "settings": { "label": "Funktionsweise", "module": "ac_function" } },
        { "type": "link", "settings": { "label": "Vorteile", "module": "ac_why" } },
        { "type": "link", "settings": { "label": "AC oder DC?", "module": "ac_comparison" } },
        { "type": "link", "settings": { "label": "Intelligente Steuerung", "module": "ac_smart" } },
        { "type": "link", "settings": { "label": "Zielgruppen", "module": "ac_audience" } },
        { "type": "link", "settings": { "label": "Modelle", "module": "ac_models" } },
        { "type": "link", "settings": { "label": "FAQ", "module": "ac_faq" } },
        { "type": "link", "settings": { "label": "Ratgeber", "module": "ac_blog" } }
      ]
    }
  ]
}
{% endschema %}
