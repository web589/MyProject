{%- comment -%} AC storage editor section: audiences {%- endcomment -%}
{% render 'ac-storage-module', module: 'audience', section: section %}

{% schema %}
{
  "name": "07 Zielgruppen",
  "tag": "section",
  "class": "ac-storage-audience-section",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Zielgruppen"},
    {"type":"text","id":"heading","label":"Überschrift","default":"Für wen ist ein AC-gekoppelter Speicher besonders interessant?"},
    {"type":"text","id":"link_label","label":"Weiterführender Link","default":"Zur Lösung für E-Auto & Speicher →"},
    {"type":"url","id":"link_url","label":"Weiterführender Link Ziel"}
  ],
  "blocks": [
    {
      "type":"audience_card",
      "name":"Zielgruppenkarte",
      "settings":[
        {"type":"text","id":"title","label":"Titel","default":"Zielgruppe"},
        {"type":"textarea","id":"body","label":"Text","default":"Beschreibung der Zielgruppe."},
        {"type":"image_picker","id":"image","label":"Bild"},
        {"type":"text","id":"alt","label":"Alt-Text","default":"AC-gekoppelter Speicher im Haushalt"},
        {"type":"textarea","id":"placeholder","label":"Bild-Platzhalter","default":"Szenenbild auswählen"}
      ]
    }
  ],
  "max_blocks": 8,
  "presets":[{"name":"07 Zielgruppen","blocks":[{"type":"audience_card","settings":{"title":"Für Haushalte mit bestehender PV-Lösung","body":"Wenn du bereits Solarstrom erzeugst, aber mehr davon selbst nutzen möchtest, ist ein Speicher eine logische Erweiterung.","alt":"Haus mit bestehender Photovoltaikanlage","placeholder":"Szenenbild auswählen: Haus mit bestehender PV"}},{"type":"audience_card","settings":{"title":"Für Balkonkraftwerk-Nutzer mit wachsendem Bedarf","body":"Wer klein startet und später mehr Unabhängigkeit will, kann schrittweise aufrüsten.","alt":"Balkonkraftwerk und Speicher an einem Wohnhaus","placeholder":"Szenenbild auswählen: Balkonkraftwerk und Speicher"}},{"type":"audience_card","settings":{"title":"Für Haushalte mit Verbrauch am Abend oder in der Nacht","body":"Wenn Strom vor allem dann gebraucht wird, wenn die Sonne nicht mehr scheint, wird ein Speicher besonders relevant.","alt":"Abendlicher Stromverbrauch in einem Haushalt","placeholder":"Szenenbild auswählen: abendlicher oder nächtlicher Verbrauch"}},{"type":"audience_card","settings":{"title":"Für Haushalte mit Wallbox oder E-Auto","body":"Wer zusätzliche Verbraucher im Haushalt hat, profitiert oft stärker von einer intelligenten Nutzung des gespeicherten Stroms.","alt":"Wallbox und E-Auto an einem Haus","placeholder":"Szenenbild auswählen: Wallbox und E-Auto"}}]}
]}
{% endschema %}
