{%- comment -%} AC storage editor section: AC vs DC comparison {%- endcomment -%}
{% render 'ac-storage-module', module: 'comparison', section: section %}

{% schema %}
{
  "name": "05 AC oder DC",
  "tag": "section",
  "class": "ac-storage-comparison-section",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Einordnung"},
    {"type":"text","id":"heading","label":"Überschrift","default":"AC- oder DC-Speicher – was ist der Unterschied?"},
    {"type":"textarea","id":"subtext","label":"Beschreibung","default":"Beide Konzepte haben ihre Berechtigung. Für viele Haushalte ist jedoch entscheidend, ob ein Speicher in ein bestehendes System integriert oder von Anfang an mitgeplant wird."},
    {"type":"text","id":"table_feature_heading","label":"Tabellenkopf Merkmal","default":"Merkmal"},
    {"type":"text","id":"table_ac_heading","label":"Tabellenkopf AC","default":"AC-gekoppelt"},
    {"type":"text","id":"table_dc_heading","label":"Tabellenkopf DC","default":"DC-gekoppelt"},
    {"type":"textarea","id":"note","label":"Hinweis unter der Tabelle","default":"Wenn du bereits eine PV-Lösung nutzt oder schrittweise erweitern möchtest, ist ein AC-gekoppelter Speicher oft der naheliegendere Weg."},
    {"type":"text","id":"link_label","label":"Weiterführender Link","default":"Mehr zu AC vs. DC Speicher →"},
    {"type":"url","id":"link_url","label":"Weiterführender Link Ziel"}
  ],
  "blocks": [
    {
      "type":"row",
      "name":"Vergleichszeile",
      "settings":[
        {"type":"text","id":"label","label":"Merkmal","default":"Merkmal"},
        {"type":"textarea","id":"ac","label":"AC-gekoppelt","default":"AC-Inhalt"},
        {"type":"textarea","id":"dc","label":"DC-gekoppelt","default":"DC-Inhalt"}
      ]
    }
  ],
  "max_blocks": 10,
  "presets":[{"name":"05 AC oder DC","blocks":[{"type":"row","settings":{"label":"Typischer Einsatz","ac":"Nachrüstung und schrittweise Erweiterung","dc":"Neue PV-Planung von Anfang an"}},{"type":"row","settings":{"label":"Integration","ac":"Über das Hausnetz","dc":"Direkt auf der DC-Seite der PV-Anlage"}},{"type":"row","settings":{"label":"Eignung für bestehende Systeme","ac":"Besonders interessant für Nachrüstung","dc":"Häufig bei neuer PV-Planung integriert"}},{"type":"row","settings":{"label":"Flexibilität","ac":"Hohe Flexibilität bei Standort und Erweiterung","dc":"Flexibilität abhängig von der Systemplanung"}},{"type":"row","settings":{"label":"Fokus","ac":"Bestehendes System einfacher ergänzen","dc":"Von Anfang an im Gesamtsystem mitplanen"}}]}
]}
{% endschema %}
