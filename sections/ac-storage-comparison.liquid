{%- comment -%} AC storage editor section: AC vs DC comparison {%- endcomment -%}
{% render 'ac-storage-module', module: 'comparison', section: section %}

{% schema %}
{
  "name": "05 AC oder DC",
  "tag": "section",
  "class": "ac-storage-comparison-section",
  "settings": [
    {"type":"text","id":"eyebrow","label":"眉题","default":"Einordnung"},
    {"type":"text","id":"heading","label":"标题","default":"AC- oder DC-Speicher – was ist der Unterschied?"},
    {"type":"text","id":"heading_accent","label":"标题强调部分","default":"was ist der Unterschied?"},
    {"type":"textarea","id":"subtext","label":"补充文字","default":"Beide Konzepte haben ihre Berechtigung. Für viele Haushalte ist jedoch entscheidend, ob ein Speicher in ein bestehendes System integriert oder von Anfang an mitgeplant wird."},
    {"type":"range","id":"section_padding","label":"区块内边距","min":40,"max":120,"step":4,"unit":"px","default":72},
    {"type":"range","id":"content_width","label":"内容宽度","min":960,"max":1600,"step":20,"unit":"px","default":1440},
    {"type":"range","id":"eyebrow_size","label":"眉题大小","min":10,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"heading_size","label":"标题大小","min":24,"max":56,"step":1,"unit":"px","default":34},
    {"type":"range","id":"body_size","label":"正文大小","min":12,"max":22,"step":1,"unit":"px","default":15},
    {"type":"range","id":"table_text_size","label":"表格文本大小","min":12,"max":20,"step":1,"unit":"px","default":15},
    {"type":"text","id":"table_feature_heading","label":"表格功能标题","default":"Punkt"},
    {"type":"text","id":"table_ac_heading","label":"表格交流耦合标题","default":"AC-gekoppelter Speicher"},
    {"type":"text","id":"table_dc_heading","label":"表格直流耦合标题","default":"DC-gekoppelter Speicher"},
    {"type":"textarea","id":"note","label":"备注","default":"Wenn du bereits eine PV-Lösung nutzt oder schrittweise erweitern möchtest, ist ein AC-gekoppelter Speicher oft der naheliegendere Weg."},
    {"type":"text","id":"link_label","label":"链接标签","default":"Mehr zu AC vs. DC Speicher →"},
    {"type":"url","id":"link_url","label":"链接链接地址"}
  ],
  "blocks": [
    {
      "type":"row",
      "name":"Vergleichszeile",
      "settings":[
        {"type":"text","id":"label","label":"标签","default":"Merkmal"},
        {"type":"textarea","id":"ac","label":"交流耦合","default":"AC-Inhalt"},
        {"type":"textarea","id":"dc","label":"直流耦合","default":"DC-Inhalt"}
      ]
    }
  ],
  "max_blocks": 10,
  "presets":[{"name":"05 AC oder DC","blocks":[{"type":"row","settings":{"label":"Typischer Einsatz","ac":"Nachrüstung und schrittweise Erweiterung","dc":"Neue PV-Planung von Anfang an"}},{"type":"row","settings":{"label":"Integration","ac":"Über das Hausnetz","dc":"Direkt auf der DC-Seite der PV-Anlage"}},{"type":"row","settings":{"label":"Eignung für bestehende Systeme","ac":"Besonders interessant für Nachrüstung","dc":"Häufig bei neuer PV-Planung integriert"}},{"type":"row","settings":{"label":"Flexibilität","ac":"Hohe Flexibilität bei Standort und Erweiterung","dc":"Flexibilität abhängig von der Systemplanung"}},{"type":"row","settings":{"label":"Fokus","ac":"Bestehendes System einfacher ergänzen","dc":"Von Anfang an im Gesamtsystem mitplanen"}}]}
]}
{% endschema %}
