{%- comment -%} AC storage editor section: definition {%- endcomment -%}
{% render 'ac-storage-module', module: 'definition', section: section %}

{% schema %}
{
  "name": "02 Definition",
  "tag": "section",
  "class": "ac-storage-definition-section",
  "settings": [
    {"type":"text","id":"eyebrow","label":"眉题","default":"Definition"},
    {"type":"text","id":"heading","label":"标题","default":"Was ist ein AC-gekoppelter Speicher?"},
    {"type":"text","id":"heading_accent","label":"标题强调部分","default":"AC-gekoppelter Speicher?"},
    {"type":"text","id":"answer_label","label":"答案标签","default":"Kurz gesagt:"},
    {"type":"textarea","id":"answer","label":"答案","default":"Ein AC-gekoppelter Speicher wird nicht direkt auf der DC-Seite der Solarmodule eingebunden, sondern über das Hausnetz integriert. Dadurch eignet er sich besonders für die Nachrüstung in bestehenden Haushalten und PV-Setups."},
    {"type":"range","id":"section_padding","label":"区块内边距","min":40,"max":120,"step":4,"unit":"px","default":72},
    {"type":"range","id":"content_width","label":"内容宽度","min":960,"max":1600,"step":20,"unit":"px","default":1440},
    {"type":"range","id":"eyebrow_size","label":"眉题大小","min":10,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"heading_size","label":"标题大小","min":24,"max":56,"step":1,"unit":"px","default":34},
    {"type":"range","id":"body_size","label":"正文大小","min":12,"max":22,"step":1,"unit":"px","default":15},
    {"type":"range","id":"answer_size","label":"答案大小","min":14,"max":24,"step":1,"unit":"px","default":18}
  ],
  "blocks": [
    {
      "type":"feature",
      "name":"Vorteilskarte",
      "settings":[
        {"type":"text","id":"title","label":"标题","default":"Vorteil"},
        {"type":"textarea","id":"body","label":"正文","default":"Beschreibung des Vorteils."},
        {"type":"image_picker","id":"icon_image","label":"图标图片","info":"Optionales Bild hochladen; es ersetzt das Standard-Icon dieser Karte."},
        {"type":"range","id":"title_size","label":"标题大小","min":14,"max":24,"step":1,"unit":"px","default":18},
        {"type":"range","id":"body_size","label":"正文大小","min":12,"max":20,"step":1,"unit":"px","default":13},
        {"type":"range","id":"card_height","label":"卡片高度","min":140,"max":300,"step":10,"unit":"px","default":200},
        {"type":"range","id":"icon_size","label":"图标大小","min":16,"max":40,"step":2,"unit":"px","default":24}
      ]
    }
  ],
  "max_blocks": 6,
  "presets":[{"name":"02 Definition","blocks":[{"type":"feature","settings":{"title":"Einfach nachrüstbar","body":"Ideal, wenn du bereits ein Balkonkraftwerk oder eine bestehende PV-Lösung nutzt und später einen Speicher ergänzen möchtest."}},{"type":"feature","settings":{"title":"Flexibel im Haushalt einsetzbar","body":"Der gespeicherte Strom steht dort zur Verfügung, wo dein Haushalt ihn braucht – zum Beispiel abends, nachts oder bei höherem Verbrauch."}},{"type":"feature","settings":{"title":"Mehr Eigenverbrauch im Alltag","body":"Überschüssiger Solarstrom kann zeitversetzt genutzt werden, wenn dein Haushalt ihn wirklich braucht."}}]}
]}
{% endschema %}
