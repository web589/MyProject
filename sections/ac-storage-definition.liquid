{%- comment -%} AC storage editor section: definition {%- endcomment -%}
{% render 'ac-storage-module', module: 'definition', section: section %}

{% schema %}
{
  "name": "02 Definition",
  "tag": "section",
  "class": "ac-storage-definition-section",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Definition"},
    {"type":"text","id":"heading","label":"Überschrift","default":"Was ist ein AC-gekoppelter Speicher?"},
    {"type":"text","id":"answer_label","label":"Antwort-Label","default":"Kurz gesagt:"},
    {"type":"textarea","id":"answer","label":"Kurzantwort","default":"Ein AC-gekoppelter Speicher wird nicht direkt auf der DC-Seite der Solarmodule eingebunden, sondern über das Hausnetz integriert. Dadurch eignet er sich besonders für die Nachrüstung in bestehenden Haushalten und PV-Setups."},
    {"type":"range","id":"section_padding","label":"Innenabstand Abschnitt","min":40,"max":120,"step":4,"unit":"px","default":72},
    {"type":"range","id":"content_width","label":"Maximale Inhaltsbreite","min":960,"max":1600,"step":20,"unit":"px","default":1440},
    {"type":"range","id":"eyebrow_size","label":"Eyebrow-Schriftgröße","min":10,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"heading_size","label":"Überschrift Schriftgröße","min":24,"max":56,"step":1,"unit":"px","default":34},
    {"type":"range","id":"body_size","label":"Grundtext Schriftgröße","min":12,"max":22,"step":1,"unit":"px","default":15},
    {"type":"range","id":"answer_size","label":"Antwort Schriftgröße","min":14,"max":24,"step":1,"unit":"px","default":18}
  ],
  "blocks": [
    {
      "type":"feature",
      "name":"Vorteilskarte",
      "settings":[
        {"type":"text","id":"title","label":"Titel","default":"Vorteil"},
        {"type":"textarea","id":"body","label":"Text","default":"Beschreibung des Vorteils."},
        {"type":"range","id":"title_size","label":"Titel Schriftgröße","min":14,"max":24,"step":1,"unit":"px","default":18},
        {"type":"range","id":"body_size","label":"Text Schriftgröße","min":12,"max":20,"step":1,"unit":"px","default":13},
        {"type":"range","id":"card_height","label":"Kartenhöhe","min":140,"max":300,"step":10,"unit":"px","default":202},
        {"type":"range","id":"icon_size","label":"Icon-Größe","min":16,"max":40,"step":2,"unit":"px","default":24}
      ]
    }
  ],
  "max_blocks": 6,
  "presets":[{"name":"02 Definition","blocks":[{"type":"feature","settings":{"title":"Einfach nachrüstbar","body":"Ideal, wenn du bereits ein Balkonkraftwerk oder eine bestehende PV-Lösung nutzt und später einen Speicher ergänzen möchtest."}},{"type":"feature","settings":{"title":"Flexibel im Haushalt einsetzbar","body":"Der gespeicherte Strom steht dort zur Verfügung, wo dein Haushalt ihn braucht – zum Beispiel abends, nachts oder bei höherem Verbrauch."}},{"type":"feature","settings":{"title":"Mehr Eigenverbrauch im Alltag","body":"Überschüssiger Solarstrom kann zeitversetzt genutzt werden, wenn dein Haushalt ihn wirklich braucht."}}]}
]}
