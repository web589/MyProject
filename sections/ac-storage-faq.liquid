{%- comment -%} AC storage editor section: FAQ {%- endcomment -%}
{% render 'ac-storage-module', module: 'faq', section: section %}

{% schema %}
{
  "name": "09 常见问题",
  "tag": "section",
  "class": "ac-storage-faq-section",
  "settings": [
    {"type":"text","id":"eyebrow","label":"眉题","default":"Häufige Fragen"},
    {"type":"text","id":"heading","label":"标题","default":"Fragen zum AC-gekoppelten Speicher"},
    {"type":"range","id":"section_padding","label":"区块内边距","min":40,"max":120,"step":4,"unit":"px","default":72},
    {"type":"range","id":"content_width","label":"最大内容宽度","min":960,"max":1600,"step":20,"unit":"px","default":1440},
    {"type":"range","id":"eyebrow_size","label":"眉题字号","min":10,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"heading_size","label":"标题字号","min":24,"max":56,"step":1,"unit":"px","default":34},
    {"type":"range","id":"body_size","label":"正文字号","min":12,"max":22,"step":1,"unit":"px","default":15},
    {"type":"range","id":"question_size","label":"问题字号","min":13,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"answer_size","label":"回答字号","min":12,"max":20,"step":1,"unit":"px","default":14}
  ],
  "blocks": [
    {
      "type":"faq",
      "name":"常见问题",
      "settings":[
        {"type":"text","id":"question","label":"问题","default":"Frage zum AC-gekoppelten Speicher"},
        {"type":"textarea","id":"answer","label":"回答","default":"Antwort auf die Frage."}
      ]
    }
  ],
  "max_blocks": 12,
  "presets":[{"name":"09 常见问题","blocks":[{"type":"faq","settings":{"question":"Was bedeutet AC-gekoppelter Speicher?","answer":"Ein AC-gekoppelter Speicher wird über das Hausnetz in dein Energiesystem eingebunden. Er eignet sich besonders dann, wenn du ein bestehendes System erweitern möchtest."}},{"type":"faq","settings":{"question":"Kann ich einen AC-Speicher mit einer bestehenden PV-Anlage kombinieren?","answer":"In vielen Fällen ja. Weil der Speicher über das Hausnetz eingebunden wird, lässt er sich häufig ergänzen, ohne die bestehende PV-Anlage umzubauen. Wie gut das im Einzelfall funktioniert, hängt von deinem Hausanschluss und deiner bisherigen Konfiguration ab."}},{"type":"faq","settings":{"question":"Ist ein AC-gekoppelter Speicher gut für die Nachrüstung geeignet?","answer":"Ja, genau dafür ist dieses Konzept oft besonders interessant. Vor allem bestehende Haushalte mit PV oder Balkonkraftwerk profitieren von der flexibleren Einbindung."}},{"type":"faq","settings":{"question":"Was ist der Unterschied zwischen AC- und DC-Speicher?","answer":"AC-Speicher werden über das Hausnetz integriert, DC-Speicher direkt auf der Gleichstromseite der PV-Anlage. AC ist oft spannender für Nachrüstung, DC eher für Neuplanung."}},{"type":"faq","settings":{"question":"Kann ich mit einem AC-gekoppelten Speicher meinen Eigenverbrauch erhöhen?","answer":"Ja. Genau darin liegt einer der größten Vorteile: Überschüssiger Solarstrom kann später im Haushalt genutzt werden, statt sofort eingespeist zu werden."}},{"type":"faq","settings":{"question":"Brauche ich dafür ein Smart Meter?","answer":"Für eine intelligentere Steuerung und mehr Transparenz über Energieflüsse ist ein passender Smart Meter sehr sinnvoll."}},{"type":"faq","settings":{"question":"Ist ein AC-gekoppelter Speicher auch für Balkonkraftwerke relevant?","answer":"Ja, besonders dann, wenn du deinen selbst erzeugten Solarstrom zeitversetzt nutzen möchtest und eine flexible Erweiterung suchst."}}]}
]}
{% endschema %}
