{%- comment -%} AC storage editor section: final CTA {%- endcomment -%}
{% render 'ac-storage-module', module: 'final', section: section %}

{% schema %}
{
  "name": "11 Abschluss-CTA",
  "tag": "section",
  "class": "ac-storage-final-section",
  "settings": [
    {"type":"text","id":"heading","label":"Überschrift","default":"Du möchtest herausfinden, welche Lösung zu deinem Haushalt passt?"},
    {"type":"textarea","id":"copy","label":"Text","default":"Sieh dir die VENUS E Modelle an, vergleiche typische Einsatzbereiche oder entdecke passende Lösungen für mehr Eigenverbrauch im Alltag."}
  ],
  "blocks": [
    {
      "type":"action",
      "name":"CTA-Aktion",
      "settings":[
        {"type":"text","id":"label","label":"Beschriftung","default":"Aktion"},
        {"type":"url","id":"url","label":"Ziel"},
        {"type":"select","id":"style","label":"Stil","default":"secondary","options":[{"value":"primary","label":"Primär"},{"value":"secondary","label":"Sekundär"},{"value":"link","label":"Textlink"}]}
      ]
    }
  ],
  "max_blocks": 3,
  "presets":[{"name":"11 Abschluss-CTA","blocks":[{"type":"action","settings":{"label":"VENUS E Modelle ansehen","url":"/pages/venus-e-vergleich","style":"primary"}},{"type":"action","settings":{"label":"Balkonkraftwerk mit Speicher","url":"/pages/balkonkraftwerk-mit-speicher","style":"secondary"}},{"type":"action","settings":{"label":"E-Auto laden mit Speicher →","url":"/pages/e-auto","style":"link"}}]}
]}
{% endschema %}
