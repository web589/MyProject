{%- comment -%} AC storage editor section: final CTA {%- endcomment -%}
{% render 'ac-storage-module', module: 'final', section: section %}

{% schema %}
{
  "name": "11 Abschluss-CTA",
  "tag": "section",
  "class": "ac-storage-final-section",
  "settings": [
    {"type":"text","id":"eyebrow","label":"眉题","default":"Nächster Schritt"},
    {"type":"text","id":"heading","label":"标题","default":"Du möchtest herausfinden, welche Lösung zu deinem Haushalt passt?"},
    {"type":"textarea","id":"copy","label":"文案","default":"Sieh dir die VENUS E Modelle an, vergleiche typische Einsatzbereiche oder entdecke passende Lösungen für mehr Eigenverbrauch im Alltag."},
    {"type":"range","id":"section_padding","label":"区块内边距","min":40,"max":120,"step":4,"unit":"px","default":72},
    {"type":"range","id":"content_width","label":"内容宽度","min":960,"max":1600,"step":20,"unit":"px","default":1440},
    {"type":"range","id":"final_heading_size","label":"结尾标题大小","min":24,"max":48,"step":1,"unit":"px","default":30},
    {"type":"range","id":"final_copy_size","label":"结尾文案大小","min":12,"max":22,"step":0.5,"unit":"px","default":15.5}
  ],
  "blocks": [
    {
      "type":"action",
      "name":"CTA-Aktion",
      "settings":[
        {"type":"text","id":"label","label":"标签","default":"Aktion"},
        {"type":"url","id":"url","label":"链接地址"},
        {"type":"select","id":"style","label":"样式","default":"secondary","options":[{"value":"primary","label":"Primär"},{"value":"secondary","label":"Sekundär"},{"value":"link","label":"Textlink"}]}
      ]
    }
  ],
  "max_blocks": 3,
  "presets":[{"name":"11 Abschluss-CTA","blocks":[{"type":"action","settings":{"label":"VENUS E Modelle ansehen","url":"/pages/venus-e-vergleich","style":"primary"}},{"type":"action","settings":{"label":"Balkonkraftwerk mit Speicher","url":"/pages/balkonkraftwerk-mit-speicher","style":"secondary"}},{"type":"action","settings":{"label":"E-Auto laden mit Speicher →","url":"/pages/e-auto","style":"link"}}]}
]}
{% endschema %}
