{%- comment -%} AC storage editor section: function {%- endcomment -%}
{% render 'ac-storage-module', module: 'function', section: section %}

{% schema %}
{
  "name": "03 Funktionsweise",
  "tag": "section",
  "class": "ac-storage-function-section",
  "settings": [
    {"type":"text","id":"eyebrow","label":"眉题","default":"Funktionsweise"},
    {"type":"text","id":"heading","label":"标题","default":"So arbeitet ein AC-gekoppelter Speicher im Haushalt"},
    {"type":"text","id":"heading_accent","label":"标题强调部分","default":"im Haushalt"},
    {"type":"textarea","id":"subtext","label":"补充文字","default":"Der Solarstrom wird im Haushalt verteilt und bei Überschuss gespeichert. Wenn später mehr Strom gebraucht wird, kann der Speicher Energie wieder über das Hausnetz bereitstellen."},
    {"type":"range","id":"section_padding","label":"区块内边距","min":40,"max":120,"step":4,"unit":"px","default":72},
    {"type":"range","id":"content_width","label":"内容宽度","min":960,"max":1600,"step":20,"unit":"px","default":1440},
    {"type":"range","id":"eyebrow_size","label":"眉题大小","min":10,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"heading_size","label":"标题大小","min":24,"max":56,"step":1,"unit":"px","default":34},
    {"type":"range","id":"body_size","label":"正文大小","min":12,"max":22,"step":1,"unit":"px","default":15},
    {"type":"range","id":"flow_image_height","label":"能量流程图片高度","min":240,"max":640,"step":10,"unit":"px","default":460},
    {"type":"range","id":"flow_image_width","label":"能量流程图片宽度","min":40,"max":100,"step":1,"unit":"%","default":100},
    {"type":"range","id":"flow_node_size","label":"能量流程节点大小","min":11,"max":18,"step":1,"unit":"px","default":13},
    {"type":"text","id":"toggle_aria_label","label":"切换无障碍标签","default":"Tageszeit für Energiefluss auswählen"},
    {"type":"text","id":"toggle_day_label","label":"切换白天标签","default":"☀ Tag · Speichern"},
    {"type":"text","id":"toggle_evening_label","label":"切换夜间标签","default":"☾ Abend · Nutzen"},
    {"type":"image_picker","id":"day_image","label":"白天图片"},
    {"type":"text","id":"day_image_alt","label":"白天图片替代文字","default":"Energiefluss von PV-Anlage über das Hausnetz zum Haushalt und Speicher"},
    {"type":"textarea","id":"day_placeholder","label":"白天占位文字","default":"Erklärbild auswählen: PV → Hausnetz → Haushalt / Speicher"},
    {"type":"textarea","id":"day_nodes","label":"白天节点","info":"Einträge mit | trennen","default":"PV-Anlage|Hausnetz|Haushalt|Speicher|Smart Meter / CT"},
    {"type":"image_picker","id":"evening_image","label":"夜间图片"},
    {"type":"text","id":"evening_image_alt","label":"夜间图片替代文字","default":"Energiefluss vom Speicher über das Hausnetz zum Haushalt und weiteren Verbrauchern"},
    {"type":"textarea","id":"evening_placeholder","label":"夜间占位文字","default":"Erklärbild auswählen: Speicher → Hausnetz → Haushalt / weitere Verbraucher"},
    {"type":"textarea","id":"evening_nodes","label":"夜间节点","info":"Einträge mit | trennen","default":"Speicher|Hausnetz|Haushalt|Weitere Verbraucher"},
    {"type":"text","id":"link_label","label":"链接标签","default":"Mehr über E-Auto laden mit Speicher →"},
    {"type":"url","id":"link_url","label":"链接链接地址"}
  ],
  "blocks": [
    {
      "type":"step",
      "name":"Funktionsschritt",
      "settings":[
        {"type":"text","id":"title","label":"标题","default":"Schritt"},
        {"type":"textarea","id":"body","label":"正文","default":"Beschreibung des Schritts."},
        {"type":"range","id":"title_size","label":"标题大小","min":14,"max":24,"step":1,"unit":"px","default":19},
        {"type":"range","id":"body_size","label":"正文大小","min":12,"max":20,"step":1,"unit":"px","default":14}
      ]
    }
  ],
  "max_blocks": 6,
  "presets":[{"name":"03 Funktionsweise","blocks":[{"type":"step","settings":{"title":"Strom erzeugen","body":"Die PV-Anlage produziert tagsüber Energie für den Haushalt."}},{"type":"step","settings":{"title":"Überschüsse speichern","body":"Wird nicht alles sofort verbraucht, kann der Überschuss im Speicher landen."}},{"type":"step","settings":{"title":"Später nutzen","body":"Abends, nachts oder bei höherem Bedarf unterstützt der Speicher dein Hausnetz mit zuvor gespeicherter Energie."}}]}
]}
{% endschema %}
