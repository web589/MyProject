{%- comment -%} AC storage editor section: hero {%- endcomment -%}
{% render 'ac-storage-module', module: 'hero', section: section %}

{% schema %}
{
  "name": "01 Hero – AC-Speicher",
  "tag": "section",
  "class": "ac-storage-hero-section",
  "settings": [
    {"type":"text","id":"eyebrow","label":"眉题","default":"Technologie einfach erklärt"},
    {"type":"text","id":"heading","label":"标题","default":"AC-gekoppelter Speicher: Solarstrom speichern und"},
    {"type":"text","id":"heading_accent","label":"标题强调部分","default":"bestehende Systeme flexibel erweitern"},
    {"type":"textarea","id":"lead","label":"引言","default":"Ein AC-gekoppelter Speicher wird über dein Hausnetz eingebunden. Das macht ihn besonders interessant, wenn du bestehenden Solarstrom besser speichern und deinen Eigenverbrauch steigern möchtest – ohne deine bestehende PV-Lösung grundsätzlich ersetzen zu müssen."},
    {"type":"range","id":"section_padding","label":"区块内边距","min":40,"max":120,"step":4,"unit":"px","default":72},
    {"type":"range","id":"content_width","label":"内容宽度","min":960,"max":1600,"step":20,"unit":"px","default":1440},
    {"type":"range","id":"eyebrow_size","label":"眉题大小","min":10,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"hero_heading_size","label":"主视觉标题大小","min":36,"max":64,"step":1,"unit":"px","default":48},
    {"type":"range","id":"hero_lead_size","label":"主视觉引言大小","min":13,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"hero_copy_width","label":"主视觉文案宽度","min":420,"max":760,"step":10,"unit":"px","default":640},
    {"type":"range","id":"hero_media_height","label":"主视觉媒体高度","min":280,"max":640,"step":10,"unit":"px","default":480},
    {"type":"range","id":"hero_image_width","label":"主视觉图片宽度","min":40,"max":100,"step":1,"unit":"%","default":100},
    {"type":"select","id":"hero_image_fit","label":"主视觉图片适配方式","default":"cover","options":[{"value":"cover","label":"Flächig ausfüllen"},{"value":"contain","label":"Vollständig zeigen"}]},
    {"type":"image_picker","id":"hero_image","label":"主视觉图片"},
    {"type":"text","id":"hero_image_alt","label":"主视觉图片替代文字","default":"Solarspeicher an einem Haus mit Photovoltaikanlage"},
    {"type":"textarea","id":"hero_placeholder","label":"主视觉占位文字","default":"Hero-Bild auswählen: Haus mit Photovoltaikanlage und Speicher"}
  ],
  "blocks": [
    {
      "type":"button",
      "name":"Hero-Button",
      "settings":[
        {"type":"text","id":"label","label":"标签","default":"Button"},
        {"type":"url","id":"url","label":"链接地址"},
        {"type":"select","id":"style","label":"样式","default":"secondary","options":[{"value":"primary","label":"Primär"},{"value":"secondary","label":"Sekundär"}]}
      ]
    }
  ],
  "max_blocks": 2,
  "presets":[{"name":"01 Hero – AC-Speicher","blocks":[{"type":"button","settings":{"label":"Modelle ansehen","url":"/pages/venus-e-vergleich","style":"primary"}},{"type":"button","settings":{"label":"So funktioniert es","url":"#funktion","style":"secondary"}}]}]
}
{% endschema %}
