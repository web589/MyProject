{%- comment -%} AC storage editor section: models {%- endcomment -%}
{% render 'ac-storage-module', module: 'models', section: section %}

{% schema %}
{
  "name": "08 Modelle",
  "tag": "section",
  "class": "ac-storage-models-section",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Lösungen"},
    {"type":"text","id":"heading","label":"Überschrift","default":"Passende VENUS E Lösungen"},
    {"type":"textarea","id":"subtext","label":"Beschreibung","default":"Je nach Haushaltsgröße, Verbrauch und Ausbauziel kommen unterschiedliche Speicherlösungen infrage."},
    {"type":"text","id":"card_link_label","label":"Fallback-Modellkarten-Link","default":"Modell ansehen →"},
    {"type":"text","id":"compare_label","label":"Vergleichsbutton","default":"Modelle im Überblick"},
    {"type":"url","id":"compare_url","label":"Vergleichsbutton Ziel"},
    {"type":"text","id":"storage_label","label":"Balkonkraftwerk-Button","default":"Balkonkraftwerk mit Speicher ansehen"},
    {"type":"url","id":"storage_url","label":"Balkonkraftwerk-Button Ziel"}
  ],
  "blocks": [
    {
      "type":"product_card",
      "name":"Produktkarte",
      "settings":[
        {"type":"product","id":"product","label":"Produkt"},
        {"type":"text","id":"name","label":"Name","default":"VENUS E"},
        {"type":"textarea","id":"copy","label":"Beschreibung","default":"Beschreibung des Modells."},
        {"type":"text","id":"alt","label":"Bild-Alt-Text","default":"VENUS E Solarspeicher"},
        {"type":"text","id":"link_label","label":"Karten-Link","default":"Modell ansehen →"}
      ]
    }
  ],
  "max_blocks": 8,
  "presets":[{"name":"08 Modelle","blocks":[{"type":"product_card","settings":{"product":"venus-e-mini","name":"VENUS E Mini","copy":"Für kleinere Haushalte und den Einstieg in mehr Eigenverbrauch.","alt":"VENUS E Mini Solarspeicher","link_label":"Modell ansehen →"}},{"type":"product_card","settings":{"product":"venus-e-3","name":"VENUS E 3.0","copy":"Für flexible Speicherlösungen im Alltag.","alt":"VENUS E 3.0 Solarspeicher","link_label":"Modell ansehen →"}},{"type":"product_card","settings":{"product":"venus-e-4","name":"VENUS E 4.0","copy":"Für höheren Energiebedarf und größere Haushalte.","alt":"VENUS E 4.0 Solarspeicher","link_label":"Modell ansehen →"}},{"type":"product_card","settings":{"product":"venus-e-max","name":"VENUS E Max","copy":"Für maximale Speicherkapazität und Ausbaupläne.","alt":"VENUS E Max Solarspeicher","link_label":"Modell ansehen →"}}]}
]}
{% endschema %}
