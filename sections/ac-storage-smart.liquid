{%- comment -%} AC storage editor section: smart control {%- endcomment -%}
{% render 'ac-storage-module', module: 'smart', section: section %}

{% schema %}
{
  "name": "06 Intelligente Steuerung",
  "tag": "section",
  "class": "ac-storage-smart-section",
  "settings": [
    {"type":"text","id":"eyebrow","label":"眉题","default":"Intelligente Steuerung"},
    {"type":"text","id":"heading","label":"标题","default":"Nicht nur speichern – sondern intelligent steuern"},
    {"type":"text","id":"heading_accent","label":"标题强调部分","default":"sondern intelligent steuern"},
    {"type":"textarea","id":"subtext","label":"补充文字","default":"Ein moderner Speicher ist dann besonders sinnvoll, wenn er nicht nur Energie puffert, sondern sich am tatsächlichen Bedarf im Haushalt orientiert."},
    {"type":"range","id":"section_padding","label":"区块内边距","min":40,"max":120,"step":4,"unit":"px","default":72},
    {"type":"range","id":"content_width","label":"内容宽度","min":960,"max":1600,"step":20,"unit":"px","default":1440},
    {"type":"range","id":"eyebrow_size","label":"眉题大小","min":10,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"heading_size","label":"标题大小","min":24,"max":56,"step":1,"unit":"px","default":34},
    {"type":"range","id":"body_size","label":"正文大小","min":12,"max":22,"step":1,"unit":"px","default":15},
    {"type":"range","id":"main_image_height","label":"主图片高度","min":220,"max":420,"step":10,"unit":"px","default":300},
    {"type":"range","id":"small_image_height","label":"小型图片高度","min":100,"max":240,"step":10,"unit":"px","default":150},
    {"type":"range","id":"main_image_width","label":"主图片宽度","min":40,"max":100,"step":1,"unit":"%","default":100},
    {"type":"range","id":"small_image_width","label":"小型图片宽度","min":40,"max":100,"step":1,"unit":"%","default":100},
    {"type":"text","id":"link_label","label":"链接标签","default":"Smart Meter & Energiefluss ansehen"},
    {"type":"url","id":"link_url","label":"链接链接地址"},
    {"type":"image_picker","id":"main_image","label":"主图片"},
    {"type":"text","id":"main_image_alt","label":"主图片替代文字","default":"VENUS E Speicher in einem modernen Zuhause"},
    {"type":"textarea","id":"main_placeholder","label":"主占位文字","default":"Smart-Control-Bild auswählen: VENUS E und modernes Zuhause"},
    {"type":"image_picker","id":"app_image","label":"应用图片"},
    {"type":"text","id":"app_image_alt","label":"应用图片替代文字","default":"Energiedaten in der Speicher-App"},
    {"type":"textarea","id":"app_placeholder","label":"应用占位文字","default":"App-Energiedaten auswählen"},
    {"type":"image_picker","id":"meter_image","label":"电表图片"},
    {"type":"text","id":"meter_image_alt","label":"电表图片替代文字","default":"CT002 oder CT003 Smart Meter"},
    {"type":"textarea","id":"meter_placeholder","label":"电表占位文字","default":"Smart Meter CT002 / CT003 auswählen"}
  ],
  "blocks": [
    {
      "type":"step",
      "name":"Steuerungsschritt",
      "settings":[
        {"type":"text","id":"title","label":"标题","default":"Schritt"},
        {"type":"textarea","id":"body","label":"正文","default":"Beschreibung des Schritts."},
        {"type":"range","id":"title_size","label":"标题大小","min":14,"max":24,"step":1,"unit":"px","default":19},
        {"type":"range","id":"body_size","label":"正文大小","min":12,"max":20,"step":1,"unit":"px","default":14}
      ]
    }
  ],
  "max_blocks": 6,
  "presets":[{"name":"06 Intelligente Steuerung","blocks":[{"type":"step","settings":{"title":"Verbrauch erkennen","body":"Mit passendem Smart Meter lassen sich Energieflüsse im Haushalt transparenter erfassen."}},{"type":"step","settings":{"title":"Leistung anpassen","body":"So kann das System besser darauf reagieren, wann Strom im Haushalt gebraucht wird."}},{"type":"step","settings":{"title":"Eigenverbrauch optimieren","body":"Das Ziel ist nicht nur Speichern, sondern den selbst erzeugten Solarstrom möglichst sinnvoll im Alltag zu nutzen."}}]}
]}
{% endschema %}
