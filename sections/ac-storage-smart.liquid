{%- comment -%} AC storage editor section: smart control {%- endcomment -%}
{% render 'ac-storage-module', module: 'smart', section: section %}

{% schema %}
{
  "name": "06 智能控制",
  "tag": "section",
  "class": "ac-storage-smart-section",
  "settings": [
    {"type":"text","id":"eyebrow","label":"眉题","default":"Intelligente Steuerung"},
    {"type":"text","id":"heading","label":"标题","default":"Nicht nur speichern – sondern intelligent steuern"},
    {"type":"textarea","id":"subtext","label":"描述","default":"Ein moderner Speicher ist dann besonders sinnvoll, wenn er nicht nur Energie puffert, sondern sich am tatsächlichen Bedarf im Haushalt orientiert."},
    {"type":"range","id":"section_padding","label":"区块内边距","min":40,"max":120,"step":4,"unit":"px","default":72},
    {"type":"range","id":"content_width","label":"最大内容宽度","min":960,"max":1600,"step":20,"unit":"px","default":1440},
    {"type":"range","id":"eyebrow_size","label":"眉题字号","min":10,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"heading_size","label":"标题字号","min":24,"max":56,"step":1,"unit":"px","default":34},
    {"type":"range","id":"body_size","label":"正文字号","min":12,"max":22,"step":1,"unit":"px","default":15},
    {"type":"range","id":"main_image_height","label":"主图高度","min":220,"max":420,"step":10,"unit":"px","default":296},
    {"type":"range","id":"small_image_height","label":"小图高度","min":100,"max":240,"step":10,"unit":"px","default":150},
    {"type":"text","id":"link_label","label":"相关链接文字","default":"Smart Meter & Energiefluss ansehen"},
    {"type":"url","id":"link_url","label":"相关链接目标"},
    {"type":"image_picker","id":"main_image","label":"主图"},
    {"type":"text","id":"main_image_alt","label":"主图替代文本","default":"VENUS E Speicher in einem modernen Zuhause"},
    {"type":"textarea","id":"main_placeholder","label":"主图占位提示","default":"Smart-Control-Bild auswählen: VENUS E und modernes Zuhause"},
    {"type":"image_picker","id":"app_image","label":"App 图片"},
    {"type":"text","id":"app_image_alt","label":"App 图片替代文本","default":"Energiedaten in der Speicher-App"},
    {"type":"textarea","id":"app_placeholder","label":"App 图片占位提示","default":"App-Energiedaten auswählen"},
    {"type":"image_picker","id":"meter_image","label":"智能电表图片"},
    {"type":"text","id":"meter_image_alt","label":"智能电表替代文本","default":"CT002 oder CT003 Smart Meter"},
    {"type":"textarea","id":"meter_placeholder","label":"智能电表占位提示","default":"Smart Meter CT002 / CT003 auswählen"}
  ],
  "blocks": [
    {
      "type":"step",
      "name":"控制步骤",
      "settings":[
        {"type":"text","id":"title","label":"标题","default":"Schritt"},
        {"type":"textarea","id":"body","label":"正文","default":"Beschreibung des Schritts."},
        {"type":"range","id":"title_size","label":"标题字号","min":14,"max":24,"step":1,"unit":"px","default":19},
        {"type":"range","id":"body_size","label":"正文字号","min":12,"max":20,"step":1,"unit":"px","default":14}
      ]
    }
  ],
  "max_blocks": 6,
  "presets":[{"name":"06 智能控制","blocks":[{"type":"step","settings":{"title":"Verbrauch erkennen","body":"Mit passendem Smart Meter lassen sich Energieflüsse im Haushalt transparenter erfassen."}},{"type":"step","settings":{"title":"Leistung anpassen","body":"So kann das System besser darauf reagieren, wann Strom im Haushalt gebraucht wird."}},{"type":"step","settings":{"title":"Eigenverbrauch optimieren","body":"Das Ziel ist nicht nur Speichern, sondern den selbst erzeugten Solarstrom möglichst sinnvoll im Alltag zu nutzen."}}]}
]}
{% endschema %}
