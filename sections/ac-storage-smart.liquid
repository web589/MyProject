{%- comment -%} AC storage editor section: smart control {%- endcomment -%}
{% render 'ac-storage-module', module: 'smart', section: section %}

{% schema %}
{
  "name": "06 Intelligente Steuerung",
  "tag": "section",
  "class": "ac-storage-smart-section",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Intelligente Steuerung"},
    {"type":"text","id":"heading","label":"Überschrift","default":"Nicht nur speichern – sondern intelligent steuern"},
    {"type":"textarea","id":"subtext","label":"Beschreibung","default":"Ein moderner Speicher ist dann besonders sinnvoll, wenn er nicht nur Energie puffert, sondern sich am tatsächlichen Bedarf im Haushalt orientiert."},
    {"type":"range","id":"section_padding","label":"Innenabstand Abschnitt","min":40,"max":120,"step":4,"unit":"px","default":72},
    {"type":"range","id":"content_width","label":"Maximale Inhaltsbreite","min":960,"max":1600,"step":20,"unit":"px","default":1440},
    {"type":"range","id":"eyebrow_size","label":"Eyebrow-Schriftgröße","min":10,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"heading_size","label":"Überschrift Schriftgröße","min":24,"max":56,"step":1,"unit":"px","default":34},
    {"type":"range","id":"body_size","label":"Grundtext Schriftgröße","min":12,"max":22,"step":1,"unit":"px","default":15},
    {"type":"range","id":"main_image_height","label":"Hauptbildhöhe","min":220,"max":420,"step":10,"unit":"px","default":300},
    {"type":"range","id":"small_image_height","label":"Kleine Bildhöhe","min":100,"max":240,"step":10,"unit":"px","default":150},
    {"type":"range","id":"main_image_width","label":"Hauptbildbreite","min":40,"max":100,"step":1,"unit":"%","default":100},
    {"type":"range","id":"small_image_width","label":"Kleine Bilder Breite","min":40,"max":100,"step":1,"unit":"%","default":100},
    {"type":"text","id":"link_label","label":"Weiterführender Link","default":"Smart Meter & Energiefluss ansehen"},
    {"type":"url","id":"link_url","label":"Weiterführender Link Ziel"},
    {"type":"image_picker","id":"main_image","label":"Hauptbild"},
    {"type":"text","id":"main_image_alt","label":"Hauptbild Alt-Text","default":"VENUS E Speicher in einem modernen Zuhause"},
    {"type":"textarea","id":"main_placeholder","label":"Hauptbild Platzhalter","default":"Smart-Control-Bild auswählen: VENUS E und modernes Zuhause"},
    {"type":"image_picker","id":"app_image","label":"App-Bild"},
    {"type":"text","id":"app_image_alt","label":"App-Bild Alt-Text","default":"Energiedaten in der Speicher-App"},
    {"type":"textarea","id":"app_placeholder","label":"App-Bild Platzhalter","default":"App-Energiedaten auswählen"},
    {"type":"image_picker","id":"meter_image","label":"Smart-Meter-Bild"},
    {"type":"text","id":"meter_image_alt","label":"Smart-Meter Alt-Text","default":"CT002 oder CT003 Smart Meter"},
    {"type":"textarea","id":"meter_placeholder","label":"Smart-Meter Platzhalter","default":"Smart Meter CT002 / CT003 auswählen"}
  ],
  "blocks": [
    {
      "type":"step",
      "name":"Steuerungsschritt",
      "settings":[
        {"type":"text","id":"title","label":"Titel","default":"Schritt"},
        {"type":"textarea","id":"body","label":"Text","default":"Beschreibung des Schritts."},
        {"type":"range","id":"title_size","label":"Titel Schriftgröße","min":14,"max":24,"step":1,"unit":"px","default":19},
        {"type":"range","id":"body_size","label":"Text Schriftgröße","min":12,"max":20,"step":1,"unit":"px","default":14}
      ]
    }
  ],
  "max_blocks": 6,
  "presets":[{"name":"06 Intelligente Steuerung","blocks":[{"type":"step","settings":{"title":"Verbrauch erkennen","body":"Mit passendem Smart Meter lassen sich Energieflüsse im Haushalt transparenter erfassen."}},{"type":"step","settings":{"title":"Leistung anpassen","body":"So kann das System besser darauf reagieren, wann Strom im Haushalt gebraucht wird."}},{"type":"step","settings":{"title":"Eigenverbrauch optimieren","body":"Das Ziel ist nicht nur Speichern, sondern den selbst erzeugten Solarstrom möglichst sinnvoll im Alltag zu nutzen."}}]}
]}
{% endschema %}
