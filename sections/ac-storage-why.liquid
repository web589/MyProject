{%- comment -%} AC storage editor section: benefits {%- endcomment -%}
{% render 'ac-storage-module', module: 'why', section: section %}

{% schema %}
{
  "name": "04 优势",
  "tag": "section",
  "class": "ac-storage-why-section",
  "settings": [
    {"type":"text","id":"eyebrow","label":"眉题","default":"Vorteile im Alltag"},
    {"type":"text","id":"heading","label":"标题","default":"Warum AC-gekoppelt für viele Haushalte besonders praktisch ist"},
    {"type":"textarea","id":"subtext","label":"描述","default":"Viele Haushalte wollen Solarstrom besser nutzen, ohne ihr bestehendes System komplett umzubauen. Genau hier spielt ein AC-gekoppelter Speicher seine Stärken aus."},
    {"type":"range","id":"section_padding","label":"区块内边距","min":40,"max":120,"step":4,"unit":"px","default":72},
    {"type":"range","id":"content_width","label":"最大内容宽度","min":960,"max":1600,"step":20,"unit":"px","default":1440},
    {"type":"range","id":"eyebrow_size","label":"眉题字号","min":10,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"heading_size","label":"标题字号","min":24,"max":56,"step":1,"unit":"px","default":34},
    {"type":"range","id":"body_size","label":"正文字号","min":12,"max":22,"step":1,"unit":"px","default":15},
    {"type":"text","id":"cta_label","label":"行动链接文字","default":"Passende Modelle entdecken"},
    {"type":"url","id":"cta_url","label":"行动链接目标"}
  ],
  "blocks": [
    {
      "type":"image_card",
      "name":"优势卡片",
      "settings":[
        {"type":"text","id":"title","label":"标题","default":"Vorteil"},
        {"type":"textarea","id":"body","label":"正文","default":"Beschreibung des Vorteils."},
        {"type":"image_picker","id":"image","label":"图片"},
        {"type":"text","id":"alt","label":"图片替代文本","default":"Vorteil des AC-gekoppelten Speichers"},
        {"type":"textarea","id":"placeholder","label":"图片占位提示","default":"Vorteilsbild auswählen"},
        {"type":"range","id":"title_size","label":"标题字号","min":14,"max":24,"step":1,"unit":"px","default":18},
        {"type":"range","id":"body_size","label":"正文字号","min":12,"max":20,"step":1,"unit":"px","default":13},
        {"type":"range","id":"image_height","label":"图片高度","min":140,"max":360,"step":10,"unit":"px","default":210}
      ]
    },
    {
      "type":"stat",
      "name":"优势数据卡",
      "settings":[
        {"type":"text","id":"title","label":"标题","default":"Vorteil"},
        {"type":"textarea","id":"body","label":"正文","default":"Beschreibung des Vorteils."},
        {"type":"text","id":"tag","label":"标签","default":"Flexibel"},
        {"type":"range","id":"title_size","label":"标题字号","min":14,"max":24,"step":1,"unit":"px","default":18},
        {"type":"range","id":"body_size","label":"正文字号","min":12,"max":20,"step":1,"unit":"px","default":13},
        {"type":"range","id":"card_height","label":"卡片高度","min":140,"max":300,"step":10,"unit":"px","default":188}
      ]
    }
  ],
  "max_blocks": 8,
  "presets":[{"name":"04 优势","blocks":[{"type":"image_card","settings":{"title":"Sinnvoll für Nachrüstung","body":"Wenn bereits eine PV-Anlage oder ein Balkonkraftwerk vorhanden ist, lässt sich ein Speicher oft deutlich einfacher ergänzen.","alt":"Haus mit bestehender PV-Anlage und nachgerüstetem Speicher","placeholder":"Familien-Szenenbild auswählen: bestehende PV und nachgerüsteter Speicher"}},{"type":"image_card","settings":{"title":"Mehr Flexibilität im Alltag","body":"Du nutzt Solarstrom dann, wenn du ihn brauchst – nicht nur dann, wenn er erzeugt wird.","alt":"Familie nutzt am Abend den gespeicherten Solarstrom","placeholder":"Familien-Szenenbild auswählen: abendlicher Stromverbrauch"}},{"type":"stat","settings":{"title":"Weniger Abhängigkeit vom Stromnetz","body":"Je höher dein Eigenverbrauch, desto weniger Strom musst du aus dem Netz beziehen.","tag":"Netzbezug reduzieren"}},{"type":"stat","settings":{"title":"Passend für verschiedene Haushaltsgrößen","body":"Von kleineren Setups bis zu höherem Verbrauch lässt sich das Prinzip flexibel einsetzen.","tag":"Modular erweiterbar"}}]}
]}
{% endschema %}
