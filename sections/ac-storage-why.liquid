{%- comment -%} AC storage editor section: benefits {%- endcomment -%}
{% render 'ac-storage-module', module: 'why', section: section %}

{% schema %}
{
  "name": "04 Vorteile",
  "tag": "section",
  "class": "ac-storage-why-section",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Vorteile im Alltag"},
    {"type":"text","id":"heading","label":"Überschrift","default":"Warum AC-gekoppelt für viele Haushalte besonders praktisch ist"},
    {"type":"textarea","id":"subtext","label":"Beschreibung","default":"Viele Haushalte wollen Solarstrom besser nutzen, ohne ihr bestehendes System komplett umzubauen. Genau hier spielt ein AC-gekoppelter Speicher seine Stärken aus."},
    {"type":"text","id":"cta_label","label":"CTA-Link","default":"Passende Modelle entdecken"},
    {"type":"url","id":"cta_url","label":"CTA-Link Ziel"}
  ],
  "blocks": [
    {
      "type":"image_card",
      "name":"Vorteilskarte",
      "settings":[
        {"type":"text","id":"title","label":"Titel","default":"Vorteil"},
        {"type":"textarea","id":"body","label":"Text","default":"Beschreibung des Vorteils."},
        {"type":"image_picker","id":"image","label":"Bild"},
        {"type":"text","id":"alt","label":"Alt-Text","default":"Vorteil des AC-gekoppelten Speichers"},
        {"type":"textarea","id":"placeholder","label":"Bild-Platzhalter","default":"Vorteilsbild auswählen"}
      ]
    },
    {
      "type":"stat",
      "name":"Vorteils-Statistik",
      "settings":[
        {"type":"text","id":"title","label":"Titel","default":"Vorteil"},
        {"type":"textarea","id":"body","label":"Text","default":"Beschreibung des Vorteils."},
        {"type":"text","id":"tag","label":"Tag","default":"Flexibel"}
      ]
    }
  ],
  "max_blocks": 8,
  "presets":[{"name":"04 Vorteile","blocks":[{"type":"image_card","settings":{"title":"Sinnvoll für Nachrüstung","body":"Wenn bereits eine PV-Anlage oder ein Balkonkraftwerk vorhanden ist, lässt sich ein Speicher oft deutlich einfacher ergänzen.","alt":"Haus mit bestehender PV-Anlage und nachgerüstetem Speicher","placeholder":"Familien-Szenenbild auswählen: bestehende PV und nachgerüsteter Speicher"}},{"type":"image_card","settings":{"title":"Mehr Flexibilität im Alltag","body":"Du nutzt Solarstrom dann, wenn du ihn brauchst – nicht nur dann, wenn er erzeugt wird.","alt":"Familie nutzt am Abend den gespeicherten Solarstrom","placeholder":"Familien-Szenenbild auswählen: abendlicher Stromverbrauch"}},{"type":"stat","settings":{"title":"Weniger Abhängigkeit vom Stromnetz","body":"Je höher dein Eigenverbrauch, desto weniger Strom musst du aus dem Netz beziehen.","tag":"Netzbezug reduzieren"}},{"type":"stat","settings":{"title":"Passend für verschiedene Haushaltsgrößen","body":"Von kleineren Setups bis zu höherem Verbrauch lässt sich das Prinzip flexibel einsetzen.","tag":"Modular erweiterbar"}}]}
]}
{% endschema %}
