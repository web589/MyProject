<div class="acdc-section acdc-architecture acdc-gray-sec">
  <div class="acdc-container">
    {% if section.settings.eyebrow != blank %}<div class="acdc-eyebrow">{{ section.settings.eyebrow | escape }}</div>{% endif %}
    <h2>{{ section.settings.heading | escape }}{% if section.settings.heading_accent != blank %} <span class="acdc-acc">{{ section.settings.heading_accent | escape }}</span>{% endif %}</h2>
    {% if section.settings.subtitle != blank %}<p class="acdc-sub">{{ section.settings.subtitle | escape }}</p>{% endif %}
    {% if section.blocks.size > 0 %}
      <div class="acdc-arch-grid">
        {% for block in section.blocks %}
          <article class="acdc-arch" {{ block.shopify_attributes }}>
            <div class="acdc-arch-media">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '550, 800, 1100, 1400', sizes: '(min-width: 981px) 45vw, 100vw', alt: block.settings.image_alt }}
              {% else %}
                <div class="acdc-ph acdc-arch-ph" aria-hidden="true"></div>
              {% endif %}
              {% if block.settings.badge != blank %}<span class="acdc-badge">{{ block.settings.badge | escape }}</span>{% endif %}
            </div>
            <div class="acdc-arch-body">
              {% if block.settings.title != blank %}<h3>{{ block.settings.title | escape }}</h3>{% endif %}
              {% if block.settings.description != blank %}<p class="acdc-lead">{{ block.settings.description | escape }}</p>{% endif %}
              {% if block.settings.flow_one != blank or block.settings.flow_two != blank %}
                <div class="acdc-flow">
                  {% if section.settings.flow_label != blank %}<div class="acdc-flow-cap">{{ section.settings.flow_label | escape }}</div>{% endif %}
                  {% if block.settings.flow_one != blank %}<div class="acdc-flowline">{{ block.settings.flow_one | escape | replace: '→', '<span aria-hidden="true">→</span>' | replace: '↔', '<span aria-hidden="true">↔</span>' }}</div>{% endif %}
                  {% if block.settings.flow_two != blank %}<div class="acdc-flowline">{{ block.settings.flow_two | escape | replace: '→', '<span aria-hidden="true">→</span>' | replace: '↔', '<span aria-hidden="true">↔</span>' }}</div>{% endif %}
                </div>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}
    {% if section.settings.note != blank %}
      <aside class="acdc-merk"><span class="acdc-i" aria-hidden="true">i</span><p>{{ section.settings.note | escape }}</p></aside>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "03 系统架构",
  "tag": "section",
  "class": "acdc-section-wrap acdc-architecture-wrap",
  "settings": [
    {"type":"text","id":"eyebrow","label":"眉题","default":"Systemarchitektur"},
    {"type":"text","id":"heading","label":"标题普通文字","default":"So unterscheiden sich AC- und"},
    {"type":"text","id":"heading_accent","label":"标题蓝色文字","default":"DC-gekoppelte Speicher"},
    {"type":"textarea","id":"subtitle","label":"副标题","default":"Der Unterschied liegt in der Einbindung: AC-Speicher arbeiten auf der Wechselstromseite, DC-Speicher auf der Gleichstromseite der PV-Anlage."},
    {"type":"text","id":"flow_label","label":"能量流标签","default":"ENERGIEFLUSS"},
    {"type":"textarea","id":"note","label":"底部重点说明","default":"Beide Architekturen sind bei PV-Speichersystemen verbreitet. Entscheidend ist nicht die eine „richtige“ Technik, sondern welche Architektur zu deiner vorhandenen Anlage und zu deinen Plänen passt."}
  ],
  "blocks": [
    {"type":"architecture","name":"架构卡","settings":[
      {"type":"image_picker","id":"image","label":"结构示意图片"},
      {"type":"text","id":"image_alt","label":"图片替代文字","default":"Struktur eines Solarspeichers"},
      {"type":"text","id":"badge","label":"图片角标","default":"AC"},
      {"type":"text","id":"title","label":"卡片标题","default":"AC-Kopplung"},
      {"type":"textarea","id":"description","label":"卡片说明","default":"Einbindung des Speichers im PV-System."},
      {"type":"text","id":"flow_one","label":"第一行能量流","default":"PV → Wechselrichter → Hausnetz → Haushalt"},
      {"type":"text","id":"flow_two","label":"第二行能量流","default":"Speicher ↔ Hausnetz (AC-Seite)"}
    ]}
  ],
  "max_blocks": 4,
  "presets": [{"name":"03 系统架构","blocks":[
    {"type":"architecture","settings":{"image_alt":"Struktur eines AC-gekoppelten Solarspeichers im Hausnetz","badge":"AC","title":"AC-Kopplung: Einbindung auf der Wechselstromseite","description":"Der Solarstrom wird zunächst wie gewohnt in Wechselstrom umgewandelt. Der Speicher wird danach auf der Wechselstromseite angebunden und ist damit Teil des Hausnetzes.","flow_one":"PV → Wechselrichter → Hausnetz → Haushalt","flow_two":"Speicher ↔ Hausnetz (AC-Seite)"}},
    {"type":"architecture","settings":{"image_alt":"Struktur eines DC-gekoppelten Solarspeichers mit Hybridwechselrichter","badge":"DC","title":"DC-Kopplung: Einbindung auf der Gleichstromseite","description":"Der Speicher wird auf der Gleichstromseite eingebunden, häufig zusammen mit einem Hybridwechselrichter. Erzeugung und Speicher werden dabei als gemeinsames System gedacht.","flow_one":"PV → Hybridwechselrichter → Hausnetz → Haushalt","flow_two":"Speicher ↔ Hybridwechselrichter (DC-Seite)"}}
  ]}]
}
{% endschema %}
