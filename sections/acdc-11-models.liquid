<section id="modelle" class="acdc-section acdc-models" aria-labelledby="acdc-models-title-{{ section.id }}">
  <div class="acdc-inner">
    {%- if section.settings.eyebrow != blank -%}<div class="acdc-eyebrow">{{ section.settings.eyebrow | escape }}</div>{%- endif -%}
    <h2 id="acdc-models-title-{{ section.id }}" class="acdc-h2">{{ section.settings.heading | escape }} <span class="acdc-accent">{{ section.settings.heading_accent | escape }}</span></h2>
    {%- if section.settings.subtext != blank -%}<p class="acdc-sub">{{ section.settings.subtext | escape }}</p>{%- endif -%}

    <div class="acdc-prod-grid">
      {%- for block in section.blocks -%}
        {%- assign card_product = block.settings.product -%}
        {%- assign card_title = block.settings.title | default: card_product.title -%}
        <article class="acdc-prod" {{ block.shopify_attributes }}>
          <div class="acdc-prod-media">
            {%- if card_product != blank and card_product.featured_image != blank -%}
              {%- assign card_alt = block.settings.image_alt | default: card_product.featured_image.alt | default: card_title -%}
              {{ card_product.featured_image | image_url: width: 900 | image_tag: class: 'acdc-prod-image', alt: card_alt, loading: 'lazy', widths: '320, 480, 640, 900', sizes: '(max-width: 720px) 100vw, (max-width: 1180px) 50vw, 25vw' }}
            {%- else -%}
              <div class="acdc-media-placeholder" aria-hidden="true"></div>
            {%- endif -%}
          </div>
          <div class="acdc-prod-body">
            {%- if card_title != blank -%}<h3>{{ card_title | escape }}</h3>{%- endif -%}
            {%- if block.settings.capacity != blank -%}<div class="acdc-cap">{{ block.settings.capacity | escape }}</div>{%- endif -%}
            {%- if block.settings.description != blank -%}<p>{{ block.settings.description | escape }}</p>{%- endif -%}
            {%- if card_product != blank -%}<a class="acdc-link" href="{{ card_product.url }}">{{ block.settings.link_label | escape }}</a>{%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>

    {%- if section.settings.hint != blank -%}
      <p class="acdc-prod-hint"><span class="acdc-info-icon" aria-hidden="true">i</span><span>{{ section.settings.hint | escape }}</span></p>
    {%- endif -%}
    {%- if section.settings.compare_url != blank -%}
      <div class="acdc-range-links"><a class="acdc-link" href="{{ section.settings.compare_url }}">{{ section.settings.compare_label | escape }}</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "11 VENUS E 型号",
  "class": "acdc-models-section",
  "settings": [
    {"type":"text","id":"eyebrow","label":"眉题","default":"VENUS E Modelle"},
    {"type":"text","id":"heading","label":"标题前半部分","default":"Passende VENUS E Speicher"},
    {"type":"text","id":"heading_accent","label":"标题蓝色部分","default":"entdecken"},
    {"type":"textarea","id":"subtext","label":"副标题","default":"Vier Modelle für unterschiedliche Ausgangslagen – vom Balkonkraftwerk bis zum größeren Haushalt."},
    {"type":"textarea","id":"hint","label":"产品信息提示","default":"Alle Angaben zu Kapazität und Leistung findest du auf der jeweiligen Produktseite. Welche Funktionen verfügbar sind, hängt vom Modell, vom Softwarestand und von deiner Installation ab."},
    {"type":"text","id":"compare_label","label":"型号对比链接文字","default":"Alle VENUS E Modelle vergleichen →"},
    {"type":"url","id":"compare_url","label":"型号对比链接"}
  ],
  "blocks": [
    {
      "type":"product_card",
      "name":"产品卡片",
      "settings":[
        {"type":"product","id":"product","label":"选择商品","info":"图片和链接来自所选商品。"},
        {"type":"text","id":"title","label":"卡片标题","default":"VENUS E"},
        {"type":"textarea","id":"description","label":"卡片说明","default":"Für unterschiedliche Anforderungen an die Speicherung von Solarstrom."},
        {"type":"text","id":"capacity","label":"容量文字","info":"核实产品参数后再填写；留空时不会显示。"},
        {"type":"text","id":"image_alt","label":"图片替代文字","info":"留空时使用商品图片替代文字或卡片标题。"},
        {"type":"text","id":"link_label","label":"商品链接文字","default":"Zum Modell →"}
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name":"11 VENUS E 型号",
      "settings":{"compare_url":"/pages/speicher-vergleich"},
      "blocks":[
        {"type":"product_card","settings":{"product":"venus-e-mini","title":"VENUS E Mini","description":"Für den Einstieg, Balkon-PV und Haushalte mit überschaubarem Abendbedarf.","image_alt":"VENUS E Mini Solarspeicher"}},
        {"type":"product_card","settings":{"product":"venus-e-3","title":"VENUS E 3.0","description":"Für Haushalte mit typischem Verbrauch, die Solarstrom zeitversetzt nutzen möchten.","image_alt":"VENUS E 3.0 Solarspeicher"}},
        {"type":"product_card","settings":{"product":"venus-e-4","title":"VENUS E 4.0","description":"Für Haushalte mit höheren Anforderungen an Leistung und Steuerung.","image_alt":"VENUS E 4.0 Solarspeicher"}},
        {"type":"product_card","settings":{"product":"venus-e-max","title":"VENUS E Max","description":"Für größere Haushalte mit höherem Speicher- und Leistungsbedarf.","image_alt":"VENUS E Max Solarspeicher"}}
      ]
    }
  ]
}
{% endschema %}
