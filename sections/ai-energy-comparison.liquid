{%- assign page_id = 'ai-energy-comparison-' | append: section.id -%}
{%- assign comparison_url = '/pages/balkonkraftwerk-mit-speicher#warum-speicher' -%}

<div class="ai-energy-page" data-ai-energy-page style="{% render 'ai-energy-style', section: section %}">
  <section id="vergleich" class="ai-energy__section ai-energy__comparison" data-ai-anchor aria-labelledby="{{ page_id }}-heading">
    <div class="ai-energy__container">
      <p class="ai-energy__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 id="{{ page_id }}-heading">{{ section.settings.heading_before }} <span>{{ section.settings.heading_highlight }}</span></h2>
      <p class="ai-energy__subtext">{{ section.settings.subtext }}</p>
      <div class="ai-energy__table-wrap">
        <table>
          <thead><tr><th scope="col">{{ section.settings.feature_heading }}</th><th scope="col">{{ section.settings.classic_heading }}</th><th scope="col" class="is-highlight">{{ section.settings.smart_heading }}</th></tr></thead>
          <tbody>
            {% for block in section.blocks %}
              <tr {{ block.shopify_attributes }}><th scope="row">{{ block.settings.feature }}</th><td>{{ block.settings.classic }}</td><td class="{% if block.settings.highlight %}is-positive{% endif %}">{{ block.settings.smart }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <p class="ai-energy__comparison-note">{{ section.settings.note }}</p>
      {% if section.settings.cta_label != blank %}<a class="ai-energy__text-link" href="{{ section.settings.cta_url | default: comparison_url }}">{{ section.settings.cta_label }}</a>{% endif %}
    </div>
  </section>
</div>

{% schema %}
{
  "name":"AI Energie – Vergleich",
  "tag":"section",
  "class":"section-ai-energy-comparison",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Einordnung"},
    {"type":"text","id":"heading_before","label":"Titel Hauptsatz","default":"Klassischer Speicher oder intelligentes Energiemanagement:"},
    {"type":"text","id":"heading_highlight","label":"Titel Hervorhebung","default":"Was ist der Unterschied?"},
    {"type":"textarea","id":"subtext","label":"Untertitel","default":"Ein klassischer Speicher erfüllt seinen Zweck zuverlässig: Energie aufnehmen und wieder abgeben. Ein intelligentes System ergänzt diesen Ansatz um Messdaten und eine laufende Bewertung."},
    {"type":"text","id":"feature_heading","label":"Spalte Funktion","default":"Funktion"},
    {"type":"text","id":"classic_heading","label":"Spalte klassischer Speicher","default":"Klassischer Speicher"},
    {"type":"text","id":"smart_heading","label":"Spalte intelligentes System","default":"Intelligentes System"},
    {"type":"textarea","id":"note","label":"Hinweis unter Tabelle","default":"Die Gegenüberstellung ist keine Bewertung von gut oder schlecht. Sie zeigt vor allem, welche zusätzlichen Informationen ein System braucht, um Energie nicht nur zu puffern, sondern situationsbezogen einzusetzen."},
    {"type":"text","id":"cta_label","label":"CTA Text","default":"Mehr zum Thema Eigenverbrauch erhöhen →"},
    {"type":"url","id":"cta_url","label":"CTA Link"},
    {"type":"header","content":"Typography"},
    {"type":"range","id":"eyebrow_size","label":"Kicker und Label Größe","min":9,"max":18,"step":1,"unit":"px","default":11},
    {"type":"range","id":"item_heading_size","label":"Elementüberschrift Größe","min":14,"max":30,"step":1,"unit":"px","default":18},
    {"type":"range","id":"item_text_size","label":"Elementtext Größe","min":10,"max":20,"step":1,"unit":"px","default":13},
    {"type":"range","id":"control_size","label":"Button und Link Größe","min":11,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"note_size","label":"Hinweisgröße","min":10,"max":18,"step":1,"unit":"px","default":12},
    {"type":"header","content":"Layout und Größen"},
    {"type":"range","id":"heading_size","label":"Überschrift Größe","min":28,"max":72,"step":1,"unit":"px","default":34},
    {"type":"range","id":"body_size","label":"Textgröße","min":12,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"section_spacing","label":"Abstand oben und unten","min":40,"max":140,"step":4,"unit":"px","default":80}
  ],
  "blocks":[{"type":"comparison_row","name":"Vergleichszeile","settings":[
    {"type":"text","id":"feature","label":"Funktion","default":"Speichern"},
    {"type":"text","id":"classic","label":"Klassischer Speicher","default":"✓"},
    {"type":"text","id":"smart","label":"Intelligentes System","default":"✓"},
    {"type":"checkbox","id":"highlight","label":"Zeile hervorheben","default":true}
  ]}],
  "max_blocks":12,
  "presets":[{"name":"AI Energie – Vergleich","blocks":[{"type":"comparison_row"},{"type":"comparison_row"},{"type":"comparison_row"},{"type":"comparison_row"},{"type":"comparison_row"}]}]
}
{% endschema %}
