{%- assign page_id = 'ai-energy-cta-' | append: section.id -%}

<div class="ai-energy-page" data-ai-energy-page style="{% render 'ai-energy-style', section: section %}">
  <section class="ai-energy__section ai-energy__guides" aria-labelledby="{{ page_id }}-heading">
    <div class="ai-energy__container">
      <div class="ai-energy__final-cta">
        <p class="ai-energy__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 id="{{ page_id }}-heading">{{ section.settings.heading_before }}{% if section.settings.heading_highlight != blank %} <span>{{ section.settings.heading_highlight }}</span>{% endif %}</h2>
        <p>{{ section.settings.subtext }}</p>
        <div class="ai-energy__actions">
          {% for block in section.blocks %}
            {% if block.settings.style == 'link' %}
              <a class="ai-energy__text-link" href="{{ block.settings.url | default: '#modelle' }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
            {% else %}
              <a class="ai-energy__button ai-energy__button--{{ block.settings.style }}" href="{{ block.settings.url | default: '#modelle' }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name":"AI Energie – CTA",
  "tag":"section",
  "class":"section-ai-energy-cta",
  "settings":[
    {"type":"text","id":"eyebrow","label":"眉题","default":"Nächster Schritt"},
    {"type":"text","id":"heading_before","label":"标题前半部分","default":"Nutze deinen Solarstrom intelligenter"},
    {"type":"text","id":"heading_highlight","label":"标题高亮"},
    {"type":"textarea","id":"subtext","label":"补充文字","default":"Ob Einstieg oder Ausbau: Wenn du Erzeugung, Verbrauch und Speicher als ein System betrachtest, holst du mehr aus deinem Solarstrom heraus."},
    {"type":"header","content":"Typography"},
    {"type":"range","id":"eyebrow_size","label":"眉题大小","min":9,"max":18,"step":1,"unit":"px","default":11},
    {"type":"range","id":"item_heading_size","label":"项目标题大小","min":14,"max":30,"step":1,"unit":"px","default":18},
    {"type":"range","id":"item_text_size","label":"项目文本大小","min":10,"max":20,"step":1,"unit":"px","default":13},
    {"type":"range","id":"control_size","label":"控件大小","min":11,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"note_size","label":"备注大小","min":10,"max":18,"step":1,"unit":"px","default":12},
    {"type":"header","content":"Layout und Größen"},
    {"type":"range","id":"heading_size","label":"标题大小","min":28,"max":72,"step":1,"unit":"px","default":34},
    {"type":"range","id":"body_size","label":"正文大小","min":12,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"section_spacing","label":"区块间距","min":40,"max":140,"step":4,"unit":"px","default":80}
  ],
  "blocks":[{"type":"button","name":"Button","settings":[
    {"type":"text","id":"label","label":"标签","default":"VENUS E Modelle ansehen"},
    {"type":"url","id":"url","label":"链接地址"},
    {"type":"select","id":"style","label":"样式","options":[{"value":"primary","label":"Primär"},{"value":"secondary","label":"Sekundär"},{"value":"link","label":"Textlink"}],"default":"primary"}
  ]}],
  "max_blocks":4,
  "presets":[{"name":"AI Energie – CTA","blocks":[{"type":"button"},{"type":"button"},{"type":"button"}]}]
}
{% endschema %}
