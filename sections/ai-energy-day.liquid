{%- assign page_id = 'ai-energy-day-' | append: section.id -%}
{%- assign eauto_url = '/pages/e-auto' -%}

<div class="ai-energy-page" data-ai-energy-page style="{% render 'ai-energy-style', section: section %} --ai-day-image-height: {{ section.settings.day_image_height | default: 330 }}px; --ai-day-image-width: {{ section.settings.day_image_width | default: 100 }}%;">
  <section id="alltag" class="ai-energy__section ai-energy__day" data-ai-anchor aria-labelledby="{{ page_id }}-heading" data-ai-tabs>
    <div class="ai-energy__container">
      <p class="ai-energy__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 id="{{ page_id }}-heading">{{ section.settings.heading_before }} <span>{{ section.settings.heading_highlight }}</span></h2>
      <p class="ai-energy__subtext">{{ section.settings.subtext }}</p>
      <div class="ai-energy__timeline" role="tablist" aria-label="{{ section.settings.timeline_label }}">
        {% for block in section.blocks %}
          <button id="ai-energy-tab-{{ block.id }}" type="button" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-controls="ai-energy-panel-{{ block.id }}" data-ai-tab="{{ block.id }}" {{ block.shopify_attributes }}>
            <strong>{{ block.settings.time_label }}</strong><span>{{ block.settings.title }}</span>
          </button>
        {% endfor %}
      </div>
      <div class="ai-energy__day-panels">
        {% for block in section.blocks %}
          <div id="ai-energy-panel-{{ block.id }}" class="ai-energy__day-panel" data-ai-panel="{{ block.id }}" role="tabpanel" aria-labelledby="ai-energy-tab-{{ block.id }}"{% unless forloop.first %} hidden{% endunless %} {{ block.shopify_attributes }}>
            <div class="ai-energy__day-image{% if block.settings.image == blank %} ai-energy__day-image--placeholder{% endif %}">
              {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '550, 800, 1100', sizes: '(min-width: 960px) 45vw, 100vw', alt: block.settings.image_alt | default: block.settings.title }}{% else %}<div class="ph ai-energy__placeholder">Szenenbild auswählen</div>{% endif %}
            </div>
            <div class="ai-energy__day-copy">
              <p><b>ERKANNT</b>{{ block.settings.recognized }}</p>
              <p><b>BEWERTET</b>{{ block.settings.evaluated }}</p>
              <p><b>ERGEBNIS</b>{{ block.settings.result }}</p>
            </div>
          </div>
        {% endfor %}
      </div>
      {% if section.settings.cta_label != blank %}<a class="ai-energy__text-link" href="{{ section.settings.cta_url | default: eauto_url }}">{{ section.settings.cta_label }}</a>{% endif %}
    </div>
  </section>
</div>

{% schema %}
{
  "name":"AI Energie – Im Alltag",
  "tag":"section",
  "class":"section-ai-energy-day",
  "settings":[
    {"type":"text","id":"eyebrow","label":"眉题","default":"Im Alltag"},
    {"type":"text","id":"heading_before","label":"标题前半部分","default":"Intelligente Energie im"},
    {"type":"text","id":"heading_highlight","label":"标题高亮","default":"Alltag"},
    {"type":"textarea","id":"subtext","label":"补充文字","default":"Was bedeutet das konkret über den Tag verteilt? Vier typische Situationen – und was das System daraus macht."},
    {"type":"text","id":"timeline_label","label":"时间线标签","default":"Tageszeiten"},
    {"type":"text","id":"cta_label","label":"行动按钮标签","default":"Mehr zum Thema E-Auto laden mit Speicher →"},
    {"type":"url","id":"cta_url","label":"行动按钮链接地址"},
    {"type":"header","content":"Typography"},
    {"type":"range","id":"eyebrow_size","label":"眉题大小","min":9,"max":18,"step":1,"unit":"px","default":11},
    {"type":"range","id":"item_heading_size","label":"项目标题大小","min":14,"max":30,"step":1,"unit":"px","default":18},
    {"type":"range","id":"item_text_size","label":"项目文本大小","min":10,"max":20,"step":1,"unit":"px","default":13},
    {"type":"range","id":"control_size","label":"控件大小","min":11,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"note_size","label":"备注大小","min":10,"max":18,"step":1,"unit":"px","default":12},
    {"type":"header","content":"Layout und Größen"},
    {"type":"range","id":"heading_size","label":"标题大小","min":28,"max":72,"step":1,"unit":"px","default":34},
    {"type":"range","id":"body_size","label":"正文大小","min":12,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"section_spacing","label":"区块间距","min":40,"max":140,"step":4,"unit":"px","default":80},
    {"type":"range","id":"day_image_height","label":"白天图片高度","min":240,"max":520,"step":10,"unit":"px","default":330},
    {"type":"range","id":"day_image_width","label":"白天图片宽度","min":40,"max":100,"step":1,"unit":"%","default":100}
  ],
  "blocks":[{"type":"scenario","name":"Alltagsszenario","settings":[
    {"type":"text","id":"time_label","label":"时间标签","default":"06–10 UHR"},
    {"type":"text","id":"title","label":"标题","default":"Morgens"},
    {"type":"image_picker","id":"image","label":"图片"},
    {"type":"text","id":"image_alt","label":"图片替代文字","default":"Morgendlicher Energiebedarf im Haushalt"},
    {"type":"textarea","id":"recognized","label":"已识别","default":"Der Bedarf im Haushalt steigt an, während die PV-Anlage noch wenig Energie liefert."},
    {"type":"textarea","id":"evaluated","label":"已评估","default":"Das System prüft Speicherstand und Netzbezug und erkennt, dass gerade keine hohen Überschüsse entstehen."},
    {"type":"textarea","id":"result","label":"结果","default":"Gespeicherter Solarstrom wird gezielt dort eingesetzt, wo morgens Bedarf entsteht."}
  ]}],
  "max_blocks":8,
  "presets":[{"name":"AI Energie – Im Alltag","blocks":[{"type":"scenario"},{"type":"scenario"},{"type":"scenario"},{"type":"scenario"}]}]
}
{% endschema %}
