{%- assign page_id = 'ai-energy-day-' | append: section.id -%}
{%- assign eauto_url = '/pages/e-auto' -%}

<div class="ai-energy-page" data-ai-energy-page>
  <section id="alltag" class="ai-energy__section ai-energy__day" data-ai-anchor aria-labelledby="{{ page_id }}-heading" data-ai-tabs>
    <div class="ai-energy__container">
      <p class="ai-energy__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 id="{{ page_id }}-heading">{{ section.settings.heading_before }} <span>{{ section.settings.heading_highlight }}</span></h2>
      <p class="ai-energy__subtext">{{ section.settings.subtext }}</p>
      <div class="ai-energy__timeline" role="tablist" aria-label="{{ section.settings.timeline_label }}">
        {% for block in section.blocks %}
          <button id="ai-energy-tab-{{ block.id }}" type="button" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-controls="ai-energy-panel-{{ block.id }}" data-ai-tab="{{ block.id }}" {{ block.shopify_attributes }}>
            <strong>{{ block.settings.time_label }}</strong><span>{{ block.settings.title }}</span>
          </button>
        {% endfor %}
      </div>
      <div class="ai-energy__day-panels">
        {% for block in section.blocks %}
          <div id="ai-energy-panel-{{ block.id }}" class="ai-energy__day-panel" data-ai-panel="{{ block.id }}" role="tabpanel" aria-labelledby="ai-energy-tab-{{ block.id }}"{% unless forloop.first %} hidden{% endunless %} {{ block.shopify_attributes }}>
            <div class="ai-energy__day-image">
              {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '550, 800, 1100', sizes: '(min-width: 960px) 45vw, 100vw', alt: block.settings.image_alt | default: block.settings.title }}{% endif %}
            </div>
            <div class="ai-energy__day-copy">
              <p><b>ERKANNT</b>{{ block.settings.recognized }}</p>
              <p><b>BEWERTET</b>{{ block.settings.evaluated }}</p>
              <p><b>ERGEBNIS</b>{{ block.settings.result }}</p>
            </div>
          </div>
        {% endfor %}
      </div>
      {% if section.settings.cta_label != blank %}<a class="ai-energy__text-link" href="{{ section.settings.cta_url | default: eauto_url }}">{{ section.settings.cta_label }}</a>{% endif %}
    </div>
  </section>
</div>

{% schema %}
{
  "name":"AI Energie – Im Alltag",
  "tag":"section",
  "class":"section-ai-energy-day",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Im Alltag"},
    {"type":"text","id":"heading_before","label":"Titel Hauptsatz","default":"Intelligente Energie im"},
    {"type":"text","id":"heading_highlight","label":"Titel Hervorhebung","default":"Alltag"},
    {"type":"textarea","id":"subtext","label":"Untertitel","default":"Was bedeutet das konkret über den Tag verteilt? Vier typische Situationen – und was das System daraus macht."},
    {"type":"text","id":"timeline_label","label":"Tab-Navigation Label","default":"Tageszeiten"},
    {"type":"text","id":"cta_label","label":"CTA Text","default":"Mehr zum Thema E-Auto laden mit Speicher →"},
    {"type":"url","id":"cta_url","label":"CTA Link"}
  ],
  "blocks":[{"type":"scenario","name":"Alltagsszenario","settings":[
    {"type":"text","id":"time_label","label":"Zeit Label","default":"06–10 UHR"},
    {"type":"text","id":"title","label":"Szenario Name","default":"Morgens"},
    {"type":"image_picker","id":"image","label":"Bild"},
    {"type":"text","id":"image_alt","label":"Bild Alt-Text","default":"Morgendlicher Energiebedarf im Haushalt"},
    {"type":"textarea","id":"recognized","label":"ERKANNT","default":"Der Bedarf im Haushalt steigt an, während die PV-Anlage noch wenig Energie liefert."},
    {"type":"textarea","id":"evaluated","label":"BEWERTET","default":"Das System prüft Speicherstand und Netzbezug und erkennt, dass gerade keine hohen Überschüsse entstehen."},
    {"type":"textarea","id":"result","label":"ERGEBNIS","default":"Gespeicherter Solarstrom wird gezielt dort eingesetzt, wo morgens Bedarf entsteht."}
  ]}],
  "max_blocks":8,
  "presets":[{"name":"AI Energie – Im Alltag","blocks":[{"type":"scenario"},{"type":"scenario"},{"type":"scenario"},{"type":"scenario"}]}]
}
{% endschema %}
