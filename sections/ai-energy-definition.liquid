{%- assign page_id = 'ai-energy-definition-' | append: section.id -%}

<div class="ai-energy-page" data-ai-energy-page>
  <section id="definition" class="ai-energy__section ai-energy__definition" data-ai-anchor aria-labelledby="{{ page_id }}-heading">
    <div class="ai-energy__container">
      <p class="ai-energy__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 id="{{ page_id }}-heading">{{ section.settings.heading_before }} <span>{{ section.settings.heading_highlight }}</span></h2>
      <div class="ai-energy__answer"><strong>{{ section.settings.answer_label }}</strong> {{ section.settings.answer }}</div>
      <p class="ai-energy__muted">{{ section.settings.subtext }}</p>
      <div class="ai-energy__feature-grid">
        {% for block in section.blocks %}
          <article class="ai-energy__feature-card" {{ block.shopify_attributes }}>
            <span class="ai-energy__feature-icon" aria-hidden="true">{{ block.settings.icon }}</span>
            <p class="ai-energy__tag">{{ block.settings.label }}</p>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "AI Energie – Definition",
  "tag": "section",
  "class": "section-ai-energy-definition",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Definition"},
    {"type":"text","id":"heading_before","label":"Titel Hauptsatz","default":"Was bedeutet intelligentes"},
    {"type":"text","id":"heading_highlight","label":"Titel Hervorhebung","default":"Energiemanagement?"},
    {"type":"text","id":"answer_label","label":"Kurzantwort Label","default":"Kurz gesagt:"},
    {"type":"textarea","id":"answer","label":"Kurzantwort","default":"AI-Energiemanagement beschreibt ein intelligentes System, das Energieflüsse im Haushalt erkennt, analysiert und die Nutzung von Solarstrom optimiert."},
    {"type":"textarea","id":"subtext","label":"Einleitungstext","default":"Es geht dabei nicht um automatisch Geld verdienen, sondern um etwas Nüchternes: die Energie, die dein Haushalt selbst erzeugt, möglichst gut im eigenen Alltag zu nutzen."}
  ],
  "blocks": [
    {"type":"feature","name":"Feature","settings":[
      {"type":"text","id":"icon","label":"Icon","default":"01"},
      {"type":"text","id":"label","label":"Nummer und Label","default":"01 · ENERGIE ERKENNEN"},
      {"type":"text","id":"title","label":"Titel","default":"Energieflüsse verstehen"},
      {"type":"textarea","id":"text","label":"Beschreibung","default":"Smart Meter und Systemdaten zeigen, wann Energie erzeugt, verbraucht oder gespeichert wird."}
    ]}
  ],
  "max_blocks": 8,
  "presets": [{"name":"AI Energie – Definition","blocks":[{"type":"feature"},{"type":"feature"},{"type":"feature"}]}]
}
{% endschema %}
