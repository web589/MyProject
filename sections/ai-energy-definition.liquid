{%- assign page_id = 'ai-energy-definition-' | append: section.id -%}

<div class="ai-energy-page" data-ai-energy-page style="{% render 'ai-energy-style', section: section %}">
  <section id="definition" class="ai-energy__section ai-energy__definition" data-ai-anchor aria-labelledby="{{ page_id }}-heading">
    <div class="ai-energy__container">
      <p class="ai-energy__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 id="{{ page_id }}-heading">{{ section.settings.heading_before }} <span>{{ section.settings.heading_highlight }}</span></h2>
      <div class="ai-energy__answer"><strong>{{ section.settings.answer_label }}</strong> {{ section.settings.answer }}</div>
      <p class="ai-energy__muted">{{ section.settings.subtext }}</p>
      <div class="ai-energy__feature-grid">
        {% for block in section.blocks %}
          <article class="ai-energy__feature-card" {{ block.shopify_attributes }}>
            {% if block.settings.icon != blank %}
              <span class="ai-energy__feature-icon" aria-hidden="true">
                {{ block.settings.icon | image_url: width: 64 | image_tag: loading: 'lazy', widths: '32, 48, 64', sizes: '24px', alt: '' }}
              </span>
            {% endif %}
            <p class="ai-energy__tag">{{ block.settings.label }}</p>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "AI Energie – Definition",
  "tag": "section",
  "class": "section-ai-energy-definition",
  "settings": [
    {"type":"text","id":"eyebrow","label":"眉题","default":"Definition"},
    {"type":"text","id":"heading_before","label":"标题前半部分","default":"Was bedeutet intelligentes"},
    {"type":"text","id":"heading_highlight","label":"标题高亮","default":"Energiemanagement?"},
    {"type":"text","id":"answer_label","label":"答案标签","default":"Kurz gesagt:"},
    {"type":"textarea","id":"answer","label":"答案","default":"AI-Energiemanagement beschreibt ein intelligentes System, das Energieflüsse im Haushalt erkennt, analysiert und die Nutzung von Solarstrom optimiert."},
    {"type":"textarea","id":"subtext","label":"补充文字","default":"Es geht dabei nicht um automatisch Geld verdienen, sondern um etwas Nüchternes: die Energie, die dein Haushalt selbst erzeugt, möglichst gut im eigenen Alltag zu nutzen."},
    {"type":"header","content":"Typography"},
    {"type":"range","id":"eyebrow_size","label":"眉题大小","min":9,"max":18,"step":1,"unit":"px","default":11},
    {"type":"range","id":"item_heading_size","label":"项目标题大小","min":14,"max":30,"step":1,"unit":"px","default":18},
    {"type":"range","id":"item_text_size","label":"项目文本大小","min":10,"max":20,"step":1,"unit":"px","default":13},
    {"type":"range","id":"control_size","label":"控件大小","min":11,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"note_size","label":"备注大小","min":10,"max":18,"step":1,"unit":"px","default":12},
    {"type":"header","content":"Layout und Größen"},
    {"type":"range","id":"heading_size","label":"标题大小","min":28,"max":72,"step":1,"unit":"px","default":34},
    {"type":"range","id":"body_size","label":"正文大小","min":12,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"section_spacing","label":"区块间距","min":40,"max":140,"step":4,"unit":"px","default":80}
  ],
  "blocks": [
    {"type":"feature","name":"Feature","settings":[
      {"type":"image_picker","id":"icon","label":"图标"},
      {"type":"text","id":"label","label":"标签","default":"01 · ENERGIE ERKENNEN"},
      {"type":"text","id":"title","label":"标题","default":"Energieflüsse verstehen"},
      {"type":"textarea","id":"text","label":"文本","default":"Smart Meter und Systemdaten zeigen, wann Energie erzeugt, verbraucht oder gespeichert wird."}
    ]}
  ],
  "max_blocks": 8,
  "presets": [{"name":"AI Energie – Definition","blocks":[{"type":"feature"},{"type":"feature"},{"type":"feature"}]}]
}
{% endschema %}
