{%- assign page_id = 'ai-energy-faq-' | append: section.id -%}

<div class="ai-energy-page" data-ai-energy-page>
  <section id="faq" class="ai-energy__section ai-energy__faq" data-ai-anchor aria-labelledby="{{ page_id }}-heading">
    <div class="ai-energy__container">
      <p class="ai-energy__eyebrow">Häufige Fragen</p>
      <h2 id="{{ page_id }}-heading">Fragen zum <span>Energiemanagement</span></h2>
      <div class="ai-energy__faq-list">
        {% for block in section.blocks %}
          <article class="ai-energy__faq-item" {{ block.shopify_attributes }}>
            <button type="button" class="ai-energy__faq-question" data-ai-faq-question aria-expanded="false"><span>{{ block.settings.question }}</span><span aria-hidden="true">+</span></button>
            <div class="ai-energy__faq-answer" data-ai-faq-answer hidden>{{ block.settings.answer }}</div>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name":"AI Energie – FAQ",
  "tag":"section",
  "class":"section-ai-energy-faq",
  "settings":[],
  "blocks":[{"type":"faq","name":"FAQ Frage","settings":[{"type":"text","id":"question","label":"Frage"},{"type":"richtext","id":"answer","label":"Antwort"}]}],
  "max_blocks":12,
  "presets":[{"name":"AI Energie – FAQ","blocks":[{"type":"faq"},{"type":"faq"},{"type":"faq"},{"type":"faq"},{"type":"faq"},{"type":"faq"}]}]
}
{% endschema %}
