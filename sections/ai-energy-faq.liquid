{%- assign page_id = 'ai-energy-faq-' | append: section.id -%}

<div class="ai-energy-page" data-ai-energy-page style="{% render 'ai-energy-style', section: section %}">
  <section id="faq" class="ai-energy__section ai-energy__faq" data-ai-anchor aria-labelledby="{{ page_id }}-heading">
    <div class="ai-energy__container">
      <p class="ai-energy__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 id="{{ page_id }}-heading">{{ section.settings.heading_before }} <span>{{ section.settings.heading_highlight }}</span></h2>
      {% if section.settings.subtext != blank %}<p class="ai-energy__subtext">{{ section.settings.subtext }}</p>{% endif %}
      <div class="ai-energy__faq-list">
        {% for block in section.blocks %}
          {%- assign faq_question_id = 'ai-energy-faq-question-' | append: section.id | append: '-' | append: block.id -%}
          {%- assign faq_answer_id = 'ai-energy-faq-answer-' | append: section.id | append: '-' | append: block.id -%}
          <article class="ai-energy__faq-item" {{ block.shopify_attributes }}>
            <button id="{{ faq_question_id }}" type="button" class="ai-energy__faq-question" data-ai-faq-question aria-controls="{{ faq_answer_id }}" aria-expanded="false"><span>{{ block.settings.question }}</span><span aria-hidden="true">+</span></button>
            <div id="{{ faq_answer_id }}" class="ai-energy__faq-answer" data-ai-faq-answer role="region" aria-labelledby="{{ faq_question_id }}" aria-hidden="true" hidden>
              <div class="ai-energy__faq-answer-inner">{{ block.settings.answer }}</div>
            </div>
          </article>
        {% endfor %}
      </div>
      {% if section.settings.cta_label != blank %}<a class="ai-energy__text-link" href="{{ section.settings.cta_url | default: '#modelle' }}">{{ section.settings.cta_label }}</a>{% endif %}
    </div>
  </section>
</div>

{% schema %}
{
  "name":"AI Energie – FAQ",
  "tag":"section",
  "class":"section-ai-energy-faq",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Häufige Fragen"},
    {"type":"text","id":"heading_before","label":"Titel Hauptsatz","default":"Fragen zum"},
    {"type":"text","id":"heading_highlight","label":"Titel Hervorhebung","default":"Energiemanagement"},
    {"type":"textarea","id":"subtext","label":"Untertitel","default":"Klare Antworten zu Daten, Speicher und intelligenter Nutzung von Solarstrom."},
    {"type":"text","id":"cta_label","label":"CTA Text"},
    {"type":"url","id":"cta_url","label":"CTA Link"},
    {"type":"header","content":"Typography"},
    {"type":"range","id":"eyebrow_size","label":"Kicker und Label Größe","min":9,"max":18,"step":1,"unit":"px","default":11},
    {"type":"range","id":"item_heading_size","label":"Elementüberschrift Größe","min":14,"max":30,"step":1,"unit":"px","default":18},
    {"type":"range","id":"item_text_size","label":"Elementtext Größe","min":10,"max":20,"step":1,"unit":"px","default":13},
    {"type":"range","id":"control_size","label":"Button und Link Größe","min":11,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"note_size","label":"Hinweisgröße","min":10,"max":18,"step":1,"unit":"px","default":12},
    {"type":"header","content":"Layout und Größen"},
    {"type":"range","id":"heading_size","label":"Überschrift Größe","min":28,"max":72,"step":1,"unit":"px","default":34},
    {"type":"range","id":"body_size","label":"Textgröße","min":12,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"section_spacing","label":"Abstand oben und unten","min":40,"max":140,"step":4,"unit":"px","default":80}
  ],
  "blocks":[{"type":"faq","name":"FAQ Frage","settings":[{"type":"text","id":"question","label":"Frage"},{"type":"richtext","id":"answer","label":"Antwort"}]}],
  "max_blocks":12,
  "presets":[{"name":"AI Energie – FAQ","blocks":[{"type":"faq"},{"type":"faq"},{"type":"faq"},{"type":"faq"},{"type":"faq"},{"type":"faq"}]}]
}
{% endschema %}
