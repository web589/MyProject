{%- liquid
  assign page_id = 'ai-energy-guides-' | append: section.id
  assign blog_url = '/blogs/blog-center'
-%}

<div class="ai-energy-page" data-ai-energy-page style="{% render 'ai-energy-style', section: section %} --ai-guide-image-height: {{ section.settings.guide_image_height | default: 280 }}px; --ai-guide-image-width: {{ section.settings.guide_image_width | default: 100 }}%;">
  <section id="ratgeber" class="ai-energy__section ai-energy__guides" aria-labelledby="{{ page_id }}-heading">
    <div class="ai-energy__container">
      <p class="ai-energy__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 id="{{ page_id }}-heading">{{ section.settings.heading_before }} <span>{{ section.settings.heading_highlight }}</span></h2>
      {% if section.settings.subtext != blank %}<p class="ai-energy__subtext">{{ section.settings.subtext }}</p>{% endif %}
      <div class="ai-energy__guide-grid">
        {% for block in section.blocks %}
          <article class="ai-energy__guide-card" {{ block.shopify_attributes }}>
            <a class="ai-energy__guide-media" href="{{ block.settings.url | default: blog_url }}">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 600, 900', sizes: '(min-width: 960px) 33vw, 100vw', alt: block.settings.image_alt | default: block.settings.title }}{% else %}<div class="ph ai-energy__placeholder">Ratgeberbild auswählen</div>{% endif %}</a>
            <div class="ai-energy__guide-copy"><p class="ai-energy__tag">{{ block.settings.tag }}</p><h3>{{ block.settings.title }}</h3><p>{{ block.settings.excerpt }}</p><a class="ai-energy__text-link" href="{{ block.settings.url | default: blog_url }}">{{ block.settings.link_label }}</a></div>
          </article>
        {% endfor %}
      </div>
      {% if section.settings.cta_label != blank %}<a class="ai-energy__button ai-energy__button--{{ section.settings.cta_style }} ai-energy__center-cta" href="{{ section.settings.cta_url | default: blog_url }}">{{ section.settings.cta_label }}</a>{% endif %}
    </div>
  </section>
</div>

{% schema %}
{
  "name":"AI Energie – Ratgeber",
  "tag":"section",
  "class":"section-ai-energy-guides",
  "settings":[
    {"type":"text","id":"eyebrow","label":"眉题","default":"Mehr erfahren"},
    {"type":"text","id":"heading_before","label":"标题前半部分","default":"Ratgeber &"},
    {"type":"text","id":"heading_highlight","label":"标题高亮","default":"Energie-Wissen"},
    {"type":"textarea","id":"subtext","label":"补充文字","default":"Praktische Antworten und Hintergrundwissen für deinen nächsten Schritt."},
    {"type":"text","id":"cta_label","label":"行动按钮标签","default":"Alle Ratgeber ansehen →"},
    {"type":"url","id":"cta_url","label":"行动按钮链接地址"},
    {"type":"select","id":"cta_style","label":"行动按钮样式","options":[{"value":"primary","label":"Primär"},{"value":"secondary","label":"Sekundär"}],"default":"secondary"},
    {"type":"header","content":"Typography"},
    {"type":"range","id":"eyebrow_size","label":"眉题大小","min":9,"max":18,"step":1,"unit":"px","default":11},
    {"type":"range","id":"item_heading_size","label":"项目标题大小","min":14,"max":30,"step":1,"unit":"px","default":18},
    {"type":"range","id":"item_text_size","label":"项目文本大小","min":10,"max":20,"step":1,"unit":"px","default":13},
    {"type":"range","id":"control_size","label":"控件大小","min":11,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"note_size","label":"备注大小","min":10,"max":18,"step":1,"unit":"px","default":12},
    {"type":"header","content":"Layout und Größen"},
    {"type":"range","id":"heading_size","label":"标题大小","min":28,"max":72,"step":1,"unit":"px","default":34},
    {"type":"range","id":"body_size","label":"正文大小","min":12,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"section_spacing","label":"区块间距","min":40,"max":140,"step":4,"unit":"px","default":80},
    {"type":"range","id":"guide_image_height","label":"指南图片高度","min":180,"max":420,"step":10,"unit":"px","default":280},
    {"type":"range","id":"guide_image_width","label":"指南图片宽度","min":40,"max":100,"step":1,"unit":"%","default":100}
  ],
  "blocks":[{"type":"guide","name":"Ratgeber Karte","settings":[
    {"type":"text","id":"tag","label":"标记","default":"RATGEBER"},
    {"type":"text","id":"title","label":"标题"},
    {"type":"textarea","id":"excerpt","label":"摘要"},
    {"type":"image_picker","id":"image","label":"图片"},
    {"type":"text","id":"image_alt","label":"图片替代文字"},
    {"type":"url","id":"url","label":"链接地址"},
    {"type":"text","id":"link_label","label":"卡片链接文字","default":"Weiterlesen →"}
  ]}],
  "max_blocks":12,
  "presets":[{"name":"AI Energie – Ratgeber","blocks":[{"type":"guide"},{"type":"guide"},{"type":"guide"}]}]
}
{% endschema %}
