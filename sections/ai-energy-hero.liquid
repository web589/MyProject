{%- liquid
  assign page_id = 'ai-energy-hero-' | append: section.id
-%}

<div class="ai-energy-page" data-ai-energy-page>
  <section class="ai-energy__section ai-energy__hero" aria-labelledby="{{ page_id }}-heading">
    <div class="ai-energy__container ai-energy__hero-grid">
      <div class="ai-energy__hero-copy">
        <p class="ai-energy__eyebrow">{{ section.settings.hero_eyebrow }}</p>
        <h1 id="{{ page_id }}-heading">{{ section.settings.hero_heading }}</h1>
        <p class="ai-energy__lead">{{ section.settings.hero_text }}</p>
        <div class="ai-energy__actions">
          <a class="ai-energy__button ai-energy__button--primary" href="#funktion">{{ section.settings.hero_function_label }}</a>
          <a class="ai-energy__button ai-energy__button--secondary" href="#modelle">{{ section.settings.hero_models_label }}</a>
        </div>
      </div>
      <div class="ai-energy__media ai-energy__media--hero">
        {% if section.settings.hero_image != blank %}
          {{ section.settings.hero_image | image_url: width: 1800 | image_tag: loading: 'eager', widths: '640, 960, 1280, 1600, 1800', sizes: '(min-width: 960px) 50vw, 100vw', alt: 'VENUS E Solarspeicher mit Photovoltaikanlage und Smart Energy System' }}
        {% endif %}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "AI Energie – Hero",
  "tag": "section",
  "class": "section-ai-energy-hero",
  "settings": [
    {"type":"text","id":"hero_eyebrow","label":"Hero Eyebrow","default":"Technologie · Smart Energy"},
    {"type":"text","id":"hero_heading","label":"Hero Überschrift","default":"AI-Energiemanagement: Solarstrom intelligent nutzen"},
    {"type":"textarea","id":"hero_text","label":"Hero Text","default":"VENUS E verbindet Energieerzeugung, Verbrauch und Speicher zu einem intelligenten System. So kannst du deinen Eigenverbrauch erhöhen und Solarstrom gezielter nutzen."},
    {"type":"text","id":"hero_function_label","label":"Hero Hauptbutton","default":"Smart Energy entdecken"},
    {"type":"text","id":"hero_models_label","label":"Hero Nebenbutton","default":"VENUS E Modelle ansehen"},
    {"type":"image_picker","id":"hero_image","label":"Hero Bild"}
  ]
}
{% endschema %}
