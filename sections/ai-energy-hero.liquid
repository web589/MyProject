{%- assign page_id = 'ai-energy-hero-' | append: section.id -%}

<div class="ai-energy-page" data-ai-energy-page style="{% render 'ai-energy-style', section: section %} --ai-hero-image-height: {{ section.settings.hero_image_height | default: 480 }}px; --ai-hero-image-width: {{ section.settings.hero_image_width | default: 100 }}%;">
  <section class="ai-energy__section ai-energy__hero" aria-labelledby="{{ page_id }}-heading">
    <div class="ai-energy__container ai-energy__hero-grid">
      <div class="ai-energy__hero-copy">
        <p class="ai-energy__eyebrow">{{ section.settings.eyebrow }}</p>
        <h1 id="{{ page_id }}-heading">{{ section.settings.heading_before }}{% if section.settings.heading_highlight != blank %} <span>{{ section.settings.heading_highlight }}</span>{% endif %}</h1>
        <p class="ai-energy__lead">{{ section.settings.subtext }}</p>
        <div class="ai-energy__actions">
          {% for block in section.blocks %}
            {% if block.type == 'button' %}
              {% assign button_fallback = '#funktion' %}
              {% if forloop.last %}{% assign button_fallback = '#modelle' %}{% endif %}
              <a class="ai-energy__button ai-energy__button--{{ block.settings.style }}" href="{{ block.settings.url | default: button_fallback }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
            {% endif %}
          {% endfor %}
        </div>
      </div>
      <div class="ai-energy__media ai-energy__media--hero">
        {% if section.settings.hero_image != blank %}{{ section.settings.hero_image | image_url: width: 1800 | image_tag: loading: 'eager', widths: '640, 960, 1280, 1600, 1800', sizes: '(min-width: 960px) 50vw, 100vw', alt: section.settings.hero_alt }}{% else %}<div class="ph ai-energy__placeholder">Hero-Bild auswählen</div>{% endif %}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name":"AI Energie – Hero",
  "tag":"section",
  "class":"section-ai-energy-hero",
  "settings":[
    {"type":"text","id":"eyebrow","label":"眉题","default":"Technologie · Smart Energy"},
    {"type":"text","id":"heading_before","label":"标题前半部分","default":"AI-Energiemanagement: Solarstrom"},
    {"type":"text","id":"heading_highlight","label":"标题高亮","default":"intelligent nutzen"},
    {"type":"textarea","id":"subtext","label":"补充文字","default":"VENUS E verbindet Energieerzeugung, Verbrauch und Speicher zu einem intelligenten System. So kannst du deinen Eigenverbrauch erhöhen und Solarstrom gezielter nutzen."},
    {"type":"image_picker","id":"hero_image","label":"主视觉图片"},
    {"type":"text","id":"hero_alt","label":"主视觉替代文字","default":"VENUS E Solarspeicher mit Photovoltaikanlage und Smart Energy System"},
    {"type":"header","content":"Typography"},
    {"type":"range","id":"eyebrow_size","label":"眉题大小","min":9,"max":18,"step":1,"unit":"px","default":11},
    {"type":"range","id":"item_heading_size","label":"项目标题大小","min":14,"max":30,"step":1,"unit":"px","default":18},
    {"type":"range","id":"item_text_size","label":"项目文本大小","min":10,"max":20,"step":1,"unit":"px","default":12},
    {"type":"range","id":"control_size","label":"控件大小","min":11,"max":18,"step":1,"unit":"px","default":14},
    {"type":"range","id":"note_size","label":"备注大小","min":10,"max":18,"step":1,"unit":"px","default":12},
    {"type":"header","content":"Layout und Größen"},
    {"type":"range","id":"heading_size","label":"标题大小","min":36,"max":72,"step":1,"unit":"px","default":48},
    {"type":"range","id":"body_size","label":"正文大小","min":13,"max":22,"step":1,"unit":"px","default":17},
    {"type":"range","id":"section_spacing","label":"区块间距","min":40,"max":140,"step":4,"unit":"px","default":80},
    {"type":"range","id":"hero_image_height","label":"主视觉图片高度","min":320,"max":620,"step":10,"unit":"px","default":480},
    {"type":"range","id":"hero_image_width","label":"主视觉图片宽度","min":40,"max":100,"step":1,"unit":"%","default":100}
  ],
  "blocks":[{"type":"button","name":"Hero Button","settings":[
    {"type":"text","id":"label","label":"标签","default":"Smart Energy entdecken"},
    {"type":"url","id":"url","label":"链接地址"},
    {"type":"select","id":"style","label":"样式","options":[{"value":"primary","label":"Primär"},{"value":"secondary","label":"Sekundär"}],"default":"primary"}
  ]}],
  "max_blocks":4,
  "presets":[{"name":"AI Energie – Hero","blocks":[{"type":"button"},{"type":"button"}]}]
}
{% endschema %}
