{%- assign page_id = 'ai-energy-models-' | append: section.id -%}
{%- assign models_compare_url = '/pages/venus-e-vergleich' -%}

<div class="ai-energy-page" data-ai-energy-page style="{% render 'ai-energy-style', section: section %} --ai-model-image-height: {{ section.settings.model_image_height | default: 210 }}px; --ai-model-image-width: {{ section.settings.model_image_width | default: 100 }}%;">
  <section id="modelle" class="ai-energy__section ai-energy__models" data-ai-anchor aria-labelledby="{{ page_id }}-heading">
    <div class="ai-energy__container">
      <p class="ai-energy__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 id="{{ page_id }}-heading">{{ section.settings.heading_before }} <span>{{ section.settings.heading_highlight }}</span></h2>
      <p class="ai-energy__subtext">{{ section.settings.subtext }}</p>
      <div class="ai-energy__model-grid">
        {% for block in section.blocks %}
          {% assign product = block.settings.product %}
          <article class="ai-energy__model-card" {{ block.shopify_attributes }}>
            <a class="ai-energy__model-media" href="{{ block.settings.product_url | default: product.url | default: models_compare_url }}">
              {% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 600, 900', sizes: '(min-width: 960px) 25vw, 100vw', alt: product.title }}{% elsif block.settings.image != blank %}{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 600, 900', sizes: '(min-width: 960px) 25vw, 100vw', alt: block.settings.title }}{% else %}<div class="ph ai-energy__placeholder">Produktbild auswählen</div>{% endif %}
            </a>
            <div class="ai-energy__model-copy">
              <p class="ai-energy__tag">{{ block.settings.tag }}</p>
              <h3>{{ block.settings.title | default: product.title }}</h3>
              <p>{{ block.settings.text }}</p>
              <a class="ai-energy__text-link" href="{{ block.settings.product_url | default: product.url | default: models_compare_url }}">{{ block.settings.title | default: product.title }} ansehen →</a>
            </div>
          </article>
        {% endfor %}
      </div>
      {% if section.settings.cta_label != blank %}<a class="ai-energy__button ai-energy__button--{{ section.settings.cta_style }} ai-energy__center-cta" href="{{ section.settings.cta_url | default: models_compare_url }}">{{ section.settings.cta_label }}</a>{% endif %}
    </div>
  </section>
</div>

{% schema %}
{
  "name":"AI Energie – Modelle",
  "tag":"section",
  "class":"section-ai-energy-models",
  "settings":[
    {"type":"text","id":"eyebrow","label":"眉题","default":"Lösungen"},
    {"type":"text","id":"heading_before","label":"标题前半部分","default":"Welche VENUS E Lösung passt zu deinem"},
    {"type":"text","id":"heading_highlight","label":"标题高亮","default":"Energiebedarf?"},
    {"type":"textarea","id":"subtext","label":"补充文字","default":"Die Entscheidung hängt weniger von technischen Details ab als von deinem Alltag: Wie viel Energie verbrauchst du, wann brauchst du sie, und wie willst du weiter ausbauen?"},
    {"type":"text","id":"cta_label","label":"行动按钮标签","default":"Alle Modelle im Vergleich →"},
    {"type":"url","id":"cta_url","label":"行动按钮链接地址"},
    {"type":"select","id":"cta_style","label":"行动按钮样式","options":[{"value":"primary","label":"Primär"},{"value":"secondary","label":"Sekundär"}],"default":"secondary"},
    {"type":"header","content":"Typography"},
    {"type":"range","id":"eyebrow_size","label":"眉题大小","min":9,"max":18,"step":1,"unit":"px","default":11},
    {"type":"range","id":"item_heading_size","label":"项目标题大小","min":14,"max":30,"step":1,"unit":"px","default":18},
    {"type":"range","id":"item_text_size","label":"项目文本大小","min":10,"max":20,"step":1,"unit":"px","default":13},
    {"type":"range","id":"control_size","label":"控件大小","min":11,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"note_size","label":"备注大小","min":10,"max":18,"step":1,"unit":"px","default":12},
    {"type":"header","content":"Layout und Größen"},
    {"type":"range","id":"heading_size","label":"标题大小","min":28,"max":72,"step":1,"unit":"px","default":34},
    {"type":"range","id":"body_size","label":"正文大小","min":12,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"section_spacing","label":"区块间距","min":40,"max":140,"step":4,"unit":"px","default":80},
    {"type":"range","id":"model_image_height","label":"型号图片高度","min":160,"max":360,"step":10,"unit":"px","default":210},
    {"type":"range","id":"model_image_width","label":"型号图片宽度","min":40,"max":100,"step":1,"unit":"%","default":100}
  ],
  "blocks":[{"type":"model","name":"Modellkarte","settings":[
    {"type":"product","id":"product","label":"产品"},
    {"type":"image_picker","id":"image","label":"图片"},
    {"type":"url","id":"product_url","label":"产品链接地址"},
    {"type":"text","id":"tag","label":"标记","default":"KOMPAKTE LÖSUNG"},
    {"type":"text","id":"title","label":"标题","default":"VENUS E Mini"},
    {"type":"textarea","id":"text","label":"文本","default":"Für kleinere Haushalte und einfache Energieoptimierung."}
  ]}],
  "max_blocks":8,
  "presets":[{"name":"AI Energie – Modelle","blocks":[{"type":"model"},{"type":"model"},{"type":"model"},{"type":"model"}]}]
}
{% endschema %}
