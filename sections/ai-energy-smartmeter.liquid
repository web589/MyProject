{%- assign page_id = 'ai-energy-smartmeter-' | append: section.id -%}
{%- assign smart_meter_url = '/products/ct002-smart-meter' -%}

<div class="ai-energy-page" data-ai-energy-page style="{% render 'ai-energy-style', section: section %} --ai-meter-image-height: {{ section.settings.smart_meter_image_height | default: 260 }}px; --ai-thumb-image-height: {{ section.settings.smart_thumb_image_height | default: 170 }}px; --ai-smart-image-width: {{ section.settings.smart_image_width | default: 100 }}%;">
  <section id="smartmeter" class="ai-energy__section ai-energy__smartmeter" data-ai-anchor aria-labelledby="{{ page_id }}-heading">
    <div class="ai-energy__container">
      <p class="ai-energy__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 id="{{ page_id }}-heading">{{ section.settings.heading_before }} <span>{{ section.settings.heading_highlight }}</span></h2>
      <div class="ai-energy__smart-grid">
        <div class="ai-energy__smart-media">
          <div class="ai-energy__media ai-energy__media--meter">
            {% if section.settings.smart_meter_image != blank %}{{ section.settings.smart_meter_image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '550, 800, 1100', sizes: '(min-width: 960px) 42vw, 100vw', alt: section.settings.smart_meter_alt }}{% else %}<div class="ph ai-energy__placeholder">Smart-Meter-Bild auswählen</div>{% endif %}
          </div>
          <div class="ai-energy__smart-thumbs">
            <div class="ai-energy__media">{% if section.settings.ct002_image != blank %}{{ section.settings.ct002_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 960px) 20vw, 50vw', alt: section.settings.ct002_alt }}{% else %}<div class="ph ai-energy__placeholder">CT002-Bild auswählen</div>{% endif %}</div>
            <div class="ai-energy__media">{% if section.settings.ct003_image != blank %}{{ section.settings.ct003_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 960px) 20vw, 50vw', alt: section.settings.ct003_alt }}{% else %}<div class="ph ai-energy__placeholder">CT003-Bild auswählen</div>{% endif %}</div>
          </div>
        </div>
        <div class="ai-energy__smart-copy">
          <p>{{ section.settings.subtext }}</p>
          <div class="ai-energy__smart-points">
            {% for block in section.blocks %}
              <article {{ block.shopify_attributes }}><strong>{{ block.settings.number }}</strong><div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div></article>
            {% endfor %}
          </div>
          {% if section.settings.cta_label != blank %}<a class="ai-energy__button ai-energy__button--{{ section.settings.cta_style }}" href="{{ section.settings.cta_url | default: smart_meter_url }}">{{ section.settings.cta_label }}</a>{% endif %}
        </div>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name":"AI Energie – Smart Meter",
  "tag":"section",
  "class":"section-ai-energy-smartmeter",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Datenbasis"},
    {"type":"text","id":"heading_before","label":"Titel Hauptsatz","default":"Smart Meter: Die Grundlage für"},
    {"type":"text","id":"heading_highlight","label":"Titel Hervorhebung","default":"intelligente Steuerung"},
    {"type":"textarea","id":"subtext","label":"Untertitel","default":"Ohne aktuelle Energiedaten kann ein Speicher nur reagieren. Mit Smart Meter erkennt VENUS E, was im Haushalt passiert, und kann Energieflüsse gezielter steuern."},
    {"type":"image_picker","id":"smart_meter_image","label":"Smart Meter Hauptbild"},
    {"type":"text","id":"smart_meter_alt","label":"Hauptbild Alt-Text","default":"MARSTEK Smart Meter im Verteilerkasten"},
    {"type":"image_picker","id":"ct002_image","label":"CT002 Bild"},
    {"type":"text","id":"ct002_alt","label":"CT002 Alt-Text","default":"MARSTEK CT002 Smart Meter"},
    {"type":"image_picker","id":"ct003_image","label":"CT003 Bild"},
    {"type":"text","id":"ct003_alt","label":"CT003 Alt-Text","default":"MARSTEK CT003 P1 Smart Meter"},
    {"type":"text","id":"cta_label","label":"CTA Text","default":"Mehr über Smart Meter erfahren →"},
    {"type":"url","id":"cta_url","label":"CTA Link"},
    {"type":"select","id":"cta_style","label":"CTA Stil","options":[{"value":"primary","label":"Primär"},{"value":"secondary","label":"Sekundär"}],"default":"primary"},
    {"type":"header","content":"Typography"},
    {"type":"range","id":"eyebrow_size","label":"Kicker und Label Größe","min":9,"max":18,"step":1,"unit":"px","default":11},
    {"type":"range","id":"item_heading_size","label":"Elementüberschrift Größe","min":14,"max":30,"step":1,"unit":"px","default":18},
    {"type":"range","id":"item_text_size","label":"Elementtext Größe","min":10,"max":20,"step":1,"unit":"px","default":13},
    {"type":"range","id":"control_size","label":"Button und Link Größe","min":11,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"note_size","label":"Hinweisgröße","min":10,"max":18,"step":1,"unit":"px","default":12},
    {"type":"header","content":"Layout und Größen"},
    {"type":"range","id":"heading_size","label":"Überschrift Größe","min":28,"max":72,"step":1,"unit":"px","default":34},
    {"type":"range","id":"body_size","label":"Textgröße","min":12,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"section_spacing","label":"Abstand oben und unten","min":40,"max":140,"step":4,"unit":"px","default":80},
    {"type":"range","id":"smart_meter_image_height","label":"Smart-Meter-Bildhöhe","min":220,"max":420,"step":10,"unit":"px","default":260},
    {"type":"range","id":"smart_thumb_image_height","label":"Kleine Bilder Höhe","min":120,"max":260,"step":10,"unit":"px","default":170},
    {"type":"range","id":"smart_image_width","label":"Smart-Meter-Bildbreite","min":40,"max":100,"step":1,"unit":"%","default":100}
  ],
  "blocks":[{"type":"point","name":"Datenpunkt","settings":[
    {"type":"text","id":"number","label":"Nummer","default":"01"},
    {"type":"text","id":"title","label":"Titel","default":"Verbrauch messen"},
    {"type":"textarea","id":"text","label":"Beschreibung","default":"Der Smart Meter erfasst, wie viel Energie dein Haushalt aktuell nutzt – und wann diese Nachfrage entsteht."}
  ]}],
  "max_blocks":8,
  "presets":[{"name":"AI Energie – Smart Meter","blocks":[{"type":"point"},{"type":"point"},{"type":"point"}]}]
}
{% endschema %}
