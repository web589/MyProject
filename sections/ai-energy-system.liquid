{%- assign page_id = 'ai-energy-system-' | append: section.id -%}

<div class="ai-energy-page" data-ai-energy-page style="{% render 'ai-energy-style', section: section %} --ai-system-image-height: {{ section.settings.system_image_height | default: 230 }}px; --ai-system-image-width: {{ section.settings.system_image_width | default: 100 }}%;">
  <section id="system" class="ai-energy__section ai-energy__system" data-ai-anchor aria-labelledby="{{ page_id }}-heading">
    <div class="ai-energy__container">
      <p class="ai-energy__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 id="{{ page_id }}-heading">{{ section.settings.heading_before }} <span>{{ section.settings.heading_highlight }}</span></h2>
      <p class="ai-energy__subtext">{{ section.settings.subtext }}</p>
      <div class="ai-energy__bento">
        {% for block in section.blocks %}
          <article class="ai-energy__bento-card{% if block.settings.layout != 'standard' %} ai-energy__bento-card--{{ block.settings.layout }}{% endif %}" {{ block.shopify_attributes }}>
            <div class="ai-energy__badge">{{ block.settings.badge }}</div>
            <div class="ai-energy__bento-media{% if block.settings.show_diagram %} ai-energy__vpp-visual{% endif %}">
              {% if block.settings.show_diagram %}
                <svg viewBox="0 0 360 180" role="img" aria-label="Virtuelles Kraftwerk Diagramm"><path d="M52 88h256M92 47l-40 41 40 41M268 47l40 41-40 41M180 24v128"/><circle cx="52" cy="88" r="13"/><circle cx="180" cy="88" r="16"/><circle cx="308" cy="88" r="13"/></svg>
              {% elsif block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '700, 1000, 1400', sizes: '(min-width: 960px) 50vw, 100vw', alt: block.settings.image_alt | default: block.settings.title }}
              {% else %}
                <div class="ph ai-energy__placeholder{% if block.settings.show_diagram %} ph--dark{% endif %}">Systembild auswählen</div>
              {% endif %}
            </div>
            <div class="ai-energy__bento-copy"><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>
          </article>
        {% endfor %}
      </div>
      {% if section.settings.cta_label != blank %}<a class="ai-energy__button ai-energy__button--{{ section.settings.cta_style }} ai-energy__center-cta" href="{{ section.settings.cta_url | default: '#modelle' }}">{{ section.settings.cta_label }}</a>{% endif %}
    </div>
  </section>
</div>

{% schema %}
{
  "name":"AI Energie – System",
  "tag":"section",
  "class":"section-ai-energy-system",
  "settings":[
    {"type":"text","id":"eyebrow","label":"眉题","default":"VENUS E System"},
    {"type":"text","id":"heading_before","label":"标题前半部分","default":"Ein System, das mit deinem"},
    {"type":"text","id":"heading_highlight","label":"标题高亮","default":"Energiebedarf mitdenkt"},
    {"type":"textarea","id":"subtext","label":"补充文字","default":"Vier Rollen, ein System: der Speicher als Kern, die App als Fenster zum System, der Smart Meter als Datenquelle – und eine Architektur, die für mehr ausgelegt ist. Sie arbeiten nicht nebeneinander, sondern greifen ineinander."},
    {"type":"text","id":"cta_label","label":"行动按钮标签","default":"Passende VENUS E Lösung finden"},
    {"type":"url","id":"cta_url","label":"行动按钮链接地址"},
    {"type":"select","id":"cta_style","label":"行动按钮样式","options":[{"value":"primary","label":"Primär"},{"value":"secondary","label":"Sekundär"}],"default":"primary"},
    {"type":"header","content":"Typography"},
    {"type":"range","id":"eyebrow_size","label":"眉题大小","min":9,"max":18,"step":1,"unit":"px","default":11},
    {"type":"range","id":"item_heading_size","label":"项目标题大小","min":14,"max":30,"step":1,"unit":"px","default":18},
    {"type":"range","id":"item_text_size","label":"项目文本大小","min":10,"max":20,"step":1,"unit":"px","default":13},
    {"type":"range","id":"control_size","label":"控件大小","min":11,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"note_size","label":"备注大小","min":10,"max":18,"step":1,"unit":"px","default":12},
    {"type":"header","content":"Layout und Größen"},
    {"type":"range","id":"heading_size","label":"标题大小","min":28,"max":72,"step":1,"unit":"px","default":34},
    {"type":"range","id":"body_size","label":"正文大小","min":12,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"section_spacing","label":"区块间距","min":40,"max":140,"step":4,"unit":"px","default":80},
    {"type":"range","id":"system_image_height","label":"系统图片高度","min":160,"max":500,"step":10,"unit":"px","default":230},
    {"type":"range","id":"system_image_width","label":"系统图片宽度","min":40,"max":100,"step":1,"unit":"%","default":100}
  ],
  "blocks":[{"type":"bento","name":"Systemkarte","settings":[
    {"type":"text","id":"badge","label":"徽标","default":"01 · KERN"},
    {"type":"text","id":"title","label":"标题","default":"VENUS E Speicher"},
    {"type":"textarea","id":"text","label":"文本","default":"Nimmt Energie auf, hält sie bereit und gibt sie über das Hausnetz wieder ab – abgestimmt auf das, was im Haushalt gerade passiert. Er ist die Hardware, in der alle Entscheidungen des Systems zusammenlaufen."},
    {"type":"image_picker","id":"image","label":"图片"},
    {"type":"text","id":"image_alt","label":"图片替代文字","default":"VENUS E Speicher im Zuhause"},
    {"type":"select","id":"layout","label":"布局","options":[{"value":"main","label":"Groß"},{"value":"app","label":"Mittel"},{"value":"standard","label":"Standard"}],"default":"standard"},
    {"type":"checkbox","id":"show_diagram","label":"显示示意图","default":false}
  ]}],
  "max_blocks":8,
  "presets":[{"name":"AI Energie – System","blocks":[{"type":"bento"},{"type":"bento"},{"type":"bento"},{"type":"bento"}]}]
}
{% endschema %}
