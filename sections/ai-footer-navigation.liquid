{% comment %}
  @prompt
    <style>
    .marstek-footer * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      list-style: none;
      text-decoration: none;
    }
    .marstek-footer {
      background-color: #0A1628;
      color: rgba(255, 255, 255, 0.7);
      padding: 60px 20px 30px;
      font-family: system-ui, sans-serif;
    }
    .footer-container {
      max-width: 1400px;
      margin: 0 auto;
    }
    /* 四栏导航主体 */
    .footer-nav-wrap {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 60px;
      margin-bottom: 50px;
      padding-bottom: 30px;
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }
    /* 品牌第一列 */
    .footer-brand h1 {
      color: #ffffff;
      font-size: 42px;
      font-weight: 700;
      margin-bottom: 16px;
      letter-spacing: 2px;
    }
    .footer-brand .brand-desc {
      font-size: 18px;
      line-height: 1.6;
      max-width: 320px;
    }
    /* 导航列通用样式 */
    .footer-column h3 {
      color: #ffffff;
      font-size: 22px;
      margin-bottom: 22px;
      font-weight: 500;
    }
    .footer-column li {
      margin-bottom: 16px;
    }
    .footer-column li a {
      color: rgba(255, 255, 255, 0.65);
      font-size: 17px;
      transition: 0.2s;
    }
    .footer-column li a:hover {
      color: #ffffff;
    }
    /* 底部版权栏 */
    .footer-bottom-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 16px;
      color: rgba(255,255,255,0.5);
      flex-wrap: wrap;
      gap: 20px;
    }
    .lang-switch a {
      color: rgba(255,255,255,0.5);
    }
    /* 移动端自适应 */
    @media (max-width: 1024px) {
      .footer-nav-wrap {
        grid-template-columns: 1fr 1fr;
        gap: 40px;
      }
    }
    @media (max-width: 640px) {
      .footer-nav-wrap {
        grid-template-columns: 1fr;
      }
      .footer-bottom-bar {
        flex-direction: column;
        text-align: center;
      }
    }
    </style>
    
    <div class="marstek-footer">
      <div class="footer-container">
        <div class="footer-nav-wrap">
          <!-- 品牌栏 -->
          <div class="footer-column footer-brand">
            <h1>MARSTEK</h1>
            <p class="brand-desc">Sonne als zuverlässiger Strom für Ihr Zuhause.</p>
          </div>
          <!-- Produkte -->
          <div class="footer-column">
            <h3>Produkte</h3>
            <ul>
              <li><a href="#">VENUSE Mini</a></li>
              <li><a href="#">VENUSE 3.0</a></li>
              <li><a href="#">VENUSE 4.0</a></li>
              <li><a href="#">VENUSE MAX</a></li>
            </ul>
          </div>
          <!-- Support -->
          <div class="footer-column">
            <h3>Support</h3>
            <ul>
              <li><a href="#">Installationsanleitung</a></li>
              <li><a href="#">App Download</a></li>
              <li><a href="#">FAQ</a></li>
              <li><a href="#">Kontakt</a></li>
            </ul>
          </div>
          <!-- Unternehmen -->
          <div class="footer-column">
            <h3>Unternehmen</h3>
            <ul>
              <li><a href="#">Über MARSTEK</a></li>
              <li><a href="#">Presse</a></li>
              <li><a href="#">Karriere</a></li>
              <li><a href="#">Datenschutz</a></li>
            </ul>
          </div>
        </div>
        <!-- 底部版权 -->
        <div class="footer-bottom-bar">
          <div class="copyright">© 2026 MARSTEK. All rights reserved.</div>
          <div class="lang-switch">
            <a href="#">Deutsch / Global</a>
          </div>
        </div>
      </div>
    </div>
{% endcomment %}
{% assign block = section %}
{% assign ai_gen_id = section.id | replace: '_', '' | downcase %}
{%- liquid
  assign ai_footer_facebook_link = block.settings.social_facebook_link | default: settings.social_facebook_link | default: shop.brand.metafields.social_links.facebook.value
  assign ai_footer_instagram_link = block.settings.social_instagram_link | default: settings.social_instagram_link | default: shop.brand.metafields.social_links.instagram.value
  assign ai_footer_youtube_link = block.settings.social_youtube_link | default: settings.social_youtube_link | default: shop.brand.metafields.social_links.youtube.value
  assign ai_footer_linkedin_link = block.settings.social_linkedin_link | default: settings.social_linkedin_link | default: shop.brand.metafields.social_links.linkedin.value
  assign ai_footer_reddit_link = block.settings.social_reddit_link

  assign ai_footer_show_social = false
  if ai_footer_facebook_link != blank or ai_footer_instagram_link != blank or ai_footer_youtube_link != blank or ai_footer_linkedin_link != blank or ai_footer_reddit_link != blank
    assign ai_footer_show_social = true
  endif
-%}

{% style %}
  .ai-footer-{{ ai_gen_id }} * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    list-style: none;
    text-decoration: none;
  }

  .ai-footer-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
    font-family: {{ block.settings.font_family.family }}, {{ block.settings.font_family.fallback_families }};
    width: 100%;
  }

  .ai-footer-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-footer-nav-wrap-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 2fr repeat({{ section.blocks.size }}, minmax(0, 1fr));
    gap: 60px;
    margin-bottom: 50px;
    padding-bottom: 30px;
    border-bottom: 1px solid {{ block.settings.divider_color }};
  }

  .ai-footer-brand-{{ ai_gen_id }} h1 {
    color: {{ block.settings.brand_color }};
    font-size: {{ block.settings.brand_size }}px;
    font-weight: 700;
    margin-bottom: 16px;
    letter-spacing: 2px;
  }

  .ai-footer-brand-desc-{{ ai_gen_id }} {
    font-size: {{ block.settings.brand_desc_size }}px;
    line-height: 1.6;
    max-width: 320px;
    color: {{ block.settings.text_color }};
  }

  .ai-footer-social-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 30px;
  }

  .ai-footer-social-{{ ai_gen_id }} a {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    color: #ffffff;
    background: linear-gradient(135deg, #41484f 0%, #2d3339 48%, #1f252b 100%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.14), 0 8px 18px rgba(0, 0, 0, 0.26);
    transition: transform 0.22s ease, box-shadow 0.22s ease, background 0.22s ease;
  }

  .ai-footer-social-{{ ai_gen_id }} a::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(135deg, #00c6ff 0%, #0072ff 100%);
    opacity: 0;
    transition: opacity 0.22s ease;
  }

  .ai-footer-social-{{ ai_gen_id }} a:hover,
  .ai-footer-social-{{ ai_gen_id }} a:focus-visible {
    color: #ffffff;
    transform: translateY(-3px);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22), 0 12px 26px rgba(0, 198, 255, 0.28);
  }

  .ai-footer-social-{{ ai_gen_id }} a:hover::before,
  .ai-footer-social-{{ ai_gen_id }} a:focus-visible::before {
    opacity: 1;
  }

  .ai-footer-social-{{ ai_gen_id }} a:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.9);
    outline-offset: 4px;
  }

  .ai-footer-social-{{ ai_gen_id }} svg {
    position: relative;
    z-index: 1;
    width: 17px;
    height: 17px;
    fill: currentColor;
  }

  .ai-footer-social-{{ ai_gen_id }} .ai-footer-social-icon-youtube {
    width: 18px;
    height: 18px;
  }

  .ai-footer-column-{{ ai_gen_id }} h3 {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin-bottom: 22px;
    font-weight: 500;
  }

  .ai-footer-column-{{ ai_gen_id }} li {
    margin-bottom: 16px;
  }

  .ai-footer-column-{{ ai_gen_id }} li a,
  .ai-footer-column-{{ ai_gen_id }} li span {
    color: {{ block.settings.link_color }};
    font-size: {{ block.settings.link_size }}px;
    transition: color 0.2s ease;
  }

  .ai-footer-column-{{ ai_gen_id }} li a:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-footer-bottom-bar-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: {{ block.settings.bottom_text_size }}px;
    color: {{ block.settings.bottom_text_color }};
    flex-wrap: wrap;
    gap: 20px;
  }

  .ai-footer-lang-switch-{{ ai_gen_id }} a {
    color: {{ block.settings.bottom_text_color }};
    transition: color 0.2s ease;
  }

  .ai-footer-lang-switch-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.link_hover_color }};
  }

  @media (max-width: 1024px) {
    .ai-footer-nav-wrap-{{ ai_gen_id }} {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 640px) {
    .ai-footer-nav-wrap-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
    .ai-footer-bottom-bar-{{ ai_gen_id }} {
      flex-direction: column;
      text-align: center;
    }
  }
{% endstyle %}

<footer-block-{{ ai_gen_id }} class="ai-footer-{{ ai_gen_id }}">
  <div class="ai-footer-container-{{ ai_gen_id }}">
    <div class="ai-footer-nav-wrap-{{ ai_gen_id }}">
      <div class="ai-footer-column-{{ ai_gen_id }} ai-footer-brand-{{ ai_gen_id }}">
        {% if block.settings.brand_name != blank %}
          <h1>{{ block.settings.brand_name }}</h1>
        {% endif %}
        {% if block.settings.brand_description != blank %}
          <p class="ai-footer-brand-desc-{{ ai_gen_id }}">{{ block.settings.brand_description }}</p>
        {% endif %}

        {% if ai_footer_show_social %}
          <nav class="ai-footer-social-{{ ai_gen_id }}" aria-label="MARSTEK social media">
            {% if ai_footer_facebook_link != blank %}
              <a href="{{ ai_footer_facebook_link }}" target="_blank" rel="noopener noreferrer" aria-label="MARSTEK on Facebook">
                {{ 'icon.facebook.svg' | inline_asset_content }}
              </a>
            {% endif %}
            {% if ai_footer_instagram_link != blank %}
              <a href="{{ ai_footer_instagram_link }}" target="_blank" rel="noopener noreferrer" aria-label="MARSTEK on Instagram">
                {{ 'icon.instagram.svg' | inline_asset_content }}
              </a>
            {% endif %}
            {% if ai_footer_youtube_link != blank %}
              <a href="{{ ai_footer_youtube_link }}" target="_blank" rel="noopener noreferrer" aria-label="MARSTEK on YouTube">
                <svg class="ai-footer-social-icon-youtube" aria-hidden="true" focusable="false" role="presentation" viewBox="0 0 21 20">
                  <path d="M-.196 15.803q0 1.23.812 2.092t1.977.861h14.946q1.165 0 1.977-.861t.812-2.092V3.909q0-1.23-.82-2.116T17.539.907H2.593q-1.148 0-1.969.886t-.82 2.116v11.894zm7.465-2.149V6.058q0-.115.066-.18.049-.016.082-.016l.082.016 7.153 3.806q.066.066.066.164 0 .066-.066.131l-7.153 3.806q-.033.033-.066.033-.066 0-.098-.033-.066-.066-.066-.131"/>
                </svg>
              </a>
            {% endif %}
            {% if ai_footer_linkedin_link != blank %}
              <a href="{{ ai_footer_linkedin_link }}" target="_blank" rel="noopener noreferrer" aria-label="MARSTEK on LinkedIn">
                {{ 'icon.linkedin.svg' | inline_asset_content }}
              </a>
            {% endif %}
            {% if ai_footer_reddit_link != blank %}
              <a href="{{ ai_footer_reddit_link }}" target="_blank" rel="noopener noreferrer" aria-label="MARSTEK community on Reddit">
                <svg aria-hidden="true" focusable="false" role="presentation" viewBox="0 0 24 24">
                  <path d="M20.2 12.2c0-.8-.6-1.4-1.4-1.4-.4 0-.8.2-1.1.5-1.3-.8-3.1-1.3-5.1-1.4l.9-4.1 2.9.6c.1.7.7 1.2 1.4 1.2.8 0 1.4-.6 1.4-1.4s-.6-1.4-1.4-1.4c-.5 0-1 .3-1.2.7l-3.4-.7c-.3-.1-.6.1-.6.4l-1 4.7c-2 .1-3.8.6-5.2 1.4-.3-.3-.7-.5-1.1-.5-.8 0-1.4.6-1.4 1.4 0 .6.4 1.1.9 1.3v.5c0 2.5 3.2 4.5 7.2 4.5s7.2-2 7.2-4.5v-.5c.6-.2 1-.7 1-1.3ZM8.9 13.3c0-.7.5-1.2 1.2-1.2s1.2.5 1.2 1.2-.5 1.2-1.2 1.2-1.2-.5-1.2-1.2Zm5.9 3.1c-.8.8-2.5.8-3.3.8s-2.5-.1-3.3-.8c-.2-.2-.2-.5 0-.7s.5-.2.7 0c.5.5 1.7.5 2.6.5s2.1 0 2.6-.5c.2-.2.5-.2.7 0s.2.5 0 .7Zm-.6-1.9c-.7 0-1.2-.5-1.2-1.2s.5-1.2 1.2-1.2 1.2.5 1.2 1.2-.5 1.2-1.2 1.2Z"/>
                </svg>
              </a>
            {% endif %}
          </nav>
        {% endif %}
      </div>

      {% for block in section.blocks %}
        <div class="ai-footer-column-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
          {% if block.settings.title != blank %}
            <h3>{{ block.settings.title }}</h3>
          {% endif %}
          {% if block.settings.menu != blank %}
            <ul>
              {% for link in block.settings.menu.links %}
                {% liquid
                  assign footer_link_title = link.title | strip
                  assign footer_link_url = link.url
                  case footer_link_title
                    when 'Garantie'
                      assign footer_link_url = '/pages/warranty-policy?view=widerrufsrecht'
                    when 'Widerruf & Rückgabe'
                      assign footer_link_url = '/policies/refund-policy'
                    when 'Versand & Lieferung'
                      assign footer_link_url = '/policies/shipping-policy'
                    when 'Datenschutz'
                      assign footer_link_url = '/policies/privacy-policy'
                    when 'AGB'
                      assign footer_link_url = '/policies/terms-of-service'
                    when 'Impressum'
                      assign footer_link_url = '/policies/legal-notice'
                    when 'Garantie & Rückgabe'
                      assign footer_link_url = '/pages/garantie-ruckgabe?view=widerrufsrecht'
                  endcase
                %}
                <li>
                  <a href="{{ footer_link_url }}">{{ link.title }}</a>
                </li>
              {% endfor %}
            </ul>
          {% else %}
            {% case block.id %}
              {% when 'column_products' %}
                <ul>
                  <li><a href="{{ routes.search_url }}?q=VENUS%20E%20Mini&amp;type=product">VENUSE Mini</a></li>
                  <li><a href="/products/balkonkraftwerk-800w-mit-speicher-2-2kw">VENUSE 3.0</a></li>
                  <li><a href="{{ routes.search_url }}?q=VENUS%20E%204.0&amp;type=product">VENUSE 4.0</a></li>
                  <li><a href="{{ routes.search_url }}?q=VENUS%20E%20MAX&amp;type=product">VENUSE MAX</a></li>
                </ul>
              {% when 'column_support' %}
                <ul>
                  <li><a href="/pages/setup-operation-guide">Installationsanleitung</a></li>
                  <li><a href="https://marstek.de/pages/app-download" target="_blank" rel="noopener noreferrer">App Download</a></li>
                  <li><a href="/pages/faqs">FAQ</a></li>
                  <li><a href="/pages/contact">Kontakt</a></li>
                </ul>
              {% when 'column_company' %}
                <ul>
                  <li><a href="https://marstek.de/pages/about-us" target="_blank" rel="noopener noreferrer">Über MARSTEK</a></li>
                  <li><a href="/blogs/news">Presse</a></li>
                  <li><a href="https://www.linkedin.com/company/marstek-energy-co-limited/jobs/" target="_blank" rel="noopener noreferrer">Karriere</a></li>
                  <li><a href="/policies/privacy-policy">Datenschutz</a></li>
                </ul>
            {% endcase %}
          {% endif %}
        </div>
      {% endfor %}
    </div>

    <div class="ai-footer-bottom-bar-{{ ai_gen_id }}">
      <div class="ai-footer-copyright-{{ ai_gen_id }}">
        {% if block.settings.copyright_text != blank %}
          {{ block.settings.copyright_text }}
        {% endif %}
      </div>
      <div class="ai-footer-lang-switch-{{ ai_gen_id }}">
        {% if block.settings.language_text != blank %}
          <a href="{{ block.settings.language_url }}">{{ block.settings.language_text }}</a>
        {% endif %}
      </div>
    </div>
  </div>
</footer-block-{{ ai_gen_id }}>

