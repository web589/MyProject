{%- liquid
  assign number_of_comments = article.comments_count
  if comment.status == 'pending'
    assign number_of_comments = article.comments_count | plus: 1
  endif

  assign article_blog = article.blog | default: blog
  assign blog_center_menu = linklists['blog-center']
  assign blog_center_home_link = blank
  assign blog_center_page = pages['blogs']
  assign blog_center_url = blank
  if blog_center_page != blank and blog_center_page.url != blank
    assign blog_center_url = blog_center_page.url
  elsif blog_center_menu != blank and blog_center_menu.links.size > 0
    assign blog_center_home_link = blog_center_menu.links | first
    assign blog_center_url = blog_center_home_link.url
  endif
  if blog_center_url == blank
    assign blog_center_url = article_blog.url
  endif
  if blog_center_url != blank
    unless blog_center_url contains '/pages/' or blog_center_url contains 'view='
      if blog_center_url contains '?'
        assign blog_center_url = blog_center_url | append: '&view=all'
      else
        assign blog_center_url = blog_center_url | append: '?view=all'
      endif
    endunless
  endif

  assign privacy_policy_url = '/policies/privacy-policy'
  assign newsletter_form_id = 'blog-article-newsletter-' | append: section.id
  for store_policy in shop.policies
    if store_policy.url contains 'privacy'
      assign privacy_policy_url = store_policy.url
      break
    endif
  endfor

  assign newsletter_title = 'blogs.article.newsletter_title' | t
  if section.settings.newsletter_title != blank
    assign newsletter_title = section.settings.newsletter_title
  endif

  assign newsletter_text = 'blogs.article.newsletter_text' | t
  if section.settings.newsletter_text != blank
    assign newsletter_text = section.settings.newsletter_text
  endif

  assign newsletter_email_placeholder = 'blogs.article.newsletter_email' | t
  if section.settings.newsletter_email_placeholder != blank
    assign newsletter_email_placeholder = section.settings.newsletter_email_placeholder
  endif

  assign newsletter_consent = 'blogs.article.newsletter_consent_html' | t: privacy_url: privacy_policy_url
  if section.settings.newsletter_consent != blank
    assign newsletter_consent = section.settings.newsletter_consent
  endif

  assign newsletter_submit = 'blogs.article.newsletter_submit' | t
  if section.settings.newsletter_submit != blank
    assign newsletter_submit = section.settings.newsletter_submit
  endif

  assign newsletter_success = 'general.newsletter_form.newsletter_confirmation' | t
  if section.settings.newsletter_success != blank
    assign newsletter_success = section.settings.newsletter_success
  endif

  assign recommended_products_title = 'blogs.article.recommended_products' | t
  if section.settings.recommended_products_title != blank
    assign recommended_products_title = section.settings.recommended_products_title
  endif

  assign recommended_product_count = 0
  for block in section.blocks
    if block.type == 'product' and block.settings.product != blank
      assign recommended_product_count = recommended_product_count | plus: 1
    endif
  endfor
-%}

{% style %}
  .blog-article {
    --blog-article-blue: #0099fc;
    --blog-article-ink: var(--colorTextBody, #2a3743);
    --blog-article-muted: #8a8f98;
    --blog-article-border: #e1e4e8;
  }

  .blog-article .page-width {
    max-width: 1280px;
  }

  .blog-article__hero {
    padding: 30px 0 64px;
  }

  .blog-article__hero .breadcrumb {
    align-items: center;
    color: #7b8794;
    display: flex;
    flex-wrap: nowrap;
    gap: 10px;
    line-height: 1.5;
    max-width: 100%;
    overflow: hidden;
    margin: 0 0 58px;
  }

  .blog-article__hero .breadcrumb > * {
    flex: 0 0 auto;
  }

  .blog-article__hero .breadcrumb a {
    color: inherit;
    text-decoration: none;
  }

  .blog-article__hero .breadcrumb a:hover,
  .blog-article__hero .breadcrumb a:focus-visible {
    color: var(--blog-article-blue);
  }

  .blog-article__hero .breadcrumb__current {
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .blog-article__heading {
    max-width: 1100px;
  }

  .blog-article__title {
    font-size: clamp(38px, 5vw, 64px);
    line-height: 1.08;
    letter-spacing: -0.025em;
    margin: 0 0 28px;
  }

  .blog-article__meta-row {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .blog-article__meta {
    align-items: center;
    color: var(--blog-article-muted);
    display: flex;
    flex-wrap: wrap;
    font-size: var(--typeBodySmallSize);
    gap: 10px;
  }

  .blog-article__meta-separator {
    color: var(--blog-article-muted);
  }

  .blog-article__social {
    margin-left: 8px;
  }

  .blog-article__social .social-sharing {
    margin: 0;
  }

  .blog-article__category-bar {
    background: var(--colorBody, #fff);
    border-bottom: 1px solid var(--blog-article-border);
    border-top: 1px solid var(--blog-article-border);
    margin-bottom: 62px;
    position: sticky;
    top: var(--site-header-group-height, var(--header-height, 0px));
    z-index: 25;
  }

  .blog-article__category-inner {
    align-items: center;
    display: flex;
    gap: 34px;
    min-height: 72px;
  }

  .blog-article__category-heading {
    color: var(--blog-article-ink);
    flex: 0 0 auto;
    font-size: clamp(20px, 2vw, 28px);
    font-weight: 600;
    line-height: 1.15;
    white-space: nowrap;
  }

  .blog-article__category-heading:hover {
    color: var(--blog-article-blue);
  }

  .blog-article__category-nav {
    align-items: center;
    display: flex;
    flex: 1 1 auto;
    gap: 34px;
    justify-content: flex-end;
    min-width: 0;
    overflow-x: auto;
    padding: 18px 0;
    scrollbar-width: none;
  }

  .blog-article__category-nav::-webkit-scrollbar {
    display: none;
  }

  .blog-article__category-link {
    color: var(--blog-article-ink);
    font-size: 16px;
    line-height: 1.4;
    white-space: nowrap;
  }

  .blog-article__category-link:hover,
  .blog-article__category-link[aria-current='page'] {
    color: var(--blog-article-blue);
  }

  .blog-article__category-link[aria-current='page'] {
    font-weight: 700;
  }

  .blog-article__layout {
    align-items: start;
    display: grid;
    gap: 64px;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 360px);
  }

  .blog-article__main {
    min-width: 0;
  }

  .blog-article__toc {
    border-left: 3px solid var(--blog-article-blue);
    margin: 0 0 48px;
    padding: 0 0 0 16px;
  }

  .blog-article__toc[hidden] {
    display: none;
  }

  .blog-article__toc-title {
    font-size: 18px;
    font-weight: 700;
    margin: 0 0 10px;
  }

  .blog-article__toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .blog-article__toc-item {
    margin: 0;
  }

  .blog-article__toc-link {
    color: #a0a4aa;
    display: inline-block;
    font-size: 17px;
    line-height: 1.55;
    padding: 2px 0;
  }

  .blog-article__toc-link:hover,
  .blog-article__toc-link.is-active {
    color: var(--blog-article-blue);
    font-weight: 700;
  }

  .blog-article__body {
    margin-bottom: 72px;
  }

  .blog-article__body h2,
  .blog-article__body h3 {
    scroll-margin-top: calc(var(--blog-center-sticky-height, 0px) + 24px);
  }

  .blog-article__body h2 {
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1.18;
    margin: 52px 0 18px;
  }

  .blog-article__body h3 {
    font-size: clamp(22px, 2.4vw, 30px);
    line-height: 1.2;
    margin: 38px 0 14px;
  }

  .blog-article__body p,
  .blog-article__body ul,
  .blog-article__body ol {
    line-height: 1.6;
  }

  .blog-article__sidebar {
    min-width: 0;
  }

  .blog-article__newsletter,
  .blog-article__recommended {
    margin-bottom: 32px;
  }

  .blog-article__newsletter {
    background: #fff;
    border: 1px solid var(--blog-article-border);
    border-radius: 16px;
    padding: 24px;
  }

  .blog-article__newsletter-title,
  .blog-article__recommended-title {
    font-size: 22px;
    line-height: 1.2;
    margin: 0 0 14px;
  }

  .blog-article__newsletter-copy {
    color: var(--blog-article-muted);
    line-height: 1.45;
    margin: 0 0 18px;
  }

  .blog-article__newsletter-copy p,
  .blog-article__consent-copy p {
    margin: 0;
  }

  .blog-article__newsletter .input-full {
    margin-bottom: 12px;
  }

  .blog-article__newsletter-submit {
    background: var(--blog-article-blue);
    border: 1px solid var(--blog-article-blue);
    border-radius: 999px;
    color: #fff;
    display: block;
    min-height: 48px;
    width: 100%;
  }

  .blog-article__newsletter-submit:hover,
  .blog-article__newsletter-submit:focus-visible {
    background: #007dcc;
    border-color: #007dcc;
    color: #fff;
  }

  .blog-article__consent {
    align-items: flex-start;
    color: var(--blog-article-muted);
    display: flex;
    font-size: 13px;
    gap: 8px;
    line-height: 1.35;
    margin: 14px 0 18px;
  }

  .blog-article__consent input {
    flex: 0 0 auto;
    margin: 2px 0 0;
  }

  .blog-article__consent-copy {
    flex: 1 1 auto;
  }

  .blog-article__consent-copy a {
    color: inherit;
    text-decoration: underline;
  }

  .blog-article__form-message {
    line-height: 1.45;
    margin: 0;
  }

  .blog-article__sidebar-sticky {
    position: sticky;
    top: calc(var(--site-header-group-height, var(--header-height, 0px)) + var(--blog-center-sticky-height, 0px) + 24px);
  }

  .blog-article__recommended-title {
    margin-bottom: 18px;
  }

  .blog-article__recommended-list {
    display: grid;
    gap: 20px;
  }

  .blog-article__related {
    border-top: 1px solid var(--blog-article-border);
    margin: 0 0 48px;
    padding-top: 32px;
  }

  .blog-article__related-title {
    font-size: 28px;
    margin: 0 0 20px;
  }

  .blog-article__related-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .blog-article__related-card {
    border: 1px solid var(--blog-article-border);
    border-radius: 12px;
    overflow: hidden;
  }

  .blog-article__related-image {
    background: #f1f4f6;
    display: block;
    height: 150px;
    overflow: hidden;
  }

  .blog-article__related-image img {
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .blog-article__related-copy {
    padding: 14px;
  }

  .blog-article__related-meta {
    color: var(--blog-article-blue);
    display: block;
    font-size: 12px;
    margin-bottom: 7px;
  }

  .blog-article__related-link {
    color: var(--colorBodyText, #1c1d1d);
    display: block;
    font-size: 16px;
    line-height: 1.35;
  }

  .blog-article__related-link:hover {
    color: var(--blog-article-blue);
  }

  .blog-article__pagination {
    border-bottom: 1px solid var(--blog-article-border);
    border-top: 1px solid var(--blog-article-border);
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0 0 64px;
    padding: 24px 0;
  }

  .blog-article__pagination-link {
    color: var(--colorBodyText, #1c1d1d);
    display: block;
  }

  .blog-article__pagination-link--next {
    text-align: right;
  }

  .blog-article__pagination-label {
    color: var(--blog-article-muted);
    display: block;
    font-size: 13px;
    margin-bottom: 5px;
  }

  .blog-article__pagination-title {
    display: block;
    font-size: 17px;
    line-height: 1.35;
  }

  .blog-article__pagination-link:hover .blog-article__pagination-title {
    color: var(--blog-article-blue);
  }

  @media only screen and (max-width: 768px) {
    .blog-article__hero {
      padding: 22px 0 44px;
    }

    .blog-article__hero .breadcrumb {
      margin-bottom: 36px;
    }

    .blog-article__title {
      font-size: clamp(34px, 10vw, 48px);
    }

    .blog-article__category-bar {
      margin-bottom: 40px;
    }

    .blog-article__category-inner {
      gap: 18px;
      min-height: 58px;
    }

    .blog-article__category-heading {
      font-size: 20px;
    }

    .blog-article__category-nav {
      gap: 24px;
      justify-content: flex-start;
      padding: 14px 0;
    }

    .blog-article__layout {
      display: block;
    }

    .blog-article__sidebar {
      margin-top: 48px;
    }

    .blog-article__sidebar-sticky {
      position: static;
    }

    .blog-article__related-grid {
      grid-template-columns: 1fr;
    }

    .blog-article__related-image {
      height: 180px;
    }

    .blog-article__pagination {
      grid-template-columns: 1fr;
    }

    .blog-article__pagination-link--next {
      text-align: left;
    }
  }
{% endstyle %}

<div
  class="blog-article"
  data-section-id="{{ section.id }}"
  data-section-type="article"
  data-blog-article
>
  <header class="blog-article__hero">
    <div class="page-width">
      {%- render 'breadcrumbs' -%}

      <div class="blog-article__heading">
        <h1 class="blog-article__title">{{ article.title | escape }}</h1>

        <div class="blog-article__meta-row">
          <div class="blog-article__meta">
            {%- if section.settings.blog_show_date and article.published_at != blank -%}
              {{ article.published_at | time_tag: format: 'month_day_year' }}
            {%- endif -%}
            {%- if section.settings.blog_show_date and article.published_at != blank -%}
              <span class="blog-article__meta-separator" aria-hidden="true">|</span>
            {%- endif -%}
            <span>Venus E</span>
          </div>

          {%- if section.settings.social_sharing_blog -%}
            <div class="blog-article__social">
              {%- render 'social-sharing', share_title: article.title, share_permalink: article.url, share_image: article.image, show_labels: false -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </header>

  {%- if blog_center_menu != blank and blog_center_menu.links.size > 0 -%}
    <div class="blog-article__category-bar" data-blog-center>
      <div class="page-width">
        <div class="blog-article__category-inner">
          {%- if blog_center_url != blank -%}
            <a class="blog-article__category-heading" href="{{ blog_center_url }}">
              {{ 'blogs.article.blog_center' | t }}
            </a>
          {%- else -%}
            <span class="blog-article__category-heading">
              {{ 'blogs.article.blog_center' | t }}
            </span>
          {%- endif -%}

          <nav class="blog-article__category-nav" aria-label="{{ 'blogs.article.blog_center' | t }}">
          {%- if blog_center_url != blank -%}
            <a class="blog-article__category-link" href="{{ blog_center_url }}">
              {{ 'blogs.article.all' | t }}
            </a>
          {%- endif -%}

          {%- for link in blog_center_menu.links offset: 1 -%}
            {%- assign link_blog_handle = blank -%}
            {%- assign linked_blog = blank -%}
            {%- if link.object != blank and link.object.handle != blank -%}
              {%- assign link_blog_handle = link.object.handle -%}
              {%- assign linked_blog = link.object -%}
            {%- endif -%}
            {%- if link_blog_handle == blank and link.url != blank -%}
              {%- assign link_url = link.url | split: '?' | first | split: '#' | first -%}
              {%- assign link_url_parts = link_url | split: '/blogs/' -%}
              {%- if link_url_parts.size > 1 -%}
                {%- assign link_blog_handle = link_url_parts[1] | split: '/' | first -%}
                {%- assign linked_blog = blogs[link_blog_handle] -%}
              {%- endif -%}
            {%- endif -%}
            {%- assign is_current_blog = false -%}
            {%- if link_blog_handle == article_blog.handle or link.url == article_blog.url -%}
              {%- assign is_current_blog = true -%}
            {%- endif -%}

            {%- if linked_blog != blank and linked_blog.articles_count > 0 -%}
              <a
                class="blog-article__category-link"
                href="{{ link.url }}"
                {% if is_current_blog %}aria-current="page"{% endif %}
              >
                {{ link.title | escape }}
              </a>
            {%- endif -%}
          {%- endfor -%}
          </nav>
        </div>
      </div>
    </div>
  {%- endif -%}

  <div class="page-width">
    <div class="blog-article__layout">
      <div class="blog-article__main">
        {%- if article.content != blank -%}
          <div class="article__body rte blog-article__body" data-blog-article-body>
            <nav class="blog-article__toc" data-blog-article-toc hidden aria-label="{{ 'blogs.article.table_of_contents' | t }}">
              <div class="blog-article__toc-title">{{ 'blogs.article.table_of_contents' | t }}</div>
              <ol class="blog-article__toc-list" data-blog-article-toc-list></ol>
            </nav>
            {{ article.content }}
          </div>
        {%- endif -%}

        {%- if article_blog.articles_count > 1 -%}
          {%- assign related_count = 0 -%}
          <section class="blog-article__related" aria-labelledby="BlogArticleRelated-{{ section.id }}">
            <h2 class="blog-article__related-title" id="BlogArticleRelated-{{ section.id }}">
              {{ 'blogs.article.more_articles' | t }}
            </h2>
            <div class="blog-article__related-grid">
              {%- for related_article in article_blog.articles -%}
                {%- if related_article.id != article.id and related_count < 3 -%}
                  {%- assign related_count = related_count | plus: 1 -%}
                  <article class="blog-article__related-card">
                    {%- if related_article.image != blank -%}
                      <a class="blog-article__related-image" href="{{ related_article.url }}" aria-label="{{ related_article.title | escape }}">
                        {%- render 'image-element',
                          img: related_article.image,
                          sizes: '(min-width: 769px) 25vw, 90vw',
                          widths: '360, 540, 720',
                        -%}
                      </a>
                    {%- endif -%}
                    <div class="blog-article__related-copy">
                      <span class="blog-article__related-meta">
                        {{ article_blog.title | escape }}
                        {%- if related_article.published_at != blank -%}
                          · {{ related_article.published_at | time_tag: format: 'month_day_year' }}
                        {%- endif -%}
                      </span>
                      <a class="blog-article__related-link" href="{{ related_article.url }}">
                        {{ related_article.title | escape }}
                      </a>
                    </div>
                  </article>
                {%- endif -%}
                {%- if related_count == 3 -%}{%- break -%}{%- endif -%}
              {%- endfor -%}
            </div>
          </section>
        {%- endif -%}

        {%- if article_blog.previous_article != blank or article_blog.next_article != blank -%}
          <nav class="blog-article__pagination" aria-label="{{ 'blogs.article.article_navigation' | t }}">
            {%- if article_blog.previous_article != blank -%}
              <a class="blog-article__pagination-link" href="{{ article_blog.previous_article.url }}" rel="prev">
                <span class="blog-article__pagination-label">{{ 'blogs.article.previous_article' | t }}</span>
                <span class="blog-article__pagination-title">{{ article_blog.previous_article.title | escape }}</span>
              </a>
            {%- endif -%}
            {%- if article_blog.next_article != blank -%}
              <a class="blog-article__pagination-link blog-article__pagination-link--next" href="{{ article_blog.next_article.url }}" rel="next">
                <span class="blog-article__pagination-label">{{ 'blogs.article.next_article' | t }}</span>
                <span class="blog-article__pagination-title">{{ article_blog.next_article.title | escape }}</span>
              </a>
            {%- endif -%}
          </nav>
        {%- endif -%}

        {%- if section.settings.blog_show_comments and article_blog.comments_enabled? -%}
          {%- if number_of_comments > 0 -%}
            <hr class="hr--large">
            <h3>{{ 'blogs.comments.with_count' | t: count: number_of_comments }}</h3>
            <hr class="hr--small hr--clear">
          {%- endif -%}

          {%- paginate article.comments by 5 -%}
            <div id="comments">
              {%- if comment and comment.errors == blank -%}
                <hr class="hr--small hr--clear">
                <p class="note note--success">
                  {%- if article_blog.moderated? -%}
                    {{ 'blogs.comments.success_moderated' | t }}
                  {%- else -%}
                    {{ 'blogs.comments.success' | t }}
                  {%- endif -%}
                </p>
              {%- endif -%}

              {%- if number_of_comments > 0 -%}
                <ul class="no-bullets">
                  {%- if comment.status == 'pending' -%}
                    <li id="Comment-{{ comment.id }}" class="article__comment">
                      {%- render 'comment', comment: comment -%}
                    </li>
                  {%- endif -%}

                  {%- for comment in article.comments -%}
                    <li id="Comment-{{ comment.id }}" class="article__comment">
                      {%- render 'comment', comment: comment -%}
                    </li>
                    {%- unless forloop.last -%}
                      <li><hr class="hr--clear"></li>
                    {%- endunless -%}
                  {%- endfor -%}
                </ul>

                {%- if paginate.pages > 1 -%}
                  {%- render 'pagination', paginate: paginate, hash: '#comments' -%}
                {%- endif -%}
              {%- endif -%}

              <hr class="hr--large">

              <header class="section-header">
                <h3 class="section-header__title">{{ 'blogs.comments.title' | t }}</h3>
              </header>

              <div class="form-vertical">
                {%- form 'new_comment', article -%}
                  {{ form.errors | default_errors }}

                  <div class="grid grid--small">
                    <div class="grid__item medium-up--one-half">
                      <label for="CommentAuthor">{{ 'blogs.comments.name' | t }}</label>
                      <input required class="input-full{% if form.errors contains 'author' %} error{% endif %}" type="text" name="comment[author]" id="CommentAuthor" value="{{ form.author }}" autocapitalize="words">
                    </div>
                    <div class="grid__item medium-up--one-half">
                      <label for="CommentEmail">{{ 'blogs.comments.email' | t }}</label>
                      <input required class="input-full{% if form.errors contains 'email' %} error{% endif %}" type="email" name="comment[email]" id="CommentEmail" value="{{ form.email }}" autocorrect="off" autocapitalize="off">
                    </div>
                  </div>

                  <label for="CommentBody">{{ 'blogs.comments.message' | t }}</label>
                  <textarea required class="input-full{% if form.errors contains 'body' %} error{% endif %}" name="comment[body]" id="CommentBody">{{ form.body }}</textarea>

                  {%- if article_blog.moderated? -%}
                    <p><small>{{ 'blogs.comments.moderated' | t }}</small></p>
                  {%- endif -%}

                  <button type="submit" class="btn btn--secondary">
                    {{ 'blogs.comments.post' | t }}
                  </button>

                  {{ 'shopify.online_store.spam_detection.disclaimer_html' | t }}
                {%- endform -%}
              </div>
            </div>
          {%- endpaginate -%}
        {%- endif -%}
      </div>

      <aside class="blog-article__sidebar">
        <div class="blog-article__sidebar-sticky">
          <section class="blog-article__newsletter" aria-labelledby="BlogArticleNewsletter-{{ section.id }}">
            <h2 class="blog-article__newsletter-title" id="BlogArticleNewsletter-{{ section.id }}">
              {{ newsletter_title | escape }}
            </h2>
            <div class="blog-article__newsletter-copy">{{ newsletter_text }}</div>

            {%- form 'customer', id: newsletter_form_id -%}
              {%- if form.posted_successfully? -%}
                <p class="blog-article__form-message note note--success">
                  {{ newsletter_success | escape }}
                </p>
              {%- else -%}
                {{ form.errors | default_errors }}
                <input type="hidden" name="contact[tags]" value="prospect,newsletter">
                <label class="visually-hidden" for="BlogArticleEmail-{{ section.id }}">
                  {{ 'general.newsletter_form.newsletter_email' | t }}
                </label>
                <input
                  class="input-full"
                  type="email"
                  name="contact[email]"
                  id="BlogArticleEmail-{{ section.id }}"
                  value="{% if customer %}{{ customer.email }}{% endif %}"
                  placeholder="{{ newsletter_email_placeholder | escape }}"
                  autocorrect="off"
                  autocapitalize="off"
                  required
                >
                <div class="blog-article__consent">
                  <input id="BlogArticleConsent-{{ section.id }}" type="checkbox" name="contact[accepts_marketing]" value="true" aria-labelledby="BlogArticleConsentText-{{ section.id }}" required>
                  <div class="blog-article__consent-copy" id="BlogArticleConsentText-{{ section.id }}">{{ newsletter_consent }}</div>
                </div>
                <button class="blog-article__newsletter-submit" type="submit">
                  {{ newsletter_submit | escape }}
                </button>
              {%- endif -%}
            {%- endform -%}
          </section>

          {%- if recommended_product_count > 0 -%}
            <section class="blog-article__recommended" aria-labelledby="BlogArticleRecommended-{{ section.id }}">
              <h2 class="blog-article__recommended-title" id="BlogArticleRecommended-{{ section.id }}">
                {{ recommended_products_title | escape }}
              </h2>
              <div class="blog-article__recommended-list">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'product' and block.settings.product != blank -%}
                    {%- render 'blog-article-product-card',
                      product: block.settings.product,
                      variant: 'compact',
                      custom_image: block.settings.image,
                      title_override: block.settings.title,
                      subtitle_override: block.settings.description,
                      specs_override: block.settings.specs,
                      badge_override: block.settings.badge,
                      badge_color_override: block.settings.badge_color,
                      cta_label_override: block.settings.button_label,
                      link_override: block.settings.link,
                      block_attributes: block.shopify_attributes
                    -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </section>
          {%- endif -%}
        </div>
      </aside>
    </div>
  </div>
</div>

<script src="{{ 'blog-article.js' | asset_url }}" defer="defer"></script>

<script type="application/ld+json">
{
  "@context": "http://schema.org",
  "@type": "Article",
  "articleBody": {{ article.content | strip_html | json }},
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": {{ shop.url | append: article.url | json }}
  },
  "headline": {{ article.title | json }},
  {% if article.excerpt != blank %}
    "description": {{ article.excerpt | strip_html | json }},
  {% endif %}
  {% if article.image %}
    "image": [
      {{ article.image | image_url: width: article.image.width | json }}
    ],
  {% endif %}
  "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
  "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
  "dateCreated": {{ article.created_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
  "author": {
    "@type": "Person",
    "name": "Venus E"
  },
  "publisher": {
    "@type": "Organization",
    {% if page_image %}
      "logo": {
        "@type": "ImageObject",
        "height": {{ page_image.height | json }},
        "url": {{ page_image | image_url: width: page_image.width | json }},
        "width": {{ page_image.width | json }}
      },
    {% endif %}
    "name": {{ shop.name | json }}
  }
}
</script>

{% schema %}
{
  "name": "t:sections.article-template.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "blog_show_date",
      "label": "t:sections.article-template.settings.blog_show_date.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "blog_show_comments",
      "label": "t:sections.article-template.settings.blog_show_comments.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "social_sharing_blog",
      "label": "t:sections.article-template.settings.social_sharing_blog.label",
      "default": true
    },
    {
      "type": "header",
      "content": "Sidebar content"
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Newsletter title",
      "info": "Leave blank to use the translated default."
    },
    {
      "type": "richtext",
      "id": "newsletter_text",
      "label": "Newsletter description",
      "info": "Leave blank to use the translated default."
    },
    {
      "type": "text",
      "id": "newsletter_email_placeholder",
      "label": "Email input placeholder",
      "info": "Leave blank to use the translated default."
    },
    {
      "type": "richtext",
      "id": "newsletter_consent",
      "label": "Privacy consent text",
      "info": "Leave blank to use the translated default. Add the privacy policy link when using custom text."
    },
    {
      "type": "text",
      "id": "newsletter_submit",
      "label": "Newsletter button text",
      "info": "Leave blank to use the translated default."
    },
    {
      "type": "text",
      "id": "newsletter_success",
      "label": "Newsletter success message",
      "info": "Leave blank to use the translated default."
    },
    {
      "type": "text",
      "id": "recommended_products_title",
      "label": "Recommended products title",
      "info": "Leave blank to use the translated default."
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Recommended product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card title",
          "info": "Leave blank to use the product metafield or product title."
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Card description",
          "info": "Leave blank to use the product metafield."
        },
        {
          "type": "text",
          "id": "specs",
          "label": "Card specifications",
          "info": "Leave blank to use the product metafield."
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge text"
        },
        {
          "type": "select",
          "id": "badge_color",
          "label": "Badge color",
          "default": "blue",
          "options": [
            {
              "value": "blue",
              "label": "Blue"
            },
            {
              "value": "orange",
              "label": "Orange"
            }
          ]
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button text",
          "info": "Leave blank to use the translated default."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Card link"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "disabled_on": {
    "groups": ["footer", "header", "custom.popups"]
  }
}
{% endschema %}
