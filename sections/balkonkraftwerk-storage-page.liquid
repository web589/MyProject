{% liquid
  assign venus_mini = section.settings.product_mini
  assign venus_3 = section.settings.product_3
  assign venus_4 = section.settings.product_4
  assign venus_max = section.settings.product_max
  assign ct002 = section.settings.product_ct002
  assign ct003 = section.settings.product_ct003
  if venus_mini == blank
    assign venus_mini = all_products['venus-e-mini']
  endif
  if venus_3 == blank
    assign venus_3 = all_products['venus-e-3']
  endif
  if venus_4 == blank
    assign venus_4 = all_products['venus-e-4']
  endif
  if venus_max == blank
    assign venus_max = all_products['venus-e-max']
  endif
  if ct002 == blank
    assign ct002 = all_products['ct002-smart-meter']
  endif
  if ct003 == blank
    assign ct003 = all_products['ct003-smart-meter']
  endif
  assign ct002_variant = ct002.selected_or_first_available_variant
  assign ct003_variant = ct003.selected_or_first_available_variant
  assign ct002_image = ct002_variant.featured_image | default: ct002.featured_image
  assign ct003_image = ct003_variant.featured_image | default: ct003.featured_image
  assign ct002_subtitle = ct002.title | remove_first: 'MARSTEK CT002 – ' | remove_first: 'MARSTEK CT002 - '
  assign ct003_subtitle = ct003.title | remove_first: 'MARSTEK CT003 – ' | remove_first: 'MARSTEK CT003 - '
  if ct002_subtitle == blank
    assign ct002_subtitle = '3-Phasen Smart Meter für VENUS E'
  endif
  if ct003_subtitle == blank
    assign ct003_subtitle = 'P1 Smart Meter für VENUS E'
  endif
%}

{{ 'balkonkraftwerk-storage-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'balkonkraftwerk-storage-page.js' | asset_url }}" defer="defer"></script>

<div class="bw-storage" data-bw-storage data-section-id="{{ section.id }}"
  data-people-tier-5="{{ section.settings.people_tier_5_max }}"
  data-people-tier-10="{{ section.settings.people_tier_10_max }}"
  data-people-tier-15="{{ section.settings.people_tier_15_max }}"
  data-pv-tier-5="{{ section.settings.pv_tier_5_max }}"
  data-pv-tier-10="{{ section.settings.pv_tier_10_max }}"
  data-pv-tier-15="{{ section.settings.pv_tier_15_max }}"
  data-annual-tier-5="{{ section.settings.annual_tier_5_max }}"
  data-annual-tier-10="{{ section.settings.annual_tier_10_max }}"
  data-annual-tier-15="{{ section.settings.annual_tier_15_max }}">
  <nav class="bw-anchor-nav" data-bw-anchor-nav aria-label="Seitennavigation">
    <div class="bw-container bw-anchor-nav__inner">
      <a href="#balkonkraftwerk-kaufen" data-bw-anchor-link>Balkonkraftwerk kaufen</a>
      <a href="#warum-speicher" data-bw-anchor-link>Warum</a>
      <a href="#vergleich" data-bw-anchor-link>Vergleich</a>
      <a href="#funktionsweise" data-bw-anchor-link>Funktionsweise</a>
      <a href="#nachruesten" data-bw-anchor-link>Nachrüsten</a>
      <a href="#kapazitaet" data-bw-anchor-link>Kapazität</a>
      <a href="#modelle" data-bw-anchor-link>Modelle</a>
      <a href="#faq" data-bw-anchor-link>FAQ</a>
      <a class="bw-anchor-nav__cta" href="#kapazitaet" data-bw-anchor-link>Jetzt kaufen</a>
    </div>
  </nav>

  <section id="balkonkraftwerk-kaufen" class="bw-hero bw-anchor-target">
    <div class="bw-container bw-hero__grid">
      <div class="bw-hero__copy">
        <p class="bw-eyebrow">VENUS E · BALKONKRAFTWERK MIT SPEICHER</p>
        <h1>{{ section.settings.hero_heading }}</h1>
        <p class="bw-lead">{{ section.settings.hero_text }}</p>
        <div class="bw-actions">
          <a class="bw-button bw-button--primary" href="#kapazitaet" data-bw-anchor-link>{{ section.settings.hero_primary_label }}</a>
          <a class="bw-button bw-button--secondary" href="#kapazitaet" data-bw-anchor-link>{{ section.settings.hero_secondary_label }}</a>
        </div>
        <div class="bw-hero__stats" aria-label="Produktvorteile">
          <div><strong>4</strong><span>Modelle</span></div>
          <div><strong>85 %</strong><span>Eigenverbrauch</span></div>
          <div><strong>10</strong><span>Jahre Garantie</span></div>
        </div>
      </div>
      <div class="bw-media bw-media--hero">
        {% if section.settings.hero_image != blank %}
          {{ section.settings.hero_image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '600,900,1200,1400', sizes: '(min-width: 900px) 50vw, 100vw', alt: 'VENUS E Speicher im Wohnbereich' }}
        {% else %}
          <div class="bw-media__placeholder"><span>VENUS E</span><small>Hero-Motiv hier einsetzen</small></div>
        {% endif %}
      </div>
    </div>
  </section>

  <section class="bw-trust" aria-label="Qualität und Sicherheit">
    <div class="bw-container bw-trust__grid">
      <span>TÜV &amp; CE</span><span>IP65</span><span>10 Jahre Leistungsgarantie</span><span>100.000+ Haushalte</span><span>LiFePO4-Technologie</span>
    </div>
  </section>

  <section id="warum-speicher" class="bw-section bw-anchor-target">
    <div class="bw-container">
      <div class="bw-section__intro">
        <p class="bw-eyebrow">MEHR AUS DEINER SONNE MACHEN</p>
        <h2>Drei Gründe, warum sich der Speicher rechnet</h2>
        <p>Ein Balkonkraftwerk erzeugt tagsüber Strom. VENUS E sorgt dafür, dass du ihn auch dann nutzt, wenn die Sonne längst untergegangen ist.</p>
      </div>
      <div class="bw-bento">
        <article class="bw-bento__feature">
          <div class="bw-media bw-media--wide">
            {% if section.settings.bento_image != blank %}
              {{ section.settings.bento_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600,900,1200,1400', sizes: '(min-width: 900px) 66vw, 100vw', alt: 'Balkonkraftwerk mit VENUS E Speicher' }}
            {% else %}
              <div class="bw-media__placeholder"><span>01</span><small>Bild oder GIF einsetzen</small></div>
            {% endif %}
          </div>
          <div class="bw-bento__body"><span class="bw-number">01</span><h3>Dein Strom arbeitet für dich</h3><p>Speichere den Überschuss vom Tag und nutze ihn am Abend für Kühlschrank, Router und Licht.</p></div>
        </article>
        <article class="bw-bento__card"><span class="bw-number">02</span><h3>Weniger Netzstrom</h3><p>Mehr selbst erzeugte Energie bleibt in deinem Haushalt. Das macht deine Stromkosten planbarer.</p></article>
        <article class="bw-bento__card bw-bento__card--blue"><span class="bw-number">03</span><h3>Passt mit dir mit</h3><p>Von 5,12 kWh bis zur erweiterbaren Lösung: Starte passend zu deinem Bedarf und wachse später weiter.</p></article>
      </div>
    </div>
  </section>

  <section id="vergleich" class="bw-section bw-section--muted bw-anchor-target">
    <div class="bw-container">
      <div class="bw-section__intro bw-section__intro--center"><p class="bw-eyebrow">DER UNTERSCHIED IM ALLTAG</p><h2>Was der Speicher verändert</h2><p>Ein Blick auf denselben Sonnentag – mit und ohne Batteriespeicher.</p></div>
      <div class="bw-compare">
        <article class="bw-compare__card bw-compare__card--positive">
          <div class="bw-compare__tag">MIT VENUS E</div><h3>Dein Sonnenstrom wird voll genutzt.</h3>
          <ul><li>Überschuss wird automatisch geladen</li><li>Abends und nachts aus dem Speicher versorgen</li><li>Weniger Strom aus dem öffentlichen Netz</li></ul>
        </article>
        <article class="bw-compare__card"><div class="bw-compare__tag">OHNE SPEICHER</div><h3>Überschuss wird ungenutzt eingespeist.</h3><ul><li>Mittags entsteht häufig mehr Strom als benötigt</li><li>Abends kommt der Strom wieder aus dem Netz</li><li>Der Eigenverbrauch bleibt begrenzt</li></ul></article>
      </div>
    </div>
  </section>

  <section id="funktionsweise" class="bw-section bw-anchor-target">
    <div class="bw-container">
      <div class="bw-section__intro"><p class="bw-eyebrow">INTELLIGENTE ENERGIEFLÜSSE</p><h2>Tagsüber speichern, abends nutzen</h2><p>VENUS E verteilt deinen Strom automatisch dorthin, wo er gerade gebraucht wird.</p></div>
      <div class="bw-toggle" role="tablist" aria-label="Tageszeit auswählen"><button type="button" class="is-active" data-bw-flow-tab="day" role="tab" aria-selected="true">Tagsüber</button><button type="button" data-bw-flow-tab="evening" role="tab" aria-selected="false">Abends</button></div>
      <div class="bw-flow" data-bw-flow-panel="day"><div class="bw-flow__node"><span class="bw-flow__icon">☀</span><strong>PV-Anlage</strong><small>Erzeugt Solarstrom</small></div><span class="bw-flow__line" aria-hidden="true">→</span><div class="bw-flow__node bw-flow__node--accent"><span class="bw-flow__icon">▣</span><strong>VENUS E</strong><small>Lädt Überschuss</small></div><span class="bw-flow__line" aria-hidden="true">→</span><div class="bw-flow__node"><span class="bw-flow__icon">⌂</span><strong>Haushalt</strong><small>Nutzt Strom direkt</small></div></div>
      <div class="bw-flow" data-bw-flow-panel="evening" hidden><div class="bw-flow__node"><span class="bw-flow__icon">▣</span><strong>VENUS E</strong><small>Gibt gespeicherten Strom ab</small></div><span class="bw-flow__line" aria-hidden="true">→</span><div class="bw-flow__node bw-flow__node--accent"><span class="bw-flow__icon">⌂</span><strong>Haushalt</strong><small>Versorgt deine Geräte</small></div><span class="bw-flow__line" aria-hidden="true">→</span><div class="bw-flow__node"><span class="bw-flow__icon">◌</span><strong>Netz</strong><small>Nur wenn nötig</small></div></div>
    </div>
  </section>

  <section id="nachruesten" class="bw-section bw-section--blue bw-anchor-target">
    <div class="bw-container bw-split">
      <div class="bw-media bw-media--split">
        {% if section.settings.retrofit_image != blank %}
          {{ section.settings.retrofit_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500,800,1200', sizes: '(min-width: 900px) 50vw, 100vw', alt: 'VENUS E Speicher zum Nachrüsten' }}
        {% else %}
          <div class="bw-media__placeholder"><span>RETROFIT</span><small>Bild oder GIF einsetzen</small></div>
        {% endif %}
      </div>
      <div class="bw-split__copy"><p class="bw-eyebrow">NACHRÜSTEN LEICHT GEMACHT</p><h2>Du hast schon ein Balkonkraftwerk? Perfekt.</h2><p>VENUS E lässt sich in bestehende Systeme integrieren. So speicherst du deinen Solarstrom, ohne deine komplette Anlage neu zu planen.</p><ul><li>Kompatibel mit gängigen Mikro-Wechselrichtern</li><li>Schritt für Schritt per App einrichten</li><li>Später um zusätzliche Kapazität erweiterbar</li></ul><a class="bw-button bw-button--light" href="#kapazitaet" data-bw-anchor-link>Passende Größe finden</a></div>
    </div>
  </section>

  <section id="kapazitaet" class="bw-section bw-anchor-target">
    <div class="bw-container">
      <div class="bw-section__intro bw-section__intro--center"><p class="bw-eyebrow">DEINE EMPFEHLUNG</p><h2>Welche Kapazität passt zu deinem Haushalt?</h2><p>Beantworte drei kurze Fragen. Die Empfehlung wird sofort aktualisiert und bleibt in deiner Sitzung gespeichert.</p></div>
      <div class="bw-capacity-presets" aria-label="Kapazitätsstufen"><button type="button" data-bw-preset="5.12"><strong>5,12 kWh</strong><span>Für 1–2 Personen</span></button><button type="button" data-bw-preset="10.24"><strong>10,24 kWh</strong><span>Für 2–3 Personen</span></button><button type="button" data-bw-preset="15.36"><strong>15,36 kWh</strong><span>Für 3–4 Personen</span></button><button type="button" data-bw-preset="30"><strong>Erweiterbar</strong><span>Bis 30 kWh</span></button></div>
      <div class="bw-calculator" data-bw-calculator>
        <div class="bw-calculator__controls">
          <div class="bw-slider-row"><label for="bw-people-{{ section.id }}">Haushaltsgröße <output data-bw-output="people">3 Personen</output></label><input id="bw-people-{{ section.id }}" data-bw-input="people" type="range" min="1" max="6" step="1" value="3"><div class="bw-slider-scale"><span>1</span><span>6+</span></div></div>
          <div class="bw-slider-row"><label for="bw-pv-{{ section.id }}">PV-Leistung <output data-bw-output="pv">6 kWp</output></label><input id="bw-pv-{{ section.id }}" data-bw-input="pv" type="range" min="0" max="12" step="0.5" value="6"><div class="bw-slider-scale"><span>0 kWp</span><span>12 kWp</span></div></div>
          <div class="bw-slider-row"><label for="bw-annual-{{ section.id }}">Jährlicher Verbrauch <output data-bw-output="annual">4.000 kWh/Jahr</output></label><input id="bw-annual-{{ section.id }}" data-bw-input="annual" type="range" min="1500" max="8000" step="100" value="4000"><div class="bw-slider-scale"><span>1.500</span><span>8.000 kWh</span></div></div>
        </div>
        <div class="bw-calculator__result"><p class="bw-eyebrow">EMPFOHLENE KAPAZITÄT</p><strong data-bw-capacity>15,36 kWh</strong><div class="bw-result-badges"><span data-bw-summary>3 Personen · 6 kWp · 4.000 kWh/Jahr</span></div><button type="button" class="bw-button bw-button--light" data-bw-scroll-results>Passende Konfigurationen ansehen</button><small>Die Empfehlung ist eine Orientierung. Für eine genaue Planung berücksichtige bitte deine individuellen Verbrauchsdaten.</small></div>
      </div>
      <div class="bw-results" data-bw-results>
        <div class="bw-results__heading"><div><p class="bw-eyebrow">DEINE AUSWAHL</p><h3>Diese Konfigurationen passen zu <span data-bw-capacity-inline>15,36 kWh</span></h3></div><span class="bw-results__live">Wird in Echtzeit aktualisiert</span></div>
        <div class="bw-results__grid">
          <article class="bw-result-card bw-result-card--primary" data-bw-result-card="primary"><span class="bw-card-badge">UNSERE EMPFEHLUNG</span><h4 data-bw-primary-title>3× VENUS E 3.0</h4><strong data-bw-primary-capacity>15,36 kWh</strong><p>Die passende Kombination für deinen Bedarf – mit direkter Bestellmöglichkeit.</p><button type="button" class="bw-button bw-button--primary bw-result-action" data-bw-product-role="primary">In den Warenkorb</button></article>
          <article class="bw-result-card" data-bw-result-card="alternative-4"><h4 data-bw-alt4-title>3× VENUS E 4.0</h4><strong data-bw-alt4-capacity>15 kWh</strong><p>Mehr Leistung pro Einheit und eine kompakte Alternative.</p><a class="bw-button bw-button--secondary bw-result-action" data-bw-product-role="alt4" href="{{ venus_4.url | default: '/products/venus-e-4' }}">Zur Produktseite</a></article>
          <article class="bw-result-card" data-bw-result-card="alternative-max"><h4 data-bw-altmax-title>2× VENUS E Max</h4><strong data-bw-altmax-capacity>20 kWh</strong><p>Für größere Haushalte oder wenn du später erweitern möchtest.</p><a class="bw-button bw-button--secondary bw-result-action" data-bw-product-role="altmax" href="{{ venus_max.url | default: '/products/venus-e-max' }}">Zur Produktseite</a></article>
        </div>
      </div>
    </div>
  </section>

  <section class="bw-section bw-zero-feed" aria-labelledby="zero-feed-heading">
    <div class="bw-container bw-zero-feed__container">
      <div class="bw-section__intro bw-zero-feed__intro">
        <h2 id="zero-feed-heading">Keine Einspeisung ins Netz. Automatisch.</h2>
        <p>Der Smart Meter erkennt deinen Verbrauch, VENUS E reagiert von selbst. Die CT-Sensoren (CT002 / CT003) erfassen jeden Lastfluss in Echtzeit. Innerhalb von unter 10 Millisekunden entscheidet VENUS E, ob Strom gespeichert, verbraucht oder – falls gewünscht – gar nicht ins Netz abgegeben wird. Keine komplizierte Konfiguration, kein Elektriker erforderlich.</p>
      </div>

      <div class="bw-system-flow" role="list" aria-label="Automatischer Energiefluss">
        <article class="bw-system-flow__card" role="listitem">
          <span class="bw-system-flow__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4.5"></circle><path d="M12 12.5v6M8.5 21h7"></path></svg>
          </span>
          <strong>Smart Meter</strong>
          <small>Misst Verbrauch &amp;<br>Erzeugung in Echtzeit</small>
        </article>
        <article class="bw-system-flow__card is-active" role="listitem" aria-current="true">
          <span class="bw-system-flow__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="15" height="10" rx="1.5"></rect><path d="M18 10h3v4h-3"></path></svg>
          </span>
          <strong>VENUS E</strong>
          <small>≤ 10 ms Steuerung<br>Kein Watt ins Netz</small>
        </article>
        <article class="bw-system-flow__card" role="listitem">
          <span class="bw-system-flow__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m3 11 9-8 9 8"></path><path d="M5.5 10v10h13V10M9 20v-6h6v6"></path></svg>
          </span>
          <strong>Hausnetz</strong>
          <small>Verbraucht was<br>gebraucht wird</small>
        </article>
      </div>

      <div class="bw-accessory-grid" aria-label="Passende Smart Meter">
        <article class="bw-accessory-card">
          <a class="bw-accessory-card__image" href="{{ ct002.url | default: '/products/ct002-smart-meter' }}" aria-label="CT002 Produktseite">
            {% if ct002_image != blank %}
              {{ ct002_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120,180,240', sizes: '96px', alt: ct002.title | default: 'CT002' }}
            {% else %}
              <span class="bw-accessory-card__image-placeholder" aria-hidden="true"></span>
            {% endif %}
          </a>
          <div class="bw-accessory-card__details">
            <h3><a href="{{ ct002.url | default: '/products/ct002-smart-meter' }}">CT002</a></h3>
            <p>{{ ct002_subtitle }}</p>
            <span class="bw-accessory-card__badge">Plug &amp; Play</span>
          </div>
          <div class="bw-accessory-card__purchase">
            <div class="bw-accessory-card__price">
              {% if ct002_variant != blank %}
                <strong>{{ ct002_variant.price | money }}</strong>
                {% if ct002_variant.compare_at_price > ct002_variant.price %}<s>{{ ct002_variant.compare_at_price | money }}</s>{% endif %}
              {% endif %}
            </div>
            {% if ct002_variant != blank and ct002_variant.available %}
              <a class="bw-accessory-card__button" href="{{ ct002.url | default: '/products/ct002-smart-meter' }}">Auswählen</a>
            {% else %}
              <span class="bw-accessory-card__button is-disabled" aria-disabled="true">Nicht verfügbar</span>
            {% endif %}
          </div>
        </article>

        <article class="bw-accessory-card">
          <a class="bw-accessory-card__image" href="{{ ct003.url | default: '/products/ct003-smart-meter' }}" aria-label="CT003 Produktseite">
            {% if ct003_image != blank %}
              {{ ct003_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120,180,240', sizes: '96px', alt: ct003.title | default: 'CT003' }}
            {% else %}
              <span class="bw-accessory-card__image-placeholder" aria-hidden="true"></span>
            {% endif %}
          </a>
          <div class="bw-accessory-card__details">
            <h3><a href="{{ ct003.url | default: '/products/ct003-smart-meter' }}">CT003</a></h3>
            <p>{{ ct003_subtitle }}</p>
            <span class="bw-accessory-card__badge">Plug &amp; Play</span>
          </div>
          <div class="bw-accessory-card__purchase">
            <div class="bw-accessory-card__price">
              {% if ct003_variant != blank %}
                <strong>{{ ct003_variant.price | money }}</strong>
                {% if ct003_variant.compare_at_price > ct003_variant.price %}<s>{{ ct003_variant.compare_at_price | money }}</s>{% endif %}
              {% endif %}
            </div>
            {% if ct003_variant != blank and ct003_variant.available %}
              <a class="bw-accessory-card__button" href="{{ ct003.url | default: '/products/ct003-smart-meter' }}">Auswählen</a>
            {% else %}
              <span class="bw-accessory-card__button is-disabled" aria-disabled="true">Nicht verfügbar</span>
            {% endif %}
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="bw-section" aria-labelledby="feature-heading">
    <div class="bw-container"><div class="bw-section__intro"><p class="bw-eyebrow">FÜR JEDEN TAG GEMACHT</p><h2 id="feature-heading">Vier Eigenschaften, die den Unterschied machen</h2></div><div class="bw-feature-grid"><article><div class="bw-feature-grid__media">{% if section.settings.feature_image_1 != blank %}{{ section.settings.feature_image_1 | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(min-width: 900px) 25vw, 100vw', alt: 'VENUS E Funktion' }}{% else %}<span>GIF / Bild</span>{% endif %}</div><h3>Notstrom</h3><p>Wichtige Verbraucher bleiben bei einem Stromausfall versorgt, sofern die Anlage passend installiert ist.</p></article><article><div class="bw-feature-grid__media"><span>GIF / Bild</span></div><h3>VPP-ready</h3><p>Bereit für intelligente Energienetze und flexible Nutzung deiner Speicherkapazität.</p></article><article><div class="bw-feature-grid__media"><span>GIF / Bild</span></div><h3>KI-Energiemanagement</h3><p>Die App hilft, Erzeugung, Verbrauch und Ladezustand übersichtlich zu steuern.</p></article><article><div class="bw-feature-grid__media">{% if section.settings.feature_image_2 != blank %}{{ section.settings.feature_image_2 | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(min-width: 900px) 25vw, 100vw', alt: 'VENUS E Erweiterung' }}{% else %}<span>GIF / Bild</span>{% endif %}</div><h3>Erweiterbarkeit</h3><p>Beginne mit einer passenden Größe und ergänze später weitere Kapazität, wenn dein Bedarf wächst.</p></article></div></div>
  </section>

  <section class="bw-section bw-section--blue-light" aria-labelledby="steps-heading"><div class="bw-container"><div class="bw-section__intro bw-section__intro--center"><p class="bw-eyebrow">VON DER IDEE ZUR EIGENEN ENERGIE</p><h2 id="steps-heading">Drei Schritte, dann läuft dein Speicher</h2></div><div class="bw-steps"><article><span>01</span><h3>Bedarf &amp; Kapazität klären</h3><p>Nutze den Rechner und finde eine passende Größenordnung.</p></article><article><span>02</span><h3>Modell wählen</h3><p>Vergleiche die VENUS E Serie und wähle deine Konfiguration.</p></article><article><span>03</span><h3>Installieren &amp; App verbinden</h3><p>Verbinde Speicher und Messung – die App führt dich durch die Einrichtung.</p></article></div></div></section>

  <section class="bw-section bw-section--muted bw-durability" aria-labelledby="durability-heading">
    <div class="bw-container bw-durability__container">
      <div class="bw-section__intro bw-durability__intro">
        <h2 id="durability-heading">Auf 10 Jahre gebaut, auf 15 Jahre ausgelegt</h2>
        <p>LiFePO₄-Zellen, IP65-Gehäuse und unabhängige Prüfungen – ein Speicher, der drinnen wie draußen funktioniert.</p>
      </div>
      <div class="bw-stats" role="list" aria-label="Lebensdauer und Schutz">
        <article class="bw-stat-card" role="listitem">
          <span class="bw-stat-card__icon" aria-hidden="true">{% render 'element.icon', name: 'shield' %}</span>
          <div class="bw-stat-card__metric"><strong>10</strong><span>Jahre Garantie</span></div>
          <p>Herstellergarantie auf alle Modelle – inklusive Batteriemanagement.</p>
        </article>
        <article class="bw-stat-card" role="listitem">
          <span class="bw-stat-card__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="6" width="17" height="12" rx="1.5"></rect><path d="M19.5 10h2v4h-2"></path></svg></span>
          <div class="bw-stat-card__metric"><strong>15</strong><span>Jahre Lebensdauer</span></div>
          <p>LiFePO₄ mit über 6.000 Ladezyklen bei 90&nbsp;% Restkapazität.</p>
        </article>
        <article class="bw-stat-card" role="listitem">
          <span class="bw-stat-card__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="m8 12 2.5 2.5L16.5 9"></path></svg></span>
          <div class="bw-stat-card__metric"><strong>IP65</strong><span>Für jedes Wetter</span></div>
          <p>Staubdicht, strahlwassergeschützt, −20&nbsp;°C bis 55&nbsp;°C.</p>
        </article>
        <article class="bw-stat-card" role="listitem">
          <span class="bw-stat-card__icon" aria-hidden="true">{% render 'element.icon', name: 'ribbon' %}</span>
          <div class="bw-stat-card__metric"><strong>TÜV</strong><span>Geprüft &amp; zertifiziert</span></div>
          <p>CE-konform, mit mehrstufigem Zell- und Brandschutz.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="faq" class="bw-section bw-section--muted bw-anchor-target" aria-labelledby="bw-faq-heading"><div class="bw-container bw-faq"><div class="bw-section__intro bw-section__intro--center"><p class="bw-eyebrow">NOCH FRAGEN?</p><h2 id="bw-faq-heading">Häufige Fragen zum Balkonkraftwerk mit Speicher</h2></div><details><summary>Brauche ich einen Elektriker für die Installation?</summary><p>VENUS E ist für eine einfache Inbetriebnahme konzipiert. Ob ein Elektriker erforderlich ist, hängt von deiner Hausinstallation und der gewählten Systemkonfiguration ab. Bei Unsicherheit empfehlen wir einen Fachbetrieb.</p></details><details><summary>Funktioniert VENUS E auch ohne Photovoltaik?</summary><p>Die Nutzung ist auf die Kombination mit einer passenden PV-Anlage ausgelegt. Prüfe vor dem Kauf die Kompatibilität deines Wechselrichters und deiner Anlage.</p></details><details><summary>Wie lange hält die Batterie?</summary><p>Die LiFePO4-Batterie ist auf eine lange Lebensdauer ausgelegt. Die genaue Leistung hängt von Nutzung, Temperatur und Installationsbedingungen ab.</p></details><details><summary>Was ist VPP und wie viel verdiene ich?</summary><p>VPP steht für virtuelles Kraftwerk. Ob und wie eine Vergütung möglich ist, hängt von Programm, Land und Teilnahmebedingungen ab.</p></details><details><summary>Welche Länder werden unterstützt?</summary><p>Verfügbarkeit und Netzanforderungen unterscheiden sich je nach Land. Bitte prüfe die aktuellen regionalen Hinweise vor dem Kauf.</p></details></div></section>

  <section class="bw-final-cta" aria-labelledby="final-cta-heading"><div class="bw-container bw-final-cta__inner"><div><p class="bw-eyebrow">DER NÄCHSTE SCHRITT</p><h2 id="final-cta-heading">{{ section.settings.final_heading }}</h2><p>{{ section.settings.final_text }}</p></div><div class="bw-final-cta__state" data-bw-final-state><div data-bw-calculated-state hidden><span class="bw-card-badge">DEINE EMPFEHLUNG</span><strong>Du brauchst <span data-bw-final-capacity>15,36 kWh</span></strong><small>Empfehlung: <span data-bw-final-product>3× VENUS E 3.0</span></small><button type="button" class="bw-button bw-button--light" data-bw-final-action>Jetzt kaufen</button></div><div data-bw-uncalculated-state><strong>Noch nicht die passende Kapazität?</strong><small>30 Sekunden bis zur Empfehlung.</small><a class="bw-button bw-button--light" href="#kapazitaet" data-bw-anchor-link>Zum Rechner ↑</a></div></div></div></section>

