      "venus4": {"url": {{ venus_4.url | default: '/products/venus-e-4' | json }}, "title": {{ venus_4.title | default: 'VENUS E 4.0' | json }}, "variants": [{% if venus_4 != blank %}{% for variant in venus_4.variants %}{"id": {{ variant.id | json }}, "title": {{ variant.title | json }}, "available": {{ variant.available | json }}, "price": {{ variant.price | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}{% endif %}]},
      "max": {"url": {{ venus_max.url | default: '/products/venus-e-max' | json }}, "title": {{ venus_max.title | default: 'VENUS E Max' | json }}, "variants": [{% if venus_max != blank %}{% for variant in venus_max.variants %}{"id": {{ variant.id | json }}, "title": {{ variant.title | json }}, "available": {{ variant.available | json }}, "price": {{ variant.price | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}{% endif %}]}
