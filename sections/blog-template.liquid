{%- liquid
  assign blog_center_menu = linklists['blog-center']
  assign blog_center_home_link = blank
  assign blog_center_page = pages['blogs']
  assign is_blog_all_page = false
  assign is_all_blog_view = false
  if blog_center_menu != blank and blog_center_menu.links.size > 0
    assign blog_center_home_link = blog_center_menu.links | first
  endif
  if template.name == 'page' and template.suffix == 'blogs'
    assign is_blog_all_page = true
    assign is_all_blog_view = true
    assign blog_center_url = page.url
  elsif blog_center_page != blank and blog_center_page.url != blank
    assign blog_center_url = blog_center_page.url
  else
    assign blog_center_url = blog_center_home_link.url | default: blog.url
  endif
  if blog_center_url != blank
    unless is_blog_all_page or blog_center_url contains '/pages/' or blog_center_url contains 'view='
      if blog_center_url contains '?'
        assign blog_center_url = blog_center_url | append: '&view=all'
      else
        assign blog_center_url = blog_center_url | append: '?view=all'
      endif
    endunless
  endif
  if template.suffix == 'all'
    assign is_all_blog_view = true
  endif

  assign all_articles = '' | split: ''
  assign all_blog_handles = '|'
  if is_all_blog_view and blog_center_menu != blank
    for link in blog_center_menu.links
      assign source_blog_handle = blank
      if link.object != blank and link.object.handle != blank
        assign source_blog_handle = link.object.handle
      endif

      if source_blog_handle == blank and link.url != blank
        assign source_blog_url = link.url | split: '?' | first | split: '#' | first
        assign source_blog_url_parts = source_blog_url | split: '/blogs/'
        if source_blog_url_parts.size > 1
          assign source_blog_path = source_blog_url_parts[1]
          assign source_blog_handle = source_blog_path | split: '/' | first
        endif
      endif

      assign source_blog_key = '|' | append: source_blog_handle | append: '|'
      if source_blog_handle != blank and all_blog_handles contains source_blog_key
        continue
      endif

      assign source_blog = blogs[source_blog_handle]
      if source_blog != blank and source_blog.articles_count > 0
        assign all_articles = all_articles | concat: source_blog.articles
        assign all_blog_handles = all_blog_handles | append: source_blog_handle | append: '|'
      endif
    endfor
    assign all_articles = all_articles | sort: 'published_at' | reverse
  endif
-%}

{% style %}
  .blog-page {
    --blog-accent: #0099fc;
    --blog-ink: var(--colorTextBody, #2a3743);
    --blog-muted: #697586;
    --blog-border: #dfe6ee;
    --blog-surface: #f4f6f8;
    background: #fff;
  }

  .blog-page__content {
    padding-bottom: 72px;
  }

  .blog-breadcrumbs {
    align-items: center;
    color: #7b8794;
    display: flex;
    flex-wrap: wrap;
    font-size: 14px;
    gap: 10px;
    line-height: 1.5;
    margin: 0 0 28px;
  }

  .blog-breadcrumbs a {
    color: inherit;
    text-decoration: none;
  }

  .blog-breadcrumbs a:hover,
  .blog-breadcrumbs a:focus-visible {
    color: var(--blog-accent);
  }

  .blog-breadcrumbs__divider {
    color: #a7b0bb;
  }

  .blog-page__header {
    align-items: center;
    background: #fff;
    border-bottom: 1px solid var(--blog-border);
    display: flex;
    gap: 32px;
    justify-content: space-between;
    margin-bottom: 16px;
    padding-bottom: 12px;
    position: sticky;
    top: var(--site-header-group-height, var(--header-height, 0px));
    z-index: 10;
  }

  .blog-page__title {
    color: var(--blog-ink);
    font-size: clamp(26px, 2.6vw, 34px);
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin: 0;
  }

  .blog-page__description {
    color: var(--blog-muted);
    font-size: 16px;
    line-height: 1.6;
    margin: 14px 0 0;
    max-width: 680px;
  }

  .blog-category-nav {
    align-items: center;
    display: flex;
    flex: 1 1 auto;
    gap: 26px;
    justify-content: flex-end;
    margin-bottom: 0;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
    white-space: nowrap;
  }

  .blog-category-nav::-webkit-scrollbar {
    display: none;
  }

  .blog-category-nav__link {
    border-bottom: 2px solid transparent;
    color: var(--blog-ink);
    flex: 0 0 auto;
    font-size: 15px;
    padding: 0 0 8px;
    text-decoration: none;
    transition: border-color 180ms ease, color 180ms ease;
  }

  .blog-category-nav__link:hover,
  .blog-category-nav__link:focus-visible,
  .blog-category-nav__link[aria-current='page'] {
    border-color: var(--blog-accent);
    color: var(--blog-accent);
  }

  .blog-featured {
    margin-bottom: 56px;
  }

  .blog-card {
    background: #fff;
    border: 1px solid var(--blog-border);
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .blog-card:hover,
  .blog-card:focus-within {
    border-color: var(--blog-accent);
    box-shadow: 0 12px 30px rgba(0, 102, 170, 0.1);
    transform: translateY(-2px);
  }

  .blog-card__media {
    background: var(--blog-surface);
    display: block;
    overflow: hidden;
    position: relative;
  }

  .blog-card__media .image-element,
  .blog-card__media image-element {
    display: block;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
    width: 100%;
  }

  .blog-card__media > image-element {
    aspect-ratio: 16 / 9;
  }

  .blog-card__media img {
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .blog-card:hover .blog-card__media img,
  .blog-card:focus-within .blog-card__media img {
    transform: scale(1.04);
  }

  .blog-card__placeholder {
    align-items: center;
    aspect-ratio: 16 / 9;
    background: var(--blog-surface);
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .blog-card__placeholder-svg {
    height: 34%;
    opacity: 0.18;
    width: 34%;
  }

  .blog-card__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 20px 22px 24px;
  }

  .blog-card__tag {
    align-self: flex-start;
    color: var(--blog-accent);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.35;
    margin-bottom: 10px;
    text-decoration: none;
  }

  .blog-card__tag:hover,
  .blog-card__tag:focus-visible {
    text-decoration: underline;
  }

  .blog-card__date {
    color: #8a95a3;
    font-size: 13px;
    line-height: 1.4;
    margin-bottom: 10px;
  }

  .blog-card__title {
    color: var(--blog-ink);
    font-size: 20px;
    letter-spacing: -0.02em;
    line-height: 1.3;
    margin: 0;
  }

  .blog-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .blog-card__title a:hover,
  .blog-card__title a:focus-visible {
    color: var(--blog-accent);
  }

  .blog-card__excerpt {
    color: var(--blog-muted);
    font-size: 15px;
    line-height: 1.55;
    margin: 12px 0 0;
  }

  .blog-card__link {
    align-items: center;
    color: var(--blog-accent);
    display: inline-flex;
    font-size: 14px;
    font-weight: 600;
    gap: 7px;
    margin-top: auto;
    padding-top: 18px;
    text-decoration: none;
  }

  .blog-card__link span {
    transition: transform 180ms ease;
  }

  .blog-card__link:hover span,
  .blog-card__link:focus-visible span {
    transform: translateX(3px);
  }

  .blog-card--featured {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
  }

  .blog-card--featured .blog-card__media,
  .blog-card--featured .blog-card__placeholder {
    height: 100%;
    min-height: 320px;
  }

  .blog-card--featured .blog-card__content {
    justify-content: center;
    padding: 40px;
  }

  .blog-card--featured .blog-card__title {
    font-size: clamp(26px, 3vw, 38px);
    max-width: 620px;
  }

  .blog-card--featured .blog-card__excerpt {
    font-size: 16px;
    max-width: 620px;
  }

  .blog-card-grid {
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .blog-empty-state {
    background: var(--blog-surface);
    color: var(--blog-muted);
    padding: 56px 24px;
    text-align: center;
  }

  .blog-page .pagination {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    margin: 48px 0 0;
    padding: 0;
  }

  .blog-page .pagination > span {
    display: inline-flex;
  }

  .blog-page .pagination a,
  .blog-page .pagination .page.current {
    align-items: center;
    border: 1px solid var(--blog-border);
    border-radius: 50%;
    color: var(--blog-ink);
    display: inline-flex;
    font-size: 14px;
    height: 40px;
    justify-content: center;
    min-width: 40px;
    padding: 0 10px;
    text-decoration: none;
  }

  .blog-page .pagination .page.current {
    background: var(--blog-accent);
    border-color: var(--blog-accent);
    color: #fff;
    opacity: 1;
  }

  .blog-page .pagination a:hover,
  .blog-page .pagination a:focus-visible {
    border-color: var(--blog-accent);
    color: var(--blog-accent);
  }

  .blog-page .pagination .next a,
  .blog-page .pagination .prev a {
    background: #fff;
    color: var(--blog-ink);
  }

  .blog-page .pagination .next .icon,
  .blog-page .pagination .prev .icon {
    height: 12px;
    width: 12px;
  }

  @media only screen and (max-width: 900px) {
    .blog-card-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media only screen and (max-width: 768px) {
    .blog-page__content {
      padding-bottom: 48px;
    }

    .blog-page__header {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
      margin-bottom: 16px;
      padding-bottom: 14px;
    }

    .blog-category-nav {
      gap: 20px;
      justify-content: flex-start;
      width: 100%;
    }

    .blog-card--featured {
      display: flex;
    }

    .blog-card--featured .blog-card__media,
    .blog-card--featured .blog-card__placeholder {
      height: auto;
      min-height: 0;
    }

    .blog-card--featured .blog-card__content {
      padding: 24px;
    }

    .blog-card--featured .blog-card__title {
      font-size: 28px;
    }
  }

  @media only screen and (max-width: 560px) {
    .blog-card-grid {
      grid-template-columns: 1fr;
    }

    .blog-card--featured .blog-card__title {
      font-size: 24px;
    }

    .blog-card__content {
      padding: 18px 18px 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-card,
    .blog-card__media .image-element,
    .blog-card__link span,
    .blog-category-nav__link {
      transition: none;
    }
  }
{% endstyle %}

<div class="blog-page" data-section-id="{{ section.id }}" data-section-type="blog">
  <div class="page-width page-content blog-page__content">
    <header class="blog-page__header">
      <div>
        <h1 class="blog-page__title">{{ 'blogs.article.blog_center' | t }}</h1>
      </div>
      {%- if blog_center_menu != blank and blog_center_menu.links.size > 0 -%}
        <nav class="blog-category-nav" aria-label="{{ 'blogs.article.blog_center' | t }}">
          {%- if blog_center_home_link != blank and blog_center_home_link.url != blank -%}
            {%- assign is_blog_center_home = false -%}
            {%- if is_all_blog_view -%}
              {%- assign is_blog_center_home = true -%}
            {%- endif -%}
            <a
              class="blog-category-nav__link{% if is_blog_center_home %} is-active{% endif %}"
              href="{{ blog_center_url }}"
              {% if is_blog_center_home %}aria-current="page"{% endif %}
            >
              {{ 'blogs.article.all' | t }}
            </a>
          {%- endif -%}

          {%- for link in blog_center_menu.links offset: 1 -%}
            {%- assign link_blog_handle = blank -%}
            {%- assign linked_blog = blank -%}
            {%- if link.object != blank and link.object.handle != blank -%}
              {%- assign link_blog_handle = link.object.handle -%}
              {%- assign linked_blog = link.object -%}
            {%- endif -%}
            {%- if link_blog_handle == blank and link.url != blank -%}
              {%- assign link_url = link.url | split: '?' | first | split: '#' | first -%}
              {%- assign link_url_parts = link_url | split: '/blogs/' -%}
              {%- if link_url_parts.size > 1 -%}
                {%- assign link_blog_handle = link_url_parts[1] | split: '/' | first -%}
                {%- assign linked_blog = blogs[link_blog_handle] -%}
              {%- endif -%}
            {%- endif -%}
            {%- assign is_current_blog = false -%}
            {%- if is_all_blog_view == false -%}
              {%- if link_blog_handle == blog.handle or link.url == blog.url or link.url contains blog.url -%}
                {%- assign is_current_blog = true -%}
              {%- endif -%}
            {%- endif -%}

            {%- if linked_blog != blank and linked_blog.articles_count > 0 -%}
              <a
                class="blog-category-nav__link{% if is_current_blog %} is-active{% endif %}"
                href="{{ link.url }}"
                {% if is_current_blog %}aria-current="page"{% endif %}
              >
                {{ link.object.title | default: link.title | escape }}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      {%- elsif blog.articles_count > 0 -%}
        <nav class="blog-category-nav" aria-label="{{ 'blogs.article.blog_center' | t }}">
          <a class="blog-category-nav__link is-active" href="{{ blog.url }}" aria-current="page">
            {{ blog.title | escape }}
          </a>
        </nav>
      {%- endif -%}
    </header>

    {%- render 'blog-breadcrumbs', blog: blog, blog_center_home_link: blog_center_home_link, blog_center_url: blog_center_url, is_blog_all_page: is_blog_all_page -%}

    {%- if is_all_blog_view -%}
      {%- if all_articles.size > 0 -%}
        {%- for article in all_articles limit: 1 -%}
          <section class="blog-featured">
            {%- render 'blog-card', blog: blog, article: article, featured: true -%}
          </section>
        {%- endfor -%}

        <section>
          <div class="blog-card-grid">
            {%- for article in all_articles offset: 1 -%}
              {%- render 'blog-card', blog: blog, article: article -%}
            {%- endfor -%}
          </div>
        </section>
      {%- else -%}
        <p class="blog-empty-state">{{ 'home_page.onboarding.no_content' | t }}</p>
      {%- endif -%}
    {%- else -%}
      {%- paginate blog.articles by 10 -%}
        {%- if blog.articles_count > 0 -%}
          {%- for article in blog.articles limit: 1 -%}
            <section class="blog-featured">
              {%- render 'blog-card', blog: blog, article: article, featured: true -%}
            </section>
          {%- endfor -%}

          <section>
            <div class="blog-card-grid">
              {%- for article in blog.articles offset: 1 -%}
                {%- render 'blog-card', blog: blog, article: article -%}
              {%- endfor -%}
            </div>
          </section>

          {%- if paginate.pages > 1 -%}
            {%- render 'pagination', paginate: paginate -%}
          {%- endif -%}
        {%- else -%}
          <p class="blog-empty-state">{{ 'home_page.onboarding.no_content' | t }}</p>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.blog-template.name",
  "settings": [],
  "disabled_on": {
    "groups": ["footer", "header", "custom.popups"]
  }
}
{% endschema %}
