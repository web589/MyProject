{% liquid
  assign grid_anchor = section.settings.anchor_id | handle
  if grid_anchor == blank
    assign grid_anchor = 'entscheidungshelfer'
  endif
%}

<section
  id="{{ grid_anchor }}"
  class="bw-storage bw-storage-section bw-content-grid bw-content-grid--{{ section.settings.card_style }} bw-content-grid--surface-{{ section.settings.surface }} bw-anchor-target"
  data-bw-module="content-grid"
  aria-labelledby="bw-content-grid-heading-{{ section.id }}"
  style="{% render 'bw-comparison-section-style', section: section %} --bw-content-columns: {{ section.settings.columns }};"
>
  <div class="bw-container">
    <div class="bw-section__intro bw-content-grid__intro{% if grid_anchor == 'kaufkriterien' %} bw-content-grid__intro--stacked{% endif %}">
      {% if section.settings.eyebrow != blank %}
        <p class="bw-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      <h2 id="bw-content-grid-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.text != blank %}
        <div class="bw-rte">{{ section.settings.text }}</div>
      {% endif %}
    </div>

    <div class="bw-content-grid__items" role="list">
      {% for block in section.blocks %}
        {% liquid
          assign card_product = block.settings.product
          assign card_variant = card_product.selected_or_first_available_variant | default: card_product.variants.first
          assign card_image = block.settings.image
          if card_image == blank and card_variant != blank
            assign card_image = card_variant.featured_image
          endif
          if card_image == blank and card_product != blank
            assign card_image = card_product.featured_image
          endif
          assign card_image_alt = block.settings.image_alt | default: card_image.alt | default: card_product.title | default: block.settings.title
          assign product_link_label = block.settings.product_link_label
          assign card_link = block.settings.link_url
          if card_link == blank and card_product != blank and product_link_label == blank
            assign card_link = card_product.url
          endif
          assign card_link_label = block.settings.link_label
          if card_link_label == blank and card_product != blank and product_link_label == blank
            assign card_link_label = card_product.title
          endif
          assign product_link = block.settings.product_link_url
          if product_link == blank and card_product != blank
            assign product_link = card_product.url
          endif
          assign secondary_link = block.settings.secondary_link_url
          assign secondary_link_label = block.settings.secondary_link_label
          assign has_card_actions = false
          if product_link_label != blank and product_link != blank
            assign has_card_actions = true
          elsif secondary_link_label != blank and secondary_link != blank
            assign has_card_actions = true
          elsif card_link_label != blank and card_link != blank
            assign has_card_actions = true
          endif
        %}
        <article class="bw-content-card" role="listitem" {{ block.shopify_attributes }}>
          {% if block.settings.video != blank or card_image != blank %}
            <div class="bw-content-card__media bw-content-card__media--has-content">
              {% if block.settings.video != blank %}
                {{
                  block.settings.video
                  | video_tag:
                    image_size: '900x',
                    autoplay: false,
                    loop: false,
                    muted: true,
                    controls: true,
                    playsinline: true,
                    preload: 'none',
                    class: 'bw-content-card__video'
                }}
              {% else %}
                {{
                  card_image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '360, 540, 720, 900, 1200',
                    sizes: '(min-width: 1100px) 32vw, (min-width: 700px) 48vw, 92vw',
                    alt: card_image_alt
                }}
              {% endif %}
            </div>
          {% elsif request.design_mode and section.settings.card_style == 'media' %}
            <div class="bw-content-card__media bw-editor-placeholder">Bild oder Shopify-Video auswählen</div>
          {% endif %}

          <div class="bw-content-card__body">
            {% if section.settings.show_numbers and block.settings.number != blank %}
              <span class="bw-content-card__number" aria-hidden="true">{{ block.settings.number | escape }}</span>
            {% endif %}
            {% if block.settings.badge != blank %}
              <p class="bw-content-card__badge">{{ block.settings.badge | escape }}</p>
            {% endif %}
            {% if block.settings.title != blank %}
              <h3>{{ block.settings.title | escape }}</h3>
            {% endif %}
            {% if block.settings.text != blank %}
              <div class="bw-content-card__text">{{ block.settings.text }}</div>
            {% endif %}

            {% if block.settings.tag_1 != blank or block.settings.tag_2 != blank %}
              <ul class="bw-content-card__tags" aria-label="Merkmale">
                {% if block.settings.tag_1 != blank %}<li>{{ block.settings.tag_1 | escape }}</li>{% endif %}
                {% if block.settings.tag_2 != blank %}<li>{{ block.settings.tag_2 | escape }}</li>{% endif %}
              </ul>
            {% endif %}

            {% if has_card_actions %}
              <div class="bw-content-card__actions">
                {% if product_link_label != blank and product_link != blank %}
                  <a class="bw-content-card__link bw-content-card__link--product" href="{{ product_link }}">
                    <span aria-hidden="true">&rarr;</span>
                    {{ product_link_label | escape }}
                  </a>
                {% endif %}
                {% if secondary_link_label != blank and secondary_link != blank %}
                  <a class="bw-content-card__link bw-content-card__link--secondary" href="{{ secondary_link }}">
                    {{ secondary_link_label | escape }}
                  </a>
                {% endif %}
                {% if card_link_label != blank and card_link != blank %}
                  <a class="bw-content-card__link" href="{{ card_link }}">
                    {{ card_link_label | escape }}
                    <span aria-hidden="true">&rarr;</span>
                  </a>
                {% endif %}
              </div>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "VENUS E · Inhaltskarten",
  "class": "section-bw-compare-card-grid",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "锚点ID",
      "info": "Ohne # eingeben; die ID muss auf dieser Seite eindeutig sein.",
      "default": "entscheidungshelfer"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "眉题"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "Entscheidungshilfe"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "文本"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "列数",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "卡片样式",
      "options": [
        { "value": "media", "label": "Mit großem Bild" },
        { "value": "feature", "label": "Kompakte Vorteilskarte" },
        { "value": "numbered", "label": "Nummerierter Schritt" }
      ],
      "default": "media"
    },
    {
      "type": "checkbox",
      "id": "show_numbers",
      "label": "显示编号",
      "default": false
    },
    {
      "type": "select",
      "id": "surface",
      "label": "表面",
      "options": [
        { "value": "white", "label": "Weiß" },
        { "value": "soft", "label": "Hellgrau" },
        { "value": "blue", "label": "Hellblau" },
        { "value": "dark", "label": "Dunkel" }
      ],
      "default": "white"
    },
    {
      "type": "header",
      "content": "Layout und Größen"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "眉题大小",
      "min": 10,
      "max": 18,
      "step": 0.5,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "标题大小",
      "min": 24,
      "max": 56,
      "step": 0.5,
      "unit": "px",
      "default": 38
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "正文大小",
      "min": 12,
      "max": 22,
      "step": 0.5,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_title_size",
      "label": "卡片标题大小",
      "min": 14,
      "max": 28,
      "step": 0.5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_text_size",
      "label": "卡片文本大小",
      "min": 11,
      "max": 20,
      "step": 0.5,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "control_size",
      "label": "控件大小",
      "min": 11,
      "max": 18,
      "step": 0.5,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "section_spacing",
      "label": "区块间距",
      "min": 40,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "卡片图片宽度",
      "min": 60,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "卡片图片高度",
      "min": 160,
      "max": 360,
      "step": 10,
      "unit": "px",
      "default": 300
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Inhaltskarte",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "图片",
          "info": "Ohne eigenes Bild wird automatisch das Bild des ausgewählten Produkts verwendet."
        },
        {
          "type": "product",
          "id": "product",
          "label": "产品",
          "info": "Lädt bei leerem Bildfeld das Produktbild und verwendet bei leerem Linkziel die Produktseite."
        },
        {
          "type": "video",
          "id": "video",
          "label": "视频",
          "info": "Wenn ausgewählt, hat das Video Vorrang vor dem Bild."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "图片替代文字"
        },
        {
          "type": "text",
          "id": "number",
          "label": "编号"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "徽标"
        },
        {
          "type": "text",
          "id": "title",
          "label": "标题",
          "default": "Kartentitel"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "文本",
          "default": "<p>Ergänze hier eine konkrete, überprüfbare Information.</p>"
        },
        {
          "type": "text",
          "id": "tag_1",
          "label": "标记1"
        },
        {
          "type": "text",
          "id": "tag_2",
          "label": "标记2"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "链接标签"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "链接链接地址"
        },
        {
          "type": "text",
          "id": "product_link_label",
          "label": "产品链接标签",
          "info": "Zusätzlicher Produktlink vor dem normalen Link, z. B. „VENUS E Mini“."
        },
        {
          "type": "url",
          "id": "product_link_url",
          "label": "产品链接链接地址",
          "info": "Ohne Eingabe wird die ausgewählte Produktseite verwendet."
        },
        {
          "type": "text",
          "id": "secondary_link_label",
          "label": "次链接标签"
        },
        {
          "type": "url",
          "id": "secondary_link_url",
          "label": "次链接链接地址"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "VENUS E · Inhaltskarten",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
