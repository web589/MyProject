{% liquid
  assign models_anchor = section.settings.anchor_id | handle
  if models_anchor == blank
    assign models_anchor = 'modelle'
  endif
  assign section_layout = section.settings.layout | default: 'overview'
%}

<section
  id="{{ models_anchor }}"
  class="bw-storage bw-storage-section bw-models bw-models--{{ section_layout }} bw-anchor-target"
  data-bw-module="models"
  aria-labelledby="bw-models-heading-{{ section.id }}"
  style="{% render 'bw-comparison-section-style', section: section %}"
>
  <div class="bw-container">
    <div class="bw-section__intro bw-models__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="bw-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      <h2 id="bw-models-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.text != blank %}
        <div class="bw-rte">{{ section.settings.text }}</div>
      {% endif %}
    </div>

    <div class="bw-models__grid" role="list">
      {% for block in section.blocks %}
        {% liquid
          assign model = block.settings.product
          assign model_image = block.settings.image
          assign display_title = block.settings.display_title
          assign model_button_label = block.settings.button_label | default: section.settings.cta_label
          if model_image == blank and model != blank
            assign model_image = model.featured_image
          endif
          if display_title == blank and model != blank
            assign display_title = model.title
          endif
        %}
        <article
          class="bw-model-card{% if block.settings.highlight %} bw-model-card--highlight{% endif %}"
          role="listitem"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.badge != blank %}
            <p class="bw-model-card__badge">{{ block.settings.badge | escape }}</p>
          {% endif %}

          <div class="bw-model-card__media{% if model_image != blank %} bw-model-card__media--has-image{% endif %}">
            {% if model_image != blank %}
              {{
                model_image
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  widths: '240, 360, 480, 640, 800',
                  sizes: '(min-width: 1200px) 22vw, (min-width: 700px) 45vw, 90vw',
                  alt: model_image.alt | default: model.title
              }}
            {% elsif request.design_mode %}
              <div class="bw-editor-placeholder">Produkt oder Ersatzbild auswählen</div>
            {% endif %}
          </div>

          <div class="bw-model-card__body">
            {% if model != blank %}
              <h3>{{ display_title | escape }}</h3>
            {% else %}
              <h3>{{ block.settings.display_title | default: section.settings.empty_product_title | escape }}</h3>
            {% endif %}

            {% if block.settings.capacity_range != blank %}
              <p class="bw-model-card__capacity">{{ block.settings.capacity_range | escape }}</p>
            {% endif %}
            {% if block.settings.description != blank %}
              <div class="bw-model-card__description">{{ block.settings.description }}</div>
            {% endif %}

            <div class="bw-model-card__footer">
              {% if model != blank %}
                <p class="bw-model-card__price">
                  <span>{{ section.settings.price_prefix | escape }}</span>
                  <strong>{{ model.price_min | money }}</strong>
                </p>
                <p class="bw-model-card__availability{% unless model.available %} is-unavailable{% endunless %}">
                  <span aria-hidden="true"></span>
                  {% if model.available %}
                    {{ section.settings.available_label | escape }}
                  {% else %}
                    {{ section.settings.unavailable_label | escape }}
                  {% endif %}
                </p>
                <a class="bw-button bw-button--primary bw-model-card__button" href="{{ model.url }}">
                  {{ model_button_label | escape }}
                </a>
              {% elsif request.design_mode %}
                <span class="bw-button bw-button--primary bw-model-card__button" aria-disabled="true">
                  {{ model_button_label | escape }}
                </span>
              {% endif %}
            </div>
          </div>
        </article>
      {% endfor %}
    </div>

    {% assign support_point_keys = 'support_point_1,support_point_2,support_point_3' | split: ',' %}
    {% if section.settings.support_heading != blank or section.settings.support_text != blank or section.settings.support_label != blank or section.settings.support_compare_label != blank %}
      <aside class="bw-models__support">
        <div class="bw-models__support-copy">
          {% if section.settings.support_heading != blank %}
            <h3>{{ section.settings.support_heading | escape }}</h3>
          {% endif %}
          {% if section.settings.support_text != blank %}
            <p>{{ section.settings.support_text | escape }}</p>
          {% endif %}
        </div>

        <ul class="bw-models__support-points" role="list">
          {% for point_key in support_point_keys %}
            {% assign point_text = section.settings[point_key] %}
            {% if point_text != blank %}
              <li>
                <span class="bw-models__support-check" aria-hidden="true">✓</span>
                <span>{{ point_text | escape }}</span>
              </li>
            {% endif %}
          {% endfor %}
        </ul>

        <div class="bw-models__support-actions">
          {% if section.settings.support_label != blank and section.settings.support_link != blank %}
            <a class="bw-button bw-button--primary" href="{{ section.settings.support_link }}">
              {{ section.settings.support_label | escape }} <span aria-hidden="true">&rarr;</span>
            </a>
          {% endif %}
          {% if section.settings.support_compare_label != blank and section.settings.support_compare_link != blank %}
            <a class="bw-button bw-button--secondary" href="{{ section.settings.support_compare_link }}">
              {{ section.settings.support_compare_label | escape }} <span aria-hidden="true">&rarr;</span>
            </a>
          {% endif %}
        </div>
      </aside>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "VENUS E · Modelle",
  "class": "section-bw-compare-models",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "锚点ID",
      "info": "Ohne # eingeben; die ID muss auf dieser Seite eindeutig sein.",
      "default": "modelle"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "眉题",
      "default": "Vier Modelle, ein Ziel"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "Welcher VENUS E passt zu deinem Zuhause?"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "文本",
      "default": "<p>Vergleiche Kapazität, Leistung und Erweiterbarkeit. Produktdaten und Preise werden direkt aus den ausgewählten Shopify-Produkten übernommen.</p>"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "布局",
      "options": [
        { "value": "overview", "label": "Modellübersicht" },
        { "value": "final", "label": "Abschluss-CTA" }
      ],
      "default": "overview"
    },
    {
      "type": "header",
      "content": "Produktinformationen"
    },
    {
      "type": "text",
      "id": "price_prefix",
      "label": "价格前缀",
      "default": "Ab"
    },
    {
      "type": "text",
      "id": "available_label",
      "label": "可用标签",
      "default": "Verfügbar"
    },
    {
      "type": "text",
      "id": "unavailable_label",
      "label": "不可用标签",
      "default": "Derzeit nicht verfügbar"
    },
    {
      "type": "text",
      "id": "empty_product_title",
      "label": "为空产品标题",
      "default": "Produkt auswählen"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "行动按钮标签",
      "default": "Produkt ansehen"
    },
    {
      "type": "header",
      "content": "Beratungshinweis"
    },
    {
      "type": "text",
      "id": "support_heading",
      "label": "支持标题"
    },
    {
      "type": "textarea",
      "id": "support_text",
      "label": "支持文本"
    },
    {
      "type": "text",
      "id": "support_label",
      "label": "支持标签"
    },
    {
      "type": "url",
      "id": "support_link",
      "label": "支持链接"
    },
    {
      "type": "text",
      "id": "support_compare_label",
      "label": "支持对比标签"
    },
    {
      "type": "url",
      "id": "support_compare_link",
      "label": "支持对比链接"
    },
    {
      "type": "text",
      "id": "support_point_1",
      "label": "支持要点1"
    },
    {
      "type": "text",
      "id": "support_point_2",
      "label": "支持要点2"
    },
    {
      "type": "text",
      "id": "support_point_3",
      "label": "支持要点3"
    },
    {
      "type": "header",
      "content": "Layout und Größen"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "眉题大小",
      "min": 10,
      "max": 18,
      "step": 0.5,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "标题大小",
      "min": 24,
      "max": 56,
      "step": 0.5,
      "unit": "px",
      "default": 38
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "正文大小",
      "min": 12,
      "max": 22,
      "step": 0.5,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_title_size",
      "label": "卡片标题大小",
      "min": 14,
      "max": 28,
      "step": 0.5,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "card_text_size",
      "label": "卡片文本大小",
      "min": 11,
      "max": 20,
      "step": 0.5,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "control_size",
      "label": "控件大小",
      "min": 11,
      "max": 18,
      "step": 0.5,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "section_spacing",
      "label": "区块间距",
      "min": 40,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "图片宽度",
      "min": 60,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "图片高度",
      "min": 160,
      "max": 360,
      "step": 10,
      "unit": "px",
      "default": 240
    }
  ],
  "blocks": [
    {
      "type": "model",
      "name": "Modell",
      "limit": 4,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "产品"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "图片",
          "info": "Ohne Auswahl wird das Produktbild verwendet."
        },
        {
          "type": "text",
          "id": "display_title",
          "label": "显示标题",
          "info": "Ohne Eingabe wird der Shopify-Produktname verwendet."
        },
        {
          "type": "text",
          "id": "badge",
          "label": "徽标"
        },
        {
          "type": "text",
          "id": "capacity_range",
          "label": "容量范围"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "说明"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "按钮标签",
          "info": "Ohne Eingabe wird der allgemeine Produktbutton verwendet."
        },
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "高亮",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "VENUS E · Modelle",
      "blocks": [
        { "type": "model" },
        { "type": "model" },
        { "type": "model", "settings": { "highlight": false } },
        { "type": "model" }
      ]
    }
  ]
}
{% endschema %}
