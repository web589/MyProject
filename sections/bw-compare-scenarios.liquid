{% liquid
  assign scenario_anchor = section.settings.anchor_id | handle
  if scenario_anchor == blank
    assign scenario_anchor = 'einsatz'
  endif
%}

<section id="{{ scenario_anchor }}" class="bw-storage bw-storage-section bw-scenarios bw-anchor-target" aria-labelledby="bw-scenarios-heading-{{ section.id }}" style="{% render 'bw-comparison-section-style', section: section %}">
  <div class="bw-container">
    <div class="bw-section__intro bw-scenarios__intro">
      {% if section.settings.eyebrow != blank %}<p class="bw-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2 id="bw-scenarios-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    </div>

    <div class="bw-scenarios__grid" role="list">
      {% for block in section.blocks %}
        {% liquid
          assign product = block.settings.product
          assign scenario_image = block.settings.image
          if scenario_image == blank and product != blank
            assign scenario_variant = product.selected_or_first_available_variant | default: product.variants.first
            assign scenario_image = scenario_variant.featured_image | default: product.featured_image
          endif
          assign scenario_image_alt = block.settings.image_alt | default: scenario_image.alt | default: product.title | default: block.settings.title
        %}
        <article
          class="bw-scenario-card{% if block.settings.highlight %} bw-scenario-card--highlight{% endif %}"
          role="listitem"
          {{ block.shopify_attributes }}
        >
          <div class="bw-scenario-card__media">
            {% if scenario_image != blank %}
              {{ scenario_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1400', sizes: '(min-width: 900px) 46vw, 92vw', alt: scenario_image_alt }}
            {% elsif request.design_mode %}
              <div class="bw-editor-placeholder">Szenariobild auswählen oder Produktbild verwenden</div>
            {% endif %}
          </div>
          <div class="bw-scenario-card__body">
            <div>
              <h3>{{ block.settings.title | escape }}</h3>
              {% if block.settings.text != blank %}<p>{{ block.settings.text | escape }}</p>{% endif %}
            </div>
            {% if product != blank %}
              <a class="bw-scenario-card__link" href="{{ product.url }}">{{ block.settings.link_label | default: product.title | escape }} <span aria-hidden="true">→</span></a>
            {% elsif request.design_mode %}
              <span class="bw-scenario-card__link" aria-disabled="true">{{ block.settings.link_label | default: 'Produkt auswählen' | escape }} <span aria-hidden="true">→</span></span>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "VENUS E · Wohnsituation",
  "class": "section-bw-compare-scenarios",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "锚点ID", "default": "einsatz" },
    { "type": "text", "id": "eyebrow", "label": "眉题", "default": "Was passt zu dir?" },
    { "type": "text", "id": "heading", "label": "标题", "default": "Wähle nach deiner Wohnsituation" },
    { "type": "header", "content": "Layout und Größen" },
    { "type": "range", "id": "eyebrow_size", "label": "眉题大小", "min": 10, "max": 18, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "heading_size", "label": "标题大小", "min": 24, "max": 56, "step": 1, "unit": "px", "default": 38 },
    { "type": "range", "id": "body_size", "label": "正文大小", "min": 12, "max": 22, "step": 0.5, "unit": "px", "default": 16 },
    { "type": "range", "id": "card_title_size", "label": "卡片标题大小", "min": 14, "max": 28, "step": 0.5, "unit": "px", "default": 20 },
    { "type": "range", "id": "card_text_size", "label": "卡片文本大小", "min": 11, "max": 20, "step": 0.5, "unit": "px", "default": 14 },
    { "type": "range", "id": "control_size", "label": "控件大小", "min": 11, "max": 18, "step": 0.5, "unit": "px", "default": 12 },
    { "type": "range", "id": "section_spacing", "label": "区块间距", "min": 40, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "image_width", "label": "图片宽度", "min": 60, "max": 100, "step": 1, "unit": "%", "default": 100 },
    { "type": "range", "id": "image_height", "label": "图片高度", "min": 180, "max": 420, "step": 10, "unit": "px", "default": 300 }
  ],
  "blocks": [
    {
      "type": "scenario",
      "name": "Wohnsituation",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "图片", "info": "Ohne eigenes Bild wird automatisch das Bild des ausgewählten Produkts verwendet." },
        { "type": "text", "id": "image_alt", "label": "图片替代文字" },
        { "type": "text", "id": "title", "label": "标题", "default": "Wohnung" },
        { "type": "textarea", "id": "text", "label": "文本" },
        { "type": "product", "id": "product", "label": "产品" },
        { "type": "text", "id": "link_label", "label": "链接标签", "info": "Ohne Eingabe wird der Shopify-Produktname verwendet." },
        { "type": "checkbox", "id": "highlight", "label": "高亮", "default": false }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "VENUS E · Wohnsituation", "blocks": [{ "type": "scenario" }, { "type": "scenario" }, { "type": "scenario" }, { "type": "scenario" }] }]
}
{% endschema %}
