{% liquid
  assign table_anchor = section.settings.anchor_id | handle
  if table_anchor == blank
    assign table_anchor = 'vergleich'
  endif

  assign product_1 = section.settings.product_1
  assign product_2 = section.settings.product_2
  assign product_3 = section.settings.product_3
  assign product_4 = section.settings.product_4
  assign product_1_label = section.settings.product_1_label | default: product_1.title | default: 'Produkt 1'
  assign product_2_label = section.settings.product_2_label | default: product_2.title | default: 'Produkt 2'
  assign product_3_label = section.settings.product_3_label | default: product_3.title | default: 'Produkt 3'
  assign product_4_label = section.settings.product_4_label | default: product_4.title | default: 'Produkt 4'
  assign product_1_link_label = section.settings.product_1_link_label | default: 'Mini entdecken'
  assign product_2_link_label = section.settings.product_2_link_label | default: '3.0 entdecken'
  assign product_3_link_label = section.settings.product_3_link_label | default: '4.0 entdecken'
  assign product_4_link_label = section.settings.product_4_link_label | default: 'Max entdecken'
  assign highlight_1 = false
  assign highlight_2 = false
  assign highlight_3 = false
  assign highlight_4 = false
  assign default_selected_column = '1'
  case section.settings.highlight_column
    when '1'
      assign highlight_1 = true
    when '2'
      assign highlight_2 = true
    when '3'
      assign highlight_3 = true
    when '4'
      assign highlight_4 = true
  endcase
%}

<section
  id="{{ table_anchor }}"
  class="bw-storage bw-storage-section bw-specs bw-anchor-target"
  data-bw-module="comparison-table"
  data-bw-compare-table
  aria-labelledby="bw-specs-heading-{{ section.id }}"
  style="{% render 'bw-comparison-section-style', section: section %} --bw-compare-table-image-width: {{ section.settings.image_width | default: 112 }}px; --bw-compare-table-image-height: {{ section.settings.image_height | default: 82 }}px;"
>
  <div class="bw-container">
    <div class="bw-section__intro bw-specs__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="bw-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      <h2 id="bw-specs-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.text != blank %}
        <div class="bw-rte">{{ section.settings.text }}</div>
      {% endif %}
    </div>

    <div class="bw-specs__sticky" data-bw-compare-sticky aria-hidden="true" inert>
      <div class="bw-specs__sticky-label" data-bw-compare-sticky-label>
        {{ section.settings.label_heading | escape }}
      </div>
      <div class="bw-specs__sticky-viewport" data-bw-compare-sticky-viewport>
        <div class="bw-specs__sticky-products" data-bw-compare-sticky-products>
          <div
            class="bw-specs__sticky-product{% if highlight_1 %} is-highlighted{% endif %}{% if default_selected_column == '1' %} is-selected{% endif %}"
            data-bw-compare-sticky-product
            data-bw-compare-column="1"
            data-bw-compare-product-select
            tabindex="-1"
            role="button"
            aria-pressed="{% if default_selected_column == '1' %}true{% else %}false{% endif %}"
            aria-label="{{ product_1_label | append: ' auswählen' | escape }}"
          >
            {% render 'bw-compare-product-header', compare_product: product_1, highlighted: highlight_1, visual_only: true, display_label: product_1_label, price_prefix: section.settings.price_prefix %}
          </div>
          <div
            class="bw-specs__sticky-product{% if highlight_2 %} is-highlighted{% endif %}{% if default_selected_column == '2' %} is-selected{% endif %}"
            data-bw-compare-sticky-product
            data-bw-compare-column="2"
            data-bw-compare-product-select
            tabindex="-1"
            role="button"
            aria-pressed="{% if default_selected_column == '2' %}true{% else %}false{% endif %}"
            aria-label="{{ product_2_label | append: ' auswählen' | escape }}"
          >
            {% render 'bw-compare-product-header', compare_product: product_2, highlighted: highlight_2, visual_only: true, display_label: product_2_label, price_prefix: section.settings.price_prefix %}
          </div>
          <div
            class="bw-specs__sticky-product{% if highlight_3 %} is-highlighted{% endif %}{% if default_selected_column == '3' %} is-selected{% endif %}"
            data-bw-compare-sticky-product
            data-bw-compare-column="3"
            data-bw-compare-product-select
            tabindex="-1"
            role="button"
            aria-pressed="{% if default_selected_column == '3' %}true{% else %}false{% endif %}"
            aria-label="{{ product_3_label | append: ' auswählen' | escape }}"
          >
            {% render 'bw-compare-product-header', compare_product: product_3, highlighted: highlight_3, visual_only: true, display_label: product_3_label, price_prefix: section.settings.price_prefix %}
          </div>
          <div
            class="bw-specs__sticky-product{% if highlight_4 %} is-highlighted{% endif %}{% if default_selected_column == '4' %} is-selected{% endif %}"
            data-bw-compare-sticky-product
            data-bw-compare-column="4"
            data-bw-compare-product-select
            tabindex="-1"
            role="button"
            aria-pressed="{% if default_selected_column == '4' %}true{% else %}false{% endif %}"
            aria-label="{{ product_4_label | append: ' auswählen' | escape }}"
          >
            {% render 'bw-compare-product-header', compare_product: product_4, highlighted: highlight_4, visual_only: true, display_label: product_4_label, price_prefix: section.settings.price_prefix %}
          </div>
        </div>
      </div>
    </div>

    <div
      class="bw-specs__scroller"
      data-bw-compare-scroller
      tabindex="0"
      role="region"
      aria-label="{{ section.settings.scroll_label | escape }}"
    >
      <table class="bw-specs__table" data-bw-compare-table-element>
        <caption class="visually-hidden">{{ section.settings.caption | escape }}</caption>
        <colgroup>
          <col class="bw-specs__label-column">
          <col>
          <col>
          <col>
          <col>
        </colgroup>
        <thead>
          <tr>
            <th class="bw-specs__label-cell" scope="col">{{ section.settings.label_heading | escape }}</th>
            <th
              class="bw-specs__product-cell{% if highlight_1 %} is-highlighted{% endif %}{% if default_selected_column == '1' %} is-selected{% endif %}"
              scope="col"
              data-bw-compare-column="1"
              data-bw-compare-product-select
              tabindex="0"
              role="button"
              aria-pressed="{% if default_selected_column == '1' %}true{% else %}false{% endif %}"
              aria-label="{{ product_1_label | append: ' auswählen' | escape }}"
            >
              {% render 'bw-compare-product-header', compare_product: product_1, highlighted: highlight_1, display_label: product_1_label, price_prefix: section.settings.price_prefix %}
            </th>
            <th
              class="bw-specs__product-cell{% if highlight_2 %} is-highlighted{% endif %}{% if default_selected_column == '2' %} is-selected{% endif %}"
              scope="col"
              data-bw-compare-column="2"
              data-bw-compare-product-select
              tabindex="0"
              role="button"
              aria-pressed="{% if default_selected_column == '2' %}true{% else %}false{% endif %}"
              aria-label="{{ product_2_label | append: ' auswählen' | escape }}"
            >
              {% render 'bw-compare-product-header', compare_product: product_2, highlighted: highlight_2, display_label: product_2_label, price_prefix: section.settings.price_prefix %}
            </th>
            <th
              class="bw-specs__product-cell{% if highlight_3 %} is-highlighted{% endif %}{% if default_selected_column == '3' %} is-selected{% endif %}"
              scope="col"
              data-bw-compare-column="3"
              data-bw-compare-product-select
              tabindex="0"
              role="button"
              aria-pressed="{% if default_selected_column == '3' %}true{% else %}false{% endif %}"
              aria-label="{{ product_3_label | append: ' auswählen' | escape }}"
            >
              {% render 'bw-compare-product-header', compare_product: product_3, highlighted: highlight_3, display_label: product_3_label, price_prefix: section.settings.price_prefix %}
            </th>
            <th
              class="bw-specs__product-cell{% if highlight_4 %} is-highlighted{% endif %}{% if default_selected_column == '4' %} is-selected{% endif %}"
              scope="col"
              data-bw-compare-column="4"
              data-bw-compare-product-select
              tabindex="0"
              role="button"
              aria-pressed="{% if default_selected_column == '4' %}true{% else %}false{% endif %}"
              aria-label="{{ product_4_label | append: ' auswählen' | escape }}"
            >
              {% render 'bw-compare-product-header', compare_product: product_4, highlighted: highlight_4, display_label: product_4_label, price_prefix: section.settings.price_prefix %}
            </th>
          </tr>
        </thead>
        <tbody>
          {% for block in section.blocks %}
            {% liquid
              assign spec_namespace = section.settings.spec_namespace
              assign spec_keys = ''
              assign spec_source = 'product'
              assign row_label = block.settings.label

              case block.settings.common_field
                when 'capacity'
                  assign spec_keys = 'capacity,storage_capacity,speicherkapazitaet,speicherkapazitat,speicherkapazität'
                  assign spec_source = 'capacity_range'
                when 'battery_type'
                  assign spec_keys = 'battery_type,batterietyp,cell_type,zelltyp,battery_chemistry'
                when 'nominal_voltage'
                  assign spec_keys = 'nominal_voltage,rated_voltage,nennspannung,spannung'
                when 'cell_capacity'
                  assign spec_keys = 'cell_capacity,cell_capacity_per_cell,zellkapazitaet,zellkapazitat'
                when 'depth_of_discharge'
                  assign spec_keys = 'dod,depth_of_discharge,entladetiefe'
                when 'cycles'
                  assign spec_keys = 'cycles,charging_cycles,cycle_life,ladezyklen,lebenszyklen'
                when 'lifespan'
                  assign spec_keys = 'lifespan,lifetime,service_life,lebensdauer'
                when 'ac_input'
                  assign spec_keys = 'ac_input,ac_input_power,ac_eingangsleistung,pv_input_power,pv_eingangsleistung,input_power'
                when 'ac_output'
                  assign spec_keys = 'ac_output,ac_output_power,ac_ausgangsleistung,output_power'
                when 'bidirectional_power'
                  assign spec_keys = 'bidirectional_power,bidirektionale_leistung,leistung'
                when 'backup_power'
                  assign spec_keys = 'backup_power,emergency_power,notstromleistung,notstrom'
                when 'peak_power'
                  assign spec_keys = 'peak_power,peak_output_power,spitzenleistung'
                when 'eps_switch_time'
                  assign spec_keys = 'eps_switch_time,eps_switching_time,eps_transfer_time,eps_umschaltzeit,umschaltzeit'
                when 'efficiency'
                  assign spec_keys = 'efficiency,conversion_efficiency,wirkungsgrad'
                when 'installation'
                  assign spec_keys = 'installation,installation_type,installationstyp'
                when 'ac_coupling'
                  assign spec_keys = 'ac_coupling,ac_gekoppelt,ac_kopplung'
                when 'scalability'
                  assign spec_keys = 'scalability,expandability,erweiterbarkeit,max_erweiterung,skalierbarkeit'
                when 'smartbox'
                  assign spec_keys = 'smartbox_compatible,smartbox_compatibility,smartbox_kompatibel,smartbox,smart_box'
                when 'zero_feed_in'
                  assign spec_keys = 'zero_feed_in,zero_export,zero_injection,nulleinspeisung,zero_feed'
                when 'vpp'
                  assign spec_keys = 'vpp,vpp_support,vpp_unterstuetzung,vpp_unterstutzung,virtuelles_kraftwerk'
                when 'ai_energy'
                  assign spec_keys = 'ai_energy_management,ai_energy_manager,ki_energiemanagement,ki_energiemanagementsystem,ai_energy,energy_management'
                when 'smart_ev'
                  assign spec_keys = 'smart_ev_charging,ev_charging,smart_ev_laden,smart_ev,e_mobility'
                when 'communication'
                  assign spec_keys = 'communication,kommunikation'
                when 'wifi'
                  assign spec_keys = 'wi_fi,wifi,wlan'
                when 'bluetooth'
                  assign spec_keys = 'bluetooth'
                when 'ip_rating'
                  assign spec_keys = 'ip_rating,ingress_protection,schutzart'
                when 'cooling'
                  assign spec_keys = 'cooling,cooling_type,kuehlung'
                when 'operating_temperature'
                  assign spec_keys = 'operating_temperature,operating_temp,betriebstemperatur'
                when 'dimensions'
                  assign spec_keys = 'dimensions,abmessungen'
                when 'weight'
                  assign spec_keys = 'device_weight,weight,geraetegewicht,gerategewicht,gewicht'
                when 'warranty'
                  assign spec_keys = 'warranty,garantie'
                when 'compatibility'
                  assign spec_keys = 'compatibility,kompatibilitat,kompatibilitaet'
                when 'ideal_for'
                  assign spec_keys = 'ideal_fur,ideal_fuer,ideal_for,recommended_for,geeignet_fur,geeignet_fuer'
                when 'custom'
                  assign spec_namespace = block.settings.custom_namespace
                  assign spec_keys = block.settings.custom_keys
                  assign spec_source = block.settings.custom_source
              endcase

              if row_label == blank
                assign row_label = block.settings.common_field | replace: '_', ' ' | capitalize
              endif
            %}
            <tr {{ block.shopify_attributes }}>
              <th class="bw-specs__label-cell" scope="row">{{ row_label | escape }}</th>
              <td class="bw-specs__value{% if highlight_1 %} is-highlighted{% endif %}{% if default_selected_column == '1' %} is-selected{% endif %}" data-bw-compare-column="1">
                {% capture value_1 %}{% render 'product-comparison-value', spec_product: product_1, spec_source: spec_source, spec_variant_option: section.settings.variant_option, spec_keys: spec_keys, spec_namespace: spec_namespace %}{% endcapture %}
                {% assign value_1 = value_1 | strip %}{{ value_1 | default: '—' }}
              </td>
              <td class="bw-specs__value{% if highlight_2 %} is-highlighted{% endif %}{% if default_selected_column == '2' %} is-selected{% endif %}" data-bw-compare-column="2">
                {% capture value_2 %}{% render 'product-comparison-value', spec_product: product_2, spec_source: spec_source, spec_variant_option: section.settings.variant_option, spec_keys: spec_keys, spec_namespace: spec_namespace %}{% endcapture %}
                {% assign value_2 = value_2 | strip %}{{ value_2 | default: '—' }}
              </td>
              <td class="bw-specs__value{% if highlight_3 %} is-highlighted{% endif %}{% if default_selected_column == '3' %} is-selected{% endif %}" data-bw-compare-column="3">
                {% capture value_3 %}{% render 'product-comparison-value', spec_product: product_3, spec_source: spec_source, spec_variant_option: section.settings.variant_option, spec_keys: spec_keys, spec_namespace: spec_namespace %}{% endcapture %}
                {% assign value_3 = value_3 | strip %}{{ value_3 | default: '—' }}
              </td>
              <td class="bw-specs__value{% if highlight_4 %} is-highlighted{% endif %}{% if default_selected_column == '4' %} is-selected{% endif %}" data-bw-compare-column="4">
                {% capture value_4 %}{% render 'product-comparison-value', spec_product: product_4, spec_source: spec_source, spec_variant_option: section.settings.variant_option, spec_keys: spec_keys, spec_namespace: spec_namespace %}{% endcapture %}
                {% assign value_4 = value_4 | strip %}{{ value_4 | default: '—' }}
              </td>
            </tr>
          {% endfor %}
        </tbody>
        <tfoot>
          <tr class="bw-specs__actions-row">
            <th class="bw-specs__label-cell" scope="row"></th>
            <td class="{% if default_selected_column == '1' %}is-selected{% endif %}" data-bw-compare-column="1">
              {% if product_1 != blank %}
                <a class="bw-specs__product-link" href="{{ product_1.url }}">
                  {{ product_1_link_label | escape }} <span aria-hidden="true">&rarr;</span>
                </a>
              {% endif %}
            </td>
            <td class="{% if default_selected_column == '2' %}is-selected{% endif %}" data-bw-compare-column="2">
              {% if product_2 != blank %}
                <a class="bw-specs__product-link" href="{{ product_2.url }}">
                  {{ product_2_link_label | escape }} <span aria-hidden="true">&rarr;</span>
                </a>
              {% endif %}
            </td>
            <td class="{% if default_selected_column == '3' %}is-selected{% endif %}" data-bw-compare-column="3">
              {% if product_3 != blank %}
                <a class="bw-specs__product-link" href="{{ product_3.url }}">
                  {{ product_3_link_label | escape }} <span aria-hidden="true">&rarr;</span>
                </a>
              {% endif %}
            </td>
            <td class="{% if default_selected_column == '4' %}is-selected{% endif %}" data-bw-compare-column="4">
              {% if product_4 != blank %}
                <a class="bw-specs__product-link" href="{{ product_4.url }}">
                  {{ product_4_link_label | escape }} <span aria-hidden="true">&rarr;</span>
                </a>
              {% endif %}
            </td>
          </tr>
        </tfoot>
      </table>
    </div>
    <p class="bw-specs__mobile-hint">{{ section.settings.mobile_hint | escape }}</p>
  </div>
</section>

{% schema %}
{
  "name": "VENUS E · Datentabelle",
  "class": "section-bw-compare-table",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anker-ID",
      "info": "Ohne # eingeben; die ID muss auf dieser Seite eindeutig sein.",
      "default": "vergleich"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kleine Überschrift",
      "default": "Technische Daten"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "VENUS E Modelle im direkten Vergleich"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Beschreibung",
      "default": "<p>Die Werte werden automatisch aus den Produkt-Metafeldern ausgelesen. Nicht gepflegte Angaben erscheinen als Gedankenstrich.</p>"
    },
    {
      "type": "header",
      "content": "Produkte"
    },
    { "type": "product", "id": "product_1", "label": "Produkt 1" },
    { "type": "product", "id": "product_2", "label": "Produkt 2" },
    { "type": "product", "id": "product_3", "label": "Produkt 3" },
    { "type": "product", "id": "product_4", "label": "Produkt 4" },
    {
      "type": "text",
      "id": "product_1_label",
      "label": "Anzeigename Produkt 1",
      "default": "VENUS E Mini"
    },
    {
      "type": "text",
      "id": "product_2_label",
      "label": "Anzeigename Produkt 2",
      "default": "VENUS E 3.0"
    },
    {
      "type": "text",
      "id": "product_3_label",
      "label": "Anzeigename Produkt 3",
      "default": "VENUS E 4.0"
    },
    {
      "type": "text",
      "id": "product_4_label",
      "label": "Anzeigename Produkt 4",
      "default": "VENUS E Max"
    },
    { "type": "text", "id": "product_1_link_label", "label": "Linktext Produkt 1", "default": "Mini entdecken" },
    { "type": "text", "id": "product_2_link_label", "label": "Linktext Produkt 2", "default": "3.0 entdecken" },
    { "type": "text", "id": "product_3_link_label", "label": "Linktext Produkt 3", "default": "4.0 entdecken" },
    { "type": "text", "id": "product_4_link_label", "label": "Linktext Produkt 4", "default": "Max entdecken" },
    {
      "type": "select",
      "id": "highlight_column",
      "label": "Blau hervorgehobene Spalte",
      "options": [
        { "value": "none", "label": "Keine" },
        { "value": "1", "label": "Produkt 1" },
        { "value": "2", "label": "Produkt 2" },
        { "value": "3", "label": "Produkt 3" },
        { "value": "4", "label": "Produkt 4" }
      ],
      "default": "3"
    },
    {
      "type": "header",
      "content": "Metafelder"
    },
    {
      "type": "text",
      "id": "spec_namespace",
      "label": "Standard-Namespace (optional)",
      "info": "Leer lassen, um die globale Einstellung und die bekannten Ersatz-Namespaces zu verwenden."
    },
    {
      "type": "text",
      "id": "variant_option",
      "label": "Basisvariante für Variantenwerte",
      "default": "1×"
    },
    {
      "type": "header",
      "content": "Beschriftungen"
    },
    {
      "type": "text",
      "id": "label_heading",
      "label": "Überschrift der Merkmals-Spalte",
      "default": "Merkmal"
    },
    {
      "type": "text",
      "id": "price_prefix",
      "label": "Text vor dem Preis",
      "default": "Ab"
    },
    {
      "type": "text",
      "id": "available_label",
      "label": "Verfügbarkeitsstatus",
      "default": "Verfügbar"
    },
    {
      "type": "text",
      "id": "unavailable_label",
      "label": "Status bei Nichtverfügbarkeit",
      "default": "Derzeit nicht verfügbar"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Barrierefreie Tabellenbeschreibung",
      "default": "Technischer Vergleich der vier VENUS E Modelle"
    },
    {
      "type": "text",
      "id": "scroll_label",
      "label": "Barrierefreie Bezeichnung des Scrollbereichs",
      "default": "Vergleichstabelle, horizontal scrollbar"
    },
    {
      "type": "text",
      "id": "mobile_hint",
      "label": "Hinweis auf Mobilgeräten",
      "default": "Seitlich wischen, um alle Modelle zu vergleichen."
    },
    {
      "type": "header",
      "content": "Layout und Größen"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Kleine Überschrift Größe",
      "min": 10,
      "max": 18,
      "step": 0.5,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Überschrift Größe",
      "min": 24,
      "max": 56,
      "step": 0.5,
      "unit": "px",
      "default": 38
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Textgröße",
      "min": 12,
      "max": 22,
      "step": 0.5,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_text_size",
      "label": "Produkttext Größe",
      "min": 11,
      "max": 20,
      "step": 0.5,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "control_size",
      "label": "Tabellenhinweis Größe",
      "min": 11,
      "max": 18,
      "step": 0.5,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "section_spacing",
      "label": "Abstand oben und unten",
      "min": 40,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "产品图宽度",
      "min": 60,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 112
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "产品图高度",
      "min": 50,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 82
    }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Parameterzeile",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Anzeigename links",
          "default": "Speicherkapazität"
        },
        {
          "type": "select",
          "id": "common_field",
