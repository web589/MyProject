{% liquid
  assign trust_anchor = section.settings.anchor_id | handle
  if trust_anchor == blank
    assign trust_anchor = 'vertrauen'
  endif
%}

<section
  id="{{ trust_anchor }}"
  class="bw-storage bw-storage-section bw-compare-trust bw-anchor-target"
  data-bw-module="compare-trust"
  aria-labelledby="bw-compare-trust-heading-{{ section.id }}"
>
  <div class="bw-container">
    <div class="bw-compare-trust__panel">
      <div class="bw-compare-trust__copy">
        {% if section.settings.eyebrow != blank %}
          <p class="bw-compare-trust__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        <h2 id="bw-compare-trust-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {% if section.settings.text != blank %}
          <p class="bw-compare-trust__intro">{{ section.settings.text | escape }}</p>
        {% endif %}

        <div class="bw-compare-trust__stats" role="list" aria-label="{{ section.settings.list_label | escape }}">
          {% for block in section.blocks %}
            <article class="bw-compare-trust__stat" role="listitem" {{ block.shopify_attributes }}>
              <strong>{{ block.settings.metric | escape }}</strong>
              {% if block.settings.label != blank %}
                <span class="bw-compare-trust__stat-label">{{ block.settings.label | escape }}</span>
              {% endif %}
              {% if block.settings.text != blank %}
                <p>{{ block.settings.text | escape }}</p>
              {% endif %}
            </article>
          {% endfor %}
        </div>
      </div>

      <div class="bw-compare-trust__media">
        {% if section.settings.image != blank %}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              widths: '480, 720, 960, 1200',
              sizes: '(min-width: 900px) 34vw, 100vw',
              alt: section.settings.image_alt | default: section.settings.heading
          }}
        {% elsif request.design_mode %}
          <span class="bw-compare-trust__placeholder">Bild für Garantie und Lebensdauer auswählen</span>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "VENUS E · Vertrauen",
  "class": "section-bw-compare-trust",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anker-ID", "default": "vertrauen" },
    { "type": "text", "id": "eyebrow", "label": "Kleine Überschrift", "default": "Vertrauen startet beim Download" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "10 Jahre Herstellergarantie. Bis zu 15 Jahre Lebensdauer." },
    { "type": "textarea", "id": "text", "label": "Beschreibung", "default": "LFP-Batteriezellen mit über 10.000 Ladezyklen, ausgezeichnete Effizienz und tausende Installationen in Europa." },
    { "type": "text", "id": "list_label", "label": "Bezeichnung der Kennzahlen", "default": "Garantie und Lebensdauer" },
    { "type": "image_picker", "id": "image", "label": "Bild" },
    { "type": "text", "id": "image_alt", "label": "Alternativtext" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Kennzahl",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "metric", "label": "Große Kennzahl", "default": "10 Jahre" },
        { "type": "text", "id": "label", "label": "Bezeichnung", "default": "Herstellergarantie" },
        { "type": "textarea", "id": "text", "label": "Beschreibung" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "VENUS E · Vertrauen",
      "blocks": [
        { "type": "stat", "settings": { "metric": "10 Jahre", "label": "Herstellergarantie", "text": "Alle VENUS E Modelle – ohne Aufpreis." } },
        { "type": "stat", "settings": { "metric": "15 Jahre", "label": "Lebensdauer", "text": "LFP-Zellen, auf lange Lebensdauer ausgelegt." } },
        { "type": "stat", "settings": { "metric": "10.000+", "label": "Ladezyklen", "text": "Für tägliches Laden und Entladen bei hohem Wirkungsgrad." } },
        { "type": "stat", "settings": { "metric": "Tausende", "label": "Installationen in Europa", "text": "Von der Wohnung bis zur Villa erprobt." } }
      ]
    }
  ]
}
{% endschema %}
