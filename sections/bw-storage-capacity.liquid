{% liquid
  assign capacity_anchor = section.settings.anchor_id | handle
  if capacity_anchor == blank
    assign capacity_anchor = 'kapazitaet'
  endif
  assign capacity_heading_id = 'bw-capacity-heading-' | append: section.id
  assign homepage_overlay_color = settings.color_image_overlay | default: '#000000'
  assign homepage_overlay_opacity = settings.color_image_overlay_opacity | default: 10
  assign presets_overlay_color = homepage_overlay_color
  assign presets_overlay_opacity = homepage_overlay_opacity
  if section.settings.presets_overlay_use_global == false
    assign presets_overlay_color = section.settings.presets_overlay_color | default: homepage_overlay_color
    assign presets_overlay_opacity = section.settings.presets_background_overlay | default: homepage_overlay_opacity
  endif
  assign presets_overlay_red = presets_overlay_color | color_extract: 'red'
  assign presets_overlay_green = presets_overlay_color | color_extract: 'green'
  assign presets_overlay_blue = presets_overlay_color | color_extract: 'blue'
%}

<section
  id="{{ capacity_anchor }}"
  class="bw-storage bw-storage-section bw-section bw-capacity bw-anchor-target"
  data-bw-module="capacity"
  data-section-id="{{ section.id }}"
  aria-labelledby="{{ capacity_heading_id }}"
>
  <div class="bw-container">
    <header class="bw-section__intro bw-capacity__intro">
      <h2 id="{{ capacity_heading_id }}">{{ section.settings.heading }}</h2>
      {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
    </header>

    {% if section.blocks.size > 0 %}
      <div
        class="bw-capacity-presets{% if section.settings.presets_background_image != blank %} bw-capacity-presets--has-background{% endif %}"
        aria-label="{{ section.settings.presets_label | escape }}"
        style="--bw-capacity-presets-overlay-rgb: {{ presets_overlay_red }}, {{ presets_overlay_green }}, {{ presets_overlay_blue }}; --bw-capacity-presets-overlay-opacity: {{ presets_overlay_opacity | divided_by: 100.0 }}; --bw-capacity-presets-background-position: {{ section.settings.presets_background_position }};{% if section.settings.presets_background_image != blank %} --bw-capacity-presets-background: url('{{ section.settings.presets_background_image | image_url: width: 2200 }}');{% endif %}"
      >
        {% for block in section.blocks %}
          {% liquid
            assign preset_overlay_color = homepage_overlay_color
            assign preset_overlay_opacity = homepage_overlay_opacity
            if block.settings.overlay_use_global == false
              assign preset_overlay_color = block.settings.overlay_color | default: homepage_overlay_color
              assign preset_overlay_opacity = block.settings.background_overlay | default: homepage_overlay_opacity
            endif
            assign preset_overlay_red = preset_overlay_color | color_extract: 'red'
            assign preset_overlay_green = preset_overlay_color | color_extract: 'green'
            assign preset_overlay_blue = preset_overlay_color | color_extract: 'blue'
            assign preset_background = 'rgba(244, 246, 248, 0.84)'
            assign preset_active_background = 'rgba(238, 248, 255, 0.9)'
            if block.settings.background_image != blank
              assign preset_background = 'transparent'
              assign preset_active_background = 'rgba(238, 248, 255, 0.22)'
            endif
          %}
          <button
            type="button"
            class="bw-capacity-preset{% if block.settings.background_image != blank %} bw-capacity-preset--has-background{% endif %}"
            data-bw-preset="{{ block.settings.capacity }}"
            data-bw-preset-people="{{ block.settings.people_value }}"
            data-bw-preset-pv="{{ block.settings.pv_value }}"
            data-bw-preset-annual="{{ block.settings.annual_value }}"
            aria-pressed="false"
            style="--bw-capacity-title-color: {{ block.settings.title_color }}; --bw-capacity-text-color: {{ block.settings.text_color }}; --bw-capacity-overlay-rgb: {{ preset_overlay_red }}, {{ preset_overlay_green }}, {{ preset_overlay_blue }}; --bw-capacity-overlay-opacity: {{ preset_overlay_opacity | divided_by: 100.0 }}; --bw-capacity-preset-background: {{ preset_background }}; --bw-capacity-preset-active-background: {{ preset_active_background }};{% if block.settings.background_image != blank %} --bw-capacity-background: url('{{ block.settings.background_image | image_url: width: 1400 }}'); --bw-capacity-background-position: {{ block.settings.background_position }};{% endif %}"
            {{ block.shopify_attributes }}
          >
            <span class="bw-capacity-preset__badge">{{ block.settings.badge }}</span>
            <strong>{{ block.settings.title }}</strong>
            {% if block.settings.text != blank %}<small>{{ block.settings.text }}</small>{% endif %}
          </button>
        {% endfor %}
      </div>
    {% endif %}

    <div class="bw-calculator" data-bw-calculator>
      <div class="bw-calculator__heading">
        <h3>{{ section.settings.calculator_heading }}</h3>
        {% if section.settings.calculator_text != blank %}<p>{{ section.settings.calculator_text }}</p>{% endif %}
      </div>

      <div class="bw-calculator__controls">
        <div class="bw-slider-row">
          <label for="bw-people-{{ section.id }}">{{ section.settings.people_label }}</label>
          <div class="bw-slider-row__control">
            <input id="bw-people-{{ section.id }}" data-bw-input="people" type="range" min="1" max="6" step="1" value="{{ section.settings.people_default }}">
            <span class="bw-slider-thumb" aria-hidden="true"></span>
            <div class="bw-slider-scale" aria-hidden="true"><span data-bw-scale-value="1">1</span><span data-bw-scale-value="2">2</span><span data-bw-scale-value="3">3</span><span data-bw-scale-value="4">4</span><span data-bw-scale-value="5">5</span><span data-bw-scale-value="6">6+</span></div>
          </div>
          <output for="bw-people-{{ section.id }}" data-bw-output="people">{{ section.settings.people_default }} Personen</output>
        </div>

        <div class="bw-slider-row">
          <label for="bw-pv-{{ section.id }}">{{ section.settings.pv_label }}</label>
          <div class="bw-slider-row__control">
            <input id="bw-pv-{{ section.id }}" data-bw-input="pv" type="range" min="0.8" max="20" step="0.2" value="{{ section.settings.pv_default }}">
            <span class="bw-slider-thumb" aria-hidden="true"></span>
            <div class="bw-slider-scale" aria-hidden="true"><span data-bw-scale-value="0.8">0,8</span><span data-bw-scale-value="5">5</span><span data-bw-scale-value="10">10</span><span data-bw-scale-value="15">15</span><span data-bw-scale-value="20">20</span></div>
          </div>
          <output for="bw-pv-{{ section.id }}" data-bw-output="pv">{{ section.settings.pv_default }} kWp</output>
        </div>

        <div class="bw-slider-row">
          <label for="bw-annual-{{ section.id }}">{{ section.settings.annual_label }}</label>
          <div class="bw-slider-row__control">
            <input id="bw-annual-{{ section.id }}" data-bw-input="annual" type="range" min="1000" max="20000" step="100" value="{{ section.settings.annual_default }}">
            <span class="bw-slider-thumb" aria-hidden="true"></span>
            <div class="bw-slider-scale" aria-hidden="true"><span data-bw-scale-value="1000">1.000</span><span data-bw-scale-value="5000">5.000</span><span data-bw-scale-value="10000">10.000</span><span data-bw-scale-value="15000">15.000</span><span data-bw-scale-value="20000">20.000</span></div>
          </div>
          <output for="bw-annual-{{ section.id }}" data-bw-output="annual">{{ section.settings.annual_default }} kWh/Jahr</output>
        </div>
      </div>

      <div class="bw-calculator__result" aria-live="polite">
        <p class="bw-eyebrow">{{ section.settings.result_eyebrow }}</p>
        <strong data-bw-capacity>ca. 6 kWh</strong>
        {% if section.settings.result_text != blank %}<p>{{ section.settings.result_text }}</p>{% endif %}
        <div class="bw-result-badges" aria-label="Aktuelle Eingaben">
          <span data-bw-summary="people">{{ section.settings.people_default }} Personen</span>
          <span data-bw-summary="pv">{{ section.settings.pv_default }} kWp</span>
          <span data-bw-summary="annual">{{ section.settings.annual_default }} kWh/Jahr</span>
        </div>
        <button type="button" class="bw-button bw-button--primary" data-bw-scroll-results data-bw-results-control aria-expanded="false">
          {{ section.settings.result_button_label }} <span aria-hidden="true">→</span>
        </button>
        {% if section.settings.result_note != blank %}<small>{{ section.settings.result_note }}</small>{% endif %}
        <p class="bw-calculator__warning" data-bw-low-pv-warning role="status" hidden>{{ section.settings.low_pv_warning }}</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "VENUS E · Kapazität",
  "tag": "section",
  "class": "section-bw-storage-capacity",
  "max_blocks": 4,
  "settings": [
    {"type":"text","id":"anchor_id","label":"Anker-ID","info":"Ohne # eingeben; die ID muss auf dieser Seite eindeutig sein.","default":"kapazitaet"},
    {"type":"text","id":"heading","label":"Überschrift","default":"Welche Kapazität passt zu deinem Haushalt?"},
    {"type":"textarea","id":"text","label":"Beschreibung","default":"Wähle nach deiner Wohnsituation, nicht nach Parametern."},
    {"type":"text","id":"presets_label","label":"Bezeichnung der Auswahl","default":"Kapazitätsstufen"},
    {"type":"header","content":"Hintergrund für den Kartenbereich"},
    {"type":"image_picker","id":"presets_background_image","label":"Hintergrundbild für Kartenbereich"},
    {"type":"select","id":"presets_background_position","label":"Bildposition","default":"center center","options":[{"value":"left center","label":"Links"},{"value":"center center","label":"Mitte"},{"value":"right center","label":"Rechts"},{"value":"center top","label":"Oben"},{"value":"center bottom","label":"Unten"}]},
    {"type":"checkbox","id":"presets_overlay_use_global","label":"Homepage-Bildmaskierung verwenden","default":true},
    {"type":"color","id":"presets_overlay_color","label":"Eigene Maskenfarbe für Kartenbereich","default":"#000000"},
    {"type":"range","id":"presets_background_overlay","label":"Helle Überlagerung","min":0,"max":100,"step":5,"unit":"%","default":75},
    {"type":"header","content":"Rechner"},
    {"type":"text","id":"calculator_heading","label":"Rechner-Überschrift","default":"Nicht sicher, was zu dir passt?"},
    {"type":"textarea","id":"calculator_text","label":"Rechner-Beschreibung","default":"Beantworte drei Fragen – wir empfehlen dir die passende VENUS E Kapazität."},
    {"type":"text","id":"people_label","label":"Personen-Bezeichnung","default":"Haushaltsgröße"},
    {"type":"range","id":"people_default","label":"Personen-Startwert","min":1,"max":6,"step":1,"default":3},
    {"type":"text","id":"pv_label","label":"PV-Bezeichnung","default":"PV-Leistung"},
    {"type":"range","id":"pv_default","label":"PV-Startwert","min":0.8,"max":20,"step":0.2,"unit":"kWp","default":6},
    {"type":"text","id":"annual_label","label":"Verbrauch-Bezeichnung","default":"Jährlicher Verbrauch"},
    {"type":"text","id":"annual_default","label":"Verbrauch-Startwert","default":"4000","info":"Nur eine Zahl in kWh eingeben. Der Rechner unterstützt 1.000 bis 20.000 kWh."},
    {"type":"header","content":"Ergebnis"},
    {"type":"text","id":"result_eyebrow","label":"Ergebnis-Kicker","default":"EMPFOHLENE SPEICHERKLASSE"},
    {"type":"text","id":"result_text","label":"Ergebnis-Text","default":"Die Speicherklasse wird aus Verbrauch und PV-Leistung berechnet."},
    {"type":"text","id":"result_button_label","label":"Button","default":"Passende Konfigurationen ansehen"},
    {"type":"textarea","id":"result_note","label":"Hinweis","default":"Die Empfehlung ist eine Orientierung. Für eine genaue Planung berücksichtige bitte deine individuellen Verbrauchsdaten."},
    {"type":"textarea","id":"low_pv_warning","label":"PV-Hinweis","default":"Deine PV-Leistung ist im Verhältnis zu deinem Jahresverbrauch relativ niedrig. Du kannst die Empfehlung trotzdem ansehen."}
  ],
  "blocks": [
    {
      "type": "preset",
      "name": "Haushaltsszenario",
      "settings": [
        {"type":"image_picker","id":"background_image","label":"Hintergrundbild"},
        {"type":"select","id":"background_position","label":"Bildposition","default":"center center","options":[{"value":"left center","label":"Links"},{"value":"center center","label":"Mitte"},{"value":"right center","label":"Rechts"},{"value":"center top","label":"Oben"},{"value":"center bottom","label":"Unten"}]},
        {"type":"checkbox","id":"overlay_use_global","label":"Homepage-Maskierung verwenden","default":true},
        {"type":"color","id":"overlay_color","label":"Eigene Maskenfarbe","default":"#000000"},
        {"type":"range","id":"background_overlay","label":"Helle Überlagerung","min":0,"max":100,"step":5,"unit":"%","default":75},
        {"type":"color","id":"title_color","label":"Titelfarbe","default":"#111827"},
        {"type":"color","id":"text_color","label":"Beschreibungsfarbe","default":"#596b82"},
        {"type":"select","id":"capacity","label":"Speicherklasse","options":[{"value":"2","label":"ca. 2 kWh"},{"value":"4","label":"ca. 4 kWh"},{"value":"5","label":"ca. 5 kWh"},{"value":"6","label":"ca. 6 kWh"},{"value":"10","label":"ca. 10 kWh"},{"value":"15","label":"ca. 15 kWh"},{"value":"20","label":"ca. 20 kWh"},{"value":"30","label":"ca. 30 kWh"}],"default":"10"},
        {"type":"text","id":"badge","label":"Badge","default":"ca. 10 kWh"},
        {"type":"text","id":"title","label":"Titel","default":"3 Personen · 6 kWp"},
        {"type":"textarea","id":"text","label":"Beschreibung","default":"6.200 kWh/Jahr"},
        {"type":"range","id":"people_value","label":"Haushaltsgröße","min":1,"max":6,"step":1,"default":3},
        {"type":"range","id":"pv_value","label":"PV-Leistung","min":0.8,"max":20,"step":0.2,"unit":"kWp","default":6},
        {"type":"text","id":"annual_value","label":"Jährlicher Verbrauch","default":"6200","info":"Nur eine Zahl in kWh eingeben."}
      ]
    }
  ],
  "presets": [
    {
      "name": "VENUS E · Kapazität",
      "blocks": [
        {"type":"preset","settings":{"capacity":"5","badge":"ca. 5 kWh","title":"1 Person · 11 kWp","text":"3.200 kWh/Jahr","people_value":1,"pv_value":11,"annual_value":"3200"}},
        {"type":"preset","settings":{"capacity":"10","badge":"ca. 10 kWh","title":"3 Personen · 6 kWp","text":"6.200 kWh/Jahr","people_value":3,"pv_value":6,"annual_value":"6200"}},
        {"type":"preset","settings":{"capacity":"15","badge":"ca. 15 kWh","title":"4 Personen · 10 kWp","text":"9.000 kWh/Jahr","people_value":4,"pv_value":10,"annual_value":"9000"}},
        {"type":"preset","settings":{"capacity":"30","badge":"ca. 30 kWh","title":"6+ Personen · 20 kWp","text":"20.000 kWh/Jahr","people_value":6,"pv_value":20,"annual_value":"20000"}}
      ]
    }
  ]
}
{% endschema %}
