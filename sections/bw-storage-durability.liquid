<section
  class="bw-storage bw-storage-section bw-durability"
  data-bw-module="durability"
  aria-labelledby="bw-durability-heading-{{ section.id }}"
>
  <div class="bw-container bw-durability__container">
    <div class="bw-section__intro bw-durability__intro">
      <h2 id="bw-durability-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
      {% if section.settings.text != blank %}
        <p>{{ section.settings.text }}</p>
      {% endif %}
    </div>

    <div class="bw-stats" role="list" aria-label="{{ section.settings.list_label | escape }}">
      {% for block in section.blocks %}
        <article class="bw-stat-card" role="listitem" {{ block.shopify_attributes }}>
          <span class="bw-stat-card__icon" aria-hidden="true">
            {% if block.settings.icon_image != blank %}
              {{
                block.settings.icon_image
                | image_url: width: 64
                | image_tag: loading: 'lazy', widths: '32,48,64', sizes: '24px', alt: ''
              }}
            {% else %}
              {% case block.settings.icon %}
                {% when 'battery' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="6" width="17" height="12" rx="1.5"></rect><path d="M19.5 10h2v4h-2"></path></svg>
                {% when 'check' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="m8 12 2.5 2.5L16.5 9"></path></svg>
                {% when 'ribbon' %}
                  {% render 'element.icon', name: 'ribbon' %}
                {% else %}
                  {% render 'element.icon', name: 'shield' %}
              {% endcase %}
            {% endif %}
          </span>
          <div class="bw-stat-card__metric">
            <strong>{{ block.settings.metric }}</strong>
            <span>{{ block.settings.label }}</span>
          </div>
          {% if block.settings.text != blank %}
            <p>{{ block.settings.text }}</p>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "VENUS E · Haltbarkeit",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Auf 10 Jahre gebaut, auf 15 Jahre ausgelegt"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Beschreibung",
      "default": "LiFePO₄-Zellen, IP65-Gehäuse und unabhängige Prüfungen – ein Speicher, der drinnen wie draußen funktioniert."
    },
    {
      "type": "text",
      "id": "list_label",
      "label": "Bezeichnung der Kennzahlen",
      "default": "Lebensdauer und Schutz"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Kennzahl",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Standardsymbol",
          "options": [
            { "value": "shield", "label": "Schild" },
            { "value": "battery", "label": "Batterie" },
            { "value": "check", "label": "Prüfzeichen" },
            { "value": "ribbon", "label": "Medaille" }
          ],
          "default": "shield"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Eigenes Symbol (optional)"
        },
        {
          "type": "text",
          "id": "metric",
          "label": "Große Kennzahl",
          "default": "10"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Bezeichnung",
          "default": "Jahre Garantie"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Beschreibung"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "VENUS E · Haltbarkeit",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "icon": "shield",
            "metric": "10",
            "label": "Jahre Garantie",
            "text": "Herstellergarantie auf alle Modelle – inklusive Batteriemanagement."
          }
        },
        {
          "type": "stat",
          "settings": {
            "icon": "battery",
            "metric": "15",
            "label": "Jahre Lebensdauer",
            "text": "LiFePO₄ mit über 6.000 Ladezyklen bei 90 % Restkapazität."
          }
        },
        {
          "type": "stat",
          "settings": {
            "icon": "check",
            "metric": "IP65",
            "label": "Für jedes Wetter",
            "text": "Staubdicht, strahlwassergeschützt, −20 °C bis 55 °C."
          }
        },
        {
          "type": "stat",
          "settings": {
            "icon": "ribbon",
            "metric": "TÜV",
            "label": "Geprüft & zertifiziert",
            "text": "CE-konform, mit mehrstufigem Zell- und Brandschutz."
          }
        }
      ]
    }
  ]
}
{% endschema %}
