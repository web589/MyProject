{% liquid
  assign flow_anchor = section.settings.anchor_id | handle
  if flow_anchor == blank
    assign flow_anchor = 'funktionsweise'
  endif
  assign flow_heading_id = 'bw-flow-heading-' | append: section.id
  assign day_tab_id = 'bw-flow-day-tab-' | append: section.id
  assign evening_tab_id = 'bw-flow-evening-tab-' | append: section.id
  assign day_panel_id = 'bw-flow-day-panel-' | append: section.id
  assign evening_panel_id = 'bw-flow-evening-panel-' | append: section.id
%}

<section
  id="{{ flow_anchor }}"
  class="bw-storage bw-storage-section bw-section bw-energy-flow bw-anchor-target"
  data-bw-module="energy-flow"
  data-bw-flow
  aria-labelledby="{{ flow_heading_id }}"
>
  <div class="bw-container">
    <div class="bw-energy-flow__card">
      <header class="bw-section__intro bw-energy-flow__intro">
        <h2 id="{{ flow_heading_id }}">{{ section.settings.heading }}</h2>
        {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
      </header>

      <div class="bw-energy-flow__toggle-wrap">
        <div class="bw-toggle" role="tablist" aria-label="{{ section.settings.tabs_label | escape }}">
          <button
            id="{{ day_tab_id }}"
            type="button"
            class="is-active"
            role="tab"
            aria-selected="true"
            aria-controls="{{ day_panel_id }}"
            data-bw-flow-tab="day"
          >{% if section.settings.day_icon != blank %}{{ section.settings.day_icon | image_url: width: 64 | image_tag: loading: 'lazy', widths: '32,48,64', sizes: '20px', alt: '', class: 'bw-toggle__icon' }}{% endif %}<span>{{ section.settings.day_label }}</span></button>
          <button
            id="{{ evening_tab_id }}"
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="{{ evening_panel_id }}"
            tabindex="-1"
            data-bw-flow-tab="evening"
          >{% if section.settings.evening_icon != blank %}{{ section.settings.evening_icon | image_url: width: 64 | image_tag: loading: 'lazy', widths: '32,48,64', sizes: '20px', alt: '', class: 'bw-toggle__icon' }}{% endif %}<span>{{ section.settings.evening_label }}</span></button>
        </div>
      </div>

      <div class="bw-energy-flow__media-stack">
        <div
          id="{{ day_panel_id }}"
          class="bw-flow-media bw-configurable-media bw-media-align--{{ section.settings.media_alignment }} is-active"
          style="--bw-media-width: {{ section.settings.media_width }}%;"
          role="tabpanel"
          aria-labelledby="{{ day_tab_id }}"
          aria-hidden="false"
          data-bw-flow-panel="day"
        >
          {% if section.settings.day_video != blank %}
            {{ section.settings.day_video | video_tag: image_size: '1800x', muted: true, controls: false, playsinline: true, preload: 'metadata', class: 'bw-media__video' }}
          {% elsif section.settings.day_image != blank %}
            {{ section.settings.day_image | image_url: width: 3200 | image_tag: loading: 'lazy', widths: '800,1200,1600,2000,2400,3200', sizes: '(min-width: 1248px) min(1416px, calc(100vw - 132px)), (min-width: 600px) calc(100vw - 96px), calc(100vw - 88px)', alt: section.settings.day_alt }}
          {% elsif request.design_mode %}
            <div class="bw-editor-media-placeholder">Video, GIF oder Bild für Tagsüber auswählen</div>
          {% endif %}
        </div>

        <div
          id="{{ evening_panel_id }}"
          class="bw-flow-media bw-configurable-media bw-media-align--{{ section.settings.media_alignment }}"
          style="--bw-media-width: {{ section.settings.media_width }}%;"
          role="tabpanel"
          aria-labelledby="{{ evening_tab_id }}"
          aria-hidden="true"
          data-bw-flow-panel="evening"
        >
          {% if section.settings.evening_video != blank %}
            {{ section.settings.evening_video | video_tag: image_size: '1800x', muted: true, controls: false, playsinline: true, preload: 'metadata', class: 'bw-media__video' }}
          {% elsif section.settings.evening_image != blank %}
            {{ section.settings.evening_image | image_url: width: 3200 | image_tag: loading: 'lazy', widths: '800,1200,1600,2000,2400,3200', sizes: '(min-width: 1248px) min(1416px, calc(100vw - 132px)), (min-width: 600px) calc(100vw - 96px), calc(100vw - 88px)', alt: section.settings.evening_alt }}
          {% elsif request.design_mode %}
            <div class="bw-editor-media-placeholder">Video, GIF oder Bild für Abends auswählen</div>
          {% endif %}
        </div>
      </div>

      {% if section.settings.footer_text != blank %}
        <p class="bw-energy-flow__footer">{{ section.settings.footer_text }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "VENUS E · Energiefluss",
  "settings": [
    {"type":"text","id":"anchor_id","label":"Anker-ID","info":"Ohne # eingeben; die ID muss auf dieser Seite eindeutig sein.","default":"funktionsweise"},
    {"type":"text","id":"heading","label":"Überschrift","default":"Tagsüber speichern, abends nutzen"},
    {"type":"textarea","id":"text","label":"Beschreibung","default":"Dein VENUS E managt den Energiefluss automatisch. Zwei Szenarien, ein System."},
    {"type":"text","id":"tabs_label","label":"Bezeichnung der Umschaltung","default":"Tageszeit auswählen"},
    {"type":"text","id":"day_label","label":"Tab 1","default":"Tagsüber"},
    {"type":"image_picker","id":"day_icon","label":"Icon · Tagsüber"},
    {"type":"video","id":"day_video","label":"Shopify-Video · Tagsüber","info":"Hat Vorrang vor GIF oder Bild."},
    {"type":"image_picker","id":"day_image","label":"GIF oder Bild · Tagsüber"},
    {"type":"text","id":"day_alt","label":"Alternativtext · Tagsüber","default":"Energiefluss mit VENUS E am Tag"},
    {"type":"text","id":"evening_label","label":"Tab 2","default":"Abends"},
    {"type":"image_picker","id":"evening_icon","label":"Icon · Abends"},
    {"type":"video","id":"evening_video","label":"Shopify-Video · Abends","info":"Hat Vorrang vor GIF oder Bild."},
    {"type":"image_picker","id":"evening_image","label":"GIF oder Bild · Abends"},
    {"type":"text","id":"evening_alt","label":"Alternativtext · Abends","default":"Energiefluss mit VENUS E am Abend"},
    {"type":"range","id":"media_width","label":"Medienbreite","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"select","id":"media_alignment","label":"Medienausrichtung","default":"center","options":[{"value":"left","label":"Links"},{"value":"center","label":"Mitte"},{"value":"right","label":"Rechts"}]},
    {"type":"text","id":"footer_text","label":"Hinweis unter dem GIF","default":"Tagsüber speichern, abends nutzen – dein VENUS E managt den Fluss automatisch."}
  ],
  "presets": [{"name":"VENUS E · Energiefluss"}]
}
{% endschema %}
