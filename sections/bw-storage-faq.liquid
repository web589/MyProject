{% liquid
  assign faq_anchor = section.settings.anchor_id | handle
  if faq_anchor == blank
    assign faq_anchor = 'faq'
  endif
%}

<section
  id="{{ faq_anchor }}"
  class="bw-storage bw-storage-section bw-faq-section bw-anchor-target"
  data-bw-module="faq"
  aria-labelledby="bw-faq-heading-{{ section.id }}"
  style="{% render 'bw-comparison-section-style', section: section %}"
>
  <div class="bw-container bw-faq">
    <div class="bw-section__intro bw-faq__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="bw-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      <h2 id="bw-faq-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
      {% if section.settings.text != blank %}
        <p>{{ section.settings.text }}</p>
      {% endif %}
    </div>

    <div class="bw-faq__items">
      {% for block in section.blocks %}
        {% liquid
          assign item_open = false
          if section.settings.initial_state == 'all'
            assign item_open = true
          elsif section.settings.initial_state == 'first' and forloop.first
            assign item_open = true
          endif
        %}
        <details class="bw-faq__item"{% if item_open %} open{% endif %} {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          {% if block.settings.answer != blank %}
            <div class="bw-faq__answer">
              <div class="bw-faq__answer-inner">{{ block.settings.answer }}</div>
            </div>
          {% endif %}
        </details>
      {% endfor %}
    </div>

    {% if section.settings.view_all_text != blank and section.settings.view_all_link != blank %}
      <div class="bw-faq__view-all">
        <a class="bw-faq__view-all-link" href="{{ section.settings.view_all_link }}">
          {{ section.settings.view_all_text | escape }}
          <svg class="bw-faq__view-all-arrow" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M4 10h11m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    {% endif %}
  </div>
</section>

{%- render 'structured-data',
  structured_data_context: 'faq',
  faq_items: section.blocks,
  faq_source: 'bw_storage'
-%}

{% schema %}
{
  "name": "VENUS E · FAQ",
  "class": "section-bw-storage-faq",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "锚点ID",
      "info": "Ohne # eingeben; die ID muss auf dieser Seite eindeutig sein.",
      "default": "faq"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "眉题"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "文本"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "查看全部文本"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "查看全部链接"
    },
    {
      "type": "select",
      "id": "initial_state",
      "label": "初始状态",
      "options": [
        { "value": "all", "label": "Alle Fragen" },
        { "value": "first", "label": "Nur die erste Frage" },
        { "value": "none", "label": "Keine Frage" }
      ],
      "default": "none"
    },
    { "type": "header", "content": "Layout und Größen" },
    { "type": "range", "id": "heading_size", "label": "标题大小", "min": 24, "max": 56, "step": 1, "unit": "px", "default": 38 },
    { "type": "range", "id": "body_size", "label": "正文大小", "min": 12, "max": 22, "step": 0.5, "unit": "px", "default": 16 },
    { "type": "range", "id": "question_size", "label": "问题大小", "min": 13, "max": 24, "step": 0.5, "unit": "px", "default": 16 },
    { "type": "range", "id": "answer_size", "label": "答案大小", "min": 12, "max": 20, "step": 0.5, "unit": "px", "default": 14 },
    { "type": "range", "id": "section_spacing", "label": "区块间距", "min": 40, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Frage",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "问题",
          "default": "Frage eingeben"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "答案",
          "default": "<p>Antwort eingeben.</p>"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "VENUS E · FAQ",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "Brauche ich einen Elektriker für die Installation?",
            "answer": "<p>Ob ein Elektriker erforderlich ist, hängt von deiner Hausinstallation und der gewählten Systemkonfiguration ab. Bei Unsicherheit empfehlen wir einen Fachbetrieb.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Funktioniert VENUS E auch ohne Photovoltaik?",
            "answer": "<p>Die Nutzung ist auf die Kombination mit einer passenden PV-Anlage ausgelegt. Prüfe vor dem Kauf die Kompatibilität deines Wechselrichters und deiner Anlage.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Wie lange hält die Batterie?",
            "answer": "<p>Die LiFePO₄-Batterie ist auf eine lange Lebensdauer ausgelegt. Die genaue Leistung hängt von Nutzung, Temperatur und Installationsbedingungen ab.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Was ist VPP und wie viel verdiene ich?",
            "answer": "<p>VPP steht für virtuelles Kraftwerk. Ob und wie eine Vergütung möglich ist, hängt vom Programm, dem Land und den Teilnahmebedingungen ab.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Welche Länder werden unterstützt?",
            "answer": "<p>Verfügbarkeit und Netzanforderungen unterscheiden sich je nach Land. Bitte prüfe die aktuellen regionalen Hinweise vor dem Kauf.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
