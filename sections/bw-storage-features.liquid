{% liquid
  assign features_anchor = section.settings.anchor_id | handle
  if features_anchor == blank
    assign features_anchor = 'features'
  endif
%}

<section
  id="{{ features_anchor }}"
  class="bw-storage bw-storage-section bw-features bw-anchor-target"
  data-bw-module="features"
  aria-labelledby="bw-features-heading-{{ section.id }}"
>
  <div class="bw-container">
    <div class="bw-section__intro bw-features__intro">
      <h2 id="bw-features-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
      {% if section.settings.text != blank %}
        <p>{{ section.settings.text }}</p>
      {% endif %}
    </div>

    <div class="bw-feature-grid" role="list">
      {% for block in section.blocks %}
        {% liquid
          assign media_alt = block.settings.media_alt | default: block.settings.title
        %}
        <article class="bw-feature-card" role="listitem" {{ block.shopify_attributes }}>
          <div class="bw-feature-card__copy">
            <h3>{{ block.settings.title }}</h3>
            {% if block.settings.text != blank %}
              <p>{{ block.settings.text }}</p>
            {% endif %}
          </div>

          {% if block.settings.video != blank or block.settings.image != blank or request.design_mode %}
            <div class="bw-feature-grid__media bw-feature-card__media">
              {% if block.settings.video != blank %}
                {{
                  block.settings.video
                  | video_tag:
                    autoplay: true,
                    loop: true,
                    muted: true,
                    controls: false,
                    preload: 'metadata',
                    image_size: '900x'
                }}
              {% elsif block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '400,600,900,1200',
                    sizes: '(min-width: 750px) 50vw, 100vw',
                    alt: media_alt
                }}
              {% else %}
                <span class="bw-editor-placeholder">Bild, GIF oder Shopify-Video auswählen</span>
              {% endif %}
            </div>
          {% endif %}

          {% if block.settings.badge != blank %}
            <span class="bw-feature-card__badge">{{ block.settings.badge }}</span>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "VENUS E · Eigenschaften",
  "settings": [
    {"type":"text","id":"anchor_id","label":"Anker-ID","info":"Ohne # eingeben; die ID muss auf dieser Seite eindeutig sein.","default":"features"},
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Vier Eigenschaften, die den Unterschied machen"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Beschreibung",
      "default": "Was die VENUS E von einem gewöhnlichen Heimspeicher unterscheidet."
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Eigenschaft",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Eigenschaft"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Beschreibung"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Bild oder GIF"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Shopify-Video"
        },
        {
          "type": "text",
          "id": "media_alt",
          "label": "Alternativtext"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "VENUS E · Eigenschaften",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Notstrom",
            "text": "Wichtige Verbraucher können bei einem Stromausfall versorgt bleiben, sofern die Anlage passend installiert und konfiguriert ist.",
            "badge": "≤ 10 ms Reaktionszeit"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "VPP",
            "text": "Bereit für die Einbindung in kompatible Programme für vernetzte und flexible Energienutzung.",
            "badge": "Für vernetzte Energienutzung"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "KI-Energiemanagement",
            "text": "Die App hilft, Erzeugung, Verbrauch und Ladezustand übersichtlich zu steuern.",
            "badge": "Passt sich deinem Verbrauch an"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Erweiterbarkeit",
            "text": "Beginne mit einer passenden Größe und ergänze später weitere Kapazität, wenn dein Bedarf wächst.",
            "badge": "Modular erweiterbar"
          }
        }
      ]
    }
  ]
}
{% endschema %}
