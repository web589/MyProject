{% liquid
  assign hero_anchor = section.settings.anchor_id | handle
  if hero_anchor == blank
    assign hero_anchor = 'balkonkraftwerk-kaufen'
  endif
  assign primary_link = section.settings.primary_link
  assign secondary_link = section.settings.secondary_link
  if primary_link == blank
    assign primary_link = '#kapazitaet'
  endif
  if secondary_link == blank
    assign secondary_link = '#kapazitaet'
  endif
  assign has_media = false
  if section.settings.video != blank or section.settings.image != blank
    assign has_media = true
  endif
  assign hero_copy_width = 100 | minus: section.settings.media_width
%}

<section
  id="{{ hero_anchor }}"
  class="bw-storage bw-storage-section bw-hero bw-anchor-target"
  data-bw-module="hero"
  data-section-id="{{ section.id }}"
  style="{% render 'bw-comparison-section-style', section: section %}"
>
  <div
    class="bw-container bw-hero__grid{% unless has_media or request.design_mode %} bw-hero__grid--copy-only{% endunless %}{% if section.settings.media_position == 'left' %} bw-hero__grid--media-left{% endif %}"
    style="--bw-hero-copy-fr: {{ hero_copy_width }}fr; --bw-hero-media-fr: {{ section.settings.media_width }}fr;"
  >
    <div class="bw-hero__copy">
      {% if section.settings.badge != blank %}
        <p class="bw-hero__pill">{{ section.settings.badge | escape }}</p>
      {% endif %}

      <h1>
        <span class="bw-hero__heading-line">{{ section.settings.heading_line_1 | escape }}</span>
        <span class="bw-hero__heading-line">
          {{ section.settings.heading_line_2 | escape }}
          <span class="bw-hero__heading-accent">{{ section.settings.heading_accent | escape }}</span>
        </span>
      </h1>

      {% if section.settings.text != blank %}
        <div class="bw-lead">{{ section.settings.text }}</div>
      {% endif %}

      <div class="bw-actions">
        {% if section.settings.primary_label != blank %}
          <a class="bw-button bw-button--primary" href="{{ primary_link }}" data-bw-anchor-link>
            {{ section.settings.primary_label | escape }}
          </a>
        {% endif %}
        {% if section.settings.secondary_label != blank %}
          <a class="bw-button bw-button--secondary" href="{{ secondary_link }}" data-bw-anchor-link>
            {{ section.settings.secondary_label | escape }}
          </a>
        {% endif %}
      </div>

      {% if section.blocks.size > 0 %}
        <div class="bw-hero__stats{% if section.settings.stats_style == 'checklist' %} bw-hero__stats--checklist{% endif %}" aria-label="{{ section.settings.stats_label | escape }}">
          {% for block in section.blocks %}
            <div class="bw-hero__stat" {{ block.shopify_attributes }}>
              {% if section.settings.stats_style == 'checklist' %}
                {% if block.settings.value != blank %}<span class="bw-hero__check" aria-hidden="true">✓</span><strong>{{ block.settings.value | escape }}</strong>{% endif %}
              {% else %}
                {% if block.settings.value != blank %}<strong>{{ block.settings.value | escape }}</strong>{% endif %}
                {% if block.settings.detail != blank %}<span>{{ block.settings.detail | escape }}</span>{% endif %}
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    {% if has_media or request.design_mode %}
      <div class="bw-media bw-media--hero bw-hero__media">
        {% if section.settings.video != blank %}
          {{ section.settings.video | video_tag: image_size: '1400x', autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', class: 'bw-media__video' }}
        {% elsif section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '600, 900, 1200, 1600', sizes: '(min-width: 900px) 50vw, 100vw', alt: section.settings.media_alt }}
        {% elsif request.design_mode %}
          <div class="bw-editor-placeholder">Hero-Bild, GIF oder Shopify-Video auswählen</div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "VENUS E · Hero",
  "class": "section-bw-storage-hero",
  "settings": [
    {"type":"text","id":"anchor_id","label":"Anker-ID","info":"Ohne # eingeben; die ID muss auf dieser Seite eindeutig sein.","default":"balkonkraftwerk-kaufen"},
    {
      "type": "text",
      "id": "badge",
      "label": "Kennzeichnung",
      "default": "Balkonkraftwerk mit Speicher"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Überschrift · Zeile 1",
      "default": "Mehr Eigenstrom."
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Überschrift · Zeile 2",
      "default": "Weniger"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Blauer Überschriftenteil",
      "default": "Netzstrom."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Beschreibung",
      "default": "<p>Du hast schon ein Balkonkraftwerk (oder planst eines)? Mit einem VENUS E Speicher nutzt du deinen Solarstrom auch abends und nachts – statt ihn ins Netz zu verschenken.</p>"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primärer Button",
      "default": "Passenden Speicher finden"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primäres Linkziel"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Sekundärer Button",
      "default": "Welche Größe brauche ich?"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Sekundäres Linkziel"
    },
    {
      "type": "header",
      "content": "Medien"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify-Video",
      "info": "Wenn ausgewählt, hat das Video Vorrang vor dem Bild."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bild oder GIF"
    },
    {
      "type": "range",
      "id": "media_width",
      "label": "Medienbreite (Desktop)",
      "min": 35,
      "max": 75,
      "step": 5,
      "unit": "%",
      "default": 55
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Medienposition (Desktop)",
      "default": "right",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "right", "label": "Rechts" }
      ]
    },
    {
      "type": "text",
      "id": "media_alt",
      "label": "Alternativtext",
      "default": "VENUS E Speicher im Wohnbereich"
    },
    {
      "type": "text",
      "id": "stats_label",
      "label": "Bezeichnung der Kennzahlen",
      "default": "Produktvorteile"
    },
    {
      "type": "select",
      "id": "stats_style",
      "label": "Darstellung der Kennzahlen",
      "options": [
        { "value": "stats", "label": "Kennzahl mit Zusatz" },
        { "value": "checklist", "label": "Checkliste" }
      ],
      "default": "stats"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Kennzeichnungsgröße",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "card_title_size",
      "label": "Kennzahl Größe",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_text_size",
      "label": "Kennzahltext Größe",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Layout und Größen"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Überschrift Größe",
      "min": 34,
      "max": 68,
      "step": 1,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Textgröße",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 17
    },
    {
      "type": "range",
      "id": "control_size",
      "label": "Buttongröße",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "section_spacing",
      "label": "Abstand oben und unten",
      "min": 40,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Hero Bildbreite",
      "min": 70,
      "max": 130,
      "step": 1,
      "unit": "%",
      "default": 110
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Hero Bildhöhe",
      "min": 280,
      "max": 640,
      "step": 10,
      "unit": "px",
      "default": 440
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Kennzahl",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Kennzahl",
          "default": "4 Modelle"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Zusatz",
          "default": "2,56 – 10,24 kWh"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "VENUS E · Hero",
      "blocks": [
        { "type": "stat", "settings": { "value": "4 Modelle", "detail": "2,56 – 10,24 kWh" } },
        { "type": "stat", "settings": { "value": "bis 85 %", "detail": "Eigenverbrauch" } },
        { "type": "stat", "settings": { "value": "10 Jahre", "detail": "Garantie" } }
      ]
    }
  ]
}
{% endschema %}
