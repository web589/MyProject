{% liquid
  assign models_anchor = section.settings.anchor_id | handle
  if models_anchor == blank
    assign models_anchor = 'modelle'
  endif
  assign models_heading_id = 'bw-models-heading-' | append: section.id
%}

<section
  id="{{ models_anchor }}"
  class="bw-storage bw-storage-section bw-section bw-models-sync bw-anchor-target"
  data-bw-module="models-sync"
  data-section-id="{{ section.id }}"
  aria-labelledby="{{ models_heading_id }}"
>
  <div class="bw-container">
    <header class="bw-section__intro">
      <h2 id="{{ models_heading_id }}">{{ section.settings.heading }}</h2>
      {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
    </header>
    <div
      id="BwHomepageProductSync-{{ section.id }}"
      class="bw-homepage-product-sync"
      data-bw-homepage-product-sync
      data-bw-source-section-id="{{ section.settings.source_section_id | escape }}"
      data-bw-source-category="{{ section.settings.source_category | escape }}"
      aria-busy="true"
    ></div>
    <p class="bw-sync-status" data-bw-sync-status hidden>{{ section.settings.error_text }}</p>
  </div>
</section>

{% schema %}
{
  "name": "VENUS E · Modelle Sync",
  "tag": "section",
  "class": "section-bw-storage-models-sync",
  "settings": [
    {"type":"text","id":"anchor_id","label":"Anker-ID","default":"modelle"},
    {"type":"text","id":"heading","label":"Überschrift","default":"Die VENUS E Serie im Überblick"},
    {"type":"textarea","id":"text","label":"Beschreibung","default":"Wähle deinen Speicher – Preis, Verfügbarkeit und Produktdaten werden von der Startseite übernommen."},
    {"type":"text","id":"source_section_id","label":"Startseiten-Section-ID","default":"17864389448c0111e2","info":"Nur ändern, wenn die Produktsektion auf der Startseite ersetzt wurde."},
    {"type":"text","id":"source_category","label":"Anzuzeigende Kategorie","default":"VENUS E Speicher"},
    {"type":"text","id":"error_text","label":"Hinweis bei Ladefehler","default":"Die Modelle konnten gerade nicht geladen werden."}
  ],
  "presets": [{"name":"VENUS E · Modelle Sync"}]
}
{% endschema %}
