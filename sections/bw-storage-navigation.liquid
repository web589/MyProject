{% liquid
  assign navigation_anchor = section.settings.anchor_id | handle
  if navigation_anchor == blank
    assign navigation_anchor = 'navigation'
  endif
%}

<nav
  id="{{ navigation_anchor }}"
  class="bw-storage bw-storage-section bw-anchor-nav bw-anchor-target"
  data-bw-module="navigation"
  data-bw-anchor-nav
  data-section-id="{{ section.id }}"
  aria-label="{{ section.settings.aria_label | escape }}"
>
  <div class="bw-container bw-anchor-nav__inner">
    {% for block in section.blocks %}
      {% assign link_target = block.settings.target | remove_first: '#' | handle %}
      {% if block.settings.label != blank and link_target != blank %}
        <a
          class="bw-anchor-nav__link"
          href="#{{ link_target }}"
          data-bw-anchor-link
          {{ block.shopify_attributes }}
        >
          {{ block.settings.label | escape }}
        </a>
      {% endif %}
    {% endfor %}

    {% assign cta_target = section.settings.cta_target | remove_first: '#' | handle %}
    {% if section.settings.cta_label != blank and cta_target != blank %}
      <a
        class="bw-anchor-nav__cta"
        href="#{{ cta_target }}"
        data-bw-anchor-link
      >
        {{ section.settings.cta_label | escape }}
      </a>
    {% endif %}
  </div>
</nav>

{% schema %}
{
  "name": "VENUS E · Navigation",
  "class": "section-bw-storage-navigation",
  "settings": [
    {
      "type": "text",
      "id": "aria_label",
      "label": "Barrierefreie Bezeichnung",
      "default": "Seitennavigation"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anker-ID",
      "info": "Ohne # eingeben; die ID muss auf dieser Seite eindeutig sein.",
      "default": "navigation"
    },
    {
      "type": "header",
      "content": "Hervorgehobener Button"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Beschriftung",
      "default": "Jetzt kaufen"
    },
    {
      "type": "text",
      "id": "cta_target",
      "label": "Sprungziel",
      "info": "Anker-ID mit oder ohne # eingeben.",
      "default": "#kapazitaet"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Navigationslink",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Beschriftung",
          "default": "Navigation"
        },
        {
          "type": "text",
          "id": "target",
          "label": "Sprungziel",
          "info": "Anker-ID mit oder ohne # eingeben.",
          "default": "#balkonkraftwerk-kaufen"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "VENUS E · Navigation",
      "blocks": [
        { "type": "link", "settings": { "label": "Balkonkraftwerk kaufen", "target": "#balkonkraftwerk-kaufen" } },
        { "type": "link", "settings": { "label": "Warum", "target": "#warum-speicher" } },
        { "type": "link", "settings": { "label": "Vergleich", "target": "#vergleich" } },
        { "type": "link", "settings": { "label": "Funktionsweise", "target": "#funktionsweise" } },
        { "type": "link", "settings": { "label": "Nachrüsten", "target": "#nachruesten" } },
        { "type": "link", "settings": { "label": "Kapazität", "target": "#kapazitaet" } },
        { "type": "link", "settings": { "label": "Modelle", "target": "#modelle" } },
        { "type": "link", "settings": { "label": "FAQ", "target": "#faq" } }
      ]
    }
  ]
}
{% endschema %}
