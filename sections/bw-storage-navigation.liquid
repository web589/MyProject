{% liquid
  assign navigation_anchor = 'navigation'
%}

<nav
  id="{{ navigation_anchor }}"
  class="bw-storage bw-storage-section bw-anchor-nav bw-anchor-target"
  data-bw-module="navigation"
  data-bw-anchor-nav
  data-anchor-nav
  data-bw-anchor-controller="modern"
  data-section-id="{{ section.id }}"
  style="--bw-nav-text-size: {{ section.settings.nav_text_size | default: 13 }}px;"
  aria-label="{{ section.settings.aria_label | escape }}"
>
  <div class="bw-container bw-anchor-nav__inner">
    {% for block in section.blocks %}
      {% liquid
        assign link_module = block.settings.module | default: 'custom'
        assign module_label = 'Navigation'
        case link_module
          when 'storage_hero'
            assign module_label = 'Balkonkraftwerk kaufen'
          when 'storage_why'
            assign module_label = 'Warum'
          when 'storage_comparison'
            assign module_label = 'Vergleich'
          when 'storage_flow'
            assign module_label = 'Funktionsweise'
          when 'storage_retrofit'
            assign module_label = 'Nachrüsten'
          when 'storage_capacity'
            assign module_label = 'Kapazität'
          when 'storage_models'
            assign module_label = 'Modelle'
          when 'storage_faq'
            assign module_label = 'FAQ'
          when 'comparison_models'
            assign module_label = 'Modelle'
          when 'comparison_scenarios'
            assign module_label = 'Wohnsituation'
          when 'comparison_comparison'
            assign module_label = 'Modellvergleich'
          when 'comparison_capacity'
            assign module_label = 'Speichergröße'
          when 'comparison_priorities'
            assign module_label = 'Prioritäten'
          when 'comparison_smart'
            assign module_label = 'Smart Energy'
          when 'comparison_setup'
            assign module_label = 'Installation & Notstrom'
          when 'comparison_trust'
            assign module_label = 'Vertrauen'
          when 'comparison_faq'
            assign module_label = 'FAQ'
          when 'comparison_completion'
            assign module_label = 'Abschluss'
        endcase
        assign link_label = block.settings.label | default: module_label
        assign link_warning_id = 'anchor-warning-' | append: section.id | append: '-' | append: block.id
      %}
      {% capture link_target %}{% render 'anchor-navigation-target', module: link_module, fallback: block.settings.target %}{% endcapture %}
      {% assign link_target = link_target | strip | remove_first: '#' | handle %}
      {% if link_label != blank and link_target != blank %}
        <span class="bw-anchor-nav__item" {{ block.shopify_attributes }}>
          <a
            class="bw-anchor-nav__link"
            href="#{{ link_target }}"
            data-bw-anchor-link
            data-anchor-link
            data-anchor-nav-link
            data-bw-anchor-module="{{ link_module | escape }}"
            data-anchor-warning-id="{{ link_warning_id }}"
          >
            {{ link_label | escape }}
          </a>
          <span id="{{ link_warning_id }}" class="bw-anchor-nav__warning" data-anchor-warning hidden>未找到目标模块：{{ link_label | escape }}</span>
        </span>
      {% endif %}
    {% endfor %}

    {% assign cta_module = section.settings.cta_module | default: 'custom' %}
    {% assign cta_warning_id = 'anchor-warning-' | append: section.id | append: '-cta' %}
    {% capture cta_target %}{% render 'anchor-navigation-target', module: cta_module, fallback: section.settings.cta_target %}{% endcapture %}
    {% assign cta_target = cta_target | strip | remove_first: '#' | handle %}
    {% if section.settings.cta_label != blank and cta_target != blank %}
      <a
        class="bw-anchor-nav__cta"
        href="#{{ cta_target }}"
        data-bw-anchor-link
        data-anchor-link
        data-anchor-nav-cta
        data-bw-anchor-module="{{ cta_module | escape }}"
        data-anchor-warning-id="{{ cta_warning_id }}"
      >
        {{ section.settings.cta_label | escape }}
      </a>
      <span id="{{ cta_warning_id }}" class="bw-anchor-nav__warning" data-anchor-warning hidden>未找到目标模块：{{ section.settings.cta_label | escape }}</span>
    {% endif %}
  </div>
</nav>

