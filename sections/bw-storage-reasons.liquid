{% liquid
  assign reasons_anchor = section.settings.anchor_id | handle
  if reasons_anchor == blank
    assign reasons_anchor = 'warum-speicher'
  endif
  assign has_media = false
  if section.settings.video != blank or section.settings.image != blank
    assign has_media = true
  endif
%}

<section
  id="{{ reasons_anchor }}"
  class="bw-storage bw-storage-section bw-section bw-reasons bw-anchor-target"
  data-bw-module="reasons"
  data-section-id="{{ section.id }}"
>
  <div class="bw-container">
    <div class="bw-section__intro bw-reasons__intro">
      {% if section.settings.eyebrow != blank %}<p class="bw-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}
      {% if section.settings.text != blank %}<div class="bw-reasons__text">{{ section.settings.text }}</div>{% endif %}
    </div>

    {% if has_media or request.design_mode %}
      <div
        class="bw-media bw-reasons__media bw-configurable-media bw-media-align--{{ section.settings.media_alignment }}"
        style="--bw-media-width: {{ section.settings.media_width }}%;"
      >
        {% if section.settings.video != blank %}
          {{ section.settings.video | video_tag: image_size: '1800x', autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', class: 'bw-media__video' }}
        {% elsif section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 3200 | image_tag: loading: 'lazy', widths: '800,1200,1600,2000,2400,3200', sizes: '(min-width: 1248px) min(1500px, calc(100vw - 48px)), (min-width: 600px) calc(100vw - 40px), calc(100vw - 32px)', alt: section.settings.media_alt }}
        {% elsif request.design_mode %}
          <div class="bw-editor-placeholder">Breites Bild, GIF oder Shopify-Video auswählen</div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "VENUS E · Gründe",
  "class": "section-bw-storage-reasons",
  "settings": [
    {"type":"text","id":"anchor_id","label":"Anker-ID","info":"Ohne # eingeben; die ID muss auf dieser Seite eindeutig sein.","default":"warum-speicher"},
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Übertitel"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Drei Gründe, warum sich der Speicher rechnet"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Beschreibung",
      "default": "<p>Ein Balkonkraftwerk erzeugt oft mehr Strom als du tagsüber verbrauchst. Ohne Speicher geht dieser Strom ungenutzt ins Netz – mit Speicher nutzt du ihn selbst.</p>"
    },
    {
      "type": "header",
      "content": "Medien"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify-Video",
      "info": "Wenn ausgewählt, hat das Video Vorrang vor dem Bild."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bild oder GIF"
    },
    {
      "type": "range",
      "id": "media_width",
      "label": "Medienbreite",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "media_alignment",
      "label": "Medienausrichtung",
      "default": "center",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "center", "label": "Mitte" },
        { "value": "right", "label": "Rechts" }
      ]
    },
    {
      "type": "text",
      "id": "media_alt",
      "label": "Alternativtext",
      "default": "Balkonkraftwerk mit VENUS E Speicher"
    }
  ],
  "presets": [
    {
      "name": "VENUS E · Gründe"
    }
  ]
}
{% endschema %}
