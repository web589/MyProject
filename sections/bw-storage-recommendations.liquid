{% liquid
  assign venus_mini = section.settings.product_mini
  assign venus_3 = section.settings.product_3
  assign venus_4 = section.settings.product_4
  assign venus_max = section.settings.product_max
  if venus_mini == blank
    assign venus_mini = all_products['venus-e-mini']
  endif
  if venus_3 == blank
    assign venus_3 = all_products['venus-e-3']
  endif
  if venus_4 == blank
    assign venus_4 = all_products['venus-e-4']
  endif
  if venus_max == blank
    assign venus_max = all_products['venus-e-max']
  endif

  assign mini_preorder = venus_mini.metafields.custom.preorder_enabled.value
  assign mini_has_inventory = false
  for variant in venus_mini.variants
    if variant.available
      assign mini_has_inventory = true
      break
    endif
  endfor
  unless mini_has_inventory and venus_mini.available
    assign mini_preorder = true
  endunless

  assign venus_3_preorder = venus_3.metafields.custom.preorder_enabled.value
  assign venus_3_has_inventory = false
  for variant in venus_3.variants
    if variant.available
      assign venus_3_has_inventory = true
      break
    endif
  endfor
  unless venus_3_has_inventory and venus_3.available
    assign venus_3_preorder = true
  endunless

  assign venus_4_preorder = venus_4.metafields.custom.preorder_enabled.value
  assign venus_4_has_inventory = false
  for variant in venus_4.variants
    if variant.available
      assign venus_4_has_inventory = true
      break
    endif
  endfor
  unless venus_4_has_inventory and venus_4.available
    assign venus_4_preorder = true
  endunless

  assign venus_max_preorder = venus_max.metafields.custom.preorder_enabled.value
  assign venus_max_has_inventory = false
  for variant in venus_max.variants
    if variant.available
      assign venus_max_has_inventory = true
      break
    endif
  endfor
  unless venus_max_has_inventory and venus_max.available
    assign venus_max_preorder = true
  endunless

  assign recommendations_anchor = section.settings.anchor_id | handle
  if recommendations_anchor == blank
    assign recommendations_anchor = 'empfehlungen'
  endif
  assign recommendations_heading_id = 'bw-recommendations-heading-' | append: section.id
%}

<section
  id="{{ recommendations_anchor }}"
  class="bw-storage bw-storage-section bw-section bw-recommendations bw-anchor-target"
  data-bw-module="recommendations"
  data-bw-results
  data-bw-results-state="hidden"
  data-section-id="{{ section.id }}"
  aria-labelledby="{{ recommendations_heading_id }}"
  hidden
>
  <div class="bw-container">
    <header class="bw-results__heading">
      {% if section.settings.context_label != blank %}<p>{{ section.settings.context_label }}: <strong data-bw-recommendation-summary>3 Personen · 6 kWp · 4.000 kWh/Jahr</strong></p>{% endif %}
      <h2 id="{{ recommendations_heading_id }}" data-bw-results-heading tabindex="-1">{{ section.settings.heading }} <span data-bw-capacity-inline>ca. 6 kWh</span></h2>
    </header>

    <div class="bw-results__grid">
      {% for block in section.blocks %}
        {% liquid
          assign card_product = venus_3
          assign card_variant = card_product.selected_or_first_available_variant | default: card_product.variants.first
          assign card_image = card_variant.featured_image | default: card_product.featured_image
          assign card_url = card_product.url | default: '/products/venus-e-3'
          assign slot = block.settings.role
          if slot == blank
            assign slot = 'slot' | append: forloop.index
          endif
        %}
        <article
          class="bw-result-card{% if slot == 'slot1' %} bw-result-card--primary{% endif %}"
          data-bw-result-card="{{ slot }}"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.badge != blank %}<span class="bw-card-badge">{{ block.settings.badge }}</span>{% endif %}

          <a class="bw-result-card__media" href="{{ card_url }}" data-bw-result-image-wrap{% if card_image == blank %} hidden{% endif %}>
            <img
              data-bw-result-image
              {% if card_image != blank %}
                src="{{ card_image | image_url: width: 800 }}"
                srcset="{{ card_image | image_url: width: 400 }} 400w, {{ card_image | image_url: width: 800 }} 800w"
              {% else %}
                hidden
              {% endif %}
              sizes="(min-width: 990px) 30vw, 100vw"
              width="800"
              height="600"
              loading="lazy"
              alt="{{ card_product.title | default: block.settings.title | escape }}"
            >
          </a>
          {% if request.design_mode and card_image == blank %}<div class="bw-editor-media-placeholder">Produktbild wird aus Shopify geladen.</div>{% endif %}

          <div class="bw-result-card__body">
            <h3 data-bw-result-title>{{ block.settings.title }}</h3>
            <small data-bw-result-capacity>{{ block.settings.capacity }}</small>
            {% if block.settings.text != blank %}<p>{{ block.settings.text }}</p>{% endif %}
            <div class="bw-result-card__price">
              <strong data-bw-result-price>{% if card_variant != blank %}{{ card_variant.price | money }}{% endif %}</strong>
              <s data-bw-result-compare-at{% unless card_variant.compare_at_price > card_variant.price %} hidden{% endunless %}>{% if card_variant.compare_at_price > card_variant.price %}{{ card_variant.compare_at_price | money }}{% endif %}</s>
            </div>
            <span class="bw-result-card__availability" data-bw-result-availability>{% if card_variant.available %}Verfügbar{% else %}Nicht verfügbar{% endif %}</span>
            <button
              type="button"
              class="bw-button bw-button--primary bw-result-action"
              data-bw-product-role="{{ slot }}"
              data-product-url="{{ card_url }}"
              data-variant-id="{% if card_variant != blank %}{{ card_variant.id }}{% endif %}"
              data-direct-add="false"
            >{{ block.settings.button_label }}</button>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>

  <script type="application/json" data-bw-product-data>
    {
      "mini": {
        "id": {{ venus_mini.id | append: '' | json }},
        "handle": {{ venus_mini.handle | default: 'venus-e-mini' | json }},
        "url": {{ venus_mini.url | default: '/products/venus-e-mini' | json }},
        "title": {{ venus_mini.title | default: 'VENUS E Mini' | json }},
        "featured_image": {% if venus_mini.featured_image != blank %}{{ venus_mini.featured_image | image_url: width: 1000 | json }}{% else %}null{% endif %},
        "preorder_enabled": {{ mini_preorder | default: false | json }},
        "preorder_label": {{ venus_mini.metafields.custom.preorder_button_label.value | default: 'Jetzt vormerken' | json }},
        "variants": [{% if venus_mini != blank %}{% for variant in venus_mini.variants %}{% assign variant_image = variant.featured_image | default: venus_mini.featured_image %}{"id":{{ variant.id | append: '' | json }},"title":{{ variant.title | json }},"available":{{ variant.available | json }},"price":{{ variant.price | json }},"compare_at_price":{{ variant.compare_at_price | json }},"image":{% if variant_image != blank %}{{ variant_image | image_url: width: 1000 | json }}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}{% endfor %}{% endif %}]
      },
      "venus3": {
        "id": {{ venus_3.id | append: '' | json }},
        "handle": {{ venus_3.handle | default: 'venus-e-3' | json }},
        "url": {{ venus_3.url | default: '/products/venus-e-3' | json }},
        "title": {{ venus_3.title | default: 'VENUS E 3.0' | json }},
        "featured_image": {% if venus_3.featured_image != blank %}{{ venus_3.featured_image | image_url: width: 1000 | json }}{% else %}null{% endif %},
        "preorder_enabled": {{ venus_3_preorder | default: false | json }},
        "preorder_label": {{ venus_3.metafields.custom.preorder_button_label.value | default: 'Jetzt vormerken' | json }},
        "variants": [{% if venus_3 != blank %}{% for variant in venus_3.variants %}{% assign variant_image = variant.featured_image | default: venus_3.featured_image %}{"id":{{ variant.id | append: '' | json }},"title":{{ variant.title | json }},"available":{{ variant.available | json }},"price":{{ variant.price | json }},"compare_at_price":{{ variant.compare_at_price | json }},"image":{% if variant_image != blank %}{{ variant_image | image_url: width: 1000 | json }}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}{% endfor %}{% endif %}]
      },
      "venus4": {
        "id": {{ venus_4.id | append: '' | json }},
        "handle": {{ venus_4.handle | default: 'venus-e-4' | json }},
        "url": {{ venus_4.url | default: '/products/venus-e-4' | json }},
        "title": {{ venus_4.title | default: 'VENUS E 4.0' | json }},
        "featured_image": {% if venus_4.featured_image != blank %}{{ venus_4.featured_image | image_url: width: 1000 | json }}{% else %}null{% endif %},
        "preorder_enabled": {{ venus_4_preorder | default: false | json }},
        "preorder_label": {{ venus_4.metafields.custom.preorder_button_label.value | default: 'Jetzt vormerken' | json }},
        "variants": [{% if venus_4 != blank %}{% for variant in venus_4.variants %}{% assign variant_image = variant.featured_image | default: venus_4.featured_image %}{"id":{{ variant.id | append: '' | json }},"title":{{ variant.title | json }},"available":{{ variant.available | json }},"price":{{ variant.price | json }},"compare_at_price":{{ variant.compare_at_price | json }},"image":{% if variant_image != blank %}{{ variant_image | image_url: width: 1000 | json }}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}{% endfor %}{% endif %}]
      },
      "max": {
        "id": {{ venus_max.id | append: '' | json }},
        "handle": {{ venus_max.handle | default: 'venus-e-max' | json }},
        "url": {{ venus_max.url | default: '/products/venus-e-max' | json }},
        "title": {{ venus_max.title | default: 'VENUS E Max' | json }},
        "featured_image": {% if venus_max.featured_image != blank %}{{ venus_max.featured_image | image_url: width: 1000 | json }}{% else %}null{% endif %},
        "preorder_enabled": {{ venus_max_preorder | default: false | json }},
        "preorder_label": {{ venus_max.metafields.custom.preorder_button_label.value | default: 'Jetzt vormerken' | json }},
        "variants": [{% if venus_max != blank %}{% for variant in venus_max.variants %}{% assign variant_image = variant.featured_image | default: venus_max.featured_image %}{"id":{{ variant.id | append: '' | json }},"title":{{ variant.title | json }},"available":{{ variant.available | json }},"price":{{ variant.price | json }},"compare_at_price":{{ variant.compare_at_price | json }},"image":{% if variant_image != blank %}{{ variant_image | image_url: width: 1000 | json }}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}{% endfor %}{% endif %}]
      }
    }
  </script>
</section>

{% schema %}
{
  "name": "VENUS E · Empfehlungen",
  "tag": "section",
  "class": "section-bw-storage-recommendations",
  "max_blocks": 3,
  "settings": [
    {"type":"text","id":"anchor_id","label":"Anker-ID","info":"Ohne # eingeben; die ID muss auf dieser Seite eindeutig sein.","default":"empfehlungen"},
    {"type":"text","id":"context_label","label":"Eingabe-Zusammenfassung","default":"Basierend auf deiner Eingabe"},
    {"type":"text","id":"heading","label":"Überschrift","default":"Diese Konfigurationen passen zu"},
    {"type":"product","id":"product_mini","label":"VENUS E Mini Produkt"},
    {"type":"product","id":"product_3","label":"VENUS E 3.0 Produkt"},
    {"type":"product","id":"product_4","label":"VENUS E 4.0 Produkt"},
    {"type":"product","id":"product_max","label":"VENUS E Max Produkt"}
  ],
  "blocks": [
    {
      "type": "recommendation_card",
      "name": "Empfehlungskarte",
      "settings": [
        {"type":"select","id":"role","label":"Kartenplatz","options":[{"value":"slot1","label":"1. Karte"},{"value":"slot2","label":"2. Karte"},{"value":"slot3","label":"3. Karte"}],"default":"slot1"},
        {"type":"text","id":"badge","label":"Badge"},
        {"type":"text","id":"title","label":"Starttitel","info":"Wird nach der Berechnung dynamisch aktualisiert."},
        {"type":"text","id":"capacity","label":"Startkapazität","info":"Wird nach der Berechnung dynamisch aktualisiert."},
        {"type":"textarea","id":"text","label":"Beschreibung","default":"Die passende Konfiguration für deinen Bedarf."},
        {"type":"text","id":"button_label","label":"Button","default":"In den Warenkorb"}
      ]
    }
  ],
  "presets": [
    {
      "name": "VENUS E · Empfehlungen",
      "blocks": [
        {"type":"recommendation_card","settings":{"role":"slot1","badge":"Empfohlen","title":"VENUS E","capacity":"ca. 10 kWh","text":"Die passende Konfiguration für deinen Bedarf.","button_label":"In den Warenkorb"}},
        {"type":"recommendation_card","settings":{"role":"slot2","title":"Alternative","capacity":"ca. 10 kWh","text":"Eine weitere passende Konfiguration.","button_label":"In den Warenkorb"}},
        {"type":"recommendation_card","settings":{"role":"slot3","title":"Alternative","capacity":"ca. 10 kWh","text":"Eine weitere passende Konfiguration.","button_label":"In den Warenkorb"}}
      ]
    }
  ]
}
{% endschema %}
