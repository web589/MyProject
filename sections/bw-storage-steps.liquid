{% liquid
  assign steps_anchor = section.settings.anchor_id | handle
  if steps_anchor == blank
    assign steps_anchor = 'steps'
  endif
%}

<section
  id="{{ steps_anchor }}"
  class="bw-storage bw-storage-section bw-steps-section bw-anchor-target"
  data-bw-module="steps"
  aria-labelledby="bw-steps-heading-{{ section.id }}"
>
  <div class="bw-container">
    <div class="bw-section__intro bw-steps-section__intro">
      <h2 id="bw-steps-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
      {% if section.settings.text != blank %}
        <p>{{ section.settings.text }}</p>
      {% endif %}
    </div>

    <div class="bw-steps" role="list">
      {% for block in section.blocks %}
        <article class="bw-step-card" role="listitem" {{ block.shopify_attributes }}>
          <span class="bw-step-card__number" aria-hidden="true">{{ block.settings.number }}</span>
          <h3>{{ block.settings.title }}</h3>
          {% if block.settings.text != blank %}
            <p>{{ block.settings.text }}</p>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "VENUS E · Schritte",
  "settings": [
    {"type":"text","id":"anchor_id","label":"Anker-ID","info":"Ohne # eingeben; die ID muss auf dieser Seite eindeutig sein.","default":"steps"},
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Drei Schritte, dann läuft dein Speicher"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Beschreibung",
      "default": "Vom Bedarf bis zur App – ohne Umweg über eine komplizierte Auswahl."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Schritt",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Nummer",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Bedarf & Kapazität klären"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Beschreibung"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "VENUS E · Schritte",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "number": "01",
            "title": "Bedarf & Kapazität klären",
            "text": "Wie viele Personen im Haushalt? Wie viel kWh pro Jahr? Welche Verbraucher willst du abdecken?"
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "02",
            "title": "Modell wählen",
            "text": "Mini, 3.0, 4.0 oder Max – passend zu deinem Balkonkraftwerk und deinem Verbrauch."
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "03",
            "title": "Installieren & App verbinden",
            "text": "Smart Meter anbringen, VENUS E einstecken und die App koppeln. Fertig."
          }
        }
      ]
    }
  ]
}
{% endschema %}
