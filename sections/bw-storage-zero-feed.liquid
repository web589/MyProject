{% liquid
  assign zero_feed_anchor = section.settings.anchor_id | handle
  if zero_feed_anchor == blank
    assign zero_feed_anchor = 'zero-feed'
  endif
  assign section_ct002 = section.settings.product_ct002
  assign section_ct003 = section.settings.product_ct003
%}

<section
  id="{{ zero_feed_anchor }}"
  class="bw-storage bw-storage-section bw-zero-feed bw-anchor-target"
  data-bw-module="zero-feed"
  aria-labelledby="bw-zero-feed-heading-{{ section.id }}"
  style="
    --bw-zero-feed-heading-font-size: {{ section.settings.heading_font_size | default: 42 }}px;
    --bw-zero-feed-intro-font-size: {{ section.settings.intro_font_size | default: 16 }}px;
    --bw-zero-feed-feature-title-font-size: {{ section.settings.feature_title_font_size | default: 12 }}px;
    --bw-zero-feed-feature-text-font-size: {{ section.settings.feature_text_font_size | default: 10 }}px;
    --bw-zero-feed-accessory-title-font-size: {{ section.settings.accessory_title_font_size | default: 16 }}px;
    --bw-zero-feed-accessory-subtitle-font-size: {{ section.settings.accessory_subtitle_font_size | default: 12 }}px;
    --bw-zero-feed-accessory-badge-font-size: {{ section.settings.accessory_badge_font_size | default: 10 }}px;
    --bw-zero-feed-accessory-price-font-size: {{ section.settings.accessory_price_font_size | default: 19 }}px;
    --bw-zero-feed-accessory-compare-font-size: {{ section.settings.accessory_compare_font_size | default: 12 }}px;
    --bw-zero-feed-accessory-button-font-size: {{ section.settings.accessory_button_font_size | default: 12 }}px;
    --bw-zero-feed-service-font-size: {{ section.settings.service_font_size | default: 11 }}px;
  "
>
  <div class="bw-container bw-zero-feed__container">
    <div
      class="bw-section__intro bw-zero-feed__intro bw-configurable-media bw-media-align--{{ section.settings.media_alignment }}"
      style="--bw-media-width: {{ section.settings.media_width }}%;"
    >
      <h2 id="bw-zero-feed-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
      {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
    </div>

    {% if section.settings.flow_video != blank or section.settings.flow_image != blank or request.design_mode %}
      <div
        class="bw-zero-feed__media bw-configurable-media bw-media-align--{{ section.settings.media_alignment }}"
        style="--bw-media-width: {{ section.settings.media_width }}%;"
      >
        {% if section.settings.flow_video != blank %}
          {{ section.settings.flow_video | video_tag: image_size: '2000x', autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', class: 'bw-media__video' }}
        {% elsif section.settings.flow_image != blank %}
          {{ section.settings.flow_image | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '750,1100,1500,2000', sizes: '(min-width: 1248px) 1200px, calc(100vw - 48px)', alt: section.settings.flow_image_alt }}
        {% else %}
          <span class="bw-editor-media-placeholder">Großes Energieflussvideo, GIF oder Bild auswählen</span>
        {% endif %}
      </div>
    {% endif %}

    <div class="bw-zero-feed-features" role="list" aria-label="{{ section.settings.feature_label | escape }}">
      {% for block in section.blocks %}
        {% if block.type == 'feature_point' %}
          <div
            class="bw-zero-feed-feature"
            role="listitem"
            style="
              --bw-zero-feed-feature-card-width: {{ block.settings.card_width | default: 100 }}%;
              --bw-zero-feed-feature-card-height: {{ block.settings.card_height | default: 70 }}px;
            "
            {{ block.shopify_attributes }}
          >
            <span class="bw-zero-feed-feature__icon" aria-hidden="true">
              {% if block.settings.icon_image != blank %}
                {{ block.settings.icon_image | image_url: width: 64 | image_tag: loading: 'lazy', widths: '32,48,64', sizes: '21px', alt: '' }}
              {% else %}
                {% case block.settings.icon %}
                  {% when 'control' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1"></path><circle cx="12" cy="12" r="4"></circle></svg>
                  {% when 'battery' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="18" rx="2"></rect><path d="M9 7h6M12 11v6M9 14h6"></path></svg>
                  {% when 'home' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m3 11 9-8 9 8"></path><path d="M5.5 10v10h13V10M9 20v-6h6v6"></path></svg>
                  {% else %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19V9M9 19V5M14 19v-7M19 19V3"></path></svg>
                {% endcase %}
              {% endif %}
            </span>
            <span><strong>{{ block.settings.title }}</strong>{% if block.settings.text != blank %}<small>{{ block.settings.text }}</small>{% endif %}</span>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="bw-accessory-grid" role="list" aria-label="{{ section.settings.accessory_label | escape }}">
      {% for block in section.blocks %}
        {% if block.type == 'accessory' %}
          {% liquid
            assign fallback_handle = 'ct002-smart-meter'
            assign fallback_title = 'CT002'
            assign fallback_subtitle = '3-Phasen Smart Meter für VENUS E'
            assign accessory_product = block.settings.product

            if block.settings.product_kind == 'ct003'
              assign fallback_handle = 'ct003-smart-meter'
              assign fallback_title = 'CT003'
              assign fallback_subtitle = 'P1 Smart Meter für VENUS E'
              if accessory_product == blank
                assign accessory_product = section_ct003
              endif
            elsif accessory_product == blank
              assign accessory_product = section_ct002
            endif

            if accessory_product == blank
              assign accessory_product = all_products[fallback_handle]
            endif

            assign accessory_variant = accessory_product.selected_or_first_available_variant
            assign accessory_image = accessory_variant.featured_image | default: accessory_product.featured_image
            assign accessory_title = block.settings.title | default: fallback_title
            assign accessory_subtitle = block.settings.subtitle
            if accessory_subtitle == blank and accessory_product != blank
              assign accessory_subtitle = accessory_product.title | remove_first: 'MARSTEK CT002 – ' | remove_first: 'MARSTEK CT002 - ' | remove_first: 'MARSTEK CT003 – ' | remove_first: 'MARSTEK CT003 - '
            endif
            if accessory_subtitle == blank
              assign accessory_subtitle = fallback_subtitle
            endif
            assign accessory_url = accessory_product.url
            if accessory_url == blank
              assign accessory_url = '/products/' | append: fallback_handle
            endif
          %}

          <article class="bw-accessory-card{% if accessory_image == blank %} bw-accessory-card--no-image{% endif %}" role="listitem" {{ block.shopify_attributes }}>
            {% if accessory_image != blank or request.design_mode %}
              <a class="bw-accessory-card__image" href="{{ accessory_url }}" aria-label="{{ accessory_title | escape }} Produktseite">
                {% if accessory_image != blank %}
                  {{ accessory_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120,180,240', sizes: '96px', alt: accessory_title }}
                {% else %}
                  <span class="bw-editor-placeholder">Produktbild auswählen</span>
                {% endif %}
              </a>
            {% endif %}

            <div class="bw-accessory-card__details">
              <h3><a href="{{ accessory_url }}">{{ accessory_title }}</a></h3>
              <p>{{ accessory_subtitle }}</p>
              {% if block.settings.badge != blank %}<span class="bw-accessory-card__badge">{{ block.settings.badge }}</span>{% endif %}
            </div>

            <div class="bw-accessory-card__purchase">
              {% if accessory_variant != blank %}
                <div class="bw-accessory-card__price">
                  <strong>{{ accessory_variant.price | money }}</strong>
                  {% if accessory_variant.compare_at_price > accessory_variant.price %}<s>{{ accessory_variant.compare_at_price | money }}</s>{% endif %}
                </div>
              {% endif %}
              {% if accessory_variant != blank and accessory_variant.available %}
                <a class="bw-accessory-card__button" href="{{ accessory_url }}">{{ block.settings.button_label }}</a>
              {% else %}
                <span class="bw-accessory-card__button is-disabled" aria-disabled="true">{{ section.settings.sold_out_label }}</span>
              {% endif %}
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>

    <div class="bw-zero-feed-services" role="list" aria-label="{{ section.settings.service_label | escape }}">
      {% for block in section.blocks %}
        {% if block.type == 'service_point' %}
          <div class="bw-zero-feed-service" role="listitem" {{ block.shopify_attributes }}>
            <span class="bw-zero-feed-service__icon" aria-hidden="true">
              {% if block.settings.icon_image != blank %}
                {{ block.settings.icon_image | image_url: width: 48 | image_tag: loading: 'lazy', widths: '24,36,48', sizes: '20px', alt: '' }}
              {% else %}
                {% case block.settings.icon %}
                  {% when 'return' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 7H5v-4"></path><path d="M5 7a8 8 0 1 1-1 8"></path><path d="m5 7 4-4"></path></svg>
                  {% when 'payment' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 10h18M7 15h3"></path></svg>
                  {% else %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h11v10H3zM14 9h4l3 3v4h-7zM6 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM18 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"></path></svg>
                {% endcase %}
              {% endif %}
            </span>
            <span>{{ block.settings.text }}</span>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "VENUS E · Nullfeed",
  "settings": [
    {"type":"text","id":"anchor_id","label":"Anker-ID","info":"Ohne # eingeben; die ID muss auf dieser Seite eindeutig sein.","default":"zero-feed"},
    {"type":"text","id":"heading","label":"Überschrift","default":"Keine Einspeisung ins Netz. Automatisch."},
    {"type":"textarea","id":"text","label":"Beschreibung","default":"Der Smart Meter erkennt deinen Verbrauch, VENUS E reagiert von selbst. Die CT-Sensoren (CT002 / CT003) erfassen jeden Lastfluss in Echtzeit. Innerhalb von unter 10 Millisekunden entscheidet VENUS E, ob Strom gespeichert, verbraucht oder – falls gewünscht – gar nicht ins Netz abgegeben wird. Keine komplizierte Konfiguration, kein Elektriker erforderlich."},
    {"type":"video","id":"flow_video","label":"Shopify-Video für Energiefluss","info":"Hat Vorrang vor GIF oder Bild."},
    {"type":"image_picker","id":"flow_image","label":"Großes Energieflussbild oder GIF"},
    {"type":"text","id":"flow_image_alt","label":"Alternativtext","default":"Smart Meter, VENUS E, Hausnetz, Speicher und Stromnetz im Energiefluss"},
    {"type":"range","id":"media_width","label":"Bildbreite","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"select","id":"media_alignment","label":"Bildausrichtung","default":"center","options":[{"value":"left","label":"Links"},{"value":"center","label":"Mitte"},{"value":"right","label":"Rechts"}]},
    {"type":"header","content":"Schriftgrößen"},
    {"type":"range","id":"heading_font_size","label":"Modultitel","min":20,"max":64,"step":1,"unit":"px","default":42},
    {"type":"range","id":"intro_font_size","label":"Modulbeschreibung","min":10,"max":28,"step":1,"unit":"px","default":16},
    {"type":"range","id":"feature_title_font_size","label":"Funktionskarten Titel","min":10,"max":24,"step":1,"unit":"px","default":12},
    {"type":"range","id":"feature_text_font_size","label":"Funktionskarten Beschreibung","min":8,"max":20,"step":1,"unit":"px","default":10},
    {"type":"range","id":"accessory_title_font_size","label":"Produktkarten Titel","min":10,"max":28,"step":1,"unit":"px","default":16},
    {"type":"range","id":"accessory_subtitle_font_size","label":"Produktkarten Beschreibung","min":8,"max":20,"step":1,"unit":"px","default":12},
    {"type":"range","id":"accessory_badge_font_size","label":"Produktkarten Badge","min":8,"max":18,"step":1,"unit":"px","default":10},
    {"type":"range","id":"accessory_price_font_size","label":"Produktkarten Preis","min":12,"max":36,"step":1,"unit":"px","default":19},
    {"type":"range","id":"accessory_compare_font_size","label":"Produktkarten Vergleichspreis","min":8,"max":20,"step":1,"unit":"px","default":12},
    {"type":"range","id":"accessory_button_font_size","label":"Produktkarten Button","min":9,"max":22,"step":1,"unit":"px","default":12},
    {"type":"range","id":"service_font_size","label":"Servicevorteile Text","min":8,"max":20,"step":1,"unit":"px","default":11},
    {"type":"text","id":"feature_label","label":"Bezeichnung der Funktionspunkte","default":"Funktionen der automatischen Steuerung"},
    {"type":"text","id":"accessory_label","label":"Bezeichnung der Zubehörliste","default":"Passende Smart Meter"},
    {"type":"text","id":"service_label","label":"Bezeichnung der Servicevorteile","default":"Servicevorteile"},
    {"type":"product","id":"product_ct002","label":"CT002 Standardprodukt"},
    {"type":"product","id":"product_ct003","label":"CT003 Standardprodukt"},
    {"type":"text","id":"sold_out_label","label":"Text bei Nichtverfügbarkeit","default":"Nicht verfügbar"}
  ],
  "blocks": [
    {
      "type":"feature_point",
      "name":"Funktionspunkt",
      "limit":4,
      "settings":[
        {"type":"select","id":"icon","label":"Standardsymbol","default":"measure","options":[{"value":"measure","label":"Messen"},{"value":"control","label":"Steuern"},{"value":"battery","label":"Speichern"},{"value":"home","label":"Versorgen"}]},
        {"type":"image_picker","id":"icon_image","label":"Eigenes Symbol (optional)"},
        {"type":"text","id":"title","label":"Titel","default":"Messen"},
        {"type":"text","id":"text","label":"Beschreibung","default":"Verbrauch in Echtzeit erfassen"},
        {"type":"range","id":"card_width","label":"Kartenbreite (Anteil der Spaltenbreite)","min":60,"max":100,"step":5,"unit":"%","default":100},
        {"type":"range","id":"card_height","label":"Kartenhöhe (Mindesthöhe)","min":44,"max":180,"step":2,"unit":"px","default":70}
      ]
    },
    {
      "type":"accessory",
      "name":"Smart-Meter-Karte",
      "limit":2,
      "settings":[
        {"type":"select","id":"product_kind","label":"Fallback-Produkt","options":[{"value":"ct002","label":"CT002"},{"value":"ct003","label":"CT003"}],"default":"ct002"},
        {"type":"product","id":"product","label":"Abweichendes Produkt (optional)"},
        {"type":"text","id":"title","label":"Kurztitel"},
        {"type":"text","id":"subtitle","label":"Beschreibung"},
        {"type":"text","id":"badge","label":"Badge","default":"Plug & Play"},
        {"type":"text","id":"button_label","label":"Button","default":"Auswählen"}
      ]
    },
    {
      "type":"service_point",
      "name":"Servicevorteil",
      "limit":3,
      "settings":[
        {"type":"select","id":"icon","label":"Standardsymbol","default":"shipping","options":[{"value":"shipping","label":"Versand"},{"value":"return","label":"Rückgabe"},{"value":"payment","label":"Bezahlung"}]},
        {"type":"image_picker","id":"icon_image","label":"Eigenes Symbol (optional)"},
        {"type":"text","id":"text","label":"Text","default":"Schneller Versand"}
      ]
    }
  ],
  "max_blocks":9,
  "presets":[
    {
      "name":"VENUS E · Nullfeed",
      "blocks":[
        {"type":"feature_point","settings":{"icon":"measure","title":"Messen","text":"Verbrauch in Echtzeit erfassen"}},
        {"type":"feature_point","settings":{"icon":"control","title":"Steuern","text":"VENUS E regelt automatisch"}},
        {"type":"feature_point","settings":{"icon":"battery","title":"Speichern","text":"Überschüsse intelligent nutzen"}},
        {"type":"feature_point","settings":{"icon":"home","title":"Versorgen","text":"Dein Zuhause zuerst"}},
        {"type":"accessory","settings":{"product_kind":"ct002","title":"CT002"}},
        {"type":"accessory","settings":{"product_kind":"ct003","title":"CT003"}},
        {"type":"service_point","settings":{"icon":"shipping","text":"Schneller Versand"}},
        {"type":"service_point","settings":{"icon":"return","text":"30 Tage Rückgaberecht"}},
        {"type":"service_point","settings":{"icon":"payment","text":"Sichere Bezahlung"}}
      ]
    }
  ]
}
{% endschema %}
