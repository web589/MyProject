{%- liquid
  assign download_center_id = 'download-center-' | append: section.id
  assign download_center_hero_class = download_center_id | append: '__hero-image'
  assign download_categories = 'storage,accessories' | split: ','
-%}

{%- style -%}
  .{{ download_center_id }} {
    --download-blue: #0099fe;
    --download-blue-soft: #e8f4ff;
    --download-purple: #7a3ff2;
    --download-purple-soft: #f1ecfd;
    --download-ink: #0e1b2c;
    --download-gray: #5b6b7c;
    --download-muted: #8a97a6;
    --download-border: #e3e8ee;
    --download-line: #edf0f4;
    --download-heading-size: {{ section.settings.heading_size | default: 52 }}px;
    --download-body-size: {{ section.settings.body_size | default: 16 }}px;
    --download-eyebrow-size: {{ section.settings.eyebrow_size | default: 14 }}px;
    --download-category-heading-size: {{ section.settings.category_heading_size | default: 24 }}px;
    --download-card-title-size: {{ section.settings.card_title_size | default: 17 }}px;
    --download-card-text-size: {{ section.settings.card_text_size | default: 13 }}px;
    --download-control-size: {{ section.settings.control_size | default: 14 }}px;
    --download-note-size: {{ section.settings.note_size | default: 12 }}px;
    --download-section-spacing: {{ section.settings.section_spacing | default: 72 }}px;
    --download-hero-height: {{ section.settings.hero_image_height | default: 360 }}px;
    --download-hero-width: {{ section.settings.hero_image_width | default: 100 }}%;
    --download-card-image-height: {{ section.settings.card_image_height | default: 170 }}px;
    --download-card-image-width: {{ section.settings.card_image_width | default: 100 }}%;
    color: var(--download-ink);
    padding: 0 0 var(--download-section-spacing, 72px);
  }

  .{{ download_center_id }}__hero {
    width: min(1520px, var(--download-hero-width, 100%));
    height: clamp(180px, 23.684vw, var(--download-hero-height, 360px));
    margin: 0 auto var(--download-section-spacing, 72px);
  }

  .{{ download_center_id }}__hero-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .{{ download_center_id }}__container {
    width: calc(100% - 48px);
    max-width: 1440px;
    margin: 0 auto;
  }

  .{{ download_center_id }}__intro {
    padding-bottom: 38px;
    border-bottom: 1px solid var(--download-line);
  }

  .{{ download_center_id }}__eyebrow {
    margin: 0 0 12px;
    color: var(--download-blue);
    font-size: var(--download-eyebrow-size, 14px);
    font-weight: 700;
    letter-spacing: .02em;
  }

  .{{ download_center_id }}__title {
    margin: 0;
    color: var(--download-ink);
    font-size: clamp(32px, 4vw, var(--download-heading-size, 52px));
    font-weight: 600;
    line-height: 1.15;
  }

  .{{ download_center_id }}__description {
    max-width: 1200px;
    margin: 18px 0 0;
    color: var(--download-gray);
    font-size: var(--download-body-size, 16px);
    line-height: 1.65;
  }

  .{{ download_center_id }}__category {
    margin-top: 62px;
  }

  .{{ download_center_id }}__category-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 22px;
  }

  .{{ download_center_id }}__category-title {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin: 0;
    color: var(--download-ink);
    font-size: var(--download-category-heading-size, 24px);
    font-weight: 600;
    line-height: 1.25;
  }

  .{{ download_center_id }}__category-number {
    color: var(--download-blue);
    font-size: var(--download-eyebrow-size, 14px);
    font-weight: 700;
  }

  .{{ download_center_id }}__category-meta {
    margin: 0;
    color: var(--download-muted);
    font-size: var(--download-note-size, 13px);
  }

  .{{ download_center_id }}__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .{{ download_center_id }}__card {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 26px;
    min-width: 0;
    padding: 26px 28px;
    background: #fff;
    border: 1px solid var(--download-border);
    border-radius: 10px;
    transition: border-color .15s ease, box-shadow .15s ease;
  }

  .{{ download_center_id }}__card:hover {
    border-color: #bfd9f2;
    box-shadow: 0 8px 24px rgba(14, 27, 44, .04);
  }

  .{{ download_center_id }}__product {
    min-width: 0;
  }

  .{{ download_center_id }}__image {
    display: flex;
    align-items: center;
    justify-content: center;
    width: min(200px, var(--download-card-image-width, 100%));
    height: var(--download-card-image-height, 170px);
    margin-inline: auto;
    overflow: hidden;
    background: #fff !important;
    border-radius: 8px;
  }

  .{{ download_center_id }}__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background-color: #fff !important;
  }

  .{{ download_center_id }}__product-name {
    margin: 14px 0 0;
    color: var(--download-ink);
    font-size: var(--download-card-title-size, 17px);
    font-weight: 600;
    line-height: 1.35;
  }

  .{{ download_center_id }}__spec,
  .{{ download_center_id }}__tagline {
    margin: 4px 0 0;
    color: var(--download-gray);
    font-size: var(--download-card-text-size, 12.5px);
    line-height: 1.55;
  }

  .{{ download_center_id }}__badge {
    display: inline-block;
    margin-top: 10px;
    padding: 3px 9px;
    color: var(--download-blue);
    background: var(--download-blue-soft);
    border-radius: 3px;
    font-size: var(--download-control-size, 11px);
    font-weight: 600;
  }

  .{{ download_center_id }}__documents {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .{{ download_center_id }}__document {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 60px;
    padding: 13px 0;
    border-top: 1px solid var(--download-line);
  }

  .{{ download_center_id }}__document:first-child {
    border-top: 0;
  }

  .{{ download_center_id }}__type {
    flex: 0 0 auto;
    min-width: 52px;
    padding: 3px 8px;
    color: var(--download-blue);
    background: var(--download-blue-soft);
    border-radius: 3px;
    font-size: var(--download-control-size, 11px);
    font-weight: 600;
    text-align: center;
  }

  .{{ download_center_id }}__type--video {
    color: var(--download-purple);
    background: var(--download-purple-soft);
  }

  .{{ download_center_id }}__document-title {
    min-width: 0;
    color: var(--download-ink);
    font-size: var(--download-card-text-size, 14px);
    font-weight: 500;
    line-height: 1.4;
  }

  .{{ download_center_id }}__language {
    margin-left: 8px;
    color: var(--download-gray);
    font-size: var(--download-note-size, 12px);
    white-space: nowrap;
  }

  .{{ download_center_id }}__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 34px;
    width: 34px;
    height: 34px;
    margin-left: auto;
    color: var(--download-blue);
    background: var(--download-blue-soft);
    border-radius: 8px;
    text-decoration: none;
    transition: background-color .15s ease, color .15s ease;
  }

  .{{ download_center_id }}__link:hover,
  .{{ download_center_id }}__link:focus-visible {
    color: #fff;
    background: var(--download-blue);
  }

  .{{ download_center_id }}__link:focus-visible {
    outline: 2px solid var(--download-blue);
    outline-offset: 3px;
  }

  .{{ download_center_id }}__link svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media screen and (max-width: 990px) {
    .{{ download_center_id }}__grid {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 600px) {
    .{{ download_center_id }} {
      padding-bottom: 48px;
    }

    .{{ download_center_id }}__hero {
      margin-bottom: 44px;
    }

    .{{ download_center_id }}__container {
      width: calc(100% - 32px);
    }

    .{{ download_center_id }}__intro {
      padding-bottom: 28px;
    }

    .{{ download_center_id }}__category {
      margin-top: 44px;
    }

    .{{ download_center_id }}__category-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 6px;
      margin-bottom: 16px;
    }

    .{{ download_center_id }}__category-title {
      font-size: min(var(--download-category-heading-size, 24px), 21px);
    }

    .{{ download_center_id }}__card {
      grid-template-columns: 1fr;
      gap: 20px;
      padding: 20px;
    }

    .{{ download_center_id }}__image {
      width: min(100%, var(--download-card-image-width, 100%));
      height: var(--download-card-image-height, 170px);
    }

    .{{ download_center_id }}__document {
      gap: 10px;
    }

    .{{ download_center_id }}__document-title {
      font-size: var(--download-card-text-size, 13px);
    }

    .{{ download_center_id }}__language {
      display: inline-block;
      margin-left: 4px;
    }
  }
{%- endstyle -%}

<section class="{{ download_center_id }}" aria-labelledby="{{ download_center_id }}-title">
  {%- if section.settings.hero_image != blank -%}
    <div class="{{ download_center_id }}__hero">
      {{
        section.settings.hero_image
        | image_url: width: 1520
        | image_tag:
          class: download_center_hero_class,
          loading: 'eager',
          widths: '640, 960, 1280, 1520',
          sizes: '100vw',
          alt: section.settings.hero_alt
      }}
    </div>
  {%- endif -%}

  <div class="{{ download_center_id }}__container">
    <header class="{{ download_center_id }}__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="{{ download_center_id }}__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 id="{{ download_center_id }}-title" class="{{ download_center_id }}__title">{{ section.settings.title | escape }}</h1>
      {%- if section.settings.description != blank -%}
        <p class="{{ download_center_id }}__description">{{ section.settings.description | escape }}</p>
      {%- endif -%}
    </header>

    {%- for category in download_categories -%}
      {%- assign category_block_count = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.category == category -%}
          {%- assign category_block_count = category_block_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if category_block_count > 0 -%}
        {%- if category == 'storage' -%}
          {%- assign category_number = '01' -%}
          {%- assign category_title = section.settings.storage_heading -%}
          {%- assign category_meta = category_block_count | append: ' Modelle' -%}
        {%- else -%}
          {%- assign category_number = '02' -%}
          {%- assign category_title = section.settings.accessories_heading -%}
          {%- assign category_meta = category_block_count | append: ' Artikel' -%}
        {%- endif -%}

        <section class="{{ download_center_id }}__category" aria-labelledby="{{ download_center_id }}-{{ category }}-title">
          <div class="{{ download_center_id }}__category-heading">
            <h2 id="{{ download_center_id }}-{{ category }}-title" class="{{ download_center_id }}__category-title">
              <span class="{{ download_center_id }}__category-number">{{ category_number }}</span>
              <span>{{ category_title | escape }}</span>
            </h2>
            <p class="{{ download_center_id }}__category-meta">{{ category_meta }}</p>
          </div>

          <div class="{{ download_center_id }}__grid">
            {%- for block in section.blocks -%}
              {%- if block.settings.category != category -%}
                {%- continue -%}
              {%- endif -%}
              {%- assign product = block.settings.product -%}
              {%- assign card_title = block.settings.title | default: product.title -%}
              {%- assign card_image = block.settings.image | default: product.featured_image -%}
              {%- assign document_count = 0 -%}
              {%- for document_index in (1..8) -%}
                {%- assign document_url_key = 'file_' | append: document_index | append: '_url' -%}
                {%- if block.settings[document_url_key] != blank -%}
                  {%- assign document_count = document_count | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}

              <article class="{{ download_center_id }}__card" {{ block.shopify_attributes }}>
                <div class="{{ download_center_id }}__product">
                  {%- if card_image != blank -%}
                    <div class="{{ download_center_id }}__image">
                      {{
                        card_image
                        | image_url: width: 800
                        | image_tag:
                          loading: 'lazy',
                          widths: '240, 360, 480, 640, 800',
                          sizes: '(max-width: 600px) calc(100vw - 72px), 200px',
                          alt: card_title
                      }}
                    </div>
                  {%- endif -%}
                  {%- if card_title != blank -%}<h3 class="{{ download_center_id }}__product-name">{{ card_title | escape }}</h3>{%- endif -%}
                  {%- if block.settings.spec != blank -%}<p class="{{ download_center_id }}__spec">{{ block.settings.spec | escape }}</p>{%- endif -%}
                  {%- if block.settings.tagline != blank -%}<p class="{{ download_center_id }}__tagline">{{ block.settings.tagline | escape }}</p>{%- endif -%}
                  {%- if block.settings.badge != blank -%}<span class="{{ download_center_id }}__badge">{{ block.settings.badge | escape }}</span>{%- endif -%}
                </div>

                {%- if document_count > 0 -%}
                  <div class="{{ download_center_id }}__documents">
                    {%- for document_index in (1..8) -%}
                      {%- assign document_url_key = 'file_' | append: document_index | append: '_url' -%}
                      {%- assign document_type_key = 'file_' | append: document_index | append: '_type' -%}
                      {%- assign document_title_key = 'file_' | append: document_index | append: '_title' -%}
                      {%- assign document_language_key = 'file_' | append: document_index | append: '_language' -%}
                      {%- assign document_url = block.settings[document_url_key] -%}
                      {%- if document_url == blank -%}{%- continue -%}{%- endif -%}
                      {%- assign document_type = block.settings[document_type_key] -%}
                      {%- assign document_label = 'PDF' -%}
                      {%- if document_type == 'video' -%}{%- assign document_label = 'VIDEO' -%}{%- endif -%}
                      {%- assign document_title = block.settings[document_title_key] | default: document_label -%}
                      {%- assign document_language = block.settings[document_language_key] -%}
                      <div class="{{ download_center_id }}__document">
                        <span class="{{ download_center_id }}__type{% if document_type == 'video' %} {{ download_center_id }}__type--video{% endif %}">{{ document_label }}</span>
                        <span class="{{ download_center_id }}__document-title">
                          {{ document_title | escape }}{% if document_language != blank %}<span class="{{ download_center_id }}__language">{{ document_language | escape }}</span>{% endif %}
                        </span>
                        <a class="{{ download_center_id }}__link" href="{{ document_url | escape }}"{% if document_type == 'video' %} target="_blank" rel="noopener noreferrer"{% else %} download{% endif %} aria-label="{{ document_title | escape }}{% if document_language != blank %} {{ document_language | escape }}{% endif %} {{ document_label | escape }}">
                          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14" /></svg>
                        </a>
                      </div>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              </article>
            {%- endfor -%}
          </div>
        </section>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Download-Center",
  "tag": "section",
  "class": "section-download-center",
  "settings": [
    {"type":"image_picker","id":"hero_image","label":"主视觉图片"},
    {"type":"text","id":"hero_alt","label":"主视觉替代文字","default":"VENUS E Download-Center"},
    {"type":"text","id":"eyebrow","label":"眉题","default":"Support & Ressourcen"},
    {"type":"text","id":"title","label":"标题","default":"Download-Center"},
    {"type":"textarea","id":"description","label":"说明","default":"Hier findest du alle Broschüren, Datenblätter, Bedienungs- und Installationsanleitungen für deinen VENUS E Speicher – als PDF zum Download bereit."},
    {"type":"text","id":"storage_heading","label":"储能标题","default":"VENUS E Speicher"},
    {"type":"text","id":"accessories_heading","label":"配件标题","default":"Zubehör & Smart Meter"},
    {"type":"header","content":"Typography"},
    {"type":"range","id":"eyebrow_size","label":"眉题大小","min":10,"max":18,"step":1,"unit":"px","default":14},
    {"type":"range","id":"heading_size","label":"标题大小","min":32,"max":72,"step":1,"unit":"px","default":52},
    {"type":"range","id":"body_size","label":"正文大小","min":12,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"category_heading_size","label":"分类标题大小","min":18,"max":36,"step":1,"unit":"px","default":24},
    {"type":"range","id":"card_title_size","label":"卡片标题大小","min":14,"max":24,"step":1,"unit":"px","default":17},
    {"type":"range","id":"card_text_size","label":"卡片文本大小","min":11,"max":20,"step":1,"unit":"px","default":13},
    {"type":"range","id":"control_size","label":"控件大小","min":10,"max":18,"step":1,"unit":"px","default":11},
    {"type":"range","id":"note_size","label":"备注大小","min":10,"max":16,"step":1,"unit":"px","default":12},
    {"type":"header","content":"Layout und Größen"},
    {"type":"range","id":"section_spacing","label":"区块间距","min":40,"max":120,"step":4,"unit":"px","default":72},
    {"type":"range","id":"hero_image_height","label":"主视觉图片高度","min":180,"max":520,"step":10,"unit":"px","default":360},
    {"type":"range","id":"hero_image_width","label":"主视觉图片宽度","min":60,"max":100,"step":1,"unit":"%","default":100},
    {"type":"range","id":"card_image_height","label":"卡片图片高度","min":120,"max":280,"step":10,"unit":"px","default":170},
    {"type":"range","id":"card_image_width","label":"卡片图片宽度","min":60,"max":100,"step":1,"unit":"%","default":100}
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product download card",
      "limit": 6,
      "settings": [
        {"type":"select","id":"category","label":"分类","default":"storage","options":[{"value":"storage","label":"VENUS E Speicher"},{"value":"accessories","label":"Zubehör & Smart Meter"}]},
        {"type":"product","id":"product","label":"产品"},
        {"type":"image_picker","id":"image","label":"图片"},
        {"type":"text","id":"title","label":"标题"},
        {"type":"text","id":"spec","label":"规格"},
        {"type":"text","id":"tagline","label":"短语"},
        {"type":"text","id":"badge","label":"徽标","default":"Plug-in ESS"},
        {"type":"header","content":"Document 1"},
        {"type":"select","id":"file_1_type","label":"文件1类型","default":"pdf","options":[{"value":"pdf","label":"PDF"},{"value":"video","label":"Video"}]},
        {"type":"text","id":"file_1_title","label":"文件1标题"},
        {"type":"text","id":"file_1_language","label":"文件1语言"},
        {"type":"url","id":"file_1_url","label":"文件1链接地址"},
        {"type":"header","content":"Document 2"},
        {"type":"select","id":"file_2_type","label":"文件2类型","default":"pdf","options":[{"value":"pdf","label":"PDF"},{"value":"video","label":"Video"}]},
        {"type":"text","id":"file_2_title","label":"文件2标题"},
        {"type":"text","id":"file_2_language","label":"文件2语言"},
        {"type":"url","id":"file_2_url","label":"文件2链接地址"},
        {"type":"header","content":"Document 3"},
        {"type":"select","id":"file_3_type","label":"文件3类型","default":"pdf","options":[{"value":"pdf","label":"PDF"},{"value":"video","label":"Video"}]},
        {"type":"text","id":"file_3_title","label":"文件3标题"},
        {"type":"text","id":"file_3_language","label":"文件3语言"},
        {"type":"url","id":"file_3_url","label":"文件3链接地址"},
        {"type":"header","content":"Document 4"},
        {"type":"select","id":"file_4_type","label":"文件4类型","default":"pdf","options":[{"value":"pdf","label":"PDF"},{"value":"video","label":"Video"}]},
        {"type":"text","id":"file_4_title","label":"文件4标题"},
        {"type":"text","id":"file_4_language","label":"文件4语言"},
        {"type":"url","id":"file_4_url","label":"文件4链接地址"},
        {"type":"header","content":"Document 5"},
        {"type":"select","id":"file_5_type","label":"文件5类型","default":"pdf","options":[{"value":"pdf","label":"PDF"},{"value":"video","label":"Video"}]},
        {"type":"text","id":"file_5_title","label":"文件5标题"},
        {"type":"text","id":"file_5_language","label":"文件5语言"},
        {"type":"url","id":"file_5_url","label":"文件5链接地址"},
        {"type":"header","content":"Document 6"},
        {"type":"select","id":"file_6_type","label":"文件6类型","default":"pdf","options":[{"value":"pdf","label":"PDF"},{"value":"video","label":"Video"}]},
        {"type":"text","id":"file_6_title","label":"文件6标题"},
        {"type":"text","id":"file_6_language","label":"文件6语言"},
        {"type":"url","id":"file_6_url","label":"文件6链接地址"},
        {"type":"header","content":"Document 7"},
        {"type":"select","id":"file_7_type","label":"文件7类型","default":"pdf","options":[{"value":"pdf","label":"PDF"},{"value":"video","label":"Video"}]},
        {"type":"text","id":"file_7_title","label":"文件7标题"},
        {"type":"text","id":"file_7_language","label":"文件7语言"},
        {"type":"url","id":"file_7_url","label":"文件7链接地址"},
        {"type":"header","content":"Document 8"},
        {"type":"select","id":"file_8_type","label":"文件8类型","default":"pdf","options":[{"value":"pdf","label":"PDF"},{"value":"video","label":"Video"}]},
        {"type":"text","id":"file_8_title","label":"文件8标题"},
        {"type":"text","id":"file_8_language","label":"文件8语言"},
        {"type":"url","id":"file_8_url","label":"文件8链接地址"}
      ]
    }
  ],
  "presets": [{"name":"Download-Center"}]
}
{% endschema %}
