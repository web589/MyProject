{% liquid
  assign page_id = 'eauto-' | append: section.id
%}

<section id="eauto-benefits" class="e-auto-page e-auto-page__section e-auto-page__benefits" style="--eauto-heading-size: {{ section.settings.heading_size }}px; --eauto-copy-size: {{ section.settings.copy_size }}px; --eauto-section-space: {{ section.settings.section_spacing }}px;" aria-labelledby="{{ page_id }}-benefits-heading">
  <div class="e-auto-page__container">
    <div class="e-auto-page__section-heading">
      <p class="e-auto-page__eyebrow">{{ section.settings.benefits_eyebrow }}</p>
      <h2 id="{{ page_id }}-benefits-heading">{{ section.settings.benefits_heading }}{% if section.settings.benefits_heading_accent != blank %} <span>{{ section.settings.benefits_heading_accent }}</span>{% endif %}</h2>
      <p>{{ section.settings.benefits_text }}</p>
    </div>
    <div class="e-auto-page__benefits-grid">
      {% for block in section.blocks %}
        <article {{ block.shopify_attributes }}><strong>{{ block.settings.value }}{% if block.settings.value_accent != blank %} <span>{{ block.settings.value_accent }}</span>{% endif %}</strong><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></article>
      {% endfor %}
    </div>
    {% if section.settings.benefits_note != blank %}
      <p class="e-auto-page__note">{{ section.settings.benefits_note }}</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "E-Auto 使用收益",
  "tag": "section",
  "class": "section-e-auto-benefits",
  "settings": [
    {"type":"text","id":"benefits_eyebrow","label":"收益区小标题","default":"Dein Nutzen"},
    {"type":"text","id":"benefits_heading","label":"收益区标题（主体）","default":"Was der Speicher beim Laden"},
    {"type":"text","id":"benefits_heading_accent","label":"收益区标题（蓝色强调）","default":"wirklich bringt"},
    {"type":"textarea","id":"benefits_text","label":"收益区说明","default":"Solarstrom wird zeitlich verschoben und steht dann zur Verfügung, wenn Haushalt und E-Auto ihn brauchen."},
    {"type":"textarea","id":"benefits_note","label":"收益区脚注","default":"* Orientierungswerte, abhängig von Anlagengröße, Verbrauchsprofil und Speicherkapazität."},
    {"type":"header","content":"布局与尺寸"},
    {"type":"range","id":"heading_size","label":"标题字号","min":28,"max":60,"step":1,"unit":"px","default":42},
    {"type":"range","id":"copy_size","label":"文案字号","min":13,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"section_spacing","label":"区块上下间距","min":40,"max":140,"step":4,"unit":"px","default":72}
  ],
  "blocks": [
    {"type":"benefit","name":"收益项","settings":[{"type":"text","id":"value","label":"数值","default":"24"},{"type":"text","id":"value_accent","label":"数值强调"},{"type":"text","id":"title","label":"标题","default":"Solarstrom später nutzen"},{"type":"textarea","id":"text","label":"文案","default":"Tagsüber produziert, abends geladen – der Speicher verschiebt Solarstrom in den passenden Moment."}]}
  ],
  "max_blocks": 3,
  "presets": [{"name":"E-Auto 使用收益","blocks":[{"type":"benefit"},{"type":"benefit"},{"type":"benefit"}] }]
}
{% endschema %}
