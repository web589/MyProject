{% liquid
  assign page_id = 'eauto-' | append: section.id
%}

<section id="eauto-benefits" class="e-auto-page e-auto-page__section e-auto-page__benefits" style="--eauto-heading-size: {{ section.settings.heading_size }}px; --eauto-copy-size: {{ section.settings.copy_size }}px; --eauto-eyebrow-size: {{ section.settings.eyebrow_size | default: 11 }}px; --eauto-item-heading-size: {{ section.settings.item_heading_size | default: 13 }}px; --eauto-item-text-size: {{ section.settings.item_text_size | default: 12 }}px; --eauto-control-size: {{ section.settings.control_size | default: 12 }}px; --eauto-value-size: {{ section.settings.value_size | default: 34 }}px; --eauto-note-size: {{ section.settings.note_size | default: 10 }}px; --eauto-section-space: {{ section.settings.section_spacing }}px;" aria-labelledby="{{ page_id }}-benefits-heading">
  <div class="e-auto-page__container">
    <div class="e-auto-page__section-heading">
      <p class="e-auto-page__eyebrow">{{ section.settings.benefits_eyebrow }}</p>
      <h2 id="{{ page_id }}-benefits-heading">{{ section.settings.benefits_heading }}{% if section.settings.benefits_heading_accent != blank %} <span>{{ section.settings.benefits_heading_accent }}</span>{% endif %}</h2>
      <p>{{ section.settings.benefits_text }}</p>
    </div>
    <div class="e-auto-page__benefits-grid">
      {% for block in section.blocks %}
        <article {{ block.shopify_attributes }}><strong>{% if block.settings.value_prefix != blank %}<span>{{ block.settings.value_prefix }}</span>{% endif %}{{ block.settings.value }}{% if block.settings.value_accent != blank %} <span>{{ block.settings.value_accent }}</span>{% endif %}{% if block.settings.value_suffix != blank %}{{ block.settings.value_suffix }}{% endif %}</strong><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></article>
      {% endfor %}
    </div>
    {% if section.settings.benefits_note != blank %}
      <p class="e-auto-page__note">{{ section.settings.benefits_note }}</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "E-Auto Vorteile",
  "tag": "section",
  "class": "section-e-auto-benefits",
  "settings": [
    {"type":"text","id":"benefits_eyebrow","label":"优势眉题","default":"Dein Nutzen"},
    {"type":"text","id":"benefits_heading","label":"优势标题","default":"Was der Speicher beim Laden"},
    {"type":"text","id":"benefits_heading_accent","label":"优势标题强调部分","default":"wirklich bringt"},
    {"type":"textarea","id":"benefits_text","label":"优势文本","default":""},
    {"type":"textarea","id":"benefits_note","label":"优势备注","default":"* Orientierungswerte, abhängig von Anlagengröße, Verbrauchsprofil und Speicherkapazität."},
    {"type":"header","content":"Typography"},
    {"type":"range","id":"eyebrow_size","label":"眉题大小","min":9,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"item_heading_size","label":"项目标题大小","min":12,"max":26,"step":0.5,"unit":"px","default":18},
    {"type":"range","id":"item_text_size","label":"项目文本大小","min":10,"max":20,"step":0.5,"unit":"px","default":13.5},
    {"type":"range","id":"control_size","label":"控件大小","min":11,"max":18,"step":1,"unit":"px","default":12},
    {"type":"range","id":"value_size","label":"数值大小","min":20,"max":64,"step":1,"unit":"px","default":64},
    {"type":"range","id":"note_size","label":"备注大小","min":10,"max":16,"step":0.5,"unit":"px","default":12.5},
    {"type":"header","content":"Layout und Größen"},
    {"type":"range","id":"heading_size","label":"标题大小","min":28,"max":60,"step":1,"unit":"px","default":40},
    {"type":"range","id":"copy_size","label":"文案大小","min":13,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"section_spacing","label":"区块间距","min":40,"max":140,"step":4,"unit":"px","default":68}
  ],
  "blocks": [
    {"type":"benefit","name":"Vorteil","settings":[{"type":"text","id":"value_prefix","label":"数值前缀（蓝色）"},{"type":"text","id":"value","label":"数值","default":"24"},{"type":"text","id":"value_accent","label":"数值强调部分（蓝色）"},{"type":"text","id":"value_suffix","label":"数值后缀"},{"type":"text","id":"title","label":"标题","default":"Solarstrom später nutzen"},{"type":"textarea","id":"text","label":"文本","default":"Tagsüber produziert, abends geladen – der Speicher verschiebt Solarstrom in den passenden Moment."}]}
  ],
  "max_blocks": 3,
  "presets": [{"name":"E-Auto Vorteile","blocks":[{"type":"benefit"},{"type":"benefit"},{"type":"benefit"}] }]
}
{% endschema %}
