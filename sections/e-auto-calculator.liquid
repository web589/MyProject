{% liquid
  assign page_id = 'eauto-' | append: section.id
  assign result_button_target = section.settings.result_button_target | default: 'eauto-recommendations' | remove_first: '#' | handle | prepend: '#'
  assign distance_heading_parts = section.settings.distance_heading | split: '?'
  assign efficiency_heading_parts = section.settings.efficiency_heading | split: '?'
  assign pv_heading_parts = section.settings.pv_heading | split: '?'
  assign charge_heading_parts = section.settings.charge_heading | split: '?'
%}

<section id="eauto-calculator" class="e-auto-page e-auto-page__section e-auto-page__calculator-section" style="--eauto-heading-size: {{ section.settings.heading_size }}px; --eauto-copy-size: {{ section.settings.copy_size }}px; --eauto-eyebrow-size: {{ section.settings.eyebrow_size | default: 11 }}px; --eauto-item-heading-size: {{ section.settings.item_heading_size | default: 16 }}px; --eauto-item-text-size: {{ section.settings.item_text_size | default: 11 }}px; --eauto-control-size: {{ section.settings.control_size | default: 12 }}px; --eauto-value-size: {{ section.settings.value_size | default: 58 }}px; --eauto-note-size: {{ section.settings.note_size | default: 11 }}px; --eauto-section-space: {{ section.settings.section_spacing }}px;" aria-labelledby="{{ page_id }}-calculator-heading">
  <div class="e-auto-page__container">
    <div class="e-auto-page__section-heading">
      <p class="e-auto-page__eyebrow">{{ section.settings.calculator_eyebrow }}</p>
      <h2 id="{{ page_id }}-calculator-heading">{{ section.settings.calculator_heading }}{% if section.settings.calculator_heading_accent != blank %} <span>{{ section.settings.calculator_heading_accent }}</span>{% endif %}</h2>
      <p>{{ section.settings.calculator_text }}</p>
    </div>
    <div
      class="e-auto-page__calculator"
      data-eauto-calculator
      data-eauto-result-model-template="{{ section.settings.result_model_template | escape }}"
      data-eauto-result-copy-template="{{ section.settings.result_copy_template | escape }}"
      data-eauto-capacity-unit="{{ section.settings.capacity_unit_label | escape }}"
    >
      <div class="e-auto-page__calculator-steps">
        <div class="e-auto-page__calculator-step">
          <span class="e-auto-page__step-number">01</span>
          <h3>{% if distance_heading_parts.size > 1 %}{{ distance_heading_parts[0] }}? <span class="e-auto-page__calculator-detail">{{ distance_heading_parts[1] | strip }}</span>{% else %}{{ section.settings.distance_heading }}{% endif %}</h3>
          <div class="e-auto-page__option-grid" data-eauto-option-group="distance">
            <button type="button" class="is-active" data-eauto-option data-eauto-value="under20" aria-pressed="true">{{ section.settings.distance_option_under20_label }}</button>
            <button type="button" data-eauto-option data-eauto-value="20to40" aria-pressed="false">{{ section.settings.distance_option_20to40_label }}</button>
            <button type="button" data-eauto-option data-eauto-value="40to80" aria-pressed="false">{{ section.settings.distance_option_40to80_label }}</button>
            <button type="button" data-eauto-option data-eauto-value="over80" aria-pressed="false">{{ section.settings.distance_option_over80_label }}</button>
          </div>
        </div>
        <div class="e-auto-page__calculator-step">
          <span class="e-auto-page__step-number">02</span>
          <h3>{% if efficiency_heading_parts.size > 1 %}{{ efficiency_heading_parts[0] }}? <span class="e-auto-page__calculator-detail">{{ efficiency_heading_parts[1] | strip }}</span>{% else %}{{ section.settings.efficiency_heading }}{% endif %}</h3>
          <div class="e-auto-page__option-grid" data-eauto-option-group="efficiency">
            <button type="button" class="is-active" data-eauto-option data-eauto-value="efficient" aria-pressed="true">{{ section.settings.efficiency_option_efficient_label }}{% if section.settings.efficiency_option_efficient_note != blank %} <small>({{ section.settings.efficiency_option_efficient_note }})</small>{% endif %}</button>
            <button type="button" data-eauto-option data-eauto-value="average" aria-pressed="false">{{ section.settings.efficiency_option_average_label }}{% if section.settings.efficiency_option_average_note != blank %} <small>({{ section.settings.efficiency_option_average_note }})</small>{% endif %}</button>
            <button type="button" data-eauto-option data-eauto-value="high" aria-pressed="false">{{ section.settings.efficiency_option_high_label }}{% if section.settings.efficiency_option_high_note != blank %} <small>({{ section.settings.efficiency_option_high_note }})</small>{% endif %}</button>
          </div>
        </div>
        <div class="e-auto-page__calculator-step">
          <span class="e-auto-page__step-number">03</span>
          <h3>{% if pv_heading_parts.size > 1 %}{{ pv_heading_parts[0] }}? <span class="e-auto-page__calculator-detail">{{ pv_heading_parts[1] | strip }}</span>{% else %}{{ section.settings.pv_heading }}{% endif %}</h3>
          <div class="e-auto-page__option-grid" data-eauto-option-group="pv">
            <button type="button" data-eauto-option data-eauto-value="low" aria-pressed="false">{{ section.settings.pv_option_low_label }}</button>
            <button type="button" class="is-active" data-eauto-option data-eauto-value="medium" aria-pressed="true">{{ section.settings.pv_option_medium_label }}{% if section.settings.pv_option_medium_note != blank %} <small>({{ section.settings.pv_option_medium_note }})</small>{% endif %}</button>
            <button type="button" data-eauto-option data-eauto-value="high" aria-pressed="false">{{ section.settings.pv_option_high_label }}{% if section.settings.pv_option_high_note != blank %} <small>({{ section.settings.pv_option_high_note }})</small>{% endif %}</button>
          </div>
        </div>
        <div class="e-auto-page__calculator-step">
          <span class="e-auto-page__step-number">04</span>
          <h3>{% if charge_heading_parts.size > 1 %}{{ charge_heading_parts[0] }}? <span class="e-auto-page__calculator-detail">{{ charge_heading_parts[1] | strip }}</span>{% else %}{{ section.settings.charge_heading }}{% endif %}</h3>
          <div class="e-auto-page__option-grid" data-eauto-option-group="chargeWindow">
            <button type="button" class="is-active" data-eauto-option data-eauto-value="evening" aria-pressed="true">{{ section.settings.charge_option_evening_label }}</button>
            <button type="button" data-eauto-option data-eauto-value="daytime" aria-pressed="false">{{ section.settings.charge_option_daytime_label }}</button>
          </div>
        </div>
      </div>
      <aside class="e-auto-page__calculator-result" aria-live="polite">
        <span class="e-auto-page__eyebrow">{{ section.settings.result_eyebrow }}</span>
        <strong data-eauto-result-range>{{ section.settings.result_initial_range }}</strong>
        <h3 data-eauto-result-model>{{ section.settings.result_loading_model }}</h3>
        <p data-eauto-result-copy>Wähle deine vier Angaben, um eine passende Kapazität und Produktkonfiguration zu sehen.</p>
        <a class="e-auto-page__button e-auto-page__button--primary" href="{{ result_button_target }}">{{ section.settings.result_button_label }} <span aria-hidden="true">→</span></a>
        {% if section.settings.result_note != blank %}<small>{{ section.settings.result_note }}</small>{% endif %}
      </aside>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "E-Auto Kapazitätsrechner",
  "tag": "section",
  "class": "section-e-auto-calculator",
  "settings": [
    {"type":"text","id":"calculator_eyebrow","label":"Rechner Kicker","default":"Schnell-Ermittlung"},
    {"type":"text","id":"calculator_heading","label":"Rechner Überschrift – Hauptteil","default":"Wie viel Speicher braucht dein"},
    {"type":"text","id":"calculator_heading_accent","label":"Rechner Überschrift – blauer Akzent","default":"E-Auto?"},
    {"type":"textarea","id":"calculator_text","label":"Rechner Text","default":"Vier feste Angaben – wir zeigen dir, in welchem Kapazitätsbereich dein VENUS E liegen sollte."},
    {"type":"text","id":"distance_heading","label":"Schritt 1","default":"Wie weit fährst du am Tag? ø km / Tag"},
    {"type":"text","id":"efficiency_heading","label":"Schritt 2","default":"Wie viel Verbrauch hat dein Auto? kWh / 100 km"},
    {"type":"text","id":"pv_heading","label":"Schritt 3","default":"Wie viel PV-Überschuss hast du? geschätzt pro Tag"},
    {"type":"text","id":"charge_heading","label":"Schritt 4","default":"Wann lädst du meistens? Ladefenster"},
    {"type":"header","content":"Auswahltexte"},
    {"type":"text","id":"distance_option_under20_label","label":"Distanz: Unter 20 km","default":"Unter 20 km"},
    {"type":"text","id":"distance_option_20to40_label","label":"Distanz: 20–40 km","default":"20–40 km"},
    {"type":"text","id":"distance_option_40to80_label","label":"Distanz: 40–80 km","default":"40–80 km"},
    {"type":"text","id":"distance_option_over80_label","label":"Distanz: Über 80 km","default":"Über 80 km"},
    {"type":"text","id":"efficiency_option_efficient_label","label":"Verbrauch: Effizient","default":"Effizient"},
    {"type":"text","id":"efficiency_option_efficient_note","label":"Verbrauch: Effizient Zusatz","default":"bis 16"},
    {"type":"text","id":"efficiency_option_average_label","label":"Verbrauch: Durchschnitt","default":"Durchschnitt"},
    {"type":"text","id":"efficiency_option_average_note","label":"Verbrauch: Durchschnitt Zusatz","default":"17–21"},
    {"type":"text","id":"efficiency_option_high_label","label":"Verbrauch: Verbrauchsstark","default":"Verbrauchsstark"},
    {"type":"text","id":"efficiency_option_high_note","label":"Verbrauch: Verbrauchsstark Zusatz","default":"über 21"},
    {"type":"text","id":"pv_option_low_label","label":"PV: Wenig","default":"Wenig / unbekannt"},
    {"type":"text","id":"pv_option_medium_label","label":"PV: Mittel","default":"Mittel"},
    {"type":"text","id":"pv_option_medium_note","label":"PV: Mittel Zusatz","default":"ca. 5–15 kWh"},
    {"type":"text","id":"pv_option_high_label","label":"PV: Viel","default":"Viel"},
    {"type":"text","id":"pv_option_high_note","label":"PV: Viel Zusatz","default":"über 15 kWh"},
    {"type":"text","id":"charge_option_evening_label","label":"Ladefenster: Abends","default":"Abends / nachts"},
    {"type":"text","id":"charge_option_daytime_label","label":"Ladefenster: Tagsüber","default":"Tagsüber zu Hause"},
    {"type":"header","content":"Dynamisches Ergebnis"},
    {"type":"text","id":"result_eyebrow","label":"Ergebnis Kicker","default":"Dein Ergebnis"},
    {"type":"text","id":"result_loading_model","label":"Ergebnis Startmodell","default":"Deine passende VENUS E Konfiguration"},
    {"type":"text","id":"result_initial_range","label":"Ergebnis Startbereich","default":"2–5 kWh"},
    {"type":"text","id":"capacity_unit_label","label":"Kapazität Einheit","default":"kWh"},
    {"type":"textarea","id":"result_model_template","label":"Ergebnis Modellvorlage","info":"Verfügbare Variablen: product_title, product_capacity, range, lower, upper, unit.","default":"Passt zu [[product_title]]"},
    {"type":"textarea","id":"result_copy_template","label":"Ergebnis Textvorlage","info":"Verfügbare Variablen: product_title, product_capacity, range, lower, upper, unit.","default":"Mit deiner Auswahl liegt der sinnvolle Orientierungsbereich bei [[range]]."},
    {"type":"text","id":"result_button_label","label":"Ergebnis Button","default":"Passende Modelle ansehen"},
    {"type":"text","id":"result_button_target","label":"Ergebnis Button Ziel","info":"Anker-ID mit oder ohne # eingeben.","default":"#eauto-recommendations"},
    {"type":"textarea","id":"result_note","label":"Ergebnis Hinweis","default":"Orientierungswert auf Basis deiner Angaben. Die genaue Auslegung hängt auch von Haushaltsverbrauch, Jahreszeit und Wallbox-Leistung ab."},
    {"type":"header","content":"Typography"},
    {"type":"range","id":"item_heading_size","label":"Schritt Überschrift Größe","min":14,"max":26,"step":1,"unit":"px","default":16},
    {"type":"range","id":"item_text_size","label":"Zusatztext Größe","min":10,"max":18,"step":1,"unit":"px","default":11},
    {"type":"range","id":"control_size","label":"Auswahl und Button Größe","min":11,"max":18,"step":1,"unit":"px","default":12},
    {"type":"range","id":"note_size","label":"Ergebnis Hinweis Größe","min":10,"max":18,"step":1,"unit":"px","default":11},
    {"type":"header","content":"Layout und Größen"},
    {"type":"range","id":"heading_size","label":"Überschrift Größe","min":28,"max":60,"step":1,"unit":"px","default":42},
    {"type":"range","id":"copy_size","label":"Textgröße","min":13,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"section_spacing","label":"Abstand oben und unten","min":40,"max":140,"step":4,"unit":"px","default":80}
  ],
  "presets": [{"name":"E-Auto Kapazitätsrechner"}]
}
{% endschema %}
