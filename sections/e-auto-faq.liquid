{% liquid
  assign page_id = 'eauto-' | append: section.id
%}

<section id="eauto-faq" class="e-auto-page e-auto-page__section e-auto-page__faq" style="--eauto-heading-size: {{ section.settings.heading_size }}px; --eauto-copy-size: {{ section.settings.copy_size }}px; --eauto-eyebrow-size: {{ section.settings.eyebrow_size | default: 11 }}px; --eauto-item-heading-size: {{ section.settings.item_heading_size | default: 16 }}px; --eauto-item-text-size: {{ section.settings.item_text_size | default: 16 }}px; --eauto-control-size: {{ section.settings.control_size | default: 13 }}px; --eauto-value-size: {{ section.settings.value_size | default: 34 }}px; --eauto-note-size: {{ section.settings.note_size | default: 12 }}px; --eauto-section-space: {{ section.settings.section_spacing }}px;" aria-labelledby="{{ page_id }}-faq-heading">
  <div class="e-auto-page__container e-auto-page__faq-container">
    <div class="e-auto-page__section-heading">
      <p class="e-auto-page__eyebrow">{{ section.settings.faq_eyebrow }}</p>
      <h2 id="{{ page_id }}-faq-heading">{{ section.settings.faq_heading }}{% if section.settings.faq_heading_accent != blank %} <span>{{ section.settings.faq_heading_accent }}</span>{% endif %}</h2>
    </div>
    <div class="e-auto-page__faq-list">
      {% for block in section.blocks %}
        {%- assign faq_item_id = page_id | append: '-item-' | append: forloop.index -%}
        <div id="{{ faq_item_id }}" class="e-auto-page__faq-item" {{ block.shopify_attributes }}>
          <button id="{{ faq_item_id }}-question" type="button" class="e-auto-page__faq-question" data-eauto-faq-question aria-controls="{{ faq_item_id }}-answer" aria-expanded="false">
            <span>{{ block.settings.question }}</span>
            <span class="e-auto-page__faq-icon" aria-hidden="true">
              <svg viewBox="0 0 12 8" focusable="false"><path d="m1 1.5 5 5 5-5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4" /></svg>
            </span>
          </button>
          <div id="{{ faq_item_id }}-answer" class="e-auto-page__faq-answer" data-eauto-faq-answer aria-hidden="true" hidden role="region" aria-labelledby="{{ faq_item_id }}-question">
            <div class="e-auto-page__faq-answer-inner">{{ block.settings.answer }}</div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% assign eauto_faq_blocks = section.blocks %}
{% render 'structured-data', structured_data_context: 'faq', faq_items: eauto_faq_blocks, faq_source: 'bw_storage' %}

{% schema %}
{
  "name": "E-Auto FAQ",
  "tag": "section",
  "class": "section-e-auto-faq",
  "settings": [
    {"type":"text","id":"faq_eyebrow","label":"常见问题眉题","default":"Häufige Fragen"},
    {"type":"text","id":"faq_heading","label":"常见问题标题","default":"Fragen rund ums"},
    {"type":"text","id":"faq_heading_accent","label":"常见问题标题强调部分","default":"E-Auto laden mit Speicher"},
    {"type":"textarea","id":"faq_text","label":"常见问题文本","default":"Antworten auf häufige Fragen rund um E-Auto und Speicher."},
    {"type":"header","content":"Typography"},
    {"type":"range","id":"eyebrow_size","label":"眉题大小","min":9,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"item_heading_size","label":"项目标题大小","min":13,"max":24,"step":0.5,"unit":"px","default":15.5},
    {"type":"range","id":"item_text_size","label":"项目文本大小","min":12,"max":20,"step":0.5,"unit":"px","default":14},
    {"type":"range","id":"control_size","label":"控件大小","min":11,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"value_size","label":"数值大小","min":20,"max":64,"step":1,"unit":"px","default":34},
    {"type":"range","id":"note_size","label":"备注大小","min":10,"max":16,"step":0.5,"unit":"px","default":13},
    {"type":"header","content":"Layout und Größen"},
    {"type":"range","id":"heading_size","label":"标题大小","min":28,"max":60,"step":1,"unit":"px","default":40},
    {"type":"range","id":"copy_size","label":"文案大小","min":13,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"section_spacing","label":"区块间距","min":40,"max":140,"step":2,"unit":"px","default":68}
  ],
  "blocks": [
    {"type":"faq","name":"FAQ Frage","settings":[{"type":"text","id":"question","label":"问题","default":"Kann der VENUS E mein Auto direkt laden?"},{"type":"richtext","id":"answer","label":"答案","default":"<p>Nein. Der VENUS E ist AC-gekoppelt an dein Hausnetz angeschlossen. Geladen wird dein Auto weiterhin über die Wallbox.</p>"}]}
  ],
  "max_blocks": 6,
  "presets": [{"name":"E-Auto FAQ","blocks":[{"type":"faq"},{"type":"faq"},{"type":"faq"},{"type":"faq"},{"type":"faq"},{"type":"faq"}] }]
}
{% endschema %}
