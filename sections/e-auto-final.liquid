{% liquid
  assign page_id = 'eauto-' | append: section.id
  assign final_primary_link = section.settings.final_primary_link | default: '#eauto-calculator'
%}

<section id="eauto-final" class="e-auto-page e-auto-page__final" style="--eauto-heading-size: {{ section.settings.heading_size }}px; --eauto-copy-size: {{ section.settings.copy_size }}px; --eauto-section-space: {{ section.settings.section_spacing }}px; --eauto-final-media-height: {{ section.settings.final_media_height }}px;" aria-labelledby="{{ page_id }}-final-heading">
  <div class="e-auto-page__container e-auto-page__final-inner">
    <div>
      <p class="e-auto-page__eyebrow">{{ section.settings.final_eyebrow }}</p>
      <h2 id="{{ page_id }}-final-heading">{{ section.settings.final_heading }}{% if section.settings.final_heading_accent != blank %} <span>{{ section.settings.final_heading_accent }}</span>{% endif %}</h2>
      <p>{{ section.settings.final_text }}</p>
      <a class="e-auto-page__button e-auto-page__button--primary" href="{{ final_primary_link }}">{{ section.settings.final_primary_label }} <span aria-hidden="true">→</span></a>
    </div>
    <div class="e-auto-page__media e-auto-page__media--final">
      {% if section.settings.final_image != blank %}
        {{ section.settings.final_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '640, 960, 1280, 1600', sizes: '(min-width: 960px) 50vw, 100vw', alt: section.settings.final_image_alt }}
      {% elsif request.design_mode %}
        <div class="e-auto-page__placeholder">{{ section.settings.final_image_placeholder }}</div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "E-Auto 结尾",
  "tag": "section",
  "class": "section-e-auto-final",
  "settings": [
    {"type":"text","id":"final_eyebrow","label":"结尾小标题","default":"Bereit?"},
    {"type":"text","id":"final_heading","label":"结尾标题（主体）","default":"Finde den Speicher,"},
    {"type":"text","id":"final_heading_accent","label":"结尾标题（蓝色强调）","default":"der zu deinem Auto passt"},
    {"type":"textarea","id":"final_text","label":"结尾说明","default":"Von der kompakten Lösung bis zur großen Konfiguration: Starte mit deinem Fahrprofil und vergleiche die passenden VENUS E Modelle."},
    {"type":"text","id":"final_primary_label","label":"结尾主按钮","default":"Passenden Speicher finden"},
    {"type":"url","id":"final_primary_link","label":"结尾链接"},
    {"type":"image_picker","id":"final_image","label":"结尾图片"},
    {"type":"text","id":"final_image_alt","label":"结尾图片替代文本","default":"VENUS E Produktreihe für unterschiedliche E-Auto Fahrprofile"},
    {"type":"text","id":"final_image_placeholder","label":"结尾图片占位提示","default":"Produktreihe-Bild auswählen"},
    {"type":"header","content":"布局与尺寸"},
    {"type":"range","id":"heading_size","label":"标题字号","min":28,"max":60,"step":1,"unit":"px","default":38},
    {"type":"range","id":"copy_size","label":"文案字号","min":13,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"final_media_height","label":"结尾图片高度","min":180,"max":420,"step":10,"unit":"px","default":260},
    {"type":"range","id":"section_spacing","label":"区块上下间距","min":40,"max":140,"step":4,"unit":"px","default":72}
  ],
  "presets": [{"name":"E-Auto 结尾"}]
}
{% endschema %}
