{% liquid
  assign page_id = 'eauto-' | append: section.id
%}

<section id="eauto-flow" class="e-auto-page e-auto-page__section e-auto-page__flow" style="--eauto-heading-size: {{ section.settings.heading_size }}px; --eauto-copy-size: {{ section.settings.copy_size }}px; --eauto-section-space: {{ section.settings.section_spacing }}px; --eauto-flow-media-height: {{ section.settings.flow_media_height }}px;" aria-labelledby="{{ page_id }}-flow-heading">
  <div class="e-auto-page__container">
    <div class="e-auto-page__section-heading">
      <p class="e-auto-page__eyebrow">{{ section.settings.flow_eyebrow }}</p>
      <h2 id="{{ page_id }}-flow-heading">{{ section.settings.flow_heading }}{% if section.settings.flow_heading_accent != blank %} <span>{{ section.settings.flow_heading_accent }}</span>{% endif %}</h2>
      <p>{{ section.settings.flow_text }}</p>
    </div>
    <div class="e-auto-page__toggle" role="tablist" aria-label="{{ section.settings.flow_toggle_label }}">
      <button type="button" class="is-active" data-eauto-flow-toggle="day" role="tab" aria-selected="true">{{ section.settings.flow_day_label }}</button>
      <button type="button" data-eauto-flow-toggle="evening" role="tab" aria-selected="false">{{ section.settings.flow_evening_label }}</button>
    </div>
    <div class="e-auto-page__flow-panel is-active" data-eauto-flow-panel="day" role="tabpanel">
      <div class="e-auto-page__flow-copy">
        <h3>{{ section.settings.flow_day_heading }}</h3>
        <p>{{ section.settings.flow_day_text }}</p>
        <ul>
          <li>{{ section.settings.flow_day_point_1 }}</li>
          <li>{{ section.settings.flow_day_point_2 }}</li>
          <li>{{ section.settings.flow_day_point_3 }}</li>
        </ul>
      </div>
      <div class="e-auto-page__media e-auto-page__media--flow">
        {% if section.settings.flow_day_video != blank %}
          {{ section.settings.flow_day_video | video_tag: controls: false, autoplay: false, loop: true, muted: true, playsinline: true, preload: 'metadata' }}
        {% elsif section.settings.flow_day_image != blank %}
          {{ section.settings.flow_day_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '640, 960, 1280, 1600', sizes: '(min-width: 960px) 58vw, 100vw', alt: section.settings.flow_day_image_alt }}
        {% elsif request.design_mode %}
          <div class="e-auto-page__placeholder">{{ section.settings.flow_image_placeholder }}</div>
        {% endif %}
      </div>
    </div>
    <div class="e-auto-page__flow-panel" data-eauto-flow-panel="evening" role="tabpanel" hidden>
      <div class="e-auto-page__flow-copy">
        <h3>{{ section.settings.flow_evening_heading }}</h3>
        <p>{{ section.settings.flow_evening_text }}</p>
        <ul>
          <li>{{ section.settings.flow_evening_point_1 }}</li>
          <li>{{ section.settings.flow_evening_point_2 }}</li>
          <li>{{ section.settings.flow_evening_point_3 }}</li>
        </ul>
      </div>
      <div class="e-auto-page__media e-auto-page__media--flow">
        {% if section.settings.flow_evening_video != blank %}
          {{ section.settings.flow_evening_video | video_tag: controls: false, autoplay: false, loop: true, muted: true, playsinline: true, preload: 'metadata' }}
        {% elsif section.settings.flow_evening_image != blank %}
          {{ section.settings.flow_evening_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '640, 960, 1280, 1600', sizes: '(min-width: 960px) 58vw, 100vw', alt: section.settings.flow_evening_image_alt }}
        {% elsif request.design_mode %}
          <div class="e-auto-page__placeholder">{{ section.settings.flow_image_placeholder }}</div>
        {% endif %}
      </div>
    </div>
    {% if section.settings.flow_note != blank %}<p class="e-auto-page__note">{{ section.settings.flow_note }}</p>{% endif %}
  </div>
</section>

{% schema %}
{
  "name": "E-Auto 能量流",
  "tag": "section",
  "class": "section-e-auto-flow",
  "settings": [
    {"type":"text","id":"flow_eyebrow","label":"能量流小标题","default":"So funktioniert es"},
    {"type":"text","id":"flow_heading","label":"能量流标题（主体）","default":"Energiefluss:"},
    {"type":"text","id":"flow_heading_accent","label":"能量流标题（蓝色强调）","default":"AC-gekoppelt über dein Hausnetz"},
    {"type":"textarea","id":"flow_text","label":"能量流说明","default":"Der VENUS E wird an dein Hausnetz angeschlossen – nicht an dein Auto. PV-Überschuss landet zuerst im Speicher, abends fließt er über das Hausnetz zu Wallbox und E-Auto."},
    {"type":"text","id":"flow_toggle_label","label":"能量流切换标签","default":"Tageszeit auswählen"},
    {"type":"text","id":"flow_day_label","label":"白天标签","default":"☀ Tag · Speichern"},
    {"type":"text","id":"flow_evening_label","label":"夜晚标签","default":"☾ Abend · Laden"},
    {"type":"text","id":"flow_day_heading","label":"白天标题","default":"PV-Überschuss wird gespeichert"},
    {"type":"textarea","id":"flow_day_text","label":"白天说明","default":"Am Tag fließt überschüssige Energie über das Hausnetz in den VENUS E. Der Speicher nimmt sie auf, statt sie ungenutzt einzuspeisen."},
    {"type":"text","id":"flow_day_point_1","label":"白天要点 1","default":"PV → Hausnetz → VENUS E"},
    {"type":"text","id":"flow_day_point_2","label":"白天要点 2","default":"Das E-Auto ist unterwegs"},
    {"type":"text","id":"flow_day_point_3","label":"白天要点 3","default":"Überschuss bleibt für den Abend verfügbar"},
    {"type":"text","id":"flow_evening_heading","label":"夜晚标题","default":"Gespeicherter Solarstrom lädt das Auto"},
    {"type":"textarea","id":"flow_evening_text","label":"夜晚说明","default":"Am Abend liefert der VENUS E Energie zurück ins Hausnetz. Deine Wallbox regelt weiterhin die Ladeleistung am Fahrzeug."},
    {"type":"text","id":"flow_evening_point_1","label":"夜晚要点 1","default":"VENUS E → Hausnetz → Wallbox"},
    {"type":"text","id":"flow_evening_point_2","label":"夜晚要点 2","default":"Die PV produziert kaum noch"},
    {"type":"text","id":"flow_evening_point_3","label":"夜晚要点 3","default":"Das Netz ergänzt nur, wenn Speicherenergie fehlt"},
    {"type":"image_picker","id":"flow_day_image","label":"白天图片"},
    {"type":"image_picker","id":"flow_evening_image","label":"夜晚图片"},
    {"type":"video","id":"flow_day_video","label":"白天视频"},
    {"type":"video","id":"flow_evening_video","label":"夜晚视频"},
    {"type":"text","id":"flow_day_image_alt","label":"白天图片替代文本","default":"PV-Überschuss lädt den VENUS E Speicher"},
    {"type":"text","id":"flow_evening_image_alt","label":"夜晚图片替代文本","default":"VENUS E liefert Solarstrom über das Hausnetz zur Wallbox"},
    {"type":"text","id":"flow_image_placeholder","label":"能量流占位提示","default":"Energiefluss-Bild oder Video auswählen"},
    {"type":"textarea","id":"flow_note","label":"能量流提示","default":"Wichtig: Der VENUS E speichert und liefert Energie über das Hausnetz. Er wird nicht direkt mit dem Auto verbunden."},
    {"type":"header","content":"布局与尺寸"},
    {"type":"range","id":"heading_size","label":"标题字号","min":28,"max":60,"step":1,"unit":"px","default":42},
    {"type":"range","id":"copy_size","label":"文案字号","min":13,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"flow_media_height","label":"能量流图片高度","min":320,"max":720,"step":10,"unit":"px","default":520},
    {"type":"range","id":"section_spacing","label":"区块上下间距","min":40,"max":140,"step":4,"unit":"px","default":80}
  ],
  "presets": [{"name":"E-Auto 能量流"}]
}
{% endschema %}
