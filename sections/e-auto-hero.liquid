{% liquid
  assign page_id = 'eauto-' | append: section.id
  assign hero_primary_link = section.settings.hero_primary_link | default: '#eauto-calculator'
  assign hero_secondary_link = section.settings.hero_secondary_link | default: '#eauto-flow'
%}

<section id="eauto-start" class="e-auto-page e-auto-page__hero" style="--eauto-heading-size: {{ section.settings.heading_size }}px; --eauto-copy-size: {{ section.settings.copy_size }}px; --eauto-section-space: {{ section.settings.section_spacing }}px; --eauto-hero-media-height: {{ section.settings.hero_media_height }}px; --eauto-hero-image-width: {{ section.settings.hero_image_width }}%;" aria-labelledby="{{ page_id }}-hero-heading">
  <div class="e-auto-page__container e-auto-page__hero-grid">
    <div class="e-auto-page__hero-copy">
      {% if section.settings.hero_eyebrow != blank %}<p class="e-auto-page__eyebrow">{{ section.settings.hero_eyebrow }}</p>{% endif %}
      <h1 id="{{ page_id }}-hero-heading">{{ section.settings.hero_heading }}{% if section.settings.hero_heading_accent != blank %} <span>{{ section.settings.hero_heading_accent }}</span>{% endif %}</h1>
      {% if section.settings.hero_text != blank %}<p class="e-auto-page__lead">{{ section.settings.hero_text }}</p>{% endif %}
      <div class="e-auto-page__actions">
        <a class="e-auto-page__button e-auto-page__button--primary" href="{{ hero_primary_link }}">{{ section.settings.hero_primary_label }} <span aria-hidden="true">→</span></a>
        <a class="e-auto-page__button e-auto-page__button--secondary" href="{{ hero_secondary_link }}">{{ section.settings.hero_secondary_label }}</a>
      </div>
      <div class="e-auto-page__stats" aria-label="{{ section.settings.hero_stats_label }}">
        <div><strong>{{ section.settings.hero_stat_1_value }}</strong><span>{{ section.settings.hero_stat_1_label }}</span></div>
        <div><strong>{{ section.settings.hero_stat_2_value }}</strong><span>{{ section.settings.hero_stat_2_label }}</span></div>
        <div><strong>{{ section.settings.hero_stat_3_value }}</strong><span>{{ section.settings.hero_stat_3_label }}</span></div>
      </div>
    </div>
    <div class="e-auto-page__media e-auto-page__media--hero">
      {% if section.settings.hero_image != blank %}
        {{ section.settings.hero_image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '480, 720, 960, 1200, 1600', sizes: '(min-width: 960px) 52vw, 100vw', alt: section.settings.hero_image_alt }}
      {% elsif request.design_mode %}
        <div class="e-auto-page__placeholder">{{ section.settings.hero_image_placeholder }}</div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "E-Auto 首屏",
  "tag": "section",
  "class": "section-e-auto-hero",
  "settings": [
    {"type":"text","id":"hero_eyebrow","label":"首屏小标题","default":"E-Auto & Photovoltaik"},
    {"type":"text","id":"hero_heading","label":"首屏标题（主体）","default":"E-Auto laden mit Speicher: Mehr Solarstrom"},
    {"type":"text","id":"hero_heading_accent","label":"首屏标题（蓝色强调）","default":"für dein Auto"},
    {"type":"textarea","id":"hero_text","label":"首屏说明","default":"Deine PV-Anlage produziert am Tag, dein Auto lädt abends. Mit einem VENUS E Speicher passt das endlich zusammen: Überschuss speichern – später fahren."},
    {"type":"text","id":"hero_primary_label","label":"首屏主按钮","default":"Passenden Speicher finden"},
    {"type":"url","id":"hero_primary_link","label":"首屏主链接"},
    {"type":"text","id":"hero_secondary_label","label":"首屏次按钮","default":"So funktioniert es"},
    {"type":"url","id":"hero_secondary_link","label":"首屏次链接"},
    {"type":"image_picker","id":"hero_image","label":"首屏图片"},
    {"type":"text","id":"hero_image_alt","label":"首屏图片替代文本","default":"PV-Anlage, VENUS E Speicher und E-Auto an einem modernen Wohnhaus"},
    {"type":"text","id":"hero_image_placeholder","label":"首屏图片占位提示","default":"Hero-Bild auswählen: PV, VENUS E, Wallbox und E-Auto"},
    {"type":"text","id":"hero_stats_label","label":"首屏数据标签","default":"E-Auto Speicher Kennzahlen"},
    {"type":"text","id":"hero_stat_1_value","label":"数据 1 数值","default":"2–30 kWh"},
    {"type":"text","id":"hero_stat_1_label","label":"数据 1 标签","default":"Speicherkapazität"},
    {"type":"text","id":"hero_stat_2_value","label":"数据 2 数值","default":"bis zu 3,6 kW"},
    {"type":"text","id":"hero_stat_2_label","label":"数据 2 标签","default":"Ausgangsleistung"},
    {"type":"text","id":"hero_stat_3_value","label":"数据 3 数值","default":"10 Jahre"},
    {"type":"text","id":"hero_stat_3_label","label":"数据 3 标签","default":"Herstellergarantie"},
    {"type":"header","content":"布局与尺寸"},
    {"type":"range","id":"heading_size","label":"标题字号","min":36,"max":72,"step":1,"unit":"px","default":52},
    {"type":"range","id":"copy_size","label":"文案字号","min":13,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"hero_media_height","label":"首屏图片高度","min":360,"max":620,"step":10,"unit":"px","default":480},
    {"type":"range","id":"hero_image_width","label":"首屏图片宽度","min":40,"max":65,"step":1,"unit":"%","default":52},
    {"type":"range","id":"section_spacing","label":"区块上下间距","min":40,"max":140,"step":4,"unit":"px","default":80}
  ],
  "presets": [{"name":"E-Auto 首屏"}]
}
{% endschema %}
