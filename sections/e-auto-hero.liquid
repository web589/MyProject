{% liquid
  assign page_id = 'eauto-' | append: section.id
  assign hero_primary_link = section.settings.hero_primary_link | default: '#eauto-calculator'
  assign hero_secondary_link = section.settings.hero_secondary_link | default: '#eauto-flow'
%}

<section id="eauto-start" class="e-auto-page e-auto-page__hero" aria-labelledby="{{ page_id }}-hero-heading">
  <div class="e-auto-page__container e-auto-page__hero-grid">
    <div class="e-auto-page__hero-copy">
      {% if section.settings.hero_eyebrow != blank %}<p class="e-auto-page__eyebrow">{{ section.settings.hero_eyebrow }}</p>{% endif %}
      <h1 id="{{ page_id }}-hero-heading">{{ section.settings.hero_heading }}</h1>
      {% if section.settings.hero_text != blank %}<p class="e-auto-page__lead">{{ section.settings.hero_text }}</p>{% endif %}
      <div class="e-auto-page__actions">
        <a class="e-auto-page__button e-auto-page__button--primary" href="{{ hero_primary_link }}">{{ section.settings.hero_primary_label }} <span aria-hidden="true">→</span></a>
        <a class="e-auto-page__button e-auto-page__button--secondary" href="{{ hero_secondary_link }}">{{ section.settings.hero_secondary_label }}</a>
      </div>
      <div class="e-auto-page__stats" aria-label="{{ section.settings.hero_stats_label }}">
        <div><strong>{{ section.settings.hero_stat_1_value }}</strong><span>{{ section.settings.hero_stat_1_label }}</span></div>
        <div><strong>{{ section.settings.hero_stat_2_value }}</strong><span>{{ section.settings.hero_stat_2_label }}</span></div>
        <div><strong>{{ section.settings.hero_stat_3_value }}</strong><span>{{ section.settings.hero_stat_3_label }}</span></div>
      </div>
    </div>
    <div class="e-auto-page__media e-auto-page__media--hero">
      {% if section.settings.hero_image != blank %}
        {{ section.settings.hero_image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '480, 720, 960, 1200, 1600', sizes: '(min-width: 960px) 52vw, 100vw', alt: section.settings.hero_image_alt }}
      {% elsif request.design_mode %}
        <div class="e-auto-page__placeholder">{{ section.settings.hero_image_placeholder }}</div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "E-Auto Hero",
  "tag": "section",
  "class": "section-e-auto-hero",
  "settings": [
    {"type":"text","id":"hero_eyebrow","label":"Hero Kicker","default":"E-Auto & Photovoltaik"},
    {"type":"text","id":"hero_heading","label":"Hero Überschrift","default":"E-Auto laden mit Speicher: Mehr Solarstrom für dein Auto"},
    {"type":"textarea","id":"hero_text","label":"Hero Text","default":"Deine PV-Anlage produziert am Tag, dein Auto lädt abends. Mit einem VENUS E Speicher passt das endlich zusammen: Überschuss speichern – später fahren."},
    {"type":"text","id":"hero_primary_label","label":"Hero Hauptbutton","default":"Passenden Speicher finden"},
    {"type":"url","id":"hero_primary_link","label":"Hero Hauptlink"},
    {"type":"text","id":"hero_secondary_label","label":"Hero Nebenbutton","default":"So funktioniert es"},
    {"type":"url","id":"hero_secondary_link","label":"Hero Nebenlink"},
    {"type":"image_picker","id":"hero_image","label":"Hero Bild"},
    {"type":"text","id":"hero_image_alt","label":"Hero Bild Alt-Text","default":"PV-Anlage, VENUS E Speicher und E-Auto an einem modernen Wohnhaus"},
    {"type":"text","id":"hero_image_placeholder","label":"Hero Bild Platzhalter","default":"Hero-Bild auswählen: PV, VENUS E, Wallbox und E-Auto"},
    {"type":"text","id":"hero_stats_label","label":"Hero Kennzahlen Label","default":"E-Auto Speicher Kennzahlen"},
    {"type":"text","id":"hero_stat_1_value","label":"Kennzahl 1 Wert","default":"2–30 kWh"},
    {"type":"text","id":"hero_stat_1_label","label":"Kennzahl 1 Label","default":"Speicherkapazität"},
    {"type":"text","id":"hero_stat_2_value","label":"Kennzahl 2 Wert","default":"bis zu 3,6 kW"},
    {"type":"text","id":"hero_stat_2_label","label":"Kennzahl 2 Label","default":"Ausgangsleistung"},
    {"type":"text","id":"hero_stat_3_value","label":"Kennzahl 3 Wert","default":"10 Jahre"},
    {"type":"text","id":"hero_stat_3_label","label":"Kennzahl 3 Label","default":"Herstellergarantie"}
  ],
  "presets": [{"name":"E-Auto Hero"}]
}
{% endschema %}
