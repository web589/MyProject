{% liquid
  assign page_id = 'eauto-' | append: section.id
%}

<section id="eauto-installation" class="e-auto-page e-auto-page__section e-auto-page__installation" style="--eauto-heading-size: {{ section.settings.heading_size }}px; --eauto-copy-size: {{ section.settings.copy_size }}px; --eauto-section-space: {{ section.settings.section_spacing }}px; --eauto-installation-media-height: {{ section.settings.installation_media_height }}px;" aria-labelledby="{{ page_id }}-installation-heading">
  <div class="e-auto-page__container">
    <div class="e-auto-page__section-heading">
      <p class="e-auto-page__eyebrow">{{ section.settings.installation_eyebrow }}</p>
      <h2 id="{{ page_id }}-installation-heading">{{ section.settings.installation_heading }}{% if section.settings.installation_heading_accent != blank %} <span>{{ section.settings.installation_heading_accent }}</span>{% endif %}</h2>
      <p>{{ section.settings.installation_text }}</p>
    </div>
    <div class="e-auto-page__installation-grid">
      <div class="e-auto-page__installation-row">
        <div class="e-auto-page__media e-auto-page__installation-media">
          {% if section.settings.installation_image != blank %}
            {{ section.settings.installation_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '540, 800, 1100, 1400', sizes: '(min-width: 960px) 55vw, 100vw', alt: section.settings.installation_image_alt }}
          {% elsif request.design_mode %}
            <div class="e-auto-page__placeholder">{{ section.settings.installation_image_placeholder }}</div>
          {% endif %}
        </div>
        <div class="e-auto-page__installation-copy">
          <p class="e-auto-page__eyebrow">{{ section.settings.existing_pv_eyebrow }}</p>
          <h3>{{ section.settings.installation_card_heading }}</h3>
          <p>{{ section.settings.installation_card_text }}</p>
          <ul>
            <li>{{ section.settings.installation_point_1 }}</li>
            <li>{{ section.settings.installation_point_2 }}</li>
          </ul>
        </div>
      </div>
      <div class="e-auto-page__installation-row">
        <div class="e-auto-page__media e-auto-page__installation-media">
          {% if section.settings.installation_house_image != blank %}
            {{ section.settings.installation_house_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '540, 800, 1100, 1400', sizes: '(min-width: 960px) 55vw, 100vw', alt: section.settings.installation_house_image_alt }}
          {% elsif request.design_mode %}
            <div class="e-auto-page__placeholder">{{ section.settings.installation_house_image_placeholder }}</div>
          {% endif %}
        </div>
        <div class="e-auto-page__installation-copy">
          <p class="e-auto-page__eyebrow">{{ section.settings.house_eyebrow }}</p>
          <h3>{{ section.settings.house_heading }}</h3>
          <p>{{ section.settings.house_text }}</p>
          <ul>
            <li>{{ section.settings.house_point_1 }}</li>
            <li>{{ section.settings.house_point_2 }}</li>
          </ul>
        </div>
      </div>
      <div class="e-auto-page__installation-row">
        <div class="e-auto-page__media e-auto-page__installation-media">
          {% if section.settings.installation_step_image != blank %}
            {{ section.settings.installation_step_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '540, 800, 1100, 1400', sizes: '(min-width: 960px) 55vw, 100vw', alt: section.settings.installation_step_image_alt }}
          {% elsif request.design_mode %}
            <div class="e-auto-page__placeholder">{{ section.settings.installation_step_image_placeholder }}</div>
          {% endif %}
        </div>
        <div class="e-auto-page__installation-copy">
          <p class="e-auto-page__eyebrow">{{ section.settings.steps_eyebrow }}</p>
          <h3>{{ section.settings.steps_heading }}</h3>
          <p>{{ section.settings.steps_text }}</p>
          <div class="e-auto-page__install-steps">
            {% for block in section.blocks %}
              <div {{ block.shopify_attributes }}><span>{{ forloop.index }}</span><strong>{{ block.settings.title }}</strong><small>{{ block.settings.text }}</small></div>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "E-Auto 安装与改造",
  "tag": "section",
  "class": "section-e-auto-installation",
  "settings": [
    {"type":"text","id":"installation_eyebrow","label":"安装区小标题","default":"Installation & Nachrüstung"},
    {"type":"text","id":"installation_heading","label":"安装区标题（主体）","default":"Wallbox, Hausnetz & bestehende PV –"},
    {"type":"text","id":"installation_heading_accent","label":"安装区标题（蓝色强调）","default":"alles bleibt wie es ist"},
    {"type":"textarea","id":"installation_text","label":"安装区说明","default":"Der VENUS E wird AC-gekoppelt auf der Haushaltsseite ergänzt. Die Wallbox regelt weiterhin die Ladeleistung am Fahrzeug."},
    {"type":"image_picker","id":"installation_image","label":"安装区图片"},
    {"type":"text","id":"installation_image_alt","label":"安装区图片替代文本","default":"Bestehende PV-Anlage, Hausnetz und Wallbox mit VENUS E"},
    {"type":"text","id":"installation_image_placeholder","label":"安装区图片占位提示","default":"Bestehende PV-Anlage auswählen"},
    {"type":"image_picker","id":"installation_house_image","label":"家庭电网图片"},
    {"type":"text","id":"installation_house_image_alt","label":"家庭电网图片替代文本","default":"Hausnetz, Wallbox und VENUS E"},
    {"type":"text","id":"installation_house_image_placeholder","label":"家庭电网图片占位提示","default":"Hausnetz-Bild auswählen"},
    {"type":"image_picker","id":"installation_step_image","label":"改造步骤图片"},
    {"type":"text","id":"installation_step_image_alt","label":"改造步骤图片替代文本","default":"VENUS E Nachrüstung in drei Schritten"},
    {"type":"text","id":"installation_step_image_placeholder","label":"改造步骤图片占位提示","default":"Nachrüstungsbild auswählen"},
    {"type":"text","id":"existing_pv_eyebrow","label":"现有光伏小标题","default":"Bestehende PV-Anlage"},
    {"type":"text","id":"installation_card_heading","label":"安装卡片标题","default":"Alles läuft über dein Hausnetz"},
    {"type":"textarea","id":"installation_card_text","label":"安装卡片说明","default":"Bestehende PV, Hausnetz und Wallbox bleiben als getrennte Komponenten erhalten."},
    {"type":"text","id":"installation_point_1","label":"安装要点 1","default":"Keine direkte Verbindung vom Speicher zum Auto"},
    {"type":"text","id":"installation_point_2","label":"安装要点 2","default":"Die Ladeleistung wird weiterhin von der Wallbox geregelt"},
    {"type":"text","id":"installation_point_3","label":"安装要点 3","default":"Für die Messung und Regelung kann ein kompatibles Smart Meter erforderlich sein"},
    {"type":"text","id":"house_eyebrow","label":"家庭电网小标题","default":"Wallbox & Hausnetz"},
    {"type":"text","id":"house_heading","label":"家庭电网标题","default":"Alles läuft über dein Hausnetz"},
    {"type":"textarea","id":"house_text","label":"家庭电网说明","default":"Der VENUS E wird AC-gekoppelt auf der Hausnetzseite ergänzt. Deine Wallbox bleibt die Schnittstelle zum Auto."},
    {"type":"text","id":"house_point_1","label":"家庭电网要点 1","default":"Kompatibel mit bestehenden Wallboxen"},
    {"type":"text","id":"house_point_2","label":"家庭电网要点 2","default":"Die Ladeleistung wird weiterhin von der Wallbox geregelt"},
    {"type":"text","id":"steps_eyebrow","label":"改造步骤小标题","default":"AC-gekoppelt nachrüstbar"},
    {"type":"text","id":"steps_heading","label":"改造步骤标题","default":"Nachrüsten in drei Schritten"},
    {"type":"textarea","id":"steps_text","label":"改造步骤说明","default":"Bestehende Komponenten bleiben erhalten. Der Speicher ergänzt dein Hausnetz auf der AC-Seite."},
    {"type":"header","content":"布局与尺寸"},
    {"type":"range","id":"heading_size","label":"标题字号","min":28,"max":60,"step":1,"unit":"px","default":42},
    {"type":"range","id":"copy_size","label":"文案字号","min":13,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"installation_media_height","label":"安装图片高度","min":180,"max":420,"step":10,"unit":"px","default":260},
    {"type":"range","id":"section_spacing","label":"区块上下间距","min":40,"max":140,"step":4,"unit":"px","default":80}
  ],
  "blocks": [
    {"type":"install_step","name":"改造步骤","settings":[{"type":"text","id":"title","label":"标题","default":"Bestehende PV bleibt"},{"type":"text","id":"text","label":"文案","default":"Module und Wechselrichter bleiben unangetastet."}]}
  ],
  "max_blocks": 3,
  "presets": [{"name":"E-Auto 安装与改造","blocks":[{"type":"install_step"},{"type":"install_step"},{"type":"install_step"}] }]
}
{% endschema %}
