{% liquid
  assign navigation_anchor = section.settings.anchor_id | handle
  if navigation_anchor == blank
    assign navigation_anchor = 'eauto-navigation'
  endif
%}

<nav
  id="{{ navigation_anchor }}"
  class="bw-storage bw-storage-section bw-anchor-nav bw-anchor-target"
  data-eauto-anchor-nav
  data-section-id="{{ section.id }}"
  aria-label="{{ section.settings.aria_label | escape }}"
>
  <div class="bw-container bw-anchor-nav__inner">
    {% for block in section.blocks %}
      {% assign link_target = block.settings.target | remove_first: '#' | handle %}
      {% if block.settings.label != blank and link_target != blank %}
        <a
          class="bw-anchor-nav__link"
          href="#{{ link_target }}"
          data-eauto-anchor-link
          {{ block.shopify_attributes }}
        >
          {{ block.settings.label | escape }}
        </a>
      {% endif %}
    {% endfor %}

    {% assign cta_target = section.settings.cta_target | remove_first: '#' | handle %}
    {% if section.settings.cta_label != blank and cta_target != blank %}
      <a
        class="bw-anchor-nav__cta"
        href="#{{ cta_target }}"
        data-eauto-anchor-link
      >
        {{ section.settings.cta_label | escape }}
      </a>
    {% endif %}
  </div>
</nav>

{% schema %}
{
  "name": "E-Auto 导航",
  "tag": "section",
  "class": "section-e-auto-navigation",
  "settings": [
    {
      "type": "text",
      "id": "aria_label",
      "label": "无障碍名称",
      "default": "E-Auto Seitennavigation"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "锚点 ID",
      "info": "请输入不带 # 的 ID，并确保它在本页面中唯一。",
      "default": "eauto-navigation"
    },
    {
      "type": "header",
      "content": "高亮按钮"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA 按钮文案",
      "default": "Passenden Speicher finden"
    },
    {
      "type": "text",
      "id": "cta_target",
      "label": "CTA 跳转目标",
      "info": "请输入锚点 ID，可带或不带 #。",
      "default": "#eauto-calculator"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "导航链接",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "链接文案",
          "default": "Navigation"
        },
        {
          "type": "text",
          "id": "target",
          "label": "跳转目标",
          "info": "请输入锚点 ID，可带或不带 #。",
          "default": "#eauto-start"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "E-Auto 导航",
      "settings": {
        "anchor_id": "eauto-navigation",
        "aria_label": "E-Auto Seitennavigation",
        "cta_label": "Passenden Speicher finden",
        "cta_target": "#eauto-calculator"
      },
      "blocks": [
        { "type": "link", "settings": { "label": "Start", "target": "#eauto-start" } },
        { "type": "link", "settings": { "label": "Problem", "target": "#eauto-problem" } },
        { "type": "link", "settings": { "label": "Energiefluss", "target": "#eauto-flow" } },
        { "type": "link", "settings": { "label": "Typischer Tag", "target": "#eauto-day" } },
        { "type": "link", "settings": { "label": "Fahrprofile", "target": "#eauto-profile" } },
        { "type": "link", "settings": { "label": "Rechner", "target": "#eauto-calculator" } },
        { "type": "link", "settings": { "label": "Empfehlungen", "target": "#eauto-recommendations" } },
        { "type": "link", "settings": { "label": "Smart Energy", "target": "#eauto-smart-energy" } },
        { "type": "link", "settings": { "label": "Installation", "target": "#eauto-installation" } },
        { "type": "link", "settings": { "label": "FAQ", "target": "#eauto-faq" } }
      ]
    }
  ]
}
{% endschema %}
