{% liquid
  assign navigation_anchor = section.settings.anchor_id | handle
  if navigation_anchor == blank
    assign navigation_anchor = 'eauto-navigation'
  endif
%}

<nav
  id="{{ navigation_anchor }}"
  class="bw-storage bw-storage-section bw-anchor-nav bw-anchor-target"
  style="--eauto-control-size: {{ section.settings.control_size | default: 13 }}px;"
  data-eauto-anchor-nav
  data-section-id="{{ section.id }}"
  aria-label="{{ section.settings.aria_label | escape }}"
>
  <div class="bw-container bw-anchor-nav__inner">
    {% for block in section.blocks %}
      {% assign link_module = block.settings.module | default: 'custom' %}
      {% capture link_target %}{% render 'anchor-navigation-target', module: link_module, fallback: block.settings.target %}{% endcapture %}
      {% assign link_target = link_target | strip | remove_first: '#' | handle %}
      {% if block.settings.label != blank and link_target != blank %}
        <a
          class="bw-anchor-nav__link"
          href="#{{ link_target }}"
          data-eauto-anchor-link
          data-bw-anchor-module="{{ link_module | escape }}"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.label | escape }}
        </a>
      {% endif %}
    {% endfor %}

    {% assign cta_module = section.settings.cta_module | default: 'custom' %}
    {% capture cta_target %}{% render 'anchor-navigation-target', module: cta_module, fallback: section.settings.cta_target %}{% endcapture %}
    {% assign cta_target = cta_target | strip | remove_first: '#' | handle %}
    {% if section.settings.cta_label != blank and cta_target != blank %}
      <a
        class="bw-anchor-nav__cta"
        href="#{{ cta_target }}"
        data-eauto-anchor-link
        data-bw-anchor-module="{{ cta_module | escape }}"
      >
        {{ section.settings.cta_label | escape }}
      </a>
    {% endif %}
  </div>
</nav>

{% schema %}
{
  "name": "E-Auto Navigation",
  "tag": "section",
  "class": "section-e-auto-navigation",
  "settings": [
    {
      "type": "text",
      "id": "aria_label",
      "label": "无障碍标签",
      "default": "E-Auto Seitennavigation"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "锚点ID",
      "info": "Ohne # eingeben; die ID muss auf dieser Seite eindeutig sein.",
      "default": "eauto-navigation"
    },
    {
      "type": "header",
      "content": "Hervorgehobener Button"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "行动按钮标签",
      "default": "Passenden Speicher finden"
    },
    {
      "type": "select",
      "id": "cta_module",
      "label": "行动按钮链接到模块",
      "options": [
        { "value": "eauto_calculator", "label": "E-Auto · Rechner" },
        { "value": "eauto_start", "label": "E-Auto · Start" },
        { "value": "eauto_problem", "label": "E-Auto · Problem" },
        { "value": "eauto_flow", "label": "E-Auto · Energiefluss" },
        { "value": "eauto_day", "label": "E-Auto · Typischer Tag" },
        { "value": "eauto_profile", "label": "E-Auto · Fahrprofile" },
        { "value": "eauto_recommendations", "label": "E-Auto · Empfehlungen" },
        { "value": "eauto_smart_energy", "label": "E-Auto · Smart Energy" },
        { "value": "eauto_installation", "label": "E-Auto · Installation" },
        { "value": "eauto_faq", "label": "E-Auto · FAQ" },
        { "value": "custom", "label": "自定义锚点（高级）" }
      ],
      "default": "custom"
    },
    {
      "type": "text",
      "id": "cta_target",
      "label": "自定义锚点 ID（高级）",
      "info": "仅当上方选择“自定义锚点”时填写，可带或不带 #。",
      "visible_if": "{{ section.settings.cta_module == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "control_size",
      "label": "控件大小",
      "min": 11,
      "max": 18,
      "step": 0.5,
      "unit": "px",
      "default": 13.5
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Navigationslink",
      "settings": [
        {
          "type": "select",
          "id": "module",
          "label": "链接到模块",
          "options": [
            { "value": "eauto_start", "label": "E-Auto · Start" },
            { "value": "eauto_problem", "label": "E-Auto · Problem" },
            { "value": "eauto_flow", "label": "E-Auto · Energiefluss" },
            { "value": "eauto_day", "label": "E-Auto · Typischer Tag" },
            { "value": "eauto_profile", "label": "E-Auto · Fahrprofile" },
            { "value": "eauto_calculator", "label": "E-Auto · Rechner" },
            { "value": "eauto_recommendations", "label": "E-Auto · Empfehlungen" },
            { "value": "eauto_smart_energy", "label": "E-Auto · Smart Energy" },
            { "value": "eauto_installation", "label": "E-Auto · Installation" },
            { "value": "eauto_faq", "label": "E-Auto · FAQ" },
            { "value": "custom", "label": "自定义锚点（高级）" }
          ],
          "default": "custom"
        },
        {
          "type": "text",
          "id": "label",
          "label": "标签",
          "default": "Navigation",
          "info": "模块决定链接目标；此处仅用于自定义导航显示文字。"
        },
        {
          "type": "text",
          "id": "target",
          "label": "自定义锚点 ID（高级）",
          "info": "仅当上方选择“自定义锚点”时填写，可带或不带 #。",
          "visible_if": "{{ block.settings.module == 'custom' }}"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "E-Auto Navigation",
      "settings": {
        "anchor_id": "eauto-navigation",
        "aria_label": "E-Auto Seitennavigation",
        "cta_label": "Passenden Speicher finden",
        "cta_module": "eauto_calculator",
        "cta_target": ""
      },
      "blocks": [
        { "type": "link", "settings": { "label": "Start", "module": "eauto_start" } },
        { "type": "link", "settings": { "label": "Problem", "module": "eauto_problem" } },
        { "type": "link", "settings": { "label": "Energiefluss", "module": "eauto_flow" } },
        { "type": "link", "settings": { "label": "Typischer Tag", "module": "eauto_day" } },
        { "type": "link", "settings": { "label": "Fahrprofile", "module": "eauto_profile" } },
        { "type": "link", "settings": { "label": "Rechner", "module": "eauto_calculator" } },
        { "type": "link", "settings": { "label": "Empfehlungen", "module": "eauto_recommendations" } },
        { "type": "link", "settings": { "label": "Smart Energy", "module": "eauto_smart_energy" } },
        { "type": "link", "settings": { "label": "Installation", "module": "eauto_installation" } },
        { "type": "link", "settings": { "label": "FAQ", "module": "eauto_faq" } }
      ]
    }
  ]
}
{% endschema %}
