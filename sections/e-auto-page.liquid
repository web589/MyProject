{% liquid
  assign page_id = 'eauto-' | append: section.id

  assign product_mini = section.settings.product_mini
  assign product_3 = section.settings.product_3
  assign product_4 = section.settings.product_4
  assign product_max = section.settings.product_max

  if product_mini == blank
    assign product_mini = all_products['venus-e-mini']
  endif
  if product_3 == blank
    assign product_3 = all_products['venus-e-3']
  endif
  if product_4 == blank
    assign product_4 = all_products['venus-e-4']
  endif
  if product_max == blank
    assign product_max = all_products['venus-e-max']
  endif

  assign mini_preorder = false
  assign product_3_preorder = false
  assign product_4_preorder = false
  assign max_preorder = false
  if product_mini != blank
    assign mini_preorder = product_mini.metafields.custom.preorder_enabled.value
  endif
  if product_3 != blank
    assign product_3_preorder = product_3.metafields.custom.preorder_enabled.value
  endif
  if product_4 != blank
    assign product_4_preorder = product_4.metafields.custom.preorder_enabled.value
  endif
  if product_max != blank
    assign max_preorder = product_max.metafields.custom.preorder_enabled.value
  endif

  assign hero_primary_link = section.settings.hero_primary_link | default: '#eauto-calculator'
  assign hero_secondary_link = section.settings.hero_secondary_link | default: '#eauto-flow'
  assign final_primary_link = section.settings.final_primary_link | default: '#eauto-calculator'
%}

<div
  id="{{ page_id }}"
  class="e-auto-page"
  data-eauto-page
  data-section-id="{{ section.id }}"
  data-eauto-available-label="{{ section.settings.available_label | escape }}"
  data-eauto-unavailable-label="{{ section.settings.unavailable_label | escape }}"
  data-eauto-preorder-label="{{ section.settings.preorder_label | escape }}"
  data-eauto-primary-label="{{ section.settings.card_recommendation_label | escape }}"
  data-eauto-alternative-label="ALTERNATIVE KONFIGURATION"
  data-eauto-variant-unavailable-label="Variante nicht gefunden"
>
  <section id="eauto-start" class="e-auto-page__hero" aria-labelledby="{{ page_id }}-hero-heading">
    <div class="e-auto-page__container e-auto-page__hero-grid">
      <div class="e-auto-page__hero-copy">
        {% if section.settings.hero_eyebrow != blank %}<p class="e-auto-page__eyebrow">{{ section.settings.hero_eyebrow }}</p>{% endif %}
        <h1 id="{{ page_id }}-hero-heading">{{ section.settings.hero_heading }}</h1>
        {% if section.settings.hero_text != blank %}<p class="e-auto-page__lead">{{ section.settings.hero_text }}</p>{% endif %}
        <div class="e-auto-page__actions">
          <a class="e-auto-page__button e-auto-page__button--primary" href="{{ hero_primary_link }}">{{ section.settings.hero_primary_label }} <span aria-hidden="true">→</span></a>
          <a class="e-auto-page__button e-auto-page__button--secondary" href="{{ hero_secondary_link }}">{{ section.settings.hero_secondary_label }}</a>
        </div>
        <div class="e-auto-page__stats" aria-label="{{ section.settings.hero_stats_label }}">
          <div><strong>{{ section.settings.hero_stat_1_value }}</strong><span>{{ section.settings.hero_stat_1_label }}</span></div>
          <div><strong>{{ section.settings.hero_stat_2_value }}</strong><span>{{ section.settings.hero_stat_2_label }}</span></div>
          <div><strong>{{ section.settings.hero_stat_3_value }}</strong><span>{{ section.settings.hero_stat_3_label }}</span></div>
        </div>
      </div>
      <div class="e-auto-page__media e-auto-page__media--hero">
        {% if section.settings.hero_image != blank %}
          {{ section.settings.hero_image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '480, 720, 960, 1200, 1600', sizes: '(min-width: 960px) 52vw, 100vw', alt: section.settings.hero_image_alt }}
        {% elsif request.design_mode %}
          <div class="e-auto-page__placeholder">{{ section.settings.hero_image_placeholder }}</div>
        {% endif %}
      </div>
    </div>
  </section>

  <section id="eauto-problem" class="e-auto-page__section e-auto-page__problem" aria-labelledby="{{ page_id }}-problem-heading">
    <div class="e-auto-page__container">
      <div class="e-auto-page__section-heading">
        <p class="e-auto-page__eyebrow">{{ section.settings.problem_eyebrow }}</p>
        <h2 id="{{ page_id }}-problem-heading">{{ section.settings.problem_heading }}</h2>
        <p>{{ section.settings.problem_text }}</p>
      </div>
      <div class="e-auto-page__problem-grid">
        <div class="e-auto-page__media e-auto-page__media--wide">
          {% if section.settings.problem_image != blank %}
            {{ section.settings.problem_image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '640, 960, 1280, 1600, 1800', sizes: '100vw', alt: section.settings.problem_image_alt }}
          {% elsif request.design_mode %}
            <div class="e-auto-page__placeholder">{{ section.settings.problem_image_placeholder }}</div>
          {% endif %}
        </div>
        <div class="e-auto-page__problem-cards">
          <article>
            <span class="e-auto-page__time">{{ section.settings.problem_card_1_kicker }}</span>
            <h3>{{ section.settings.problem_card_1_heading }}</h3>
            <p>{{ section.settings.problem_card_1_text }}</p>
          </article>
          <article>
            <span class="e-auto-page__time">{{ section.settings.problem_card_2_kicker }}</span>
            <h3>{{ section.settings.problem_card_2_heading }}</h3>
            <p>{{ section.settings.problem_card_2_text }}</p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section id="eauto-flow" class="e-auto-page__section e-auto-page__flow" aria-labelledby="{{ page_id }}-flow-heading">
    <div class="e-auto-page__container">
      <div class="e-auto-page__section-heading">
        <p class="e-auto-page__eyebrow">{{ section.settings.flow_eyebrow }}</p>
        <h2 id="{{ page_id }}-flow-heading">{{ section.settings.flow_heading }}</h2>
        <p>{{ section.settings.flow_text }}</p>
      </div>
      <div class="e-auto-page__toggle" role="tablist" aria-label="{{ section.settings.flow_toggle_label }}">
        <button type="button" class="is-active" data-eauto-flow-toggle="day" role="tab" aria-selected="true">{{ section.settings.flow_day_label }}</button>
        <button type="button" data-eauto-flow-toggle="evening" role="tab" aria-selected="false">{{ section.settings.flow_evening_label }}</button>
      </div>
      <div class="e-auto-page__flow-panel is-active" data-eauto-flow-panel="day" role="tabpanel">
        <div class="e-auto-page__flow-copy">
          <h3>{{ section.settings.flow_day_heading }}</h3>
          <p>{{ section.settings.flow_day_text }}</p>
          <ul>
            <li>{{ section.settings.flow_day_point_1 }}</li>
            <li>{{ section.settings.flow_day_point_2 }}</li>
            <li>{{ section.settings.flow_day_point_3 }}</li>
          </ul>
        </div>
        <div class="e-auto-page__media e-auto-page__media--flow">
          {% if section.settings.flow_day_video != blank %}
            {{ section.settings.flow_day_video | video_tag: controls: false, autoplay: false, loop: true, muted: true, playsinline: true, preload: 'metadata' }}
          {% elsif section.settings.flow_day_image != blank %}
            {{ section.settings.flow_day_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '640, 960, 1280, 1600', sizes: '(min-width: 960px) 58vw, 100vw', alt: section.settings.flow_day_image_alt }}
          {% elsif request.design_mode %}
            <div class="e-auto-page__placeholder">{{ section.settings.flow_image_placeholder }}</div>
          {% endif %}
        </div>
      </div>
      <div class="e-auto-page__flow-panel" data-eauto-flow-panel="evening" role="tabpanel" hidden>
        <div class="e-auto-page__flow-copy">
          <h3>{{ section.settings.flow_evening_heading }}</h3>
          <p>{{ section.settings.flow_evening_text }}</p>
          <ul>
            <li>{{ section.settings.flow_evening_point_1 }}</li>
            <li>{{ section.settings.flow_evening_point_2 }}</li>
            <li>{{ section.settings.flow_evening_point_3 }}</li>
          </ul>
        </div>
        <div class="e-auto-page__media e-auto-page__media--flow">
          {% if section.settings.flow_evening_video != blank %}
            {{ section.settings.flow_evening_video | video_tag: controls: false, autoplay: false, loop: true, muted: true, playsinline: true, preload: 'metadata' }}
          {% elsif section.settings.flow_evening_image != blank %}
            {{ section.settings.flow_evening_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '640, 960, 1280, 1600', sizes: '(min-width: 960px) 58vw, 100vw', alt: section.settings.flow_evening_image_alt }}
          {% elsif request.design_mode %}
            <div class="e-auto-page__placeholder">{{ section.settings.flow_image_placeholder }}</div>
          {% endif %}
        </div>
      </div>
      {% if section.settings.flow_note != blank %}<p class="e-auto-page__note">{{ section.settings.flow_note }}</p>{% endif %}
    </div>
  </section>

  <section id="eauto-day" class="e-auto-page__section e-auto-page__timeline" aria-labelledby="{{ page_id }}-timeline-heading">
    <div class="e-auto-page__container">
      <div class="e-auto-page__section-heading">
        <p class="e-auto-page__eyebrow">{{ section.settings.timeline_eyebrow }}</p>
        <h2 id="{{ page_id }}-timeline-heading">{{ section.settings.timeline_heading }}</h2>
        <p>{{ section.settings.timeline_text }}</p>
      </div>
      <div class="e-auto-page__timeline-grid" role="list">
        {% assign timeline_blocks = section.blocks | where: 'type', 'timeline' %}
        {% for block in timeline_blocks %}
          <article class="e-auto-page__timeline-item" role="listitem" {{ block.shopify_attributes }}>
            <div class="e-auto-page__timeline-time">{{ block.settings.time }}</div>
            <div class="e-auto-page__media e-auto-page__media--timeline">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 960px) 25vw, 90vw', alt: block.settings.image_alt }}
              {% elsif request.design_mode %}
                <div class="e-auto-page__placeholder">{{ block.settings.image_placeholder }}</div>
              {% endif %}
            </div>
            <h3>{{ block.settings.heading }}</h3>
            <p>{{ block.settings.text }}</p>
            {% if block.settings.badge != blank %}<span class="e-auto-page__timeline-badge">{{ block.settings.badge }}</span>{% endif %}
          </article>
        {% endfor %}
      </div>
    </div>
  </section>

  <section id="eauto-profile" class="e-auto-page__section e-auto-page__profiles" aria-labelledby="{{ page_id }}-profile-heading">
    <div class="e-auto-page__container">
      <div class="e-auto-page__section-heading">
        <p class="e-auto-page__eyebrow">{{ section.settings.profile_eyebrow }}</p>
        <h2 id="{{ page_id }}-profile-heading">{{ section.settings.profile_heading }}</h2>
        <p>{{ section.settings.profile_text }}</p>
      </div>
      <div class="e-auto-page__profile-layout">
        <div class="e-auto-page__profile-tabs" role="tablist" aria-label="{{ section.settings.profile_tab_label }}">
          {% assign profile_blocks = section.blocks | where: 'type', 'profile' %}
          {% for block in profile_blocks %}
            <button type="button" class="e-auto-page__profile-tab{% if forloop.first %} is-active{% endif %}" data-eauto-profile-tab="{{ block.id }}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>
              <strong>{{ block.settings.title }}</strong>
              <span>{{ block.settings.summary }}</span>
            </button>
          {% endfor %}
        </div>
        <div class="e-auto-page__profile-details">
          {% for block in profile_blocks %}
            <div class="e-auto-page__profile-detail{% if forloop.first %} is-active{% endif %}" data-eauto-profile-panel="{{ block.id }}" role="tabpanel"{% unless forloop.first %} hidden{% endunless %}>
              <div class="e-auto-page__media e-auto-page__media--profile">
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1100', sizes: '(min-width: 960px) 55vw, 100vw', alt: block.settings.image_alt }}
                {% elsif request.design_mode %}
                  <div class="e-auto-page__placeholder">{{ block.settings.image_placeholder }}</div>
                {% endif %}
              </div>
              <div>
                <h3>{{ block.settings.title }}</h3>
                <p>{{ block.settings.summary }}</p>
                <p class="e-auto-page__profile-focus"><strong>{{ section.settings.profile_focus_label }}</strong> {{ block.settings.focus }}</p>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
      {% if section.settings.profile_note != blank %}<p class="e-auto-page__note">{{ section.settings.profile_note }}</p>{% endif %}
    </div>
  </section>

  <section id="eauto-calculator" class="e-auto-page__section e-auto-page__calculator-section" aria-labelledby="{{ page_id }}-calculator-heading">
    <div class="e-auto-page__container">
      <div class="e-auto-page__section-heading">
        <p class="e-auto-page__eyebrow">{{ section.settings.calculator_eyebrow }}</p>
        <h2 id="{{ page_id }}-calculator-heading">{{ section.settings.calculator_heading }}</h2>
        <p>{{ section.settings.calculator_text }}</p>
      </div>
      <div class="e-auto-page__calculator" data-eauto-calculator>
        <div class="e-auto-page__calculator-steps">
          <div class="e-auto-page__calculator-step">
            <span class="e-auto-page__step-number">01</span>
            <h3>{{ section.settings.distance_heading }}</h3>
            <div class="e-auto-page__option-grid" data-eauto-option-group="distance">
              <button type="button" class="is-active" data-eauto-option data-eauto-value="under20" aria-pressed="true">Unter 20 km</button>
              <button type="button" data-eauto-option data-eauto-value="20to40" aria-pressed="false">20–40 km</button>
              <button type="button" data-eauto-option data-eauto-value="40to80" aria-pressed="false">40–80 km</button>
              <button type="button" data-eauto-option data-eauto-value="over80" aria-pressed="false">Über 80 km</button>
            </div>
          </div>
          <div class="e-auto-page__calculator-step">
            <span class="e-auto-page__step-number">02</span>
            <h3>{{ section.settings.efficiency_heading }}</h3>
            <div class="e-auto-page__option-grid" data-eauto-option-group="efficiency">
              <button type="button" class="is-active" data-eauto-option data-eauto-value="efficient" aria-pressed="true">Effizient <small>(bis 16)</small></button>
              <button type="button" data-eauto-option data-eauto-value="average" aria-pressed="false">Durchschnitt <small>(17–21)</small></button>
              <button type="button" data-eauto-option data-eauto-value="high" aria-pressed="false">Verbrauchsstark <small>(über 21)</small></button>
            </div>
          </div>
          <div class="e-auto-page__calculator-step">
            <span class="e-auto-page__step-number">03</span>
            <h3>{{ section.settings.pv_heading }}</h3>
            <div class="e-auto-page__option-grid" data-eauto-option-group="pv">
              <button type="button" data-eauto-option data-eauto-value="low" aria-pressed="false">Wenig / unbekannt</button>
              <button type="button" class="is-active" data-eauto-option data-eauto-value="medium" aria-pressed="true">Mittel <small>(ca. 5–15 kWh)</small></button>
              <button type="button" data-eauto-option data-eauto-value="high" aria-pressed="false">Viel <small>(über 15 kWh)</small></button>
            </div>
          </div>
          <div class="e-auto-page__calculator-step">
            <span class="e-auto-page__step-number">04</span>
            <h3>{{ section.settings.charge_heading }}</h3>
            <div class="e-auto-page__option-grid" data-eauto-option-group="chargeWindow">
              <button type="button" class="is-active" data-eauto-option data-eauto-value="evening" aria-pressed="true">Abends / nachts</button>
              <button type="button" data-eauto-option data-eauto-value="daytime" aria-pressed="false">Tagsüber zu Hause</button>
            </div>
          </div>
        </div>
        <aside class="e-auto-page__calculator-result" aria-live="polite">
          <span class="e-auto-page__eyebrow">{{ section.settings.result_eyebrow }}</span>
          <strong data-eauto-result-range>2–5 kWh</strong>
          <h3 data-eauto-result-model>{{ section.settings.result_loading_model }}</h3>
          <p data-eauto-result-copy>{{ section.settings.result_loading_copy }}</p>
          <a class="e-auto-page__button e-auto-page__button--primary" href="#eauto-recommendations">{{ section.settings.result_button_label }} <span aria-hidden="true">→</span></a>
          {% if section.settings.result_note != blank %}<small>{{ section.settings.result_note }}</small>{% endif %}
        </aside>
      </div>
    </div>
  </section>

  <section id="eauto-recommendations" class="e-auto-page__section e-auto-page__recommendations" aria-labelledby="{{ page_id }}-recommendations-heading">
    <div class="e-auto-page__container">
      <div class="e-auto-page__section-heading">
        <p class="e-auto-page__eyebrow">{{ section.settings.recommendations_eyebrow }}</p>
        <h2 id="{{ page_id }}-recommendations-heading">{{ section.settings.recommendations_heading }}</h2>
        <p data-eauto-recommendations-summary>{{ section.settings.recommendations_text }}</p>
      </div>
      <div class="e-auto-page__recommendation-grid" data-eauto-recommendation-grid>
        {% for index in (0..2) %}
          <article class="e-auto-page__product-card" data-eauto-card="{{ index }}">
            <a class="e-auto-page__product-card-media" data-eauto-card-link href="#">
              <img data-eauto-card-image hidden loading="lazy" width="720" height="720" alt="">
              <span data-eauto-card-placeholder>{{ section.settings.card_loading_label }}</span>
            </a>
            <div class="e-auto-page__product-card-body">
              <span class="e-auto-page__product-card-badge" data-eauto-card-badge>{{ section.settings.card_recommendation_label }}</span>
              <h3><a data-eauto-card-title-link href="#"><span data-eauto-card-title>{{ section.settings.card_loading_label }}</span></a></h3>
              <p class="e-auto-page__product-card-variant" data-eauto-card-variant></p>
              <p class="e-auto-page__product-card-capacity" data-eauto-card-capacity></p>
              <div class="e-auto-page__product-card-meta">
                <strong data-eauto-card-price>—</strong>
                <span data-eauto-card-availability>{{ section.settings.card_loading_label }}</span>
              </div>
              <a class="e-auto-page__button e-auto-page__button--secondary" data-eauto-card-action href="#">{{ section.settings.card_cta_label }}</a>
            </div>
          </article>
        {% endfor %}
      </div>
      {% if section.settings.recommendations_note != blank %}<p class="e-auto-page__note">{{ section.settings.recommendations_note }}</p>{% endif %}
    </div>
  </section>

  <section id="eauto-smart-energy" class="e-auto-page__section e-auto-page__smart" aria-labelledby="{{ page_id }}-smart-heading">
    <div class="e-auto-page__container">
      <div class="e-auto-page__section-heading">
        <p class="e-auto-page__eyebrow">{{ section.settings.smart_eyebrow }}</p>
        <h2 id="{{ page_id }}-smart-heading">{{ section.settings.smart_heading }}</h2>
        <p>{{ section.settings.smart_text }}</p>
      </div>
      <div class="e-auto-page__smart-grid">
        {% for index in (1..3) %}
          {% assign title_key = 'smart_' | append: index | append: '_title' %}
          {% assign text_key = 'smart_' | append: index | append: '_text' %}
          <article><span>0{{ index }}</span><h3>{{ section.settings[title_key] }}</h3><p>{{ section.settings[text_key] }}</p></article>
        {% endfor %}
        <div class="e-auto-page__media e-auto-page__media--smart">
          {% if section.settings.smart_image != blank %}
            {{ section.settings.smart_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200', sizes: '(min-width: 960px) 50vw, 100vw', alt: section.settings.smart_image_alt }}
          {% elsif request.design_mode %}
            <div class="e-auto-page__placeholder">{{ section.settings.smart_image_placeholder }}</div>
          {% endif %}
        </div>
      </div>
    </div>
  </section>

  <section id="eauto-installation" class="e-auto-page__section e-auto-page__installation" aria-labelledby="{{ page_id }}-installation-heading">
    <div class="e-auto-page__container">
      <div class="e-auto-page__section-heading">
        <p class="e-auto-page__eyebrow">{{ section.settings.installation_eyebrow }}</p>
        <h2 id="{{ page_id }}-installation-heading">{{ section.settings.installation_heading }}</h2>
        <p>{{ section.settings.installation_text }}</p>
      </div>
      <div class="e-auto-page__installation-grid">
        <div class="e-auto-page__media e-auto-page__media--installation">
          {% if section.settings.installation_image != blank %}
            {{ section.settings.installation_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '540, 800, 1100, 1400', sizes: '(min-width: 960px) 55vw, 100vw', alt: section.settings.installation_image_alt }}
          {% elsif request.design_mode %}
            <div class="e-auto-page__placeholder">{{ section.settings.installation_image_placeholder }}</div>
          {% endif %}
        </div>
        <div class="e-auto-page__installation-copy">
          <h3>{{ section.settings.installation_card_heading }}</h3>
          <p>{{ section.settings.installation_card_text }}</p>
          <ul>
            <li>{{ section.settings.installation_point_1 }}</li>
            <li>{{ section.settings.installation_point_2 }}</li>
            <li>{{ section.settings.installation_point_3 }}</li>
          </ul>
          <div class="e-auto-page__install-steps">
            {% assign install_blocks = section.blocks | where: 'type', 'install_step' %}
            {% for block in install_blocks %}
              <div {{ block.shopify_attributes }}><span>{{ forloop.index }}</span><strong>{{ block.settings.title }}</strong><small>{{ block.settings.text }}</small></div>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="eauto-benefits" class="e-auto-page__section e-auto-page__benefits" aria-labelledby="{{ page_id }}-benefits-heading">
    <div class="e-auto-page__container">
      <div class="e-auto-page__section-heading">
        <p class="e-auto-page__eyebrow">{{ section.settings.benefits_eyebrow }}</p>
        <h2 id="{{ page_id }}-benefits-heading">{{ section.settings.benefits_heading }}</h2>
        <p>{{ section.settings.benefits_text }}</p>
      </div>
      <div class="e-auto-page__benefits-grid">
        {% assign benefit_blocks = section.blocks | where: 'type', 'benefit' %}
        {% for block in benefit_blocks %}
          <article {{ block.shopify_attributes }}><strong>{{ block.settings.value }}</strong><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></article>
        {% endfor %}
      </div>
    </div>
  </section>

  <section id="eauto-trust" class="e-auto-page__section e-auto-page__trust" aria-labelledby="{{ page_id }}-trust-heading">
    <div class="e-auto-page__container">
      <div class="e-auto-page__section-heading">
        <p class="e-auto-page__eyebrow">{{ section.settings.trust_eyebrow }}</p>
        <h2 id="{{ page_id }}-trust-heading">{{ section.settings.trust_heading }}</h2>
        <p>{{ section.settings.trust_text }}</p>
      </div>
      <div class="e-auto-page__trust-grid">
        {% assign trust_blocks = section.blocks | where: 'type', 'trust' %}
        {% for block in trust_blocks %}
          <article {{ block.shopify_attributes }}><strong>{{ block.settings.value }}</strong><p>{{ block.settings.text }}</p></article>
        {% endfor %}
      </div>
    </div>
  </section>

  <section id="eauto-faq" class="e-auto-page__section e-auto-page__faq" aria-labelledby="{{ page_id }}-faq-heading">
    <div class="e-auto-page__container e-auto-page__faq-container">
      <div class="e-auto-page__section-heading">
        <p class="e-auto-page__eyebrow">{{ section.settings.faq_eyebrow }}</p>
        <h2 id="{{ page_id }}-faq-heading">{{ section.settings.faq_heading }}</h2>
        <p>{{ section.settings.faq_text }}</p>
      </div>
      <div class="e-auto-page__faq-list">
        {% assign faq_blocks = section.blocks | where: 'type', 'faq' %}
        {% for block in faq_blocks %}
          <div class="e-auto-page__faq-item" {{ block.shopify_attributes }}>
            <button type="button" class="e-auto-page__faq-question" data-eauto-faq-question aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}">
              <span>{{ block.settings.question }}</span><span aria-hidden="true">+</span>
            </button>
            <div class="e-auto-page__faq-answer" data-eauto-faq-answer{% unless forloop.first %} hidden{% endunless %}>{{ block.settings.answer }}</div>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <section id="eauto-final" class="e-auto-page__final" aria-labelledby="{{ page_id }}-final-heading">
    <div class="e-auto-page__container e-auto-page__final-inner">
      <div>
        <p class="e-auto-page__eyebrow">{{ section.settings.final_eyebrow }}</p>
        <h2 id="{{ page_id }}-final-heading">{{ section.settings.final_heading }}</h2>
        <p>{{ section.settings.final_text }}</p>
        <a class="e-auto-page__button e-auto-page__button--primary" href="{{ final_primary_link }}">{{ section.settings.final_primary_label }} <span aria-hidden="true">→</span></a>
      </div>
      <div class="e-auto-page__media e-auto-page__media--final">
        {% if section.settings.final_image != blank %}
          {{ section.settings.final_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '640, 960, 1280, 1600', sizes: '(min-width: 960px) 50vw, 100vw', alt: section.settings.final_image_alt }}
        {% elsif request.design_mode %}
          <div class="e-auto-page__placeholder">{{ section.settings.final_image_placeholder }}</div>
        {% endif %}
      </div>
    </div>
  </section>

