{% liquid
  assign page_id = 'eauto-' | append: section.id
%}

<section id="eauto-profile" class="e-auto-page e-auto-page__section e-auto-page__profiles" style="--eauto-heading-size: {{ section.settings.heading_size }}px; --eauto-copy-size: {{ section.settings.copy_size }}px; --eauto-section-space: {{ section.settings.section_spacing }}px; --eauto-profile-media-height: {{ section.settings.profile_media_height }}px;" aria-labelledby="{{ page_id }}-profile-heading">
  <div class="e-auto-page__container">
    <div class="e-auto-page__section-heading">
      <p class="e-auto-page__eyebrow">{{ section.settings.profile_eyebrow }}</p>
      <h2 id="{{ page_id }}-profile-heading">{{ section.settings.profile_heading }}{% if section.settings.profile_heading_accent != blank %} <span>{{ section.settings.profile_heading_accent }}</span>{% endif %}</h2>
      <p>{{ section.settings.profile_text }}</p>
    </div>
    <div class="e-auto-page__profile-layout">
      <div class="e-auto-page__profile-tabs" role="tablist" aria-label="{{ section.settings.profile_tab_label }}">
        {% for block in section.blocks %}
          <button type="button" class="e-auto-page__profile-tab{% if forloop.first %} is-active{% endif %}" data-eauto-profile-tab="{{ block.id }}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>
            <strong>{{ block.settings.title }}</strong>
            <span>{{ block.settings.summary }}</span>
          </button>
        {% endfor %}
      </div>
      <div class="e-auto-page__profile-details">
        {% for block in section.blocks %}
          <div class="e-auto-page__profile-detail{% if forloop.first %} is-active{% endif %}" data-eauto-profile-panel="{{ block.id }}" role="tabpanel"{% unless forloop.first %} hidden{% endunless %}>
            <div class="e-auto-page__media e-auto-page__media--profile">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1100', sizes: '(min-width: 960px) 55vw, 100vw', alt: block.settings.image_alt }}
              {% elsif request.design_mode %}
                <div class="e-auto-page__placeholder">{{ block.settings.image_placeholder }}</div>
              {% endif %}
            </div>
            <div class="e-auto-page__profile-copy">
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.summary }}</p>
              <p class="e-auto-page__profile-focus"><strong>{{ section.settings.profile_focus_label }}</strong> {{ block.settings.focus }}</p>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
    {% if section.settings.profile_note != blank %}<p class="e-auto-page__note">{{ section.settings.profile_note }}</p>{% endif %}
  </div>
</section>

{% schema %}
{
  "name": "E-Auto 用车画像",
  "tag": "section",
  "class": "section-e-auto-profile",
  "settings": [
    {"type":"text","id":"profile_eyebrow","label":"用车画像小标题","default":"Dein Fahrprofil"},
    {"type":"text","id":"profile_heading","label":"用车画像标题（主体）","default":"Welches Ladeprofil"},
    {"type":"text","id":"profile_heading_accent","label":"用车画像标题（蓝色强调）","default":"passt zu dir?"},
    {"type":"textarea","id":"profile_text","label":"用车画像说明","default":"Vier typische Alltage. Wähle ein Profil und sieh, worauf es bei deinem Speicher ankommt."},
    {"type":"text","id":"profile_tab_label","label":"画像标签说明","default":"Fahrprofile auswählen"},
    {"type":"text","id":"profile_focus_label","label":"画像重点标签","default":"Speicher-Fokus:"},
    {"type":"textarea","id":"profile_note","label":"画像提示","default":"Kein Profil passt exakt? Die Kapazitätswahl berücksichtigt deine tatsächlichen Angaben."},
    {"type":"header","content":"布局与尺寸"},
    {"type":"range","id":"heading_size","label":"标题字号","min":28,"max":60,"step":1,"unit":"px","default":42},
    {"type":"range","id":"copy_size","label":"文案字号","min":13,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"profile_media_height","label":"画像图片高度","min":260,"max":560,"step":10,"unit":"px","default":410},
    {"type":"range","id":"section_spacing","label":"区块上下间距","min":40,"max":140,"step":4,"unit":"px","default":80}
  ],
  "blocks": [
    {"type":"profile","name":"用车画像项","settings":[{"type":"text","id":"title","label":"标题","default":"Pendler"},{"type":"textarea","id":"summary","label":"简短说明","default":"Jeden Tag ins Büro, ca. 30–60 km hin und zurück."},{"type":"textarea","id":"focus","label":"储能重点","default":"Mittelgroße Kapazität für das Laden am Abend."},{"type":"image_picker","id":"image","label":"图片"},{"type":"text","id":"image_alt","label":"图片替代文本","default":"E-Auto Fahrprofil"},{"type":"text","id":"image_placeholder","label":"图片占位提示","default":"Profilbild auswählen"}]}
  ],
  "max_blocks": 4,
  "presets": [{"name":"E-Auto 用车画像","blocks":[{"type":"profile"},{"type":"profile"},{"type":"profile"},{"type":"profile"}] }]
}
{% endschema %}
