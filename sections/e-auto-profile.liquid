{% liquid
  assign page_id = 'eauto-' | append: section.id
%}

<section id="eauto-profile" class="e-auto-page e-auto-page__section e-auto-page__profiles" style="--eauto-heading-size: {{ section.settings.heading_size }}px; --eauto-copy-size: {{ section.settings.copy_size }}px; --eauto-eyebrow-size: {{ section.settings.eyebrow_size | default: 11 }}px; --eauto-item-heading-size: {{ section.settings.item_heading_size | default: 18 }}px; --eauto-item-text-size: {{ section.settings.item_text_size | default: 12 }}px; --eauto-control-size: {{ section.settings.control_size | default: 16 }}px; --eauto-value-size: {{ section.settings.value_size | default: 34 }}px; --eauto-note-size: {{ section.settings.note_size | default: 12 }}px; --eauto-section-space: {{ section.settings.section_spacing }}px; --eauto-profile-media-height: {{ section.settings.profile_media_height }}px; --eauto-media-width: {{ section.settings.profile_media_width | default: 100 }}%;" aria-labelledby="{{ page_id }}-profile-heading">
  <div class="e-auto-page__container">
    <div class="e-auto-page__section-heading">
      <p class="e-auto-page__eyebrow">{{ section.settings.profile_eyebrow }}</p>
      <h2 id="{{ page_id }}-profile-heading">{{ section.settings.profile_heading }}{% if section.settings.profile_heading_accent != blank %} <span>{{ section.settings.profile_heading_accent }}</span>{% endif %}</h2>
      <p>{{ section.settings.profile_text }}</p>
    </div>
    <div class="e-auto-page__profile-layout">
      <div class="e-auto-page__profile-tabs" role="tablist" aria-label="{{ section.settings.profile_tab_label }}">
        {% for block in section.blocks %}
          <button id="{{ page_id }}-profile-tab-{{ block.id }}" type="button" class="e-auto-page__profile-tab{% if forloop.first %} is-active{% endif %}" data-eauto-profile-tab="{{ block.id }}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"{% unless forloop.first %} tabindex="-1"{% endunless %} aria-controls="{{ page_id }}-profile-panel-{{ block.id }}" {{ block.shopify_attributes }}>
            <strong>{{ block.settings.title }}</strong>
            <span>{{ block.settings.summary }}</span>
          </button>
        {% endfor %}
      </div>
      <div class="e-auto-page__profile-details">
        {% for block in section.blocks %}
          <div id="{{ page_id }}-profile-panel-{{ block.id }}" class="e-auto-page__profile-detail{% if forloop.first %} is-active{% endif %}" data-eauto-profile-panel="{{ block.id }}" role="tabpanel" aria-labelledby="{{ page_id }}-profile-tab-{{ block.id }}"{% unless forloop.first %} hidden{% endunless %}>
            <div class="e-auto-page__media e-auto-page__media--profile">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1100', sizes: '(min-width: 960px) 55vw, 100vw', alt: block.settings.image_alt }}
              {% else %}
                <div class="e-auto-page__placeholder">{{ block.settings.image_placeholder }}</div>
              {% endif %}
            </div>
            <div class="e-auto-page__profile-copy">
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.summary }}</p>
              <p class="e-auto-page__profile-focus"><strong>{{ section.settings.profile_focus_label }}</strong> {{ block.settings.focus }}</p>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
    {% if section.settings.profile_note != blank %}<p class="e-auto-page__note">{{ section.settings.profile_note }}</p>{% endif %}
  </div>
</section>

{% schema %}
{
  "name": "E-Auto Fahrprofile",
  "tag": "section",
  "class": "section-e-auto-profile",
  "settings": [
    {"type":"text","id":"profile_eyebrow","label":"Profil Kicker","default":"Dein Fahrprofil"},
    {"type":"text","id":"profile_heading","label":"Profil Überschrift – Hauptteil","default":"Welches Ladeprofil"},
    {"type":"text","id":"profile_heading_accent","label":"Profil Überschrift – blauer Akzent","default":"passt zu dir?"},
    {"type":"textarea","id":"profile_text","label":"Profil Text","default":"Vier typische Alltage. Wähle ein Profil und sieh, worauf es bei deinem Speicher ankommt."},
    {"type":"text","id":"profile_tab_label","label":"Profil Tab Label","default":"Fahrprofile auswählen"},
    {"type":"text","id":"profile_focus_label","label":"Profil Fokus Label","default":"Speicher-Fokus:"},
    {"type":"textarea","id":"profile_note","label":"Profil Hinweis","default":"Kein Profil passt exakt? Die Kapazitätswahl berücksichtigt deine tatsächlichen Angaben."},
    {"type":"header","content":"Typography"},
    {"type":"range","id":"eyebrow_size","label":"Kicker Größe","min":9,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"item_heading_size","label":"Profil Überschrift Größe","min":14,"max":30,"step":1,"unit":"px","default":18},
    {"type":"range","id":"item_text_size","label":"Profil Text Größe","min":10,"max":20,"step":0.5,"unit":"px","default":14},
    {"type":"range","id":"control_size","label":"Profil Tab Größe","min":11,"max":20,"step":1,"unit":"px","default":16},
    {"type":"range","id":"value_size","label":"Wert Größe","min":20,"max":64,"step":1,"unit":"px","default":34},
    {"type":"range","id":"note_size","label":"Hinweis Größe","min":10,"max":16,"step":0.5,"unit":"px","default":13},
    {"type":"header","content":"Layout und Größen"},
    {"type":"range","id":"heading_size","label":"Überschrift Größe","min":28,"max":60,"step":1,"unit":"px","default":40},
    {"type":"range","id":"copy_size","label":"Textgröße","min":13,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"profile_media_height","label":"Fahrprofil Bildhöhe","min":260,"max":560,"step":10,"unit":"px","default":410},
    {"type":"range","id":"profile_media_width","label":"Fahrprofil Bildbreite","min":70,"max":100,"step":1,"unit":"%","default":100},
    {"type":"range","id":"section_spacing","label":"Abstand oben und unten","min":40,"max":140,"step":4,"unit":"px","default":68}
  ],
  "blocks": [
    {"type":"profile","name":"Fahrprofil","settings":[{"type":"text","id":"title","label":"Titel","default":"Pendler"},{"type":"textarea","id":"summary","label":"Kurzbeschreibung","default":"Jeden Tag ins Büro, ca. 30–60 km hin und zurück."},{"type":"textarea","id":"focus","label":"Speicher-Fokus","default":"Mittelgroße Kapazität für das Laden am Abend."},{"type":"image_picker","id":"image","label":"Bild"},{"type":"text","id":"image_alt","label":"Bild Alt-Text","default":"E-Auto Fahrprofil"},{"type":"text","id":"image_placeholder","label":"Bild Platzhalter","default":"Profilbild auswählen"}]}
  ],
  "max_blocks": 4,
  "presets": [{"name":"E-Auto Fahrprofile","blocks":[{"type":"profile"},{"type":"profile"},{"type":"profile"},{"type":"profile"}] }]
}
{% endschema %}
