{% liquid
  assign page_id = 'eauto-' | append: section.id
  assign product_mini = section.settings.product_mini
  assign product_3 = section.settings.product_3
  assign product_4 = section.settings.product_4
  assign product_max = section.settings.product_max

  if product_mini == blank
    assign product_mini = all_products['venus-e-mini']
  endif
  if product_3 == blank
    assign product_3 = all_products['venus-e-3']
  endif
  if product_4 == blank
    assign product_4 = all_products['venus-e-4']
  endif
  if product_max == blank
    assign product_max = all_products['venus-e-max']
  endif

  assign mini_preorder = false
  assign product_3_preorder = false
  assign product_4_preorder = false
  assign max_preorder = false
  if product_mini != blank
    assign mini_preorder = product_mini.metafields.custom.preorder_enabled.value
  endif
  if product_3 != blank
    assign product_3_preorder = product_3.metafields.custom.preorder_enabled.value
  endif
  if product_4 != blank
    assign product_4_preorder = product_4.metafields.custom.preorder_enabled.value
  endif
  if product_max != blank
    assign max_preorder = product_max.metafields.custom.preorder_enabled.value
  endif
%}

<section
  id="eauto-recommendations"
  class="e-auto-page e-auto-page__section e-auto-page__recommendations"
  style="--eauto-heading-size: {{ section.settings.heading_size }}px; --eauto-copy-size: {{ section.settings.copy_size }}px; --eauto-eyebrow-size: {{ section.settings.eyebrow_size | default: 10 }}px; --eauto-item-heading-size: {{ section.settings.item_heading_size | default: 18 }}px; --eauto-item-text-size: {{ section.settings.item_text_size | default: 12 }}px; --eauto-control-size: {{ section.settings.control_size | default: 14 }}px; --eauto-value-size: {{ section.settings.value_size | default: 15 }}px; --eauto-note-size: {{ section.settings.note_size | default: 12 }}px; --eauto-section-space: {{ section.settings.section_spacing }}px; --eauto-recommendation-media-height: {{ section.settings.recommendation_media_height }}px; --eauto-media-width: {{ section.settings.recommendation_media_width | default: 100 }}%;"
  data-eauto-page
  data-section-id="{{ section.id }}"
  data-eauto-available-label="{{ section.settings.available_label | escape }}"
  data-eauto-unavailable-label="{{ section.settings.unavailable_label | escape }}"
  data-eauto-preorder-label="{{ section.settings.preorder_label | escape }}"
  data-eauto-primary-label="{{ section.settings.card_recommendation_label | escape }}"
  data-eauto-alternative-label="{{ section.settings.alternative_label | escape }}"
  data-eauto-variant-unavailable-label="{{ section.settings.variant_unavailable_label | escape }}"
  data-eauto-summary-template="{{ section.settings.recommendations_summary_template | escape }}"
  aria-labelledby="{{ page_id }}-recommendations-heading"
>
  <div class="e-auto-page__container">
    <div class="e-auto-page__section-heading">
      <p class="e-auto-page__eyebrow">{{ section.settings.recommendations_eyebrow }}</p>
      <h2 id="{{ page_id }}-recommendations-heading">{{ section.settings.recommendations_heading }}{% if section.settings.recommendations_heading_accent != blank %} <span>{{ section.settings.recommendations_heading_accent }}</span>{% endif %}</h2>
      <p data-eauto-recommendations-summary>{{ section.settings.recommendations_text }}</p>
    </div>
    <div class="e-auto-page__recommendation-grid" data-eauto-recommendation-grid>
      {% for index in (0..2) %}
        {% assign card_block = section.blocks[index] %}
        {% assign card_fallback_product = product_mini %}
        {% if index == 1 %}{% assign card_fallback_product = product_3 %}{% endif %}
        {% if index == 2 %}{% assign card_fallback_product = product_4 %}{% endif %}
        {% assign card_fallback_url = card_fallback_product.url | default: '/collections/alle-venus-e-serie' %}
        <article
          class="e-auto-page__product-card"
          data-eauto-card="{{ index }}"
          data-eauto-card-badge-override="{{ card_block.settings.badge | escape }}"
          data-eauto-card-title-override="{{ card_block.settings.title | escape }}"
          data-eauto-card-variant-override="{{ card_block.settings.variant | escape }}"
          data-eauto-card-capacity-override="{{ card_block.settings.capacity | escape }}"
          data-eauto-card-price-override="{{ card_block.settings.price | escape }}"
          data-eauto-card-availability-override="{{ card_block.settings.availability | escape }}"
          data-eauto-card-cta-label-override="{{ card_block.settings.cta_label | escape }}"
          data-eauto-card-cta-link-override="{{ card_block.settings.cta_link | escape }}"
          data-eauto-card-default-cta-label="{{ section.settings.card_cta_label | escape }}"
          {% if card_block != blank %}{{ card_block.shopify_attributes }}{% endif %}
        >
          <a class="e-auto-page__product-card-media" data-eauto-card-link href="{{ card_fallback_url }}">
            <img data-eauto-card-image hidden loading="lazy" width="720" height="720" alt="">
            <span data-eauto-card-placeholder>{{ section.settings.card_loading_label }}</span>
          </a>
          <div class="e-auto-page__product-card-body">
            <span class="e-auto-page__product-card-badge" data-eauto-card-badge>{{ section.settings.card_recommendation_label }}</span>
            <h3><a data-eauto-card-title-link href="{{ card_fallback_url }}"><span data-eauto-card-title>{{ section.settings.card_loading_label }}</span></a></h3>
            <p class="e-auto-page__product-card-variant" data-eauto-card-variant></p>
            <p class="e-auto-page__product-card-capacity" data-eauto-card-capacity></p>
            <p class="e-auto-page__product-card-description" data-eauto-card-description hidden></p>
            <div class="e-auto-page__product-card-meta">
              <strong data-eauto-card-price>–</strong>
              <span data-eauto-card-availability>{{ section.settings.card_loading_label }}</span>
            </div>
            <a class="e-auto-page__button e-auto-page__button--secondary" data-eauto-card-action href="{{ card_block.settings.cta_link | default: card_fallback_url }}">{{ card_block.settings.cta_label | default: section.settings.card_cta_label }}</a>
          </div>
        </article>
      {% endfor %}
    </div>
    {% if section.settings.recommendations_note != blank %}<p class="e-auto-page__note">{{ section.settings.recommendations_note }}</p>{% endif %}
  </div>
  <script type="application/json" data-eauto-product-data>
    {
      "mini": {
        "id": {{ product_mini.id | append: '' | json }},
        "handle": {{ product_mini.handle | json }},
        "title": {{ product_mini.title | json }},
        "url": {{ product_mini.url | json }},
        "featured_image": {% if product_mini.featured_image != blank %}{{ product_mini.featured_image | image_url: width: 1000 | json }}{% else %}null{% endif %},
        "preorder_enabled": {{ mini_preorder | default: false | json }},
        "variants": [{% if product_mini != blank %}{% for variant in product_mini.variants %}{"id":{{ variant.id | append: '' | json }},"title":{{ variant.title | json }},"options":{{ variant.options | json }},"available":{{ variant.available | json }},"price":{{ variant.price | json }},"compare_at_price":{{ variant.compare_at_price | json }},"image":{% if variant.featured_image != blank %}{{ variant.featured_image | image_url: width: 1000 | json }}{% elsif product_mini.featured_image != blank %}{{ product_mini.featured_image | image_url: width: 1000 | json }}{% else %}null{% endif %},"url":{{ product_mini.url | append: '?variant=' | append: variant.id | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}{% endif %}]
      },
      "venus3": {
        "id": {{ product_3.id | append: '' | json }},
        "handle": {{ product_3.handle | json }},
        "title": {{ product_3.title | json }},
        "url": {{ product_3.url | json }},
        "featured_image": {% if product_3.featured_image != blank %}{{ product_3.featured_image | image_url: width: 1000 | json }}{% else %}null{% endif %},
        "preorder_enabled": {{ product_3_preorder | default: false | json }},
        "variants": [{% if product_3 != blank %}{% for variant in product_3.variants %}{"id":{{ variant.id | append: '' | json }},"title":{{ variant.title | json }},"options":{{ variant.options | json }},"available":{{ variant.available | json }},"price":{{ variant.price | json }},"compare_at_price":{{ variant.compare_at_price | json }},"image":{% if variant.featured_image != blank %}{{ variant.featured_image | image_url: width: 1000 | json }}{% elsif product_3.featured_image != blank %}{{ product_3.featured_image | image_url: width: 1000 | json }}{% else %}null{% endif %},"url":{{ product_3.url | append: '?variant=' | append: variant.id | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}{% endif %}]
      },
      "venus4": {
        "id": {{ product_4.id | append: '' | json }},
        "handle": {{ product_4.handle | json }},
        "title": {{ product_4.title | json }},
        "url": {{ product_4.url | json }},
        "featured_image": {% if product_4.featured_image != blank %}{{ product_4.featured_image | image_url: width: 1000 | json }}{% else %}null{% endif %},
        "preorder_enabled": {{ product_4_preorder | default: false | json }},
        "variants": [{% if product_4 != blank %}{% for variant in product_4.variants %}{"id":{{ variant.id | append: '' | json }},"title":{{ variant.title | json }},"options":{{ variant.options | json }},"available":{{ variant.available | json }},"price":{{ variant.price | json }},"compare_at_price":{{ variant.compare_at_price | json }},"image":{% if variant.featured_image != blank %}{{ variant.featured_image | image_url: width: 1000 | json }}{% elsif product_4.featured_image != blank %}{{ product_4.featured_image | image_url: width: 1000 | json }}{% else %}null{% endif %},"url":{{ product_4.url | append: '?variant=' | append: variant.id | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}{% endif %}]
      },
      "max": {
        "id": {{ product_max.id | append: '' | json }},
        "handle": {{ product_max.handle | json }},
        "title": {{ product_max.title | json }},
        "url": {{ product_max.url | json }},
        "featured_image": {% if product_max.featured_image != blank %}{{ product_max.featured_image | image_url: width: 1000 | json }}{% else %}null{% endif %},
        "preorder_enabled": {{ max_preorder | default: false | json }},
        "variants": [{% if product_max != blank %}{% for variant in product_max.variants %}{"id":{{ variant.id | append: '' | json }},"title":{{ variant.title | json }},"options":{{ variant.options | json }},"available":{{ variant.available | json }},"price":{{ variant.price | json }},"compare_at_price":{{ variant.compare_at_price | json }},"image":{% if variant.featured_image != blank %}{{ variant.featured_image | image_url: width: 1000 | json }}{% elsif product_max.featured_image != blank %}{{ product_max.featured_image | image_url: width: 1000 | json }}{% else %}null{% endif %},"url":{{ product_max.url | append: '?variant=' | append: variant.id | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}{% endif %}]
      }
    }
  </script>
</section>

{% schema %}
{
  "name": "E-Auto Empfehlungen",
  "tag": "section",
  "class": "section-e-auto-recommendations",
  "blocks": [
    {
      "type": "card_copy",
      "name": "Empfehlungskarte",
      "settings": [
        {"type":"text","id":"badge","label":"Badge überschreiben","info":"Leer lassen für EMPFOHLENE/ALTERNATIVE KONFIGURATION."},
        {"type":"text","id":"title","label":"Titel überschreiben","info":"Leer lassen für den Shopify-Produkttitel."},
        {"type":"text","id":"variant","label":"Konfiguration überschreiben","info":"Leer lassen für den automatisch ermittelten Variantentitel."},
        {"type":"text","id":"capacity","label":"Kapazität überschreiben","info":"Leer lassen für die automatisch berechnete Kapazität."},
        {"type":"text","id":"price","label":"Preis überschreiben","info":"Leer lassen für den aktuellen Shopify-Preis."},
        {"type":"text","id":"availability","label":"Verfügbarkeit überschreiben","info":"Leer lassen für den aktuellen Shopify-Status."},
        {"type":"text","id":"cta_label","label":"Button überschreiben","info":"Leer lassen für den globalen Karten-CTA."},
        {"type":"url","id":"cta_link","label":"Button-Link überschreiben","info":"Leer lassen für den automatisch ermittelten Produkt-Link."}
      ]
    }
  ],
  "max_blocks": 3,
  "settings": [
    {"type":"product","id":"product_mini","label":"VENUS E Mini Produkt"},
    {"type":"product","id":"product_3","label":"VENUS E 3.0 Produkt"},
    {"type":"product","id":"product_4","label":"VENUS E 4.0 Produkt"},
    {"type":"product","id":"product_max","label":"VENUS E Max Produkt"},
    {"type":"text","id":"recommendations_eyebrow","label":"Empfehlungen Kicker","default":"Deine Optionen"},
    {"type":"text","id":"recommendations_heading","label":"Empfehlungen Überschrift – Hauptteil","default":"Welche VENUS E Lösung"},
    {"type":"text","id":"recommendations_heading_accent","label":"Empfehlungen Überschrift – blauer Akzent","default":"passt dazu?"},
    {"type":"textarea","id":"recommendations_text","label":"Empfehlungen Text","default":"Die drei Konfigurationen werden direkt aus deiner Auswahl und den aktuellen Shopify-Produktdaten zusammengestellt."},
    {"type":"textarea","id":"recommendations_summary_template","label":"Dynamische Empfehlung Zusammenfassung","info":"Verfügbare Variablen: range, lower, upper, unit.","default":"Kapazitätsbereich: [[range]]. Preise und Verfügbarkeit werden direkt aus Shopify geladen."},
    {"type":"textarea","id":"recommendations_note","label":"Empfehlungen Hinweis","default":"Preise, Varianten, Bilder und Verfügbarkeit werden direkt aus Shopify gelesen."},
    {"type":"text","id":"card_recommendation_label","label":"Karten Badge","default":"EMPFOHLENE KONFIGURATION"},
    {"type":"text","id":"alternative_label","label":"Alternatives Karten Badge","default":"ALTERNATIVE KONFIGURATION"},
    {"type":"text","id":"variant_unavailable_label","label":"Variante fehlt Label","default":"Variante nicht gefunden"},
    {"type":"text","id":"card_loading_label","label":"Karten Ladezustand","default":"Konfiguration wird geladen"},
    {"type":"text","id":"card_cta_label","label":"Karten CTA","default":"Produkt ansehen"},
    {"type":"text","id":"available_label","label":"Verfügbar Label","default":"Verfügbar"},
    {"type":"text","id":"unavailable_label","label":"Nicht verfügbar Label","default":"Derzeit nicht verfügbar"},
    {"type":"text","id":"preorder_label","label":"Vormerkung Label","default":"Demnächst verfügbar"},
    {"type":"header","content":"Typography"},
    {"type":"range","id":"eyebrow_size","label":"Badge und Label Größe","min":9,"max":18,"step":1,"unit":"px","default":10},
    {"type":"range","id":"item_heading_size","label":"Produkt Titel Größe","min":14,"max":30,"step":1,"unit":"px","default":18},
    {"type":"range","id":"item_text_size","label":"Produkt Text Größe","min":10,"max":20,"step":1,"unit":"px","default":12},
    {"type":"range","id":"control_size","label":"Button Größe","min":11,"max":18,"step":1,"unit":"px","default":14},
    {"type":"range","id":"value_size","label":"Preis Größe","min":12,"max":24,"step":1,"unit":"px","default":15},
    {"type":"range","id":"note_size","label":"Hinweis Größe","min":10,"max":16,"step":1,"unit":"px","default":12},
    {"type":"header","content":"Layout und Größen"},
    {"type":"range","id":"heading_size","label":"Überschrift Größe","min":28,"max":60,"step":1,"unit":"px","default":40},
    {"type":"range","id":"copy_size","label":"Textgröße","min":13,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"recommendation_media_height","label":"Produkt Bildhöhe","min":180,"max":420,"step":10,"unit":"px","default":220},
    {"type":"range","id":"recommendation_media_width","label":"Produkt Bildbreite","min":70,"max":100,"step":1,"unit":"%","default":100},
    {"type":"range","id":"section_spacing","label":"Abstand oben und unten","min":40,"max":140,"step":4,"unit":"px","default":68}
  ],
  "presets": [{"name":"E-Auto Empfehlungen"}]
}
{% endschema %}
