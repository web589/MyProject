{% liquid
  assign page_id = 'eauto-' | append: section.id
%}

<section id="eauto-smart-energy" class="e-auto-page e-auto-page__section e-auto-page__smart" style="--eauto-heading-size: {{ section.settings.heading_size }}px; --eauto-copy-size: {{ section.settings.copy_size }}px; --eauto-section-space: {{ section.settings.section_spacing }}px; --eauto-smart-media-height: {{ section.settings.smart_media_height }}px;" aria-labelledby="{{ page_id }}-smart-heading">
  <div class="e-auto-page__container">
    <div class="e-auto-page__section-heading">
      <p class="e-auto-page__eyebrow">{{ section.settings.smart_eyebrow }}</p>
      <h2 id="{{ page_id }}-smart-heading">{{ section.settings.smart_heading }}{% if section.settings.smart_heading_accent != blank %} <span>{{ section.settings.smart_heading_accent }}</span>{% endif %}</h2>
      <p>{{ section.settings.smart_text }}</p>
    </div>
    <div class="e-auto-page__smart-grid">
      {% for index in (1..3) %}
        {% assign number_key = 'smart_' | append: index | append: '_number' %}
        {% assign title_key = 'smart_' | append: index | append: '_title' %}
        {% assign text_key = 'smart_' | append: index | append: '_text' %}
        <article><span>{{ section.settings[number_key] }}</span><h3>{{ section.settings[title_key] }}</h3><p>{{ section.settings[text_key] }}</p></article>
      {% endfor %}
      <div class="e-auto-page__media e-auto-page__media--smart">
        {% if section.settings.smart_image != blank %}
          {{ section.settings.smart_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200', sizes: '(min-width: 960px) 50vw, 100vw', alt: section.settings.smart_image_alt }}
        {% elsif request.design_mode %}
          <div class="e-auto-page__placeholder">{{ section.settings.smart_image_placeholder }}</div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "E-Auto 智能能源",
  "tag": "section",
  "class": "section-e-auto-smart-energy",
  "settings": [
    {"type":"text","id":"smart_eyebrow","label":"智能能源小标题","default":"Smart Energy"},
    {"type":"text","id":"smart_heading","label":"智能能源标题（主体）","default":"Intelligent steuern statt einfach entladen"},
    {"type":"text","id":"smart_heading_accent","label":"智能能源标题（蓝色强调）","default":""},
    {"type":"textarea","id":"smart_text","label":"智能能源说明","default":"Der VENUS E beobachtet Produktion, Haushalt und Ladebedarf und unterstützt eine passendere Nutzung deines Solarstroms."},
    {"type":"image_picker","id":"smart_image","label":"智能能源图片"},
    {"type":"text","id":"smart_image_alt","label":"智能能源图片替代文本","default":"App, Smart Meter und VENUS E im Alltag"},
    {"type":"text","id":"smart_image_placeholder","label":"智能能源图片占位提示","default":"Smart-Energy-Bild auswählen"},
    {"type":"text","id":"smart_1_number","label":"智能要点 1 序号","default":"01"},
    {"type":"text","id":"smart_1_title","label":"智能要点 1 标题","default":"Verbrauch erkennen"},
    {"type":"textarea","id":"smart_1_text","label":"智能要点 1 文案","default":"Das Smart Meter erfasst, was PV, Haushalt und Wallbox gerade benötigen."},
    {"type":"text","id":"smart_2_number","label":"智能要点 2 序号","default":"02"},
    {"type":"text","id":"smart_2_title","label":"智能要点 2 标题","default":"Leistung anpassen"},
    {"type":"textarea","id":"smart_2_text","label":"智能要点 2 文案","default":"Das System passt Lade- und Entladevorgänge an den tatsächlichen Bedarf an."},
    {"type":"text","id":"smart_3_number","label":"智能要点 3 序号","default":"03"},
    {"type":"text","id":"smart_3_title","label":"智能要点 3 标题","default":"Netzbezug reduzieren"},
    {"type":"textarea","id":"smart_3_text","label":"智能要点 3 文案","default":"Gespeicherter Solarstrom steht auch dann zur Verfügung, wenn die PV gerade wenig produziert."},
    {"type":"header","content":"布局与尺寸"},
    {"type":"range","id":"heading_size","label":"标题字号","min":28,"max":60,"step":1,"unit":"px","default":42},
    {"type":"range","id":"copy_size","label":"文案字号","min":13,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"smart_media_height","label":"智能能源图片高度","min":260,"max":560,"step":10,"unit":"px","default":420},
    {"type":"range","id":"section_spacing","label":"区块上下间距","min":40,"max":140,"step":4,"unit":"px","default":80}
  ],
  "presets": [{"name":"E-Auto 智能能源"}]
}
{% endschema %}
