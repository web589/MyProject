{% liquid
  assign page_id = 'eauto-' | append: section.id
%}

<section id="eauto-smart-energy" class="e-auto-page e-auto-page__section e-auto-page__smart" style="--eauto-heading-size: {{ section.settings.heading_size }}px; --eauto-copy-size: {{ section.settings.copy_size }}px; --eauto-eyebrow-size: {{ section.settings.eyebrow_size | default: 11 }}px; --eauto-item-heading-size: {{ section.settings.item_heading_size | default: 15 }}px; --eauto-item-text-size: {{ section.settings.item_text_size | default: 12 }}px; --eauto-control-size: {{ section.settings.control_size | default: 12 }}px; --eauto-value-size: {{ section.settings.value_size | default: 34 }}px; --eauto-note-size: {{ section.settings.note_size | default: 12 }}px; --eauto-section-space: {{ section.settings.section_spacing }}px; --eauto-smart-media-height: {{ section.settings.smart_media_height }}px; --eauto-media-width: {{ section.settings.smart_media_width | default: 100 }}%;" aria-labelledby="{{ page_id }}-smart-heading">
  <div class="e-auto-page__container">
    <div class="e-auto-page__section-heading">
      <p class="e-auto-page__eyebrow">{{ section.settings.smart_eyebrow }}</p>
      <h2 id="{{ page_id }}-smart-heading">{{ section.settings.smart_heading }}{% if section.settings.smart_heading_accent != blank %} <span>{{ section.settings.smart_heading_accent }}</span>{% endif %}</h2>
      <p>{{ section.settings.smart_text }}</p>
    </div>
    <div class="e-auto-page__smart-grid">
      {% for index in (1..3) %}
        {% assign number_key = 'smart_' | append: index | append: '_number' %}
        {% assign title_key = 'smart_' | append: index | append: '_title' %}
        {% assign text_key = 'smart_' | append: index | append: '_text' %}
        <article><span>{{ section.settings[number_key] }}</span><h3>{{ section.settings[title_key] }}</h3><p>{{ section.settings[text_key] }}</p></article>
      {% endfor %}
      <div class="e-auto-page__media e-auto-page__media--smart">
        {% if section.settings.smart_image != blank %}
          {{ section.settings.smart_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200', sizes: '(min-width: 960px) 50vw, 100vw', alt: section.settings.smart_image_alt }}
        {% else %}
          <div class="e-auto-page__placeholder">{{ section.settings.smart_image_placeholder }}</div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "E-Auto Smart Energy",
  "tag": "section",
  "class": "section-e-auto-smart-energy",
  "settings": [
    {"type":"text","id":"smart_eyebrow","label":"智能眉题","default":"Smart Energy"},
    {"type":"text","id":"smart_heading","label":"智能标题","default":"Intelligent steuern statt einfach entladen"},
    {"type":"text","id":"smart_heading_accent","label":"智能标题强调部分"},
    {"type":"textarea","id":"smart_text","label":"智能文本","default":"Der VENUS E beobachtet Produktion, Haushalt und Ladebedarf und unterstützt eine passendere Nutzung deines Solarstroms."},
    {"type":"image_picker","id":"smart_image","label":"智能图片"},
    {"type":"text","id":"smart_image_alt","label":"智能图片替代文字","default":"App, Smart Meter und VENUS E im Alltag"},
    {"type":"text","id":"smart_image_placeholder","label":"智能图片占位文字","default":"Smart-Energy-Bild auswählen"},
    {"type":"text","id":"smart_1_number","label":"智能1编号","default":"01"},
    {"type":"text","id":"smart_1_title","label":"智能1标题","default":"Verbrauch erkennen"},
    {"type":"textarea","id":"smart_1_text","label":"智能1文本","default":"Das Smart Meter erfasst, was PV, Haushalt und Wallbox gerade benötigen."},
    {"type":"text","id":"smart_2_number","label":"智能2编号","default":"02"},
    {"type":"text","id":"smart_2_title","label":"智能2标题","default":"Leistung anpassen"},
    {"type":"textarea","id":"smart_2_text","label":"智能2文本","default":"Das System passt Lade- und Entladevorgänge an den tatsächlichen Bedarf an."},
    {"type":"text","id":"smart_3_number","label":"智能3编号","default":"03"},
    {"type":"text","id":"smart_3_title","label":"智能3标题","default":"Netzbezug reduzieren"},
    {"type":"textarea","id":"smart_3_text","label":"智能3文本","default":"Gespeicherter Solarstrom steht auch dann zur Verfügung, wenn die PV gerade wenig produziert."},
    {"type":"header","content":"Typography"},
    {"type":"range","id":"eyebrow_size","label":"眉题大小","min":9,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"item_heading_size","label":"项目标题大小","min":14,"max":26,"step":0.5,"unit":"px","default":19},
    {"type":"range","id":"item_text_size","label":"项目文本大小","min":10,"max":20,"step":0.5,"unit":"px","default":14},
    {"type":"range","id":"control_size","label":"控件大小","min":11,"max":18,"step":1,"unit":"px","default":12},
    {"type":"range","id":"value_size","label":"数值大小","min":20,"max":64,"step":1,"unit":"px","default":34},
    {"type":"range","id":"note_size","label":"备注大小","min":10,"max":16,"step":0.5,"unit":"px","default":13},
    {"type":"header","content":"Layout und Größen"},
    {"type":"range","id":"heading_size","label":"标题大小","min":28,"max":60,"step":1,"unit":"px","default":40},
    {"type":"range","id":"copy_size","label":"文案大小","min":13,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"smart_media_height","label":"智能媒体高度","min":260,"max":560,"step":10,"unit":"px","default":420},
    {"type":"range","id":"smart_media_width","label":"智能媒体宽度","min":70,"max":100,"step":1,"unit":"%","default":100},
    {"type":"range","id":"section_spacing","label":"区块间距","min":40,"max":140,"step":4,"unit":"px","default":68}
  ],
  "presets": [{"name":"E-Auto Smart Energy"}]
}
{% endschema %}
