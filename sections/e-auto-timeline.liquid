{% liquid
  assign page_id = 'eauto-' | append: section.id
%}

<section id="eauto-day" class="e-auto-page e-auto-page__section e-auto-page__timeline" style="--eauto-heading-size: {{ section.settings.heading_size }}px; --eauto-copy-size: {{ section.settings.copy_size }}px; --eauto-eyebrow-size: {{ section.settings.eyebrow_size | default: 11 }}px; --eauto-item-heading-size: {{ section.settings.item_heading_size | default: 16 }}px; --eauto-item-text-size: {{ section.settings.item_text_size | default: 13 }}px; --eauto-control-size: {{ section.settings.control_size | default: 12 }}px; --eauto-value-size: {{ section.settings.value_size | default: 34 }}px; --eauto-note-size: {{ section.settings.note_size | default: 12 }}px; --eauto-section-space: {{ section.settings.section_spacing }}px; --eauto-timeline-media-height: {{ section.settings.timeline_media_height }}px; --eauto-media-width: {{ section.settings.timeline_media_width | default: 100 }}%;" aria-labelledby="{{ page_id }}-timeline-heading">
  <div class="e-auto-page__container">
    <div class="e-auto-page__section-heading">
      <p class="e-auto-page__eyebrow">{{ section.settings.timeline_eyebrow }}</p>
      <h2 id="{{ page_id }}-timeline-heading">{{ section.settings.timeline_heading }}{% if section.settings.timeline_heading_accent != blank %} <span>{{ section.settings.timeline_heading_accent }}</span>{% endif %}</h2>
      {% if section.settings.timeline_text != blank %}<p>{{ section.settings.timeline_text }}</p>{% endif %}
    </div>
    <div class="e-auto-page__timeline-frame">
      <div class="e-auto-page__timeline-grid" role="list">
        {% for block in section.blocks %}
          <article class="e-auto-page__timeline-item" role="listitem" {{ block.shopify_attributes }}>
            {% if block.settings.time_link != blank %}
              <a class="e-auto-page__timeline-time" href="{{ block.settings.time_link | escape }}" aria-label="{{ block.settings.time | escape }}">{{ block.settings.time }}</a>
            {% else %}
              <span class="e-auto-page__timeline-time">{{ block.settings.time }}</span>
            {% endif %}
            <div class="e-auto-page__media e-auto-page__media--timeline">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 960px) 25vw, 90vw', alt: block.settings.image_alt }}
              {% else %}
                <div class="e-auto-page__placeholder">{{ block.settings.image_placeholder }}</div>
              {% endif %}
              {% if block.settings.badge != blank %}<span class="e-auto-page__timeline-badge">{{ block.settings.badge }}</span>{% endif %}
            </div>
            <div class="e-auto-page__timeline-copy">
              <h3>{{ block.settings.heading }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          </article>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "E-Auto Typischer Tag",
  "tag": "section",
  "class": "section-e-auto-timeline",
  "settings": [
    {"type":"text","id":"timeline_eyebrow","label":"时间线眉题","default":"Ein typischer Tag"},
    {"type":"text","id":"timeline_heading","label":"时间线标题","default":"So sieht ein Tag"},
    {"type":"text","id":"timeline_heading_accent","label":"时间线标题强调部分","default":"mit PV, Speicher und E-Auto aus"},
    {"type":"textarea","id":"timeline_text","label":"时间线文本","default":"Vier Momente zeigen, wie dein Solarstrom vom Mittag bis zum Laden am Abend verschoben wird."},
    {"type":"header","content":"Typography"},
    {"type":"range","id":"eyebrow_size","label":"眉题大小","min":9,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"item_heading_size","label":"项目标题大小","min":14,"max":30,"step":0.5,"unit":"px","default":17},
    {"type":"range","id":"item_text_size","label":"项目文本大小","min":10,"max":20,"step":0.5,"unit":"px","default":13.5},
    {"type":"range","id":"control_size","label":"控件大小","min":11,"max":18,"step":1,"unit":"px","default":12},
    {"type":"range","id":"value_size","label":"数值大小","min":20,"max":64,"step":1,"unit":"px","default":34},
    {"type":"range","id":"note_size","label":"备注大小","min":10,"max":16,"step":0.5,"unit":"px","default":13},
    {"type":"header","content":"Layout und Größen"},
    {"type":"range","id":"heading_size","label":"标题大小","min":28,"max":60,"step":1,"unit":"px","default":40},
    {"type":"range","id":"copy_size","label":"文案大小","min":13,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"timeline_media_height","label":"时间线媒体高度","min":150,"max":360,"step":10,"unit":"px","default":220},
    {"type":"range","id":"timeline_media_width","label":"时间线媒体宽度","min":70,"max":100,"step":1,"unit":"%","default":100},
    {"type":"range","id":"section_spacing","label":"区块间距","min":40,"max":140,"step":4,"unit":"px","default":68}
  ],
  "blocks": [
    {"type":"timeline","name":"Typischer Tag","settings":[{"type":"text","id":"time","label":"时间","default":"08:00"},{"type":"url","id":"time_link","label":"时间链接"},{"type":"image_picker","id":"image","label":"图片"},{"type":"text","id":"image_alt","label":"图片替代文字","default":"E-Auto im Tagesverlauf"},{"type":"text","id":"image_placeholder","label":"图片占位文字","default":"Timeline-Bild auswählen"},{"type":"text","id":"heading","label":"标题","default":"Auto unterwegs"},{"type":"textarea","id":"text","label":"文本","default":"Das Auto fährt los, die PV-Anlage startet in den Tag."},{"type":"text","id":"badge","label":"徽标","default":"PV-Überschuss"}]}
  ],
  "max_blocks": 4,
  "presets": [{"name":"E-Auto Typischer Tag","blocks":[{"type":"timeline"},{"type":"timeline"},{"type":"timeline"},{"type":"timeline"}] }]
}
{% endschema %}
