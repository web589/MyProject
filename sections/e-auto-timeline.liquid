{% liquid
  assign page_id = 'eauto-' | append: section.id
%}

<section id="eauto-day" class="e-auto-page e-auto-page__section e-auto-page__timeline" style="--eauto-heading-size: {{ section.settings.heading_size }}px; --eauto-copy-size: {{ section.settings.copy_size }}px; --eauto-section-space: {{ section.settings.section_spacing }}px; --eauto-timeline-media-height: {{ section.settings.timeline_media_height }}px;" aria-labelledby="{{ page_id }}-timeline-heading">
  <div class="e-auto-page__container">
    <div class="e-auto-page__section-heading">
      <p class="e-auto-page__eyebrow">{{ section.settings.timeline_eyebrow }}</p>
      <h2 id="{{ page_id }}-timeline-heading">{{ section.settings.timeline_heading }}{% if section.settings.timeline_heading_accent != blank %} <span>{{ section.settings.timeline_heading_accent }}</span>{% endif %}</h2>
      <p>{{ section.settings.timeline_text }}</p>
    </div>
    <div class="e-auto-page__timeline-grid" role="list">
      {% for block in section.blocks %}
        <article class="e-auto-page__timeline-item" role="listitem" {{ block.shopify_attributes }}>
          <div class="e-auto-page__timeline-time">{{ block.settings.time }}</div>
          <div class="e-auto-page__media e-auto-page__media--timeline">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 960px) 25vw, 90vw', alt: block.settings.image_alt }}
            {% elsif request.design_mode %}
              <div class="e-auto-page__placeholder">{{ block.settings.image_placeholder }}</div>
            {% endif %}
          </div>
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
          {% if block.settings.badge != blank %}<span class="e-auto-page__timeline-badge">{{ block.settings.badge }}</span>{% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "E-Auto 典型日",
  "tag": "section",
  "class": "section-e-auto-timeline",
  "settings": [
    {"type":"text","id":"timeline_eyebrow","label":"典型日小标题","default":"Ein typischer Tag"},
    {"type":"text","id":"timeline_heading","label":"典型日标题（主体）","default":"So sieht ein Tag"},
    {"type":"text","id":"timeline_heading_accent","label":"典型日标题（蓝色强调）","default":"mit PV, Speicher und E-Auto aus"},
    {"type":"textarea","id":"timeline_text","label":"典型日说明","default":"Vier Momente zeigen, wie dein Solarstrom vom Mittag bis zum Laden am Abend verschoben wird."},
    {"type":"header","content":"布局与尺寸"},
    {"type":"range","id":"heading_size","label":"标题字号","min":28,"max":60,"step":1,"unit":"px","default":42},
    {"type":"range","id":"copy_size","label":"文案字号","min":13,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"timeline_media_height","label":"时间线图片高度","min":150,"max":360,"step":10,"unit":"px","default":220},
    {"type":"range","id":"section_spacing","label":"区块上下间距","min":40,"max":140,"step":4,"unit":"px","default":80}
  ],
  "blocks": [
    {"type":"timeline","name":"典型日节点","settings":[{"type":"text","id":"time","label":"时间","default":"08:00"},{"type":"image_picker","id":"image","label":"图片"},{"type":"text","id":"image_alt","label":"图片替代文本","default":"E-Auto im Tagesverlauf"},{"type":"text","id":"image_placeholder","label":"图片占位提示","default":"Timeline-Bild auswählen"},{"type":"text","id":"heading","label":"标题","default":"Auto unterwegs"},{"type":"textarea","id":"text","label":"文案","default":"Das Auto fährt los, die PV-Anlage startet in den Tag."},{"type":"text","id":"badge","label":"标签","default":"PV-Überschuss"}]}
  ],
  "max_blocks": 4,
  "presets": [{"name":"E-Auto 典型日","blocks":[{"type":"timeline"},{"type":"timeline"},{"type":"timeline"},{"type":"timeline"}] }]
}
{% endschema %}
