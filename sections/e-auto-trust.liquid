{% liquid
  assign page_id = 'eauto-' | append: section.id
%}

<section id="eauto-trust" class="e-auto-page e-auto-page__section e-auto-page__trust" style="--eauto-heading-size: {{ section.settings.heading_size }}px; --eauto-copy-size: {{ section.settings.copy_size }}px; --eauto-eyebrow-size: {{ section.settings.eyebrow_size | default: 11 }}px; --eauto-item-heading-size: {{ section.settings.item_heading_size | default: 24 }}px; --eauto-item-text-size: {{ section.settings.item_text_size | default: 11 }}px; --eauto-control-size: {{ section.settings.control_size | default: 12 }}px; --eauto-value-size: {{ section.settings.value_size | default: 24 }}px; --eauto-note-size: {{ section.settings.note_size | default: 12 }}px; --eauto-section-space: {{ section.settings.section_spacing }}px; --eauto-trust-media-height: {{ section.settings.trust_media_height }}px; --eauto-media-width: {{ section.settings.trust_media_width | default: 100 }}%;" aria-labelledby="{{ page_id }}-trust-heading">
  <div class="e-auto-page__container">
    <div class="e-auto-page__trust-layout">
      <div class="e-auto-page__media e-auto-page__media--trust">
        {% if section.settings.trust_image != blank %}
          {{ section.settings.trust_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200', sizes: '(min-width: 960px) 50vw, 100vw', alt: section.settings.trust_image_alt }}
        {% else %}
          <div class="e-auto-page__placeholder">{{ section.settings.trust_image_placeholder }}</div>
        {% endif %}
      </div>
      <div>
        <div class="e-auto-page__section-heading">
          <p class="e-auto-page__eyebrow">{{ section.settings.trust_eyebrow }}</p>
          <h2 id="{{ page_id }}-trust-heading">{{ section.settings.trust_heading }}{% if section.settings.trust_heading_accent != blank %} <span>{{ section.settings.trust_heading_accent }}</span>{% endif %}</h2>
          <p>{{ section.settings.trust_text }}</p>
        </div>
        <div class="e-auto-page__trust-grid">
          {% for block in section.blocks %}
            <article {{ block.shopify_attributes }}><strong>{{ block.settings.value }}{% if block.settings.value_label != blank %}<span>{{ block.settings.value_label }}</span>{% endif %}</strong><p>{{ block.settings.text }}</p></article>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "E-Auto Vertrauen",
  "tag": "section",
  "class": "section-e-auto-trust",
  "settings": [
    {"type":"text","id":"trust_eyebrow","label":"信任眉题","default":"Vertrauen & Alltagstauglichkeit"},
    {"type":"text","id":"trust_heading","label":"信任标题","default":"Gebaut für den täglichen Einsatz"},
    {"type":"text","id":"trust_heading_accent","label":"信任标题强调部分"},
    {"type":"textarea","id":"trust_text","label":"信任文本","default":"Tägliches Laden und Entladen ist ein anspruchsvoller Einsatz. Prüfe die aktuellen Produktdaten und Garantiebedingungen deines gewählten Modells."},
    {"type":"image_picker","id":"trust_image","label":"信任图片"},
    {"type":"text","id":"trust_image_alt","label":"信任图片替代文字","default":"VENUS E Speicher im täglichen Einsatz"},
    {"type":"text","id":"trust_image_placeholder","label":"信任图片占位文字","default":"Alltagsbild mit VENUS E auswählen"},
    {"type":"header","content":"Typography"},
    {"type":"range","id":"eyebrow_size","label":"眉题大小","min":9,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"item_heading_size","label":"项目标题大小","min":14,"max":40,"step":1,"unit":"px","default":24},
    {"type":"range","id":"item_text_size","label":"项目文本大小","min":10,"max":20,"step":0.5,"unit":"px","default":14},
    {"type":"range","id":"control_size","label":"控件大小","min":11,"max":18,"step":1,"unit":"px","default":12},
    {"type":"range","id":"value_size","label":"数值大小","min":14,"max":40,"step":1,"unit":"px","default":38},
    {"type":"range","id":"note_size","label":"备注大小","min":10,"max":16,"step":0.5,"unit":"px","default":13},
    {"type":"header","content":"Layout und Größen"},
    {"type":"range","id":"heading_size","label":"标题大小","min":28,"max":60,"step":1,"unit":"px","default":36},
    {"type":"range","id":"copy_size","label":"文案大小","min":13,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"trust_media_height","label":"信任媒体高度","min":260,"max":520,"step":10,"unit":"px","default":360},
    {"type":"range","id":"trust_media_width","label":"信任媒体宽度","min":70,"max":100,"step":1,"unit":"%","default":100},
    {"type":"range","id":"section_spacing","label":"区块间距","min":40,"max":140,"step":4,"unit":"px","default":68}
  ],
  "blocks": [
    {"type":"trust","name":"Vertrauenssignal","settings":[{"type":"text","id":"value","label":"数值","default":"10"},{"type":"text","id":"value_label","label":"数值标签"},{"type":"textarea","id":"text","label":"文本","default":"Herstellergarantie gemäß den Bedingungen des gewählten Modells."}]}
  ],
  "max_blocks": 3,
  "presets": [{"name":"E-Auto Vertrauen","blocks":[{"type":"trust"},{"type":"trust"},{"type":"trust"}] }]
}
{% endschema %}
