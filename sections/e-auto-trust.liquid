{% liquid
  assign page_id = 'eauto-' | append: section.id
%}

<section id="eauto-trust" class="e-auto-page e-auto-page__section e-auto-page__trust" style="--eauto-heading-size: {{ section.settings.heading_size }}px; --eauto-copy-size: {{ section.settings.copy_size }}px; --eauto-section-space: {{ section.settings.section_spacing }}px; --eauto-trust-media-height: {{ section.settings.trust_media_height }}px;" aria-labelledby="{{ page_id }}-trust-heading">
  <div class="e-auto-page__container">
    <div class="e-auto-page__trust-layout">
      <div class="e-auto-page__media e-auto-page__media--trust">
        {% if section.settings.trust_image != blank %}
          {{ section.settings.trust_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200', sizes: '(min-width: 960px) 50vw, 100vw', alt: section.settings.trust_image_alt }}
        {% elsif request.design_mode %}
          <div class="e-auto-page__placeholder">{{ section.settings.trust_image_placeholder }}</div>
        {% endif %}
      </div>
      <div>
        <div class="e-auto-page__section-heading">
          <p class="e-auto-page__eyebrow">{{ section.settings.trust_eyebrow }}</p>
          <h2 id="{{ page_id }}-trust-heading">{{ section.settings.trust_heading }}{% if section.settings.trust_heading_accent != blank %} <span>{{ section.settings.trust_heading_accent }}</span>{% endif %}</h2>
          <p>{{ section.settings.trust_text }}</p>
        </div>
        <div class="e-auto-page__trust-grid">
          {% for block in section.blocks %}
            <article {{ block.shopify_attributes }}><strong>{{ block.settings.value }}</strong><p>{{ block.settings.text }}</p></article>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "E-Auto Vertrauen",
  "tag": "section",
  "class": "section-e-auto-trust",
  "settings": [
    {"type":"text","id":"trust_eyebrow","label":"Vertrauen Kicker","default":"Vertrauen & Alltagstauglichkeit"},
    {"type":"text","id":"trust_heading","label":"Vertrauen Überschrift","default":"Gebaut für den täglichen Einsatz"},
    {"type":"text","id":"trust_heading_accent","label":"Vertrauen Überschrift – blauer Akzent","default":""},
    {"type":"textarea","id":"trust_text","label":"Vertrauen Text","default":"Tägliches Laden und Entladen ist ein anspruchsvoller Einsatz. Prüfe die aktuellen Produktdaten und Garantiebedingungen deines gewählten Modells."},
    {"type":"image_picker","id":"trust_image","label":"Vertrauensbild"},
    {"type":"text","id":"trust_image_alt","label":"Vertrauensbild Alt-Text","default":"VENUS E Speicher im täglichen Einsatz"},
    {"type":"text","id":"trust_image_placeholder","label":"Vertrauensbild Platzhalter","default":"Alltagsbild mit VENUS E auswählen"},
    {"type":"header","content":"Layout und Größen"},
    {"type":"range","id":"heading_size","label":"Überschrift Größe","min":28,"max":60,"step":1,"unit":"px","default":38},
    {"type":"range","id":"copy_size","label":"文案字号","min":13,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"trust_media_height","label":"信任图片高度","min":260,"max":520,"step":10,"unit":"px","default":360},
    {"type":"range","id":"section_spacing","label":"区块上下间距","min":40,"max":140,"step":4,"unit":"px","default":80}
  ],
  "blocks": [
    {"type":"trust","name":"Vertrauenssignal","settings":[{"type":"text","id":"value","label":"Wert","default":"10 Jahre"},{"type":"textarea","id":"text","label":"Text","default":"Herstellergarantie gemäß den Bedingungen des gewählten Modells."}]}
  ],
  "max_blocks": 3,
  "presets": [{"name":"E-Auto Vertrauen","blocks":[{"type":"trust"},{"type":"trust"},{"type":"trust"}] }]
}
{% endschema %}
