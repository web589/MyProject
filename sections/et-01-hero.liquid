{% if section.settings.show_section %}
  {% capture section_content %}
  <div class="et-hero-grid">
    <div class="et-hero-copy">
      {% render 'et-heading', section: section, level: 'h1' %}
      <div class="et-hero-cta">
        {% for block in section.blocks %}
          {% if block.settings.show_block and block.settings.label != blank and block.settings.link != blank %}
            <a class="et-btn {% if block.settings.style == 'primary' %}et-btn-primary{% else %}et-btn-ghost{% endif %}" href="{{ block.settings.link | escape }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
    {% render 'et-media', image: section.settings.image, alt: section.settings.image_alt, wrapper_class: 'et-hero-media', sizes: '(min-width: 1181px) 44vw, (min-width: 981px) 46vw, 100vw', eager: true %}
  </div>
  {% endcapture %}
  {% render 'et-section', section: section, anchor_id: 'et-start', extra_class: 'et-hero', content: section_content %}
{% endif %}

{% schema %}
{
  "name": "01 首屏",
  "tag": "div",
  "class": "et-section-wrap",
  "limit": 1,
  "enabled_on": {
    "templates": [
      "page"
    ]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "显示模块",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "眉题",
      "default": "ERFAHRUNGEN & TESTS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题普通文字",
      "default": "VENUS E Erfahrungen & Tests:"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "标题强调文字",
      "default": "Alltag, Technik & Nachweise"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "副标题",
      "default": "Wir ordnen Installation, Lautstärke, Energiefluss, Smart Meter, App und Erweiterbarkeit anhand klarer Kriterien ein und zeigen nur Nachweise, die dem jeweiligen Modell eindeutig zugeordnet werden können."
    },
    {
      "type": "color",
      "id": "background",
      "label": "背景颜色",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "桌面顶部间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "桌面底部间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_tablet",
      "label": "平板顶部间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_tablet",
      "label": "平板底部间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "手机顶部间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "手机底部间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "首屏图片",
      "info": "建议 4:3、1200×900：德国住宅中已安装的 VENUS E，可轻量组合真实 App 或 Smart Meter。自然光、中性低饱和；不要星级评价墙、奖章或未经授权的媒体标志。"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "图片替代文字",
      "default": "VENUS E Speicher in einem deutschen Haushalt mit App und Smart Meter"
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "行动按钮",
      "settings": [
        {
          "type": "checkbox",
          "id": "show_block",
          "label": "显示区块",
          "default": true
        },
        {
          "type": "text",
          "id": "label",
          "label": "按钮文字",
          "default": "Mehr erfahren"
        },
        {
          "type": "url",
          "id": "link",
          "label": "跳转链接",
          "info": "可选择页面，或在特殊情况使用固定页内链接，如 #erfahrungen。"
        },
        {
          "type": "select",
          "id": "style",
          "label": "按钮样式",
          "default": "primary",
          "options": [
            {
              "value": "primary",
              "label": "蓝色主按钮"
            },
            {
              "value": "ghost",
              "label": "白色描边按钮"
            }
          ]
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "01 首屏",
      "blocks": [
        {
          "type": "button",
          "settings": {
            "label": "Alltagsszenarien ansehen",
            "link": "#erfahrungen",
            "style": "primary"
          }
        },
        {
          "type": "button",
          "settings": {
            "label": "Bewertungskriterien ansehen",
            "link": "#testkriterien",
            "style": "ghost"
          }
        }
      ]
    }
  ]
}
{% endschema %}

