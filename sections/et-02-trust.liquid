{% if section.settings.show_section %}
  {% capture section_content %}
  {% render 'et-heading', section: section %}
  <div class="et-trust">
    {% for block in section.blocks %}
      {% if block.settings.show_block %}
        <div class="et-stat" {{ block.shopify_attributes }}>
          {% if section.settings.show_values and block.settings.show_values %}<div class="et-num">{{ block.settings.value | escape }}{% if block.settings.unit != blank %} <small>{{ block.settings.unit | escape }}</small>{% endif %}</div>{% endif %}
          {% if block.settings.label != blank %}<div class="et-lab">{{ block.settings.label | escape }}</div>{% endif %}
          {% if block.settings.source != blank %}<div class="et-src">{{ block.settings.source | escape }}</div>{% endif %}
          
        </div>
      {% endif %}
    {% endfor %}
  </div>
  {% if section.settings.note != blank %}<div class="et-note">{{ section.settings.note }}</div>{% endif %}
  {% endcapture %}
  {% render 'et-section', section: section, anchor_id: 'et-trust', extra_class: 'et-trust-section', content: section_content %}
{% endif %}

{% schema %}
{
  "name": "经验测试 · 02 信任数字",
  "tag": "div",
  "class": "et-section-wrap",
  "limit": 1,
  "enabled_on": {
    "templates": [
      "page"
    ]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "显示模块",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "眉题",
      "default": "Vertrauen"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题普通文字",
      "default": "VENUS E auf einen"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "标题强调文字",
      "default": "Blick"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "副标题",
      "default": "Entscheidend ist nicht die Zahl allein, sondern was sie genau bedeutet. Jede Angabe ist klar benannt."
    },
    {
      "type": "color",
      "id": "background",
      "label": "背景颜色",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "桌面顶部间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "桌面底部间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_top_tablet",
      "label": "平板顶部间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_tablet",
      "label": "平板底部间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "手机顶部间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "手机底部间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "paragraph",
      "content": "数字来自参考稿，发布前须按对应型号的正式资料核实。保修年限、寿命及循环次数必须分开表述。可隐藏全部数值，或在各区块单独隐藏。"
    },
    {
      "type": "checkbox",
      "id": "verified",
      "label": "本模块资料已核实",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_values",
      "label": "显示数字",
      "default": true
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "底部说明",
      "default": "<p>Alle Angaben beziehen sich auf die offizielle Produktdokumentation. Welche Werte im Einzelfall gelten, steht auf der jeweiligen Produktseite.</p>"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "数字卡",
      "settings": [
        {
          "type": "checkbox",
          "id": "show_block",
          "label": "显示区块",
          "default": true
        },
        {
          "type": "text",
          "id": "value",
          "label": "数值",
          "default": "10"
        },
        {
          "type": "text",
          "id": "unit",
          "label": "单位",
          "default": "Jahre"
        },
        {
          "type": "text",
          "id": "label",
          "label": "数字含义",
          "default": "Herstellergarantie"
        },
        {
          "type": "textarea",
          "id": "source",
          "label": "资料来源说明",
          "default": "Gemäß Herstellerangabe zum jeweiligen Modell"
        },
        {
          "type": "checkbox",
          "id": "show_values",
          "label": "显示此卡数字",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "此卡资料已核实",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "经验测试 · 02 信任数字",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "value": "10",
            "unit": "Jahre",
            "label": "Herstellergarantie",
            "source": "Gemäß Herstellerangabe zum jeweiligen Modell"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "Bis zu 15",
            "unit": "Jahre",
            "label": "Lebensdauer",
            "source": "Gemäß Herstellerangabe; abhängig von Nutzung und Betriebsbedingungen."
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "Unter 30",
            "unit": "dB",
            "label": "leiser Betrieb",
            "source": "Typ. Betriebsgeräusch bei passiver Kühlung"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "Bis zu 10.000",
            "unit": "Zyklen",
            "label": "Ladezyklen",
            "source": "Typ. Zyklenfestigkeit gemäß Produktdaten"
          }
        }
      ]
    }
  ]
}
{% endschema %}

