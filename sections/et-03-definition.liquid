{% if section.settings.show_section %}
  {% capture section_content %}
  {% render 'et-heading', section: section %}
  {% render 'et-answer', content: section.settings.answer %}
  <div class="et-evid">
    {% for block in section.blocks %}
      {% if block.settings.show_block %}
        <div class="et-card" {{ block.shopify_attributes }}>
          {% if block.settings.heading != blank %}<h3>{{ block.settings.heading | escape }}</h3>{% endif %}
          {% if block.settings.body != blank %}<div class="et-card-copy">{{ block.settings.body }}</div>{% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
  {% endcapture %}
  {% render 'et-section', section: section, anchor_id: 'et-definition', extra_class: 'et-definition', content: section_content %}
{% endif %}

{% schema %}
{
  "name": "03 经验与测试定义",
  "tag": "div",
  "class": "et-section-wrap",
  "limit": 1,
  "enabled_on": {
    "templates": [
      "page"
    ]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "显示模块",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "眉题",
      "default": "Klarstellung"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题普通文字",
      "default": "Was meinen wir mit"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "标题强调文字",
      "default": "Erfahrungen und Tests?"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "副标题"
    },
    {
      "type": "color",
      "id": "background",
      "label": "背景颜色",
      "default": "#F5F7F9"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "桌面顶部间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "桌面底部间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_top_tablet",
      "label": "平板顶部间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_tablet",
      "label": "平板底部间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "手机顶部间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "手机底部间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "richtext",
      "id": "answer",
      "label": "定义说明",
      "default": "<p>Auf dieser Seite unterscheiden wir zwischen Alltagseinschätzung, technischer Bewertung und externen Nachweisen. So bleibt klar, welche Aussage aus typischen Nutzungssituationen stammt und welche durch technische Daten oder unabhängige Dokumente gestützt wird.</p>"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "说明卡",
      "settings": [
        {
          "type": "checkbox",
          "id": "show_block",
          "label": "显示区块",
          "default": true
        },
        {
          "type": "text",
          "id": "heading",
          "label": "卡片标题",
          "default": "Alltagseinschätzung"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "卡片说明",
          "default": "<p>Wie sich Installation, Lautstärke, App und Energiefluss in typischen Nutzungssituationen einordnen lassen.</p>"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "03 经验与测试定义",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "heading": "Alltagseinschätzung",
            "body": "<p>Wie sich Installation, Lautstärke, App und Energiefluss in typischen Nutzungssituationen einordnen lassen.</p>"
          }
        },
        {
          "type": "card",
          "settings": {
            "heading": "Technische Bewertung",
            "body": "<p>Welche Eigenschaften anhand definierter Kriterien und Produktdaten beurteilt werden.</p>"
          }
        },
        {
          "type": "card",
          "settings": {
            "heading": "Externe Nachweise",
            "body": "<p>Prüfberichte, Zertifikate oder unabhängige Tests – sofern sie für das jeweilige Modell tatsächlich vorliegen.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}

