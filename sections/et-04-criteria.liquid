{% if section.settings.show_section %}
  {% capture section_content %}
  {% render 'et-heading', section: section %}
  <div class="et-cards3">
    {% for block in section.blocks %}
      {% if block.settings.show_block %}
        <div class="et-card" {{ block.shopify_attributes }}>
          <span class="et-ic" aria-hidden="true">{% render 'et-icon', image: block.settings.custom_icon, type: block.settings.icon %}</span>
          {% if block.settings.heading != blank %}<h3>{{ block.settings.heading | escape }}</h3>{% endif %}
          {% if block.settings.body != blank %}<div class="et-card-copy">{{ block.settings.body }}</div>{% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
  {% if section.settings.note != blank %}<div class="et-note">{{ section.settings.note }}</div>{% endif %}
  {% endcapture %}
  {% render 'et-section', section: section, anchor_id: 'testkriterien', extra_class: 'et-criteria', content: section_content %}
{% endif %}

{% schema %}
{
  "name": "经验测试 · 04 评价标准",
  "tag": "div",
  "class": "et-section-wrap",
  "limit": 1,
  "enabled_on": {
    "templates": [
      "page"
    ]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "显示模块",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "眉题",
      "default": "So bewerten wir"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题普通文字",
      "default": "Nach diesen Kriterien ordnen wir VENUS E im"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "标题强调文字",
      "default": "Alltag ein"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "副标题"
    },
    {
      "type": "color",
      "id": "background",
      "label": "背景颜色",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "桌面顶部间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "桌面底部间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_top_tablet",
      "label": "平板顶部间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_tablet",
      "label": "平板底部间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "手机顶部间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "手机底部间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "底部说明",
      "default": "<p>Kapazität allein entscheidet nicht darüber, welcher Speicher im Alltag am besten passt.</p>"
    }
  ],
  "blocks": [
    {
      "type": "criterion",
      "name": "评价标准卡",
      "settings": [
        {
          "type": "checkbox",
          "id": "show_block",
          "label": "显示区块",
          "default": true
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "自定义图标",
          "info": "上传图片后替换默认线性图标；留空时继续显示默认图标。建议使用透明背景图片。"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "默认图标",
          "default": "battery",
          "options": [
            {
              "value": "battery",
              "label": "电池"
            },
            {
              "value": "quiet",
              "label": "安静运行"
            },
            {
              "value": "flow",
              "label": "能源流"
            },
            {
              "value": "meter",
              "label": "计量"
            },
            {
              "value": "app",
              "label": "手机应用"
            },
            {
              "value": "expand",
              "label": "扩容"
            },
            {
              "value": "retrofit",
              "label": "后装检查"
            },
            {
              "value": "coupling",
              "label": "交流耦合"
            },
            {
              "value": "smart_meter",
              "label": "智能电表"
            },
            {
              "value": "settings",
              "label": "设置"
            },
            {
              "value": "info",
              "label": "信息提示"
            }
          ]
        },
        {
          "type": "text",
          "id": "heading",
          "label": "卡片标题",
          "default": "Installation"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "卡片说明",
          "default": "<p>Wie gut sich der Speicher in eine bestehende oder neue Anlage integrieren lässt.</p>"
        }
      ]
    }
  ],
  "max_blocks": 18,
  "presets": [
    {
      "name": "经验测试 · 04 评价标准",
      "blocks": [
        {
          "type": "criterion",
          "settings": {
            "icon": "battery",
            "heading": "Installation",
            "body": "<p>Wie gut sich der Speicher in eine bestehende oder neue Anlage integrieren lässt.</p>"
          }
        },
        {
          "type": "criterion",
          "settings": {
            "icon": "quiet",
            "heading": "Lautstärke",
            "body": "<p>Wie unauffällig der Speicher im täglichen Betrieb bleibt.</p>"
          }
        },
        {
          "type": "criterion",
          "settings": {
            "icon": "flow",
            "heading": "Energiefluss",
            "body": "<p>Wie nachvollziehbar Laden, Entladen und Netzbezug geregelt werden.</p>"
          }
        },
        {
          "type": "criterion",
          "settings": {
            "icon": "meter",
            "heading": "Smart Meter & Steuerung",
            "body": "<p>Wie präzise Verbrauch und Energiefluss erfasst und für die Steuerung genutzt werden.</p>"
          }
        },
        {
          "type": "criterion",
          "settings": {
            "icon": "app",
            "heading": "App & Bedienung",
            "body": "<p>Wie einfach Verbrauch, Speicherstatus und Einstellungen im Alltag nachvollziehbar sind.</p>"
          }
        },
        {
          "type": "criterion",
          "settings": {
            "icon": "expand",
            "heading": "Erweiterbarkeit",
            "body": "<p>Welche Möglichkeiten für zusätzliche Kapazität und spätere Systemerweiterungen bestehen.</p>"
          }
