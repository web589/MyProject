{% if section.settings.show_section %}
  {% capture section_content %}
  {% render 'et-heading', section: section %}
  {% render 'et-answer', content: section.settings.answer %}
  <div class="et-split">
    <ul class="et-pt-list">
      {% for block in section.blocks %}
        {% if block.settings.show_block %}
          <li {{ block.shopify_attributes }}>
            <span class="et-ic-mini" aria-hidden="true">{% render 'et-icon', image: block.settings.custom_icon, type: block.settings.icon %}</span>
            <div>
              {% if block.settings.heading != blank %}<h3>{{ block.settings.heading | escape }}</h3>{% endif %}
              {% if block.settings.body != blank %}<div class="et-point-copy">{{ block.settings.body }}</div>{% endif %}
              {% if block.settings.link_label != blank and block.settings.link != blank %}<a class="et-lnk" href="{{ block.settings.link | escape }}">{{ block.settings.link_label | escape }}</a>{% endif %}
            </div>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
    {% render 'et-media', image: section.settings.image, alt: section.settings.image_alt, wrapper_class: 'et-media', sizes: '(min-width: 981px) 48vw, 100vw' %}
  </div>
  {% endcapture %}
  {% render 'et-section', section: section, anchor_id: 'installation', extra_class: 'et-installation', content: section_content %}
{% endif %}

{% schema %}
{
  "name": "经验测试 · 05 安装与后装",
  "tag": "div",
  "class": "et-section-wrap",
  "limit": 1,
  "enabled_on": {
