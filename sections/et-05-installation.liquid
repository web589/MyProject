    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "副标题"
    },
    {
      "type": "color",
      "id": "background",
      "label": "背景颜色",
      "default": "#F5F7F9"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "桌面顶部间距",
