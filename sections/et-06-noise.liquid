{% if section.settings.show_section %}
  {% capture section_content %}
  {% render 'et-heading', section: section %}
  {% if section.settings.show_values %}{% render 'et-answer', content: section.settings.answer %}{% endif %}
  
  <div class="et-db">
    {% if section.settings.show_values %}
      <div class="et-venus" style="left: {{ section.settings.marker_position }}%;">
        {% if section.settings.marker_label != blank %}<span class="et-badge">{{ section.settings.marker_label | escape }}</span>{% endif %}
        {% if section.settings.marker_value != blank %}<span class="et-num">{{ section.settings.marker_value | escape }}</span>{% endif %}
      </div>
      <div class="et-scale">
        <span class="et-vconn" style="left: {{ section.settings.marker_position }}%;" aria-hidden="true"></span>
        <div class="et-bar" aria-hidden="true"></div>
        <span class="et-vdot" style="left: {{ section.settings.marker_position }}%;" aria-hidden="true"></span>
        {% for block in section.blocks %}
          {% if block.type == 'point' and block.settings.show_block %}
            <div class="et-mark{% if block.settings.alignment == 'left' %} et-edge-l{% elsif block.settings.alignment == 'right' %} et-edge-r{% endif %}" style="left: {{ block.settings.position }}%;" {{ block.shopify_attributes }}>
              <span class="et-dot" aria-hidden="true"></span><span class="et-t">{{ block.settings.label | escape }}</span>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
    <div class="et-scenes">
      {% if section.settings.scene_heading != blank %}<span class="et-scene-label">{{ section.settings.scene_heading | escape }}</span>{% endif %}
      {% for block in section.blocks %}
        {% if block.type == 'scene' and block.settings.show_block and block.settings.label != blank %}<span class="et-scene" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</span>{% endif %}
      {% endfor %}
      {% if section.settings.scene_note != blank %}<span class="et-scene-note">{{ section.settings.scene_note | escape }}</span>{% endif %}
    </div>
  </div>
  {% endcapture %}
  {% render 'et-section', section: section, anchor_id: 'lautstaerke', extra_class: 'et-noise', content: section_content %}
{% endif %}

{% schema %}
{
  "name": "经验测试 · 06 噪音说明",
  "tag": "div",
  "class": "et-section-wrap",
  "limit": 1,
  "enabled_on": {
    "templates": [
      "page"
    ]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "显示模块",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "眉题",
      "default": "Alltag"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题普通文字",
      "default": "Wie leise ist VENUS E im"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "标题强调文字",
      "default": "Alltag?"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "副标题"
    },
    {
      "type": "color",
      "id": "background",
      "label": "背景颜色",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "桌面顶部间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "桌面底部间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_top_tablet",
      "label": "平板顶部间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_tablet",
      "label": "平板底部间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "手机顶部间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "手机底部间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "richtext",
      "id": "answer",
      "label": "直接回答",
      "default": "<p>VENUS E arbeitet mit passiver Kühlung und bleibt mit unter 30 dB im Betrieb sehr leise. Wahrgenommene Lautstärke hängt zusätzlich vom Aufstellort und von der Umgebung ab.</p>"
    },
    {
      "type": "paragraph",
      "content": "噪音数值来自参考稿，发布前须按对应型号的正式资料核实。场景示例不代表所有型号均适合任意空间。关闭“显示噪音数值与对应回答”可隐藏含数值的回答与标尺，保留场景标签。"
    },
    {
      "type": "checkbox",
      "id": "verified",
      "label": "噪音资料已核实",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_values",
      "label": "显示噪音数值与对应回答",
      "default": true
    },
    {
      "type": "text",
      "id": "marker_label",
      "label": "产品标记文字",
      "default": "VENUS E"
    },
    {
      "type": "text",
      "id": "marker_value",
      "label": "产品噪音文字",
      "default": "unter 30 dB"
    },
    {
      "type": "range",
      "id": "marker_position",
      "label": "产品标记位置",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 30
    },
    {
      "type": "text",
      "id": "scene_heading",
      "label": "场景小标题",
      "default": "Beispielhafte Aufstellbereiche"
    },
    {
      "type": "text",
      "id": "scene_note",
      "label": "场景适用说明",
      "default": "abhängig von Modell und Installationsbedingungen"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "噪音参考节点",
      "settings": [
        {
          "type": "checkbox",
          "id": "show_block",
          "label": "显示区块",
          "default": true
        },
        {
          "type": "text",
          "id": "label",
          "label": "节点文字",
          "default": "0 dB · Hörschwelle"
        },
        {
          "type": "range",
          "id": "position",
          "label": "标尺位置",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 0
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "文字对齐方向",
          "default": "center",
          "options": [
            {
              "value": "left",
              "label": "左端向内对齐"
            },
            {
              "value": "center",
              "label": "居中对齐"
            },
            {
              "value": "right",
              "label": "右端向内对齐"
            }
          ]
        }
      ]
    },
    {
      "type": "scene",
      "name": "场景标签",
      "settings": [
        {
          "type": "checkbox",
          "id": "show_block",
          "label": "显示区块",
          "default": true
        },
        {
          "type": "text",
          "id": "label",
          "label": "场景名称",
          "default": "Wohnraum"
        }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "经验测试 · 06 噪音说明",
      "blocks": [
        {
          "type": "point",
          "settings": {
            "label": "0 dB · Hörschwelle",
            "position": 0,
            "alignment": "left"
          }
        },
        {
          "type": "point",
          "settings": {
            "label": "60 dB · normales Gespräch",
            "position": 60,
            "alignment": "center"
          }
        },
        {
          "type": "point",
          "settings": {
            "label": "100 dB · sehr laut",
            "position": 100,
            "alignment": "right"
          }
        },
        {
          "type": "scene",
          "settings": {
            "label": "Wohnraum"
          }
        },
        {
          "type": "scene",
          "settings": {
            "label": "Garage"
          }
        },
        {
          "type": "scene",
          "settings": {
            "label": "Hauswirtschaftsraum"
          }
        }
      ]
    }
  ]
}
{% endschema %}

