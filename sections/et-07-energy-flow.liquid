{% if section.settings.show_section %}
  {% capture section_content %}
  {% render 'et-heading', section: section %}
  {% render 'et-answer', content: section.settings.answer %}
  {% render 'et-media', image: section.settings.image, alt: section.settings.image_alt, wrapper_class: 'et-flow-media', sizes: '(min-width: 1640px) 1440px, (min-width: 1181px) calc(100vw - 200px), (min-width: 721px) calc(100vw - 80px), calc(100vw - 44px)', badge: section.settings.image_badge %}
  <div class="et-ef-flow">
    {% for block in section.blocks %}
      {% if block.type == 'node' and block.settings.show_block and block.settings.label != blank %}
        {% case block.settings.preceding %}
          {% when 'right' %}<span class="et-arrow" aria-hidden="true">→</span>
          {% when 'both' %}<span class="et-arrow" aria-hidden="true">↔</span>
          {% when 'dot' %}<span class="et-arrow" aria-hidden="true">·</span>
          {% when 'group' %}<span class="et-arrow et-group-arrow" aria-hidden="true">·</span>
        {% endcase %}
        <span class="et-node" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</span>
      {% endif %}
    {% endfor %}
  </div>
  <div class="et-steps">
    {% for block in section.blocks %}
      {% if block.type == 'step' and block.settings.show_block %}
        <div class="et-step" {{ block.shopify_attributes }}>
          {% if block.settings.label != blank %}<div class="et-num">{{ block.settings.label | escape }}</div>{% endif %}
          {% if block.settings.heading != blank %}<h3>{{ block.settings.heading | escape }}</h3>{% endif %}
          {% if block.settings.body != blank %}<div class="et-step-copy">{{ block.settings.body }}</div>{% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
  {% if section.settings.note != blank %}<div class="et-note">{{ section.settings.note }}</div>{% endif %}
  {% endcapture %}
  {% render 'et-section', section: section, anchor_id: 'energiefluss', extra_class: 'et-energy-flow', content: section_content %}
{% endif %}

