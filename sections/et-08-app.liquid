{%- if section.settings.show_section -%}
  {% capture section_content %}
    {% render 'et-heading', section: section %}
    {% render 'et-answer', content: section.settings.answer %}
    <div class="et-split">
      <ul class="et-pt-list">
        {%- for block in section.blocks -%}
          {%- if block.settings.show_block -%}
            <li {{ block.shopify_attributes }}>
              <span class="et-ic-mini" aria-hidden="true">{% render 'et-icon', image: block.settings.custom_icon, type: block.settings.icon %}</span>
              <div>
                {% if block.settings.title != blank %}<h3>{{ block.settings.title | escape }}</h3>{% endif %}
                {% if block.settings.text != blank %}<p>{{ block.settings.text | escape }}</p>{% endif %}
                {% if block.settings.link_label != blank and block.settings.link != blank %}<a class="et-lnk" href="{{ block.settings.link | escape }}">{{ block.settings.link_label | escape }}</a>{% endif %}
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      {% render 'et-media', image: section.settings.image, alt: section.settings.image_alt, wrapper_class: 'et-media', sizes: '(min-width: 1640px) 702px, (min-width: 981px) 45vw, 100vw' %}
    </div>
  {% endcapture %}
  {% render 'et-section', section: section, anchor_id: 'app', extra_class: 'et-app', content: section_content %}
{%- endif -%}

{% schema %}
{
  "name": "经验测试 · 08 App 与管理",
  "tag": "div",
  "class": "section-et-08-app",
  "limit": 1,
  "enabled_on": {
    "templates": [
      "page"
    ]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "显示此模块",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "眉题",
      "default": "Bedienung"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "Wie einfach lässt sich VENUS E im Alltag"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "标题强调部分",
      "default": "steuern?"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "副标题"
    },
    {
      "type": "color",
      "id": "background",
      "label": "模块背景色",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "模块间距"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "桌面上间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "桌面下间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_top_tablet",
      "label": "平板上间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_tablet",
      "label": "平板下间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "手机上间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "手机下间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "richtext",
      "id": "answer",
      "label": "直接回答",
      "default": "<p>In der MARSTEK App lassen sich Speicherstatus, Energiefluss und wichtige Betriebsdaten zentral verfolgen. Welche Funktionen verfügbar sind, hängt vom Modell, vom Softwarestand und von der Installation ab.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "应用截图",
      "info": "使用真实 MARSTEK App 截图，比例 4:3，建议 1200 × 900 像素。展示能源流、存储状态或设置界面。"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "图片替代文字",
      "default": "MARSTEK App mit Energiefluss und Speicherstatus"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "应用功能条目",
      "settings": [
        {
          "type": "checkbox",
          "id": "show_block",
          "label": "显示此区块",
          "default": true
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "自定义图标",
          "info": "上传后替换默认线性图标；留空继续使用原图标。建议使用透明背景图片。"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "默认线性图标",
          "options": [
            {
              "value": "flow",
              "label": "能源流"
            },
            {
              "value": "app",
              "label": "应用与状态"
            },
            {
              "value": "settings",
              "label": "设置与控制"
            },
            {
              "value": "info",
              "label": "信息提示"
            }
          ],
          "default": "flow"
        },
        {
          "type": "text",
          "id": "title",
          "label": "标题"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "说明"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "链接文字"
        },
        {
          "type": "url",
          "id": "link",
          "label": "链接地址"
        }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "经验测试 · 08 App 与管理",
      "settings": {},
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "show_block": true,
            "icon": "flow",
            "title": "Energiefluss im Blick",
            "text": "Laden, Entladen und Verbrauch werden übersichtlich dargestellt."
          }
        },
        {
          "type": "feature",
          "settings": {
            "show_block": true,
            "icon": "app",
            "title": "Speicherstatus prüfen",
            "text": "Ladestand und Betriebsdaten sind jederzeit abrufbar."
          }
        },
        {
          "type": "feature",
          "settings": {
            "show_block": true,
            "icon": "settings",
            "title": "Einstellungen & Steuerung",
            "text": "Verfügbare Einstellungen lassen sich direkt in der App anpassen.",
            "link_label": "AI-Energiemanagement verstehen →",
            "link": "/pages/ai-energiemanagement"
          }
        }
      ]
    }
  ]
}
{% endschema %}
