{%- if section.settings.show_section -%}
  {% capture section_content %}
    {% render 'et-heading', section: section %}
    <div class="et-prod-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'product_card' and block.settings.show_block -%}
          {%- liquid
            assign selected_product = block.settings.product
            assign product_image = block.settings.image | default: selected_product.featured_image
            assign product_title = block.settings.custom_title | default: selected_product.title | default: block.settings.fallback_title
            assign product_text = block.settings.custom_text
            if product_text == blank and selected_product != blank
              assign product_text = selected_product.description | strip_html | strip | truncate: 180
            endif
            assign product_text = product_text | default: block.settings.fallback_text
            assign product_link = block.settings.link | default: selected_product.url | default: block.settings.fallback_link
            assign product_alt = block.settings.image_alt | default: product_image.alt | default: product_title
          -%}
          <article class="et-prod" {{ block.shopify_attributes }}>
            {% render 'et-media', image: product_image, alt: product_alt, wrapper_class: 'et-product-media', sizes: '(min-width: 1640px) 345px, (min-width: 1181px) 23vw, (min-width: 721px) 45vw, 100vw', fit: 'contain' %}
            <div class="et-prod-body">
              {% if product_title != blank %}<h3>{{ product_title | escape }}</h3>{% endif %}
              {% if block.settings.show_capacity and block.settings.capacity != blank %}<div class="et-cap">{{ block.settings.capacity | escape }}</div>{% endif %}
              {% if product_text != blank %}<p>{{ product_text | escape }}</p>{% endif %}
              {% if block.settings.link_label != blank and product_link != blank %}<a class="et-lnk" href="{{ product_link | escape }}">{{ block.settings.link_label | escape }}</a>{% endif %}
              {% if request.design_mode and block.settings.show_capacity and block.settings.capacity != blank and block.settings.verified == false %}<p class="et-editor-note">容量尚未核实，请按对应型号的正式参数表填写；可关闭“显示容量”。</p>{% endif %}
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- for block in section.blocks -%}
      {%- if block.type == 'hint' and block.settings.show_block -%}
        <div class="et-prod-hint" {{ block.shopify_attributes }}>
          <span class="et-i{% if block.settings.custom_icon != blank %} et-i-custom{% endif %}" aria-hidden="true">{% if block.settings.custom_icon != blank %}{% render 'et-icon', image: block.settings.custom_icon, type: 'info' %}{% else %}i{% endif %}</span>
          <span>{{ block.settings.text | escape }}</span>
        </div>
      {%- endif -%}
    {%- endfor -%}
    {% if section.settings.link_label != blank and section.settings.link != blank %}<div class="et-range-links"><a class="et-lnk" href="{{ section.settings.link | escape }}">{{ section.settings.link_label | escape }}</a></div>{% endif %}
  {% endcapture %}
  {% render 'et-section', section: section, anchor_id: 'modelle', extra_class: 'et-models', content: section_content %}
{%- endif -%}

{% schema %}
{
  "name": "经验测试 · 10 产品型号",
  "tag": "div",
  "class": "section-et-10-models",
  "limit": 1,
  "enabled_on": {
    "templates": [
      "page"
    ]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "显示此模块",
      "default": true
