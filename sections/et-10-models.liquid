            "capacity": "5,12–15,36 kWh",
            "show_capacity": true,
            "verified": false,
            "fallback_link": "/products/venus-e-3-0",
            "image_alt": "VENUS E 3.0 Solarspeicher",
            "link_label": "Zum Modell →"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "show_block": true,
            "product": "venus-e-4",
