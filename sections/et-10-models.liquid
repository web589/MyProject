            "custom_text": "Für höheren Leistungs- und Steuerungsbedarf.",
            "fallback_title": "VENUS E 4.0",
            "fallback_text": "Für höheren Leistungs- und Steuerungsbedarf.",
            "capacity": "5–15 kWh",
            "show_capacity": true,
            "verified": false,
            "fallback_link": "/products/venus-e-4-0",
            "image_alt": "VENUS E 4.0 Solarspeicher",
            "link_label": "Zum Modell →"
          }
        },
        {
          "type": "product_card",
