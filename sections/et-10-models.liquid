    {
      "type": "text",
      "id": "eyebrow",
      "label": "眉题",
      "default": "Nach Modell"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "Welcher VENUS E passt zu welchem"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "标题强调部分",
      "default": "Alltag?"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "副标题",
      "default": "Vier Modelle für unterschiedliche Ausgangslagen – vom Balkonkraftwerk bis zum größeren Haushalt."
    },
    {
      "type": "color",
      "id": "background",
      "label": "模块背景色",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "模块间距"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "桌面上间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "桌面下间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_top_tablet",
      "label": "平板上间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_tablet",
      "label": "平板下间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "手机上间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "手机下间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "型号比较链接文字",
      "default": "Alle Modelle vergleichen →"
    },
    {
      "type": "url",
      "id": "link",
      "label": "型号比较链接"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "产品卡",
      "settings": [
        {
          "type": "checkbox",
          "id": "show_block",
          "label": "显示此区块",
          "default": true
        },
        {
          "type": "product",
          "id": "product",
          "label": "选择商品"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "自定义产品图",
          "info": "自定义图优先；留空使用所选商品主图。建议 4:3，显示完整产品。"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "图片替代文字"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "自定义标题",
          "info": "留空使用所选商品标题；未选商品时使用备用标题。"
        },
        {
          "type": "textarea",
          "id": "custom_text",
          "label": "自定义说明",
          "info": "留空使用所选商品简介；未选商品时使用备用说明。"
        },
        {
          "type": "text",
          "id": "capacity",
          "label": "容量",
          "info": "参考容量为占位值，请按该型号的正式参数表核实。"
        },
        {
          "type": "checkbox",
          "id": "show_capacity",
          "label": "显示容量",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "容量已按正式资料核实",
          "default": false
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "链接文字",
          "default": "Zum Modell →"
        },
        {
          "type": "url",
          "id": "link",
          "label": "自定义链接",
          "info": "留空跟随所选商品链接；未选商品时使用备用链接。"
        },
        {
          "type": "header",
          "content": "未选择商品时的备用内容"
        },
        {
          "type": "text",
          "id": "fallback_title",
          "label": "备用标题"
        },
        {
          "type": "textarea",
          "id": "fallback_text",
          "label": "备用说明"
        },
        {
          "type": "url",
          "id": "fallback_link",
          "label": "备用链接"
        }
      ]
    },
    {
      "type": "hint",
      "name": "型号信息提示",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_block",
          "label": "显示此区块",
          "default": true
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "自定义提示图标",
          "info": "上传后替换默认信息图标；留空显示原图标。"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "提示说明",
          "default": "Konkrete Kapazität und Funktionen nennen wir auf der jeweiligen Produktseite. Welche Funktionen verfügbar sind, hängt vom Modell, vom Softwarestand und von deiner Installation ab."
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
