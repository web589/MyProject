{%- if section.settings.show_section -%}
  {% capture section_content %}
    {% render 'et-heading', section: section %}
    {% render 'et-answer', content: section.settings.answer %}
    <div class="et-cert">
      {%- for block in section.blocks -%}
        {%- if block.settings.show_block -%}
          <article class="et-doc-card" {{ block.shopify_attributes }}>
            {% if block.settings.title != blank %}<h3>{{ block.settings.title | escape }}</h3>{% endif %}
            {% if block.settings.text != blank %}<p class="et-lead">{{ block.settings.text | escape }}</p>{% endif %}
            <div class="et-rows">
              {%- for row_number in (1..3) -%}
                {%- liquid
                  assign key_id = 'row_' | append: row_number | append: '_key'
                  assign value_id = 'row_' | append: row_number | append: '_value'
                  assign pending_id = 'row_' | append: row_number | append: '_pending'
                  assign row_key = block.settings[key_id]
                  assign row_value = block.settings[value_id]
                  assign row_pending = block.settings[pending_id]
                  assign show_row = true
                  if row_pending and block.settings.show_pending_values == false
                    assign show_row = false
                  endif
                -%}
                {%- if show_row and row_key != blank and row_value != blank -%}
                  <div class="et-row"><span class="et-k">{{ row_key | escape }}</span><span class="et-v{% if row_pending %} et-todo{% endif %}">{{ row_value | escape }}</span></div>
                {%- endif -%}
              {%- endfor -%}
            </div>
            {% if block.settings.link_label != blank and block.settings.link != blank %}<a class="et-lnk et-dlink" href="{{ block.settings.link | escape }}">{{ block.settings.link_label | escape }}</a>{% endif %}
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {% if section.settings.note != blank %}<div class="et-note">{{ section.settings.note | replace: '<a ', '<a class="et-lnk" ' }}</div>{% endif %}
  {% endcapture %}
  {% render 'et-section', section: section, anchor_id: 'nachweise', extra_class: 'et-documents', content: section_content %}
{%- endif -%}

