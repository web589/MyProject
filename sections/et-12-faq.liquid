{%- if section.settings.show_section -%}
  {% capture section_content %}
    {% render 'et-heading', section: section %}
    <div class="et-faq-wrap" data-et-faq>
      {%- for block in section.blocks -%}
        {%- if block.settings.show_block -%}
          {%- liquid
            assign question_id = 'et-faq-q-' | append: section.id | append: '-' | append: block.id
            assign answer_id = 'et-faq-a-' | append: section.id | append: '-' | append: block.id
          -%}
          <div class="et-faq-item" {{ block.shopify_attributes }}>
            <button class="et-faq-q" id="{{ question_id }}" type="button" aria-expanded="true" aria-controls="{{ answer_id }}">{{ block.settings.question | escape }}</button>
            <div class="et-faq-a" id="{{ answer_id }}" role="region" aria-labelledby="{{ question_id }}"><div class="et-faq-answer">{{ block.settings.answer | replace: '<a ', '<a class="et-lnk" ' }}</div></div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {% endcapture %}
  {% render 'et-section', section: section, anchor_id: 'faq', extra_class: 'et-faq', content: section_content %}
{%- endif -%}

{% schema %}
{
  "name": "经验测试 · 12 常见问题",
  "tag": "div",
  "class": "section-et-12-faq",
  "limit": 1,
  "enabled_on": {
    "templates": [
      "page"
    ]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "显示此模块",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "眉题",
      "default": "Häufige Fragen"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "FAQ zu"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "标题强调部分",
      "default": "VENUS E Erfahrungen und Tests"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "副标题"
    },
    {
      "type": "color",
      "id": "background",
      "label": "模块背景色",
      "default": "#F5F7F9"
    },
    {
      "type": "header",
      "content": "模块间距"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "桌面上间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "桌面下间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_top_tablet",
      "label": "平板上间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_tablet",
      "label": "平板下间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "手机上间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "手机下间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 44
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "问答",
      "settings": [
        {
          "type": "checkbox",
          "id": "show_block",
          "label": "显示此区块",
          "default": true
        },
        {
          "type": "text",
          "id": "question",
          "label": "问题"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "答案"
        }
      ]
    }
  ],
  "max_blocks": 30,
  "presets": [
    {
      "name": "经验测试 · 12 常见问题",
      "settings": {},
      "blocks": [
        {
          "type": "question",
          "settings": {
            "show_block": true,
            "question": "Wie laut ist VENUS E im Betrieb?",
            "answer": "<p>VENUS E arbeitet mit passiver Kühlung und bleibt mit unter 30 dB im Betrieb sehr leise. Wahrgenommene Lautstärke hängt zusätzlich vom Aufstellort und von der Umgebung ab.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "show_block": true,
            "question": "Kann VENUS E bei einer bestehenden PV-Anlage nachgerüstet werden?",
            "answer": "<p>Als AC-gekoppelter Speicher kann VENUS E in vielen Fällen bestehende PV-Systeme ergänzen. Welche Anpassungen erforderlich sind, hängt von Wechselrichter, Hausinstallation und Messkonzept der vorhandenen Anlage ab. <a href=\"/pages/ac-gekoppelter-speicher\">AC-Kopplung verstehen →</a></p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "show_block": true,
            "question": "Wie wird der Energiefluss gemessen?",
            "answer": "<p>Ein Smart Meter erfasst den Energiefluss am Messpunkt und stellt diese Daten für die Steuerung bereit. Der Smart Meter ist Teil der Messung, nicht der elektrischen Hauptverbindung. <a href=\"/pages/smart-meter-energiefluss\">Smart Meter &amp; Energiefluss →</a></p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "show_block": true,
            "question": "Brauche ich einen Smart Meter?",
            "answer": "<p>Nicht jeder Speicher benötigt für seine Grundfunktion zwingend einen Smart Meter. Für eine verbrauchsabhängige Steuerung sind Messdaten jedoch in der Regel wichtig.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "show_block": true,
            "question": "Welche Funktionen bietet die MARSTEK App?",
            "answer": "<p>In der MARSTEK App lassen sich Energiefluss, Speicherstatus und wichtige Betriebsdaten verfolgen. Welche Funktionen im Einzelfall verfügbar sind, hängt vom Modell und vom Softwarestand ab.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "show_block": true,
            "question": "Wie lange ist die Herstellergarantie?",
            "answer": "<p>VENUS E wird mit einer Herstellergarantie von 10 Jahren angeboten (gemäß Herstellerangabe zum jeweiligen Modell). Garantie und tatsächliche Nutzungsdauer sind dabei getrennt zu betrachten.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "show_block": true,
            "question": "Wie lange ist VENUS E auf Nutzung ausgelegt?",
            "answer": "<p>VENUS E ist laut Hersteller auf eine Nutzungsdauer von bis zu 15 Jahren ausgelegt. Die tatsächliche Lebensdauer hängt von Nutzung und Betriebsbedingungen ab.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "show_block": true,
            "question": "Gibt es unabhängige Tests oder Zertifikate?",
            "answer": "<p>Wir zeigen nur Nachweise, die eindeutig einem Produkt oder einer konkreten Prüfung zugeordnet werden können – zum Beispiel vorhandene Prüfberichte, Konformitätsunterlagen und technische Dokumente. Unabhängige Medientests werden nur genannt, wenn sie tatsächlich vorliegen. <a href=\"/pages/downloads\">Downloads &amp; Dokumente →</a></p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
