{%- if template.name == 'page' and template.suffix == 'faq' -%}
<style>
  #shopify-section-{{ section.id }} .faq-category-section {
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 0 52px;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .faq-category-section__header {
    position: relative;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    margin: 0 0 16px;
    padding: 0 0 14px;
    border-bottom: 1px solid var(--line);
    scroll-margin-top: 110px;
    transition: color 0.25s ease, background-color 0.25s ease, box-shadow 0.25s ease;
  }

  #shopify-section-{{ section.id }} .faq-category-section__header::after {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 3px;
    border-radius: 999px;
    background: var(--blue);
    content: '';
    opacity: 0;
    transform: scaleX(0.35);
    transform-origin: center;
    transition: opacity 0.25s ease, transform 0.45s ease;
  }

  #shopify-section-{{ section.id }} .faq-category-section__header.is-anchor-target {
    color: var(--blue);
    background: linear-gradient(90deg, rgba(0, 153, 254, 0.08), rgba(0, 153, 254, 0));
    box-shadow: 0 14px 28px rgba(0, 153, 254, 0.08);
  }

  #shopify-section-{{ section.id }} .faq-category-section__header.is-anchor-target::after {
    opacity: 1;
    transform: scaleX(1);
  }

  #shopify-section-{{ section.id }} .faq-category-section__heading {
    display: flex;
    align-items: baseline;
    gap: 10px;
    min-width: 0;
    margin: 0;
    color: var(--ink);
    font-size: 22px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  #shopify-section-{{ section.id }} .faq-category-section__number {
    flex: 0 0 auto;
    color: var(--blue);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.05em;
    font-variant-numeric: tabular-nums;
  }

  #shopify-section-{{ section.id }} .faq-category-section__count {
    flex: 0 0 auto;
    color: var(--gray);
    font-size: 12px;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .faq-category-section__questions {
    display: grid;
    gap: 9px;
  }

  #shopify-section-{{ section.id }} .faq-category-section__item {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: #ffffff;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }

  #shopify-section-{{ section.id }} .faq-category-section__item.is-open,
  #shopify-section-{{ section.id }} .faq-category-section__item:has(.faq-category-section__trigger.is-open),
  #shopify-section-{{ section.id }} .faq-category-section__item:has(.faq-category-section__trigger:focus-visible) {
    border-color: var(--blue);
    box-shadow: none;
  }

  #shopify-section-{{ section.id }} .faq-category-section__trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: 100%;
    min-height: 46px;
    padding: 13px 18px;
    color: var(--ink);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.45;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .faq-category-section__trigger > span:first-child {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  #shopify-section-{{ section.id }} .faq-category-section__trigger:hover,
  #shopify-section-{{ section.id }} .faq-category-section__trigger:focus-visible,
  #shopify-section-{{ section.id }} .faq-category-section__trigger.is-open {
    color: var(--blue);
  }

  #shopify-section-{{ section.id }} .faq-category-section__trigger .collapsible-trigger__icon {
    position: relative;
    inset: auto;
    flex: 0 0 auto;
    width: 12px;
    height: 8px;
    color: currentColor;
  }

  #shopify-section-{{ section.id }} .faq-category-section__trigger .icon-chevron-down {
    transform: translate(-50%, -50%);
    transition: transform .34s cubic-bezier(.4, 0, .2, 1), color .18s ease;
  }

  #shopify-section-{{ section.id }} .faq-category-section__trigger.is-open .icon-chevron-down {
    transform: translate(-50%, -50%) rotate(180deg);
  }

  #shopify-section-{{ section.id }} .faq-category-section__answer {
    max-height: 0;
    overflow: hidden;
    border-left: 0;
    border-radius: 0;
    background: #ffffff;
    color: var(--gray-dark);
    opacity: 0;
    visibility: hidden;
    transition: max-height .34s cubic-bezier(.4, 0, .2, 1), opacity .22s ease .06s, visibility 0s linear .34s;
  }

  #shopify-section-{{ section.id }} .faq-category-section__answer.is-open {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s, .06s, 0s;
  }

  #shopify-section-{{ section.id }} .faq-category-section__answer-inner {
    padding: 0 18px 15px;
    color: var(--gray-dark);
    font-size: 12px;
    line-height: 1.75;
  }

  #shopify-section-{{ section.id }} .faq-category-section__answer-inner > :first-child {
    margin-top: 0;
  }

  #shopify-section-{{ section.id }} .faq-category-section__answer-inner > :last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .faq-category-section__trigger .faq-chevron {
    flex: 0 0 auto;
    width: 11px;
    height: 7px;
    color: var(--gray);
    transition: transform .34s cubic-bezier(.4, 0, .2, 1), color .18s ease;
  }

  #shopify-section-{{ section.id }} .faq-category-section__trigger.is-open .faq-chevron {
    color: var(--blue);
    transform: rotate(180deg);
  }

  @media only screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .faq-category-section {
      max-width: none;
      padding: 0 20px 38px;
    }

    #shopify-section-{{ section.id }} .faq-category-section__header {
      align-items: flex-start;
      gap: 12px;
      margin-bottom: 14px;
      scroll-margin-top: 110px;
    }

    #shopify-section-{{ section.id }} .faq-category-section__heading {
      gap: 8px;
      font-size: 21px;
    }

    #shopify-section-{{ section.id }} .faq-category-section__count {
      padding-top: 4px;
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .faq-category-section__questions {
      gap: 10px;
    }

    #shopify-section-{{ section.id }} .faq-category-section__trigger {
      min-height: 48px;
      padding: 14px 16px;
      font-size: 13px;
    }

    #shopify-section-{{ section.id }} .faq-category-section__answer-inner {
      padding: 0 16px 14px;
      font-size: 12px;
    }
  }
</style>

{%- liquid
  assign faq_anchor_id = section.settings.anchor_id | default: section.id | handle
  assign faq_category_title = section.settings.category_title | default: 'FAQ'
  assign faq_question_count = section.blocks | where: 'type', 'question' | size
-%}

<section data-faq-category-anchor="{{ faq_anchor_id }}" class="faq-category-section" aria-labelledby="FAQ-category-title-{{ section.id }}">
  <header id="{{ faq_anchor_id }}" class="faq-category-section__header" data-faq-category-heading tabindex="-1">
    <h2 id="FAQ-category-title-{{ section.id }}" class="faq-category-section__heading">
      {%- if section.settings.category_number != blank -%}
        <span class="faq-category-section__number">{{ section.settings.category_number | escape }}</span>
      {%- endif -%}
      <span>{{ faq_category_title | escape }}</span>
    </h2>
    <span class="faq-category-section__count">{{ faq_question_count }} Fragen</span>
  </header>

  <div class="faq-category-section__questions">
    {%- for block in section.blocks -%}
      {%- if block.type == 'question' and block.settings.title != blank and block.settings.text != blank -%}
        {%- assign faq_question_id = 'FAQ-question-' | append: section.id | append: '-' | append: block.id -%}
        {%- assign faq_answer_id = 'FAQ-content-' | append: section.id | append: '-' | append: block.id -%}
        <div class="faq-category-section__item" data-faq-item {{ block.shopify_attributes }}>
          <button
            id="{{ faq_question_id }}"
            type="button"
            class="faq-category-section__trigger text-left"
            data-faq-question
            aria-controls="{{ faq_answer_id }}"
            aria-expanded="false"
          >
            <span>{{ block.settings.title }}</span>
            <svg class="faq-chevron" viewBox="0 0 12 8" fill="none" aria-hidden="true" focusable="false">
              <path d="m1 1.5 5 5 5-5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4" />
            </svg>
          </button>
          <div id="{{ faq_answer_id }}" class="faq-category-section__answer" data-faq-answer role="region" aria-labelledby="{{ faq_question_id }}" aria-hidden="true">
            <div class="faq-category-section__answer-inner rte">{{ block.settings.text }}</div>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{%- render 'structured-data',
  structured_data_context: 'faq',
  faq_items: section.blocks,
  faq_source: 'standard'
-%}
{%- endif -%}

{% schema %}
{
  "name": "FAQ category",
  "class": "index-section",
  "settings": [
    {
      "type": "text",
      "id": "category_number",
      "label": "Category number",
      "default": "01"
    },
    {
      "type": "text",
      "id": "category_title",
      "label": "Category title",
      "default": "Produkt-Grundwissen"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Use the same value as the corresponding FAQ navigation link, without the # symbol.",
      "default": "faq-produkt-grundwissen"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Question",
          "default": "How long does shipping take?"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Answer",
          "default": "<p>Orders are typically processed within 1–2 business days.</p>"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "FAQ category",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "title": "How long does shipping take?",
            "text": "<p>Orders are typically processed within 1–2 business days.</p>"
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["footer", "header", "custom.popups"]
  }
}
{% endschema %}
