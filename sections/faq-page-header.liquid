{%- if template.name == 'page' and template.suffix == 'faq' -%}
{%- liquid
  assign faq_banner_overlay_color = section.settings.banner_overlay_color | default: '#041830'
  assign faq_banner_overlay_red = faq_banner_overlay_color | color_extract: 'red'
  assign faq_banner_overlay_green = faq_banner_overlay_color | color_extract: 'green'
  assign faq_banner_overlay_blue = faq_banner_overlay_color | color_extract: 'blue'
  assign faq_banner_overlay_left_opacity = section.settings.banner_overlay_left_opacity | default: 84 | divided_by: 100.0
  assign faq_banner_overlay_middle_opacity = section.settings.banner_overlay_middle_opacity | default: 48 | divided_by: 100.0
  assign faq_banner_overlay_right_opacity = section.settings.banner_overlay_right_opacity | default: 8 | divided_by: 100.0
-%}
<style>
  #shopify-section-{{ section.id }} .faq-page-header {
    width: 100%;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .faq-page-header__banner-wrap {
    display: block;
    width: 100%;
    max-width: 1640px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .faq-page-header__banner {
    position: relative;
    display: flex;
    align-items: stretch;
    min-height: 360px;
    overflow: hidden;
    isolation: isolate;
    background: linear-gradient(115deg, var(--dark) 0%, var(--navy) 52%, var(--blue) 100%);
  }

  #shopify-section-{{ section.id }} .faq-page-header__banner::after {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(circle at 78% 18%, rgba(111, 214, 255, 0.22), transparent 34%),
      linear-gradient(135deg, rgba(4, 24, 48, 0.24), transparent 62%);
    content: '';
  }

  #shopify-section-{{ section.id }} .faq-page-header__media,
  #shopify-section-{{ section.id }} .faq-page-header__media img,
  #shopify-section-{{ section.id }} .faq-page-header__scrim {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .faq-page-header__media {
    z-index: 0;
  }

  #shopify-section-{{ section.id }} .faq-page-header__media img {
    display: block;
    object-fit: cover;
    object-position: center;
  }

  #shopify-section-{{ section.id }} .faq-page-header__scrim {
    z-index: 1;
    background: linear-gradient(90deg, rgba({{ faq_banner_overlay_red }}, {{ faq_banner_overlay_green }}, {{ faq_banner_overlay_blue }}, {{ faq_banner_overlay_left_opacity }}) 0%, rgba({{ faq_banner_overlay_red }}, {{ faq_banner_overlay_green }}, {{ faq_banner_overlay_blue }}, {{ faq_banner_overlay_middle_opacity }}) 48%, rgba({{ faq_banner_overlay_red }}, {{ faq_banner_overlay_green }}, {{ faq_banner_overlay_blue }}, {{ faq_banner_overlay_right_opacity }}) 100%);
  }

  #shopify-section-{{ section.id }} .faq-page-header__banner-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: min(100%, 560px);
    min-height: 360px;
    padding: 52px 64px;
    box-sizing: border-box;
    color: #ffffff;
  }

  #shopify-section-{{ section.id }} .faq-page-header__eyebrow {
    margin: 0 0 12px;
    color: #8edcff;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.1em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .faq-page-header__banner-title {
    max-width: 520px;
    margin: 0;
    color: #ffffff;
    font-size: clamp(32px, 4vw, 54px);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.03em;
  }

  #shopify-section-{{ section.id }} .faq-page-header__banner-text {
    max-width: 480px;
    margin: 18px 0 0;
    color: rgba(255, 255, 255, 0.86);
    font-size: 17px;
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .faq-page-header__banner-text > :first-child {
    margin-top: 0;
  }

  #shopify-section-{{ section.id }} .faq-page-header__banner-text > :last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .faq-page-header__body {
    width: 100%;
    max-width: 1080px;
    padding-top: 34px;
    padding-right: 0;
    padding-left: 0;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .faq-page-header__title-wrap {
    max-width: none;
    margin: 0 0 28px;
    padding: 0 0 28px;
    border-bottom: 1px solid var(--border);
    text-align: left;
  }

  #shopify-section-{{ section.id }} .faq-page-header__title-wrap .faq-page-header__eyebrow {
    margin: 0 0 12px;
    color: var(--blue);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.4;
    text-transform: none;
  }

  #shopify-section-{{ section.id }} .faq-page-header__title {
    margin: 0;
    color: var(--ink);
    font-size: clamp(36px, 4vw, 52px);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.03em;
  }

  #shopify-section-{{ section.id }} .faq-page-header__subtitle {
    max-width: 680px;
    margin: 16px auto 0;
    color: var(--gray-dark);
    font-size: 16px;
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .faq-page-header__subtitle > :first-child {
    margin-top: 0;
  }

  #shopify-section-{{ section.id }} .faq-page-header__subtitle > :last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .faq-page-header__nav {
    width: min(1640px, calc(100vw - 40px));
    margin: 0 0 48px;
    margin-left: 50%;
    transform: translateX(-50%);
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  #shopify-section-{{ section.id }} .faq-page-header__nav::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .faq-page-header__nav-list {
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    gap: 12px;
    max-width: 1280px;
    min-width: min-content;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .faq-page-header__nav-link {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 8px;
    min-height: 42px;
    padding: 9px 14px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: #ffffff;
    color: var(--gray-dark);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.25;
    white-space: nowrap;
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
  }

  #shopify-section-{{ section.id }} .faq-page-header__nav-link:hover,
  #shopify-section-{{ section.id }} .faq-page-header__nav-link:focus-visible,
  #shopify-section-{{ section.id }} .faq-page-header__nav-link.is-active {
    border-color: var(--blue);
    background: #f2f9ff;
    color: var(--blue);
  }

  #shopify-section-{{ section.id }} .faq-page-header__nav-number {
    color: var(--blue);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }

  @media only screen and (min-width: 769px) and (max-width: 1120px) {
    #shopify-section-{{ section.id }} .faq-page-header__nav-list {
      justify-content: center;
      gap: 10px;
    }

    #shopify-section-{{ section.id }} .faq-page-header__nav-link {
      gap: 6px;
      min-height: 40px;
      padding: 8px 10px;
      font-size: 12px;
    }
  }

  @media only screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .faq-page-header__banner-wrap {
      padding: 0;
    }

    #shopify-section-{{ section.id }} .faq-page-header__banner,
    #shopify-section-{{ section.id }} .faq-page-header__banner-content {
      min-height: 320px;
    }

    #shopify-section-{{ section.id }} .faq-page-header__banner-content {
      width: 100%;
      padding: 40px 24px;
    }

    #shopify-section-{{ section.id }} .faq-page-header__banner-title {
      font-size: 36px;
    }

    #shopify-section-{{ section.id }} .faq-page-header__banner-text {
      font-size: 15px;
    }

    #shopify-section-{{ section.id }} .faq-page-header__body {
      max-width: none;
      padding-top: 48px;
      padding-right: 20px;
      padding-bottom: 0;
      padding-left: 20px;
    }

    #shopify-section-{{ section.id }} .faq-page-header__title-wrap {
      margin-bottom: 28px;
      text-align: left;
    }

    #shopify-section-{{ section.id }} .faq-page-header__title {
      font-size: 38px;
    }

    #shopify-section-{{ section.id }} .faq-page-header__nav {
      width: calc(100% + 40px);
      margin-left: -20px;
      margin-right: -20px;
      margin-bottom: 40px;
      padding: 0 20px 6px;
      box-sizing: border-box;
      transform: none;
    }

    #shopify-section-{{ section.id }} .faq-page-header__nav-list {
      flex-wrap: nowrap;
      justify-content: flex-start;
      gap: 8px;
    }
  }

  /* FAQ page UI: compact title, bordered category navigation, and answer-first cards. */
  #shopify-section-{{ section.id }} .faq-page-header__body {
    max-width: 1080px;
    padding-top: 42px;
  }

  #shopify-section-{{ section.id }} .faq-page-header__title-wrap {
    margin-bottom: 22px;
    padding-bottom: 26px;
  }

  #shopify-section-{{ section.id }} .faq-page-header__title-wrap .faq-page-header__eyebrow {
    margin-bottom: 14px;
    font-size: 13px;
    letter-spacing: 0.02em;
  }

  #shopify-section-{{ section.id }} .faq-page-header__title {
    font-size: 40px;
    line-height: 1.16;
    letter-spacing: -0.015em;
  }

  #shopify-section-{{ section.id }} .faq-page-header__nav {
    width: 100%;
    margin: 0 0 42px;
    transform: none;
  }

  #shopify-section-{{ section.id }} .faq-page-header__nav-list {
    justify-content: flex-start;
    gap: 8px;
    max-width: none;
  }

  #shopify-section-{{ section.id }} .faq-page-header__nav-link {
    min-height: 32px;
    padding: 7px 10px;
    border-radius: 4px;
    color: var(--blue);
    font-size: 12px;
    line-height: 1.25;
  }

  #shopify-section-{{ section.id }} .faq-page-header__nav-link:hover,
  #shopify-section-{{ section.id }} .faq-page-header__nav-link:focus-visible,
  #shopify-section-{{ section.id }} .faq-page-header__nav-link.is-active {
    border-color: var(--blue);
    background: var(--blue-soft);
    color: var(--blue);
  }

  @media only screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .faq-page-header__body {
      padding-top: 36px;
    }

    #shopify-section-{{ section.id }} .faq-page-header__title {
      font-size: 38px;
    }

    #shopify-section-{{ section.id }} .faq-page-header__nav {
      width: calc(100% + 40px);
      margin-bottom: 34px;
      padding-bottom: 6px;
    }
  }
</style>

{%- liquid
  assign faq_page_title = section.settings.title | default: 'FAQs'
-%}

<section class="faq-page-header" aria-labelledby="FAQ-page-title-{{ section.id }}">
  <div class="page-width page-width--narrow faq-page-header__body">
    <header class="faq-page-header__title-wrap">
      {%- if section.settings.banner_eyebrow != blank -%}
        <p class="faq-page-header__eyebrow">{{ section.settings.banner_eyebrow | escape }}</p>
      {%- endif -%}
      <h1 id="FAQ-page-title-{{ section.id }}" class="faq-page-header__title">{{ faq_page_title | escape }}</h1>
      {%- if section.settings.subtitle != blank -%}
        <div class="faq-page-header__subtitle rte">{{ section.settings.subtitle }}</div>
      {%- endif -%}
    </header>

    {%- if section.blocks != blank -%}
      <nav class="faq-page-header__nav" aria-label="FAQ Kategorien">
        <ul class="faq-page-header__nav-list">
          {%- for block in section.blocks -%}
            {%- assign faq_nav_anchor = block.settings.anchor_id | default: block.id | handle -%}
            {%- if block.settings.label != blank -%}
              <li {{ block.shopify_attributes }}>
                <a
                  class="faq-page-header__nav-link"
                  href="#{{ faq_nav_anchor }}"
                  data-faq-anchor-link
                  data-faq-target="{{ faq_nav_anchor }}"
                  aria-controls="{{ faq_nav_anchor }}"
                >
                  {%- if block.settings.number != blank -%}
                    <span class="faq-page-header__nav-number">{{ block.settings.number | escape }}</span>
                  {%- endif -%}
                  <span>{{ block.settings.label | escape }}</span>
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}
  </div>
</section>
<script>
  (() => {
    const root = document.querySelector('#shopify-section-{{ section.id }}');
    if (!root || root.dataset.faqAnchorReady === 'true') return;

    root.dataset.faqAnchorReady = 'true';
    const links = Array.from(root.querySelectorAll('[data-faq-anchor-link]'));
    const transitionDuration = 1000;
    let highlightTimer;

    const prefersReducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const setActiveLink = (anchorId) => {
      links.forEach((link) => {
        const isActive = link.dataset.faqTarget === anchorId;
        link.classList.toggle('is-active', isActive);
        if (isActive) {
          link.setAttribute('aria-current', 'location');
        } else {
          link.removeAttribute('aria-current');
        }
      });
    };

    const highlightHeading = (target) => {
      if (!target) return;
      window.clearTimeout(highlightTimer);
      target.classList.remove('is-anchor-target');
      void target.offsetWidth;
      target.classList.add('is-anchor-target');
      highlightTimer = window.setTimeout(() => {
        target.classList.remove('is-anchor-target');
      }, prefersReducedMotion() ? 0 : transitionDuration);
    };

    links.forEach((link) => {
      link.addEventListener('click', (event) => {
        const targetId = link.dataset.faqTarget;
        const target = targetId ? document.getElementById(targetId) : null;
        if (!target) return;

        event.preventDefault();
        target.scrollIntoView({
          behavior: prefersReducedMotion() ? 'auto' : 'smooth',
          block: 'start'
        });
        window.history.pushState(null, '', `#${targetId}`);
        setActiveLink(targetId);
        highlightHeading(target);

        const focusTarget = () => target.focus({ preventScroll: true });
        if (prefersReducedMotion()) {
          focusTarget();
        } else {
          window.setTimeout(focusTarget, 450);
        }
      });
    });

    const syncFromHash = () => {
      const targetId = window.location.hash.slice(1);
      if (!targetId || !links.some((link) => link.dataset.faqTarget === targetId)) return;
      const target = document.getElementById(targetId);
      setActiveLink(targetId);
      highlightHeading(target);
    };

    const setupHeadingObserver = () => {
      if (root.dataset.faqHeadingObserverReady === 'true' || !('IntersectionObserver' in window)) return;

      const headings = document.querySelectorAll('[data-faq-category-heading]');
      if (!headings.length) return;

      root.dataset.faqHeadingObserverReady = 'true';
      const observer = new IntersectionObserver((entries) => {
        const visibleEntry = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visibleEntry) setActiveLink(visibleEntry.target.id);
      }, { rootMargin: '-18% 0px -64% 0px', threshold: [0, 0.25, 0.6, 1] });
      headings.forEach((heading) => observer.observe(heading));
      syncFromHash();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupHeadingObserver, { once: true });
    } else {
      setupHeadingObserver();
    }

    window.addEventListener('hashchange', syncFromHash);
    syncFromHash();
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ page header",
  "class": "index-section--flush",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "横幅图片",
      "info": "Recommended size: 1640 × 360 px. The blue gradient is used when no image is selected."
    },
    {
      "type": "image_picker",
      "id": "banner_image_mobile",
      "label": "横幅图片移动端",
      "info": "Optional. Recommended size: 768 × 520 px. Falls back to the desktop image when empty."
    },
    {
      "type": "header",
      "content": "FAQ Banner overlay"
    },
    {
      "type": "color",
      "id": "banner_overlay_color",
      "label": "横幅叠加层颜色",
      "default": "#041830"
    },
    {
      "type": "range",
      "id": "banner_overlay_left_opacity",
      "label": "横幅叠加层左侧不透明度",
      "info": "0% is transparent and 100% is fully opaque.",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 84
    },
    {
      "type": "range",
      "id": "banner_overlay_middle_opacity",
      "label": "横幅叠加层中间不透明度",
      "info": "Controls the overlay around the center of the banner.",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 48
    },
    {
      "type": "range",
      "id": "banner_overlay_right_opacity",
      "label": "横幅叠加层右侧不透明度",
      "info": "Controls the overlay at the right edge of the banner.",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 8
    },
    {
      "type": "text",
      "id": "banner_eyebrow",
      "label": "横幅眉题",
      "default": "Hilfe & Support"
    },
    {
      "type": "text",
      "id": "banner_title",
      "label": "横幅标题",
      "default": "Wir helfen dir weiter"
    },
    {
      "type": "richtext",
      "id": "banner_text",
      "label": "横幅文本",
      "default": "<p>Antworten auf die wichtigsten Fragen zur VENUS E.</p>"
    },
    {
      "type": "text",
      "id": "title",
      "label": "标题",
      "default": "FAQs"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "副标题"
    }
  ],
  "blocks": [
    {
      "type": "category_link",
      "name": "FAQ category link",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "编号",
          "default": "01"
        },
        {
          "type": "text",
          "id": "label",
          "label": "标签",
          "default": "Produkt-Grundwissen"
        },
        {
          "type": "text",
          "id": "anchor_id",
          "label": "锚点ID",
          "info": "Use the same value as the corresponding FAQ category section, without the # symbol.",
          "default": "faq-produkt-grundwissen"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "FAQ page header",
      "blocks": [
        {
          "type": "category_link",
          "settings": {
            "number": "01",
            "label": "Produkt-Grundwissen",
            "anchor_id": "faq-produkt-grundwissen"
          }
        },
        {
          "type": "category_link",
          "settings": {
            "number": "02",
            "label": "Installation & Kompatibilität",
            "anchor_id": "faq-installation-kompatibilitaet"
          }
        },
        {
          "type": "category_link",
          "settings": {
            "number": "03",
            "label": "Kauf & Lieferung",
            "anchor_id": "faq-kauf-lieferung"
          }
        },
        {
          "type": "category_link",
          "settings": {
            "number": "04",
            "label": "Garantie & Kundenservice",
            "anchor_id": "faq-garantie-kundenservice"
          }
        },
        {
          "type": "category_link",
          "settings": {
            "number": "05",
            "label": "Technische Daten & Anwendung",
            "anchor_id": "faq-technische-daten-anwendung"
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["footer", "header", "custom.popups"]
  }
}
{% endschema %}
