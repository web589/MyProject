{% comment %}
4 Solar Bildkarten Grid 2x2
Text nur bei Hover sichtbar
{% endcomment %}
{% stylesheet %}
.four-card-section {
  width: 100%;
  padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  background: {{ section.settings.bg_color }};
}
.four-card-container {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
  padding: 0 16px;
}
.four-card-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}
.solar-card {
  position: relative;
  overflow: hidden;
  border-radius: 8px;
  min-height: 360px;
  cursor: pointer;
}
.solar-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.4s ease;
}
.card-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(transparent, rgba(0,0,0,0.72));
  opacity: 0;
  transition: opacity 0.35s ease;
}
.solar-card:hover .card-overlay {
  opacity: 1;
}
.card-text-wrap {
  position: absolute;
  bottom: 32px;
  left: 32px;
  right: 32px;
  color: #ffffff;
  z-index: 2;
}
.card-title {
  font-size: clamp(22px,2.2vw,30px);
  font-weight: 700;
  margin: 0 0 10px;
  opacity: 0;
  transform: translateY(16px);
  transition: all 0.32s ease;
}
.card-desc {
  font-size: 16px;
  line-height: 1.55;
  margin: 0;
  opacity: 0;
  transform: translateY(16px);
  transition: all 0.32s ease 0.08s;
}
.solar-card:hover .card-title {
  opacity: 1;
  transform: translateY(0);
}
.solar-card:hover .card-desc {
  opacity: 1;
  transform: translateY(0);
}
@media screen and (max-width: 749px) {
  .four-card-grid {
    grid-template-columns: 1fr;
  }
}
{% endstylesheet %}

<section class="four-card-section">
  <div class="four-card-container">
    <div class="four-card-grid">
      {% for block in section.blocks %}
      <div class="solar-card">
        <img src="{{ block.settings.image }}" alt="{{ block.settings.alt }}">
        <div class="card-overlay"></div>
        <div class="card-text-wrap">
          <h3 class="card-title">{{ block.settings.headline }}</h3>
          <p class="card-desc">{{ block.settings.text }}</p>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Solar Karten Grid",
  "presets": [
    {
      "name": "Vier Karten",
      "blocks": [
        {"type":"item"},
        {"type":"item"},
        {"type":"item"},
        {"type":"item"}
      ]
    }
  ],
  "settings": [
    {
      "type":"range",
      "id":"max_width",
      "label":"Max Breite",
      "min":600,
      "max":1600,
      "step":20,
      "default":1320
    },
    {
      "type":"range",
      "id":"padding_top",
      "label":"Oberer Abstand",
      "min":0,
      "max":160,
      "step":8,
      "default":64
    },
    {
      "type":"range",
      "id":"padding_bottom",
      "label":"Unterer Abstand",
      "min":0,
      "max":160,
      "step":8,
      "default":64
    },
    {
      "type":"color",
      "id":"bg_color",
      "label":"Hintergrundfarbe",
      "default":"#f7f8fa"
    }
  ],
  "blocks": [
    {
      "type":"item",
      "name":"Karte",
      "settings":[
        {"type":"image_picker","id":"image","label":"Bild"},
        {"type":"text","id":"headline","label":"Überschrift","default":"Sofort einsatzbereit"},
        {"type":"textarea","id":"text","label":"Beschreibung","default":"Anschließen, fertig. Der S3-20 lässt sich ohne Elektriker installieren."},
        {"type":"text","id":"alt","label":"Alt-Text"}
      ]
    }
  ]
}
{% endschema %}