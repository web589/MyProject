{% if section.settings.show_section %}
  {% capture section_content %}
<div class="ip-hero-grid{% if section.settings.image == blank and section.settings.show_placeholder == false and request.design_mode == false %} ip-hero-grid--no-media{% endif %}">
  <div class="ip-hero-copy">
    {% render 'ip-heading', section: section, level: 'h1' %}
    {% for block in section.blocks %}
  {% if block.type == 'intro' and block.settings.show_block and block.settings.body != blank %}
    <p class="ip-sub ip-intro" style="{% render 'ip-typography', settings: block.settings, prefix: 'sub' %}" {{ block.shopify_attributes }}>{{ block.settings.body | escape | newline_to_br }}</p>
  {% endif %}
{% endfor %}
    <div class="ip-hero-cta">{% for block in section.blocks %}
  {% if block.type == 'button' %}{% render 'ip-button', block: block, default_link: '#b2bformular' %}{% endif %}
{% endfor %}</div>
  </div>
  {% if section.settings.image != blank or section.settings.show_placeholder or request.design_mode %}
    <div class="ip-media ip-hero-media{% if section.settings.image == blank %} ip-media--placeholder{% endif %}">{% render 'ip-media', image: section.settings.image, alt: section.settings.image_alt, hero: true, placeholder: 'VENUS E für Installateure & Partner', scale: 100 %}</div>
  {% endif %}
</div>
  {% endcapture %}
  {% render 'ip-section', section: section, anchor_id: 'ip-start', extra_class: 'ip-hero', content: section_content %}
{% endif %}

