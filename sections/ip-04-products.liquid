{% if section.settings.show_section %}
  {% capture section_content %}
{% render 'ip-heading', section: section, level: 'h2' %}
{% for block in section.blocks %}
  {% if block.type == 'intro' and block.settings.show_block and block.settings.body != blank %}
    <p class="ip-sub ip-intro" style="{% render 'ip-typography', settings: block.settings, prefix: 'sub' %}" {{ block.shopify_attributes }}>{{ block.settings.body | escape | newline_to_br }}</p>
  {% endif %}
{% endfor %}
<div class="ip-prod">{% for block in section.blocks %}
  {% if block.type == 'storage' and block.settings.show_block %}
    {% liquid
      assign item_product = block.settings.product
      assign item_image = block.settings.image | default: item_product.featured_image
      assign item_link = item_product.url | default: block.settings.link
      assign item_title = block.settings.title | default: item_product.title
      assign item_alt = block.settings.image_alt | default: item_image.alt | default: item_title
    %}
    <article class="ip-p-card" style="{% render 'ip-typography', settings: block.settings, prefix: 'title' %}{% render 'ip-typography', settings: block.settings, prefix: 'body' %}{% render 'ip-typography', settings: block.settings, prefix: 'action' %}--ip-image-scale: {{ block.settings.image_scale | default: 100 }}%;" {{ block.shopify_attributes }}>
      <div class="ip-p-img">{% render 'ip-media', image: item_image, alt: item_alt, hero: false, placeholder: item_title, scale: block.settings.image_scale %}</div>
      <div class="ip-p-body">
        {% if block.settings.tag != blank %}<span class="ip-ptag">{{ block.settings.tag | escape }}</span>{% endif %}
        {% if item_title != blank %}<h3 class="ip-pmodel">{{ item_title | escape }}</h3>{% endif %}
        {% if block.settings.body != blank %}<p class="ip-pdesc">{{ block.settings.body | escape | newline_to_br }}</p>{% endif %}
        {% if item_link != blank and block.settings.label != blank %}<a class="ip-link" href="{{ item_link | escape }}">{{ block.settings.label | escape }}</a>{% endif %}
      </div>
    </article>
  {% endif %}
{% endfor %}</div>
<div class="ip-prod-smart">{% for block in section.blocks %}
  {% if block.type == 'smart_meter' and block.settings.show_block %}
    {% liquid
      assign item_product = block.settings.product
      assign item_image = block.settings.image | default: item_product.featured_image
      assign item_link = item_product.url | default: block.settings.link
      assign item_title = block.settings.title | default: item_product.title
      assign item_alt = block.settings.image_alt | default: item_image.alt | default: item_title
    %}
    <article class="ip-p-card ip-smart-h" style="{% render 'ip-typography', settings: block.settings, prefix: 'title' %}{% render 'ip-typography', settings: block.settings, prefix: 'body' %}{% render 'ip-typography', settings: block.settings, prefix: 'action' %}--ip-image-scale: {{ block.settings.image_scale | default: 100 }}%;" {{ block.shopify_attributes }}>
      <div class="ip-p-img">{% render 'ip-media', image: item_image, alt: item_alt, hero: false, placeholder: item_title, scale: block.settings.image_scale %}</div>
      <div class="ip-p-body">
        {% if block.settings.tag != blank %}<span class="ip-ptag">{{ block.settings.tag | escape }}</span>{% endif %}
        {% if item_title != blank %}<h3 class="ip-pmodel">{{ item_title | escape }}</h3>{% endif %}
        {% if block.settings.body != blank %}<p class="ip-pdesc">{{ block.settings.body | escape | newline_to_br }}</p>{% endif %}
        {% if item_link != blank and block.settings.label != blank %}<a class="ip-link" href="{{ item_link | escape }}">{{ block.settings.label | escape }}</a>{% endif %}
      </div>
    </article>
  {% endif %}
{% endfor %}</div>
<div class="ip-prod-foot">{% for block in section.blocks %}
  {% if block.type == 'button' %}{% render 'ip-button', block: block, default_link: '/pages/speicher-vergleich' %}{% endif %}
{% endfor %}</div>
  {% endcapture %}
  {% render 'ip-section', section: section, anchor_id: 'ip-systeme', extra_class: 'ip-products', content: section_content %}
{% endif %}

