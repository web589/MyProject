{% if section.settings.show_section %}
  {% capture section_content %}
{% render 'ip-heading', section: section, level: 'h2' %}
{% for block in section.blocks %}
  {% if block.type == 'intro' and block.settings.show_block and block.settings.body != blank %}
    <p class="ip-sub ip-intro" style="{% render 'ip-typography', settings: block.settings, prefix: 'sub' %}" {{ block.shopify_attributes }}>{{ block.settings.body | escape | newline_to_br }}</p>
  {% endif %}
{% endfor %}
<div class="ip-cards3">
  {% for block in section.blocks %}
    {% if block.type == 'card' and block.settings.show_block %}
      <div class="ip-card ip-coop-card" role="button" tabindex="0" data-ip-coop="{{ block.settings.interest | escape }}" aria-controls="b2bformular" style="{% render 'ip-typography', settings: block.settings, prefix: 'title' %}{% render 'ip-typography', settings: block.settings, prefix: 'body' %}{% render 'ip-typography', settings: block.settings, prefix: 'action' %}" {{ block.shopify_attributes }}>
        <span class="ip-ic" aria-hidden="true">{% render 'ip-icon', type: block.settings.icon_type, image: block.settings.icon_image %}</span>
        {% if block.settings.title != blank %}<h3>{{ block.settings.title | escape }}</h3>{% endif %}
        {% if block.settings.body != blank %}<p>{{ block.settings.body | escape | newline_to_br }}</p>{% endif %}
        {% if block.settings.label != blank %}<span class="ip-pick">{{ block.settings.label | escape }}</span>{% endif %}
      </div>
    {% endif %}
  {% endfor %}
</div>
{% for block in section.blocks %}
  {% if block.type == 'note' and block.settings.show_block and block.settings.body != blank %}
    <p class="ip-coop-note" style="{% render 'ip-typography', settings: block.settings, prefix: 'body' %}" {{ block.shopify_attributes }}>{{ block.settings.body | escape | newline_to_br }}</p>
  {% endif %}
{% endfor %}
  {% endcapture %}
  {% render 'ip-section', section: section, anchor_id: 'ip-zusammenarbeit', extra_class: 'ip-cooperation', content: section_content %}
{% endif %}

