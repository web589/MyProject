{% if section.settings.show_section %}
  {% capture section_content %}
{% render 'ip-heading', section: section, level: 'h2' %}
{% for block in section.blocks %}
  {% if block.type == 'intro' and block.settings.show_block and block.settings.body != blank %}
    <p class="ip-sub ip-intro" style="{% render 'ip-typography', settings: block.settings, prefix: 'sub' %}" {{ block.shopify_attributes }}>{{ block.settings.body | escape | newline_to_br }}</p>
  {% endif %}
{% endfor %}
<div class="ip-steps">
  {% for block in section.blocks %}
    {% if block.type == 'step' and block.settings.show_block %}
      <article class="ip-step" style="{% render 'ip-typography', settings: block.settings, prefix: 'title' %}{% render 'ip-typography', settings: block.settings, prefix: 'body' %}{% render 'ip-typography', settings: block.settings, prefix: 'action' %}" {{ block.shopify_attributes }}>
        <div class="ip-num" aria-hidden="true">{% if block.settings.icon_image != blank %}{% render 'ip-icon', image: block.settings.icon_image %}{% else %}{{ block.settings.number | escape }}{% endif %}</div>
        {% if block.settings.title != blank %}<h3>{{ block.settings.title | escape }}</h3>{% endif %}
        {% if block.settings.body != blank %}<p>{{ block.settings.body | escape | newline_to_br }}</p>{% endif %}
      </article>
    {% endif %}
  {% endfor %}
</div>
  {% endcapture %}
  {% render 'ip-section', section: section, anchor_id: 'ip-ablauf', extra_class: 'ip-process', content: section_content %}
{% endif %}

