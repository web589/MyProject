{% if section.settings.show_section %}
{%- liquid
  assign form_id = 'IPForm-' | append: section.id
  assign root_id = 'IPFormRoot-' | append: section.id
  assign submit_block = section.blocks | where: 'type', 'submit' | first
  assign success_block = section.blocks | where: 'type', 'success' | first
  assign error_block = section.blocks | where: 'type', 'error' | first
-%}
{%- capture status_fallback_style -%}--ip-title-size:24px;--ip-title-size-tablet:24px;--ip-title-size-mobile:24px;--ip-title-weight:600;--ip-title-line:normal;--ip-title-spacing:0em;--ip-body-size:15px;--ip-body-size-tablet:15px;--ip-body-size-mobile:15px;--ip-body-weight:400;--ip-body-line:1.7;--ip-body-spacing:0em;--ip-action-size:14.5px;--ip-action-size-tablet:14.5px;--ip-action-size-mobile:14.5px;--ip-action-weight:500;--ip-action-line:normal;--ip-action-spacing:0em;{%- endcapture -%}
{%- capture form_content -%}
  {%- form 'contact', id: form_id, return_to: 'back', data-ip-form: '' -%}
    {%- liquid
      assign form_state = 'form'
      if form.posted_successfully?
        assign form_state = 'success'
      elsif form.errors
        assign form_state = 'error'
      endif
    -%}
    {% if section.settings.eyebrow != blank %}<div class="ip-f-eyebrow">{{ section.settings.eyebrow | escape }}</div>{% endif %}
    <h2 class="ip-heading" id="ip-heading-{{ section.id }}">{{ section.settings.heading | escape }}{% if section.settings.heading_accent != blank %} <span class="ip-acc">{{ section.settings.heading_accent | escape }}</span>{% endif %}</h2>
    {% if section.settings.subtitle != blank %}<p class="ip-f-note">{{ section.settings.subtitle | escape | newline_to_br }}</p>{% endif %}
    <input type="hidden" name="contact[Anfrageart]" value="Installateure &amp; Partner">
    <div data-ip-view="form"{% unless form_state == 'form' %} hidden{% endunless %}>
      <div class="ip-form-grid">
        {%- liquid
          assign field_keys = 'company,name,role,email,phone,country,website,interest,message,privacy' | split: ','
          assign configured_slot = 0
        -%}
        {%- for default_key in field_keys -%}
          {%- assign default_block = section.blocks | where: 'type', default_key | first -%}
          {%- if default_block -%}
            {%- liquid
              assign configured_slot = configured_slot | plus: 1
              assign ordered_slot = 0
            -%}
            {%- for block in section.blocks -%}
              {%- if field_keys contains block.type -%}
                {%- assign ordered_slot = ordered_slot | plus: 1 -%}
                {%- if ordered_slot == configured_slot -%}
                  {%- assign render_field = true -%}
                  {%- if block.type == 'phone' or block.type == 'website' -%}
                    {%- unless block.settings.show_field -%}{%- assign render_field = false -%}{%- endunless -%}
                  {%- endif -%}
                  {%- if render_field -%}{% render 'ip-form-field', section: section, block: block, key: block.type, form: form %}{%- endif -%}
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {% render 'ip-form-field', section: section, key: default_key, form: form %}
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="ip-form-cta" style="{% if submit_block %}{% render 'ip-typography', settings: submit_block.settings, prefix: 'action' %}{% else %}--ip-action-size:14.5px;--ip-action-size-tablet:14.5px;--ip-action-size-mobile:14.5px;--ip-action-weight:500;--ip-action-line:normal;--ip-action-spacing:0em;{% endif %}"{% if submit_block %} {{ submit_block.shopify_attributes }}{% endif %}>
        <button type="submit" class="ip-button ip-button--primary">{{ submit_block.settings.label | default: 'B2B-Anfrage senden' | escape }}</button>
      </div>
      {% if submit_block.settings.footnote != blank %}<p class="ip-form-foot">{{ submit_block.settings.footnote | escape | newline_to_br }}</p>{% endif %}
      <div class="ip-spam-disclaimer">{{ 'shopify.online_store.spam_detection.disclaimer_html' | t }}</div>
    </div>
    <div data-ip-view="success"{% unless form_state == 'success' %} hidden{% endunless %}>
      <div class="ip-success" tabindex="-1" data-ip-status-focus role="status" style="{% if success_block %}{% render 'ip-typography', settings: success_block.settings, prefix: 'title' %}{% render 'ip-typography', settings: success_block.settings, prefix: 'body' %}{% render 'ip-typography', settings: success_block.settings, prefix: 'action' %}{% else %}{{ status_fallback_style }}{% endif %}"{% if success_block %} {{ success_block.shopify_attributes }}{% endif %}>
        <div class="ip-status-icon" aria-hidden="true">{% render 'ip-icon', type: 'success', image: success_block.settings.icon_image %}</div>
        <h3 class="ip-status-title">{{ success_block.settings.heading | default: 'Danke für deine B2B-Anfrage' | escape }}</h3>
        <p class="ip-status-body">{{ success_block.settings.body | default: 'Deine Nachricht wurde übermittelt. Wir prüfen Unternehmen, Einsatzbereich und die wichtigsten Angaben deiner Anfrage und melden uns über die von dir angegebene E-Mail-Adresse.' | escape | newline_to_br }}</p>
        <div class="ip-final-cta"><a class="ip-button ip-button--primary" href="{{ success_block.settings.primary_url | default: '/' }}">{{ success_block.settings.primary_label | default: 'Zurück zur Startseite' | escape }}</a></div>
        {%- assign success_links = section.blocks | where: 'type', 'success_link' -%}
        {%- capture success_links_markup -%}
          {%- assign visible_links = 0 -%}
          {%- for block in success_links -%}
            {% if block.settings.show_block and block.settings.label != blank and block.settings.url != blank %}{% if visible_links > 0 %} · {% endif %}<a class="ip-link" href="{{ block.settings.url }}" style="{% render 'ip-typography', settings: block.settings, prefix: 'action' %}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>{% assign visible_links = visible_links | plus: 1 %}{% endif %}
          {%- endfor -%}
          {% if success_links.size == 0 %}<a class="ip-link" href="/pages/downloads" style="--ip-action-size:14px;--ip-action-size-tablet:14px;--ip-action-size-mobile:14px;">Downloads ansehen →</a>{% endif %}
        {%- endcapture -%}
        {% if success_links_markup != blank %}<p class="ip-final-alt">{{ success_block.settings.alt_prefix | default: 'Oder' | escape }} {{ success_links_markup }}</p>{% endif %}
      </div>
    </div>
    <div data-ip-view="error"{% unless form_state == 'error' %} hidden{% endunless %}>
      <div class="ip-success ip-success--error" tabindex="-1" data-ip-status-focus role="alert" style="{% if error_block %}{% render 'ip-typography', settings: error_block.settings, prefix: 'title' %}{% render 'ip-typography', settings: error_block.settings, prefix: 'body' %}{% render 'ip-typography', settings: error_block.settings, prefix: 'action' %}{% else %}{{ status_fallback_style }}{% endif %}"{% if error_block %} {{ error_block.shopify_attributes }}{% endif %}>
        <div class="ip-status-icon" aria-hidden="true">{% render 'ip-icon', type: 'error', image: error_block.settings.icon_image %}</div>
        <h3 class="ip-status-title">{{ error_block.settings.heading | default: 'Das hat leider nicht funktioniert.' | escape }}</h3>
        <p class="ip-status-body">{{ error_block.settings.body | default: 'Deine Anfrage konnte nicht gesendet werden. Bitte versuche es erneut.' | escape | newline_to_br }}</p>
        {% if form.errors %}<div class="ip-server-errors">{{ form.errors | default_errors }}</div>{% endif %}
        <div class="ip-final-cta"><button class="ip-button ip-button--primary" type="button" data-ip-retry>{{ error_block.settings.retry_label | default: 'Erneut versuchen' | escape }}</button></div>
        <noscript><style>#{{ form_id }} [data-ip-view="form"][hidden] { display:block !important; }</style></noscript>
      </div>
    </div>
  {%- endform -%}
{%- endcapture -%}
{%- capture content -%}<div id="{{ root_id }}" class="ip-form-card" data-ip-form-root data-ip-form-state="{{ form_state }}" style="background: {{ section.settings.form_background | default: '#E8F4FF' }}; border-color: {{ section.settings.form_border | default: '#CDEBFF' }};">{{ form_content }}</div>{%- endcapture -%}
{% render 'ip-section', section: section, anchor_id: 'b2bformular', extra_class: 'ip-form-section', content: content %}
{% endif %}

