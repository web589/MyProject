{% if section.settings.show_section %}
  {% capture section_content %}
{% render 'ip-heading', section: section, level: 'h2' %}
{% for block in section.blocks %}
  {% if block.type == 'intro' and block.settings.show_block and block.settings.body != blank %}
    <p class="ip-sub ip-intro" style="{% render 'ip-typography', settings: block.settings, prefix: 'sub' %}" {{ block.shopify_attributes }}>{{ block.settings.body | escape | newline_to_br }}</p>
  {% endif %}
{% endfor %}
<div class="ip-faq-wrap" data-ip-faq>
  {% for block in section.blocks %}
    {% if block.type == 'faq' and block.settings.show_block and block.settings.title != blank %}
      {% assign question_id = 'ip-question-' | append: section.id | append: '-' | append: block.id %}
      {% assign answer_id = 'ip-answer-' | append: section.id | append: '-' | append: block.id %}
      <article class="ip-faq-item" data-ip-faq-item {{ block.shopify_attributes }}>
        <button id="{{ question_id }}" class="ip-faq-q" type="button" aria-expanded="true" aria-controls="{{ answer_id }}" data-ip-faq-question style="{% render 'ip-typography', settings: block.settings, prefix: 'title' %}">{{ block.settings.title | escape }}</button>
        <div id="{{ answer_id }}" class="ip-faq-a" role="region" aria-labelledby="{{ question_id }}" aria-hidden="false" data-ip-faq-answer>
          <div class="ip-faq-answer" style="{% render 'ip-typography', settings: block.settings, prefix: 'body' %}">{{ block.settings.body }}</div>
        </div>
      </article>
    {% endif %}
  {% endfor %}
</div>
  {% endcapture %}
  {% render 'ip-section', section: section, anchor_id: 'ip-faq', extra_class: 'ip-faq', content: section_content %}
{% endif %}

