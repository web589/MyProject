{% if section.settings.show_section %}
<nav id="ip-navigation" class="ip-anchor-nav" data-anchor-nav data-anchor-order="document" aria-label="{{ section.settings.aria_label | escape }}" style="--ip-nav-text-size: {{ section.settings.nav_text_size }}px;">
  <div class="ip-anchor-nav__layout">
    <div class="ip-anchor-nav__links anchor-nav__links">
      {% for block in section.blocks %}
        {% if block.settings.show_block %}
          {% capture target %}{% render 'anchor-navigation-target', module: block.settings.module, fallback: block.settings.target %}{% endcapture %}
          {% assign target = target | strip | remove_first: '#' %}
          {% capture module_label %}{% render 'ip-module-label', module: block.settings.module %}{% endcapture %}
          {% assign label = block.settings.label | default: module_label %}
          {% assign warning_id = 'ip-warning-' | append: section.id | append: '-' | append: block.id %}
          {% if target != blank or request.design_mode %}
            <span class="ip-anchor-nav__item" {{ block.shopify_attributes }}><a class="ip-anchor-nav__link" href="#{{ target | escape }}" data-anchor-link data-anchor-nav-link data-anchor-module="{{ block.settings.module | escape }}" data-anchor-warning-id="{{ warning_id }}">{{ label | strip | escape }}</a></span>
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>
    {% if section.settings.show_cta and section.settings.cta_label != blank %}
      {% capture cta_target %}{% render 'anchor-navigation-target', module: section.settings.cta_module, fallback: section.settings.cta_target %}{% endcapture %}
      {% assign cta_target = cta_target | strip | remove_first: '#' %}
      {% assign cta_warning_id = 'ip-warning-' | append: section.id | append: '-cta' %}
      {% if cta_target != blank or request.design_mode %}<a class="ip-anchor-nav__cta" href="#{{ cta_target | escape }}" data-anchor-link data-anchor-nav-cta data-anchor-warning-id="{{ cta_warning_id }}">{{ section.settings.cta_label | escape }}</a>{% endif %}
    {% endif %}
  </div>
  {% if request.design_mode %}
    <div class="ip-anchor-nav__warnings" aria-live="polite">
      {% for block in section.blocks %}
        {% if block.settings.show_block %}<span id="ip-warning-{{ section.id }}-{{ block.id }}" class="ip-anchor-nav__warning" hidden>未找到目标模块</span>{% endif %}
      {% endfor %}
      {% if section.settings.show_cta and section.settings.cta_label != blank %}<span id="{{ cta_warning_id }}" class="ip-anchor-nav__warning" hidden>未找到目标模块</span>{% endif %}
    </div>
  {% endif %}
</nav>
{% endif %}

{% schema %}
