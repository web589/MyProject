{% if section.settings.show_section %}
  {% capture section_content %}
    <div class="kt-hero-grid{% if section.settings.image == blank and section.settings.show_placeholder == false and request.design_mode == false %} kt-hero-grid--no-media{% endif %}">
      <div class="kt-hero-copy">
        {% render 'kontakt-heading', section: section, level: 'h1' %}
        <div class="kt-hero-cta">
          {% for block in section.blocks %}
            {% if block.settings.show_block and block.settings.label != blank and block.settings.link != blank %}
              <a class="kt-button kt-button--{{ block.settings.style | escape }}" href="{{ block.settings.link | escape }}" style="{% render 'kontakt-typography', settings: block.settings, prefix: 'action' %}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
            {% endif %}
          {% endfor %}
        </div>
      </div>
      {% if section.settings.image != blank %}
        <div class="kt-media">
          {% assign image_alt = section.settings.image_alt | default: section.settings.image.alt %}
          {{ section.settings.image | image_url: width: 1600 | image_tag: class: 'kt-media-image', widths: '400, 600, 800, 1000, 1200, 1600', sizes: '(min-width: 1640px) 748px, (min-width: 1181px) calc(100vw - 892px), (min-width: 981px) calc(100vw - 772px), (min-width: 721px) calc(100vw - 80px), calc(100vw - 44px)', loading: 'eager', fetchpriority: 'high', alt: image_alt }}
        </div>
      {% elsif section.settings.show_placeholder or request.design_mode %}
        <div class="kt-media kt-media-placeholder">
          {% if request.design_mode %}
          <span>上传首屏图片：产品与真实家庭场景</span>
          <span>建议 4:3，1200 × 900；可轻量组合手机或笔记本</span>
          {% else %}
            <span>VENUS E Support</span>
          {% endif %}
        </div>
      {% endif %}
    </div>
  {% endcapture %}
  {% render 'kontakt-section', section: section, anchor_id: 'kontakt-start', extra_class: 'kt-hero', content: section_content %}
{% endif %}

