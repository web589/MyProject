{% if section.settings.show_section %}
  {% capture section_content %}
    {% render 'kontakt-heading', section: section %}
    <div class="kt-self-help">
      {% for block in section.blocks %}
        {% if block.settings.show_block %}
          <div class="kt-help-card" style="{% render 'kontakt-typography', settings: block.settings, prefix: 'title' %}{% render 'kontakt-typography', settings: block.settings, prefix: 'body' %}{% render 'kontakt-typography', settings: block.settings, prefix: 'action' %}" {{ block.shopify_attributes }}>
            <span class="kt-icon" aria-hidden="true">{% render 'kontakt-icon', type: block.settings.icon_type, image: block.settings.icon_image %}</span>
            {% if block.settings.title != blank %}<h3>{{ block.settings.title | escape }}</h3>{% endif %}
            {% if block.settings.body != blank %}<p>{{ block.settings.body | escape | newline_to_br }}</p>{% endif %}
            {% if block.settings.label != blank and block.settings.link != blank %}<a class="kt-lnk" href="{{ block.settings.link | escape }}">{{ block.settings.label | escape }}</a>{% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  {% endcapture %}
  {% render 'kontakt-section', section: section, anchor_id: 'kontakt-selbsthilfe', extra_class: 'kt-self-help-section', content: section_content %}
{% endif %}

