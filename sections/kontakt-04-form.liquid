{% if section.settings.show_section %}
{%- liquid
  assign form_id = 'KontaktForm-' | append: section.id
  assign submit_block = section.blocks | where: 'type', 'submit' | first
  assign success_block = section.blocks | where: 'type', 'success' | first
  assign error_block = section.blocks | where: 'type', 'error' | first
-%}
{%- capture form_content -%}
  {%- form 'contact', id: form_id, return_to: 'back', data-kt-form: '' -%}
    {%- liquid
      assign form_state = 'form'
      if form.posted_successfully?
        assign form_state = 'success'
      elsif form.errors
        assign form_state = 'error'
      endif
    -%}
    {% render 'kontakt-heading', section: section %}
    <div data-kt-view="form"{% unless form_state == 'form' %} hidden{% endunless %}>
      <div class="kt-form-grid">
        {%- assign field_keys = 'topic,product,order,serial,name,email,phone,message,privacy' | split: ',' -%}
        {%- for key in field_keys -%}
          {%- liquid
            assign field_block = section.blocks | where: 'type', key | first
            assign render_field = false
            if key == 'topic' or key == 'name' or key == 'email' or key == 'message' or key == 'privacy'
              assign render_field = true
            elsif field_block and field_block.settings.show_field
              assign render_field = true
            endif
          -%}
          {%- if render_field -%}{% render 'kontakt-form-field', section: section, block: field_block, key: key, form: form %}{%- endif -%}
        {%- endfor -%}
      </div>
      <div class="kt-form-cta"{% if submit_block %} style="{% render 'kontakt-typography', settings: submit_block.settings, prefix: 'action' %}" {{ submit_block.shopify_attributes }}{% endif %}>
        <button type="submit" class="kt-button kt-button--primary">{{ submit_block.settings.label | default: 'Anfrage senden' | escape }}</button>
      </div>
      {%- if submit_block.settings.footnote != blank -%}<p class="kt-form-foot">{{ submit_block.settings.footnote | escape }}</p>{%- endif -%}
      <div class="kt-spam-disclaimer">{{ 'shopify.online_store.spam_detection.disclaimer_html' | t }}</div>
    </div>
    <div data-kt-view="success"{% unless form_state == 'success' %} hidden{% endunless %}>
      <div class="kt-success" tabindex="-1" data-kt-status-focus{% if success_block %} style="{% render 'kontakt-typography', settings: success_block.settings, prefix: 'title' %}{% render 'kontakt-typography', settings: success_block.settings, prefix: 'body' %}{% render 'kontakt-typography', settings: success_block.settings, prefix: 'action' %}" {{ success_block.shopify_attributes }}{% endif %}>
        <div class="kt-status-icon" aria-hidden="true">{% render 'kontakt-icon', type: 'success', image: success_block.settings.icon_image %}</div>
        <h3 class="kt-status-title">{{ success_block.settings.heading | default: 'Danke für deine Anfrage' | escape }}</h3>
        <p class="kt-status-body">{{ success_block.settings.body | default: 'Deine Nachricht wurde übermittelt. Wir prüfen deine Angaben und melden uns über die von dir angegebene E-Mail-Adresse.' | escape | newline_to_br }}</p>
        <div class="kt-final-cta"><a class="kt-button kt-button--primary" href="{{ success_block.settings.primary_url | default: '/' }}">{{ success_block.settings.primary_label | default: 'Zurück zur Startseite' | escape }}</a></div>
        {%- assign success_links = section.blocks | where: 'type', 'success_link' -%}
        {%- if success_links.size > 0 -%}
          <p class="kt-final-alt">{{ success_block.settings.alt_prefix | default: 'Oder' | escape }}
            {%- for block in success_links -%}
              {%- if block.settings.label != blank and block.settings.url != blank -%}
                {% unless forloop.first %} · {% endunless %}<a class="kt-link" href="{{ block.settings.url }}" style="{% render 'kontakt-typography', settings: block.settings, prefix: 'action' %}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
              {%- endif -%}
            {%- endfor -%}
          </p>
        {%- endif -%}
      </div>
    </div>
    <div data-kt-view="error"{% unless form_state == 'error' %} hidden{% endunless %}>
      <div class="kt-success kt-success--error" tabindex="-1" data-kt-status-focus{% if error_block %} style="{% render 'kontakt-typography', settings: error_block.settings, prefix: 'title' %}{% render 'kontakt-typography', settings: error_block.settings, prefix: 'body' %}{% render 'kontakt-typography', settings: error_block.settings, prefix: 'action' %}" {{ error_block.shopify_attributes }}{% endif %}>
        <div class="kt-status-icon" aria-hidden="true">{% render 'kontakt-icon', type: 'error', image: error_block.settings.icon_image %}</div>
        <h3 class="kt-status-title">{{ error_block.settings.heading | default: 'Das hat leider nicht funktioniert.' | escape }}</h3>
        <p class="kt-status-body">{{ error_block.settings.body | default: 'Deine Anfrage konnte nicht gesendet werden. Bitte versuche es erneut.' | escape | newline_to_br }}</p>
        {%- if form.errors -%}<div class="kt-server-errors" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="kt-final-cta"><button class="kt-button kt-button--primary" type="button" data-kt-retry>{{ error_block.settings.retry_label | default: 'Erneut versuchen' | escape }}</button></div>
        <noscript><style>#{{ form_id }} [data-kt-view="form"][hidden] { display:block !important; }</style></noscript>
      </div>
    </div>
  {%- endform -%}
{%- endcapture -%}
{%- capture content -%}<div class="kt-form-card" data-kt-form-root data-kt-form-state="{{ form_state }}" style="--kt-form-background: {{ section.settings.form_background | default: '#E8F4FF' }}; --kt-form-border: {{ section.settings.form_border | default: '#CDEBFF' }};">{{ form_content }}</div>{%- endcapture -%}
{% render 'kontakt-section', section: section, anchor_id: 'kontaktformular', extra_class: 'kt-form-section', content: content %}
{% endif %}

