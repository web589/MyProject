{% capture section_content %}
  {% render 'kontakt-heading', section: section, level: 'h2' %}
  <div class="kt-cards3">
    {% for block in section.blocks %}
      {% if block.settings.show_block %}
        <article class="kt-card" {{ block.shopify_attributes }}>
          <span class="kt-icon" aria-hidden="true">
            {% render 'kontakt-icon', type: block.settings.icon_type, image: block.settings.icon_image %}
          </span>
          {% if block.settings.title != blank %}
            <h3 class="kt-card-title" style="{% render 'kontakt-typography', settings: block.settings, prefix: 'title' %}">{{ block.settings.title | escape }}</h3>
          {% endif %}
          {% if block.settings.body != blank %}
            <div class="kt-card-body" style="{% render 'kontakt-typography', settings: block.settings, prefix: 'body' %}">{{ block.settings.body }}</div>
          {% endif %}
        </article>
      {% endif %}
    {% endfor %}
  </div>
{% endcapture %}
{% render 'kontakt-section', section: section, anchor_id: 'kt-preparation', extra_class: 'kt-preparation', content: section_content %}

