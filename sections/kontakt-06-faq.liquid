{% capture section_content %}
  {% render 'kontakt-heading', section: section, level: 'h2' %}
  <div class="kt-faq-wrap" data-kt-faq>
    {% for block in section.blocks %}
      {% if block.settings.show_block and block.settings.title != blank %}
        {% assign question_id = 'kt-question-' | append: section.id | append: '-' | append: block.id %}
        {% assign answer_id = 'kt-answer-' | append: section.id | append: '-' | append: block.id %}
        <article class="kt-faq-item" data-kt-faq-item {{ block.shopify_attributes }}>
          <button id="{{ question_id }}" class="kt-faq-q" type="button" aria-expanded="false" aria-controls="{{ answer_id }}" data-kt-faq-question style="{% render 'kontakt-typography', settings: block.settings, prefix: 'title' %}">
            {{ block.settings.title | escape }}
          </button>
          <div id="{{ answer_id }}" class="kt-faq-a" role="region" aria-labelledby="{{ question_id }}" data-kt-faq-answer>
            <div class="kt-faq-answer" style="{% render 'kontakt-typography', settings: block.settings, prefix: 'body' %}">{{ block.settings.body }}</div>
          </div>
        </article>
      {% endif %}
    {% endfor %}
  </div>
{% endcapture %}
{% render 'kontakt-section', section: section, anchor_id: 'kt-faq', extra_class: 'kt-faq', content: section_content %}

