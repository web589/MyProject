{% capture section_content %}
  <div class="kt-final-card">
    <div class="kt-final-copy">
      {% render 'kontakt-heading', section: section, level: 'h2' %}
    </div>
    <div class="kt-final-cta">
      {% for block in section.blocks %}
        {% if block.settings.show_block and block.settings.label != blank %}
          {% assign button_link = block.settings.link | default: '#kontaktformular' %}
          <a class="kt-button kt-button--{{ block.settings.style }}" href="{{ button_link | escape }}" style="{% render 'kontakt-typography', settings: block.settings, prefix: 'action' %}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
{% endcapture %}
{% render 'kontakt-section', section: section, anchor_id: 'kt-final', extra_class: 'kt-final', content: section_content %}

