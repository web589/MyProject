{%- liquid
  assign models_collection = collections['venus-e']
  assign models_url = models_collection.url | default: '/collections/venus-e'
  assign accessory_product = all_products['ct002-smart-meter']
  assign accessory_url = accessory_product.url | default: '/products/ct002-smart-meter'
  assign faq_page = pages['faq']
  assign faq_url = faq_page.url | default: '/pages/faq'
  assign contact_page = pages['contact']
  assign contact_url = contact_page.url | default: '/pages/contact'
-%}

<section class="venus-404" data-venus-404 aria-labelledby="venus-404-title-{{ section.id }}">
  <section class="venus-404__hero">
    <div class="venus-404__hero-inner">
      <div class="venus-404__number" aria-hidden="true"><span>40</span><span class="venus-404__accent">4</span></div>
      <h1 id="venus-404-title-{{ section.id }}">Diese Seite wurde nicht gefunden.</h1>
      <p class="venus-404__path">
        Der Link ist nicht mehr verfügbar oder die Seite wurde verschoben.<br>
        <span class="venus-404__accent">Wir bringen dich schnell zurück zu den richtigen Inhalten.</span>
      </p>
      <div class="venus-404__hero-actions">
        <a class="venus-404__button venus-404__button--primary" href="{{ routes.root_url }}">Zur Startseite</a>
        <a class="venus-404__button venus-404__button--ghost" href="{{ models_url | escape }}">VENUS E Modelle ansehen</a>
      </div>

      <svg class="venus-404__breakline" width="380" height="38" viewBox="0 0 380 38" aria-hidden="true">
        <text class="venus-404__breakline-number" x="190" y="11" text-anchor="middle">404</text>
        <line class="venus-404__breakline-segment venus-404__breakline-segment--first" x1="0" y1="26" x2="170" y2="26" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
        <g class="venus-404__breakline-mark" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="185" y1="21" x2="195" y2="31"></line>
          <line x1="195" y1="21" x2="185" y2="31"></line>
        </g>
        <line class="venus-404__breakline-segment venus-404__breakline-segment--second" x1="210" y1="26" x2="356" y2="26" stroke="#C9E7FF" stroke-width="2" stroke-linecap="round"></line>
        <path class="venus-404__breakline-arrow" d="M352 22.5l5 3.5-5 3.5" fill="none" stroke="#C9E7FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </div>
  </section>

  <section class="venus-404__section venus-404__search" aria-labelledby="venus-404-search-title-{{ section.id }}">
    <div class="venus-404__section-inner">
      <p class="venus-404__eyebrow">Suche</p>
      <h2 id="venus-404-search-title-{{ section.id }}">Wohin möchtest du <span class="venus-404__accent">weitergehen?</span></h2>

      <form class="venus-404__search-form" action="{{ routes.search_url }}" method="get" role="search">
        <svg class="venus-404__search-icon" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M21 21l-4.5-4.5"></path>
        </svg>
        <label class="visually-hidden" for="venus-404-search-{{ section.id }}">Suche nach Produkten, Zubehör oder Hilfe</label>
        <input id="venus-404-search-{{ section.id }}" name="q" type="search" placeholder="Suche nach Produkten, Zubehör oder Hilfe" value="{{ search.terms | escape }}" autocomplete="off">
        <button class="venus-404__button venus-404__button--primary" type="submit">Suchen</button>
      </form>

      <div class="venus-404__chips" aria-label="Beliebte Suchbegriffe">
        <span class="venus-404__chips-label">Beliebt:</span>
        {%- assign popular_searches = 'VENUS E Mini|VENUS E 3.0|VENUS E 4.0|VENUS E Max|Smart Meter CT002|Smart Meter CT003 (P1)|Support|Ratgeber' | split: '|' -%}
        {%- for search_term in popular_searches -%}
          <button class="venus-404__chip" type="button" data-venus-404-chip data-search-term="{{ search_term | escape }}">{{ search_term }}</button>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <section class="venus-404__section venus-404__quick" aria-labelledby="venus-404-quick-title-{{ section.id }}">
    <div class="venus-404__section-inner">
      <p class="venus-404__eyebrow">Nächste Schritte</p>
      <h2 id="venus-404-quick-title-{{ section.id }}">Finde deinen Weg <span class="venus-404__accent">zurück</span></h2>

      <div class="venus-404__quick-grid">
        <article class="venus-404__card">
          <svg class="venus-404__card-icon" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="7" width="16" height="10" rx="2"></rect>
            <path d="M19 10h2v4h-2M7 10v4m3-4v4"></path>
          </svg>
          <h3>Solarspeicher entdecken</h3>
          <p>Finde den passenden VENUS E Speicher für dein Zuhause.</p>
          <a class="venus-404__card-link" href="{{ models_url | escape }}">Speicher ansehen <span aria-hidden="true">→</span></a>
        </article>

        <article class="venus-404__card">
          <svg class="venus-404__card-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9 3v6m6-6v6M7 9h10v2a5 5 0 0 1-5 5v5m0-5a5 5 0 0 1-5-5V9"></path>
            <path d="M9 21h6"></path>
          </svg>
          <h3>Passendes Zubehör finden</h3>
          <p>Smart Meter und weiteres Zubehör für dein VENUS E System entdecken.</p>
          <a class="venus-404__card-link" href="{{ accessory_url | escape }}">Zum Zubehör <span aria-hidden="true">→</span></a>
        </article>

        <article class="venus-404__card">
          <svg class="venus-404__card-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6 3h9l3 3v15H6z"></path>
            <path d="M15 3v4h3M9 12h6M9 16h6"></path>
          </svg>
          <h3>Energie-Wissen entdecken</h3>
          <p>Erfahre mehr über Balkonkraftwerk mit Speicher, Nachrüstung und Energieverbrauch.</p>
          <a class="venus-404__card-link" href="/blogs/blog-center">Zum Energie-Wissen <span aria-hidden="true">→</span></a>
        </article>

        <article class="venus-404__card">
          <svg class="venus-404__card-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 13v-1a8 8 0 0 1 16 0v1"></path>
            <path d="M4 13h3v5H5a1 1 0 0 1-1-1zm16 0h-3v5h2a1 1 0 0 0 1-1zM17 19c-1 1-2 1-3 1"></path>
          </svg>
          <h3>Hilfe &amp; Support</h3>
          <p>Wir helfen dir bei Auswahl, Installation und Fragen zu deinem System.</p>
          <a class="venus-404__card-link" href="{{ faq_url | escape }}">Support öffnen <span aria-hidden="true">→</span></a>
        </article>
      </div>
    </div>
  </section>

  <section class="venus-404__section venus-404__support" aria-labelledby="venus-404-support-title-{{ section.id }}">
    <div class="venus-404__section-inner venus-404__support-inner">
      <div>
        <p class="venus-404__eyebrow">Wir helfen weiter</p>
        <h2 id="venus-404-support-title-{{ section.id }}">Du suchst etwas Bestimmtes?</h2>
        <p class="venus-404__support-copy">Wenn du eine bestimmte Seite, ein Produkt oder Zubehör suchst, hilft dir unser Support gerne weiter.</p>
      </div>
      <div class="venus-404__support-actions">
        <a class="venus-404__button venus-404__button--primary" href="{{ contact_url | escape }}">Kontakt aufnehmen</a>
        <a class="venus-404__button venus-404__button--ghost" href="{{ faq_url | escape }}">FAQ ansehen</a>
      </div>
    </div>
  </section>
</section>

<style>
  #shopify-section-{{ section.id }} .venus-404 {
    --venus-404-blue: #0099FE;
    --venus-404-blue-soft: #E8F4FF;
    --venus-404-ink: #0E1B2C;
    --venus-404-gray: #8A97A6;
    --venus-404-gray-dark: #5B6B7C;
    --venus-404-border: #E3E8EE;
    --venus-404-bg: #F5F7F9;
    --venus-404-radius: 10px;
    width: 100%;
    max-width: 1640px;
    margin: 0 auto;
    overflow: hidden;
    color: var(--venus-404-ink);
    background: #fff;
    font-family: 'Inter', var(--typeBasePrimary), var(--typeBaseFallback), sans-serif;
    font-size: 15px;
    -webkit-font-smoothing: antialiased;
  }

  #shopify-section-{{ section.id }} .venus-404,
  #shopify-section-{{ section.id }} .venus-404 * {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .venus-404__hero {
    padding: 64px 100px 68px;
    background: #fff;
  }

  #shopify-section-{{ section.id }} .venus-404__hero-inner,
  #shopify-section-{{ section.id }} .venus-404__section-inner {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .venus-404__hero-inner {
    text-align: center;
  }

  #shopify-section-{{ section.id }} .venus-404__number {
    font-size: 140px;
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--venus-404-ink);
  }

  #shopify-section-{{ section.id }} .venus-404__accent {
    color: var(--venus-404-blue);
  }

  #shopify-section-{{ section.id }} .venus-404 h1,
  #shopify-section-{{ section.id }} .venus-404 h2,
  #shopify-section-{{ section.id }} .venus-404 h3,
  #shopify-section-{{ section.id }} .venus-404 p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .venus-404 h1 {
    margin-top: 16px;
    font-size: 30px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.28;
  }

  #shopify-section-{{ section.id }} .venus-404 h2 {
    font-size: 34px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .venus-404__path {
    margin-top: 16px;
    color: var(--venus-404-gray-dark);
    font-size: 16px;
    line-height: 1.7;
  }

  #shopify-section-{{ section.id }} .venus-404__path .venus-404__accent {
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .venus-404__hero-actions,
  #shopify-section-{{ section.id }} .venus-404__support-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
  }

  #shopify-section-{{ section.id }} .venus-404__hero-actions {
    margin-top: 30px;
  }

  #shopify-section-{{ section.id }} .venus-404__button {
    display: inline-flex;
    min-height: 47px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 14px 30px;
    cursor: pointer;
    font: inherit;
    font-size: 14.5px;
    font-weight: 500;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    transition: background-color 0.18s ease, border-color 0.18s ease, color 0.18s ease, box-shadow 0.18s ease;
  }

  #shopify-section-{{ section.id }} .venus-404__button--primary {
    border-color: var(--venus-404-blue);
    background: var(--venus-404-blue);
    color: #fff;
  }

  #shopify-section-{{ section.id }} .venus-404__button--primary:hover,
  #shopify-section-{{ section.id }} .venus-404__button--primary:focus-visible {
    border-color: #0089e4;
    background: #0089e4;
    box-shadow: 0 4px 14px rgba(0, 153, 254, 0.18);
  }

  #shopify-section-{{ section.id }} .venus-404__button--ghost {
    border-color: #9BD8FF;
    background: #fff;
    color: var(--venus-404-blue);
  }

  #shopify-section-{{ section.id }} .venus-404__button--ghost:hover,
  #shopify-section-{{ section.id }} .venus-404__button--ghost:focus-visible {
    border-color: var(--venus-404-blue);
    background: var(--venus-404-blue-soft);
  }

  #shopify-section-{{ section.id }} .venus-404__button:focus-visible,
  #shopify-section-{{ section.id }} .venus-404__chip:focus-visible,
  #shopify-section-{{ section.id }} .venus-404__card-link:focus-visible {
    outline: 2px solid var(--venus-404-blue);
    outline-offset: 3px;
  }

  #shopify-section-{{ section.id }} .venus-404__breakline {
    display: block;
    width: 380px;
    max-width: 100%;
    margin: 30px auto 0;
    color: var(--venus-404-blue);
    overflow: visible;
  }

  #shopify-section-{{ section.id }} .venus-404__breakline-number {
    fill: var(--venus-404-blue);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  #shopify-section-{{ section.id }} .venus-404__breakline-segment--first {
    stroke-dasharray: 170;
    animation: venus404DrawFirst 3.6s ease-in-out infinite;
  }

  #shopify-section-{{ section.id }} .venus-404__breakline-segment--second {
    stroke-dasharray: 146;
    stroke-dashoffset: 146;
    animation: venus404DrawSecond 3.6s ease-in-out infinite;
  }

  #shopify-section-{{ section.id }} .venus-404__breakline-mark {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: venus404ShowMark 3.6s ease-in-out infinite;
  }

  #shopify-section-{{ section.id }} .venus-404__breakline-arrow {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: venus404ShowArrow 3.6s ease-in-out infinite;
  }

  @keyframes venus404DrawFirst {
    0% { stroke-dashoffset: 170; opacity: 1; }
    25% { stroke-dashoffset: 0; }
    88% { stroke-dashoffset: 0; opacity: 1; }
    96%, 100% { opacity: 0; }
  }

  @keyframes venus404ShowMark {
    0%, 20% { opacity: 0; transform: scale(0.6); }
    32% { opacity: 1; transform: scale(1); }
    88% { opacity: 1; }
    96%, 100% { opacity: 0; }
  }

  @keyframes venus404DrawSecond {
    0%, 40% { stroke-dashoffset: 146; opacity: 1; }
    62% { stroke-dashoffset: 0; }
    88% { stroke-dashoffset: 0; opacity: 1; }
    96%, 100% { opacity: 0; }
  }

  @keyframes venus404ShowArrow {
    0%, 62% { opacity: 0; transform: translateX(-4px); }
    74% { opacity: 1; transform: translateX(0); }
    88% { opacity: 1; }
    96%, 100% { opacity: 0; }
  }

  #shopify-section-{{ section.id }} .venus-404__section {
    padding: 72px 100px;
  }

  #shopify-section-{{ section.id }} .venus-404__search,
  #shopify-section-{{ section.id }} .venus-404__support {
    background: var(--venus-404-bg);
  }

  #shopify-section-{{ section.id }} .venus-404__quick {
    background: #fff;
  }

  #shopify-section-{{ section.id }} .venus-404__eyebrow {
    margin-bottom: 14px;
    color: var(--venus-404-blue);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .venus-404__search-form {
    display: flex;
    height: 72px;
    align-items: center;
    margin-top: 28px;
    overflow: hidden;
    border: 1px solid var(--venus-404-border);
    border-radius: var(--venus-404-radius);
    background: #fff;
    transition: border-color 0.15s ease;
  }

  #shopify-section-{{ section.id }} .venus-404__search-form:focus-within {
    border-color: var(--venus-404-blue);
  }

  #shopify-section-{{ section.id }} .venus-404__search-icon {
    width: 20px;
    height: 20px;
    flex: 0 0 auto;
    margin-left: 26px;
    fill: none;
    stroke: var(--venus-404-gray);
    stroke-width: 1.6;
  }

  #shopify-section-{{ section.id }} .venus-404__search-form input {
    width: 100%;
    height: 100%;
    min-width: 0;
    flex: 1 1 auto;
    border: 0;
    outline: 0;
    padding: 0 18px;
    background: transparent;
    color: var(--venus-404-ink);
    font: inherit;
    font-size: 16px;
  }

  #shopify-section-{{ section.id }} .venus-404__search-form input::placeholder {
    color: var(--venus-404-gray);
  }

  #shopify-section-{{ section.id }} .venus-404__search-form .venus-404__button {
    height: 56px;
    flex: 0 0 auto;
    margin-right: 8px;
  }

  #shopify-section-{{ section.id }} .venus-404__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }

  #shopify-section-{{ section.id }} .venus-404__chips-label {
    align-self: center;
    margin-right: 6px;
    color: var(--venus-404-gray-dark);
    font-size: 12.5px;
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .venus-404__chip {
    border: 1px solid var(--venus-404-border);
    border-radius: 6px;
    padding: 8px 16px;
    cursor: pointer;
    background: #fff;
    color: var(--venus-404-gray-dark);
    font: inherit;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.35;
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }

  #shopify-section-{{ section.id }} .venus-404__chip:hover {
    border-color: var(--venus-404-blue);
    background: var(--venus-404-blue-soft);
    color: var(--venus-404-blue);
  }

  #shopify-section-{{ section.id }} .venus-404__quick-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin-top: 40px;
  }

  #shopify-section-{{ section.id }} .venus-404__card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: 28px 26px 26px;
    border: 1px solid var(--venus-404-border);
    border-radius: var(--venus-404-radius);
    background: #fff;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }

  #shopify-section-{{ section.id }} .venus-404__card:hover {
    border-color: #9BD8FF;
    box-shadow: 0 4px 18px rgba(0, 153, 254, 0.06);
  }

  #shopify-section-{{ section.id }} .venus-404__card-icon {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: var(--venus-404-blue);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
  }

  #shopify-section-{{ section.id }} .venus-404__card h3 {
    margin-top: 22px;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.35;
  }

  #shopify-section-{{ section.id }} .venus-404__card p {
    margin-top: 10px;
    color: var(--venus-404-gray-dark);
    font-size: 13.5px;
    line-height: 1.65;
  }

  #shopify-section-{{ section.id }} .venus-404__card-link {
    display: inline-flex;
    width: fit-content;
    gap: 4px;
    margin-top: 22px;
    color: var(--venus-404-blue);
    font-size: 13.5px;
    font-weight: 500;
    line-height: 1.4;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .venus-404__card-link:hover {
    text-decoration: underline;
  }

  #shopify-section-{{ section.id }} .venus-404__support-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 48px;
  }

  #shopify-section-{{ section.id }} .venus-404__support-copy {
    max-width: 900px;
    margin-top: 12px;
    color: var(--venus-404-gray-dark);
    font-size: 16px;
    line-height: 1.65;
  }

  #shopify-section-{{ section.id }} .venus-404__support-actions {
    flex: 0 0 auto;
  }

  @media only screen and (max-width: 1100px) {
    #shopify-section-{{ section.id }} .venus-404__hero,
    #shopify-section-{{ section.id }} .venus-404__section {
      padding-right: 48px;
      padding-left: 48px;
    }

    #shopify-section-{{ section.id }} .venus-404__quick-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media only screen and (max-width: 640px) {
    #shopify-section-{{ section.id }} .venus-404__hero,
    #shopify-section-{{ section.id }} .venus-404__section {
      padding: 56px 24px;
    }

    #shopify-section-{{ section.id }} .venus-404__hero {
      padding-top: 54px;
      padding-bottom: 60px;
    }

    #shopify-section-{{ section.id }} .venus-404__number {
      font-size: clamp(88px, 25vw, 120px);
    }

    #shopify-section-{{ section.id }} .venus-404 h1 {
      font-size: 24px;
    }

    #shopify-section-{{ section.id }} .venus-404__path {
      font-size: 15px;
    }

    #shopify-section-{{ section.id }} .venus-404__hero-actions,
    #shopify-section-{{ section.id }} .venus-404__support-actions {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }

    #shopify-section-{{ section.id }} .venus-404__button {
      width: 100%;
    }

    #shopify-section-{{ section.id }} .venus-404__breakline {
      margin-top: 28px;
    }

    #shopify-section-{{ section.id }} .venus-404 h2 {
      font-size: 30px;
    }

    #shopify-section-{{ section.id }} .venus-404__search-form {
      height: 64px;
    }

    #shopify-section-{{ section.id }} .venus-404__search-form .venus-404__button {
      height: 50px;
      margin-right: 6px;
      padding-right: 18px;
      padding-left: 18px;
    }

    #shopify-section-{{ section.id }} .venus-404__search-icon {
      margin-left: 18px;
    }

    #shopify-section-{{ section.id }} .venus-404__search-form input {
      padding-right: 10px;
      padding-left: 12px;
      font-size: 15px;
    }

    #shopify-section-{{ section.id }} .venus-404__chips {
      gap: 8px;
    }

    #shopify-section-{{ section.id }} .venus-404__chips-label {
      width: 100%;
      margin-right: 0;
    }

    #shopify-section-{{ section.id }} .venus-404__chip {
      padding: 8px 12px;
    }

    #shopify-section-{{ section.id }} .venus-404__quick-grid {
      gap: 16px;
