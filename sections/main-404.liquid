    #shopify-section-{{ section.id }} .venus-404__card {
      padding: 22px 18px 20px;
    }

    #shopify-section-{{ section.id }} .venus-404__card h3 {
      margin-top: 18px;
      font-size: 17px;
    }

    #shopify-section-{{ section.id }} .venus-404__card p,
    #shopify-section-{{ section.id }} .venus-404__card-link {
      font-size: 13px;
    }

    #shopify-section-{{ section.id }} .venus-404__support-inner {
      align-items: flex-start;
      flex-direction: column;
      gap: 28px;
    }

    #shopify-section-{{ section.id }} .venus-404__support-copy {
      font-size: 15px;
    }

    #shopify-section-{{ section.id }} .venus-404__support-actions {
      align-items: stretch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .venus-404 * {
      scroll-behavior: auto;
      transition-duration: 0.01ms;
      animation-duration: 0.01ms;
      animation-iteration-count: 1;
    }

    #shopify-section-{{ section.id }} .venus-404__breakline-segment--first,
    #shopify-section-{{ section.id }} .venus-404__breakline-segment--second {
      stroke-dashoffset: 0;
      opacity: 1;
    }

    #shopify-section-{{ section.id }} .venus-404__breakline-mark,
    #shopify-section-{{ section.id }} .venus-404__breakline-arrow {
      opacity: 1;
      transform: none;
    }
  }

  body[data-disable-animations="true"] #shopify-section-{{ section.id }} .venus-404__breakline-segment--first,
  body[data-disable-animations="true"] #shopify-section-{{ section.id }} .venus-404__breakline-segment--second,
  body[data-disable-animations="true"] #shopify-section-{{ section.id }} .venus-404__breakline-mark,
  body[data-disable-animations="true"] #shopify-section-{{ section.id }} .venus-404__breakline-arrow {
    animation: none;
