    transform: none;
  }
</style>

<script>
  (function() {
    var section = document.querySelector('#shopify-section-{{ section.id }} [data-venus-404]');
    if (!section || section.dataset.venus404Initialized === 'true') return;

    section.dataset.venus404Initialized = 'true';
    var input = section.querySelector('input[name="q"]');
    if (!input) return;

    section.querySelectorAll('[data-venus-404-chip]').forEach(function(chip) {
      chip.addEventListener('click', function() {
        input.value = chip.dataset.searchTerm || chip.textContent.trim();
        input.focus();
      });
    });
  })();
</script>

