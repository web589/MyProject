{%- assign page_id = 'smart-meter-app-' | append: section.id -%}

<section id="app" class="smart-meter-page sm-section sm-app" data-smart-meter-page aria-labelledby="{{ page_id }}-heading" style="{% render 'smart-meter-style', section: section %} --sm-app-image-height: {{ section.settings.image_height | default: 480 }}px; --sm-app-image-width: {{ section.settings.image_width | default: 100 }}%;">
  <div class="sm-container">
    {% if section.settings.eyebrow != blank %}<p class="sm-eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
    <h2 id="{{ page_id }}-heading">{{ section.settings.heading_before }}{% if section.settings.heading_highlight != blank %} <span class="sm-accent">{{ section.settings.heading_highlight }}</span>{% endif %}</h2>
    {% if section.settings.subtext != blank %}<p class="sm-subtext">{{ section.settings.subtext }}</p>{% endif %}
    <div class="sm-app__grid">
      <div class="sm-media sm-app__media">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 981px) 55vw, 100vw', alt: section.settings.image_alt }}
        {% else %}
          <div class="sm-placeholder">{{ section.settings.image_placeholder }}</div>
        {% endif %}
      </div>
      <div class="sm-app__points">
        {% for block in section.blocks %}
          <article class="sm-app-point" {{ block.shopify_attributes }}>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </article>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "智能电表 · 应用数据",
  "class": "section-smart-meter-app",
  "settings": [
    {"type":"text","id":"eyebrow","label":"眉题","default":"Sichtbarkeit"},
    {"type":"text","id":"heading_before","label":"标题前半部分","default":"Dein Energiefluss"},
    {"type":"text","id":"heading_highlight","label":"标题高亮部分","default":"auf einen Blick"},
    {"type":"textarea","id":"subtext","label":"副标题","default":"Die MARSTEK App zeigt dir verfügbare Mess- und Speicherdaten. Welche Ansichten und Werte du siehst, hängt von den verbundenen Geräten und deiner Konfiguration ab."},
    {"type":"image_picker","id":"image","label":"应用界面图片"},
    {"type":"text","id":"image_alt","label":"图片替代文字","default":"MARSTEK App mit Energiedaten eines Smart Meters"},
    {"type":"text","id":"image_placeholder","label":"图片占位文字","default":"MARSTEK-App-Ansicht auswählen"},
    {"type":"header","content":"排版与布局"},
    {"type":"range","id":"heading_size","label":"标题大小","min":24,"max":56,"step":1,"unit":"px","default":34},
    {"type":"range","id":"body_size","label":"正文大小","min":12,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"eyebrow_size","label":"眉题大小","min":10,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"item_heading_size","label":"说明标题大小","min":14,"max":30,"step":1,"unit":"px","default":17},
    {"type":"range","id":"item_text_size","label":"说明正文大小","min":10,"max":20,"step":1,"unit":"px","default":14},
    {"type":"range","id":"control_size","label":"控件文字大小","min":11,"max":18,"step":1,"unit":"px","default":14},
    {"type":"range","id":"note_size","label":"备注文字大小","min":10,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"section_spacing","label":"区块上下间距","min":40,"max":140,"step":4,"unit":"px","default":72},
    {"type":"range","id":"image_height","label":"应用界面图片高度","min":300,"max":620,"step":10,"unit":"px","default":480},
    {"type":"range","id":"image_width","label":"应用界面图片宽度","min":50,"max":100,"step":1,"unit":"%","default":100}
  ],
  "blocks": [
    {"type":"point","name":"应用信息点","settings":[
      {"type":"text","id":"title","label":"标题","default":"Netzbezug & Einspeisung"},
      {"type":"textarea","id":"text","label":"正文","default":"Erkenne anhand der verfügbaren Messwerte, ob Strom aus dem Netz bezogen oder eingespeist wird."}
    ]}
  ],
  "max_blocks": 6,
  "presets": [{"name":"智能电表 · 应用数据","blocks":[{"type":"point"},{"type":"point","settings":{"title":"Laden & Entladen","text":"Sieh, ob dein Speicher gerade Energie aufnimmt oder bereitstellt."}},{"type":"point","settings":{"title":"Ladezustand","text":"Prüfe den Ladezustand deines VENUS E Speichers."}}]}]
}
{% endschema %}
