{%- assign page_id = 'smart-meter-everyday-' | append: section.id -%}

<section id="daten" class="smart-meter-page sm-section sm-everyday" data-smart-meter-page aria-labelledby="{{ page_id }}-heading" style="{% render 'smart-meter-style', section: section %} --sm-everyday-image-height: {{ section.settings.image_height | default: 420 }}px;">
  <div class="sm-container">
    {% if section.settings.eyebrow != blank %}<p class="sm-eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
    <h2 id="{{ page_id }}-heading">{{ section.settings.heading_before }}{% if section.settings.heading_highlight != blank %} <span class="sm-accent">{{ section.settings.heading_highlight }}</span>{% endif %}</h2>
    {% if section.settings.subtext != blank %}<p class="sm-subtext">{{ section.settings.subtext }}</p>{% endif %}
    <div class="sm-everyday__grid">
      <figure class="sm-everyday__figure">
        <div class="sm-media sm-everyday__media">
          {% if section.settings.image != blank %}
            {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200', sizes: '(min-width: 981px) 40vw, 100vw', alt: section.settings.image_alt }}
          {% else %}
            <div class="sm-placeholder">{{ section.settings.image_placeholder }}</div>
          {% endif %}
        </div>
        {% if section.settings.caption != blank %}<figcaption>{{ section.settings.caption }}</figcaption>{% endif %}
      </figure>
      <div class="sm-case-list">
        {% for block in section.blocks %}
          <article class="sm-case-card{% if block.settings.highlight %} sm-case-card--highlight{% endif %}" {{ block.shopify_attributes }}>
            {% if block.settings.label != blank %}<p class="sm-case-card__label">{{ block.settings.label }}</p>{% endif %}
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </article>
        {% endfor %}
      </div>
    </div>
    {% if section.settings.summary != blank %}<p class="sm-compare-summary">{{ section.settings.summary }}</p>{% endif %}
    {% if section.settings.note != blank %}<p class="sm-note sm-note--center">{{ section.settings.note }}</p>{% endif %}
  </div>
</section>

{% schema %}
{
  "name": "智能电表 · 日常示例",
  "class": "section-smart-meter-everyday",
  "settings": [
    {"type":"text","id":"eyebrow","label":"眉题","default":"Im Alltag"},
    {"type":"text","id":"heading_before","label":"标题前半部分","default":"So helfen Messdaten bei"},
    {"type":"text","id":"heading_highlight","label":"标题高亮部分","default":"wechselndem Strombedarf"},
    {"type":"textarea","id":"subtext","label":"副标题","default":"Beispiel: Ein zusätzlicher Verbraucher wird eingeschaltet und dein Zuhause bezieht mehr Strom aus dem Netz."},
    {"type":"image_picker","id":"image","label":"场景图片"},
    {"type":"text","id":"image_alt","label":"图片替代文字","default":"Haushalt mit erhöhtem Strombedarf am Abend"},
    {"type":"text","id":"image_placeholder","label":"图片占位文字","default":"Alltagsszene auswählen"},
    {"type":"text","id":"caption","label":"图片说明","default":"Der Strombedarf im Haushalt steigt."},
    {"type":"text","id":"summary","label":"对比总结","default":"Der Smart Meter liefert die Messdaten. VENUS E regelt die Speicherleistung."},
    {"type":"text","id":"note","label":"备注","default":"Beispielhafte Darstellung. Die mögliche Anpassung hängt von Ladezustand, Leistungsgrenzen und Einstellungen ab."},
    {"type":"header","content":"排版与布局"},
    {"type":"range","id":"heading_size","label":"标题大小","min":24,"max":56,"step":1,"unit":"px","default":34},
    {"type":"range","id":"body_size","label":"正文大小","min":12,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"eyebrow_size","label":"眉题大小","min":10,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"item_heading_size","label":"对照卡标题大小","min":14,"max":30,"step":1,"unit":"px","default":18},
    {"type":"range","id":"item_text_size","label":"对照卡正文大小","min":10,"max":20,"step":1,"unit":"px","default":14},
    {"type":"range","id":"control_size","label":"控件文字大小","min":11,"max":18,"step":1,"unit":"px","default":14},
    {"type":"range","id":"note_size","label":"备注文字大小","min":10,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"section_spacing","label":"区块上下间距","min":40,"max":140,"step":4,"unit":"px","default":72},
    {"type":"range","id":"image_height","label":"场景图片高度","min":240,"max":560,"step":10,"unit":"px","default":420}
  ],
  "blocks": [
    {"type":"case","name":"对照卡","settings":[
      {"type":"text","id":"label","label":"标签","default":"Ohne aktuelle Netzflussdaten"},
      {"type":"text","id":"title","label":"标题","default":"Keine aktuelle Rückmeldung zum Netzbezug"},
      {"type":"textarea","id":"text","label":"正文","default":"Der gestiegene Netzbezug steht der Speicherregelung nicht als aktueller Messwert zur Verfügung."},
      {"type":"checkbox","id":"highlight","label":"高亮显示","default":false}
    ]}
  ],
  "max_blocks": 4,
  "presets": [{"name":"智能电表 · 日常示例","blocks":[{"type":"case"},{"type":"case","settings":{"label":"Mit aktuellen Netzflussdaten","title":"VENUS E kann seine Leistung anpassen","text":"Der erhöhte Netzbezug wird erfasst. Bei ausreichendem Ladezustand kann VENUS E seine Entladeleistung anpassen und einen Teil des zusätzlichen Bedarfs decken.","highlight":true}}]}]
}
{% endschema %}
