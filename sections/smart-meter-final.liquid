{%- assign page_id = 'smart-meter-final-' | append: section.id -%}

<section class="smart-meter-page sm-section sm-final" data-smart-meter-page aria-labelledby="{{ page_id }}-heading" style="{% render 'smart-meter-style', section: section %}">
  <div class="sm-container">
    <div class="sm-final-card">
      {% if section.settings.eyebrow != blank %}<p class="sm-eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      <h2 id="{{ page_id }}-heading">{{ section.settings.heading }}</h2>
      {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
      <div class="sm-actions sm-final-card__actions">
        {% for block in section.blocks %}
          <a class="{% if block.settings.style == 'text' %}sm-text-link{% else %}sm-button sm-button--{{ block.settings.style }}{% endif %}" href="{{ block.settings.url | default: '#ct' }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "智能电表 · 最终行动",
  "class": "section-smart-meter-final",
  "settings": [
    {"type":"text","id":"eyebrow","label":"眉题","default":"Nächster Schritt"},
    {"type":"text","id":"heading","label":"标题","default":"Finde den passenden Smart Meter für deinen Speicher"},
    {"type":"textarea","id":"text","label":"正文","default":"Vergleiche CT002 und CT003 (P1) und prüfe, welche Messlösung zu deinem Stromzähler und deinem VENUS E Modell passt."},
    {"type":"header","content":"排版与布局"},
    {"type":"range","id":"heading_size","label":"标题大小","min":24,"max":56,"step":1,"unit":"px","default":30},
    {"type":"range","id":"body_size","label":"正文大小","min":12,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"eyebrow_size","label":"眉题大小","min":10,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"item_heading_size","label":"项目标题大小","min":14,"max":30,"step":1,"unit":"px","default":18},
    {"type":"range","id":"item_text_size","label":"项目正文大小","min":10,"max":20,"step":1,"unit":"px","default":14},
    {"type":"range","id":"control_size","label":"按钮文字大小","min":11,"max":18,"step":1,"unit":"px","default":15},
    {"type":"range","id":"note_size","label":"备注文字大小","min":10,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"section_spacing","label":"区块上下间距","min":40,"max":140,"step":4,"unit":"px","default":72}
  ],
  "blocks": [
    {"type":"action","name":"行动项","settings":[
      {"type":"text","id":"label","label":"文字","default":"Smart Meter vergleichen"},
      {"type":"url","id":"url","label":"链接地址"},
      {"type":"select","id":"style","label":"样式","options":[{"value":"primary","label":"主按钮"},{"value":"secondary","label":"次按钮"},{"value":"text","label":"文字链接"}],"default":"primary"}
    ]}
  ],
  "max_blocks": 5,
  "presets": [{"name":"智能电表 · 最终行动","blocks":[{"type":"action"},{"type":"action","settings":{"label":"Kompatibilität prüfen","style":"secondary"}},{"type":"action","settings":{"label":"Speichermodelle ansehen →","style":"text"}}]}]
}
{% endschema %}
