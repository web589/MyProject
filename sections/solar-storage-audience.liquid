<section id="{{ section.settings.anchor_id | handle }}" class="ss-section ss-audience" style="--ss-section-spacing: {{ section.settings.section_spacing }}px;">
  <div class="ss-container">
    {% render 'solar-storage-section-heading', eyebrow: section.settings.eyebrow, heading_before: section.settings.heading_before, heading_highlight: section.settings.heading_highlight, subtext: section.settings.subtext %}
    <div class="ss-check-list">
      {% for block in section.blocks %}
        <article class="ss-check-item" {{ block.shopify_attributes }}><span class="ss-icon">{% render 'solar-storage-icon', icon: block.settings.icon %}</span><div><h3>{{ block.settings.title | escape }}</h3><div class="rte">{{ block.settings.text }}</div></div></article>
      {% endfor %}
    </div>
    {% if section.settings.note != blank %}<div class="ss-note rte">{{ section.settings.note }}</div>{% endif %}
  </div>
</section>
{% schema %}
{
  "name": "储能专题 · 适用家庭",
  "class": "section-solar-storage-audience",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "锚点 ID", "default": "eignung" },
    { "type": "text", "id": "eyebrow", "label": "眉题", "default": "Eignung" },
    { "type": "text", "id": "heading_before", "label": "标题前半部分", "default": "Wann passt ein Solarspeicher zu deinem" },
    { "type": "text", "id": "heading_highlight", "label": "标题高亮部分", "default": "Haushalt?" },
    { "type": "richtext", "id": "subtext", "label": "副标题", "default": "<p>Typische Situationen, in denen gespeicherter Solarstrom im Alltag besonders sinnvoll genutzt werden kann.</p>" },
    { "type": "richtext", "id": "note", "label": "说明注释", "default": "<p>Wie sinnvoll ein Speicher für deinen Haushalt ist, hängt von deinem individuellen Verbrauch, der Solarerzeugung und deinen Nutzungszielen ab. Pauschale Aussagen sind hier wenig hilfreich.</p>" },
    { "type": "range", "id": "section_spacing", "label": "区块上下间距", "min": 48, "max": 100, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    { "type": "item", "name": "适用情况", "settings": [
      { "type": "select", "id": "icon", "label": "线性图标", "options": [{ "value": "day-evening", "label": "昼夜" }, { "value": "home", "label": "住宅" }, { "value": "chart", "label": "用量" }, { "value": "car", "label": "电动车" }, { "value": "shield", "label": "规划" }], "default": "day-evening" },
      { "type": "text", "id": "title", "label": "标题", "default": "Erzeugung am Tag, Verbrauch am Abend" },
      { "type": "richtext", "id": "text", "label": "说明文字", "default": "<p>Wenn die meiste Solarenergie entsteht, während der Verbrauch im Haushalt niedrig ist, kann ein größerer Teil des Stroms nicht direkt selbst genutzt werden.</p>" }
    ] }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "储能专题 · 适用家庭" }]
}
{% endschema %}
