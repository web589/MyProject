<section id="{{ section.settings.anchor_id | handle }}" class="ss-section ss-factors ss-section--soft" style="--ss-section-spacing: {{ section.settings.section_spacing }}px;">
  <div class="ss-container">
    {% render 'solar-storage-section-heading', eyebrow: section.settings.eyebrow, heading_before: section.settings.heading_before, heading_highlight: section.settings.heading_highlight, subtext: section.settings.subtext %}
    <div class="ss-card-grid ss-card-grid--four">
      {% for block in section.blocks %}
        <article class="ss-icon-card" {{ block.shopify_attributes }}><span class="ss-icon">{% render 'solar-storage-icon', icon: block.settings.icon, image: block.settings.custom_icon %}</span><h3>{{ block.settings.title | escape }}</h3><div class="rte">{{ block.settings.text }}</div></article>
      {% endfor %}
    </div>
    {% if section.settings.note != blank %}<div class="ss-note rte">{{ section.settings.note }}</div>{% endif %}
  </div>
</section>
{% schema %}
{
  "name": "储能专题 · 影响因素",
  "class": "section-solar-storage-factors",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "锚点 ID", "default": "nutzen" },
    { "type": "text", "id": "eyebrow", "label": "眉题", "default": "Nutzenfaktoren" },
    { "type": "text", "id": "heading_before", "label": "标题前半部分", "default": "Wovon hängt der Nutzen eines" },
    { "type": "text", "id": "heading_highlight", "label": "标题高亮部分", "default": "Solarspeichers ab?" },
    { "type": "richtext", "id": "subtext", "label": "副标题", "default": "<p>Wie sinnvoll ein Speicher im Alltag eingesetzt werden kann, hängt nicht nur von seiner Größe ab.</p>" },
    { "type": "richtext", "id": "note", "label": "说明注释", "default": "<p>Wie hoch der Nutzen ausfällt, hängt von Anlagengröße, Verbrauchsprofil und Speicherkapazität ab. Ein Solarspeicher macht einen Haushalt nicht vollständig unabhängig vom öffentlichen Netz.</p>" },
    { "type": "range", "id": "section_spacing", "label": "区块上下间距", "min": 48, "max": 100, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    { "type": "factor", "name": "影响因素卡", "settings": [
      { "type": "image_picker", "id": "custom_icon", "label": "自定义上传图标", "info": "上传后优先显示；建议使用透明背景图标。" },
      { "type": "select", "id": "icon", "label": "默认图标（未上传时）", "options": [{ "value": "clock", "label": "时钟" }, { "value": "sun", "label": "太阳" }, { "value": "battery", "label": "电池" }, { "value": "plug", "label": "插头" }], "default": "clock" },
      { "type": "text", "id": "title", "label": "标题", "default": "Verbrauchsprofil" },
      { "type": "richtext", "id": "text", "label": "说明文字", "default": "<p>Entscheidend ist, wann dein Haushalt Strom benötigt – nicht nur wie viel.</p>" }
    ] }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "储能专题 · 影响因素" }]
}
{% endschema %}
