<section id="{{ section.settings.anchor_id | handle }}" class="ss-section ss-final ss-section--soft" style="--ss-section-spacing: {{ section.settings.section_spacing }}px;">
  <div class="ss-container"><div class="ss-final-card">{% render 'solar-storage-section-heading', eyebrow: section.settings.eyebrow, heading_before: section.settings.heading_before, heading_highlight: section.settings.heading_highlight %}<div class="ss-final-card__text rte">{{ section.settings.text }}</div><div class="ss-actions">{% for block in section.blocks %}{% if block.settings.label != blank and block.settings.url != blank %}{% if block.settings.style == 'text' %}<a class="ss-text-link ss-final-card__text-link" href="{{ block.settings.url }}" {{ block.shopify_attributes }}>{{ block.settings.prefix | escape }} {{ block.settings.label | escape }}</a>{% else %}<a class="ss-button ss-button--{{ block.settings.style }}" href="{{ block.settings.url }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>{% endif %}{% endif %}{% endfor %}</div></div></div>
</section>
{% schema %}
{
  "name": "储能专题 · 结尾行动",
  "class": "section-solar-storage-final",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "锚点 ID", "default": "abschluss" },
    { "type": "text", "id": "eyebrow", "label": "眉题", "default": "Nächster Schritt" },
    { "type": "text", "id": "heading_before", "label": "标题前半部分", "default": "Finde den passenden Solarspeicher für dein" },
    { "type": "text", "id": "heading_highlight", "label": "标题高亮部分", "default": "Zuhause" },
    { "type": "richtext", "id": "text", "label": "说明文字", "default": "<p>Vergleiche die VENUS E Modelle, hol dir eine Orientierung zur passenden Größe oder lass dich individuell beraten.</p>" },
    { "type": "range", "id": "section_spacing", "label": "区块上下间距", "min": 48, "max": 100, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    { "type": "action", "name": "行动入口", "settings": [
      { "type": "text", "id": "prefix", "label": "文字链接前缀", "default": "Oder" },
      { "type": "text", "id": "label", "label": "显示文字", "default": "Modelle vergleichen" },
      { "type": "url", "id": "url", "label": "链接地址", "default": "/pages/speicher-vergleich" },
      { "type": "select", "id": "style", "label": "展示样式", "options": [{ "value": "primary", "label": "主按钮" }, { "value": "secondary", "label": "次按钮" }, { "value": "text", "label": "文字链接" }], "default": "primary" }
    ] }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "储能专题 · 结尾行动" }]
}
{% endschema %}
