{% assign function_anchor = 'funktionsweise' %}
<section id="{{ function_anchor }}" class="ss-section ss-function ss-section--soft" style="--ss-section-spacing: {{ section.settings.section_spacing }}px;">
  <div class="ss-container">
    {% render 'solar-storage-section-heading', eyebrow: section.settings.eyebrow, heading_before: section.settings.heading_before, heading_highlight: section.settings.heading_highlight, subtext: section.settings.subtext %}
    <div class="ss-video" style="--ss-media-ratio: 2.2 / 1;">
      {% if section.settings.video != blank %}
        {{ section.settings.video | video_tag: image_size: '1800x', autoplay: true, loop: true, muted: true, controls: false, class: 'ss-video__media' }}
      {% elsif section.settings.poster != blank %}
        {{ section.settings.poster | image_url: width: 1800 | image_tag: widths: '720, 960, 1200, 1440, 1800', sizes: '(min-width: 1181px) 1440px, calc(100vw - 44px)', loading: 'lazy', alt: section.settings.poster_alt, class: 'ss-video__poster' }}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'ss-media__placeholder' }}
      {% endif %}
      <span class="ss-media-badge">VIDEO</span>
    </div>
    <div class="ss-step-grid">
      {% for block in section.blocks %}
        <article class="ss-step" {{ block.shopify_attributes }}><p class="ss-step__number">{{ block.settings.number | escape }}</p><h3>{{ block.settings.title | escape }}</h3><div class="rte">{{ block.settings.text }}</div></article>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "储能专题 · 工作原理",
  "class": "section-solar-storage-function",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "眉题", "default": "Funktionsweise" },
    { "type": "text", "id": "heading_before", "label": "标题前半部分", "default": "So funktioniert ein Solarspeicher im" },
    { "type": "text", "id": "heading_highlight", "label": "标题高亮部分", "default": "Alltag" },
    { "type": "richtext", "id": "subtext", "label": "副标题", "default": "<p>Der Ablauf ist im Prinzip immer gleich – unabhängig davon, wie groß die Anlage ist.</p>" },
    { "type": "video", "id": "video", "label": "循环视频" },
    { "type": "image_picker", "id": "poster", "label": "视频封面图" },
    { "type": "text", "id": "poster_alt", "label": "封面图替代文本", "default": "Wohnhaus mit PV-Anlage und Solarspeicher im Tagesverlauf" },
    { "type": "range", "id": "section_spacing", "label": "区块上下间距", "min": 48, "max": 100, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    { "type": "step", "name": "步骤", "settings": [
      { "type": "text", "id": "number", "label": "步骤编号", "default": "SCHRITT 01" },
      { "type": "text", "id": "title", "label": "标题", "default": "Strom erzeugen" },
      { "type": "richtext", "id": "text", "label": "说明文字", "default": "<p>Die PV-Anlage erzeugt Strom, solange Sonne auf die Module trifft.</p>" }
    ] }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "储能专题 · 工作原理" }]
}
{% endschema %}
