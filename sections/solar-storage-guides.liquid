{% liquid
  assign guides_anchor = 'ratgeber'
  assign source_blog = blogs['solarspeicher']
  assign all_guides_link = section.settings.all_link | default: source_blog.url | default: '/blogs/solarspeicher'
%}
<section id="{{ guides_anchor }}" class="ss-section ss-guides" style="--ss-section-spacing: {{ section.settings.section_spacing }}px;">
  <div class="ss-container">
    {% render 'solar-storage-section-heading', eyebrow: section.settings.eyebrow, heading_before: section.settings.heading_before, heading_highlight: section.settings.heading_highlight, subtext: section.settings.subtext %}
    {% if source_blog != blank and source_blog.articles_count > 0 %}
      <div class="ss-card-grid ss-card-grid--three">
        {% for article in source_blog.articles limit: 3 %}
          {% liquid
            assign card_image = article.image
            assign card_alt = card_image.alt | default: article.title
            assign article_summary = article.excerpt_or_content | strip_html | strip | truncatewords: 28
          %}
          <article class="ss-media-card">
            <a class="ss-media-card__image-link" href="{{ article.url }}">
              {% render 'solar-storage-media', image: card_image, alt: card_alt, ratio: '16 / 9', loading: 'lazy', sizes: '(min-width: 981px) 33vw, calc(100vw - 44px)' %}
            </a>
            <div class="ss-media-card__body">
              <p class="ss-tag">{{ section.settings.tag | escape }}</p>
              <h3><a class="ss-media-card__title-link" href="{{ article.url }}">{{ article.title | escape }}</a></h3>
              {% if article_summary != blank %}<div class="rte"><p>{{ article_summary | escape }}</p></div>{% endif %}
              {% if section.settings.link_label != blank %}<a class="ss-text-link" href="{{ article.url }}">{{ section.settings.link_label | escape }}</a>{% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% elsif request.design_mode %}
      <p class="ss-guides__empty">Solarspeicher 博客暂时没有可显示的文章。</p>
    {% endif %}
    {% if section.settings.all_label != blank %}<div class="ss-link-row"><a class="ss-text-link" href="{{ all_guides_link }}">{{ section.settings.all_label | escape }}</a></div>{% endif %}
  </div>
</section>
{% schema %}
{
  "name": "储能专题 · 精选文章",
  "class": "section-solar-storage-guides",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "眉题", "default": "Ratgeber" },
    { "type": "text", "id": "heading_before", "label": "标题前半部分", "default": "Ratgeber zu" },
    { "type": "text", "id": "heading_highlight", "label": "标题高亮部分", "default": "Solarspeichern" },
    { "type": "richtext", "id": "subtext", "label": "副标题", "default": "<p>Vertiefe einzelne Fragen mit ausführlichen Artikeln zu Nutzung, Nachrüstung und Alltag mit einem Solarspeicher.</p>" },
    { "type": "text", "id": "tag", "label": "文章标签", "default": "RATGEBER" },
    { "type": "text", "id": "link_label", "label": "文章链接文字", "default": "Weiterlesen →" },
    { "type": "text", "id": "all_label", "label": "底部链接文字", "default": "Alle Ratgeber ansehen →" },
    { "type": "url", "id": "all_link", "label": "底部链接地址", "info": "留空时跳转到 Solarspeicher 博客。" },
    { "type": "range", "id": "section_spacing", "label": "区块上下间距", "min": 48, "max": 100, "step": 4, "unit": "px", "default": 72 }
  ],
  "presets": [{ "name": "储能专题 · 精选文章" }]
}
{% endschema %}
