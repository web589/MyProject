<section id="{{ section.settings.anchor_id | handle }}" class="ss-section ss-guides" style="--ss-section-spacing: {{ section.settings.section_spacing }}px;">
  <div class="ss-container">
    {% render 'solar-storage-section-heading', eyebrow: section.settings.eyebrow, heading_before: section.settings.heading_before, heading_highlight: section.settings.heading_highlight, subtext: section.settings.subtext %}
    <div class="ss-card-grid ss-card-grid--three">{% for block in section.blocks %}
      {% liquid
        assign chosen_article = block.settings.article
        assign card_image = block.settings.image
        if card_image == blank and chosen_article != blank
          assign card_image = chosen_article.image
        endif
        assign article_url = block.settings.link
        if chosen_article != blank
          assign article_url = chosen_article.url
        endif
        assign article_title = block.settings.title
        if article_title == blank and chosen_article != blank
          assign article_title = chosen_article.title
        endif
      %}
      <article class="ss-media-card" {{ block.shopify_attributes }}>{% render 'solar-storage-media', image: card_image, alt: block.settings.image_alt, ratio: '16 / 9', loading: 'lazy', sizes: '(min-width: 981px) 33vw, calc(100vw - 44px)' %}<div class="ss-media-card__body"><p class="ss-tag">{{ block.settings.tag | escape }}</p><h3>{{ article_title | escape }}</h3><div class="rte">{{ block.settings.text }}</div>{% if block.settings.link_label != blank and article_url != blank %}<a class="ss-text-link" href="{{ article_url }}">{{ block.settings.link_label | escape }}</a>{% endif %}</div></article>
    {% endfor %}</div>
    {% if section.settings.all_label != blank and section.settings.all_link != blank %}<div class="ss-link-row"><a class="ss-text-link" href="{{ section.settings.all_link }}">{{ section.settings.all_label | escape }}</a></div>{% endif %}
  </div>
</section>
{% schema %}
{
  "name": "储能专题 · 精选文章",
  "class": "section-solar-storage-guides",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "锚点 ID", "default": "ratgeber" },
    { "type": "text", "id": "eyebrow", "label": "眉题", "default": "Ratgeber" },
    { "type": "text", "id": "heading_before", "label": "标题前半部分", "default": "Ratgeber zu" },
    { "type": "text", "id": "heading_highlight", "label": "标题高亮部分", "default": "Solarspeichern" },
    { "type": "richtext", "id": "subtext", "label": "副标题", "default": "<p>Vertiefe einzelne Fragen mit ausführlichen Artikeln zu Nutzung, Nachrüstung und Alltag mit einem Solarspeicher.</p>" },
    { "type": "text", "id": "all_label", "label": "底部链接文字", "default": "Alle Ratgeber ansehen →" },
    { "type": "url", "id": "all_link", "label": "底部链接地址", "default": "/pages/ratgeber" },
    { "type": "range", "id": "section_spacing", "label": "区块上下间距", "min": 48, "max": 100, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    { "type": "article", "name": "精选文章", "settings": [
      { "type": "article", "id": "article", "label": "关联博客文章", "info": "选择后自动使用文章链接，图片未设置时使用文章主图。" },
      { "type": "image_picker", "id": "image", "label": "自定义文章图片" },
      { "type": "text", "id": "image_alt", "label": "图片替代文本", "default": "Bestehende PV-Anlage mit nachgerüstetem Solarspeicher" },
      { "type": "text", "id": "tag", "label": "标签", "default": "RATGEBER" },
      { "type": "text", "id": "title", "label": "显示标题", "info": "留空时使用关联文章标题。", "default": "Solarspeicher nachrüsten: Was bei bestehender PV-Anlage zu prüfen ist" },
      { "type": "richtext", "id": "text", "label": "摘要", "default": "<p>Welche Komponenten häufig weiter genutzt werden können und welche Anpassungen im Einzelfall nötig sind.</p>" },
      { "type": "text", "id": "link_label", "label": "链接文字", "default": "Weiterlesen →" },
      { "type": "url", "id": "link", "label": "备用链接", "info": "上线前请替换成真实博客文章或使用上方文章选择器。", "default": "/pages/ratgeber/solarspeicher-nachruesten" }
    ] }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "储能专题 · 精选文章" }]
}
{% endschema %}
