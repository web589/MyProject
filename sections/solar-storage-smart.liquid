<section id="{{ section.settings.anchor_id | handle }}" class="ss-section ss-smart" style="--ss-section-spacing: {{ section.settings.section_spacing }}px;">
  <div class="ss-container">
    {% render 'solar-storage-section-heading', eyebrow: section.settings.eyebrow, heading_before: section.settings.heading_before, heading_highlight: section.settings.heading_highlight, subtext: section.settings.subtext %}
    <div class="ss-card-grid ss-card-grid--three">{% for block in section.blocks %}<article class="ss-smart-card" {{ block.shopify_attributes }}><h3>{{ block.settings.title | escape }}</h3><div class="rte">{{ block.settings.text }}</div>{% if block.settings.link_label != blank and block.settings.link != blank %}<a class="ss-text-link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>{% endif %}</article>{% endfor %}</div>
  </div>
</section>
{% schema %}
{
  "name": "储能专题 · 智能使用",
  "class": "section-solar-storage-smart",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "锚点 ID", "default": "intelligent" },
    { "type": "text", "id": "eyebrow", "label": "眉题", "default": "Intelligente Nutzung" },
    { "type": "text", "id": "heading_before", "label": "标题前半部分", "default": "Mehr als speichern: Solarspeicher" },
    { "type": "text", "id": "heading_highlight", "label": "标题高亮部分", "default": "intelligent nutzen" },
    { "type": "richtext", "id": "subtext", "label": "副标题", "default": "<p>Ein Speicher kann mehr, als Strom aufzunehmen und wieder abzugeben. Mit passenden Daten lässt sich sein Einsatz besser an deinen Verbrauch anpassen.</p>" },
    { "type": "range", "id": "section_spacing", "label": "区块上下间距", "min": 48, "max": 100, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    { "type": "feature", "name": "智能功能卡", "settings": [
      { "type": "text", "id": "title", "label": "标题", "default": "Verbrauch erkennen" },
      { "type": "richtext", "id": "text", "label": "说明文字", "default": "<p>Messdaten zeigen, wann im Haushalt wie viel Strom gebraucht wird.</p>" },
      { "type": "text", "id": "link_label", "label": "链接文字", "default": "Smart Meter & Energiefluss verstehen →" },
      { "type": "url", "id": "link", "label": "链接地址", "default": "/pages/smart-meter-energiefluss" }
    ] }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "储能专题 · 智能使用" }]
}
{% endschema %}
