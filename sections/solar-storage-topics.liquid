<section id="{{ section.settings.anchor_id | handle }}" class="ss-section ss-topics" style="--ss-section-spacing: {{ section.settings.section_spacing }}px;">
  <div class="ss-container">
    {% render 'solar-storage-section-heading', eyebrow: section.settings.eyebrow, heading_before: section.settings.heading_before, heading_highlight: section.settings.heading_highlight, subtext: section.settings.subtext %}
    <div class="ss-card-grid ss-card-grid--three">{% for block in section.blocks %}{% if block.type == 'topic' %}<article class="ss-media-card" {{ block.shopify_attributes }}>{% render 'solar-storage-media', image: block.settings.image, alt: block.settings.image_alt, ratio: '16 / 9', loading: 'lazy', sizes: '(min-width: 981px) 33vw, calc(100vw - 44px)' %}<div class="ss-media-card__body"><h3>{{ block.settings.title | escape }}</h3><div class="rte">{{ block.settings.text }}</div>{% if block.settings.link_label != blank and block.settings.link != blank %}<a class="ss-text-link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>{% endif %}</div></article>{% endif %}{% endfor %}</div>
    <div class="ss-link-row">{% for block in section.blocks %}{% if block.type == 'link' and block.settings.label != blank and block.settings.url != blank %}<a class="ss-text-link" href="{{ block.settings.url }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>{% endif %}{% endfor %}</div>
  </div>
</section>
{% schema %}
{
  "name": "储能专题 · 延伸主题",
  "class": "section-solar-storage-topics",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "锚点 ID", "default": "themen" },
    { "type": "text", "id": "eyebrow", "label": "眉题", "default": "Weiterführende Themen" },
    { "type": "text", "id": "heading_before", "label": "标题前半部分", "default": "Weiterführende Themen rund um" },
    { "type": "text", "id": "heading_highlight", "label": "标题高亮部分", "default": "Solarspeicher" },
    { "type": "richtext", "id": "subtext", "label": "副标题", "default": "<p>Vertiefe einzelne Themen zu Technik, Nachrüstung und Nutzung.</p>" },
    { "type": "range", "id": "section_spacing", "label": "区块上下间距", "min": 48, "max": 100, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    { "type": "topic", "name": "专题卡", "settings": [
      { "type": "image_picker", "id": "image", "label": "专题图片" },
      { "type": "text", "id": "image_alt", "label": "图片替代文本", "default": "Balkonkraftwerk mit Speicherlösung" },
      { "type": "text", "id": "title", "label": "标题", "default": "Balkonkraftwerk mit Speicher" },
      { "type": "richtext", "id": "text", "label": "说明文字", "default": "<p>Wie sich kleine Anlagen mit einem Speicher kombinieren lassen.</p>" },
      { "type": "text", "id": "link_label", "label": "链接文字", "default": "Mehr zum Thema →" },
      { "type": "url", "id": "link", "label": "链接地址", "default": "/pages/balkonkraftwerk-mit-speicher" }
    ] },
    { "type": "link", "name": "文字链接", "settings": [
      { "type": "text", "id": "label", "label": "链接文字", "default": "Smart Meter & Energiefluss →" },
      { "type": "url", "id": "url", "label": "链接地址", "default": "/pages/smart-meter-energiefluss" }
    ] }
  ],
  "max_blocks": 10,
  "presets": [{ "name": "储能专题 · 延伸主题" }]
}
{% endschema %}
