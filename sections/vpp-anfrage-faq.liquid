{%- assign heading_id = 'vpp-anfrage-faq-' | append: section.id -%}
<div class="vpp-anfrage-page" data-vpp-anfrage-page style="{% render 'vpp-anfrage-style', section: section %}">
  <section id="faq" class="vpp-anfrage__section vpp-anfrage__faq vpp-anchor-target" aria-labelledby="{{ heading_id }}">
    <div class="vpp-anfrage__container">
      {% if section.settings.eyebrow != blank %}<p class="vpp-anfrage__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      <h2 id="{{ heading_id }}">{{ section.settings.heading_before }}{% if section.settings.heading_highlight != blank %} <span>{{ section.settings.heading_highlight }}</span>{% endif %}</h2>
      <div class="vpp-anfrage__faq-list" data-vpp-anfrage-faq-list>
        {% for block in section.blocks %}
          {%- assign question_id = 'vpp-anfrage-question-' | append: section.id | append: '-' | append: block.id -%}
          {%- assign answer_id = 'vpp-anfrage-answer-' | append: section.id | append: '-' | append: block.id -%}
          <article class="vpp-anfrage__faq-item" {{ block.shopify_attributes }}>
            <button id="{{ question_id }}" class="vpp-anfrage__faq-question" type="button" data-vpp-anfrage-faq-question aria-controls="{{ answer_id }}" aria-expanded="false">
              <span>{{ block.settings.question }}</span>
              <span aria-hidden="true">+</span>
            </button>
            <div id="{{ answer_id }}" class="vpp-anfrage__faq-answer" data-vpp-anfrage-faq-answer role="region" aria-labelledby="{{ question_id }}" aria-hidden="true" hidden>
              <div>{{ block.settings.answer }}</div>
            </div>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "04 VPP 咨询常见问题",
  "tag": "section",
  "class": "vpp-anfrage-faq-section",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "眉题", "default": "Häufige Fragen"},
    {"type": "text", "id": "heading_before", "label": "标题前半部分", "default": "Fragen zu deiner"},
    {"type": "text", "id": "heading_highlight", "label": "标题高亮部分", "default": "VPP-Anfrage"},
    {"type": "header", "content": "版式与字体"},
    {"type": "range", "id": "section_padding", "label": "区块上下间距", "min": 40, "max": 140, "step": 4, "unit": "px", "default": 72},
    {"type": "range", "id": "content_width", "label": "内容宽度", "min": 1120, "max": 1440, "step": 20, "unit": "px", "default": 1440},
    {"type": "range", "id": "eyebrow_size", "label": "眉题字号", "min": 10, "max": 18, "step": 1, "unit": "px", "default": 13},
    {"type": "range", "id": "heading_size", "label": "标题字号", "min": 28, "max": 56, "step": 1, "unit": "px", "default": 34},
    {"type": "range", "id": "body_size", "label": "正文字号", "min": 13, "max": 22, "step": 1, "unit": "px", "default": 16},
    {"type": "range", "id": "item_heading_size", "label": "问题字号", "min": 14, "max": 24, "step": 1, "unit": "px", "default": 16},
    {"type": "range", "id": "item_text_size", "label": "答案字号", "min": 12, "max": 20, "step": 1, "unit": "px", "default": 15},
    {"type": "range", "id": "control_size", "label": "控件字号", "min": 11, "max": 18, "step": 1, "unit": "px", "default": 14}
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "问答项目",
      "settings": [
        {"type": "text", "id": "question", "label": "问题", "default": "Ist mein VENUS E automatisch VPP-fähig?"},
        {"type": "richtext", "id": "answer", "label": "答案"}
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "04 VPP 咨询常见问题",
      "blocks": [
        {"type": "faq", "settings": {"question": "Ist mein VENUS E automatisch VPP-fähig?", "answer": "<p>Nicht automatisch. Die tatsächliche Teilnahme hängt vom Modell, Softwarestand, Anbieter und verfügbaren Programmen ab.<br><a href=\"/pages/vpp-ready\">VPP-ready Speicher verstehen →</a></p>"}},
        {"type": "faq", "settings": {"question": "Muss ich bereits einen VPP-Anbieter haben?", "answer": "<p>Nein. Wir helfen dir dabei, die relevanten Voraussetzungen einzuordnen.</p>"}},
        {"type": "faq", "settings": {"question": "Kostet die Anfrage etwas?", "answer": "<p>Nein. Die erste Anfrage zur Einschätzung deiner Möglichkeiten ist kostenlos.</p>"}},
        {"type": "faq", "settings": {"question": "Kann ich meinen Speicher weiterhin normal nutzen?", "answer": "<p>Ja. VPP-ready beschreibt eine zusätzliche Möglichkeit und ersetzt nicht die normale Nutzung deines Speichers.<br><a href=\"/pages/ai-energiemanagement\">Mehr über intelligentes Energiemanagement erfahren →</a></p>"}}
      ]
    }
  ]
}
{% endschema %}
