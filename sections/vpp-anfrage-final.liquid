{%- assign heading_id = 'vpp-anfrage-final-' | append: section.id -%}
<div class="vpp-anfrage-page" data-vpp-anfrage-page style="{% render 'vpp-anfrage-style', section: section %}">
  <section id="abschluss" class="vpp-anfrage__section vpp-anfrage__final vpp-anchor-target" aria-labelledby="{{ heading_id }}">
    <div class="vpp-anfrage__container">
      <div class="vpp-anfrage__final-card">
        {% if section.settings.eyebrow != blank %}<p class="vpp-anfrage__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
        <h2 id="{{ heading_id }}">{{ section.settings.heading_before }}{% if section.settings.heading_highlight != blank %} <span>{{ section.settings.heading_highlight }}</span>{% endif %}</h2>
        {% if section.settings.subtext != blank %}<p class="vpp-anfrage__subtext vpp-anfrage__subtext--final">{{ section.settings.subtext }}</p>{% endif %}
        {% for block in section.blocks %}
          {% if block.type == 'button' %}
            <div class="vpp-anfrage__final-actions" {{ block.shopify_attributes }}>
              <a class="vpp-anfrage__button vpp-anfrage__button--secondary" href="{{ block.settings.url | default: '/pages/kontakt' }}">{{ block.settings.label }}</a>
            </div>
          {% endif %}
        {% endfor %}
        {% for block in section.blocks %}
          {% if block.type == 'text_link' %}
            <p class="vpp-anfrage__final-alternative" {{ block.shopify_attributes }}>{{ block.settings.prefix }} <a href="{{ block.settings.url | default: '/pages/smart-meter-energiefluss' }}">{{ block.settings.label }}</a></p>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "05 VPP 咨询最终行动区",
  "tag": "section",
  "class": "vpp-anfrage-final-section",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "眉题", "default": "Support"},
    {"type": "text", "id": "heading_before", "label": "标题前半部分", "default": "Noch Fragen zu deinem"},
    {"type": "text", "id": "heading_highlight", "label": "标题高亮部分", "default": "VENUS E System?"},
    {"type": "textarea", "id": "subtext", "label": "说明文字", "default": "Unser Team hilft dir bei technischen Fragen rund um Speicher, Smart Meter und VPP-Möglichkeiten."},
    {"type": "header", "content": "版式与字体"},
    {"type": "range", "id": "section_padding", "label": "区块上下间距", "min": 40, "max": 140, "step": 4, "unit": "px", "default": 72},
    {"type": "range", "id": "content_width", "label": "内容宽度", "min": 1120, "max": 1440, "step": 20, "unit": "px", "default": 1440},
    {"type": "range", "id": "eyebrow_size", "label": "眉题字号", "min": 10, "max": 18, "step": 1, "unit": "px", "default": 13},
    {"type": "range", "id": "heading_size", "label": "标题字号", "min": 24, "max": 48, "step": 1, "unit": "px", "default": 28},
    {"type": "range", "id": "body_size", "label": "正文字号", "min": 13, "max": 22, "step": 1, "unit": "px", "default": 16},
    {"type": "range", "id": "item_heading_size", "label": "项目标题字号", "min": 14, "max": 28, "step": 1, "unit": "px", "default": 18},
    {"type": "range", "id": "item_text_size", "label": "项目正文字号", "min": 12, "max": 20, "step": 1, "unit": "px", "default": 14},
    {"type": "range", "id": "control_size", "label": "按钮字号", "min": 11, "max": 18, "step": 1, "unit": "px", "default": 15}
  ],
  "blocks": [
    {
      "type": "button",
      "name": "行动按钮",
      "settings": [
        {"type": "text", "id": "label", "label": "按钮文字", "default": "Kontakt aufnehmen"},
        {"type": "url", "id": "url", "label": "按钮链接"}
      ]
    },
    {
      "type": "text_link",
      "name": "辅助文字链接",
      "settings": [
        {"type": "text", "id": "prefix", "label": "链接前文字", "default": "Oder informiere dich zuerst über"},
        {"type": "text", "id": "label", "label": "链接文字", "default": "Smart Meter & Energiefluss →"},
        {"type": "url", "id": "url", "label": "链接地址"}
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "05 VPP 咨询最终行动区",
      "blocks": [
        {"type": "button", "settings": {"label": "Kontakt aufnehmen", "url": "/pages/kontakt"}},
        {"type": "text_link", "settings": {"prefix": "Oder informiere dich zuerst über", "label": "Smart Meter & Energiefluss →", "url": "/pages/smart-meter-energiefluss"}}
      ]
    }
  ]
}
{% endschema %}
