{%- assign heading_id = 'vpp-anfrage-form-heading-' | append: section.id -%}
{%- assign form_id = 'vpp-anfrage-form-' | append: section.id -%}
<div class="vpp-anfrage-page" data-vpp-anfrage-page style="{% render 'vpp-anfrage-style', section: section %}">
  <section id="anfrage" class="vpp-anfrage__section vpp-anfrage__form-section" aria-labelledby="{{ heading_id }}">
    <div class="vpp-anfrage__container">
      {% if section.settings.eyebrow != blank %}<p class="vpp-anfrage__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      <h2 id="{{ heading_id }}">{{ section.settings.heading_before }}{% if section.settings.heading_highlight != blank %} <span>{{ section.settings.heading_highlight }}</span>{% endif %}</h2>
      {% if section.settings.subtext != blank %}<p class="vpp-anfrage__subtext">{{ section.settings.subtext }}</p>{% endif %}

      <div class="vpp-anfrage__form-grid">
        {%- form 'contact', id: form_id, class: 'vpp-anfrage__form-card' -%}
          <input type="hidden" name="contact[Anfragetyp]" value="VPP-Anfrage">

          {%- if form.posted_successfully? -%}
            <div id="{{ form_id }}-success" class="vpp-anfrage__form-success" role="status" tabindex="-1">
              <h3>{{ section.settings.success_heading }}</h3>
              <p>{{ section.settings.success_text }}</p>
            </div>
          {%- else -%}
            {%- if form.errors -%}
              <div class="vpp-anfrage__form-errors" role="alert">
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}

            <fieldset class="vpp-anfrage__field-group">
              <legend>{{ section.settings.product_group_heading }}</legend>
              <span class="vpp-anfrage__field-question">{{ section.settings.model_question }}</span>
              <div class="vpp-anfrage__option-grid vpp-anfrage__option-grid--two">
                {% for block in section.blocks %}
                  {% if block.type == 'model_option' %}
                    {%- assign input_id = form_id | append: '-model-' | append: block.id -%}
                    <label class="vpp-anfrage__option" for="{{ input_id }}" data-vpp-option {{ block.shopify_attributes }}>
                      <input id="{{ input_id }}" type="radio" name="contact[VPP-Modell]" value="{{ block.settings.label | escape }}" required>
                      <span>{{ block.settings.label }}</span>
                    </label>
                  {% endif %}
                {% endfor %}
              </div>
            </fieldset>

            <fieldset class="vpp-anfrage__field-group">
              <legend>{{ section.settings.location_group_heading }}</legend>
              <label class="vpp-anfrage__field-question" for="{{ form_id }}-country">{{ section.settings.country_question }}</label>
              <div class="vpp-anfrage__field">
                <select id="{{ form_id }}-country" name="contact[Land]" required>
                  <option value="" selected disabled>{{ section.settings.country_placeholder }}</option>
                  {% for block in section.blocks %}
                    {% if block.type == 'country_option' %}
                      <option value="{{ block.settings.label | escape }}">{{ block.settings.label }}</option>
                    {% endif %}
                  {% endfor %}
                </select>
              </div>
              <label class="vpp-anfrage__field-question" for="{{ form_id }}-postcode">{{ section.settings.postcode_label }}</label>
              <div class="vpp-anfrage__field">
                <input id="{{ form_id }}-postcode" type="text" name="contact[Postleitzahl]" inputmode="text" autocomplete="postal-code" placeholder="{{ section.settings.postcode_placeholder | escape }}" required>
              </div>
            </fieldset>

            <fieldset class="vpp-anfrage__field-group" data-vpp-component-group aria-describedby="{{ form_id }}-component-error">
              <legend>{{ section.settings.installation_group_heading }}</legend>
              <span class="vpp-anfrage__field-question">{{ section.settings.component_question }}</span>
              <div class="vpp-anfrage__option-grid vpp-anfrage__option-grid--three">
                {%- assign component_index = 0 -%}
                {% for block in section.blocks %}
                  {% if block.type == 'component_option' %}
                    {%- assign component_index = component_index | plus: 1 -%}
                    {%- assign input_id = form_id | append: '-component-' | append: block.id -%}
                    <label class="vpp-anfrage__option" for="{{ input_id }}" data-vpp-option {{ block.shopify_attributes }}>
                      <input id="{{ input_id }}" type="checkbox" name="contact[Komponente {{ component_index }}]" value="{{ block.settings.label | escape }}" data-vpp-component>
                      <span>{{ block.settings.label }}</span>
                    </label>
                  {% endif %}
                {% endfor %}
              </div>
              <p id="{{ form_id }}-component-error" class="vpp-anfrage__component-error" data-vpp-component-error role="alert" hidden>{{ section.settings.component_error }}</p>
              {% if section.settings.smart_meter_hint != blank %}
                <div class="vpp-anfrage__field-hint">{{ section.settings.smart_meter_hint }}</div>
              {% endif %}
            </fieldset>

            <fieldset class="vpp-anfrage__field-group">
              <legend>{{ section.settings.situation_group_heading }}</legend>
              <div class="vpp-anfrage__field">
                <textarea id="{{ form_id }}-message" name="contact[body]" rows="5" placeholder="{{ section.settings.situation_placeholder | escape }}">{{ form.body }}</textarea>
              </div>
            </fieldset>

            <fieldset class="vpp-anfrage__field-group">
              <legend>{{ section.settings.contact_group_heading }}</legend>
              <div class="vpp-anfrage__field-row">
                <div class="vpp-anfrage__field">
                  <label class="visually-hidden" for="{{ form_id }}-name">{{ section.settings.name_placeholder }}</label>
                  <input id="{{ form_id }}-name" type="text" name="contact[name]" autocomplete="name" placeholder="{{ section.settings.name_placeholder | escape }}" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" required>
                </div>
                <div class="vpp-anfrage__field">
                  <label class="visually-hidden" for="{{ form_id }}-email">{{ section.settings.email_placeholder }}</label>
                  <input id="{{ form_id }}-email" type="email" name="contact[email]" autocomplete="email" placeholder="{{ section.settings.email_placeholder | escape }}" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"{% if form.errors contains 'email' %} aria-invalid="true"{% endif %} required>
                </div>
              </div>
              <div class="vpp-anfrage__field">
                <label class="visually-hidden" for="{{ form_id }}-phone">{{ section.settings.phone_placeholder }}</label>
                <input id="{{ form_id }}-phone" type="tel" name="contact[phone]" autocomplete="tel" placeholder="{{ section.settings.phone_placeholder | escape }}" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}">
              </div>
            </fieldset>

            <label class="vpp-anfrage__consent" for="{{ form_id }}-privacy">
              <input id="{{ form_id }}-privacy" type="checkbox" name="contact[Datenschutz]" value="Zugestimmt" required>
              <span>{{ section.settings.privacy_text | replace: '<p>', '' | replace: '</p>', '' }}</span>
            </label>

            <button class="vpp-anfrage__button vpp-anfrage__button--primary" type="submit">{{ section.settings.submit_label }}</button>
            <p class="vpp-anfrage__form-note">{{ section.settings.form_note }}</p>
            {{ 'shopify.online_store.spam_detection.disclaimer_html' | t }}
          {%- endif -%}
        {%- endform -%}

        <aside class="vpp-anfrage__flow-card" aria-labelledby="{{ form_id }}-flow-heading">
          <h3 id="{{ form_id }}-flow-heading">{{ section.settings.flow_heading }}</h3>
          <p>{{ section.settings.flow_text }}</p>
          <ol class="vpp-anfrage__flow-list">
            {% for block in section.blocks %}
              {% if block.type == 'flow_step' %}
                <li {{ block.shopify_attributes }}>
                  <span class="vpp-anfrage__flow-number" aria-hidden="true">{{ block.settings.number }}</span>
                  <div>
                    <h4>{{ block.settings.title }}</h4>
                    <p>{{ block.settings.text }}</p>
                  </div>
                </li>
              {% endif %}
            {% endfor %}
          </ol>
          <p class="vpp-anfrage__flow-foot">{{ section.settings.flow_note }}</p>
        </aside>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "03 VPP 咨询表单",
  "tag": "section",
  "class": "vpp-anfrage-form-section",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "眉题", "default": "Formular"},
    {"type": "text", "id": "heading_before", "label": "标题前半部分", "default": "Deine Angaben zur"},
    {"type": "text", "id": "heading_highlight", "label": "标题高亮部分", "default": "VPP-Anfrage"},
    {"type": "textarea", "id": "subtext", "label": "副标题", "default": "Die Angaben helfen uns, Modell, Standort und Installation richtig einzuordnen. Du erhältst eine Einordnung – keine automatische Anmeldung."},
    {"type": "header", "content": "表单字段"},
    {"type": "text", "id": "product_group_heading", "label": "产品分组标题", "default": "Produkt"},
    {"type": "text", "id": "model_question", "label": "型号问题", "default": "Welches VENUS E Modell nutzt du?"},
    {"type": "text", "id": "location_group_heading", "label": "地点分组标题", "default": "Standort"},
    {"type": "text", "id": "country_question", "label": "国家问题", "default": "Wo befindet sich deine Installation?"},
    {"type": "text", "id": "country_placeholder", "label": "国家占位文字", "default": "Land wählen"},
    {"type": "text", "id": "postcode_label", "label": "邮政编码标题", "default": "Postleitzahl"},
    {"type": "text", "id": "postcode_placeholder", "label": "邮政编码占位文字", "default": "z. B. 40213"},
    {"type": "text", "id": "installation_group_heading", "label": "安装分组标题", "default": "Deine aktuelle Installation"},
    {"type": "text", "id": "component_question", "label": "组件问题", "default": "Welche Komponenten sind bereits vorhanden?"},
    {"type": "text", "id": "component_error", "label": "组件必填错误提示", "default": "Bitte wähle mindestens eine vorhandene Komponente aus."},
    {"type": "richtext", "id": "smart_meter_hint", "label": "智能电表提示文案", "default": "<p>Du bist nicht sicher, was ein Smart Meter ist? <a href=\"/pages/smart-meter-energiefluss\">Smart Meter & Energiefluss verstehen →</a></p>"},
    {"type": "text", "id": "situation_group_heading", "label": "情况分组标题", "default": "Deine Situation (optional)"},
    {"type": "text", "id": "situation_placeholder", "label": "情况占位文字", "default": "Beschreibe kurz deine aktuelle Situation oder deine Frage."},
    {"type": "text", "id": "contact_group_heading", "label": "联系分组标题", "default": "Kontakt"},
    {"type": "text", "id": "name_placeholder", "label": "姓名占位文字", "default": "Name"},
    {"type": "text", "id": "email_placeholder", "label": "邮箱占位文字", "default": "E-Mail-Adresse"},
    {"type": "text", "id": "phone_placeholder", "label": "电话占位文字", "default": "Telefonnummer (optional)"},
    {"type": "richtext", "id": "privacy_text", "label": "隐私同意文案", "default": "<p>Ich bin damit einverstanden, dass meine Angaben zur Bearbeitung meiner Anfrage verarbeitet werden. Weitere Informationen in der <a href=\"/pages/datenschutz\">Datenschutzerklärung</a>.</p>"},
    {"type": "text", "id": "submit_label", "label": "提交按钮文字", "default": "VPP-Möglichkeiten anfragen"},
    {"type": "text", "id": "form_note", "label": "提交按钮说明", "default": "Eine Anfrage ist noch keine Anmeldung zu einem VPP-Programm."},
    {"type": "text", "id": "success_heading", "label": "成功标题", "default": "Vielen Dank für deine Anfrage."},
    {"type": "textarea", "id": "success_text", "label": "成功说明", "default": "Wir haben deine Angaben erhalten und melden uns mit den nächsten Schritten bei dir."},
    {"type": "header", "content": "流程卡"},
    {"type": "text", "id": "flow_heading", "label": "流程卡标题", "default": "Was passiert nach deiner Anfrage?"},
    {"type": "textarea", "id": "flow_text", "label": "流程卡说明", "default": "Wir ordnen deine Angaben ein und melden uns mit den nächsten Schritten."},
    {"type": "text", "id": "flow_note", "label": "流程卡底部说明", "default": "Eine Anfrage bedeutet keine automatische Teilnahme an einem VPP-Programm."},
    {"type": "header", "content": "版式与字体"},
    {"type": "range", "id": "section_padding", "label": "区块上下间距", "min": 40, "max": 140, "step": 4, "unit": "px", "default": 72},
    {"type": "range", "id": "content_width", "label": "内容宽度", "min": 1120, "max": 1440, "step": 20, "unit": "px", "default": 1440},
    {"type": "range", "id": "eyebrow_size", "label": "眉题字号", "min": 10, "max": 18, "step": 1, "unit": "px", "default": 13},
    {"type": "range", "id": "heading_size", "label": "标题字号", "min": 28, "max": 56, "step": 1, "unit": "px", "default": 34},
    {"type": "range", "id": "body_size", "label": "正文字号", "min": 13, "max": 22, "step": 1, "unit": "px", "default": 16},
    {"type": "range", "id": "item_heading_size", "label": "项目标题字号", "min": 14, "max": 28, "step": 1, "unit": "px", "default": 15},
    {"type": "range", "id": "item_text_size", "label": "项目正文字号", "min": 12, "max": 20, "step": 1, "unit": "px", "default": 14},
    {"type": "range", "id": "control_size", "label": "控件字号", "min": 12, "max": 18, "step": 1, "unit": "px", "default": 15}
  ],
  "blocks": [
    {"type": "model_option", "name": "型号选项", "settings": [{"type": "text", "id": "label", "label": "选项文字", "default": "VENUS E Mini"}]},
    {"type": "country_option", "name": "国家选项", "settings": [{"type": "text", "id": "label", "label": "选项文字", "default": "Deutschland"}]},
    {"type": "component_option", "name": "安装组件选项", "settings": [{"type": "text", "id": "label", "label": "选项文字", "default": "PV-Anlage"}]},
    {"type": "flow_step", "name": "流程步骤", "settings": [{"type": "text", "id": "number", "label": "步骤编号", "default": "01"}, {"type": "text", "id": "title", "label": "标题", "default": "Wir prüfen deine Angaben"}, {"type": "textarea", "id": "text", "label": "说明文字", "default": "Modell, Standort und Installation."}]}
  ],
  "max_blocks": 36,
  "presets": [
    {
      "name": "03 VPP 咨询表单",
      "blocks": [
        {"type": "model_option", "settings": {"label": "Ich bin noch nicht sicher"}},
        {"type": "model_option", "settings": {"label": "VENUS E Mini"}},
        {"type": "model_option", "settings": {"label": "VENUS E 3.0"}},
        {"type": "model_option", "settings": {"label": "VENUS E 4.0"}},
        {"type": "model_option", "settings": {"label": "VENUS E Max"}},
        {"type": "country_option", "settings": {"label": "Deutschland"}},
        {"type": "country_option", "settings": {"label": "Niederlande"}},
        {"type": "country_option", "settings": {"label": "Belgien"}},
        {"type": "component_option", "settings": {"label": "PV-Anlage"}},
        {"type": "component_option", "settings": {"label": "Balkonkraftwerk"}},
        {"type": "component_option", "settings": {"label": "Smart Meter"}},
        {"type": "component_option", "settings": {"label": "Wallbox"}},
        {"type": "component_option", "settings": {"label": "Wärmepumpe"}},
        {"type": "component_option", "settings": {"label": "Noch keine Installation"}},
        {"type": "flow_step", "settings": {"number": "01", "title": "Wir prüfen deine Angaben", "text": "Modell, Standort und Installation."}},
        {"type": "flow_step", "settings": {"number": "02", "title": "Wir klären die Voraussetzungen", "text": "Technische Anforderungen und mögliche Programme."}},
        {"type": "flow_step", "settings": {"number": "03", "title": "Wir melden uns bei dir", "text": "Mit den nächsten Schritten und den Informationen, die noch fehlen."}}
      ]
    }
  ]
}
{% endschema %}
