{%- assign heading_id = 'vpp-anfrage-why-' | append: section.id -%}
<div class="vpp-anfrage-page" data-vpp-anfrage-page style="{% render 'vpp-anfrage-style', section: section %}">
  <section id="warum" class="vpp-anfrage__section vpp-anfrage__why vpp-anchor-target" aria-labelledby="{{ heading_id }}">
    <div class="vpp-anfrage__container">
      {% if section.settings.eyebrow != blank %}<p class="vpp-anfrage__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      <h2 id="{{ heading_id }}">{{ section.settings.heading_before }}{% if section.settings.heading_highlight != blank %} <span>{{ section.settings.heading_highlight }}</span>{% endif %}</h2>
      <div class="vpp-anfrage__why-grid">
        {% for block in section.blocks %}
          <article class="vpp-anfrage__why-item" {{ block.shopify_attributes }}>
            <span class="vpp-anfrage__why-icon" aria-hidden="true">
              {% if block.settings.icon_image != blank %}
                {{ block.settings.icon_image | image_url: width: 96 | image_tag: class: 'vpp-anfrage__why-icon-image', widths: '48, 72, 96', sizes: '21px', alt: '', loading: 'lazy' }}
              {% else %}
                {% case block.settings.icon %}
                  {% when 'pin' %}
                    <svg viewBox="0 0 24 24"><path d="M12 21s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11z"/><circle cx="12" cy="10" r="2.6"/></svg>
                  {% when 'home' %}
                    <svg viewBox="0 0 24 24"><path d="m3.5 10.5 8.5-6.5 8.5 6.5"/><path d="M5.5 9.8V20h13V9.8"/><path d="M10 20v-5h4v5"/><path d="M12 4V2.2"/></svg>
                  {% else %}
                    <svg viewBox="0 0 24 24"><rect x="2.5" y="7.5" width="16" height="9.5" rx="2.2"/><path d="M21 11v2.5"/><path d="M6 10.2h6.5v3.8H6z"/><path d="M15 10.2h1.6v3.8H15z"/></svg>
                {% endcase %}
              {% endif %}
            </span>
            <div>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "02 为什么需要这些信息",
  "tag": "section",
  "class": "vpp-anfrage-why-section",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "眉题", "default": "Warum diese Angaben?"},
    {"type": "text", "id": "heading_before", "label": "标题前半部分", "default": "Warum benötigen wir diese"},
    {"type": "text", "id": "heading_highlight", "label": "标题高亮部分", "default": "Informationen?"},
    {"type": "header", "content": "版式与字体"},
    {"type": "range", "id": "section_padding", "label": "区块上下间距", "min": 40, "max": 140, "step": 4, "unit": "px", "default": 72},
    {"type": "range", "id": "content_width", "label": "内容宽度", "min": 1120, "max": 1440, "step": 20, "unit": "px", "default": 1440},
    {"type": "range", "id": "eyebrow_size", "label": "眉题字号", "min": 10, "max": 18, "step": 1, "unit": "px", "default": 13},
    {"type": "range", "id": "heading_size", "label": "标题字号", "min": 28, "max": 56, "step": 1, "unit": "px", "default": 34},
    {"type": "range", "id": "body_size", "label": "正文字号", "min": 13, "max": 22, "step": 1, "unit": "px", "default": 16},
    {"type": "range", "id": "item_heading_size", "label": "项目标题字号", "min": 14, "max": 28, "step": 1, "unit": "px", "default": 17},
    {"type": "range", "id": "item_text_size", "label": "项目正文字号", "min": 12, "max": 20, "step": 1, "unit": "px", "default": 14},
    {"type": "range", "id": "control_size", "label": "控件字号", "min": 12, "max": 18, "step": 1, "unit": "px", "default": 14}
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "说明项目",
      "settings": [
        {"type": "select", "id": "icon", "label": "图标", "options": [{"value": "battery", "label": "电池"}, {"value": "pin", "label": "地点"}, {"value": "home", "label": "住宅"}], "default": "battery"},
        {"type": "image_picker", "id": "icon_image", "label": "自定义图标（可选）", "info": "上传后会替换上面的默认图标。"},
        {"type": "text", "id": "title", "label": "标题", "default": "Dein VENUS E Modell"},
        {"type": "textarea", "id": "text", "label": "说明文字", "default": "Jedes Modell kann unterschiedliche Voraussetzungen für Programme erfüllen."}
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "02 为什么需要这些信息",
      "blocks": [
        {"type": "reason", "settings": {"icon": "battery", "title": "Dein VENUS E Modell", "text": "Jedes Modell kann unterschiedliche Voraussetzungen für Programme erfüllen."}},
        {"type": "reason", "settings": {"icon": "pin", "title": "Dein Standort", "text": "VPP-Angebote hängen vom Land und verfügbaren Programmen ab."}},
        {"type": "reason", "settings": {"icon": "home", "title": "Deine Installation & Smart Meter", "text": "PV-Anlage, Smart Meter und weitere technische Komponenten helfen bei der Einschätzung."}}
      ]
    }
  ]
}
{% endschema %}
