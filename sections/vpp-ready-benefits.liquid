{%- assign page_id = 'vpp-ready-benefits-' | append: section.id -%}
<div class="vpp-ready-page" data-vpp-ready-page style="{% render 'vpp-ready-style', section: section %}">
  <section id="vorteile" class="vpp-ready__section vpp-ready__benefits vpp-anchor-target" aria-labelledby="{{ page_id }}-heading">
    <div class="vpp-ready__container">
      <p class="vpp-ready__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 id="{{ page_id }}-heading">{{ section.settings.heading_before }}{% if section.settings.heading_highlight != blank %} <span>{{ section.settings.heading_highlight }}</span>{% endif %}</h2>
      <p class="vpp-ready__subtext">{{ section.settings.subtext }}</p>
      <div class="vpp-ready__benefit-grid">
        <div class="vpp-ready__media vpp-ready__media--benefit">
          {% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1400', sizes: '(min-width: 981px) 44vw, 100vw', alt: section.settings.image_alt }}{% else %}<div class="vpp-ready__placeholder">{{ section.settings.image_placeholder }}</div>{% endif %}
        </div>
        <div class="vpp-ready__benefit-list">
          {% for block in section.blocks %}
            <article class="vpp-ready__benefit" {{ block.shopify_attributes }}>
              <p class="vpp-ready__badge-number">{{ block.settings.number }}</p>
              <div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>
            </article>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name":"03 VPP 价值",
  "tag":"section",
  "class":"vpp-ready-benefits-section",
  "settings":[
    {"type":"text","id":"eyebrow","label":"眉题","default":"Zusätzliche Möglichkeiten"},
    {"type":"text","id":"heading_before","label":"标题前半部分","default":"Welchen Nutzen kann ein virtuelles"},
    {"type":"text","id":"heading_highlight","label":"标题高亮部分","default":"Kraftwerk bieten?"},
    {"type":"textarea","id":"subtext","label":"副标题","default":"In einem passenden VPP-Programm kann die Flexibilität deines Speichers zusätzlich genutzt werden. Je nach Einsatz entstehen daraus Möglichkeiten für Vergütung und einen besser abgestimmten Betrieb im Stromsystem."},
    {"type":"image_picker","id":"image","label":"家庭场景图片"},
    {"type":"text","id":"image_alt","label":"家庭场景替代文字","default":"VENUS E Speicher an einem Einfamilienhaus"},
    {"type":"text","id":"image_placeholder","label":"图片占位文字","default":"请选择单户家庭储能与电网场景图"},
    {"type":"header","content":"版式与字体"},
    {"type":"range","id":"section_padding","label":"区块上下间距","min":40,"max":140,"step":4,"unit":"px","default":72},
    {"type":"range","id":"content_width","label":"内容宽度","min":1120,"max":1440,"step":20,"unit":"px","default":1440},
    {"type":"range","id":"eyebrow_size","label":"眉题字号","min":10,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"heading_size","label":"标题字号","min":28,"max":56,"step":1,"unit":"px","default":34},
    {"type":"range","id":"body_size","label":"副标题字号","min":13,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"item_heading_size","label":"价值标题字号","min":14,"max":28,"step":1,"unit":"px","default":18},
    {"type":"range","id":"item_text_size","label":"价值正文字号","min":12,"max":20,"step":1,"unit":"px","default":14},
    {"type":"range","id":"control_size","label":"控件字号","min":11,"max":18,"step":1,"unit":"px","default":14}
  ],
  "blocks":[{"type":"benefit","name":"价值点","settings":[
    {"type":"text","id":"number","label":"编号","default":"01"},
    {"type":"text","id":"title","label":"标题","default":"Mehr Flexibilität nutzen"},
    {"type":"textarea","id":"text","label":"说明文字","default":"Verfügbare Kapazität und verschiebbare Ladezeiten können im Verbund mit anderen Anlagen eingesetzt werden."}
  ]}],
  "max_blocks":4,
  "presets":[{"name":"03 VPP 价值","blocks":[{"type":"benefit","settings":{"number":"01","title":"Mehr Flexibilität nutzen","text":"Verfügbare Kapazität und verschiebbare Ladezeiten können im Verbund mit anderen Anlagen eingesetzt werden."}},{"type":"benefit","settings":{"number":"02","title":"Flexibilität im Stromsystem bereitstellen","text":"Koordinierte Speicher können Lade- und Entladezeiten so abstimmen, dass verfügbare Flexibilität im Stromsystem genutzt werden kann."}},{"type":"benefit","settings":{"number":"03","title":"An passenden Programmen teilnehmen","text":"Einige Programme können die Bereitstellung von Flexibilität vergüten. Die Bedingungen hängen vom jeweiligen Anbieter ab."}}]}]
}
{% endschema %}
