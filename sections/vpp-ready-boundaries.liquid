{%- assign page_id = 'vpp-ready-boundaries-' | append: section.id -%}
<div class="vpp-ready-page" data-vpp-ready-page style="{% render 'vpp-ready-style', section: section %}">
  <section id="bedingungen" class="vpp-ready__section vpp-ready__boundaries" aria-labelledby="{{ page_id }}-heading">
    <div class="vpp-ready__container">
      <p class="vpp-ready__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 id="{{ page_id }}-heading">{{ section.settings.heading_before }}{% if section.settings.heading_highlight != blank %} <span>{{ section.settings.heading_highlight }}</span>{% endif %}</h2>
      <p class="vpp-ready__subtext">{{ section.settings.subtext }}</p>
      {% if section.settings.list_heading != blank %}<p class="vpp-ready__list-heading">{{ section.settings.list_heading }}</p>{% endif %}
      <ul class="vpp-ready__checklist">
        {% for block in section.blocks %}
          <li class="vpp-ready__check" {{ block.shopify_attributes }}>
            <span class="vpp-ready__check-icon">
              {% if block.settings.icon_image != blank %}
                {{ block.settings.icon_image | image_url: width: 96 | image_tag: class: 'vpp-ready__check-icon-image', widths: '48, 72, 96', sizes: '18px', alt: '', loading: 'lazy' }}
              {% else %}
                {% render 'vpp-ready-icon', icon: block.settings.icon %}
              {% endif %}
            </span>
            <div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>
          </li>
        {% endfor %}
      </ul>
      {% if section.settings.summary != blank %}<p class="vpp-ready__summary">{{ section.settings.summary }}</p>{% endif %}
    </div>
  </section>
</div>

{% schema %}
{
  "name":"07 VPP 参与前检查",
  "tag":"section",
  "class":"vpp-ready-boundaries-section",
  "settings":[
    {"type":"text","id":"eyebrow","label":"眉题","default":"Nutzung & Bedingungen"},
    {"type":"text","id":"heading_before","label":"标题前半部分","default":"Was solltest du vor der Teilnahme"},
    {"type":"text","id":"heading_highlight","label":"标题高亮部分","default":"klären?"},
    {"type":"textarea","id":"subtext","label":"副标题","default":"Ein passendes Programm sollte nicht nur eine mögliche Vergütung nennen. Auch Eigenverbrauch, Steuerungsrechte, Garantiebedingungen und laufende Kosten müssen zu deinem Haushalt passen."},
    {"type":"text","id":"list_heading","label":"检查清单标题","default":"Wichtige Fragen vor der Teilnahme"},
    {"type":"textarea","id":"summary","label":"总结文字","default":"Entscheidend ist das konkrete Angebot – nicht allein die Bezeichnung VPP-ready."},
    {"type":"header","content":"版式与字体"},
    {"type":"range","id":"section_padding","label":"区块上下间距","min":40,"max":140,"step":4,"unit":"px","default":72},
    {"type":"range","id":"content_width","label":"内容宽度","min":1120,"max":1440,"step":20,"unit":"px","default":1440},
    {"type":"range","id":"eyebrow_size","label":"眉题字号","min":10,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"heading_size","label":"标题字号","min":28,"max":56,"step":1,"unit":"px","default":34},
    {"type":"range","id":"body_size","label":"副标题字号","min":13,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"item_heading_size","label":"检查标题字号","min":14,"max":28,"step":1,"unit":"px","default":17},
    {"type":"range","id":"item_text_size","label":"检查正文字号","min":12,"max":20,"step":1,"unit":"px","default":14},
    {"type":"range","id":"control_size","label":"控件字号","min":11,"max":18,"step":1,"unit":"px","default":14}
  ],
  "blocks":[{"type":"check","name":"检查项目","settings":[
    {"type":"select","id":"icon","label":"线性图标","options":[{"value":"home","label":"住宅"},{"value":"euro","label":"费用"},{"value":"battery","label":"电池"},{"value":"lock","label":"访问权限"},{"value":"contract","label":"合同"}],"default":"home"},
    {"type":"image_picker","id":"icon_image","label":"自定义图标（可选）","info":"上传后会替换上面的默认图标。"},
    {"type":"text","id":"title","label":"标题","default":"Eigenverbrauch & Speicherreserve"},
    {"type":"textarea","id":"text","label":"说明文字","default":"Wie werden dein eigener Strombedarf und eine mögliche Speicherreserve berücksichtigt?"}
  ]}],
  "max_blocks":6,
  "presets":[{"name":"07 VPP 参与前检查","blocks":[{"type":"check","settings":{"icon":"home","title":"Eigenverbrauch & Speicherreserve","text":"Wie werden dein eigener Strombedarf und eine mögliche Speicherreserve berücksichtigt?"}},{"type":"check","settings":{"icon":"euro","title":"Vergütung & Kosten","text":"Welche Vergütung ist vorgesehen, welche Gebühren fallen an und wie erfolgt die Abrechnung?"}},{"type":"check","settings":{"icon":"battery","title":"Ladezyklen & Garantie","text":"Welche zusätzliche Nutzung ist vorgesehen und welche Garantiebedingungen gelten dafür?"}},{"type":"check","settings":{"icon":"lock","title":"Zugriff & Daten","text":"Wer darf den Speicher steuern und welche Daten werden dafür verarbeitet?"}},{"type":"check","settings":{"icon":"contract","title":"Pause & Vertragsende","text":"Welche Möglichkeiten bestehen, die Teilnahme zu pausieren oder zu beenden?"}}]}]
}
{% endschema %}
