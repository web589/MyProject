{%- assign page_id = 'vpp-ready-definition-' | append: section.id -%}
<div class="vpp-ready-page" data-vpp-ready-page style="{% render 'vpp-ready-style', section: section %}">
  <section id="definition" class="vpp-ready__section vpp-ready__definition" aria-labelledby="{{ page_id }}-heading">
    <div class="vpp-ready__container">
      <p class="vpp-ready__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 id="{{ page_id }}-heading">{{ section.settings.heading_before }}{% if section.settings.heading_highlight != blank %} <span>{{ section.settings.heading_highlight }}</span>{% endif %}</h2>
      <div class="vpp-ready__answer"><p><strong>{{ section.settings.answer_label }}</strong> {{ section.settings.answer }}</p></div>
      {% if section.settings.note != blank %}<p class="vpp-ready__definition-note">{{ section.settings.note }}</p>{% endif %}
      <div class="vpp-ready__media vpp-ready__media--info">
        {% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '640, 960, 1280, 1600, 1800', sizes: '100vw', alt: section.settings.image_alt }}{% else %}<div class="vpp-ready__placeholder">{{ section.settings.image_placeholder }}</div>{% endif %}
      </div>
      <div class="vpp-ready__state-grid">
        {% for block in section.blocks %}
          <article class="vpp-ready__state" {{ block.shopify_attributes }}>
            <p class="vpp-ready__number">{{ block.settings.number }}</p>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name":"02 VPP 定义",
  "tag":"section",
  "class":"vpp-ready-definition-section",
  "settings":[
    {"type":"text","id":"eyebrow","label":"眉题","default":"Einfach erklärt"},
    {"type":"text","id":"heading_before","label":"标题前半部分","default":"Was bedeutet"},
    {"type":"text","id":"heading_highlight","label":"标题高亮部分","default":"VPP-ready?"},
    {"type":"text","id":"answer_label","label":"答案标签","default":"Kurz gesagt:"},
    {"type":"textarea","id":"answer","label":"定义内容","default":"VPP steht für „Virtual Power Plant“, auf Deutsch „virtuelles Kraftwerk“. Dabei werden verteilte Speicher, Erzeugungsanlagen oder flexible Verbraucher digital koordiniert. VPP-ready beschreibt hier die technische Vorbereitung auf eine solche Einbindung – noch keine bereits aktive Teilnahme."},
    {"type":"textarea","id":"note","label":"补充说明","default":"Ein virtuelles Kraftwerk koordiniert verteilte Anlagen über eine gemeinsame Steuerung. Die Häuser werden dafür nicht durch eine eigene Leitung miteinander verbunden."},
    {"type":"image_picker","id":"image","label":"信息图图片"},
    {"type":"text","id":"image_alt","label":"信息图替代文字","default":"Infografik: VENUS E Speicher, technische Vorbereitung, VPP-Programm und aktive Teilnahme"},
    {"type":"text","id":"image_placeholder","label":"图片占位文字","default":"请选择 VPP 状态信息图：最多四个蓝色节点"},
    {"type":"header","content":"版式与字体"},
    {"type":"range","id":"section_padding","label":"区块上下间距","min":40,"max":140,"step":4,"unit":"px","default":72},
    {"type":"range","id":"content_width","label":"内容宽度","min":1120,"max":1440,"step":20,"unit":"px","default":1440},
    {"type":"range","id":"eyebrow_size","label":"眉题字号","min":10,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"heading_size","label":"标题字号","min":28,"max":56,"step":1,"unit":"px","default":34},
    {"type":"range","id":"body_size","label":"正文字号","min":13,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"item_heading_size","label":"状态标题字号","min":14,"max":28,"step":1,"unit":"px","default":18},
    {"type":"range","id":"item_text_size","label":"状态正文字号","min":12,"max":20,"step":1,"unit":"px","default":14},
    {"type":"range","id":"control_size","label":"控件字号","min":11,"max":18,"step":1,"unit":"px","default":14}
  ],
  "blocks":[{"type":"state","name":"状态说明","settings":[
    {"type":"text","id":"number","label":"编号","default":"01 · TECHNISCHE BASIS"},
    {"type":"text","id":"title","label":"标题","default":"Technisch vorbereitet"},
    {"type":"textarea","id":"text","label":"说明文字","default":"Das System verfügt über die technischen Voraussetzungen für eine mögliche VPP-Anbindung."}
  ]}],
  "max_blocks":4,
  "presets":[{"name":"02 VPP 定义","blocks":[{"type":"state","settings":{"number":"01 · TECHNISCHE BASIS","title":"Technisch vorbereitet","text":"Das System verfügt über die technischen Voraussetzungen für eine mögliche VPP-Anbindung."}},{"type":"state","settings":{"number":"02 · PROGRAMM","title":"Passendes Programm erforderlich","text":"Für eine tatsächliche Teilnahme muss für dein Modell und deinen Standort ein geeignetes VPP-Programm verfügbar sein."}},{"type":"state","settings":{"number":"03 · AKTIVE NUTZUNG","title":"Teilnahme aktiviert","text":"Die Einbindung wurde eingerichtet und das entsprechende VPP-Programm ist aktiv."}}]}]
}
{% endschema %}
