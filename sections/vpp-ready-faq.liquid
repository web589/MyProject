{%- assign page_id = 'vpp-ready-faq-' | append: section.id -%}
<div class="vpp-ready-page" data-vpp-ready-page style="{% render 'vpp-ready-style', section: section %}">
  <section id="faq" class="vpp-ready__section vpp-ready__faq" aria-labelledby="{{ page_id }}-heading">
    <div class="vpp-ready__container">
      <p class="vpp-ready__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 id="{{ page_id }}-heading">{{ section.settings.heading_before }}{% if section.settings.heading_highlight != blank %} <span>{{ section.settings.heading_highlight }}</span>{% endif %}</h2>
      {% if section.settings.subtext != blank %}<p class="vpp-ready__subtext">{{ section.settings.subtext }}</p>{% endif %}
      <div class="vpp-ready__faq-list" data-vpp-faq-list>
        {% for block in section.blocks %}
          {%- assign question_id = 'vpp-ready-question-' | append: section.id | append: '-' | append: block.id -%}
          {%- assign answer_id = 'vpp-ready-answer-' | append: section.id | append: '-' | append: block.id -%}
          <article class="vpp-ready__faq-item" {{ block.shopify_attributes }}>
            <button id="{{ question_id }}" class="vpp-ready__faq-question" type="button" data-vpp-faq-question aria-controls="{{ answer_id }}" aria-expanded="false"><span>{{ block.settings.question }}</span><span aria-hidden="true">+</span></button>
            <div id="{{ answer_id }}" class="vpp-ready__faq-answer" data-vpp-faq-answer role="region" aria-labelledby="{{ question_id }}" aria-hidden="true" hidden><div>{{ block.settings.answer }}</div></div>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name":"09 VPP 常见问题",
  "tag":"section",
  "class":"vpp-ready-faq-section",
  "settings":[
    {"type":"text","id":"eyebrow","label":"眉题","default":"Häufige Fragen"},
    {"type":"text","id":"heading_before","label":"标题前半部分","default":"Fragen zu VPP-ready und virtuellen"},
    {"type":"text","id":"heading_highlight","label":"标题高亮部分","default":"Kraftwerken"},
    {"type":"textarea","id":"subtext","label":"副标题"},
    {"type":"header","content":"版式与字体"},
    {"type":"range","id":"section_padding","label":"区块上下间距","min":40,"max":140,"step":4,"unit":"px","default":72},
    {"type":"range","id":"content_width","label":"内容宽度","min":1120,"max":1440,"step":20,"unit":"px","default":1440},
    {"type":"range","id":"eyebrow_size","label":"眉题字号","min":10,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"heading_size","label":"标题字号","min":28,"max":56,"step":1,"unit":"px","default":34},
    {"type":"range","id":"body_size","label":"正文字号","min":13,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"item_heading_size","label":"问题字号","min":14,"max":24,"step":1,"unit":"px","default":16},
    {"type":"range","id":"item_text_size","label":"答案字号","min":12,"max":20,"step":1,"unit":"px","default":15},
    {"type":"range","id":"control_size","label":"控件字号","min":11,"max":18,"step":1,"unit":"px","default":14}
  ],
  "blocks":[{"type":"faq","name":"问答项目","settings":[
    {"type":"text","id":"question","label":"问题","default":"Was bedeutet VPP-ready bei einem Speicher?"},
    {"type":"richtext","id":"answer","label":"答案"}
  ]}],
  "max_blocks":12,
  "presets":[{"name":"09 VPP 常见问题","blocks":[{"type":"faq"},{"type":"faq"},{"type":"faq"}]}]
}
{% endschema %}
