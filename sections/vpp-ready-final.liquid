{%- assign page_id = 'vpp-ready-final-' | append: section.id -%}
<div class="vpp-ready-page" data-vpp-ready-page style="{% render 'vpp-ready-style', section: section %}">
  <section class="vpp-ready__section vpp-ready__final" aria-labelledby="{{ page_id }}-heading">
    <div class="vpp-ready__container">
      <div class="vpp-ready__final-card">
        <p class="vpp-ready__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 id="{{ page_id }}-heading">{{ section.settings.heading_before }}{% if section.settings.heading_highlight != blank %} <span>{{ section.settings.heading_highlight }}</span>{% endif %}</h2>
        <p class="vpp-ready__subtext vpp-ready__subtext--final">{{ section.settings.subtext }}</p>
        <div class="vpp-ready__actions">
          {% for block in section.blocks %}
            <a class="vpp-ready__button vpp-ready__button--{{ block.settings.style }}" href="{{ block.settings.url | default: '/pages/venus-e-vergleich' }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name":"11 VPP 最终行动区",
  "tag":"section",
  "class":"vpp-ready-final-section",
  "settings":[
    {"type":"text","id":"eyebrow","label":"眉题","default":"Dein nächster Schritt"},
    {"type":"text","id":"heading_before","label":"标题前半部分","default":"Speicher passend wählen. VPP-Möglichkeiten klären."},
    {"type":"text","id":"heading_highlight","label":"标题高亮部分","default":""},
    {"type":"textarea","id":"subtext","label":"说明文字","default":"Vergleiche die VENUS E Modelle für deinen Haushalt oder frage nach den Voraussetzungen für eine VPP-Anbindung an deinem Standort."},
    {"type":"header","content":"版式与字体"},
    {"type":"range","id":"section_padding","label":"区块上下间距","min":40,"max":140,"step":4,"unit":"px","default":72},
    {"type":"range","id":"content_width","label":"内容宽度","min":1120,"max":1440,"step":20,"unit":"px","default":1440},
    {"type":"range","id":"eyebrow_size","label":"眉题字号","min":10,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"heading_size","label":"标题字号","min":24,"max":48,"step":1,"unit":"px","default":30},
    {"type":"range","id":"body_size","label":"正文字号","min":13,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"item_heading_size","label":"项目标题字号","min":14,"max":28,"step":1,"unit":"px","default":18},
    {"type":"range","id":"item_text_size","label":"项目正文字号","min":12,"max":20,"step":1,"unit":"px","default":14},
    {"type":"range","id":"control_size","label":"按钮字号","min":11,"max":18,"step":1,"unit":"px","default":15}
  ],
  "blocks":[{"type":"button","name":"行动按钮","settings":[
    {"type":"text","id":"label","label":"按钮文字","default":"Speichermodelle vergleichen"},
    {"type":"url","id":"url","label":"按钮链接"},
    {"type":"select","id":"style","label":"按钮样式","options":[{"value":"primary","label":"主要按钮"},{"value":"secondary","label":"次要按钮"}],"default":"primary"}
  ]}],
  "max_blocks":3,
  "presets":[{"name":"11 VPP 最终行动区","blocks":[{"type":"button","settings":{"label":"Speichermodelle vergleichen","url":"/pages/venus-e-vergleich","style":"primary"}},{"type":"button","settings":{"label":"VPP-Möglichkeiten anfragen","url":"/pages/vpp-anfrage","style":"secondary"}}]}]
}
{% endschema %}
