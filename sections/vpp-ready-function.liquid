{%- assign page_id = 'vpp-ready-function-' | append: section.id -%}
<div class="vpp-ready-page" data-vpp-ready-page style="{% render 'vpp-ready-style', section: section %}">
  <section id="funktionsweise" class="vpp-ready__section vpp-ready__function" aria-labelledby="{{ page_id }}-heading">
    <div class="vpp-ready__container">
      <p class="vpp-ready__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 id="{{ page_id }}-heading">{{ section.settings.heading_before }}{% if section.settings.heading_highlight != blank %} <span>{{ section.settings.heading_highlight }}</span>{% endif %}</h2>
      <p class="vpp-ready__subtext">{{ section.settings.subtext }}</p>
      <div class="vpp-ready__media vpp-ready__media--community">
        {% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '720, 960, 1280, 1600, 2000', sizes: '100vw', alt: section.settings.image_alt }}{% else %}<div class="vpp-ready__placeholder">{{ section.settings.image_placeholder }}</div>{% endif %}
      </div>
      {% if section.settings.caption != blank %}<p class="vpp-ready__caption">{{ section.settings.caption }}</p>{% endif %}
      {% if section.settings.virtual_text != blank %}<p class="vpp-ready__virtual"><strong>{{ section.settings.virtual_label }}</strong> {{ section.settings.virtual_text }}</p>{% endif %}
      <div class="vpp-ready__step-grid">
        {% for block in section.blocks %}
          {% if block.type == 'step' %}
            <article class="vpp-ready__step" {{ block.shopify_attributes }}><p class="vpp-ready__number">{{ block.settings.number }}</p><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></article>
          {% endif %}
        {% endfor %}
      </div>
      <div class="vpp-ready__topic-links">
        {% for block in section.blocks %}
          {% if block.type == 'topic_link' and block.settings.label != blank %}<a class="vpp-ready__text-link" href="{{ block.settings.url | default: '/pages/ai-energiemanagement' }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>{% endif %}
        {% endfor %}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name":"04 VPP 工作原理",
  "tag":"section",
  "class":"vpp-ready-function-section",
  "settings":[
    {"type":"text","id":"eyebrow","label":"眉题","default":"Funktionsweise"},
    {"type":"text","id":"heading_before","label":"标题前半部分","default":"Wie funktioniert ein virtuelles Kraftwerk mit"},
    {"type":"text","id":"heading_highlight","label":"标题高亮部分","default":"Heimspeichern?"},
    {"type":"textarea","id":"subtext","label":"副标题","default":"Ein virtuelles Kraftwerk verbindet verteilte Speicher digital über eine Plattform und koordiniert ihre verfügbare Flexibilität innerhalb festgelegter Betriebsgrenzen. Die Speicher bleiben dabei an ihrem jeweiligen Standort."},
    {"type":"image_picker","id":"image","label":"社区场景图片"},
    {"type":"text","id":"image_alt","label":"社区场景替代文字","default":"Digital vernetzte Heimspeicher in einer Wohnsiedlung"},
    {"type":"text","id":"image_placeholder","label":"图片占位文字","default":"请选择多户社区 VPP 场景图，不使用方框流程图"},
    {"type":"text","id":"caption","label":"图片说明","default":"Prinzipdarstellung eines virtuellen Kraftwerks, kein Installationsplan."},
    {"type":"text","id":"virtual_label","label":"虚拟释义标签","default":"Virtuell bedeutet:"},
    {"type":"textarea","id":"virtual_text","label":"虚拟释义内容","default":"Die Speicher bleiben an ihren Standorten, werden aber digital gemeinsam koordiniert."},
    {"type":"header","content":"版式与字体"},
    {"type":"range","id":"section_padding","label":"区块上下间距","min":40,"max":140,"step":4,"unit":"px","default":72},
    {"type":"range","id":"content_width","label":"内容宽度","min":1120,"max":1440,"step":20,"unit":"px","default":1440},
    {"type":"range","id":"eyebrow_size","label":"眉题字号","min":10,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"heading_size","label":"标题字号","min":28,"max":56,"step":1,"unit":"px","default":34},
    {"type":"range","id":"body_size","label":"副标题字号","min":13,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"item_heading_size","label":"步骤标题字号","min":14,"max":28,"step":1,"unit":"px","default":20},
    {"type":"range","id":"item_text_size","label":"步骤正文字号","min":12,"max":20,"step":1,"unit":"px","default":14},
    {"type":"range","id":"control_size","label":"链接字号","min":11,"max":18,"step":1,"unit":"px","default":14}
  ],
  "blocks":[
    {"type":"step","name":"工作步骤","settings":[{"type":"text","id":"number","label":"步骤编号","default":"SCHRITT 01"},{"type":"text","id":"title","label":"标题","default":"Speicher anbinden"},{"type":"textarea","id":"text","label":"说明文字","default":"Freigegebene Speicher werden mit der Plattform des VPP-Anbieters verbunden."}]},
    {"type":"topic_link","name":"专题链接","settings":[{"type":"text","id":"label","label":"链接文字","default":"Intelligentes Energiemanagement verstehen →"},{"type":"url","id":"url","label":"链接地址"}]}
  ],
  "max_blocks":6,
  "presets":[{"name":"04 VPP 工作原理","blocks":[{"type":"step","settings":{"number":"SCHRITT 01","title":"Speicher anbinden","text":"Freigegebene Speicher werden mit der Plattform des VPP-Anbieters verbunden."}},{"type":"step","settings":{"number":"SCHRITT 02","title":"Flexibilität bündeln","text":"Die Plattform erfasst und bündelt die innerhalb des Programms verfügbare Flexibilität."}},{"type":"step","settings":{"number":"SCHRITT 03","title":"Betrieb koordinieren","text":"Lade- und Entladeleistung werden innerhalb der vereinbarten technischen und vertraglichen Grenzen angepasst."}},{"type":"topic_link","settings":{"label":"Intelligentes Energiemanagement verstehen →","url":"/pages/ai-energiemanagement"}}]}]
}
{% endschema %}
