{%- assign page_id = 'vpp-ready-guides-' | append: section.id -%}
<div class="vpp-ready-page" data-vpp-ready-page style="{% render 'vpp-ready-style', section: section %}">
  <section id="ratgeber" class="vpp-ready__section vpp-ready__guides vpp-anchor-target" aria-labelledby="{{ page_id }}-heading">
    <div class="vpp-ready__container">
      <p class="vpp-ready__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 id="{{ page_id }}-heading">{{ section.settings.heading_before }}{% if section.settings.heading_highlight != blank %} <span>{{ section.settings.heading_highlight }}</span>{% endif %}</h2>
      {% if section.settings.subtext != blank %}<p class="vpp-ready__subtext">{{ section.settings.subtext }}</p>{% endif %}
      <div class="vpp-ready__guide-grid">
        {% render 'latest-guide-articles', section: section, variant: 'vpp-ready' %}
      </div>
      {% if section.settings.cta_label != blank %}<p class="vpp-ready__center-cta"><a class="vpp-ready__button vpp-ready__button--secondary" href="{{ section.settings.cta_url | default: '/blogs/blog-center' }}">{{ section.settings.cta_label }}</a></p>{% endif %}
    </div>
  </section>
</div>

{% schema %}
{
  "name":"10 VPP 延伸阅读",
  "tag":"section",
  "class":"vpp-ready-guides-section",
  "settings":[
    {"type":"blog","id":"blog","label":"文章来源（可选）","info":"留空时汇总博客中心各分类，按发布时间显示最新 3 篇文章。"},
    {"type":"paragraph","content":"标题、摘要、封面和链接自动读取文章；下方卡片仅控制标签和阅读文字。"},
    {"type":"text","id":"eyebrow","label":"眉题","default":"Weiterführende Themen"},
    {"type":"text","id":"heading_before","label":"标题前半部分","default":"Ratgeber &"},
    {"type":"text","id":"heading_highlight","label":"标题高亮部分","default":"Energie-Wissen"},
    {"type":"textarea","id":"subtext","label":"副标题"},
    {"type":"text","id":"cta_label","label":"全部文章按钮文字","default":"Alle Ratgeber ansehen →"},
    {"type":"url","id":"cta_url","label":"全部文章按钮链接"},
    {"type":"header","content":"版式与字体"},
    {"type":"range","id":"section_padding","label":"区块上下间距","min":40,"max":140,"step":4,"unit":"px","default":72},
    {"type":"range","id":"content_width","label":"内容宽度","min":1120,"max":1440,"step":20,"unit":"px","default":1440},
    {"type":"range","id":"eyebrow_size","label":"眉题字号","min":10,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"heading_size","label":"标题字号","min":28,"max":56,"step":1,"unit":"px","default":34},
    {"type":"range","id":"body_size","label":"副标题字号","min":13,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"item_heading_size","label":"文章标题字号","min":14,"max":28,"step":1,"unit":"px","default":17},
    {"type":"range","id":"item_text_size","label":"文章正文字号","min":12,"max":20,"step":1,"unit":"px","default":14},
    {"type":"range","id":"control_size","label":"按钮字号","min":11,"max":18,"step":1,"unit":"px","default":14}
  ],
  "blocks":[{"type":"guide","name":"文章卡片","settings":[
    {"type":"text","id":"tag","label":"文章标签","default":"RATGEBER"},
    {"type":"text","id":"title","label":"文章标题","default":"Dynamischer Stromtarif und Speicher: Wie funktioniert das?"},
    {"type":"textarea","id":"excerpt","label":"文章摘要","default":"Wie zeitlich wechselnde Strompreise die Nutzung eines Speichers beeinflussen können."},
    {"type":"image_picker","id":"image","label":"文章图片"},
    {"type":"text","id":"image_alt","label":"文章图片替代文字","default":"Energie-Wissen Ratgeber"},
    {"type":"url","id":"url","label":"文章链接"},
    {"type":"text","id":"link_label","label":"阅读链接文字","default":"Weiterlesen →"}
  ]}],
  "max_blocks":6,
  "presets":[{"name":"10 VPP 延伸阅读","blocks":[{"type":"guide"},{"type":"guide"},{"type":"guide"}]}]
}
{% endschema %}
