{%- assign page_id = 'vpp-ready-models-' | append: section.id -%}
<div class="vpp-ready-page" data-vpp-ready-page style="{% render 'vpp-ready-style', section: section %}">
  <section id="modelle" class="vpp-ready__section vpp-ready__models" aria-labelledby="{{ page_id }}-heading">
    <div class="vpp-ready__container">
      <p class="vpp-ready__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 id="{{ page_id }}-heading">{{ section.settings.heading_before }}{% if section.settings.heading_highlight != blank %} <span>{{ section.settings.heading_highlight }}</span>{% endif %}</h2>
      <p class="vpp-ready__subtext">{{ section.settings.subtext }}</p>
      {% if section.settings.hint != blank %}<p class="vpp-ready__product-hint"><span aria-hidden="true">i</span>{{ section.settings.hint }}</p>{% endif %}
      <div class="vpp-ready__product-grid">
        {% for block in section.blocks %}
          {%- assign product = block.settings.product -%}
          <article class="vpp-ready__product-card{% if product == blank %} is-placeholder{% elsif product.available == false %} is-unavailable{% endif %}" {{ block.shopify_attributes }}>
            {% if product != blank %}
              <a class="vpp-ready__product-media" href="{{ product.url }}">
                {% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 600, 900', sizes: '(min-width: 1181px) 25vw, (min-width: 721px) 50vw, 100vw', alt: product.featured_image.alt | default: product.title }}{% else %}<div class="vpp-ready__placeholder">该产品暂无主图</div>{% endif %}
              </a>
              <div class="vpp-ready__product-copy">
                {% if block.settings.tag != blank %}<p class="vpp-ready__tag">{{ block.settings.tag }}</p>{% endif %}
                <h3>{{ product.title }}</h3>
                <p>{{ block.settings.text }}</p>
                {% unless product.available %}<p class="vpp-ready__availability">Derzeit nicht verfügbar</p>{% endunless %}
                <a class="vpp-ready__text-link" href="{{ product.url }}">{{ block.settings.link_label | default: 'Details ansehen →' }}</a>
              </div>
            {% else %}
              <div class="vpp-ready__product-media"><div class="vpp-ready__placeholder">请选择 Shopify 产品</div></div>
              <div class="vpp-ready__product-copy"><h3>{{ block.settings.fallback_title }}</h3><p>{{ block.settings.text }}</p></div>
            {% endif %}
          </article>
        {% endfor %}
      </div>
      {% if section.settings.cta_label != blank %}<p class="vpp-ready__center-cta"><a class="vpp-ready__button vpp-ready__button--secondary" href="{{ section.settings.cta_url | default: '/pages/venus-e-vergleich' }}">{{ section.settings.cta_label }}</a></p>{% endif %}
    </div>
  </section>
</div>

{% schema %}
{
  "name":"08 VPP 产品承接",
  "tag":"section",
  "class":"vpp-ready-models-section",
  "settings":[
    {"type":"text","id":"eyebrow","label":"眉题","default":"Speichermodelle"},
    {"type":"text","id":"heading_before","label":"标题前半部分","default":"Welcher VENUS E passt zu deinem"},
    {"type":"text","id":"heading_highlight","label":"标题高亮部分","default":"Zuhause?"},
    {"type":"textarea","id":"subtext","label":"副标题","default":"Wähle deinen Speicher nach Strombedarf, Solarüberschuss, Kapazität und Leistung. Die Teilnahme an einem konkreten VPP-Programm wird zusätzlich geprüft."},
    {"type":"textarea","id":"hint","label":"产品提示文字","default":"VPP-Funktionen hängen vom Modell, Softwarestand und verfügbaren Programmen ab."},
    {"type":"text","id":"cta_label","label":"比较按钮文字","default":"Alle Speichermodelle vergleichen →"},
    {"type":"url","id":"cta_url","label":"比较按钮链接"},
    {"type":"header","content":"版式与字体"},
    {"type":"range","id":"section_padding","label":"区块上下间距","min":40,"max":140,"step":4,"unit":"px","default":72},
    {"type":"range","id":"content_width","label":"内容宽度","min":1120,"max":1440,"step":20,"unit":"px","default":1440},
    {"type":"range","id":"eyebrow_size","label":"眉题字号","min":10,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"heading_size","label":"标题字号","min":28,"max":56,"step":1,"unit":"px","default":34},
    {"type":"range","id":"body_size","label":"副标题字号","min":13,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"item_heading_size","label":"产品标题字号","min":14,"max":28,"step":1,"unit":"px","default":18},
    {"type":"range","id":"item_text_size","label":"产品正文字号","min":12,"max":20,"step":1,"unit":"px","default":14},
    {"type":"range","id":"control_size","label":"按钮字号","min":11,"max":18,"step":1,"unit":"px","default":14}
  ],
  "blocks":[{"type":"product","name":"产品卡片","settings":[
    {"type":"product","id":"product","label":"Shopify 产品"},
    {"type":"text","id":"tag","label":"产品标签","default":"KOMPAKTE LÖSUNG"},
    {"type":"text","id":"fallback_title","label":"产品缺失时标题","default":"VENUS E Mini"},
    {"type":"textarea","id":"text","label":"产品说明","default":"Kompakter Speicher für kleinere Energiemengen und wenig Platz."},
    {"type":"text","id":"link_label","label":"产品链接文字","default":"Details ansehen →"}
  ]}],
  "max_blocks":4,
  "presets":[{"name":"08 VPP 产品承接","blocks":[{"type":"product"},{"type":"product"},{"type":"product"},{"type":"product"}]}]
}
{% endschema %}
