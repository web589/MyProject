{%- liquid
  assign navigation_anchor = section.settings.anchor_id | default: 'navigation' | handle
-%}

<nav
  id="{{ navigation_anchor }}"
  class="vpp-anchor-nav"
  data-vpp-anchor-nav
  data-anchor-nav
  data-bw-anchor-controller="modern"
  data-section-id="{{ section.id }}"
  aria-label="{{ section.settings.aria_label | escape }}"
  style="--vpp-anchor-text-size: {{ section.settings.nav_text_size | default: 13.5 }}px;"
>
  <div class="vpp-anchor-nav__inner">
    <div class="vpp-anchor-nav__links">
      {% for block in section.blocks %}
        {% assign link_module = block.settings.module | default: 'custom' %}
        {% capture link_target %}{% render 'anchor-navigation-target', module: link_module, fallback: block.settings.target %}{% endcapture %}
        {% assign link_target = link_target | strip | remove_first: '#' | handle %}
        {% if block.settings.label != blank and link_target != blank %}
          <a
            class="vpp-anchor-nav__link"
            href="#{{ link_target }}"
            data-vpp-anchor-link
            data-anchor-link
            data-anchor-nav-link
            data-bw-anchor-module="{{ link_module | escape }}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.label | escape }}
          </a>
        {% endif %}
      {% endfor %}
    </div>

    {% assign cta_type = section.settings.cta_type | default: 'anchor' %}
    {% assign cta_href = '' %}
    {% if cta_type == 'link' %}
      {% assign cta_href = section.settings.cta_link %}
    {% else %}
      {% assign cta_module = section.settings.cta_module | default: 'custom' %}
      {% capture cta_target %}{% render 'anchor-navigation-target', module: cta_module, fallback: section.settings.cta_target %}{% endcapture %}
      {% assign cta_target = cta_target | strip | remove_first: '#' | handle %}
      {% if cta_target != blank %}
        {% assign cta_href = cta_target | prepend: '#' %}
      {% endif %}
    {% endif %}
    {% if section.settings.cta_label != blank and cta_href != blank %}
      <a
        class="vpp-anchor-nav__cta"
        href="{{ cta_href | escape }}"
        data-anchor-nav-cta
        {% unless cta_type == 'link' %}
          data-vpp-anchor-link
          data-anchor-link
          data-bw-anchor-module="{{ cta_module | escape }}"
        {% endunless %}
      >
        {{ section.settings.cta_label | escape }}
      </a>
    {% endif %}
  </div>
</nav>

{% schema %}
{
  "name": "VPP-ready · Navigation",
  "tag": "section",
  "class": "section-vpp-anchor-navigation",
  "settings": [
    {
      "type": "text",
      "id": "aria_label",
      "label": "无障碍标签",
      "default": "Navigation zu VPP-ready"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "导航锚点 ID",
      "info": "Ohne # eingeben; die ID muss auf dieser Seite eindeutig sein.",
      "default": "navigation"
    },
    {
      "type": "range",
      "id": "nav_text_size",
      "label": "导航文本大小",
      "min": 11,
      "max": 18,
      "step": 0.5,
      "unit": "px",
      "default": 13.5
    },
    {
      "type": "header",
      "content": "突出显示的行动按钮"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "行动按钮标签",
      "default": "VPP-Möglichkeiten anfragen"
    },
    {
      "type": "select",
      "id": "cta_type",
      "label": "行动按钮跳转方式",
      "options": [
        { "value": "anchor", "label": "定位本页模块" },
        { "value": "link", "label": "跳转其他页面" }
      ],
      "default": "anchor"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "行动按钮页面链接",
      "info": "可选择店铺页面、产品或集合，也可填写完整网址；链接末尾可带 #锚点以定位目标页面的模块。",
      "visible_if": "{{ section.settings.cta_type == 'link' }}"
    },
    {
      "type": "select",
      "id": "cta_module",
      "label": "行动按钮链接到模块",
      "options": [
        { "value": "vpp_ready_start", "label": "VPP-ready · Start" },
        { "value": "vpp_ready_definition", "label": "VPP-ready · Erklärung" },
        { "value": "vpp_ready_benefits", "label": "VPP-ready · Vorteile" },
        { "value": "vpp_ready_function", "label": "VPP-ready · Funktionsweise" },
        { "value": "vpp_ready_comparison", "label": "VPP-ready · Einordnung" },
        { "value": "vpp_ready_participation", "label": "VPP-ready · Teilnahme" },
        { "value": "vpp_ready_boundaries", "label": "VPP-ready · Bedingungen" },
        { "value": "vpp_ready_models", "label": "VPP-ready · Modelle" },
        { "value": "vpp_ready_faq", "label": "VPP-ready · FAQ" },
        { "value": "vpp_ready_guides", "label": "VPP-ready · Ratgeber" },
        { "value": "custom", "label": "自定义锚点（高级）" }
      ],
      "default": "custom",
      "visible_if": "{{ section.settings.cta_type == 'anchor' }}"
    },
    {
      "type": "text",
      "id": "cta_target",
      "label": "自定义锚点 ID（高级）",
      "info": "仅当上方选择“自定义锚点”时填写，可带或不带 #。",
      "visible_if": "{{ section.settings.cta_type == 'anchor' and section.settings.cta_module == 'custom' }}"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "导航链接",
      "settings": [
        {
          "type": "select",
          "id": "module",
          "label": "链接到模块",
          "options": [
            { "value": "vpp_ready_start", "label": "VPP-ready · Start" },
            { "value": "vpp_ready_definition", "label": "VPP-ready · Erklärung" },
            { "value": "vpp_ready_benefits", "label": "VPP-ready · Vorteile" },
            { "value": "vpp_ready_function", "label": "VPP-ready · Funktionsweise" },
            { "value": "vpp_ready_comparison", "label": "VPP-ready · Einordnung" },
            { "value": "vpp_ready_participation", "label": "VPP-ready · Teilnahme" },
            { "value": "vpp_ready_boundaries", "label": "VPP-ready · Bedingungen" },
            { "value": "vpp_ready_models", "label": "VPP-ready · Modelle" },
            { "value": "vpp_ready_faq", "label": "VPP-ready · FAQ" },
            { "value": "vpp_ready_guides", "label": "VPP-ready · Ratgeber" },
            { "value": "custom", "label": "自定义锚点（高级）" }
          ],
          "default": "custom"
        },
        {
          "type": "text",
          "id": "label",
          "label": "标签",
          "default": "Navigation",
          "info": "模块决定链接目标；此处仅用于自定义导航显示文字。"
        },
        {
          "type": "text",
          "id": "target",
          "label": "自定义锚点 ID（高级）",
          "info": "仅当上方选择“自定义锚点”时填写，可带或不带 #。",
          "visible_if": "{{ block.settings.module == 'custom' }}"
        }
      ]
    }
  ],
  "max_blocks": 20
}
{% endschema %}
