{%- comment -%} Shared renderer for the AC storage Theme Editor sections. {%- endcomment -%}
{%- liquid
  assign page_id = 'ac-storage-' | append: section.id
  assign compare_url = section.settings.compare_url | default: '/pages/venus-e-vergleich'
  assign storage_url = section.settings.storage_url | default: '/pages/balkonkraftwerk-mit-speicher'
  assign eauto_url = section.settings.eauto_url | default: '/pages/e-auto'
  assign smart_meter_url = section.settings.smart_meter_url | default: '/products/ct002-smart-meter'
  assign blog_url = section.settings.blog_url | default: '/blogs/balkonkraftwerk-mit-speicher'
  assign article_1_url = section.settings.article_1_url | default: '/blogs/balkonkraftwerk-mit-speicher'
  assign article_2_url = section.settings.article_2_url | default: '/pages/venus-e-vergleich'
  assign article_3_url = section.settings.article_3_url | default: '/blogs/balkonkraftwerk-mit-speicher'
  assign product_mini = section.settings.product_mini
  assign product_3 = section.settings.product_3
  assign product_4 = section.settings.product_4
  assign product_max = section.settings.product_max
  if product_mini == blank
    assign product_mini = all_products['venus-e-mini']
  endif
  if product_3 == blank
    assign product_3 = all_products['venus-e-3']
  endif
  if product_4 == blank
    assign product_4 = all_products['venus-e-4']
  endif
  if product_max == blank
    assign product_max = all_products['venus-e-max']
  endif
  assign ct002_product = section.settings.ct002_product
  assign ct003_product = section.settings.ct003_product
  if ct002_product == blank
    assign ct002_product = all_products['ct002-smart-meter']
  endif
  if ct003_product == blank
    assign ct003_product = all_products['ct003-smart-meter']
  endif
  assign smart_meter_image = ct002_product.featured_image | default: ct003_product.featured_image
-%}

{% case module %}
  {% when 'hero' %}
    {% assign hero_primary_url = section.settings.primary_url | default: '#modelle' %}
    {% assign hero_secondary_url = section.settings.secondary_url | default: '#funktion' %}
    <section id="{{ page_id }}" class="ac-storage-page ac-storage-page__hero" data-ac-storage-page {{ section.shopify_attributes }}>
      <div class="ac-storage-page__wrap ac-storage-page__hero-grid">
        <div class="ac-storage-page__hero-copy">
          <p class="ac-storage-page__eyebrow">{{ section.settings.eyebrow }}</p>
          <h1>{{ section.settings.heading }}</h1>
          <p class="ac-storage-page__lead">{{ section.settings.lead }}</p>
          <div class="ac-storage-page__actions">
            <a class="ac-storage-page__button ac-storage-page__button--primary" href="{{ hero_primary_url }}">{{ section.settings.primary_label }}</a>
            <a class="ac-storage-page__button ac-storage-page__button--secondary" href="{{ hero_secondary_url }}">{{ section.settings.secondary_label }}</a>
          </div>
        </div>
        <div class="ac-storage-page__media ac-storage-page__media--hero">
          {% if section.settings.hero_image != blank %}
            {{ section.settings.hero_image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '640, 960, 1280, 1600', sizes: '(min-width: 1000px) 48vw, 100vw', alt: section.settings.hero_image_alt }}
          {% else %}
            <div class="ac-storage-page__placeholder">{{ section.settings.hero_placeholder }}</div>
          {% endif %}
        </div>
      </div>
    </section>

  {% when 'definition' %}
    <section id="{{ page_id }}" class="ac-storage-page ac-storage-page__section ac-storage-page__answer" data-ac-storage-page {{ section.shopify_attributes }}>
      <div class="ac-storage-page__wrap">
        <p class="ac-storage-page__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
        <div class="ac-storage-page__answer-box">
          <p><strong>{{ section.settings.answer_label }}</strong> {{ section.settings.answer }}</p>
        </div>
        <div class="ac-storage-page__feature-grid">
          {% for feature_index in (1..3) %}
            {% assign feature_title_key = 'feature_' | append: feature_index | append: '_title' %}
            {% assign feature_body_key = 'feature_' | append: feature_index | append: '_body' %}
            {% if section.settings[feature_title_key] != blank or section.settings[feature_body_key] != blank %}
              <article class="ac-storage-page__feature-card">
                <span class="ac-storage-page__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M12 3v18M3 12h18M5.5 5.5l13 13M18.5 5.5l-13 13"/></svg>
                </span>
                <h3>{{ section.settings[feature_title_key] }}</h3>
                <p>{{ section.settings[feature_body_key] }}</p>
              </article>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </section>

  {% when 'function' %}
    {% assign function_link_url = section.settings.link_url | default: eauto_url %}
    {% assign day_nodes = section.settings.day_nodes | split: '|' %}
    {% assign evening_nodes = section.settings.evening_nodes | split: '|' %}
    <section id="funktion" class="ac-storage-page ac-storage-page__section ac-storage-page__function" data-ac-storage-page {{ section.shopify_attributes }}>
      <div class="ac-storage-page__wrap">
        <p class="ac-storage-page__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
        <p class="ac-storage-page__subtext">{{ section.settings.subtext }}</p>
        <div class="ac-storage-page__flow-toggle" role="tablist" aria-label="{{ section.settings.toggle_aria_label }}">
          <button type="button" role="tab" class="is-active" data-ac-flow-toggle="day" aria-selected="true" aria-controls="{{ page_id }}-day">{{ section.settings.toggle_day_label }}</button>
          <button type="button" role="tab" data-ac-flow-toggle="evening" aria-selected="false" aria-controls="{{ page_id }}-evening" tabindex="-1">{{ section.settings.toggle_evening_label }}</button>
        </div>
        <div id="{{ page_id }}-day" class="ac-storage-page__flow-panel" data-ac-flow-panel="day" role="tabpanel" aria-hidden="false">
          <div class="ac-storage-page__media ac-storage-page__media--flow">
            {% if section.settings.day_image != blank %}
              {{ section.settings.day_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '640, 960, 1280, 1600', sizes: '100vw', alt: section.settings.day_image_alt }}
            {% else %}
              <div class="ac-storage-page__placeholder">{{ section.settings.day_placeholder }}</div>
            {% endif %}
          </div>
          <div class="ac-storage-page__flow-nodes">
            {% for node in day_nodes %}
              {% assign clean_node = node | strip %}
              {% if clean_node != blank %}<span><i aria-hidden="true"></i>{{ clean_node }}</span>{% endif %}
            {% endfor %}
          </div>
        </div>
        <div id="{{ page_id }}-evening" class="ac-storage-page__flow-panel" data-ac-flow-panel="evening" role="tabpanel" aria-hidden="true" hidden>
          <div class="ac-storage-page__media ac-storage-page__media--flow">
            {% if section.settings.evening_image != blank %}
              {{ section.settings.evening_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '640, 960, 1280, 1600', sizes: '100vw', alt: section.settings.evening_image_alt }}
            {% else %}
              <div class="ac-storage-page__placeholder">{{ section.settings.evening_placeholder }}</div>
            {% endif %}
          </div>
          <div class="ac-storage-page__flow-nodes">
            {% for node in evening_nodes %}
              {% assign clean_node = node | strip %}
              {% if clean_node != blank %}<span><i aria-hidden="true"></i>{{ clean_node }}</span>{% endif %}
            {% endfor %}
          </div>
        </div>
        <div class="ac-storage-page__steps">
          {% for step_index in (1..3) %}
            {% assign step_title_key = 'step_' | append: step_index | append: '_title' %}
            {% assign step_body_key = 'step_' | append: step_index | append: '_body' %}
            <article class="ac-storage-page__step">
              <span class="ac-storage-page__step-number">0{{ step_index }}</span>
              <h3>{{ section.settings[step_title_key] }}</h3>
              <p>{{ section.settings[step_body_key] }}</p>
            </article>
          {% endfor %}
        </div>
        <a class="ac-storage-page__link" href="{{ function_link_url }}">{{ section.settings.link_label }}</a>
      </div>
    </section>

  {% when 'why' %}
    {% assign why_cta_url = section.settings.cta_url | default: '#modelle' %}
    <section id="{{ page_id }}" class="ac-storage-page ac-storage-page__section ac-storage-page__why" data-ac-storage-page {{ section.shopify_attributes }}>
      <div class="ac-storage-page__wrap">
        <p class="ac-storage-page__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
        <p class="ac-storage-page__subtext">{{ section.settings.subtext }}</p>
        <div class="ac-storage-page__why-grid">
          {% for card_index in (1..2) %}
            {% assign card_title_key = 'card_' | append: card_index | append: '_title' %}
            {% assign card_body_key = 'card_' | append: card_index | append: '_body' %}
            {% assign card_image_key = 'card_' | append: card_index | append: '_image' %}
            {% assign card_alt_key = 'card_' | append: card_index | append: '_alt' %}
            {% assign card_placeholder_key = 'card_' | append: card_index | append: '_placeholder' %}
            <article class="ac-storage-page__why-card">
              <div class="ac-storage-page__media ac-storage-page__media--why">
                {% if section.settings[card_image_key] != blank %}
                  {{ section.settings[card_image_key] | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1000', sizes: '(min-width: 1000px) 50vw, 100vw', alt: section.settings[card_alt_key] }}
                {% else %}
                  <div class="ac-storage-page__placeholder">{{ section.settings[card_placeholder_key] }}</div>
                {% endif %}
              </div>
              <div class="ac-storage-page__card-body">
                <h3>{{ section.settings[card_title_key] }}</h3>
                <p>{{ section.settings[card_body_key] }}</p>
              </div>
            </article>
          {% endfor %}
          {% for stat_index in (1..2) %}
            {% assign stat_title_key = 'stat_' | append: stat_index | append: '_title' %}
            {% assign stat_body_key = 'stat_' | append: stat_index | append: '_body' %}
            {% assign stat_tag_key = 'stat_' | append: stat_index | append: '_tag' %}
            <article class="ac-storage-page__why-stat">
              <span class="ac-storage-page__step-number">0{{ stat_index }}</span>
              <h3>{{ section.settings[stat_title_key] }}</h3>
              <p>{{ section.settings[stat_body_key] }}</p>
              <span class="ac-storage-page__tag">{{ section.settings[stat_tag_key] }}</span>
            </article>
          {% endfor %}
        </div>
        <div class="ac-storage-page__center-cta">
          <a class="ac-storage-page__link" href="{{ why_cta_url }}">{{ section.settings.cta_label }}</a>
        </div>
      </div>
    </section>

  {% when 'comparison' %}
    {% assign comparison_link_url = section.settings.link_url | default: compare_url %}
    <section id="{{ page_id }}" class="ac-storage-page ac-storage-page__section ac-storage-page__comparison" data-ac-storage-page {{ section.shopify_attributes }}>
      <div class="ac-storage-page__wrap">
        <p class="ac-storage-page__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
        <p class="ac-storage-page__subtext">{{ section.settings.subtext }}</p>
        <div class="ac-storage-page__table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col">{{ section.settings.table_feature_heading }}</th>
                <th scope="col" class="is-highlight">{{ section.settings.table_ac_heading }}</th>
                <th scope="col">{{ section.settings.table_dc_heading }}</th>
              </tr>
            </thead>
            <tbody>
              {% for row_index in (1..5) %}
                {% assign row_label_key = 'row_' | append: row_index | append: '_label' %}
                {% assign row_ac_key = 'row_' | append: row_index | append: '_ac' %}
                {% assign row_dc_key = 'row_' | append: row_index | append: '_dc' %}
                <tr>
                  <th scope="row">{{ section.settings[row_label_key] }}</th>
                  <td>{{ section.settings[row_ac_key] }}</td>
                  <td>{{ section.settings[row_dc_key] }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        <p class="ac-storage-page__comparison-note">{{ section.settings.note }}</p>
        <a class="ac-storage-page__link" href="{{ comparison_link_url }}">{{ section.settings.link_label }}</a>
      </div>
    </section>

  {% when 'smart' %}
    {% assign smart_link_url = section.settings.link_url | default: smart_meter_url %}
    <section id="{{ page_id }}" class="ac-storage-page ac-storage-page__section ac-storage-page__smart" data-ac-storage-page {{ section.shopify_attributes }}>
      <div class="ac-storage-page__wrap">
        <p class="ac-storage-page__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
        <p class="ac-storage-page__subtext">{{ section.settings.subtext }}</p>
        <div class="ac-storage-page__smart-grid">
          <div>
            <div class="ac-storage-page__smart-steps">
              {% for step_index in (1..3) %}
                {% assign smart_title_key = 'step_' | append: step_index | append: '_title' %}
                {% assign smart_body_key = 'step_' | append: step_index | append: '_body' %}
                <article class="ac-storage-page__smart-step">
                  <span class="ac-storage-page__smart-number">0{{ step_index }}</span>
                  <div>
                    <h3>{{ section.settings[smart_title_key] }}</h3>
                    <p>{{ section.settings[smart_body_key] }}</p>
                  </div>
                </article>
              {% endfor %}
            </div>
            <a class="ac-storage-page__link" href="{{ smart_link_url }}">{{ section.settings.link_label }}</a>
          </div>
          <div class="ac-storage-page__smart-visuals">
            <div class="ac-storage-page__media ac-storage-page__media--smart-main">
              {% if section.settings.main_image != blank %}
                {{ section.settings.main_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '640, 960, 1200, 1400', sizes: '(min-width: 1000px) 42vw, 100vw', alt: section.settings.main_image_alt }}
              {% else %}
                <div class="ac-storage-page__placeholder">{{ section.settings.main_placeholder }}</div>
              {% endif %}
            </div>
            <div class="ac-storage-page__smart-small-grid">
              <div class="ac-storage-page__media ac-storage-page__media--smart-small">
                {% if section.settings.app_image != blank %}
                  {{ section.settings.app_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '360, 560, 800', sizes: '(min-width: 1000px) 21vw, 100vw', alt: section.settings.app_image_alt }}
                {% else %}
                  <div class="ac-storage-page__placeholder">{{ section.settings.app_placeholder }}</div>
                {% endif %}
              </div>
              <div class="ac-storage-page__media ac-storage-page__media--smart-small">
                {% if section.settings.meter_image != blank %}
                  {{ section.settings.meter_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '360, 560, 800', sizes: '(min-width: 1000px) 21vw, 100vw', alt: section.settings.meter_image_alt }}
                {% elsif smart_meter_image != blank %}
                  {{ smart_meter_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '360, 560, 800', sizes: '(min-width: 1000px) 21vw, 100vw', alt: section.settings.meter_image_alt }}
                {% else %}
                  <div class="ac-storage-page__placeholder">{{ section.settings.meter_placeholder }}</div>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

  {% when 'audience' %}
    {% assign audience_link_url = section.settings.link_url | default: eauto_url %}
    <section id="{{ page_id }}" class="ac-storage-page ac-storage-page__section ac-storage-page__audience" data-ac-storage-page {{ section.shopify_attributes }}>
      <div class="ac-storage-page__wrap">
        <p class="ac-storage-page__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
        <div class="ac-storage-page__audience-grid">
          {% for card_index in (1..4) %}
            {% assign audience_title_key = 'card_' | append: card_index | append: '_title' %}
            {% assign audience_body_key = 'card_' | append: card_index | append: '_body' %}
            {% assign audience_image_key = 'card_' | append: card_index | append: '_image' %}
            {% assign audience_alt_key = 'card_' | append: card_index | append: '_alt' %}
            {% assign audience_placeholder_key = 'card_' | append: card_index | append: '_placeholder' %}
            <article class="ac-storage-page__audience-card">
              <div class="ac-storage-page__media ac-storage-page__media--audience">
                {% if section.settings[audience_image_key] != blank %}
                  {{ section.settings[audience_image_key] | image_url: width: 800 | image_tag: loading: 'lazy', widths: '360, 560, 800', sizes: '(min-width: 1000px) 25vw, 100vw', alt: section.settings[audience_alt_key] }}
                {% else %}
                  <div class="ac-storage-page__placeholder">{{ section.settings[audience_placeholder_key] }}</div>
                {% endif %}
              </div>
              <div class="ac-storage-page__card-body">
                <h3>{{ section.settings[audience_title_key] }}</h3>
                <p>{{ section.settings[audience_body_key] }}</p>
              </div>
            </article>
          {% endfor %}
        </div>
        <a class="ac-storage-page__link" href="{{ audience_link_url }}">{{ section.settings.link_label }}</a>
      </div>
    </section>

  {% when 'models' %}
    <section id="modelle" class="ac-storage-page ac-storage-page__section ac-storage-page__models" data-ac-storage-page {{ section.shopify_attributes }}>
      <div class="ac-storage-page__wrap">
        <p class="ac-storage-page__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
        <p class="ac-storage-page__subtext">{{ section.settings.subtext }}</p>
        <div class="ac-storage-page__models-grid">
          {% for model_index in (1..4) %}
            {% case model_index %}
              {% when 1 %}{% assign model_product = product_mini %}
              {% when 2 %}{% assign model_product = product_3 %}
              {% when 3 %}{% assign model_product = product_4 %}
              {% when 4 %}{% assign model_product = product_max %}
            {% endcase %}
            {% assign model_name_key = 'model_' | append: model_index | append: '_name' %}
            {% assign model_copy_key = 'model_' | append: model_index | append: '_copy' %}
            {% assign model_alt_key = 'model_' | append: model_index | append: '_alt' %}
            {% assign model_name = section.settings[model_name_key] | default: model_product.title %}
            {% assign model_url = model_product.url | default: storage_url %}
            <article class="ac-storage-page__model-card">
              <a class="ac-storage-page__media ac-storage-page__media--model" href="{{ model_url }}">
                {% if model_product.featured_image != blank %}
                  {{ model_product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '360, 560, 800', sizes: '(min-width: 1000px) 25vw, 100vw', alt: section.settings[model_alt_key] | default: model_name }}
                {% else %}
                  <span class="ac-storage-page__placeholder">{{ model_name }}</span>
                {% endif %}
              </a>
              <div class="ac-storage-page__card-body">
                <h3>{{ model_name }}</h3>
                <p>{{ section.settings[model_copy_key] }}</p>
                <a class="ac-storage-page__link" href="{{ model_url }}">{{ section.settings.card_link_label }}</a>
              </div>
            </article>
          {% endfor %}
        </div>
        <div class="ac-storage-page__models-actions">
          <a class="ac-storage-page__button ac-storage-page__button--primary" href="{{ section.settings.compare_url | default: compare_url }}">{{ section.settings.compare_label }}</a>
          <a class="ac-storage-page__button ac-storage-page__button--secondary" href="{{ section.settings.storage_url | default: storage_url }}">{{ section.settings.storage_label }}</a>
        </div>
      </div>
    </section>

  {% when 'faq' %}
    <section id="{{ page_id }}" class="ac-storage-page ac-storage-page__section ac-storage-page__faq" data-ac-storage-page {{ section.shopify_attributes }}>
      <div class="ac-storage-page__wrap">
        <p class="ac-storage-page__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
        <div class="ac-storage-page__faq-list">
          {% for faq_index in (1..7) %}
            {% assign faq_question_key = 'question_' | append: faq_index %}
            {% assign faq_answer_key = 'answer_' | append: faq_index %}
            {% assign faq_question = section.settings[faq_question_key] %}
            {% assign faq_answer = section.settings[faq_answer_key] %}
            {% if faq_question != blank %}
              <article class="ac-storage-page__faq-item" data-ac-faq-item>
                <button class="ac-storage-page__faq-question" type="button" data-ac-faq-question aria-expanded="false" aria-controls="{{ page_id }}-faq-{{ faq_index }}">{{ faq_question }}<span aria-hidden="true">+</span></button>
                <div id="{{ page_id }}-faq-{{ faq_index }}" class="ac-storage-page__faq-answer" data-ac-faq-answer hidden><p>{{ faq_answer }}</p></div>
              </article>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </section>
    {%- assign faq_schema_count = 0 -%}
    <script type="application/ld+json">
    {
      "@context":"https://schema.org",
      "@type":"FAQPage",
      "mainEntity":[
        {% for faq_index in (1..7) %}
          {% assign faq_question_key = 'question_' | append: faq_index %}
          {% assign faq_answer_key = 'answer_' | append: faq_index %}
          {% assign faq_question = section.settings[faq_question_key] %}
          {% assign faq_answer = section.settings[faq_answer_key] %}
          {% if faq_question != blank %}
            {% if faq_schema_count > 0 %},{% endif %}
            {"@type":"Question","name":{{ faq_question | json }},"acceptedAnswer":{"@type":"Answer","text":{{ faq_answer | strip_html | json }}}}
            {% assign faq_schema_count = faq_schema_count | plus: 1 %}
          {% endif %}
        {% endfor %}
      ]
    }
    </script>

  {% when 'blog' %}
    <section id="{{ page_id }}" class="ac-storage-page ac-storage-page__section ac-storage-page__blog" data-ac-storage-page {{ section.shopify_attributes }}>
      <div class="ac-storage-page__wrap">
        <p class="ac-storage-page__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
        <div class="ac-storage-page__blog-grid">
          {% for article_index in (1..3) %}
            {% assign article_tag_key = 'article_' | append: article_index | append: '_tag' %}
            {% assign article_title_key = 'article_' | append: article_index | append: '_title' %}
            {% assign article_copy_key = 'article_' | append: article_index | append: '_copy' %}
            {% assign article_image_key = 'article_' | append: article_index | append: '_image' %}
            {% assign article_alt_key = 'article_' | append: article_index | append: '_alt' %}
            {% assign article_placeholder_key = 'article_' | append: article_index | append: '_placeholder' %}
            {% case article_index %}
              {% when 1 %}{% assign article_url = article_1_url %}
              {% when 2 %}{% assign article_url = article_2_url %}
              {% when 3 %}{% assign article_url = article_3_url %}
            {% endcase %}
            <article class="ac-storage-page__blog-card">
              <a class="ac-storage-page__media ac-storage-page__media--blog" href="{{ article_url }}">
                {% if section.settings[article_image_key] != blank %}
                  {{ section.settings[article_image_key] | image_url: width: 900 | image_tag: loading: 'lazy', widths: '420, 640, 900', sizes: '(min-width: 1000px) 33vw, 100vw', alt: section.settings[article_alt_key] }}
                {% else %}
                  <span class="ac-storage-page__placeholder">{{ section.settings[article_placeholder_key] }}</span>
                {% endif %}
              </a>
              <div class="ac-storage-page__card-body">
                <span class="ac-storage-page__tag">{{ section.settings[article_tag_key] }}</span>
                <h3>{{ section.settings[article_title_key] }}</h3>
                <p>{{ section.settings[article_copy_key] }}</p>
                <a class="ac-storage-page__link" href="{{ article_url }}">{{ section.settings.card_link_label }}</a>
              </div>
            </article>
          {% endfor %}
        </div>
        <a class="ac-storage-page__link" href="{{ section.settings.blog_url | default: blog_url }}">{{ section.settings.blog_link_label }}</a>
      </div>
    </section>

  {% when 'final' %}
    <section id="{{ page_id }}" class="ac-storage-page ac-storage-page__section ac-storage-page__final" data-ac-storage-page {{ section.shopify_attributes }}>
      <div class="ac-storage-page__wrap">
        <div class="ac-storage-page__final-card">
          <h2>{{ section.settings.heading }}</h2>
          <p>{{ section.settings.copy }}</p>
          <div class="ac-storage-page__actions">
            <a class="ac-storage-page__button ac-storage-page__button--primary" href="{{ section.settings.primary_url | default: compare_url }}">{{ section.settings.primary_label }}</a>
            <a class="ac-storage-page__button ac-storage-page__button--secondary" href="{{ section.settings.secondary_url | default: storage_url }}">{{ section.settings.secondary_label }}</a>
            <a class="ac-storage-page__link" href="{{ section.settings.link_url | default: eauto_url }}">{{ section.settings.link_label }}</a>
          </div>
        </div>
      </div>
    </section>
{% endcase %}
