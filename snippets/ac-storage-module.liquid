{%- comment -%} Shared renderer for the AC storage Theme Editor sections. {%- endcomment -%}
{%- liquid
  assign page_id = 'ac-storage-' | append: section.id
  assign compare_url = section.settings.compare_url | default: '/pages/venus-e-vergleich'
  assign storage_url = section.settings.storage_url | default: '/pages/balkonkraftwerk-mit-speicher'
  assign eauto_url = section.settings.eauto_url | default: '/pages/e-auto'
  assign smart_meter_url = section.settings.smart_meter_url | default: '/products/ct002-smart-meter'
  assign blog_url = section.settings.blog_url | default: '/blogs/balkonkraftwerk-mit-speicher'
  assign ct002_product = section.settings.ct002_product
  assign ct003_product = section.settings.ct003_product
  if ct002_product == blank
    assign ct002_product = all_products['ct002-smart-meter']
  endif
  if ct003_product == blank
    assign ct003_product = all_products['ct003-smart-meter']
  endif
  assign smart_meter_image = ct002_product.featured_image | default: ct003_product.featured_image
  assign ac_section_padding = section.settings.section_padding | default: 72
  assign ac_heading_size = section.settings.heading_size | default: 34
  assign ac_body_size = section.settings.body_size | default: 15
  assign ac_eyebrow_size = section.settings.eyebrow_size | default: 13
  assign ac_content_width = section.settings.content_width | default: 1440
  capture ac_storage_style
    echo '--ac-section-padding: ' | append: ac_section_padding | append: 'px; '
    echo '--ac-heading-size: ' | append: ac_heading_size | append: 'px; '
    echo '--ac-body-size: ' | append: ac_body_size | append: 'px; '
    echo '--ac-eyebrow-size: ' | append: ac_eyebrow_size | append: 'px; '
    echo '--ac-content-width: ' | append: ac_content_width | append: 'px;'
  endcapture
-%}

{% case module %}
  {% when 'hero' %}
    <section id="ac-speicher" class="ac-storage-page ac-storage-page__hero" data-ac-storage-page style="{{ ac_storage_style }} --ac-hero-heading-size: {{ section.settings.hero_heading_size | default: 48 }}px; --ac-hero-lead-size: {{ section.settings.hero_lead_size | default: 16 }}px; --ac-hero-media-height: {{ section.settings.hero_media_height | default: 480 }}px; --ac-hero-image-width: {{ section.settings.hero_image_width | default: 100 }}%; --ac-hero-copy-width: {{ section.settings.hero_copy_width | default: 640 }}px; --ac-image-fit: {{ section.settings.hero_image_fit | default: 'cover' }};" {{ section.shopify_attributes }}>
      <div class="ac-storage-page__wrap ac-storage-page__hero-grid">
        <div class="ac-storage-page__hero-copy">
          <p class="ac-storage-page__eyebrow">{{ section.settings.eyebrow }}</p>
          <h1>{{ section.settings.heading }}{% if section.settings.heading_accent != blank %} <span class="ac-storage-page__heading-accent">{{ section.settings.heading_accent }}</span>{% endif %}</h1>
          <p class="ac-storage-page__lead">{{ section.settings.lead }}</p>
          <div class="ac-storage-page__actions">
            {% for block in section.blocks %}
              {% if block.type == 'button' and block.settings.label != blank %}
                {% assign hero_button_style = block.settings.style | default: 'secondary' %}
                {% assign hero_button_url = block.settings.url %}
                {% if hero_button_url == blank %}
                  {% if hero_button_style == 'primary' %}
                    {% assign hero_button_url = '#modelle' %}
                  {% else %}
                    {% assign hero_button_url = '#funktion' %}
                  {% endif %}
                {% endif %}
                <a class="ac-storage-page__button ac-storage-page__button--{{ hero_button_style }}" href="{{ hero_button_url }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
              {% endif %}
            {% endfor %}
          </div>
        </div>
        <div class="ac-storage-page__media ac-storage-page__media--hero">
          {% if section.settings.hero_image != blank %}
            {{ section.settings.hero_image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '640, 960, 1280, 1600', sizes: '(min-width: 1000px) 48vw, 100vw', alt: section.settings.hero_image_alt }}
          {% else %}
            <div class="ac-storage-page__placeholder">{{ section.settings.hero_placeholder }}</div>
          {% endif %}
        </div>
      </div>
    </section>

  {% when 'definition' %}
    <section id="definition" class="ac-storage-page ac-storage-page__section ac-storage-page__answer" data-ac-storage-page {{ section.shopify_attributes }}>
      <div class="ac-storage-page__wrap">
        <p class="ac-storage-page__eyebrow">{{ section.settings.eyebrow }}</p>
        {% assign definition_heading_accent = section.settings.heading_accent | default: 'AC-gekoppelter Speicher?' %}
        {% if definition_heading_accent != blank and section.settings.heading contains definition_heading_accent %}
          {% assign definition_heading_parts = section.settings.heading | split: definition_heading_accent %}
          <h2>{{ definition_heading_parts[0] }}<span class="ac-storage-page__heading-accent">{{ definition_heading_accent }}</span>{{ definition_heading_parts[1] }}</h2>
        {% else %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}
        <div class="ac-storage-page__answer-box">
          <p><strong>{{ section.settings.answer_label }}</strong> {{ section.settings.answer }}</p>
        </div>
        <div class="ac-storage-page__feature-grid">
          {% for block in section.blocks %}
            {% if block.type == 'feature' %}
              {% if block.settings.title != blank or block.settings.body != blank %}
                <article class="ac-storage-page__feature-card" style="--ac-card-title-size: {{ block.settings.title_size | default: 18 }}px; --ac-card-body-size: {{ block.settings.body_size | default: 13 }}px; --ac-card-height: {{ block.settings.card_height | default: 202 }}px; --ac-icon-size: {{ block.settings.icon_size | default: 24 }}px;" {{ block.shopify_attributes }}>
                  <span class="ac-storage-page__icon" aria-hidden="true">
                    {% if block.settings.icon_image != blank %}
                      {{ block.settings.icon_image | image_url: width: 96 | image_tag: class: 'ac-storage-page__icon-image', widths: '48, 72, 96', sizes: 'var(--ac-icon-size, 24px)', alt: '', loading: 'lazy' }}
                    {% else %}
                      <svg viewBox="0 0 24 24"><path d="M12 3v18M3 12h18M5.5 5.5l13 13M18.5 5.5l-13 13"/></svg>
                    {% endif %}
                  </span>
                  <h3>{{ block.settings.title }}</h3>
                  <p>{{ block.settings.body }}</p>
                </article>
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </section>

  {% when 'function' %}
    {% assign function_link_url = section.settings.link_url | default: eauto_url %}
    {% assign day_nodes = section.settings.day_nodes | split: '|' %}
    {% assign evening_nodes = section.settings.evening_nodes | split: '|' %}
    <section id="funktion" class="ac-storage-page ac-storage-page__section ac-storage-page__function" data-ac-storage-page style="{{ ac_storage_style }} --ac-flow-image-height: {{ section.settings.flow_image_height | default: 460 }}px; --ac-flow-image-width: {{ section.settings.flow_image_width | default: 100 }}%; --ac-flow-node-size: {{ section.settings.flow_node_size | default: 13 }}px;" {{ section.shopify_attributes }}>
      <div class="ac-storage-page__wrap">
        <p class="ac-storage-page__eyebrow">{{ section.settings.eyebrow }}</p>
        {% assign function_heading_accent = section.settings.heading_accent | default: 'im Haushalt' %}
        {% if function_heading_accent != blank and section.settings.heading contains function_heading_accent %}
          {% assign function_heading_parts = section.settings.heading | split: function_heading_accent %}
          <h2>{{ function_heading_parts[0] }}<span class="ac-storage-page__heading-accent">{{ function_heading_accent }}</span>{{ function_heading_parts[1] }}</h2>
        {% else %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}
        <p class="ac-storage-page__subtext">{{ section.settings.subtext }}</p>
        <div class="ac-storage-page__flow-toggle" role="tablist" aria-label="{{ section.settings.toggle_aria_label }}">
          <button type="button" role="tab" class="is-active" data-ac-flow-toggle="day" aria-selected="true" aria-controls="{{ page_id }}-day">{{ section.settings.toggle_day_label }}</button>
          <button type="button" role="tab" data-ac-flow-toggle="evening" aria-selected="false" aria-controls="{{ page_id }}-evening" tabindex="-1">{{ section.settings.toggle_evening_label }}</button>
        </div>
        <div id="{{ page_id }}-day" class="ac-storage-page__flow-panel" data-ac-flow-panel="day" role="tabpanel" aria-hidden="false">
          <div class="ac-storage-page__media ac-storage-page__media--flow">
            {% if section.settings.day_image != blank %}
              {{ section.settings.day_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '640, 960, 1280, 1600', sizes: '100vw', alt: section.settings.day_image_alt }}
            {% else %}
              <div class="ac-storage-page__placeholder">{{ section.settings.day_placeholder }}</div>
            {% endif %}
          </div>
          <div class="ac-storage-page__flow-nodes">
            {% for node in day_nodes %}
              {% assign clean_node = node | strip %}
              {% if clean_node != blank %}<span><i aria-hidden="true"></i>{{ clean_node }}</span>{% endif %}
            {% endfor %}
          </div>
        </div>
        <div id="{{ page_id }}-evening" class="ac-storage-page__flow-panel" data-ac-flow-panel="evening" role="tabpanel" aria-hidden="true" hidden>
          <div class="ac-storage-page__media ac-storage-page__media--flow">
            {% if section.settings.evening_image != blank %}
              {{ section.settings.evening_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '640, 960, 1280, 1600', sizes: '100vw', alt: section.settings.evening_image_alt }}
            {% else %}
              <div class="ac-storage-page__placeholder">{{ section.settings.evening_placeholder }}</div>
            {% endif %}
          </div>
          <div class="ac-storage-page__flow-nodes">
            {% for node in evening_nodes %}
              {% assign clean_node = node | strip %}
              {% if clean_node != blank %}<span><i aria-hidden="true"></i>{{ clean_node }}</span>{% endif %}
            {% endfor %}
          </div>
        </div>
        <div class="ac-storage-page__steps">
          {% assign function_step_index = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'step' %}
              {% assign function_step_index = function_step_index | plus: 1 %}
              <article class="ac-storage-page__step" style="--ac-step-title-size: {{ block.settings.title_size | default: 19 }}px; --ac-step-body-size: {{ block.settings.body_size | default: 14 }}px;" {{ block.shopify_attributes }}>
                <span class="ac-storage-page__step-number">{{ function_step_index | prepend: '0' }}</span>
                <h3>{{ block.settings.title }}</h3>
                <p>{{ block.settings.body }}</p>
              </article>
            {% endif %}
          {% endfor %}
        </div>
        <a class="ac-storage-page__link" href="{{ function_link_url }}">{{ section.settings.link_label }}</a>
      </div>
    </section>

  {% when 'why' %}
    {% assign why_cta_url = section.settings.cta_url | default: '#modelle' %}
    <section id="vorteile" class="ac-storage-page ac-storage-page__section ac-storage-page__why" data-ac-storage-page style="{{ ac_storage_style }}" {{ section.shopify_attributes }}>
      <div class="ac-storage-page__wrap">
        <p class="ac-storage-page__eyebrow">{{ section.settings.eyebrow }}</p>
        {% assign why_heading_accent = section.settings.heading_accent | default: 'besonders praktisch ist' %}
        {% if why_heading_accent != blank and section.settings.heading contains why_heading_accent %}
          {% assign why_heading_parts = section.settings.heading | split: why_heading_accent %}
          <h2>{{ why_heading_parts[0] }}<span class="ac-storage-page__heading-accent">{{ why_heading_accent }}</span>{{ why_heading_parts[1] }}</h2>
        {% else %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}
        <p class="ac-storage-page__subtext">{{ section.settings.subtext }}</p>
        <div class="ac-storage-page__why-grid">
          {% assign why_stat_index = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'image_card' %}
              <article class="ac-storage-page__why-card" style="--ac-card-title-size: {{ block.settings.title_size | default: 18 }}px; --ac-card-body-size: {{ block.settings.body_size | default: 13 }}px; --ac-card-image-height: {{ block.settings.image_height | default: 210 }}px; --ac-card-image-width: {{ block.settings.image_width | default: 100 }}%;" {{ block.shopify_attributes }}>
                <div class="ac-storage-page__media ac-storage-page__media--why">
                  {% if block.settings.image != blank %}
                    {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1000', sizes: '(min-width: 1000px) 50vw, 100vw', alt: block.settings.alt }}
                  {% else %}
                    <div class="ac-storage-page__placeholder">{{ block.settings.placeholder }}</div>
                  {% endif %}
                </div>
                <div class="ac-storage-page__card-body">
                  <h3>{{ block.settings.title }}</h3>
                  <p>{{ block.settings.body }}</p>
                </div>
              </article>
            {% elsif block.type == 'stat' %}
              {% assign why_stat_index = why_stat_index | plus: 1 %}
              <article class="ac-storage-page__why-stat" style="--ac-card-title-size: {{ block.settings.title_size | default: 18 }}px; --ac-card-body-size: {{ block.settings.body_size | default: 13 }}px; --ac-card-min-height: {{ block.settings.card_height | default: 188 }}px;" {{ block.shopify_attributes }}>
                <span class="ac-storage-page__icon ac-storage-page__why-stat-icon" aria-hidden="true">
                  {% case why_stat_index %}
                    {% when 1 %}
                      <svg viewBox="0 0 24 24"><path d="M3 19h18M4 15l4-4 3 3 6-7 3 2"/></svg>
                    {% when 2 %}
                      <svg viewBox="0 0 24 24"><rect x="3.5" y="7" width="16" height="10" rx="1.5"/><path d="M19.5 10h2v4h-2M8 9.5v5M12 9.5v5M16 9.5v5"/></svg>
                  {% endcase %}
                </span>
                <h3>{{ block.settings.title }}</h3>
                <p>{{ block.settings.body }}</p>
                <span class="ac-storage-page__tag">{{ block.settings.tag }}</span>
              </article>
            {% endif %}
          {% endfor %}
        </div>
        <div class="ac-storage-page__center-cta">
          <a class="ac-storage-page__button ac-storage-page__button--primary" href="{{ why_cta_url }}">{{ section.settings.cta_label }}</a>
        </div>
      </div>
    </section>

  {% when 'comparison' %}
    {% assign comparison_link_url = section.settings.link_url | default: compare_url %}
    <section id="vergleich" class="ac-storage-page ac-storage-page__section ac-storage-page__comparison" data-ac-storage-page style="{{ ac_storage_style }} --ac-table-size: {{ section.settings.table_text_size | default: 15 }}px;" {{ section.shopify_attributes }}>
      <div class="ac-storage-page__wrap">
        <p class="ac-storage-page__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
        <p class="ac-storage-page__subtext">{{ section.settings.subtext }}</p>
        <div class="ac-storage-page__table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col">{{ section.settings.table_feature_heading }}</th>
                <th scope="col" class="is-highlight">{{ section.settings.table_ac_heading }}</th>
                <th scope="col">{{ section.settings.table_dc_heading }}</th>
              </tr>
            </thead>
            <tbody>
              {% for block in section.blocks %}
                {% if block.type == 'row' %}
                  <tr {{ block.shopify_attributes }}>
                    <th scope="row">{{ block.settings.label }}</th>
                    <td>{{ block.settings.ac }}</td>
                    <td>{{ block.settings.dc }}</td>
                  </tr>
                {% endif %}
              {% endfor %}
            </tbody>
          </table>
        </div>
        <p class="ac-storage-page__comparison-note">{{ section.settings.note }}</p>
        <a class="ac-storage-page__link" href="{{ comparison_link_url }}">{{ section.settings.link_label }}</a>
      </div>
    </section>

  {% when 'smart' %}
    {% assign smart_link_url = section.settings.link_url | default: smart_meter_url %}
    <section id="steuerung" class="ac-storage-page ac-storage-page__section ac-storage-page__smart" data-ac-storage-page style="{{ ac_storage_style }} --ac-smart-main-height: {{ section.settings.main_image_height | default: 296 }}px; --ac-smart-small-height: {{ section.settings.small_image_height | default: 150 }}px; --ac-smart-main-width: {{ section.settings.main_image_width | default: 100 }}%; --ac-smart-small-width: {{ section.settings.small_image_width | default: 100 }}%;" {{ section.shopify_attributes }}>
      <div class="ac-storage-page__wrap">
        <p class="ac-storage-page__eyebrow">{{ section.settings.eyebrow }}</p>
        {% assign smart_heading_accent = section.settings.heading_accent | default: 'sondern intelligent steuern' %}
        {% if smart_heading_accent != blank and section.settings.heading contains smart_heading_accent %}
          {% assign smart_heading_parts = section.settings.heading | split: smart_heading_accent %}
          <h2>{{ smart_heading_parts[0] }}<span>{{ smart_heading_accent }}</span>{{ smart_heading_parts[1] }}</h2>
        {% else %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}
        <p class="ac-storage-page__subtext">{{ section.settings.subtext }}</p>
        <div class="ac-storage-page__smart-grid">
          <div>
            <div class="ac-storage-page__smart-steps">
              {% assign smart_step_index = 0 %}
              {% for block in section.blocks %}
                {% if block.type == 'step' %}
                  {% assign smart_step_index = smart_step_index | plus: 1 %}
                  <article class="ac-storage-page__smart-step" style="--ac-smart-title-size: {{ block.settings.title_size | default: 19 }}px; --ac-smart-body-size: {{ block.settings.body_size | default: 14 }}px;" {{ block.shopify_attributes }}>
                    <span class="ac-storage-page__smart-number">{{ smart_step_index | prepend: '0' }}</span>
                    <div>
                      <h3>{{ block.settings.title }}</h3>
                      <p>{{ block.settings.body }}</p>
                    </div>
                  </article>
                {% endif %}
              {% endfor %}
            </div>
            <a class="ac-storage-page__link ac-storage-page__link--button" href="{{ smart_link_url }}">{{ section.settings.link_label }}</a>
          </div>
          <div class="ac-storage-page__smart-visuals">
            <div class="ac-storage-page__media ac-storage-page__media--smart-main">
              {% if section.settings.main_image != blank %}
                {{ section.settings.main_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '640, 960, 1200, 1400', sizes: '(min-width: 1000px) 42vw, 100vw', alt: section.settings.main_image_alt }}
              {% else %}
                <div class="ac-storage-page__placeholder">{{ section.settings.main_placeholder }}</div>
              {% endif %}
            </div>
            <div class="ac-storage-page__smart-small-grid">
              <div class="ac-storage-page__media ac-storage-page__media--smart-small">
                {% if section.settings.app_image != blank %}
                  {{ section.settings.app_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '360, 560, 800', sizes: '(min-width: 1000px) 21vw, 100vw', alt: section.settings.app_image_alt }}
                {% else %}
                  <div class="ac-storage-page__placeholder">{{ section.settings.app_placeholder }}</div>
                {% endif %}
              </div>
              <div class="ac-storage-page__media ac-storage-page__media--smart-small">
                {% if section.settings.meter_image != blank %}
                  {{ section.settings.meter_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '360, 560, 800', sizes: '(min-width: 1000px) 21vw, 100vw', alt: section.settings.meter_image_alt }}
                {% elsif smart_meter_image != blank %}
                  {{ smart_meter_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '360, 560, 800', sizes: '(min-width: 1000px) 21vw, 100vw', alt: section.settings.meter_image_alt }}
                {% else %}
                  <div class="ac-storage-page__placeholder">{{ section.settings.meter_placeholder }}</div>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

  {% when 'audience' %}
    {% assign audience_link_url = section.settings.link_url | default: eauto_url %}
    <section id="zielgruppen" class="ac-storage-page ac-storage-page__section ac-storage-page__audience" data-ac-storage-page style="{{ ac_storage_style }}" {{ section.shopify_attributes }}>
      <div class="ac-storage-page__wrap">
        <p class="ac-storage-page__eyebrow">{{ section.settings.eyebrow }}</p>
        {% assign audience_heading_accent = section.settings.heading_accent | default: 'besonders interessant?' %}
        {% if audience_heading_accent != blank and section.settings.heading contains audience_heading_accent %}
          {% assign audience_heading_parts = section.settings.heading | split: audience_heading_accent %}
          <h2>{{ audience_heading_parts[0] }}<span class="ac-storage-page__heading-accent">{{ audience_heading_accent }}</span>{{ audience_heading_parts[1] }}</h2>
        {% else %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}
        <div class="ac-storage-page__audience-grid">
          {% for block in section.blocks %}
            {% if block.type == 'audience_card' %}
              <article class="ac-storage-page__audience-card" style="--ac-card-title-size: {{ block.settings.title_size | default: 17 }}px; --ac-card-body-size: {{ block.settings.body_size | default: 13 }}px; --ac-card-image-height: {{ block.settings.image_height | default: 190 }}px; --ac-card-image-width: {{ block.settings.image_width | default: 100 }}%;" {{ block.shopify_attributes }}>
                <div class="ac-storage-page__media ac-storage-page__media--audience">
                  {% if block.settings.image != blank %}
                    {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '360, 560, 800', sizes: '(min-width: 1000px) 25vw, 100vw', alt: block.settings.alt }}
                  {% else %}
                    <div class="ac-storage-page__placeholder">{{ block.settings.placeholder }}</div>
                  {% endif %}
                </div>
                <div class="ac-storage-page__card-body">
                  <h3>{{ block.settings.title }}</h3>
                  <p>{{ block.settings.body }}</p>
                </div>
              </article>
            {% endif %}
          {% endfor %}
        </div>
        <a class="ac-storage-page__link" href="{{ audience_link_url }}">{{ section.settings.link_label }}</a>
      </div>
    </section>

  {% when 'models' %}
    <section id="modelle" class="ac-storage-page ac-storage-page__section ac-storage-page__models" data-ac-storage-page style="{{ ac_storage_style }}" {{ section.shopify_attributes }}>
      <div class="ac-storage-page__wrap">
        <p class="ac-storage-page__eyebrow">{{ section.settings.eyebrow }}</p>
        {% assign models_heading_accent = section.settings.heading_accent | default: 'Lösungen' %}
        {% if models_heading_accent != blank and section.settings.heading contains models_heading_accent %}
          {% assign models_heading_parts = section.settings.heading | split: models_heading_accent %}
          <h2>{{ models_heading_parts[0] }}<span class="ac-storage-page__heading-accent">{{ models_heading_accent }}</span>{{ models_heading_parts[1] }}</h2>
        {% else %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}
        <p class="ac-storage-page__subtext">{{ section.settings.subtext }}</p>
        <div class="ac-storage-page__models-grid">
          {% for block in section.blocks %}
            {% if block.type == 'product_card' %}
              {% assign model_product = block.settings.product %}
              {% assign model_name = block.settings.name | default: model_product.title | default: 'VENUS E' %}
              {% assign model_url = model_product.url | default: storage_url %}
              <article class="ac-storage-page__model-card" style="--ac-card-title-size: {{ block.settings.title_size | default: 18 }}px; --ac-card-body-size: {{ block.settings.body_size | default: 13 }}px; --ac-card-image-height: {{ block.settings.image_height | default: 210 }}px; --ac-card-image-width: {{ block.settings.image_width | default: 100 }}%;" {{ block.shopify_attributes }}>
                <a class="ac-storage-page__media ac-storage-page__media--model" href="{{ model_url }}">
                  {% if model_product.featured_image != blank %}
                    {{ model_product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '360, 560, 800', sizes: '(min-width: 1000px) 25vw, 100vw', alt: block.settings.alt | default: model_name }}
                  {% else %}
                    <span class="ac-storage-page__placeholder">{{ model_name }}</span>
                  {% endif %}
                </a>
                <div class="ac-storage-page__card-body">
                  <h3>{{ model_name }}</h3>
                  <p>{{ block.settings.copy }}</p>
                  <a class="ac-storage-page__link" href="{{ model_url }}">{{ block.settings.link_label | default: section.settings.card_link_label }}</a>
                </div>
              </article>
            {% endif %}
          {% endfor %}
        </div>
        <div class="ac-storage-page__models-actions">
          <a class="ac-storage-page__button ac-storage-page__button--primary" href="{{ section.settings.compare_url | default: compare_url }}">{{ section.settings.compare_label }}</a>
          <a class="ac-storage-page__button ac-storage-page__button--secondary" href="{{ section.settings.storage_url | default: storage_url }}">{{ section.settings.storage_label }}</a>
        </div>
      </div>
    </section>

  {% when 'faq' %}
    <section id="faq" class="ac-storage-page ac-storage-page__section ac-storage-page__faq" data-ac-storage-page style="{{ ac_storage_style }} --ac-faq-question-size: {{ section.settings.question_size | default: 16 }}px; --ac-faq-answer-size: {{ section.settings.answer_size | default: 14 }}px;" {{ section.shopify_attributes }}>
      <div class="ac-storage-page__wrap">
        <p class="ac-storage-page__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
        <div class="ac-storage-page__faq-list">
          {% for block in section.blocks %}
            {% if block.type == 'faq' and block.settings.question != blank %}
              <article class="ac-storage-page__faq-item" data-ac-faq-item {{ block.shopify_attributes }}>
                <button class="ac-storage-page__faq-question" type="button" data-ac-faq-question aria-expanded="false" aria-controls="{{ page_id }}-faq-{{ block.id }}">{{ block.settings.question }}<span aria-hidden="true">+</span></button>
                <div id="{{ page_id }}-faq-{{ block.id }}" class="ac-storage-page__faq-answer" data-ac-faq-answer hidden><p>{{ block.settings.answer }}</p></div>
              </article>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </section>
    {% assign faq_schema_count = 0 %}
    {% for block in section.blocks %}
      {% if block.type == 'faq' and block.settings.question != blank %}
        {% assign faq_schema_count = faq_schema_count | plus: 1 %}
      {% endif %}
    {% endfor %}
    {% if faq_schema_count > 0 %}
      <script type="application/ld+json">
      {
        "@context":"https://schema.org",
        "@type":"FAQPage",
        "mainEntity":[
          {% assign faq_schema_index = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'faq' and block.settings.question != blank %}
              {% if faq_schema_index > 0 %},{% endif %}
              {"@type":"Question","name":{{ block.settings.question | json }},"acceptedAnswer":{"@type":"Answer","text":{{ block.settings.answer | strip_html | json }}}}
              {% assign faq_schema_index = faq_schema_index | plus: 1 %}
            {% endif %}
          {% endfor %}
        ]
      }
      </script>
    {% endif %}

  {% when 'blog' %}
    <section id="ratgeber" class="ac-storage-page ac-storage-page__section ac-storage-page__blog" data-ac-storage-page style="{{ ac_storage_style }}" {{ section.shopify_attributes }}>
      <div class="ac-storage-page__wrap">
        <p class="ac-storage-page__eyebrow">{{ section.settings.eyebrow }}</p>
        {% assign blog_heading_words = section.settings.heading | split: ' ' %}
        {% assign blog_heading_accent = blog_heading_words | last %}
        {% assign blog_heading_before_accent = section.settings.heading | remove_last: blog_heading_accent | strip %}
        <h2>{{ blog_heading_before_accent }}{% if blog_heading_before_accent != blank %} {% endif %}<span>{{ blog_heading_accent }}</span></h2>
        <div class="ac-storage-page__blog-grid">
          {% for block in section.blocks %}
            {% if block.type == 'article' %}
              {% assign article_url = block.settings.url | default: blog_url %}
              <article class="ac-storage-page__blog-card" style="--ac-card-title-size: {{ block.settings.title_size | default: 17 }}px; --ac-card-body-size: {{ block.settings.body_size | default: 13 }}px; --ac-card-image-height: {{ block.settings.image_height | default: 140 }}px; --ac-card-image-width: {{ block.settings.image_width | default: 100 }}%;" {{ block.shopify_attributes }}>
                <a class="ac-storage-page__media ac-storage-page__media--blog" href="{{ article_url }}">
                  {% if block.settings.image != blank %}
                    {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '420, 640, 900', sizes: '(min-width: 1000px) 33vw, 100vw', alt: block.settings.alt }}
                  {% else %}
                    <span class="ac-storage-page__placeholder">{{ block.settings.placeholder }}</span>
                  {% endif %}
                </a>
                <div class="ac-storage-page__card-body">
                  <span class="ac-storage-page__tag">{{ block.settings.tag }}</span>
                  <h3>{{ block.settings.title }}</h3>
                  <p>{{ block.settings.copy }}</p>
                  <a class="ac-storage-page__link" href="{{ article_url }}">{{ block.settings.link_label | default: section.settings.card_link_label }}</a>
                </div>
              </article>
            {% endif %}
          {% endfor %}
        </div>
        <a class="ac-storage-page__link ac-storage-page__blog-cta" href="{{ section.settings.blog_url | default: blog_url }}">{{ section.settings.blog_link_label }}</a>
      </div>
    </section>

  {% when 'final' %}
    <section id="abschluss" class="ac-storage-page ac-storage-page__section ac-storage-page__final" data-ac-storage-page style="{{ ac_storage_style }} --ac-final-heading-size: {{ section.settings.final_heading_size | default: 30 }}px; --ac-final-copy-size: {{ section.settings.final_copy_size | default: 15.5 }}px;" {{ section.shopify_attributes }}>
      <div class="ac-storage-page__wrap">
        <div class="ac-storage-page__final-card">
          {% if section.settings.eyebrow != blank %}<p class="ac-storage-page__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
          <h2>{{ section.settings.heading }}</h2>
          <p>{{ section.settings.copy }}</p>
          <div class="ac-storage-page__actions">
            {% for block in section.blocks %}
              {% if block.type == 'action' and block.settings.label != blank %}
                {% assign action_style = block.settings.style | default: 'secondary' %}
                {% assign action_url = block.settings.url %}
                {% if action_url == blank %}
                  {% if action_style == 'primary' %}
                    {% assign action_url = compare_url %}
                  {% elsif action_style == 'secondary' %}
                    {% assign action_url = storage_url %}
                  {% else %}
                    {% assign action_url = eauto_url %}
                  {% endif %}
                {% endif %}
                {% if action_style == 'link' %}
                  <a class="ac-storage-page__link" href="{{ action_url }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
                {% else %}
                  <a class="ac-storage-page__button ac-storage-page__button--{{ action_style }}" href="{{ action_url }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
                {% endif %}
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </section>
{% endcase %}
