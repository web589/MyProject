{%- liquid
  assign card_page = block.settings.page
  assign article = block.settings.article
  assign content_item = card_page | default: article

  if content_item != blank
    assign card_image = block.settings.image
    if card_image == blank and card_page == blank and article != blank
      assign card_image = article.image
    endif
    assign card_title = block.settings.title | default: content_item.title
    assign card_description = block.settings.description
    if card_description == blank and card_page == blank and article != blank
      assign card_description = article.excerpt | strip_html | truncatewords: 18
    endif
    if card_description == blank
      assign card_description = content_item.content | strip_html | truncatewords: 18
    endif
    assign card_link = block.settings.link | default: content_item.url
  endif
-%}

{%- if content_item != blank -%}
  <a
    class="mega-menu-products__card mega-menu-products__card--article"
    href="{{ card_link | escape }}"
    aria-label="{{ card_title | escape }}"
  >
    <div class="mega-menu-products__card-media">
      {%- if card_image != blank -%}
        {%- render 'image-element',
          img: card_image,
          widths: '300, 500, 700',
          sizeVariable: '25vw',
          alt: card_title,
          classes: 'mega-menu-products__card-image',
          loading: 'lazy',
        -%}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'mega-menu-products__card-image' }}
      {%- endif -%}
    </div>

    <div class="mega-menu-products__card-content">
      <h3 class="mega-menu-products__card-title">{{ card_title | escape }}</h3>
      {%- if card_description != blank -%}
        <p class="mega-menu-products__card-description">{{ card_description | escape | newline_to_br }}</p>
      {%- endif -%}
    </div>
  </a>
{%- endif -%}
