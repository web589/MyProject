{%- assign visible_current_tags = blank -%}
{%- for current_tag in current_tags -%}
  {%- assign current_tag_first_character = current_tag | slice: 0, 1 -%}
  {%- unless current_tag_first_character == '_' -%}
    {%- if visible_current_tags == blank -%}
      {%- assign visible_current_tags = current_tag -%}
    {%- else -%}
      {%- assign visible_current_tags = visible_current_tags | append: ' + ' | append: current_tag -%}
    {%- endif -%}
  {%- endunless -%}
{%- endfor -%}

<nav class="blog-breadcrumbs" aria-label="breadcrumbs">
  <a href="{{ routes.root_url }}" title="{{ 'general.breadcrumbs.home_link_title' | t }}">
    {{ 'general.breadcrumbs.home' | t }}
  </a>

  <span class="blog-breadcrumbs__divider" aria-hidden="true">/</span>

  {%- if visible_current_tags != blank -%}
    <a href="{{ blog.url }}">{{ 'blogs.article.blog_center' | t }}</a>
    <span class="blog-breadcrumbs__divider" aria-hidden="true">/</span>
    <span aria-current="page">{{ visible_current_tags }}</span>
  {%- else -%}
    <span aria-current="page">{{ 'blogs.article.blog_center' | t }}</span>
  {%- endif -%}
</nav>
