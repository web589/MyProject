{%- liquid
  assign venus_pack_size = product.properties['_venus_pack_size'] | default: 1 | plus: 0
  if venus_pack_size < 1
    assign venus_pack_size = 1
  endif
  assign venus_display_quantity = product.quantity | divided_by: venus_pack_size
  assign is_venus_shared_inventory = false
  if product.properties['_venus_pack_size'] != blank
    assign is_venus_shared_inventory = true
  endif
  assign de_zero_vat_metafield = product.product.metafields.custom.de_zero_vat_eligible
  assign de_zero_vat_eligible = de_zero_vat_metafield.value
  if de_zero_vat_eligible != true
    if product.product.tags contains 'DE-0-VAT-PV' or product.product.tags contains 'DE 0% MwSt. PV'
      assign de_zero_vat_eligible = true
    endif
  endif
  assign de_zero_vat_variant = product.variant.metafields.custom.de_zero_vat_variant.value
  assign de_standard_vat_variant = product.variant.metafields.custom.de_standard_vat_variant.value
  assign de_vat_mode = product.properties['_de_vat_mode']
  if de_vat_mode != 'zero' and de_vat_mode != 'standard'
    if product.product.tags contains 'DE-0-VAT-PV' or product.product.tags contains 'DE 0% MwSt. PV' or de_standard_vat_variant != blank
      assign de_vat_mode = 'zero'
    else
      assign de_vat_mode = 'standard'
    endif
  endif
  if de_zero_vat_variant != blank
    assign de_zero_vat_eligible = true
  endif
  if de_vat_mode == 'zero' and de_standard_vat_variant != blank
    assign de_zero_vat_eligible = true
  endif
  assign has_visible_variant_option = false
  assign bundle_capacity_option_value = blank
  assign bundle_capacity_display_value = blank
  for option in product.options_with_values
    assign is_bundle_capacity_summary = false
    if option.value contains '×' and option.value contains 'VENUS E'
      assign is_bundle_capacity_summary = true
      assign bundle_capacity_option_value = option.value
      assign bundle_capacity_display_value = option.value | split: ' – ' | last
    endif
    unless is_bundle_capacity_summary
      assign has_visible_variant_option = true
    endunless
  endfor

  assign bundle_variant_1 = blank
  assign bundle_variant_2 = blank
  assign bundle_variant_3 = blank
  for bundle_variant in product.product.variants limit: 3
    case forloop.index
      when 1
        assign bundle_variant_1 = bundle_variant
      when 2
        assign bundle_variant_2 = bundle_variant
      when 3
        assign bundle_variant_3 = bundle_variant
    endcase
  endfor

  assign bundle_variant_1_available = false
  assign bundle_variant_2_available = false
  assign bundle_variant_3_available = false
  if bundle_variant_1 != blank and bundle_variant_1.available
    assign bundle_variant_1_available = true
  endif
  if bundle_variant_2 != blank and bundle_variant_2.available
    assign bundle_variant_2_available = true
  endif
  if bundle_variant_3 != blank and bundle_variant_3.available
    assign bundle_variant_3_available = true
  endif

  assign bundle_switch_quantity = 0
  assign bundle_suggestion_variant = blank
  assign bundle_suggestion_savings = 0
  assign bundle_suggestion_anchor_key = blank
  assign bundle_suggestion_cart_keys = blank
  assign bundle_current_total = 0
  assign bundle_product_id = product.product.id
  assign bundle_related_item_count = 0
  assign bundle_all_related_lines_resolved = true

  for cart_item in cart.items
    if cart_item.product.id == bundle_product_id
      assign bundle_related_item_count = bundle_related_item_count | plus: 1
      assign cart_item_pack_size = cart_item.properties['_venus_pack_size'] | plus: 0

      if cart_item_pack_size < 1 or cart_item_pack_size > 3
        assign cart_item_pack_size = 0
        if bundle_variant_1 != blank and cart_item.variant_id == bundle_variant_1.id
          assign cart_item_pack_size = 1
        elsif bundle_variant_2 != blank and cart_item.variant_id == bundle_variant_2.id
          assign cart_item_pack_size = 2
        elsif bundle_variant_3 != blank and cart_item.variant_id == bundle_variant_3.id
          assign cart_item_pack_size = 3
        endif
      endif

      if cart_item_pack_size < 1
        assign cart_item_variant_title = cart_item.variant.title | default: ''
        if cart_item_variant_title contains '3×' or cart_item_variant_title contains '3x'
          assign cart_item_pack_size = 3
        elsif cart_item_variant_title contains '2×' or cart_item_variant_title contains '2x'
          assign cart_item_pack_size = 2
        elsif cart_item_variant_title contains '1×' or cart_item_variant_title contains '1x'
          assign cart_item_pack_size = 1
        endif
      endif

      if cart_item_pack_size > 0 and cart_item_pack_size <= 3
        assign cart_item_units = cart_item.quantity | times: cart_item_pack_size
        assign bundle_switch_quantity = bundle_switch_quantity | plus: cart_item_units
        assign bundle_current_total = bundle_current_total | plus: cart_item.final_line_price

        if bundle_suggestion_anchor_key == blank
          assign bundle_suggestion_anchor_key = cart_item.key
        endif
        if bundle_suggestion_cart_keys == blank
          assign bundle_suggestion_cart_keys = cart_item.key
        else
          assign bundle_suggestion_cart_keys = bundle_suggestion_cart_keys | append: '||' | append: cart_item.key
        endif
      else
        assign bundle_all_related_lines_resolved = false
      endif
    endif
  endfor

  assign bundle_suggestion_ready = false
  assign bundle_recommended_price = 0
  assign bundle_best_count_1 = 0
  assign bundle_best_count_2 = 0
  assign bundle_best_count_3 = 0
  assign bundle_target_line_count = 0
  assign bundle_best_found = false

  if bundle_related_item_count > 0 and bundle_all_related_lines_resolved and bundle_switch_quantity >= 2 and bundle_switch_quantity <= 99
    assign bundle_max_count_3 = bundle_switch_quantity | divided_by: 3
    assign bundle_max_count_2 = bundle_switch_quantity | divided_by: 2

    for bundle_count_3 in (0..bundle_max_count_3)
      for bundle_count_2 in (0..bundle_max_count_2)
        assign bundle_units_3 = bundle_count_3 | times: 3
        assign bundle_units_2 = bundle_count_2 | times: 2
        assign bundle_count_1 = bundle_switch_quantity | minus: bundle_units_3 | minus: bundle_units_2
        if bundle_count_1 >= 0
          assign bundle_candidate_valid = true

          if bundle_count_1 > 0
            unless bundle_variant_1_available
              assign bundle_candidate_valid = false
            endunless
          endif
          if bundle_count_2 > 0
            unless bundle_variant_2_available
              assign bundle_candidate_valid = false
            endunless
          endif
          if bundle_count_3 > 0
            unless bundle_variant_3_available
              assign bundle_candidate_valid = false
            endunless
          endif

          if bundle_switch_quantity == 2 and bundle_count_2 != 1
            assign bundle_candidate_valid = false
          endif
          if bundle_switch_quantity == 3 and bundle_count_3 != 1
            assign bundle_candidate_valid = false
          endif

          if bundle_candidate_valid
            assign bundle_candidate_price = 0
            if bundle_count_1 > 0
              assign bundle_candidate_price = bundle_variant_1.price | times: bundle_count_1
            endif
            if bundle_count_2 > 0
              assign bundle_variant_2_total = bundle_variant_2.price | times: bundle_count_2
              assign bundle_candidate_price = bundle_candidate_price | plus: bundle_variant_2_total
            endif
            if bundle_count_3 > 0
              assign bundle_variant_3_total = bundle_variant_3.price | times: bundle_count_3
              assign bundle_candidate_price = bundle_candidate_price | plus: bundle_variant_3_total
            endif
            assign bundle_candidate_line_count = bundle_count_1 | plus: bundle_count_2 | plus: bundle_count_3

            assign bundle_candidate_is_better = false
            if bundle_best_found == false
              assign bundle_candidate_is_better = true
            elsif bundle_candidate_price < bundle_recommended_price
              assign bundle_candidate_is_better = true
            elsif bundle_candidate_price == bundle_recommended_price
              if bundle_candidate_line_count < bundle_target_line_count
                assign bundle_candidate_is_better = true
              elsif bundle_candidate_line_count == bundle_target_line_count and bundle_count_3 > bundle_best_count_3
                assign bundle_candidate_is_better = true
              endif
            endif

            if bundle_candidate_is_better
              assign bundle_best_found = true
              assign bundle_recommended_price = bundle_candidate_price
              assign bundle_best_count_1 = bundle_count_1
              assign bundle_best_count_2 = bundle_count_2
              assign bundle_best_count_3 = bundle_count_3
              assign bundle_target_line_count = bundle_candidate_line_count
            endif
          endif
        endif
      endfor
    endfor
  endif

  if bundle_best_found
    assign bundle_suggestion_savings = bundle_current_total | minus: bundle_recommended_price
    if bundle_suggestion_savings > 0
      assign bundle_suggestion_ready = true
    endif

    if bundle_switch_quantity == 2 and bundle_best_count_2 == 1
      assign bundle_suggestion_variant = bundle_variant_2
      for cart_item in cart.items
        if cart_item.product.id == bundle_product_id and cart_item.variant_id == bundle_suggestion_variant.id
          assign bundle_suggestion_ready = false
          break
        endif
      endfor
    elsif bundle_switch_quantity == 3 and bundle_best_count_3 == 1
      assign bundle_suggestion_variant = bundle_variant_3
      for cart_item in cart.items
        if cart_item.product.id == bundle_product_id and cart_item.variant_id == bundle_suggestion_variant.id
          assign bundle_suggestion_ready = false
          break
        endif
      endfor
    endif
  endif

  assign bundle_suggestion_summary = blank
  assign bundle_target_items_json = '['
  assign bundle_target_items_added = 0
  if bundle_suggestion_ready
    if bundle_best_count_3 > 0
      if bundle_suggestion_summary != blank
        assign bundle_suggestion_summary = bundle_suggestion_summary | append: ' + '
      endif
      if bundle_best_count_3 == 1
        assign bundle_suggestion_summary = bundle_suggestion_summary | append: '3× Set'
      else
        assign bundle_suggestion_summary = bundle_suggestion_summary | append: bundle_best_count_3 | append: ' × 3× Set'
      endif
      assign bundle_target_items_json = bundle_target_items_json | append: '{"id":' | append: bundle_variant_3.id | append: ',"quantity":' | append: bundle_best_count_3 | append: '}'
      assign bundle_target_items_added = bundle_target_items_added | plus: 1
    endif
    if bundle_best_count_2 > 0
      if bundle_suggestion_summary != blank
        assign bundle_suggestion_summary = bundle_suggestion_summary | append: ' + '
      endif
      if bundle_best_count_2 == 1
        assign bundle_suggestion_summary = bundle_suggestion_summary | append: '2× Set'
      else
        assign bundle_suggestion_summary = bundle_suggestion_summary | append: bundle_best_count_2 | append: ' × 2× Set'
      endif
      if bundle_target_items_added > 0
        assign bundle_target_items_json = bundle_target_items_json | append: ','
      endif
      assign bundle_target_items_json = bundle_target_items_json | append: '{"id":' | append: bundle_variant_2.id | append: ',"quantity":' | append: bundle_best_count_2 | append: '}'
      assign bundle_target_items_added = bundle_target_items_added | plus: 1
    endif
    if bundle_best_count_1 > 0
      if bundle_suggestion_summary != blank
        assign bundle_suggestion_summary = bundle_suggestion_summary | append: ' + '
      endif
      if bundle_best_count_1 == 1
        assign bundle_suggestion_summary = bundle_suggestion_summary | append: '1× Einzelgerät'
      else
        assign bundle_suggestion_summary = bundle_suggestion_summary | append: bundle_best_count_1 | append: ' × Einzelgeräte'
      endif
      if bundle_target_items_added > 0
        assign bundle_target_items_json = bundle_target_items_json | append: ','
      endif
      assign bundle_target_items_json = bundle_target_items_json | append: '{"id":' | append: bundle_variant_1.id | append: ',"quantity":' | append: bundle_best_count_1 | append: '}'
      assign bundle_target_items_added = bundle_target_items_added | plus: 1
    endif
  endif
  assign bundle_target_items_json = bundle_target_items_json | append: ']'
-%}
<div
  class="cart__item"
  data-key="{{ product.key }}"
  data-de-zero-vat-eligible="{{ de_zero_vat_eligible | default: false }}"
  data-de-vat-mode="{{ de_vat_mode }}"
  data-de-vat-product-id="{{ product.product.id }}"
  data-de-vat-variant-id="{{ product.variant_id }}"
  data-de-vat-is-zero-product="{% if de_vat_mode == 'zero' %}true{% else %}false{% endif %}"
  data-de-standard-vat-variant-id="{% if de_vat_mode == 'zero' %}{{ de_standard_vat_variant.id }}{% else %}{{ product.variant_id }}{% endif %}"
  data-de-zero-vat-variant-id="{% if de_vat_mode == 'zero' %}{{ product.variant_id }}{% else %}{{ de_zero_vat_variant.id }}{% endif %}"
  {% if is_venus_shared_inventory %}
    data-venus-shared-variant-id="{{ product.variant_id }}"
    data-venus-shared-inventory-limit="{{ product.variant.inventory_quantity | default: 0 }}"
    data-venus-inventory-message="{{ product.properties['_venus_inventory_error'] | default: 'Nicht genügend gemeinsamer Lagerbestand verfügbar. Bitte reduziere die gewählte Menge.' | escape }}"
  {% endif %}
>
  <div class="cart__image">
    {% if product.image != blank %}
      <a href="{{ product.url }}" class="image-wrap">
        {%- render 'image-element',
          img: product,
          alt: product.product.title,
          widths: '180, 360, 540',
          sizes: sizes,
          sizeVariable: sizeVariable,
          fallback: fallback,
        -%}
      </a>
    {% endif %}
  </div>
  <div class="cart__item-details">
    <div class="cart__item-title">
      <a href="{{ product.url }}" class="cart__item-name">
        {{ product.product.title }}
      </a>
      {%- unless product.product.has_only_default_variant or has_visible_variant_option == false -%}
        <div class="cart__item--variants">
          {%- for option in product.options_with_values -%}
            {%- liquid
              assign is_bundle_capacity_summary = false
              if option.value contains '×' and option.value contains 'VENUS E'
                assign is_bundle_capacity_summary = true
              endif
            -%}
            {%- unless is_bundle_capacity_summary -%}
              <div><span>{{ option.name }}:</span> {{ option.value }}</div>
            {%- endunless -%}
          {%- endfor -%}
        </div>
      {%- endunless -%}
      {%- if product.selling_plan_allocation != empty -%}
        <div class="cart__item--variants">
          {{ product.selling_plan_allocation.selling_plan.name }}
        </div>
      {%- endif -%}
      {%- assign property_size = product.properties | size -%}
      {%- assign bundle_capacity_rendered = false -%}
      {% if property_size > 0 %}
        {% for p in product.properties %}
          {%- assign first_character_in_key = p.first | truncate: 1, '' -%}
          {% unless p.last == blank or first_character_in_key == '_' %}
            {%- assign is_bundle_capacity_duplicate = false -%}
            {%- if p.last contains '×' and p.last contains 'VENUS E' -%}
              {%- if bundle_capacity_rendered -%}
                {%- assign is_bundle_capacity_duplicate = true -%}
              {%- else -%}
                {%- assign bundle_capacity_rendered = true -%}
              {%- endif -%}
            {%- endif -%}
            {%- unless is_bundle_capacity_duplicate -%}
              <div class="cart__item--properties">
                <span>{{ p.first }}:</span>
                {% if p.last contains '/uploads/' %}
                  <a href="{{ p.last }}">{{ p.last | split: '/' | last }}</a>
                {% else %}
                  {{ p.last }}
                {% endif %}
              </div>
            {%- endunless -%}
          {% endunless %}
        {% endfor %}
      {% endif %}

      {% if bundle_capacity_option_value != blank and bundle_capacity_rendered == false %}
        <div class="cart__item--variants">
          {{ bundle_capacity_display_value }}
        </div>
      {% endif %}

    </div>

    {% if product.key == bundle_suggestion_anchor_key and bundle_suggestion_ready %}
      <div class="cart-bundle-suggestion{% if bundle_target_line_count > 1 %} cart-bundle-suggestion--combination{% endif %}" data-bundle-suggestion>
        <div class="cart-bundle-suggestion__header">
          <span class="cart-bundle-suggestion__label">
            <svg class="cart-bundle-suggestion__tag-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M3.5 4.5h7.2l9.8 9.8-6.2 6.2-9.8-9.8V4.5Zm4.2 4.2h.1" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="7.8" cy="8.7" r="1" fill="currentColor"/>
            </svg>
            <span>Bundle-Empfehlung</span>
          </span>
          <span class="cart-bundle-suggestion__saving">Spare {{ bundle_suggestion_savings | money }}</span>
        </div>

        <p class="cart-bundle-suggestion__headline">
          {% if bundle_target_line_count == 1 %}
            Mit dem {{ bundle_switch_quantity }}×-Set sparst du {{ bundle_suggestion_savings | money }}
          {% else %}
            Mit der Bundle-Kombination {{ bundle_suggestion_summary }} sparst du {{ bundle_suggestion_savings | money }}
          {% endif %}
        </p>

        <div class="cart-bundle-suggestion__comparison" aria-label="Preisvergleich">
          <div class="cart-bundle-suggestion__comparison-item">
            <span>{{ bundle_switch_quantity }} × Einzelgerät</span>
            <strong>{{ bundle_current_total | money }}</strong>
          </div>
          <span class="cart-bundle-suggestion__comparison-arrow" aria-hidden="true">→</span>
          <div class="cart-bundle-suggestion__comparison-item cart-bundle-suggestion__comparison-item--bundle">
            <span>{{ bundle_suggestion_summary }}</span>
            <strong>{{ bundle_recommended_price | money }}</strong>
          </div>
        </div>

        <button
          type="button"
          class="cart-bundle-suggestion__button"
          data-bundle-switch
          data-cart-key="{{ product.key | escape }}"
          data-cart-keys="{{ bundle_suggestion_cart_keys | split: '||' | json | escape }}"
          data-target-items="{{ bundle_target_items_json | escape }}"
          data-target-variant-id="{% if bundle_suggestion_variant != blank %}{{ bundle_suggestion_variant.id }}{% endif %}"
          data-target-quantity="1"
        >
          {% if bundle_target_line_count == 1 %}
            <span>Zum {{ bundle_switch_quantity }}×-Set wechseln</span>
          {% else %}
            <span>Zur Bundle-Kombination wechseln</span>
          {% endif %}
          <span class="cart-bundle-suggestion__button-arrow" aria-hidden="true">→</span>
        </button>

        <p class="cart-bundle-suggestion__benefit">
          <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="8.5" fill="currentColor"/><path d="m6.3 10.1 2.3 2.3 5.1-5.1" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>Gleiche Leistung. Weniger Kosten. Mehr Unabhängigkeit.</span>
        </p>
      </div>
    {% endif %}

    <div class="cart__item-sub">
      <div>
        <div class="js-qty__wrapper" data-cart-quantity-control>
          <span class="cart-quantity-loader" aria-hidden="true"></span>
          <label for="cart_updates_{{ product.key }}" class="hidden-label">{{ 'cart.label.quantity' | t }}</label>
          <input type="text"
            id="cart_updates_{{ product.key }}"
            name="updates[]"
            class="js-qty__num"
            value="{{ venus_display_quantity }}"
            min="0"
            pattern="[0-9]*"
            data-id="{{ product.key }}"
            data-quantity-multiplier="{{ venus_pack_size }}">
          <button type="button"
            class="js-qty__adjust js-qty__adjust--minus"
            aria-label="{{ 'cart.general.reduce_quantity' | t }}">
              <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-minus" viewBox="0 0 20 20"><path fill="#444" d="M17.543 11.029H2.1A1.032 1.032 0 0 1 1.071 10c0-.566.463-1.029 1.029-1.029h15.443c.566 0 1.029.463 1.029 1.029 0 .566-.463 1.029-1.029 1.029z"/></svg>
              <span class="icon__fallback-text" aria-hidden="true">&minus;</span>
          </button>
          <button type="button"
            class="js-qty__adjust js-qty__adjust--plus"
            aria-label="{{ 'cart.general.increase_quantity' | t }}">
              <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-plus" viewBox="0 0 20 20"><path fill="#444" d="M17.409 8.929h-6.695V2.258c0-.566-.506-1.029-1.071-1.029s-1.071.463-1.071 1.029v6.671H1.967C1.401 8.929.938 9.435.938 10s.463 1.071 1.029 1.071h6.605V17.7c0 .566.506 1.029 1.071 1.029s1.071-.463 1.071-1.029v-6.629h6.695c.566 0 1.029-.506 1.029-1.071s-.463-1.071-1.029-1.071z"/></svg>
              <span class="icon__fallback-text" aria-hidden="true">+</span>
          </button>
        </div>

      </div>

      <div class="cart__item-price-col text-right">
        {%- liquid
          assign cart_item_current_price = product.final_line_price
          assign cart_item_original_price = product.original_line_price
          if product.variant.compare_at_price > product.variant.price
            assign cart_item_original_price = product.variant.compare_at_price | times: product.quantity
          endif
        -%}
        <span class="cart__price cart__price--current">
          {{ cart_item_current_price | money }}
        </span>

        {% if cart_item_original_price > cart_item_current_price %}
          <span class="visually-hidden">{{ 'products.general.regular_price' | t }}</span>
          <small class="cart__price cart__price--strikethrough">
            {{ cart_item_original_price | money }}
          </small>
        {% endif %}

        {%- if product.line_level_discount_allocations != blank -%}
          {%- for discount_allocation in product.line_level_discount_allocations -%}
            <small class="cart__discount">{{ discount_allocation.discount_application.title }} (-{{ discount_allocation.amount | money }})</small>
          {%- endfor -%}
        {%- endif -%}

        {%- if product.unit_price_measurement -%}
          {%- capture unit_price_base_unit -%}
            <span class="unit-price-base">
              {%- if product.unit_price_measurement -%}
                {%- if product.unit_price_measurement.reference_value != 1 -%}
                  {{ product.unit_price_measurement.reference_value }}
                {%- endif -%}
                {{ product.unit_price_measurement.reference_unit }}
              {%- endif -%}
            </span>
          {%- endcapture -%}

          <div class="product__unit-price">{{ product.unit_price | money }}/{{ unit_price_base_unit }}</div>
        {%- endif -%}

        <div class="cart__remove">
          <a
            href="{{ routes.cart_change_url }}?id={{ product.key }}&amp;quantity=0"
            class="cart__remove-button"
            data-cart-remove
            data-cart-key="{{ product.key }}"
            aria-label="{{ 'cart.general.remove' | t }}: {{ product.product.title | escape }}"
          >
            <span class="cart__remove-icon-card">
              {% if settings.cart_remove_icon != blank %}
                <img
                  src="{{ settings.cart_remove_icon | image_url: width: 112 }}"
                  alt=""
                  width="56"
                  height="56"
                  loading="lazy"
                >
              {% else %}
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M4 7h16M9 7V4h6v3m-8 0 1 13h8l1-13M10 11v5m4-5v5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {% endif %}
            </span>
            <span class="visually-hidden">{{ 'cart.general.remove' | t }}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
