{%- comment -%}
  Shared tax policy resolver. The theme settings are isolated to this theme;
  they do not change product tax overrides, inventory or product metafields.

  policy_product: product object; policy_variant: optional current variant.
  line_properties: optional cart properties, used only for legacy restoration.
  output: 'candidate' returns true/false; 'json' returns policy JSON;
  any other value renders the cart item's data attributes.

  Theme meter pairs deliberately require four distinct, single-variant products.
  Their identities determine both directions and the mode, never a cart property
  or a zero-rate tag. Selected products remain candidates when setup is invalid.
  The explicit component-taxed list is independent of the meter-pair switch;
  selected meter products cannot use that list to bypass pair validation.
  With the pair switch off, a selected taxable standard meter may use its
  existing standard variant for regular tax only; this never enables 0%.
  Bundle pairs use distinct native components and inventory pools. Match their
  three capacities by option value, and retain the original product outside DE.
{%- endcomment -%}
{%- liquid
  assign vat_product = policy_product
  assign vat_variant = policy_variant | default: vat_product.selected_or_first_available_variant
  assign vat_candidate = false
  assign vat_strategy = vat_product.metafields.custom.de_vat_strategy.value | default: '' | strip | downcase
  unless vat_strategy == 'single_product' or vat_strategy == 'bundle_components' or vat_strategy == 'paired_variants'
    assign vat_strategy = ''
  endunless
  if vat_strategy != blank or vat_product.metafields.custom.de_zero_vat_eligible.value == true or vat_product.tags contains 'DE-0-VAT-PV' or vat_product.tags contains 'DE 0% MwSt. PV'
    assign vat_candidate = true
  endif
  for candidate_variant in vat_product.variants
    if candidate_variant.metafields.custom.de_zero_vat_variant.value != blank or candidate_variant.metafields.custom.de_standard_vat_variant.value != blank or candidate_variant.metafields.custom.de_canonical_variant.value != blank
      assign vat_candidate = true
      break
    endif
  endfor

  assign zero_variant = vat_variant.metafields.custom.de_zero_vat_variant.value
  assign standard_variant = vat_variant.metafields.custom.de_standard_vat_variant.value
  assign vat_mode = line_properties['_de_vat_mode']
  unless vat_mode == 'zero' or vat_mode == 'standard'
    assign vat_mode = 'standard'
    if vat_product.tags contains 'DE-0-VAT-PV' or vat_product.tags contains 'DE 0% MwSt. PV' or standard_variant != blank
      assign vat_mode = 'zero'
    endif
  endunless
  assign standard_variant_id = vat_variant.id
  assign zero_variant_id = zero_variant.id
  if vat_mode == 'zero'
    assign standard_variant_id = standard_variant.id
    assign zero_variant_id = vat_variant.id
  endif
  assign vat_configured = false
  assign vat_single_source = false
  assign vat_policy_invalid = false
  assign canonical_variant_id = blank
  assign vat_regular_online_ready = false
  assign ct002_standard = settings.de_vat_ct002_standard_product
  assign ct002_zero = settings.de_vat_ct002_zero_product
  assign ct003_standard = settings.de_vat_ct003_standard_product
  assign ct003_zero = settings.de_vat_ct003_zero_product
  assign canonical_variant = vat_variant.metafields.custom.de_canonical_variant.value
  assign canonical_strategy = canonical_variant.product.metafields.custom.de_vat_strategy.value | default: '' | strip | downcase
  if canonical_variant != blank and canonical_strategy == 'single_product'
    assign canonical_variant_id = canonical_variant.id
    assign vat_candidate = true
  endif
  if vat_strategy == 'single_product' or vat_strategy == 'bundle_components'
    assign vat_configured = true
    assign vat_single_source = true
    assign vat_mode = 'single'
    assign standard_variant_id = vat_variant.id
    assign zero_variant_id = blank
  elsif vat_strategy == 'paired_variants'
    assign vat_policy_invalid = true
    if zero_variant != blank and standard_variant == blank
      assign vat_mode = 'standard'
      assign standard_variant_id = vat_variant.id
      assign zero_variant_id = zero_variant.id
      assign reverse_variant = zero_variant.metafields.custom.de_standard_vat_variant.value
      assign reverse_strategy = zero_variant.product.metafields.custom.de_vat_strategy.value | default: '' | strip | downcase
      if reverse_variant.id == vat_variant.id and zero_variant.id != vat_variant.id and reverse_strategy == 'paired_variants' and zero_variant.metafields.custom.de_zero_vat_variant.value == blank
        assign vat_configured = true
        assign vat_policy_invalid = false
      endif
    elsif standard_variant != blank and zero_variant == blank
      assign vat_mode = 'zero'
      assign standard_variant_id = standard_variant.id
      assign zero_variant_id = vat_variant.id
      assign reverse_variant = standard_variant.metafields.custom.de_zero_vat_variant.value
      assign reverse_strategy = standard_variant.product.metafields.custom.de_vat_strategy.value | default: '' | strip | downcase
      if reverse_variant.id == vat_variant.id and standard_variant.id != vat_variant.id and reverse_strategy == 'paired_variants' and standard_variant.metafields.custom.de_standard_vat_variant.value == blank
        assign vat_configured = true
        assign vat_policy_invalid = false
      endif
    endif
  endif

  unless settings.de_vat_theme_policy_enabled
    if vat_variant.taxable and canonical_variant == nil
      if ct002_standard != blank and vat_product.id == ct002_standard.id
        if ct002_standard.variants.size == 1 and vat_variant.id == ct002_standard.variants.first.id
          if ct002_zero == blank or ct002_zero.id != ct002_standard.id
            assign vat_candidate = true
            assign vat_strategy = 'paired_variants'
            assign vat_configured = false
            assign vat_single_source = false
            assign vat_policy_invalid = false
            assign vat_mode = 'standard'
            assign standard_variant_id = vat_variant.id
            assign zero_variant_id = blank
            assign vat_regular_online_ready = true
          endif
        endif
      elsif ct003_standard != blank and vat_product.id == ct003_standard.id
        if ct003_standard.variants.size == 1 and vat_variant.id == ct003_standard.variants.first.id
          if ct003_zero == blank or ct003_zero.id != ct003_standard.id
            assign vat_candidate = true
            assign vat_strategy = 'paired_variants'
            assign vat_configured = false
            assign vat_single_source = false
            assign vat_policy_invalid = false
            assign vat_mode = 'standard'
            assign standard_variant_id = vat_variant.id
            assign zero_variant_id = blank
            assign vat_regular_online_ready = true
          endif
        endif
      endif
    endif
  endunless

  if settings.de_vat_theme_policy_enabled
    assign theme_pair_candidate = false
    if vat_product.id != blank
      if vat_product.id == ct002_standard.id or vat_product.id == ct002_zero.id or vat_product.id == ct003_standard.id or vat_product.id == ct003_zero.id
        assign theme_pair_candidate = true
      endif
    endif
    if theme_pair_candidate
      assign vat_candidate = true
      assign vat_strategy = 'paired_variants'
      assign vat_configured = false
      assign vat_single_source = false
      assign vat_policy_invalid = true
      assign canonical_variant_id = blank
      assign standard_variant_id = blank
      assign zero_variant_id = blank
      assign vat_mode = 'standard'
      if vat_product.id == ct002_zero.id or vat_product.id == ct003_zero.id
        assign vat_mode = 'zero'
      endif
      assign theme_pairs_valid = true
      if ct002_standard == blank or ct002_zero == blank or ct003_standard == blank or ct003_zero == blank
        assign theme_pairs_valid = false
      elsif ct002_standard.variants.size != 1 or ct002_zero.variants.size != 1 or ct003_standard.variants.size != 1 or ct003_zero.variants.size != 1
        assign theme_pairs_valid = false
      elsif ct002_standard.id == ct002_zero.id or ct002_standard.id == ct003_standard.id or ct002_standard.id == ct003_zero.id or ct002_zero.id == ct003_standard.id or ct002_zero.id == ct003_zero.id or ct003_standard.id == ct003_zero.id
        assign theme_pairs_valid = false
      elsif ct002_standard.variants.first.id == ct002_zero.variants.first.id or ct002_standard.variants.first.id == ct003_standard.variants.first.id or ct002_standard.variants.first.id == ct003_zero.variants.first.id or ct002_zero.variants.first.id == ct003_standard.variants.first.id or ct002_zero.variants.first.id == ct003_zero.variants.first.id or ct003_standard.variants.first.id == ct003_zero.variants.first.id
        assign theme_pairs_valid = false
      endif
      for component_tax_product in settings.de_vat_bundle_components_products
        if component_tax_product.id == ct002_standard.id or component_tax_product.id == ct002_zero.id or component_tax_product.id == ct003_standard.id or component_tax_product.id == ct003_zero.id
          assign theme_pairs_valid = false
          break
        endif
      endfor
      if theme_pairs_valid
        if vat_product.id == ct002_standard.id or vat_product.id == ct002_zero.id
          assign standard_variant_id = ct002_standard.variants.first.id
          assign zero_variant_id = ct002_zero.variants.first.id
        else
          assign standard_variant_id = ct003_standard.variants.first.id
          assign zero_variant_id = ct003_zero.variants.first.id
        endif
        if vat_variant.id == standard_variant_id or vat_variant.id == zero_variant_id
          assign vat_configured = true
          assign vat_policy_invalid = false
        endif
      endif
    endif
  endif

  assign theme_bundle_candidate = false
  for component_tax_product in settings.de_vat_bundle_components_products
    if vat_product.id != blank and component_tax_product.id == vat_product.id
      assign theme_bundle_candidate = true
      break
    endif
  endfor
  if theme_bundle_candidate
    assign vat_candidate = true
    assign vat_strategy = 'bundle_components'
    assign vat_configured = true
    assign vat_single_source = true
    assign vat_policy_invalid = false
    assign vat_mode = 'single'
    assign canonical_variant_id = blank
    assign standard_variant_id = vat_variant.id
    assign zero_variant_id = blank
    assign vat_regular_online_ready = false
    if vat_product.id == settings.de_vat_ct002_standard_product.id or vat_product.id == settings.de_vat_ct002_zero_product.id or vat_product.id == settings.de_vat_ct003_standard_product.id or vat_product.id == settings.de_vat_ct003_zero_product.id
      assign vat_configured = false
      assign vat_single_source = false
      assign vat_policy_invalid = true
      assign standard_variant_id = blank
    endif
  endif

  assign theme_bundle_pair_candidate = false
  assign international_variant_id = blank
  for bundle_pair_index in (1..4)
    assign bundle_zero_key = 'de_vat_bundle_' | append: bundle_pair_index | append: '_zero_product'
    assign bundle_standard_key = 'de_vat_bundle_' | append: bundle_pair_index | append: '_standard_product'
    assign bundle_zero = settings[bundle_zero_key]
    assign bundle_standard = settings[bundle_standard_key]
    if vat_product.id != blank
      if vat_product.id == bundle_zero.id or vat_product.id == bundle_standard.id
        assign theme_bundle_pair_candidate = true
        assign vat_candidate = true
        assign vat_strategy = 'paired_variants'
        assign vat_configured = false
        assign vat_single_source = false
        assign vat_policy_invalid = true
        assign vat_regular_online_ready = false
        assign canonical_variant_id = blank
        assign standard_variant_id = blank
        assign zero_variant_id = blank
        assign international_variant_id = blank
        assign vat_mode = 'standard'
        if vat_product.id == bundle_zero.id
          assign vat_mode = 'zero'
        endif
        assign bundle_pair_valid = true
        if bundle_zero == blank or bundle_standard == blank or bundle_zero.id == bundle_standard.id
          assign bundle_pair_valid = false
        elsif bundle_zero.variants.size != 3 or bundle_standard.variants.size != 3 or bundle_zero.options.size != 1 or bundle_standard.options.size != 1
          assign bundle_pair_valid = false
        elsif bundle_zero.options.first != bundle_standard.options.first
          assign bundle_pair_valid = false
        endif
        if bundle_zero.id == ct002_zero.id or bundle_zero.id == ct002_standard.id or bundle_zero.id == ct003_zero.id or bundle_zero.id == ct003_standard.id or bundle_standard.id == ct002_zero.id or bundle_standard.id == ct002_standard.id or bundle_standard.id == ct003_zero.id or bundle_standard.id == ct003_standard.id
          assign bundle_pair_valid = false
        endif
        for other_pair_index in (1..4)
          unless other_pair_index == bundle_pair_index
            assign other_zero_key = 'de_vat_bundle_' | append: other_pair_index | append: '_zero_product'
            assign other_standard_key = 'de_vat_bundle_' | append: other_pair_index | append: '_standard_product'
            assign other_zero = settings[other_zero_key]
            assign other_standard = settings[other_standard_key]
            if bundle_zero.id == other_zero.id or bundle_zero.id == other_standard.id or bundle_standard.id == other_zero.id or bundle_standard.id == other_standard.id
              assign bundle_pair_valid = false
            endif
          endunless
        endfor
        assign matched_bundle_zero_id = ''
        assign matched_bundle_standard_id = ''
        for bundle_zero_variant in bundle_zero.variants
          assign zero_matches = bundle_zero.variants | where: 'option1', bundle_zero_variant.option1
          assign standard_matches = bundle_standard.variants | where: 'option1', bundle_zero_variant.option1
          if bundle_zero_variant.option1 == blank or zero_matches.size != 1 or standard_matches.size != 1
            assign bundle_pair_valid = false
          else
            assign bundle_standard_variant = standard_matches.first
            if bundle_zero_variant.id == bundle_standard_variant.id
              assign bundle_pair_valid = false
            endif
            if vat_mode == 'zero' and vat_variant.id == bundle_zero_variant.id
              assign matched_bundle_zero_id = bundle_zero_variant.id
              assign matched_bundle_standard_id = bundle_standard_variant.id
            elsif vat_mode == 'standard' and vat_variant.id == bundle_standard_variant.id
              assign matched_bundle_zero_id = bundle_zero_variant.id
              assign matched_bundle_standard_id = bundle_standard_variant.id
            endif
          endif
        endfor
        if bundle_pair_valid and matched_bundle_zero_id != blank and matched_bundle_standard_id != blank
          assign vat_configured = true
          assign vat_policy_invalid = false
          assign standard_variant_id = matched_bundle_standard_id
          assign zero_variant_id = matched_bundle_zero_id
          assign international_variant_id = matched_bundle_zero_id
        endif
      endif
    endif
  endfor
-%}
{%- if output == 'candidate' -%}
  {{- vat_candidate -}}
{%- elsif output == 'json' -%}
  {"candidate":{{ vat_candidate | json }},"strategy":{{ vat_strategy | json }},"configured":{{ vat_configured | json }},"mode":{{ vat_mode | json }},"singleSource":{{ vat_single_source | json }},"invalid":{{ vat_policy_invalid | json }},"standardVariantId":{{ standard_variant_id | append: '' | json }},"zeroVariantId":{{ zero_variant_id | append: '' | json }},"canonicalVariantId":{{ canonical_variant_id | append: '' | json }}{% if theme_bundle_pair_candidate %},"internationalVariantId":{{ international_variant_id | append: '' | json }}{% endif %}}
{%- else -%}
  data-de-zero-vat-eligible="{{ vat_candidate }}"
  data-de-vat-mode="{{ vat_mode }}"
  data-de-vat-is-zero-product="{% if vat_mode == 'zero' %}true{% else %}false{% endif %}"
  data-de-vat-strategy="{{ vat_strategy }}"
  data-de-vat-configured="{{ vat_configured }}"
  data-de-vat-canonical-variant-id="{{ canonical_variant_id }}"
  data-de-vat-international-variant-id="{{ international_variant_id }}"
  data-de-vat-single-source="{{ vat_single_source }}"
  data-de-vat-regular-online-ready="{{ vat_regular_online_ready }}"
  data-de-standard-vat-variant-id="{{ standard_variant_id }}"
  data-de-zero-vat-variant-id="{{ zero_variant_id }}"
  data-de-vat-policy-invalid="{{ vat_policy_invalid }}"
{%- endif -%}
