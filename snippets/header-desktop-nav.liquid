{%- liquid
  unless limit
    assign limit = main_menu.links.size
  endunless
  unless offset
    assign offset = 0
  endunless
-%}

<ul class="site-nav site-navigation small--hide">
  {%- for link in main_menu.links limit: limit offset: offset -%}
    {%- liquid
      assign mega_menu_block = nil
      assign link_handle = link.title | handleize
      assign product_block_count = 0
      assign default_product_category = blank

      for block in section.blocks
        if block.type == 'mega_menu'
          assign block_trigger = block.settings.menu_item | handleize
          if block_trigger == link_handle
            assign mega_menu_block = block
            break
          endif
        endif
      endfor

      for block in section.blocks
        if block.type == 'mega_menu_product'
          assign product_menu_handle = block.settings.menu_handle | handleize
          if product_menu_handle == link_handle and block.settings.product != blank
            assign product_block_count = product_block_count | plus: 1
            assign product_category_handle = block.settings.category_handle
            if product_category_handle == blank
              assign product_category_handle = block.settings.product.handle
            endif
            assign product_category_handle = product_category_handle | handleize
            if product_category_handle contains 'venus-e-mini'
              assign product_category_handle = 'venus-e-mini'
            elsif product_category_handle contains 'venus-e-3'
              assign product_category_handle = 'venus-e-3'
            elsif product_category_handle contains 'venus-e-4'
              assign product_category_handle = 'venus-e-4'
            elsif product_category_handle contains 'venus-e-max'
              assign product_category_handle = 'venus-e-max'
            endif
            if default_product_category == blank
              assign default_product_category = product_category_handle
            endif
          endif
        endif
      endfor

      assign has_dropdown = false
      assign is_megamenu = false
      assign has_product_menu = false
      if link.links != blank
        assign has_dropdown = true
        if mega_menu_block != nil
          assign is_megamenu = true
        endif
        if is_megamenu and product_block_count > 0
          assign has_product_menu = true
        endif
      endif

      if mega_menu_block != nil
        assign show_images = mega_menu_block.settings.show_images
        assign image_aspect_ratio = mega_menu_block.settings.image_aspect_ratio
        assign center_content = mega_menu_block.settings.center_content
      endif
    -%}

    <li class="site-nav__item site-nav__expanded-item{% if has_dropdown %} site-nav--has-dropdown{% endif %}{% if is_megamenu %} site-nav--is-megamenu{% endif %}">
      {% if is_megamenu or has_dropdown %}
        <details
          data-hover="{{ hover_menu }}"
          id="site-nav-item--{{ forloop.index }}"
          class="site-nav__details"
        >
          <summary
            data-link="{{ link.url }}"
            aria-expanded="false"
            aria-controls="site-nav-item--{{ forloop.index }}"
            class="site-nav__link site-nav__link--underline{% if has_dropdown %} site-nav__link--has-dropdown{% endif %}"
          >
            {{ link.title }} <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon--wide icon-chevron-down" viewBox="0 0 28 16"><path d="m1.57 1.59 12.76 12.77L27.1 1.59" stroke-width="2" stroke="#000" fill="none"/></svg>
          </summary>
      {% else %}
        <a
          href="{{ link.url }}"
          class="site-nav__link site-nav__link--underline"
        >
          {{ link.title }}
        </a>
      {% endif %}

      {%- if has_product_menu -%}
        <div
          class="site-nav__dropdown megamenu mega-menu-products text-left"
          data-mega-menu-products
          data-default-category="{{ default_product_category }}"
        >
          <div class="page-width">
            <div class="mega-menu-products__inner">
              <nav class="mega-menu-products__categories" aria-label="{{ link.title | escape }}">
                <ul class="mega-menu-products__category-list">
                  {%- for childlink in link.links -%}
                    {%- liquid
                      assign childlink_url = childlink.url
                      assign childlink_title_handle = childlink.title | handleize
                      if childlink_title_handle == 'venus-e-mini'
                        assign childlink_url = '/products/venus-e-mini'
                      endif
                      if childlink.title == 'Garantie & Rückgabe'
                        assign childlink_url = '/pages/garantie-ruckgabe?view=widerrufsrecht'
                      endif
                      assign category_handle = childlink_title_handle
                      if category_handle contains 'venus-e-mini'
                        assign category_handle = 'venus-e-mini'
                      elsif category_handle contains 'venus-e-3'
                        assign category_handle = 'venus-e-3'
                      elsif category_handle contains 'venus-e-4'
                        assign category_handle = 'venus-e-4'
                      elsif category_handle contains 'venus-e-max'
                        assign category_handle = 'venus-e-max'
                      endif
                      assign has_product_category = false
                      for product_block in section.blocks
                        if product_block.type == 'mega_menu_product'
                          assign product_menu_handle = product_block.settings.menu_handle | handleize
                          if product_menu_handle == link_handle and product_block.settings.product != blank
                            assign product_category_handle = product_block.settings.category_handle
                            if product_category_handle == blank
                              assign product_category_handle = product_block.settings.product.handle
                            endif
                            assign product_category_handle = product_category_handle | handleize
                            if product_category_handle contains 'venus-e-mini'
                              assign product_category_handle = 'venus-e-mini'
                            elsif product_category_handle contains 'venus-e-3'
                              assign product_category_handle = 'venus-e-3'
                            elsif product_category_handle contains 'venus-e-4'
                              assign product_category_handle = 'venus-e-4'
                            elsif product_category_handle contains 'venus-e-max'
                              assign product_category_handle = 'venus-e-max'
                            endif
                            if product_category_handle == category_handle
                              assign has_product_category = true
                              break
                            endif
                          endif
                        endif
                      endfor
                    -%}
                    <li class="mega-menu-products__category-item{% if category_handle == default_product_category or childlink.active or childlink.child_active %} is-active{% endif %}" data-mega-menu-category-item="{{ category_handle }}">
                      <a
                        href="{{ childlink_url }}"
                        class="mega-menu-products__category-link"
                        {% if has_product_category %}data-mega-menu-category="{{ category_handle }}" aria-controls="mega-menu-products-{{ mega_menu_block.id }}-{{ category_handle }}" aria-expanded="{% if category_handle == default_product_category %}true{% else %}false{% endif %}"{% endif %}
                        {% if childlink.active %}aria-current="page"{% endif %}
                      >
                        <span>{{ childlink.title | escape }}</span>
                        <span class="mega-menu-products__category-arrow" aria-hidden="true">›</span>
                      </a>
                      {%- if childlink.links != blank -%}
                        <ul class="mega-menu-products__subcategory-list">
                          {%- for grandchildlink in childlink.links -%}
                            <li>
                              <a href="{{ grandchildlink.url }}" class="mega-menu-products__subcategory-link"{% if grandchildlink.active %} aria-current="page"{% endif %}>
                                {{ grandchildlink.title | escape }}
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              </nav>

              <div class="mega-menu-products__panels">
                {%- for product_block in section.blocks -%}
                  {%- if product_block.type == 'mega_menu_product' -%}
                    {%- assign product_menu_handle = product_block.settings.menu_handle | handleize -%}
                    {%- if product_menu_handle == link_handle and product_block.settings.product != blank -%}
                      {%- assign product_category_handle = product_block.settings.category_handle -%}
                      {%- if product_category_handle == blank -%}
                        {%- assign product_category_handle = product_block.settings.product.handle -%}
                      {%- endif -%}
                      {%- assign product_category_handle = product_category_handle | handleize -%}
                      {%- if product_category_handle contains 'venus-e-mini' -%}
                        {%- assign product_category_handle = 'venus-e-mini' -%}
                      {%- elsif product_category_handle contains 'venus-e-3' -%}
                        {%- assign product_category_handle = 'venus-e-3' -%}
                      {%- elsif product_category_handle contains 'venus-e-4' -%}
                        {%- assign product_category_handle = 'venus-e-4' -%}
                      {%- elsif product_category_handle contains 'venus-e-max' -%}
                        {%- assign product_category_handle = 'venus-e-max' -%}
                      {%- endif -%}
                      <div
                        id="mega-menu-products-{{ mega_menu_block.id }}-{{ product_category_handle }}"
                        class="mega-menu-products__panel"
                        data-mega-menu-category-panel="{{ product_category_handle }}"
                        {% unless product_category_handle == default_product_category %}hidden{% endunless %}
                      >
                        <div class="mega-menu-products__cards" role="list">
                          {%- for mega_variant in product_block.settings.product.variants limit: 3 -%}
                            <div role="listitem">
                              {%- render 'product-menu-card', block: product_block, variant: mega_variant, quantity: forloop.index -%}
                            </div>
                          {%- endfor -%}
                        </div>
                      </div>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          </div>
        </div>
      {%- elsif is_megamenu -%}
        {%- liquid
          assign any_column_has_image = false
          if show_images
            for childlink in link.links
              if childlink.url contains '/collections/'
                if collections[childlink.object.handle].image != blank
                  assign any_column_has_image = true
                  break
                endif
              endif
            endfor
          endif
        -%}
        <div class="site-nav__dropdown megamenu text-left">
          <div class="page-width">
            <div class="megamenu__inner{% if center_content %} megamenu__inner--center{% endif %}">
              {%- if mega_menu_block != nil -%}
                {%- liquid
                  assign promo1_has_content = false
                  if mega_menu_block.settings.promo1_image
                    assign promo1_has_content = true
                  elsif mega_menu_block.settings.promo1_heading != blank
                    assign promo1_has_content = true
                  elsif mega_menu_block.settings.promo1_text != blank
                    assign promo1_has_content = true
                  endif
                  assign promo2_has_content = false
                  if mega_menu_block.settings.promo2_image
                    assign promo2_has_content = true
                  elsif mega_menu_block.settings.promo2_heading != blank
                    assign promo2_has_content = true
                  elsif mega_menu_block.settings.promo2_text != blank
                    assign promo2_has_content = true
                  endif
                  assign promo1_before = false
                  if promo1_has_content and mega_menu_block.settings.promo1_position == 'before'
                    assign promo1_before = true
                  endif
                  assign promo2_before = false
                  if promo2_has_content and mega_menu_block.settings.promo2_position == 'before'
                    assign promo2_before = true
                  endif
                  assign promo1_after = false
                  if promo1_has_content and mega_menu_block.settings.promo1_position == 'after'
                    assign promo1_after = true
                  endif
                  assign promo2_after = false
                  if promo2_has_content and mega_menu_block.settings.promo2_position == 'after'
                    assign promo2_after = true
                  endif
                -%}
                {%- if promo1_before or promo2_before -%}
                  <div class="megamenu__promos megamenu__promos--before appear-animation appear-delay-1">
                    {%- if promo1_before -%}
                      {%- render 'mega-menu-promo-tile', block: mega_menu_block, promo_num: '1' -%}
                    {%- endif -%}
                    {%- if promo2_before -%}
                      {%- render 'mega-menu-promo-tile', block: mega_menu_block, promo_num: '2' -%}
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endif -%}

              {%- assign animation_column = 1 -%}
              <div class="megamenu__nav{% if center_content %} megamenu__nav--center{% endif %}">
                  {%- for childlink in link.links -%}
                    {%- liquid
                      assign childlink_url = childlink.url
                      assign childlink_title_handle = childlink.title | handleize
                      if childlink_title_handle contains 'venus-e-mini'
                        assign childlink_url = '/products/venus-e-mini'
                      endif
                      if childlink.title == 'Garantie & Rückgabe'
                        assign childlink_url = '/pages/garantie-ruckgabe?view=widerrufsrecht'
                      endif
                    -%}
                    <div class="megamenu__column appear-animation appear-delay-{{ animation_column }}">
                      {%- if show_images and childlink.url contains '/collections/' and collections[childlink.object.handle].image != blank -%}
                        <a href="{{ childlink_url }}" tabindex="-1" aria-hidden="true">
                          <div class="megamenu__column-image svg-mask svg-mask--{{ image_aspect_ratio }}">
                            {%- render 'image-element',
                              img: collections[childlink.object.handle].image,
                              sizeVariable: '20vw',
                              alt: collections[childlink.object.handle].title,
                              classes: 'megamenu__collection-image',
                              loading: 'eager',
                            -%}
                          </div>
                        </a>
                      {%- elsif any_column_has_image -%}
                        <div class="megamenu__column-image-placeholder svg-mask svg-mask--{{ image_aspect_ratio }}"></div>
                      {%- endif -%}

                      <div class="h5">
                        <a href="{{ childlink_url }}" class="site-nav__dropdown-link site-nav__dropdown-link--top-level">
                          {{ childlink.title | escape }}
                        </a>
                      </div>

                      {%- for grandchildlink in childlink.links -%}
                        <div>
                          <a href="{{ grandchildlink.url }}" class="site-nav__dropdown-link">
                            {{ grandchildlink.title | escape }}
                          </a>
                        </div>
                      {%- endfor -%}
                    </div>
                    {%- assign animation_column = animation_column | plus: 1 -%}
                  {%- endfor -%}
              </div>

              {%- if mega_menu_block != nil -%}
                {%- if promo1_after or promo2_after -%}
                  <div class="megamenu__promos megamenu__promos--after appear-animation appear-delay-1">
                    {%- if promo1_after -%}
                      {%- render 'mega-menu-promo-tile', block: mega_menu_block, promo_num: '1' -%}
                    {%- endif -%}
                    {%- if promo2_after -%}
                      {%- render 'mega-menu-promo-tile', block: mega_menu_block, promo_num: '2' -%}
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- elsif has_dropdown -%}
        <ul class="site-nav__dropdown text-left">
          {%- for childlink in link.links -%}
            {%- liquid
              assign has_sub_dropdown = false
              assign childlink_url = childlink.url
              assign childlink_title_handle = childlink.title | handleize
              if childlink_title_handle == 'venus-e-mini'
                assign childlink_url = '/products/venus-e-mini'
              endif
              if childlink.title == 'Garantie & Rückgabe'
                assign childlink_url = '/pages/garantie-ruckgabe?view=widerrufsrecht'
              endif

              if childlink.links != blank
                assign has_sub_dropdown = true
              endif
            -%}

            <li class="{% if has_sub_dropdown %}site-nav__deep-dropdown-trigger{% endif %}">
              <a href="{{ childlink_url }}" class="site-nav__dropdown-link site-nav__dropdown-link--second-level{% if has_sub_dropdown %} site-nav__dropdown-link--has-children{% endif %}">
                {{ childlink.title | escape }}
                {%- if has_sub_dropdown -%}
                  <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon--wide icon-chevron-down" viewBox="0 0 28 16"><path d="m1.57 1.59 12.76 12.77L27.1 1.59" stroke-width="2" stroke="#000" fill="none"/></svg>
                {%- endif -%}
              </a>
              {%- if has_sub_dropdown -%}
                <ul class="site-nav__deep-dropdown">
                  {%- for grandchildlink in childlink.links -%}
                    <li>
                      <a href="{{ grandchildlink.url }}" class="site-nav__dropdown-link">{{ grandchildlink.title | escape }}</a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {% if is_megamenu or has_dropdown %}
        </details>
      {% endif %}
    </li>
  {%- endfor -%}
</ul>

<script>
  (function () {
    var initializeMegaMenuProductPanels = function () {
      if (window.matchMedia && !window.matchMedia('(min-width: 769px)').matches) {
        return;
      }

      document.querySelectorAll('[data-mega-menu-products]:not([data-mega-menu-ready])').forEach(function (menu) {
        menu.setAttribute('data-mega-menu-ready', 'true');

        var categoryLinks = menu.querySelectorAll('[data-mega-menu-category]');
        var categoryItems = menu.querySelectorAll('[data-mega-menu-category-item]');
        var panels = menu.querySelectorAll('[data-mega-menu-category-panel]');
        var defaultCategory = menu.getAttribute('data-default-category');

        var activateCategory = function (category) {
          if (!category) {
            return;
          }

          panels.forEach(function (panel) {
            panel.hidden = panel.getAttribute('data-mega-menu-category-panel') !== category;
          });

          categoryLinks.forEach(function (link) {
            var isActive = link.getAttribute('data-mega-menu-category') === category;
            link.setAttribute('aria-expanded', isActive ? 'true' : 'false');
          });

          categoryItems.forEach(function (item) {
            item.classList.toggle('is-active', item.getAttribute('data-mega-menu-category-item') === category);
          });
        };

        categoryLinks.forEach(function (link) {
          var category = link.getAttribute('data-mega-menu-category');
          link.addEventListener('mouseenter', function () {
            activateCategory(category);
          });
          link.addEventListener('focus', function () {
            activateCategory(category);
          });
        });

        var details = menu.closest('details');
        if (details) {
          details.addEventListener('toggle', function () {
            if (details.open) {
              activateCategory(defaultCategory);
            }
          });
        }

        activateCategory(defaultCategory);
      });
    };

    initializeMegaMenuProductPanels();
    document.addEventListener('shopify:section:load', initializeMegaMenuProductPanels);
  })();
</script>
