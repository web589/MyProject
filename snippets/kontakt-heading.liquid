{% if section.settings.eyebrow != blank %}
  <div class="kt-eyebrow">{{ section.settings.eyebrow | escape }}</div>
{% endif %}
{% if section.settings.heading != blank or section.settings.heading_accent != blank or section.settings.heading_suffix != blank %}
  {% if level == 'h1' %}
    <h1 class="kt-title" id="kt-heading-{{ section.id }}">{{ section.settings.heading | escape }}{% if section.settings.heading_accent != blank %}{% if section.settings.heading != blank %} {% endif %}<span class="kt-accent">{{ section.settings.heading_accent | escape }}</span>{% endif %}{% if section.settings.heading_suffix != blank %}{% if section.settings.heading != blank or section.settings.heading_accent != blank %} {% endif %}{{ section.settings.heading_suffix | escape }}{% endif %}</h1>
  {% else %}
    <h2 class="kt-title" id="kt-heading-{{ section.id }}">{{ section.settings.heading | escape }}{% if section.settings.heading_accent != blank %}{% if section.settings.heading != blank %} {% endif %}<span class="kt-accent">{{ section.settings.heading_accent | escape }}</span>{% endif %}{% if section.settings.heading_suffix != blank %}{% if section.settings.heading != blank or section.settings.heading_accent != blank %} {% endif %}{{ section.settings.heading_suffix | escape }}{% endif %}</h2>
  {% endif %}
{% endif %}
{% if section.settings.subtitle != blank %}
  <p class="kt-sub">{{ section.settings.subtitle | escape | newline_to_br }}</p>
{% endif %}

