      {% when 'tools' %}<path d="M14.5 4.5l5 5L9 20l-5 1 1-5 10.5-11.5z"/><path d="M12.5 6.5l5 5"/>
      {% when 'return' %}<path d="M4 12a8 8 0 0113.7-5.6L20 8"/><path d="M20 4v4h-4"/><path d="M20 12a8 8 0 01-13.7 5.6L4 16"/><path d="M4 20v-4h4"/>
