{%- if value != blank or label != blank -%}
  <div class="mega-menu-products__article-metric" role="listitem">
    <span class="mega-menu-products__article-metric-icon" aria-hidden="true">
      {%- case icon -%}
        {%- when 'bolt' -%}
          <svg viewBox="0 0 24 24" focusable="false"><path d="M13.2 2 5.5 13h5.3L10.8 22l7.7-11h-5.3L13.2 2Z" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.8"/></svg>
        {%- when 'shield' -%}
          <svg viewBox="0 0 24 24" focusable="false"><path d="m12 3 7 3v5.3c0 4.5-2.9 7.8-7 9.7-4.1-1.9-7-5.2-7-9.7V6l7-3Z" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.8"/><path d="m8.8 12 2.1 2.1 4.4-4.4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"/></svg>
        {%- else -%}
          <svg viewBox="0 0 24 24" focusable="false"><rect x="5" y="5" width="14" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M9 2h6v3H9zM9 12h6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"/></svg>
      {%- endcase -%}
    </span>
    <span class="mega-menu-products__article-metric-copy">
      {%- if value != blank -%}
        <strong>{{ value | escape }}</strong>
      {%- endif -%}
      {%- if label != blank -%}
        <span>{{ label | escape }}</span>
      {%- endif -%}
    </span>
  </div>
{%- endif -%}
