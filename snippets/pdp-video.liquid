{%- comment -%}
  Deferred, viewport-controlled video. Prefer a Shopify video object so a web
  rendition is used instead of the original upload. Legacy URLs remain playable.
{%- endcomment -%}
{%- liquid
  assign media_poster = hosted_video.preview_image | default: poster
  if media_poster == blank and request.page_type == 'product'
    assign media_poster = product.featured_image
  endif
  assign media_url = video_url
  assign target_height = target_height | default: 720
  if hosted_video != blank
    assign mp4_sources = hosted_video.sources | where: 'format', 'mp4' | sort: 'height'
    assign selected_source = mp4_sources.last
    for source in mp4_sources
      if source.height >= target_height
        assign selected_source = source
        break
      endif
    endfor
    if selected_source.url != blank
      assign media_url = selected_source.url
    endif
  endif
-%}
{%- if media_url != blank -%}
  <pdp-video data-autoplay="{% if autoplay %}true{% else %}false{% endif %}" data-state="paused" data-error-label="{{ 'general.accessibility.video_error' | t | escape }}" aria-busy="false" style="--pdp-video-fit:{{ fit | default: 'cover' }}">
    <video{% if video_id != blank %} id="{{ video_id }}"{% endif %}{% if classes != blank %} class="{{ classes }}"{% endif %} muted loop playsinline preload="none" tabindex="-1" draggable="false" disablepictureinpicture disableremoteplayback controlslist="nodownload nofullscreen noremoteplayback noplaybackrate"{% if media_poster != blank %} poster="{{ media_poster | image_url: width: 1200 }}"{% endif %}>
      <source data-src="{{ media_url | escape }}" type="video/mp4">
    </video>
    <span class="pdp-video__loading" aria-hidden="true"></span>
    <span class="visually-hidden" data-video-message aria-live="polite"></span>
  </pdp-video>
{%- endif -%}
