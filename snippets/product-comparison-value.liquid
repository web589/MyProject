{%- comment -%}
  Render one value for the homepage product comparison table.
  Product values come from Product Metafields. Capacity uses spec_source:
  'capacity_range' so bundle ranges can be shown, with a 1x Variant fallback.
{%- endcomment -%}
{%- liquid
  assign preferred_namespace = spec_namespace | default: settings.technical_specs_namespace | default: 'custom' | strip
  assign namespaces = preferred_namespace | append: ',custom,specs,features,specifications,technical_specifications,technical' | split: ','
  assign capacity_range_source = false
  if spec_source == 'capacity_range'
    assign capacity_range_source = true
    assign keys = 'capacity_range,storage_capacity_range,speicherkapazitaet_range,speicherkapazitat_range,speicherkapazität_range' | split: ','
    assign variant_keys = spec_keys | split: ','
  else
    assign keys = spec_keys | split: ','
  endif
  assign value_object = spec_product
  assign resolved = false

  if spec_source == 'variant' and spec_product != blank
    assign value_object = blank
    assign requested_variant_option = spec_variant_option | default: '1×' | strip | downcase | replace: '×', 'x' | remove: ' '
    for candidate_variant in spec_product.variants
      assign candidate_option = candidate_variant.option1 | default: candidate_variant.title | strip | downcase | replace: '×', 'x' | remove: ' '
      if candidate_option == requested_variant_option or candidate_option contains requested_variant_option
        assign value_object = candidate_variant
        break
      endif
    endfor
  endif
-%}

{%- if value_object != blank -%}
  {%- for namespace in namespaces -%}
    {%- assign clean_namespace = namespace | strip -%}
    {%- unless clean_namespace == blank or resolved -%}
      {%- for key in keys -%}
        {%- assign clean_key = key | strip -%}
        {%- if clean_key != blank -%}
          {%- assign spec_metafield = value_object.metafields[clean_namespace][clean_key] -%}
          {%- if spec_metafield.type == 'boolean' -%}
            {%- if spec_metafield.value == true -%}
              Ja
              {%- assign resolved = true -%}
              {%- break -%}
            {%- elsif spec_metafield.value == false -%}
              Nein
              {%- assign resolved = true -%}
              {%- break -%}
            {%- endif -%}
          {%- elsif spec_metafield != blank -%}
            {%- capture spec_output -%}
              {%- if spec_metafield.type contains 'list.' -%}
                {{- spec_metafield.value | join: ', ' -}}
              {%- else -%}
                {{- spec_metafield | metafield_text -}}
              {%- endif -%}
            {%- endcapture -%}
            {%- assign spec_output = spec_output | strip -%}
            {%- if spec_output == blank and spec_metafield.value != blank -%}
              {%- capture spec_output -%}{{- spec_metafield.value -}}{%- endcapture -%}
              {%- assign spec_output = spec_output | strip -%}
            {%- endif -%}
            {%- if spec_output != blank -%}
              {{- spec_output | escape_once -}}
              {%- assign resolved = true -%}
              {%- break -%}
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endunless -%}
  {%- endfor -%}
{%- endif -%}

{%- if capacity_range_source and spec_product != blank and resolved == false -%}
  {%- assign capacity_title = spec_product.title | default: '' | strip -%}
  {%- assign capacity_title_parts = capacity_title | split: ' – ' -%}
  {%- if capacity_title_parts.size == 1 -%}
    {%- assign capacity_title_parts = capacity_title | split: ' - ' -%}
  {%- endif -%}
  {%- assign capacity_text = capacity_title_parts | last | strip -%}
  {%- assign capacity_text_parts = capacity_text | split: ' kWh' -%}
  {%- assign capacity_text = capacity_text_parts | first | strip -%}
  {%- if capacity_text != blank and capacity_text != capacity_title -%}
    {%- assign capacity_text = capacity_text | replace: ' bis ', '–' | replace: ' - ', '–' | replace: ' – ', '–' -%}
    {{- capacity_text | append: ' kWh' | escape -}}
    {%- assign resolved = true -%}
  {%- endif -%}
{%- endif -%}

{%- if capacity_range_source and spec_product != blank and resolved == false -%}
  {%- assign value_object = blank -%}
  {%- assign requested_variant_option = spec_variant_option | default: '1×' | strip | downcase | replace: '×', 'x' | remove: ' ' -%}
  {%- for candidate_variant in spec_product.variants -%}
    {%- assign candidate_option = candidate_variant.option1 | default: candidate_variant.title | strip | downcase | replace: '×', 'x' | remove: ' ' -%}
    {%- if candidate_option == requested_variant_option or candidate_option contains requested_variant_option -%}
      {%- assign value_object = candidate_variant -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if value_object != blank -%}
    {%- for namespace in namespaces -%}
      {%- assign clean_namespace = namespace | strip -%}
      {%- unless clean_namespace == blank or resolved -%}
        {%- for key in variant_keys -%}
          {%- assign clean_key = key | strip -%}
          {%- if clean_key != blank -%}
            {%- assign spec_metafield = value_object.metafields[clean_namespace][clean_key] -%}
            {%- if spec_metafield != blank -%}
              {%- capture spec_output -%}
                {%- if spec_metafield.type contains 'list.' -%}
                  {{- spec_metafield.value | join: ', ' -}}
                {%- else -%}
                  {{- spec_metafield | metafield_text -}}
                {%- endif -%}
              {%- endcapture -%}
              {%- assign spec_output = spec_output | strip -%}
              {%- if spec_output == blank and spec_metafield.value != blank -%}
                {%- capture spec_output -%}{{- spec_metafield.value -}}{%- endcapture -%}
                {%- assign spec_output = spec_output | strip -%}
              {%- endif -%}
              {%- if spec_output != blank -%}
                {{- spec_output | escape_once -}}
                {%- assign resolved = true -%}
                {%- break -%}
              {%- endif -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endunless -%}
    {%- endfor -%}
  {%- endif -%}
{%- endif -%}
