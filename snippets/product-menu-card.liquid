{%- liquid
  assign product = block.settings.product

  if product != blank
    assign card_variant = variant | default: product.selected_or_first_available_variant
    assign card_title = block.settings.product_title | default: product.title
    assign card_specs = card_variant.title

    if block.settings.product_title == blank
      if product.title contains ' – '
        assign product_title_parts = product.title | split: ' – '
        assign card_title = product_title_parts.first | strip
        if card_specs == blank or card_specs == 'Default Title'
          assign card_specs = product_title_parts | slice: 1, product_title_parts.size | join: ' – ' | strip
        endif
      elsif product.title contains ' - '
        assign product_title_parts = product.title | split: ' - '
        assign card_title = product_title_parts.first | strip
        if card_specs == blank or card_specs == 'Default Title'
          assign card_specs = product_title_parts | slice: 1, product_title_parts.size | join: ' - ' | strip
        endif
      endif
    endif

    if card_specs == 'Default Title'
      assign card_specs = blank
    endif

    assign product_image_override = block.settings.image
    if quantity == 1 and block.settings.image_1 != blank
      assign product_image_override = block.settings.image_1
    elsif quantity == 2 and block.settings.image_2 != blank
      assign product_image_override = block.settings.image_2
    elsif quantity == 3 and block.settings.image_3 != blank
      assign product_image_override = block.settings.image_3
    endif
    assign product_image = product_image_override | default: card_variant.featured_image | default: product.featured_image
    assign product_link = block.settings.link
    if product_link == blank
      assign product_link = product.url | append: '?variant=' | append: card_variant.id
    endif

    assign product_description = block.settings.description
    if product_description == blank
      assign product_description = product.description | strip_html | truncatewords: 18
    endif

    assign has_card_badge_override = false
    if block.settings.badge_1 != blank or block.settings.badge_2 != blank or block.settings.badge_3 != blank
      assign has_card_badge_override = true
    endif

    assign card_badge = block.settings.badge
    assign badge_tone = block.settings.badge_color | default: 'blue'
    if has_card_badge_override
      assign card_badge = blank
      if quantity == 1
        assign card_badge = block.settings.badge_1
        assign badge_tone = block.settings.badge_color_1 | default: 'blue'
      elsif quantity == 2
        assign card_badge = block.settings.badge_2
        assign badge_tone = block.settings.badge_color_2 | default: 'blue'
      elsif quantity == 3
        assign card_badge = block.settings.badge_3
        assign badge_tone = block.settings.badge_color_3 | default: 'blue'
      endif
    endif

    if badge_tone != 'orange'
      assign badge_tone = 'blue'
    endif

    assign quantity_label = quantity | default: 1 | append: '×'
  endif
-%}

{%- if product != blank -%}
  <a
    class="mega-menu-products__card"
    href="{{ product_link | escape }}"
    aria-label="{{ quantity_label }} {{ card_title | escape }}"
  >
    <div class="mega-menu-products__card-media">
      {%- if card_badge != blank -%}
        <span
          class="mega-menu-products__badge mega-menu-products__badge--{{ badge_tone }}"
        >
          {{ card_badge | escape }}
        </span>
      {%- endif -%}

      {%- if product_image != blank -%}
        {%- render 'image-element',
          img: product_image,
          widths: '300, 500, 700',
          sizeVariable: '25vw',
          alt: card_title,
          classes: 'mega-menu-products__card-image',
          loading: 'lazy',
        -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'mega-menu-products__card-image' }}
      {%- endif -%}
    </div>

    <div class="mega-menu-products__card-content">
      <h3 class="mega-menu-products__card-title">{{ quantity_label }} {{ card_title | escape }}</h3>
      {%- if card_specs != blank -%}
        <p class="mega-menu-products__card-specs">{{ card_specs | escape }}</p>
      {%- endif -%}
      {%- if product_description != blank -%}
        <p class="mega-menu-products__card-description">{{ product_description | escape | newline_to_br }}</p>
      {%- endif -%}
      {%- if card_variant != blank and card_variant.price != blank -%}
        <p class="mega-menu-products__card-price">{{ card_variant.price | money }}</p>
      {%- endif -%}
    </div>
  </a>
{%- endif -%}
