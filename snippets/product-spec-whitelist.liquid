{%- comment -%}
  PDP technical-specification whitelist.

  The block parses each group as:
  group title@@label::key_alias,key_alias||label::source::key_alias###next group...

  Only keys listed here can be rendered. Values always come from the current
  product's Shopify Metafields; this file contains no product data. A row may
  opt into a special source with a source token between the label and aliases.
{%- endcomment -%}
{%- liquid
  assign whitelist_product_type = spec_product.type | downcase
  assign whitelist_product_handle = spec_product.handle | downcase
  assign whitelist_is_smart_meter = false
  if whitelist_product_type contains 'smart meter' or whitelist_product_handle contains 'ct002' or whitelist_product_handle contains 'ct003'
    assign whitelist_is_smart_meter = true
  endif
-%}
{%- if whitelist_is_smart_meter -%}
