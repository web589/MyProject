{%- if request.page_type == 'blog' and blog.handle == 'blog-center' -%}
  {%- assign seo_title = 'Solarspeicher: Nutzbare vs. nominale Kapazität – wie viel Energie kannst du wirklich nutzen?' -%}
{%- else -%}
  {%- capture seo_title -%}
    {{ page_title }}
    {%- if current_tags -%}
      {%- assign meta_tags = current_tags | join: ', ' %} &ndash; {{ 'general.meta.tags' | t: tags: meta_tags -}}
    {%- endif -%}
    {%- if current_page != 1 -%}
      &ndash; {{ 'general.meta.page' | t: page: current_page }}
    {%- endif -%}
    {%- if template == 'password' -%}
      {{ shop.name }}
    {%- else -%}
      {%- unless page_title contains shop.name -%}
        &ndash; {{ shop.name }}
      {%- endunless -%}
    {%- endif -%}
  {%- endcapture -%}
{%- endif -%}
<title>{{ seo_title }}</title>
