{% case icon %}
  {% when 'clock' %}
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.4"/><path d="M12 7.2V12l3.2 2"/></svg>
  {% when 'sun' %}
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.6M12 18.9v2.6M2.5 12h2.6M18.9 12h2.6M5.3 5.3l1.9 1.9M16.8 16.8l1.9 1.9M18.7 5.3l-1.9 1.9M7.2 16.8l-1.9 1.9"/></svg>
  {% when 'battery' %}
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="7.5" width="16" height="9.5" rx="2.2"/><path d="M21 11v2.5M6 10.2h6.5v3.8H6z"/></svg>
  {% when 'plug' %}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 3v5M15 3v5M7.5 8h9l1 5.5a6 6 0 0 1-6 6 6 6 0 0 1-6-6zM12 19.5V22"/></svg>
  {% when 'day-evening' %}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v2M5.6 5.6l1.4 1.4M3 12h2M4 20h16"/><circle cx="12" cy="12" r="4"/><path d="m19 16.5 1.5 1.5"/></svg>
  {% when 'home' %}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3.5 10.5 8.5-6.5 8.5 6.5M5.5 9.8V20h13V9.8M10 20v-5h4v5"/></svg>
  {% when 'chart' %}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V10M10 20V4.5M16 20v-7.5M22 20H2"/></svg>
  {% when 'car' %}
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="10" width="12" height="7" rx="2"/><path d="M15 13h3l2 3v1h-5z"/><circle cx="7" cy="19" r="1.8"/><circle cx="17.5" cy="19" r="1.8"/></svg>
  {% when 'shield' %}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3.5 7.5 3.6v5c0 4.3-3.1 7.4-7.5 8.4-4.4-1-7.5-4.1-7.5-8.4v-5zM9 12l2 2 4-4"/></svg>
{% endcase %}
