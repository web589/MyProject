{% liquid
  assign heading_tag = heading_tag | default: 'h2'
%}
{% if eyebrow != blank %}
  <div class="ss-eyebrow">{{ eyebrow | escape }}</div>
{% endif %}
<{{ heading_tag }} class="ss-heading">
  {{ heading_before | escape }}{% if heading_highlight != blank %} <span>{{ heading_highlight | escape }}</span>{% endif %}
</{{ heading_tag }}>
{% if subtext != blank %}
  <div class="ss-subtext rte">{{ subtext }}</div>
{% endif %}
