{%- liquid
  assign vpp_icon = icon | default: 'home'
-%}
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {%- case vpp_icon -%}
    {%- when 'sun' -%}
      <circle cx="12" cy="12" r="4.2" /><path d="M12 3.5v2.2M12 18.3v2.2M4.4 12H2.2M21.8 12h-2.2M6.4 6.4 4.9 4.9M19.1 19.1l-1.5-1.5M17.6 6.4l1.5-1.5M4.9 19.1l1.5-1.5" />
    {%- when 'bolt' -%}
      <path d="m13.5 3.5-8 10h5l-1 7 8-10h-5l1-7z" />
    {%- when 'network' -%}
      <circle cx="6" cy="6" r="2.3" /><circle cx="18" cy="6" r="2.3" /><circle cx="12" cy="18" r="2.3" /><path d="m8 7.2 2.6 8.6M16 7.2l-2.6 8.6M8.3 6h7.4" />
    {%- when 'euro' -%}
      <path d="M16.7 7.2a6 6 0 1 0 0 9.6M5 10.2h8M5 13.8h7" />
    {%- when 'battery' -%}
      <rect x="3" y="7" width="16" height="10" rx="2" /><path d="M21 10v4M6.5 12h7" />
    {%- when 'lock' -%}
      <rect x="5" y="10" width="14" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v2" />
    {%- when 'contract' -%}
      <path d="M7 3h8l3 3v15H7zM15 3v4h4M10 11h5M10 15h5M10 19h3" />
    {%- when 'meter' -%}
      <rect x="4" y="3" width="16" height="18" rx="2" /><path d="M8 8h8M8 13h3M14 13h2M8 17h8" />
    {%- when 'grid' -%}
      <path d="M12 3v18M6 8h12M5 13h14M7 18h10M8 3l-3 18M16 3l3 18" />
    {%- else -%}
      <path d="m3 11 9-7 9 7v9H3zM9 20v-6h6v6" />
  {%- endcase -%}
</svg>
