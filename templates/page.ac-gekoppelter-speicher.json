    "faq_FenLTg": {
      "type": "faq",
      "blocks": {
        "question_LAWPf6": {
          "type": "question",
          "settings": {
            "title": "Wie viele Erweiterungsakkus kann ich anschließen?",
            "text": "<p>Bis zu 4 SE-20 Erweiterungsakkus lassen sich anschließen, sodass die Gesamtkapazität von 2 kWh auf bis zu 10 kWh steigt.<br/><br/></p>"
          }
        },
        "question_33MTKj": {
          "type": "question",
          "settings": {
            "title": "Brauche ich einen Elektriker für die Installation？",
            "text": "<p><br/>Der S3-20 ist als Stecker-Speicher konzipiert und lässt sich ohne bauliche Eingriffe an eine normale Steckdose anschließen. Für den reinen Anschluss ist in der Regel kein Elektriker erforderlich; bei Unsicherheiten zur Hausinstallation empfehlen wir dennoch, einen Fachbetrieb zu konsultieren.<br/><br/></p>"
          }
        },
        "question_D3UJaR": {
          "type": "question",
          "settings": {
            "title": "Wie weit darf der S3-20 von der Steckdose entfernt installiert werden？",
            "text": "<p><br/>Der Abstand zwischen Gerät und Steckdose sollte 3 Meter nicht überschreiten. Bei größerer Entfernung wird ein Verlängerungskabel benötigt.<br/><br/></p>"
          }
        },
        "question_4kXcmz": {
          "type": "question",
          "settings": {
            "title": "Fällt für mein Solarsystem die Mehrwertsteuer an?",
            "text": "<p><br/>Seit 2023 gilt in Deutschland für private Photovoltaikanlagen — einschließlich Speicher, Wechselrichter und Zubehör — der Nullsteuersatz gemäß § 12 Abs. 3 UStG. Das betrifft Anlagen bis 30 kWp, die auf oder in der Nähe eines Wohngebäudes installiert werden, und umfasst Solarmodule, Wechselrichter, Batteriespeicher, Unterkonstruktion, Kabel sowie die Installationsleistung. Auch stationäre Balkonkraftwerke ab 300 Watt profitieren von dieser Regelung. Ob die Voraussetzungen im Einzelfall erfüllt sind, sollten Kundinnen und Kunden idealerweise mit ihrem Steuerberater oder der zuständigen Finanzbehörde klären.<br/><br/><br/></p>"
          }
        }
      },
      "block_order": [
