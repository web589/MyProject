    "ac_faq": {
      "type": "ac-storage-faq",
      "blocks": {
        "faq_1": {
          "type": "faq",
          "settings": {
            "question": "Was bedeutet AC-gekoppelter Speicher?",
            "answer": "Ein AC-gekoppelter Speicher wird über das Hausnetz in dein Energiesystem eingebunden. Er eignet sich besonders dann, wenn du ein bestehendes System erweitern möchtest."
          }
        },
        "faq_2": {
          "type": "faq",
          "settings": {
            "question": "Kann ich einen AC-Speicher mit einer bestehenden PV-Anlage kombinieren?",
            "answer": "In vielen Fällen ja. Weil der Speicher über das Hausnetz eingebunden wird, lässt er sich häufig ergänzen, ohne die bestehende PV-Anlage umzubauen. Wie gut das im Einzelfall funktioniert, hängt von deinem Hausanschluss und deiner bisherigen Konfiguration ab."
          }
        },
        "faq_3": {
          "type": "faq",
          "settings": {
            "question": "Ist ein AC-gekoppelter Speicher gut für die Nachrüstung geeignet?",
            "answer": "Ja, genau dafür ist dieses Konzept oft besonders interessant. Vor allem bestehende Haushalte mit PV oder Balkonkraftwerk profitieren von der flexibleren Einbindung."
          }
        },
        "faq_4": {
          "type": "faq",
          "settings": {
            "question": "Was ist der Unterschied zwischen AC- und DC-Speicher?",
            "answer": "AC-Speicher werden über das Hausnetz integriert, DC-Speicher direkt auf der Gleichstromseite der PV-Anlage. AC ist oft spannender für Nachrüstung, DC eher für Neuplanung."
          }
        },
        "faq_5": {
          "type": "faq",
          "settings": {
            "question": "Kann ich mit einem AC-gekoppelten Speicher meinen Eigenverbrauch erhöhen?",
            "answer": "Ja. Genau darin liegt einer der größten Vorteile: Überschüssiger Solarstrom kann später im Haushalt genutzt werden, statt sofort eingespeist zu werden."
          }
        },
        "faq_6": {
          "type": "faq",
          "settings": {
            "question": "Brauche ich dafür ein Smart Meter?",
            "answer": "Für eine intelligentere Steuerung und mehr Transparenz über Energieflüsse ist ein passender Smart Meter sehr sinnvoll."
          }
        },
        "faq_7": {
