    "e-auto-faq": {
      "type": "e-auto-faq",
      "blocks": {
        "faq-direct": {
          "type": "faq",
          "settings": {
            "question": "Kann der VENUS E mein Auto direkt laden?",
            "answer": "<p>Nein – und das ist Absicht. Der VENUS E ist AC-gekoppelt an dein Hausnetz angeschlossen und liefert Energie dorthin. Geladen wird dein Auto weiterhin über die Wallbox, die die Ladeleistung regelt. Der Speicher sorgt dafür, dass dabei dein eigener Solarstrom statt Netzstrom fließt.</p>"
          }
        },
        "faq-wallbox": {
          "type": "faq",
          "settings": {
            "question": "Brauche ich eine bestimmte Wallbox?",
            "answer": "<p>Nein, der VENUS E arbeitet über das Hausnetz und ist mit gängigen Wallboxen kompatibel. Deine bestehende Wallbox kann in der Regel bleiben, wie sie ist.</p>"
          }
        },
        "faq-smart-meter": {
          "type": "faq",
          "settings": {
            "question": "Brauche ich ein Smart Meter?",
            "answer": "<p>Ein Smart Meter wird empfohlen: Es erfasst in Echtzeit, was Produktion und Verbrauch gerade leisten. Nur so kann der Speicher Überschuss zuverlässig erkennen und gezielt speichern oder freigeben. Ohne Messung arbeitet das System mit geschätzten Werten.</p>"
          }
        },
        "faq-size": {
          "type": "faq",
          "settings": {
            "question": "Wie groß sollte der Speicher für mein E-Auto sein?",
            "answer": "<p>Als Faustformel zählt deine tägliche Fahrstrecke: Etwa 15–20 kWh Verbrauch pro 100 km bedeutet für 30 km/Tag rund 5–6 kWh Ladebedarf am Abend. Nutze die Schnell-Ermittlung weiter oben auf dieser Seite für eine erste Orientierung.</p>"
          }
        },
        "faq-pv": {
          "type": "faq",
          "settings": {
            "question": "Funktioniert das mit meiner bestehenden PV-Anlage?",
            "answer": "<p>Ja. Der VENUS E wird AC-gekoppelt nachgerüstet – auf der Haushaltsseite deines Hausanschlusses. Deine PV-Anlage mit Wechselrichter bleibt unverändert, es ist keine Neuverkabelung nötig.</p>"
          }
        },
        "faq-night": {
          "type": "faq",
          "settings": {
            "question": "Lädt mein Auto nachts komplett aus dem Speicher?",
            "answer": "<p>Das hängt von der Speicherkapazität und deinem Ladebedarf ab. Bei kurzen bis mittleren Strecken deckt ein passend dimensionierter VENUS E den Abendbedarf in der Regel vollständig. Bei sehr hohen Reichweiten oder mehreren Autos ergänzt das Netz – dann aber nur den Rest.</p>"
          }
        }
      },
