        "audience_evening": { "type": "item", "settings": { "icon": "day-evening", "title": "Erzeugung am Tag, Verbrauch am Abend", "text": "<p>Wenn die meiste Solarenergie entsteht, während der Verbrauch im Haushalt niedrig ist, kann ein größerer Teil des Stroms nicht direkt selbst genutzt werden.</p>" } },
        "audience_existing": { "type": "item", "settings": { "icon": "home", "title": "Bereits vorhandene PV-Anlage oder Balkonkraftwerk", "text": "<p>Mit bestehender Erzeugung lässt sich ein Speicher meist einfacher einordnen als ohne.</p>" } },
