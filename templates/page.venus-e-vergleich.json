    "compare_faq": {
      "type": "bw-storage-faq",
      "blocks": {
        "faq_difference": {
          "type": "question",
          "settings": {
            "question": "Worin unterscheiden sich VENUS E Mini, 3.0, 4.0 und Max?",
            "answer": "<p>Die Modelle unterscheiden sich unter anderem bei Speicherkapazität, bidirektionaler Leistung, Notstromleistung, EPS-Umschaltzeit und Erweiterbarkeit. Die Vergleichstabelle liest die aktuell gepflegten Werte direkt aus den ausgewählten Shopify-Produkten.</p>"
          }
        },
        "faq_size": {
          "type": "question",
          "settings": {
            "question": "Welche Speicherkapazität passt zu meinem Haushalt?",
            "answer": "<p>Die passende Größe hängt vor allem von regelmäßigem PV-Überschuss, Verbrauch außerhalb der Sonnenstunden und gewünschter Reserve ab. Die Haushaltsgröße allein reicht für eine belastbare Auswahl nicht aus.</p>"
          }
        },
        "faq_power": {
          "type": "question",
          "settings": {
            "question": "Warum sollte ich neben der Kapazität auch die Leistung vergleichen?",
            "answer": "<p>Kapazität beschreibt, wie viel Energie gespeichert werden kann. Die Entlade- beziehungsweise Notstromleistung bestimmt, welche Verbraucher gleichzeitig versorgt werden können. Beide Werte beantworten unterschiedliche Fragen.</p>"
          }
        },
        "faq_retrofit": {
          "type": "question",
          "settings": {
            "question": "Kann ich VENUS E an einem bestehenden Balkonkraftwerk nachrüsten?",
            "answer": "<p>Viele bestehende Balkonkraftwerke und PV-Anlagen lassen sich um einen Speicher ergänzen. Ob und wie das bei dir möglich ist, hängt von der vorhandenen Systemarchitektur und der gewählten Konfiguration ab.</p>"
          }
        },
        "faq_meter": {
          "type": "question",
          "settings": {
            "question": "Brauche ich einen Smart Meter?",
            "answer": "<p>Nicht für jede Grundfunktion. Für verbrauchsabhängige Regelung und Nulleinspeisung ist jedoch in der Regel ein kompatibler Smart Meter erforderlich. Prüfe die Kompatibilität des konkreten Modells und deines Stromzählers.</p>"
          }
        },
        "faq_backup": {
          "type": "question",
          "settings": {
            "question": "Bietet jedes VENUS E Modell dieselbe Notstromleistung?",
            "answer": "<p>Nein. Notstromleistung und Umschaltzeit sind modellabhängig. Überlege vorab, welche Verbraucher im Ausfall versorgt werden sollen, und vergleiche dafür die aktuellen Produktwerte.</p>"
          }
        },
        "faq_electrician": {
          "type": "question",
          "settings": {
            "question": "Brauche ich für die Installation eine Elektrofachkraft?",
            "answer": "<p>Das hängt von Modell, Zubehör und vorhandener Installation ab. Plug-&-Play-Komponenten können teilweise ohne aufwendige Elektroarbeiten genutzt werden. Arbeiten am Verteilerkasten müssen von einer Elektrofachkraft durchgeführt werden.</p>"
          }
        },
        "faq_vpp": {
          "type": "question",
          "settings": {
            "question": "Was bedeutet VPP-fähig?",
            "answer": "<p>VPP-fähig bezeichnet die technische Vorbereitung für die Einbindung in ein virtuelles Kraftwerk. Ob ein entsprechender Dienst nutzbar ist, hängt von Region, Anbieter, Tarif und Systemkonfiguration ab; eine bestimmte Vergütung lässt sich nicht pauschal zusagen.</p>"
          }
        }
      },
